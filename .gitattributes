###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

###############################################################################
# db/stored-procedures/ and db/tools/*.sh (M0-01-01/M0-01-02/M0-01-03) require
# LF line endings unconditionally -- manifest.csv and every captured/relocated
# .sql file are checked byte-for-byte by db/tools/verify-capture.sh and
# db/deploy-stored-procedures.ps1, and sp-inventory.sh must run unmodified on
# both Git Bash (Windows) and a Linux CI container. Force LF regardless of
# local core.autocrlf. The `**` form also covers
# db/stored-procedures/relocated-legacy/ (M0-01-03) -- a plain `*.sql` glob
# does not match files inside a subdirectory.
###############################################################################
db/stored-procedures/*.csv text eol=lf
db/stored-procedures/**/*.sql text eol=lf
db/tools/*.sh text eol=lf

###############################################################################
# .claude/workflows/*.js must be LF unconditionally. The Workflow tool reads the
# script from the working tree and validates it before showing the approval
# dialog; that validator rejects carriage returns as control characters, so a
# CRLF checkout makes `/migration-run` fail to launch with
# "script contains control characters that would be hidden in the approval
# dialog" -- even though the committed blob is already LF and the file is
# otherwise untouched. Force LF regardless of local core.autocrlf (which is
# `true` on the Windows dev box). Diagnosed 2026-08-17.
###############################################################################
.claude/workflows/*.js text eol=lf

###############################################################################
# Set default behavior for command prompt diff.
#
# This is need for earlier builds of msysgit that does not have it on by
# default for csharp files.
# Note: This is only used by command line
###############################################################################
#*.cs     diff=csharp

###############################################################################
# Set the merge driver for project and solution files
#
# Merging from the command prompt will add diff markers to the files if there
# are conflicts (Merging from VS is not affected by the settings below, in VS
# the diff markers are never inserted). Diff markers may cause the following 
# file extensions to fail to load in VS. An alternative would be to treat
# these files as binary and thus will always conflict and require user
# intervention with every merge. To do so, just uncomment the entries below
###############################################################################
#*.sln       merge=binary
#*.csproj    merge=binary
#*.vbproj    merge=binary
#*.vcxproj   merge=binary
#*.vcproj    merge=binary
#*.dbproj    merge=binary
#*.fsproj    merge=binary
#*.lsproj    merge=binary
#*.wixproj   merge=binary
#*.modelproj merge=binary
#*.sqlproj   merge=binary
#*.wwaproj   merge=binary

###############################################################################
# behavior for image files
#
# image files are treated as binary by default.
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

###############################################################################
# diff behavior for common document formats
# 
# Convert binary document formats to text before diffing them. This feature
# is only available from the command line. Turn it on by uncommenting the 
# entries below.
###############################################################################
#*.doc   diff=astextplain
#*.DOC   diff=astextplain
#*.docx  diff=astextplain
#*.DOCX  diff=astextplain
#*.dot   diff=astextplain
#*.DOT   diff=astextplain
#*.pdf   diff=astextplain
#*.PDF   diff=astextplain
#*.rtf   diff=astextplain
#*.RTF   diff=astextplain

###############################################################################
# M2-B10 - the API contract and the generated TypeScript client must be LF
# UNCONDITIONALLY. Both are produced byte-for-byte by tools/generate-api-client.sh
# (Swashbuckle's `dotnet swagger tofile`, then openapi-typescript), and both
# emit LF on every platform. Without these rules `* text=auto` above hands a
# CRLF working copy to a Windows checkout (core.autocrlf is `true` on the dev
# box and on the windows-latest runner), and the CI drift check would then
# compare LF output against a CRLF working tree and fail on every single run --
# a false failure that would get the check disabled within a week.
###############################################################################
api/*.json text eol=lf
frontend/nexgen-web/src/app/core/api/generated/** text eol=lf
tools/*.sh text eol=lf
