<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a2a4232e-feff-49cc-90d8-d7c6d15f7657</UserSecretsId>
    <!--
      M2-B10 — the XML documentation file is what carries every action's <summary> into the
      OpenAPI document as an operation description, and every contract record's <summary> into
      the schema description. Program.cs feeds this file to Swashbuckle's IncludeXmlComments.
      CS1591 ("missing XML comment for publicly visible type or member") is suppressed
      DELIBERATELY and EXPLICITLY rather than being allowed to inflate the repository's
      6,695-warning baseline (M0-07's warning gate): documenting every public member of this
      project is not this task's scope, and a warning nobody can clear is a warning everybody
      learns to ignore.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1573 ("parameter has no matching param tag, but other parameters do") is suppressed for the
      same reason and in the same breath: enabling the documentation file surfaced five of them in
      files this task does not otherwise touch (Auth/AccountGates.cs, Middleware/ApiProblems.cs).
      Measured on 2026-08-24 with dotnet build -t:Rebuild: 6,699 warnings without these two
      suppressions, 6,694 with them, against the repository baseline of 6,695. The residual -1 is
      run-to-run noise in the aggregate count, not a warning this task cleared.
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.5" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\V.SMART.Shared\V.SMART.Shared.csproj" />
  </ItemGroup>

</Project>
