@page "/ServiceBills"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ICashFlowService
@using V.SMART.Shared.ViewModels.CashFlowViewModel.ServiceBillViewModel

@inherits BaseUserRightsComponent

@inject ILoggingService _logs
@inject CurrentUserService _userService
@inject IJSRuntime _js
@inject IColumnPreferenceService _preferenceService;
@inject NavigationManager _navigation
@inject IServiceBillsService serviceBillsService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="ConfirmDelete_Click"
         ButtonBootstrapStyle="btn-danger"
         ButtonText="Delete"
         Title="Are you sure you want to delete this ServiceBill?">
</BsModal>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>


@if (isProcessing)
{
    <div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
        <img src="/_content/IQSMART.Shared/images/loading.gif" alt="loading.." />
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}

else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <PageHeader TitleText="ServiceBills List"
                        TitleIcon="bi bi-person-fill-gear"
                        Breadcrumbs="@ServiceBreadcrumbs" />

            <div class="card-body p-4">
                <div class="row g-3 align-items-center mb-3">

                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="ServiceBills"
                                    UserId="@UserName"
                                    MaxVisible="int.MaxValue"
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                value="@pageSize" @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <!-- DROPDOWN -->
                    <div class="col-12 col-lg-2">
                        <select class="form-select form-select-sm shadow-sm">
                            <option value="">-- Status --</option>
                          @*   @foreach (var item in AllItems)
                            {
                                <option value="@item.ItemId">@item.ItemCode</option>
                            } *@
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <select class="form-select form-select-sm shadow-sm" value="@pageSize"
                                @onchange="OnPageSizeChanged"
                                title="Select number of records per page">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                        <div class="col-12 col-lg-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewService">
                                <i class="bi bi-plus-square me-1"></i> Add New ServiceBill
                            </button>
                        </div>
                    }

                </div>

                @if (filteredEnquiry.Any())
                {
                    <div class="table-responsive">
                        <QuickGrid Items="filteredEnquiry.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            case "ServiceId":
                                                <PropertyColumn Title="Service ID" Property="@(c => c.ServiceId)" Sortable="true" />
                                                break;

                                            case "InOrOut":
                                                <TemplateColumn Title="Service Incoimg /Service Outgoing" Context="c">
                                                    @if (c.IncomingServics)
                                                    {
                                                        <span class="fw-bold text-success">Service Incoming</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-bold text-primary">Service Outgoing</span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            case "InvNo":
                                                <PropertyColumn Title="Invoice No" Property="@(x => $"{x.InvNo}{x.Suffix}")" Sortable="true" />
                                                break;

                                            case "InvDate":
                                                <PropertyColumn Title="Invoice Date" Property="@(c => c.InvDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "CustId":
                                                <PropertyColumn Title="Customer ID" Property="@(c => c.CustVendorId)" Sortable="true" />
                                                break;

                                            case "CustName":
                                                <PropertyColumn Title="Customer Name" Property="@(c => c.CustVendorName)" Sortable="true" />
                                                break;

                                            case "DCNO":
                                                <PropertyColumn Title="DC Number" Property="@(c => c.DcNo)" Sortable="false" />
                                                break;

                                            case "DCDate":
                                                <PropertyColumn Title="DC Date" Property="@(c => c.DcDate)" Sortable="true" />
                                                break;

                                            case "CurrName":
                                                <PropertyColumn Title="Currency" Property="@(c => c.CurrName)" />
                                                break;

                                            case "TodayVal":
                                                <PropertyColumn Title="Today Value" Property="@(c => c.TodayVal)" />
                                                break;

                                            case "NoOfItems":
                                                <PropertyColumn Title="No. of Items" Property="@(c => c.NoOfItems)" />
                                                break;

                                            case "TotalGrossAmount":
                                                <PropertyColumn Title="Total Gross Amount" Property="@(c => Math.Round(c.TotalGrossAmount, DecimalPlaces))" />
                                                break;

                                            case "DiscountPercent":
                                                <PropertyColumn Title="Discount Percent" Property="@(c => Math.Round(c.DiscountPercent, DecimalPlaces))" />
                                                break;

                                            case "DiscountAmount":
                                                <PropertyColumn Title="Discount Amount" Property="@(c => Math.Round(c.DiscountAmount, DecimalPlaces))" />
                                                break;

                                            case "TotalBasicAmount":
                                                <PropertyColumn Title="Total Basic Amount" Property="@(c => Math.Round(c.TotalBasicAmount, DecimalPlaces))" />
                                                break;

                                            case "FreightCharges":
                                                <PropertyColumn Title="Freight Charges" Property="@(c => Math.Round(c.FreightCharges, DecimalPlaces))" />
                                                break;

                                            case "PackingPercent":
                                                <PropertyColumn Title="Packing Percent" Property="@(c => Math.Round(c.PackingPercent, DecimalPlaces))" />
                                                break;

                                            case "PackingCharges":
                                                <PropertyColumn Title="Packing Charges" Property="@(c => Math.Round(c.PackingCharges, DecimalPlaces))" />
                                                break;

                                            case "InsurancePercent":
                                                <PropertyColumn Title="Insurance Percent" Property="@(c => Math.Round(c.InsurancePercent, DecimalPlaces))" />
                                                break;

                                            case "InsuranceCharges":
                                                <PropertyColumn Title="Insurance Charges" Property="@(c => Math.Round(c.InsuranceCharges, DecimalPlaces))" />
                                                break;

                                            case "TotalTaxable":
                                                <PropertyColumn Title="Total Taxable" Property="@(c => Math.Round(c.TotalTaxable, DecimalPlaces))" />
                                                break;

                                            case "CGstRate":
                                                <PropertyColumn Title="CGST Rate" Property="@(c => Math.Round(c.CGstRate, DecimalPlaces))" />
                                                break;

                                            case "SGstRate":
                                                <PropertyColumn Title="SGST Rate" Property="@(c => Math.Round(c.SGstRate, DecimalPlaces))" />
                                                break;

                                            case "IGstRate":
                                                <PropertyColumn Title="IGST Rate" Property="@(c => Math.Round(c.IGstRate, DecimalPlaces))" />
                                                break;

                                            case "TotalCGSTAmount":
                                                <PropertyColumn Title="Total CGST Amount" Property="@(c => Math.Round(c.TotalCGSTAmount, DecimalPlaces))" />
                                                break;

                                            case "TotalSGSTAmount":
                                                <PropertyColumn Title="Total SGST Amount" Property="@(c => Math.Round(c.TotalSGSTAmount, DecimalPlaces))" />
                                                break;

                                            case "TotalIGSTAmount":
                                                <PropertyColumn Title="Total IGST Amount" Property="@(c => Math.Round(c.TotalIGSTAmount, DecimalPlaces))" />
                                                break;

                                            case "OtherCharges":
                                                <PropertyColumn Title="Other Charges" Property="@(c => Math.Round(c.OtherCharges, DecimalPlaces))" />
                                                break;

                                            case "TCSPercent":
                                                <PropertyColumn Title="TCS Percent" Property="@(c => Math.Round(c.TCSPercent, DecimalPlaces))" />
                                                break;

                                            case "TCSAmount":
                                                <PropertyColumn Title="TCS Amount" Property="@(c => Math.Round(c.TCSAmount, DecimalPlaces))" />
                                                break;

                                            case "GrandTotal":
                                                <PropertyColumn Title="Grand Total" Property="@(c => Math.Round(c.GrandTotal, DecimalPlaces))" />
                                                break;

                                            case "MainRemarks":
                                                <PropertyColumn Title="Main Remarks" Property="@(c => c.MainRemark)" />
                                                break;

                                            case "PayTerms":
                                                <PropertyColumn Title="Payment Terms" Property="@(c => c.PayTerms)" />
                                                break;

                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" Sortable="true" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" Sortable="true" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date" Property="@(c => c.ModifiedDate)" Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <TemplateColumn Title="Service Incoming/Service Outgoing" Context="c">
                                    @if (c.IncomingServics)
                                    {
                                        <span class="fw-bold text-success">Manufacturing</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-primary">Labour</span>
                                    }
                                </TemplateColumn>
                                <PropertyColumn Title="Invoice Number" Property="@(c => c.InvNo)" Sortable="true" />
                                <PropertyColumn Title="Invoice Date" Property="@(c => c.InvDate)" Sortable="true" />
                                <PropertyColumn Title="Customer Name" Property="@(c => c.CustVendorName)" Sortable="true" />
                                <PropertyColumn Title="No. of Items" Property="@(c => c.NoOfItems)" />
                                <PropertyColumn Title="Main Remarks" Property="@(c => c.MainRemark)" />
                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" Sortable="true" />
                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                            }

                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"ServiceBills/update/{c.ServiceId}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Service Bill">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"ServiceBills/details/{c.ServiceId}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View ServiceBill">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete ServiceBill"
                                                @onclick="() => HandleDelete(c.ServiceId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>
                }
                else
                {
                    <p class="text-center">No Service Bills found.</p>
                }
            </div>
        </div>
    </div>
}

@code {
    #region Declaration And Properties
    protected override string ScreenName => "Service Bills";

    private bool isProcessing = true;
    private string? searchText { get; set; } = string.Empty;
    private string? UserName;
    private int DeleteServiceID = 0;

    public List<GridColumn> Columns { get; set; } = new();
    private IEnumerable<ServiceBillsVM> ServiceBillsVMs = new List<ServiceBillsVM>();
    private int DecimalPlaces { get; set; } = 2;

        // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);


    // === Modal State ===
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    // Instant Search filter parameter
    [Parameter, SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> ServiceBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "CashFlow" },
        new PageHeader.BreadcrumbItem { Text = "Service Bills", IsLast = true }
    };

    private IEnumerable<ServiceBillsVM> filteredEnquiry =>
        ServiceBillsVMs.Where(c =>
            (string.IsNullOrWhiteSpace(searchText) ||
                (!string.IsNullOrWhiteSpace(c.InvNo) && c.InvNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(c.CustVendorName) && c.CustVendorName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(c.CreatedBy) && c.CreatedBy.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(c.ModifiedBy) && c.ModifiedBy.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            )
        );
#endregion

    #region Initialization
    protected override async Task OnInitializedAsync()
    {
        isProcessing = true;
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            DecimalPlaces =  await serviceBillsService.GetDecimalPlacesAsync();
            UserName = await _userService.GetUsernameAsync();

            //InstantSearch
            //Important : Deserialize Filter parameter from query string if exists
            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllServicesAsync();

            var savedPreferences = await _preferenceService.LoadPreferencesAsync("ServiceBills", UserName);
            if (savedPreferences?.Any() == true)
            {
                foreach (var col in Columns)
                {
                    var match = savedPreferences.FirstOrDefault(s => s.Field == col.Field);
                    if (match != null) col.IsVisible = match.IsVisible;
                }
            }

        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error initializing the OnInitializedAsync in ServiceBill page.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    #endregion

    #region Load All ServicesAsync
    private async Task LoadAllServicesAsync()
    {
        isProcessing = true;
        try
        {
            var result = await serviceBillsService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            ServiceBillsVMs = result.serviceBillsVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "LoadAllServicesAsync");
            await _js.ToastrError("Failed to load Service Bill list.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion

    #region Initialize Columns
    public async Task InitializeColumns(bool hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "Service ID", Field = "ServiceId", IsVisible = true },
                new() { Title = "Incoming or Outgoing", Field = "InOrOut", IsVisible = true },
                new() { Title = "Inv No", Field = "InvNo", IsVisible = true },
                new() { Title = "Inv Date", Field = "InvDate", IsVisible = false },
                new() { Title = "Customer ID", Field = "CustId", IsVisible = false },
                new() { Title = "Customer Name", Field = "CustName", IsVisible = false },
                new() { Title = "DC No", Field = "DCNO", IsVisible = false },
                new() { Title = "Dc Date", Field = "DCDate", IsVisible = false },
                new() { Title = "Currency Name", Field = "CurrName", IsVisible = false },
                new() { Title = "Today Value", Field = "TodayVal", IsVisible = false },
                new() { Title = "No of Items", Field = "NoOfItems", IsVisible = false },
                new() { Title = "Main Remarks", Field = "MainRemarks", IsVisible = false },
                new() { Title = "Payment Terms", Field = "PayTerms", IsVisible = false },
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = false },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = false },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false },
            };

            if (!hidden)
            {
                Columns.AddRange(new[]
                {
                    new GridColumn { Title = "Total Gross Amount", Field = "TotalGrossAmount", IsVisible = false },
                    new GridColumn { Title = "Discount Percent", Field = "DiscountPercent", IsVisible = false },
                    new GridColumn { Title = "Discount Amount", Field = "DiscountAmount", IsVisible = false },

                    new GridColumn { Title = "Total Basic Amount", Field = "TotalBasicAmount", IsVisible = false },

                    new GridColumn { Title = "Freight Charges", Field = "FreightCharges", IsVisible = false },

                    new GridColumn { Title = "Packing Percent", Field = "PackingPercent", IsVisible = false },
                    new GridColumn { Title = "Packing Charges", Field = "PackingCharges", IsVisible = false },

                    new GridColumn { Title = "Insurance Percent", Field = "InsurancePercent", IsVisible = false },
                    new GridColumn { Title = "Insurance Charges", Field = "InsuranceCharges", IsVisible = false },

                    new GridColumn { Title = "Total Taxable", Field = "TotalTaxable", IsVisible = false },

                    new GridColumn { Title = "CGST Rate", Field = "CGstRate", IsVisible = false },
                    new GridColumn { Title = "SGST Rate", Field = "SGstRate", IsVisible = false },
                    new GridColumn { Title = "IGST Rate", Field = "IGstRate", IsVisible = false },

                    new GridColumn { Title = "Total CGST Amount", Field = "TotalCGSTAmount", IsVisible = false },
                    new GridColumn { Title = "Total SGST Amount", Field = "TotalSGSTAmount", IsVisible = false },
                    new GridColumn { Title = "Total IGST Amount", Field = "TotalIGSTAmount", IsVisible = false },

                    new GridColumn { Title = "Other Charges", Field = "OtherCharges", IsVisible = false },

                    new GridColumn { Title = "TCS Percent", Field = "TCSPercent", IsVisible = false },
                    new GridColumn { Title = "TCS Amount", Field = "TCSAmount", IsVisible = false },

                    new GridColumn { Title = "Grand Total", Field = "GrandTotal", IsVisible = false },
                });
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "InitializeColumns");
            await _js.ToastrError("Failed to initialize grid columns.");
        }
    }
    #endregion

    #region Handle Column Change
    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "HandleColumnChange");
            await _js.ToastrError("Failed to update column preferences.");
        }
    }
    #endregion

    private void AddNewService()
    {
        _navigation.NavigateTo("ServiceBills/create");
    }

    #region Deleting Service Bill
    private async Task HandleDelete(int serviceId)
    {
        try
        {
            DeleteServiceID = serviceId;
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error initiating delete for serviceId: {serviceId}");
            await _js.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            bool deleted = await serviceBillsService.DeleteServiceByIdAsync(DeleteServiceID);
            if (deleted)
            {
                await _js.ToastrSuccess("Service Bill deleted successfully.");
                await LoadAllServicesAsync();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _js.ToastrWarning("Service Bill could not be deleted. It may not exist or have dependencies.");
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error deleting ServiceId: {DeleteServiceID}");
            await _js.ToastrError("Failed to delete servicebill.");
        }
        finally
        {
            DeleteServiceID = 0;
        }
    }
    #endregion

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _js.ToastrError("Failed to close modal. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _js.ToastrError("Failed to open modal. Please try again.");
        }
    }

    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllServicesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error applying search filters in Sales Order List");
            await _js.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion

    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllServicesAsync();
            }
        }
        catch (Exception ex)
        {

            await _logs.LogDeveloperError(ex, "Error navigating to first page in Service Bills List");
            await _js.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllServicesAsync();
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error navigating to previous page in Service Bills List");
            await _js.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllServicesAsync();
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error navigating to next page in Service Bills List");
            await _js.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllServicesAsync();
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error navigating to last page in Service Bills List");
            await _js.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllServicesAsync();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error changing page size in Service Bills List");
            await _js.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllServicesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error refreshing Service Bills List page");
            await _js.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion
}

