    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.ServiceId > 0)
            {
                await ServiceBillsService.DeleteAndResequenceAsync(rowToDelete, ServiceBillVM);

                ServiceBillVM.ServiceBillsSub = await ServiceBillsService.GetServiceSubByServiceIdAsync(ServiceBillVM.ServiceId);
            }
            else
            {
                ServiceBillVM.ServiceBillsSub.Remove(rowToDelete);

                if (!ServiceBillVM.ServiceBillsSub.Any())
                {
                    ServiceBillVM.ServiceBillsSub.Add(new ServiceBillsSubVM
                    {
                        ServiceId = ServiceBillVM.ServiceId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < ServiceBillVM.ServiceBillsSub.Count; i++)
                        ServiceBillVM.ServiceBillsSub[i].SlNo = i + 1;
                }
            }

            await _calculationService.UpdateTotalsAsync(ServiceBillVM);

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error confirming deletion for ServiceID: {ServiceBillVM.ServiceId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

