    {
        try
        {
            var lastRow = ServiceBillVM.ServiceBillsSub.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
