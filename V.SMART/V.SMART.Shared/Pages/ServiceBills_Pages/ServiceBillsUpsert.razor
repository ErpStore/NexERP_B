    #region ServiceBills Operations

    private async Task UpsertService()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            ServiceBillVM.ServiceBillsSub.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!ServiceBillVM.ServiceBillsSub.Any())
            {
                await _js.ToastrError("Cannot save a service without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in ServiceBillVM.ServiceBillsSub)
            {
                bool isValid = await ValidateServiceBillLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewService = ServiceBillVM.ServiceId == 0;
            if (isNewService)
            {
                if (!(await ServiceBillsService.CheckDuplicate(ServiceBillVM.InvNo)))
                {
                    await _js.ToastrError("Service Bill No already exists. Please use a different number.");
                    return;
                }
            }
            try
            {
                await ServiceBillsService.UpsertServiceAsync(ServiceBillVM);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewService)
                await _js.ToastrSuccess("Service Bill saved successfully.");
            else
                await _js.ToastrSuccess("ServiceBill updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/ServiceBills");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "UpsertServiceBill failed.");
            await _js.ToastrError("Error saving UpsertServiceBill.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateServiceBillLineAsync(ServiceBillsSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Unit Price must be greater than 0.");
                return false;
            }
            return true;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ValidateServiceBillLineAsync failed.");
            await _js.ToastrError("Error in Validate ServiceBillLine Async.");
            return false;
        }
    }

