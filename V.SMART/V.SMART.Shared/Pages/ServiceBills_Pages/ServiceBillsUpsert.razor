    #region On Po Selected Async
    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (ServiceBillVM.ServiceBillsSub == null)
            ServiceBillVM.ServiceBillsSub = new List<ServiceBillsSubVM>();

        int custId = ServiceBillVM.CustVendorId.Value;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            //var priceDict = await MfgPoService.GetBulkLastUnitPricesAsync(itemIds, custId);

            foreach (var item in selectedItems)
            {
                int itemId = item.TryGetValue("ItemId", out var itemIdVal) && int.TryParse(itemIdVal?.ToString(), out var id) ? id : 0;

                int? poSubId = item.TryGetValue("PoSubId", out var poSubVal) && int.TryParse(poSubVal?.ToString(), out var psId) ? psId : (int?)null;

                bool isIncoming = ServiceBillVM?.IncomingServics == true;

                // 🔹 Duplicate check
                bool exists = isIncoming
                    ? ServiceBillVM.ServiceBillsSub.Any(x => x.ItemId == itemId && x.RefPurchPoSubId == poSubId)
                    : ServiceBillVM.ServiceBillsSub.Any(x => x.ItemId == itemId && x.RefMfgPoSubId == poSubId);

                if (exists) continue;

                // 🔹 Common VM creation
                var subVm = new ServiceBillsSubVM
                {
                    ItemId = itemId,
                    RefPoNo = item.TryGetValue("PoNo", out var poNo) ? poNo?.ToString() : string.Empty,
                    TypeOfPo = "General PO",
                    RefPoDate = item.TryGetValue("PoDate", out var poDate) &&
                                DateTime.TryParse(poDate?.ToString(), out var parsedPoDate)
                                    ? parsedPoDate
                                    : (DateTime?)null,

                    ItemCode = item.TryGetValue("ItemCode", out var itemCode) ? itemCode?.ToString() : string.Empty,
                    ItemName = item.TryGetValue("ItemName", out var itemName) ? itemName?.ToString() : string.Empty,
                    MeasureUnit = item.TryGetValue("UOM", out var uom) ? uom?.ToString() : string.Empty,

                    Qty = item.TryGetValue("BalQty", out var qtyVal) && decimal.TryParse(qtyVal?.ToString(), out var qty)
                            ? qty : 0m,

                    BalQty = item.TryGetValue("BalQty", out var balQtyVal) && decimal.TryParse(balQtyVal?.ToString(), out var balQty)
                            ? balQty : 0m,

                    UnitPrice = item.TryGetValue("UnitPrice", out var unitPriceVal) && decimal.TryParse(unitPriceVal?.ToString(), out var price)
                            ? price : 0m,

                    ProjectNo = item.TryGetValue("ProjectNo", out var projectNo) ? projectNo?.ToString() : string.Empty,
                    IsEditable = true
                };

                // 🔹 Assign correct PO reference
                if (isIncoming)
                    subVm.RefPurchPoSubId = poSubId;
                else
                    subVm.RefMfgPoSubId = poSubId;

                ServiceBillVM.ServiceBillsSub.Add(subVm);

                await _calculationService.UpdateTotalsAsync(ServiceBillVM);
            }

            int slNo = 1;
            foreach (var row in ServiceBillVM.ServiceBillsSub)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _js.ToastrError("Error processing selected PoSelected items.");
        }
    }
