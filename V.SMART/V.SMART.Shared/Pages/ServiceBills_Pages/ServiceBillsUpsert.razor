    private async Task CancelItem(ServiceBillsSubVM rowToCancel)
    {
        if (rowToCancel == null) return;
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!rowToCancel.ItemCancel)
            {
                rowToCancel.ItemCancel = true;
                rowToCancel.ItemCancelReason = cancelReason;

                await ServiceBillsService.UpdateItemCancelAndAddorRevertAsync(rowToCancel, ServiceId.GetValueOrDefault(), ServiceBillVM.IncomingServics);
                await _logs.LogUserAction(
                username, machine, ip,
                screen: "Service Bills",
                action: $"Cancelled ServiceBills No: {ServiceBillVM.ServiceId} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }
            else
            {
                rowToCancel.ItemCancel = false;
                rowToCancel.ItemCancelReason = string.Empty;
                await ServiceBillsService.UpdateItemCancelAndAddorRevertAsync(rowToCancel, ServiceId.GetValueOrDefault(), ServiceBillVM.IncomingServics);
                await _logs.LogUserAction(
                username, machine, ip,
                screen: "ServiceBills",
                action: $"Reverted ServiceBill No: {ServiceBillVM.ServiceId} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }
            ServiceBillVM.ServiceBillsSub = await ServiceBillsService.GetServiceSubByServiceIdAsync(ServiceBillVM.ServiceId);
            await ResetSlno();

            // Update totals
            await _calculationService.UpdateTotalsAsync(ServiceBillVM);
            var toastMessage = rowToCancel.ItemCancel
                ? "Item cancelled successfully."
                : "Item has been reverted successfully.";

            await _js.ToastrSuccess(toastMessage);
            rowToCancel = null;
            cancelReason = string.Empty;

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrWarning(ex.Message);
        }
        catch (Exception ex)
        {
            rowToCancel = null;
            await _js.ToastrError("An error occurred while cancelling/reverting the Item in ServiceBills");
            await _logs.LogDeveloperError(ex, $"Item Cancel/Reverse failed for ServiceBillId: {ServiceBillVM.ServiceId}");
        }
        finally
        {
            rowToCancel = null;
            isProcessing = false;
        }
    }

