@page "/ServiceBills/create"
@page "/ServiceBills/update/{ServiceId:int}"

@using MudBlazor
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ICashFlowService
@using V.SMART.Shared.ViewModels.CashFlowViewModel.ServiceBillViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchPoVM

@inherits BaseUserRightsComponent


@inject ICalculationService _calculationService
@inject IServiceBillsService ServiceBillsService
@inject ILoggingService _logs
@inject NavigationManager _navigationManager
@inject IJSRuntime _js


<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="PO Details"
              Columns="@PoColumns"
              ColumnFields="@PoFields"
              HiddenColumns="@PoHiddenColumns"
              Data="@PoData"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="OnPoSelectedAsync">
</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isCustModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>


@if (isProcessing)
{
    <div class="position-fixed top-50 start-50 translate-middle d-flex align-items-center justify-content-center"
         style="width: 100vw; height: 100vh; background-color: rgba(255,255,255,0.5); z-index: 1050;">
        <img src="/_content/IQSMART.Shared/images/loading.gif" alt="Loading..." />
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{

    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if ((ServiceBillVM?.IsCancel ?? false))
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (ServiceBillVM.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }

            <PageHeader TitleText="@(ServiceBillVM.ServiceId > 0 ? "Update ServiceBill" : "Create ServiceBill")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@ServiceFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="ServiceBillVM" OnValidSubmit="UpsertService">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Incoming / Outgoing Toggle -->
                        <div class="col-12 col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex justify-content-around align-items-center">

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="IncomingSwitch"
                                               checked="@ServiceBillVM.IncomingServics"
                                               @onchange="(e) => OnIncomingToggle(e)"
                                               disabled="@(IsEditingMode)" />

                                        <label class="form-check-label fw-semibold @(ServiceBillVM.IncomingServics ? "text-danger" : "")"
                                               for="IncomingSwitch">
                                            <i class="bi bi-arrow-down-left"></i> Incoming Service
                                        </label>
                                    </div>

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="OutgoingSwitch"
                                               checked="@(!ServiceBillVM.IncomingServics)"
                                               @onchange="(e) => OnOutgoingToggle(e)"
                                               disabled="@(IsEditingMode)" />

                                        <label class="form-check-label fw-semibold @(!ServiceBillVM.IncomingServics ? "text-success" : "")"
                                               for="OutgoingSwitch">
                                            <i class="bi bi-arrow-up-right"></i> Outgoing Service
                                        </label>
                                    </div>

                                </div>
                                <ValidationMessage For="@(() => ServiceBillVM.IncomingServics)" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Customer Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Customer")'>
                                        <i class="bi bi-person-add me-1"></i> Add Customer
                                    </button>
                                </div>

                                <div class="card-body">

                                    <!-- Customer -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">

                                            @if (!IsEditingMode)
                                            {
                                                @if (!(ServiceBillVM.IncomingServics))
                                                {
                                                    <MudAutocomplete T="CustomerVM"
                                                                     Value="SelectedCustomer"
                                                                     ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                                     ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                                     SearchFunc="SearchCustomers"
                                                                     Dense="true"
                                                                     Variant="Variant.Outlined"
                                                                     Placeholder="Search Customer"
                                                                     Title="Search atleast 3 letters in Customer"
                                                                     Class="w-100 autocomplete-sm"
                                                                     MaxItems="50"
                                                                     Clearable="true"
                                                                     ResetValueOnEmptyText="true"
                                                                     Required="true"
                                                                     AvoidSubmit="true"
                                                                     Disabled="@IsSomeItemsTransMade" />
                                                }
                                                else
                                                {
                                                    <MudAutocomplete T="VendorVM"
                                                                     Value="SelectedVendor"
                                                                     ValueChanged="@(async c => await OnVendorChanged(c))"
                                                                     ToStringFunc="@(c => c?.VendorName ?? string.Empty)"
                                                                     SearchFunc="SearchVendors"
                                                                     Dense="true"
                                                                     Variant="Variant.Outlined"
                                                                     Placeholder="Search Vendors"
                                                                     Title="Search atleast 3 letters in Customer"
                                                                     Class="w-100 autocomplete-sm"
                                                                     MaxItems="50"
                                                                     Clearable="true"
                                                                     ResetValueOnEmptyText="true"
                                                                     Required="true"
                                                                     AvoidSubmit="true"
                                                                     Disabled="@IsSomeItemsTransMade" />
                                                }
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" @bind-value=ServiceBillVM.CustVendorName readonly />
                                            }

                                        </div>
                                    </div>

                                    <!-- Reference PO No -->
                                    @if (!IsEditingMode)
                                    {
                                        @if (PoData != null && PoData.Count > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Ref. PO</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <button type="button" class="btn btn-sm rounded-3" style="background-color:#000080; color:white;"
                                                            @onclick="ShowPoDetails">
                                                        PO Details
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }

                                    <!-- DC Number -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>DC No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-value="ServiceBillVM.DcNo" />
                                        </div>
                                    </div>


                                    <!-- DC Date -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label pt-1 text-dark">
                                            DC Date
                                        </label>
                                        <div class="col-sm-9">
                                            <InputDate class="form-control form-control-sm"
                                                       @bind-Value="ServiceBillVM.DcDate" />
                                            <ValidationMessage For="@(() => ServiceBillVM.DcDate)" />
                                        </div>
                                    </div>


                                    <!-- Mode Of Transport -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Mode Of Transport</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select @bind="ServiceBillVM.ModeofTrasnport"
                                                    class="form-select form-select-sm rounded-3 w-100">
                                                <option value="">--Select Mode Of Transport--</option>
                                                <option value="1">By Road</option>
                                                <option value="2">By Railway</option>
                                                <option value="3">By Airway</option>
                                                <option value="4">By Seaway</option>
                                            </select>
                                            <ValidationMessage For="@(() => ServiceBillVM.ModeofTrasnport)" />
                                        </div>
                                    </div>

                                    <!-- Vehicle No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Vehicle No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="ServiceBillVM.VehicleNo" />
                                            <ValidationMessage For="@(() => ServiceBillVM.VehicleNo)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- =================== Service Bills Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">ServiceBills Details</span>

                                    @if (ServiceBillVM.ServiceId > 0 && (CanCreate || CanEdit))
                                    {
                                        <div class="d-flex align-items-center gap-2">

                                            @if (ServiceBillVM.ServiceBillsSub == null ||
                                                                                !ServiceBillVM.ServiceBillsSub.Any(x => x.ItemCancel))
                                            {
                                                <!-- Cancel / Revert -->
                                                <button type="button"
                                                        class="btn btn-sm px-3 rounded-3 d-flex align-items-center
                                                                               @(ServiceBillVM.IsCancel ? "btn-success" : "btn-danger")"
                                                        @onclick="Cancel"
                                                        disabled="@ServiceBillVM.ShortClose">

                                                    @if (!ServiceBillVM.IsCancel)
                                                    {
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        <span>Cancel</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                        <span>Revert</span>
                                                    }
                                                </button>
                                            }

                                            <!-- Short Close / Re-Open -->
                                            <button type="button"
                                                    class="btn btn-sm px-3 rounded-3 d-flex align-items-center
                                                                   @(ServiceBillVM.ShortClose ? "btn-success" : "btn-warning")"
                                                    @onclick="() => AskToShortCloseAsync(ServiceBillVM)"
                                                    disabled="@ServiceBillVM.IsCancel">

                                                @if (!ServiceBillVM.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Close</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>

                                        </div>
                                    }

                                </div>

                                <div class="card-body">

                                    <!-- Service No -->
                                    <div class="mb-2 row">
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Service Bill No.</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <div class="input-group input-group-sm w-100 rounded-3">
                                                    <InputText class="form-control form-control-sm rounded-3"
                                                               placeholder="Incoming PO No."
                                                               maxlength="30"
                                                               @bind-Value="@ServiceBillVM.InvNo" />
                                                    <span class="input-group-text rounded-3">@ServiceBillVM.Suffix</span>
                                                </div>
                                                <ValidationMessage For="@(() => ServiceBillVM.InvNo)" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Service Bill Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Service Inv Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@ServiceBillVM.InvDate" />
                                            <ValidationMessage For="@(() => ServiceBillVM.InvDate)" />
                                        </div>
                                    </div>

                                    <!-- Currency -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Currency</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value="@ServiceBillVM.CurrId"
                                                    @onchange="OnCurrencyChanged"
                                                    disabled>
                                                @foreach (var currency in Currencies)
                                                {
                                                    <option value="@currency.CurrId">@currency.CurrName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Payment Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Payment Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="ServiceBillVM.PayTerms"></textarea>
                                            <ValidationMessage For="@(() => ServiceBillVM.PayTerms)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="ServiceBillVM.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => ServiceBillVM.MainRemark)" />
                                        </div>
                                    </div>

                                    <!-- Cancel Remarks -->
                                    @if (ServiceBillVM.IsCancel)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                          rows="1"
                                                          @bind="ServiceBillVM.CancelReason"
                                                          disabled></textarea>
                                                <ValidationMessage For="@(() => ServiceBillVM.CancelReason)" />
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <!-- Discount Toggle -->
                                        <div class="d-flex align-items-center">
                                            <label class="me-2 mb-0"><small>Discount : </small></label>
                                            <div class="btn-group btn-group-sm rounded-pill border" role="group" aria-label="Toggle Discount Rs and %">
                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountToggleRs"
                                                       @onchange='() => SetDiscountMode(true)'
                                                       checked="@ServiceBillVM.IsItemWiseDiscAmtOrPerReq" />
                                                <label class="btn btn-outline-primary rounded-start-pill" for="discountToggleRs">@ServiceBillVM.Symbol</label>

                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountTogglePercent"
                                                       @onchange='() => SetDiscountMode(false)'
                                                       checked="@(!ServiceBillVM.IsItemWiseDiscAmtOrPerReq)" />
                                                <label class="btn btn-outline-primary rounded-end-pill" for="discountTogglePercent">%</label>
                                            </div>
                                        </div>

                                        <!-- Add Item Button -->
                                        <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                            <i class="bi bi-plus-circle me-1"></i> Create New Item
                                        </button>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    @if (SelectedCustomer != null && SelectedCustomer.LineId)
                                                    {
                                                        <th style="width:70px;">Line NO.</th>
                                                    }
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:70px;">HSN</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:120px;">Qty</th>
                                                    <th style="width:120px;">Price</th>
                                                    <th style="width:130px;">Gross Amount</th>

                                                    @if (!ServiceBillVM.IsItemWiseDiscAmtOrPerReq)
                                                    {
                                                        <th style="width:110px;">Disc %</th>
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }

                                                    @if (SelectedCustomer?.TaxValidate == false)
                                                    {
                                                        @if (SelectedCustomer?.BusiType == "Local")
                                                        {
                                                            <th style="width:110px;">CGST %</th>
                                                            <th style="width:110px;">SGST %</th>
                                                        }
                                                        else if (SelectedCustomer?.BusiType == "InterState")
                                                        {
                                                            <th style="width:110px;">IGST %</th>
                                                        }
                                                    }
                                                    <th style="width:130px;">Basic Amount</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:110px;">Ref PO No.</th>
                                                    <th style="width:110px;">Ref PO Dt.</th>
                                                    <th style="width:110px;">PO Due Dt.</th>
                                                    <th style="width:110px;">Type of PO</th>
                                                    <th style="width:150px;">Cost-Center</th>

                                                    @if (!ServiceBillVM.IsCancel)
                                                    {
                                                        <th style="width:130px;">Item Cancel</th>
                                                    }
                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in ServiceBillVM.ServiceBillsSub)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Line No -->
                                                        @if (SelectedCustomer != null && SelectedCustomer.LineId)
                                                        {
                                                            <td>@subitem.LineId</td>
                                                        }
                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @if (subitem.IsEditable && ((subitem.RefMfgPoSubId == 0 || subitem.RefMfgPoSubId == null) && (subitem.RefPurchPoSubId == 0 || subitem.RefPurchPoSubId == null)))
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                         Value="subitem.SelectedItem"
                                                                                         ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                         ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                         SearchFunc="SearchItems"
                                                                                         Dense="true"
                                                                                         Variant="Variant.Outlined"
                                                                                         Placeholder="Search Item Code"
                                                                                         Title="Search Atleast 3 Letters in Item-Code"
                                                                                         Class="w-100 autocomplete-sm"
                                                                                         MaxItems="50" />
                                                                        <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.ItemCode
                                                                    }
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                                                                                && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                       Size="Size.Small"
                                                                                       Color="Color.Primary"
                                                                                       OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                       Edge="Edge.End"
                                                                                       Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.HsnCode</td>
                                                        <td>@subitem.MeasureUnit</td>

                                                        <!-- Qty -->
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Qty"
                                                                       step="any"
                                                                       title="Enter Quantity"
                                                                       @bind="subitem.Qty"
                                                                       @bind:event="oninput"
                                                                       @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.Qty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.Qty</span>
                                                            }
                                                        </td>

                                                        <!-- Unit Price -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm" step="any"  placeholder="Price" title="Enter Unit Price"
                                                                       @bind="subitem.UnitPrice" @bind:event="oninput"
                                                                       @bind:after='() => _calculationService.UpdateTotalsAsync(ServiceBillVM)' />
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>

                                                        <!-- Line Gross -->
                                                        <td>@FormatDecimal(subitem.LineGross)</td>

                                                        <!-- Discount -->
                                                        @if (!ServiceBillVM.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" step="any" placeholder="Disc %" title="Enter Discount %"
                                                                           @bind="subitem.LineDiscountPercent" @bind:event="oninput"
                                                                           @bind:after='() => OnLineDiscountPercentChanged(subitem)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountPercent)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountPercent)
                                                                }
                                                            </td>
                                                            <td>@FormatDecimal(subitem.LineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" step="any" placeholder="Disc Amt" title="Enter Discount Amount"
                                                                           @bind="subitem.LineDiscountAmount" @bind:event="oninput"
                                                                           @bind:after='() => _calculationService.UpdateTotalsAsync(ServiceBillVM)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountAmount)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountAmount)
                                                                }
                                                            </td>
                                                        }

                                                        <!-- Taxes -->
                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if (SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @onchange="e => OnTaxRateChanged(e, subitem)"
                                                                                value="@subitem.LineCGSTRate">
                                                                            <option value="" disabled selected>CGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineCGSTRate)
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @onchange="e => OnTaxRateChanged(e, subitem)"
                                                                                value="@subitem.LineSGSTRate">
                                                                            <option value="" disabled selected>SGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineSGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                            else if (SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @bind="subitem.LineIGSTRate" @bind:event="oninput"
                                                                                @bind:after='() => _calculationService.UpdateTotalsAsync(ServiceBillVM)'>
                                                                            <option value="" disabled selected>IGST %</option>
                                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineIGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                        }

                                                        <!-- Basic Amount -->
                                                        <td>@FormatDecimal(subitem.LineBasicAmount)</td>

                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.Remarks" class="form-control form-control-sm" placeholder="Enter Remarks" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.Remarks
                                                            }
                                                        </td>

                                                        <!-- Ref Po -->
                                                        <td>@subitem.RefPoNo</td>
                                                        <td>@subitem.RefPoDate?.ToString("dd/MM/yyyy")</td>
                                                        <td>@subitem.PoDueDate?.ToString("dd/MM/yyyy")</td>

                                                        <!--Typeof Po -->
                                                        <td>@subitem.TypeOfPo</td>

                                                        <!-- Cost Center -->
                                                        <td>
                                                            @subitem.ProjectNo
                                                        </td>

                                                        @if (!ServiceBillVM.IsCancel)
                                                        {
                                                            <td class="text-center align-middle">
                                                                <div class="form-check form-switch d-flex justify-content-center">
                                                                    <InputCheckbox @bind-Value="subitem.ItemCancel"
                                                                                   @bind-Value:event="onchange"
                                                                                   ValueChanged="@(async (value) => await OnItemCancelChanged(subitem))"
                                                                                   class="form-check-input border border-2 shadow-lg
                                                                                                    focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                                </div>
                                                                <ValidationMessage For="@(() => subitem.ItemCancel)"
                                                                                   class="text-danger fw-semibold small mt-2 d-block" />
                                                            </td>
                                                        }



                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            @if (!ServiceBillVM.IsCancel)
                                                            {
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                            @onclick="async () => await SaveRow(subitem)">
                                                                        <i class="bi bi-check-lg"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                            @onclick="async () => await CancelEdit(subitem, ServiceBillVM)">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                            @onclick="async () => await EditRowAsync(subitem)">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                            @onclick="async () => await RemoveRow(subitem)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                }
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (ServiceBillVM.ServiceBillsSub.Any())
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        @if (ServiceBillVM?.IncomingServics == false)
                                                        {
                                                            <td colspan="@(SelectedCustomer?.LineId == true ? 6 : 5)"
                                                                class="text-end fw-bold">
                                                                Totals:
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td colspan="5"
                                                                class="text-end fw-bold">
                                                                Totals:
                                                            </td>
                                                        }
                                                        <td>@ServiceBillVM.TotalQty</td>
                                                        <td>Avg: @FormatDecimal(ServiceBillVM.AvgUnitPrice)</td>
                                                        <td>@FormatDecimal(ServiceBillVM.TotalLineGross)</td>

                                                        @if (!ServiceBillVM.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td></td>
                                                            <td>@FormatDecimal(ServiceBillVM.TotalLineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@FormatDecimal(ServiceBillVM.TotalLineDiscountAmount)</td>
                                                        }

                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if (SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td></td>
                                                                <td></td>

                                                            }
                                                            else if (SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td></td>

                                                            }

                                                        }
                                                        <td>@FormatDecimal(ServiceBillVM.TotalLineBasicAmount)</td>
                                                        <td colspan="5"></td>
                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>

                                    @if (!ServiceBillVM.IsCancel)
                                    {
                                        <div class="mt-2 text-start">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- ===================Other Details Terms and Conditions ===================-->
                        <div class="col-12 col-lg-6 mb-3">
                            @*            <div class="card shadow-sm rounded-4 border-0">
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <!-- ================= Create New Terms Button ================= -->
                                                <div class="col-12 col-md-2 d-flex align-items-end">
                                                    <button type="button" class="btn btn-sm btn-success rounded-3 w-100" 
                                                            @onclick='() => OpenModal("Terms")'>
                                                        <i class="bi bi-plus-circle me-1"></i> New Terms
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div> *@
                        </div>

                        <!-- =================== Tax Details Section =================== -->
                        <div class="col-12 col-lg-6 mb-3">
                            <div class="card shadow-sm rounded-4 border-0 p-3">

                                <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Tax & Charges
                                </h6>

                                <!-- Total Gross -->
                                <div class="row mb-2 gx-3">
                                    <label for="TotalGross" class="col-5 col-md-4 col-form-label text-dark">
                                        <small>Total Gross</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input id="TotalGross"
                                               class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               value="@FormatDecimal(ServiceBillVM.TotalGrossAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Discount -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Discount</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="discountToggle" id="discountRs"
                                                   @onchange="() => SetDiscountType(true)"
                                                   checked="@ServiceBillVM.DiscAmtOrPer"
                                                   disabled="@(ServiceBillVM.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountRs">
                                                <small>@ServiceBillVM.Symbol</small>
                                            </label>

                                            <input type="radio" class="btn-check" name="discountToggle" id="discountPercent"
                                                   @onchange="() => SetDiscountType(false)"
                                                   checked="@(!ServiceBillVM.DiscAmtOrPer)"
                                                   disabled="@(ServiceBillVM.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountPercent"><small>%</small></label>
                                        </div>
                                    </div>

                                    <div class="col-3 col-md-5">
                                        @if (ServiceBillVM.DiscAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   @bind="ServiceBillVM.DiscountAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(ServiceBillVM)'
                                                   disabled="@(ServiceBillVM.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => ServiceBillVM.DiscountAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   @bind="ServiceBillVM.DiscountPercent"
                                                   @bind:after="OnDiscountPercentChanged"
                                                   disabled="@(ServiceBillVM.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => ServiceBillVM.DiscountPercent)" />
                                            <small class="text-muted d-block text-end">
                                                Amt: @FormatDecimal(ServiceBillVM.DiscountAmount)
                                            </small>
                                        }
                                    </div>
                                </div>

                                <!-- SubTotal -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>SubTotal</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               value="@FormatDecimal(ServiceBillVM.TotalBasicAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Freight Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Freight Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="ServiceBillVM.FreightCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(ServiceBillVM)' />
                                        <ValidationMessage For="@(() => ServiceBillVM.FreightCharges)" />
                                    </div>
                                </div>

                                <!-- P & F Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>P & F Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="packingToggle" id="packingToggleRs"
                                                   @onchange="() => SetPAndFType(true)" checked="@ServiceBillVM.PackingAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="packingToggleRs"><small>@ServiceBillVM.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="packingToggle" id="packingTogglePercent"
                                                   @onchange="() => SetPAndFType(false)" checked="@(!ServiceBillVM.PackingAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="packingTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (ServiceBillVM.PackingAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="ServiceBillVM.PackingCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(ServiceBillVM)' />
                                            <ValidationMessage For="@(() => ServiceBillVM.PackingCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="ServiceBillVM.PackingPercent"
                                                   @bind:after="() => OnPandFPercentChanged()" />
                                            <ValidationMessage For="@(() => ServiceBillVM.PackingPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(ServiceBillVM.PackingCharges) </small>
                                        }
                                    </div>
                                </div>

                                <!-- Insurance Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Insurance Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceToggleRs"
                                                   @onchange="() => SetInsuranceType(true)" checked="@ServiceBillVM.InsuranceAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="insuranceToggleRs"><small>@ServiceBillVM.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceTogglePercent"
                                                   @onchange="() => SetInsuranceType(false)" checked="@(!ServiceBillVM.InsuranceAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="insuranceTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (ServiceBillVM.InsuranceAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="ServiceBillVM.InsuranceCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(ServiceBillVM)' />
                                            <ValidationMessage For="@(() => ServiceBillVM.InsuranceCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="ServiceBillVM.InsurancePercent"
                                                   @bind:after="() => OnInsurancePercentChanged()" />
                                            <ValidationMessage For="@(() => ServiceBillVM.InsurancePercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(ServiceBillVM.InsuranceCharges)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Total Taxable -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Total Taxable</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               value="@FormatDecimal(ServiceBillVM.TotalTaxable)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Taxes (CGST/SGST/IGST) -->
                                @if (SelectedCustomer?.TaxValidate == false)
                                {
                                    <div class="mb-2">
                                        @if (SelectedCustomer?.BusiType == "Local")
                                        {
                                            <!-- CGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>CGST (%)</small></label>

                                                <div class="col-3 col-md-4">
                                                    @if (!ServiceBillVM.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="ServiceBillVM.CGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(ServiceBillVM.CGstRate)">
                                                            <option value="0">-- Select CGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => ServiceBillVM.CGstRate)" />
                                                    }
                                                </div>

                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(ServiceBillVM.TotalCGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>

                                            <!-- SGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>SGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!ServiceBillVM.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="ServiceBillVM.SGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(ServiceBillVM.SGstRate)">
                                                            <option value="0">-- Select SGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => ServiceBillVM.SGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(ServiceBillVM.TotalSGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                        else if (SelectedCustomer?.BusiType == "InterState")
                                        {
                                            <!-- IGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>IGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!ServiceBillVM.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="ServiceBillVM.IGstRate"
                                                                @bind:after="() => _calculationService.UpdateTotalsAsync(ServiceBillVM)"
                                                                disabled="@(SelectedCustomer?.TaxValidate == true)">
                                                            <option value="0">-- Select IGST % --</option>
                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => ServiceBillVM.IGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(ServiceBillVM.TotalIGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- TCS Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>TCS Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsToggleRs"
                                                   @onchange="() => SetTCSType(true)" checked="@ServiceBillVM.TCSAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="tcsToggleRs"><small>@ServiceBillVM.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsTogglePercent"
                                                   @onchange="() => SetTCSType(false)" checked="@(!ServiceBillVM.TCSAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="tcsTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (ServiceBillVM.TCSAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="ServiceBillVM.TCSAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(ServiceBillVM)' />
                                            <ValidationMessage For="@(() => ServiceBillVM.TCSAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="ServiceBillVM.TCSPercent"
                                                   @bind:after="() => OnTCSPercentChanged()" />
                                            <ValidationMessage For="@(() => ServiceBillVM.TCSPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @ServiceBillVM.TCSAmount</small>
                                        }
                                    </div>
                                </div>

                                <!-- Other Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Other Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="ServiceBillVM.OtherCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(ServiceBillVM)' />
                                        <ValidationMessage For="@(() => ServiceBillVM.OtherCharges)" />
                                    </div>
                                </div>

                                <!-- Round Off -->
                                <div class="row mb-2 gx-2 align-items-center">
                                    <div class="col-5 col-md-4 d-flex align-items-center">
                                        <small class="me-2 text-dark">Round Off</small>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="roundOffSwitch"
                                                   @bind="ServiceBillVM.IsRoundOffEnabled"
                                                   @bind:after="() => _calculationService.UpdateTotalsAsync(ServiceBillVM)">
                                            <label class="form-check-label" for="roundOffSwitch"></label>
                                        </div>
                                    </div>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               value="@FormatDecimal(ServiceBillVM.RoundOff)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Grand Total -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label fw-bold text-dark">
                                        <small>Grand Total</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                               value="@FormatDecimal(ServiceBillVM.GrandTotal)"
                                               readonly />
                                        @if (ServiceBillVM.CurrId > 1)
                                        {
                                            <div class="mt-1 text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @ServiceBillVM.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((ServiceBillVM.GrandTotal * ServiceBillVM.TodayVal).ToString("0.00"))
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Amount in Words -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Amount in Words</small></label>
                                    <div class="col-7 col-md-8 pt-1">
                                        @if (ServiceBillVM.CurrId > 1)
                                        {
                                            <small class="fw-bold text-success d-block">
                                                Converted Value in Rs: @FormatDecimal(ServiceBillVM.GrandTotal * ServiceBillVM.TodayVal)
                                            </small>
                                        }
                                        else
                                        {
                                            <strong>@NumberToWordsHelper.ConvertNumberToWords(ServiceBillVM.GrandTotal)</strong>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            @if (!ServiceBillVM.IsCancel)
                            {
                                <div class="col-6 col-md-3 mt-3">
                                    <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                        <i class="bi bi-floppy2-fill me-1"></i> @(ServiceBillVM.ServiceId > 0 ? "Update" : "Create")
                                    </button>
                                </div>
                            }
                        }

                        <div class="col-6 col-md-3 mt-3">
                            <SmartBackButton Url="/ServiceBills" />
                        </div>
                    </div>

