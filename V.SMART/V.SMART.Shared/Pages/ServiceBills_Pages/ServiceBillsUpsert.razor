    private async Task CancelEdit(ServiceBillsSubVM? item, ServiceBillsVM? parentService)
    {
        try
        {
            if (item == null || parentService == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentService.ServiceBillsSub.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CancelEdit failed for ServiceBillSubId: {item?.ServiceBillSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(ServiceBillsSubVM item)
    {
        try
        {
            if (ServiceBillVM.ServiceBillsSub.Count == 1 && item.ServiceBillSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if (item.ItemCancel)
            {
                await _js.ToastrWarning("This item has already been cancelled and cannot be removed.");
                return;
            }

            if ((item.Qty ?? 0) != (item.BalQty ?? 0) && item.ServiceId != 0)
            {
                await _js.ToastrWarning("This row cannot be deleted because some transactions are done.");
                return;
            }

            if (item.ItemId == 0)
            {
                ServiceBillVM.ServiceBillsSub.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!ServiceBillVM.ServiceBillsSub.Any())
                    ServiceBillVM.ServiceBillsSub = new List<ServiceBillsSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(ServiceBillVM);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"RemoveRow failed for ServiceBillSubId: {item?.ServiceBillSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

