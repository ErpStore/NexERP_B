@page "/"
@layout BlankLayout
@using V.SMART.Shared.Layout
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IMasterServices
@inject NavigationManager Nav
@inject ThemeStateService ThemeStateService
@inject ILoggingService LoggingService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject ICompanyService _companyService

<PageTitle>NexGenERP — Next-Generation Enterprise Resource Planning</PageTitle>

@if (isProcessing)
{
    <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;background:#03050E;">
        <div style="width:40px;height:40px;border:3px solid rgba(37,99,235,0.2);border-top-color:#2563EB;border-radius:50%;animation:ng-spin 0.7s linear infinite;"></div>
    </div>
}
else
{
    <div class="ng-home">

        <AuthorizeView>
            <NotAuthorized>

                <!-- ── NAV ─────────────────────────────────────── -->
                <nav class="ng-landing-nav @(navScrolled ? "ng-landing-nav--scrolled" : "")" id="erp-top-navbar">

                    <div class="ng-landing-brand" @onclick='() => ScrollTo("top")'>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="30" height="30">
                            <defs>
                                <linearGradient id="ng-h-logo" x1="0" y1="0" x2="1" y2="1">
                                    <stop offset="0%" stop-color="#2563EB"/>
                                    <stop offset="100%" stop-color="#7C3AED"/>
                                </linearGradient>
                            </defs>
                            <rect width="48" height="48" rx="11" fill="url(#ng-h-logo)"/>
                            <path d="M11 37V11h6.5l13.5 18.5V11H37v26h-6.5L17 18.5V37z" fill="rgba(255,255,255,0.95)"/>
                        </svg>
                        <span class="ng-landing-wordmark">NexGenERP</span>
                    </div>

                    <ul class="ng-landing-nav-links">
                        <li><button class="ng-landing-nav-link @(activeSection=="home"?"active":"")" @onclick='()=>ScrollTo("home")'>Platform</button></li>
                        <li><button class="ng-landing-nav-link @(activeSection=="services"?"active":"")" @onclick='()=>ScrollTo("services")'>Modules</button></li>
                        <li><button class="ng-landing-nav-link @(activeSection=="about"?"active":"")" @onclick='()=>ScrollTo("about")'>About</button></li>
                        <li><button class="ng-landing-nav-link @(activeSection=="contact"?"active":"")" @onclick='()=>ScrollTo("contact")'>Contact</button></li>
                    </ul>

                    <button class="ng-landing-signin-btn" @onclick="GoLogin">
                        <i class="bi bi-box-arrow-in-right"></i> Sign In
                    </button>

                </nav>

                <!-- ── HERO ────────────────────────────────────── -->
                <section class="ng-hero" id="home">
                    <div class="ng-hero-bg"></div>
                    <div class="ng-hero-grid"></div>

                    <div class="ng-hero-content ng-anim-fade-up">

                        <div class="ng-hero-eyebrow">
                            <i class="bi bi-shield-check-fill"></i>
                            ISO Compliant &bull; Manufacturing ERP &bull; GST Ready
                        </div>

                        <h1 class="ng-hero-title">
                            The Enterprise Platform<br />
                            <span class="ng-hero-title-accent">Built to Scale</span>
                        </h1>

                        <p class="ng-hero-subtitle">
                            Unify manufacturing, inventory, HR, and finance in one intelligent platform.
                            Designed for modern enterprises. Engineered for growth.
                        </p>

                        <div class="ng-hero-cta-row">
                            <button class="ng-cta-primary" @onclick="GoLogin">
                                <i class="bi bi-box-arrow-in-right"></i> Access Your Workspace
                            </button>
                            <button class="ng-cta-secondary" @onclick='()=>ScrollTo("services")'>
                                <i class="bi bi-grid-3x3-gap-fill"></i> Explore Modules
                            </button>
                        </div>

                        <div class="ng-stats-strip">
                            <div class="ng-stat-item">
                                <div class="ng-stat-value">12+</div>
                                <div class="ng-stat-label">ERP Modules</div>
                            </div>
                            <div class="ng-stat-divider"></div>
                            <div class="ng-stat-item">
                                <div class="ng-stat-value">500+</div>
                                <div class="ng-stat-label">Active Users</div>
                            </div>
                            <div class="ng-stat-divider"></div>
                            <div class="ng-stat-item">
                                <div class="ng-stat-value">99.9%</div>
                                <div class="ng-stat-label">Uptime SLA</div>
                            </div>
                            <div class="ng-stat-divider"></div>
                            <div class="ng-stat-item">
                                <div class="ng-stat-value">24/7</div>
                                <div class="ng-stat-label">Support</div>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- ── MODULES SECTION ─────────────────────────── -->
                <section class="ng-section" id="services" style="background:#03050E;">
                    <div style="max-width:1200px;margin:0 auto;">
                        <p class="ng-section-eyebrow">Complete Suite</p>
                        <h2 class="ng-section-title">Every Business Function,<br/>One Platform</h2>
                        <p class="ng-section-sub">From procurement to payroll — seamlessly integrated.</p>

                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-top:48px;">
                            @foreach (var s in _services)
                            {
                                <div class="ng-module-card" style="--ng-module-bg:@GetModuleBg(s.Ic);--ng-module-color:@GetModuleColor(s.Ic);">
                                    <div class="ng-module-icon-wrap">
                                        <i class="@s.Icon"></i>
                                    </div>
                                    <div class="ng-module-title">@s.Title</div>
                                    <div class="ng-module-desc">@s.Desc</div>
                                    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;">
                                        @foreach (var tag in s.Tags)
                                        {
                                            <span style="padding:2px 8px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);border-radius:100px;font-size:11px;color:rgba(255,255,255,0.45);">@tag</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <!-- ── ABOUT ───────────────────────────────────── -->
                <section class="ng-section" id="about" style="background:#05081A;">
                    <div style="max-width:1200px;margin:0 auto;">
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;">

                            <div>
                                <p class="ng-section-eyebrow">About NexGenERP</p>
                                <h2 class="ng-section-title">Built for<br/>Manufacturing Excellence</h2>
                                <p style="font-size:15px;color:rgba(255,255,255,0.45);line-height:1.7;margin-bottom:32px;">
                                    A comprehensive ERP platform purpose-built for manufacturing and trading enterprises.
                                    Unifying every business process — from sales enquiry to delivery, purchase to payment, HR to payroll.
                                </p>
                                <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;">
                                    @foreach (var feat in new[]{"12+ integrated business modules","Real-time inventory and stock tracking","Complete HR and payroll management","GST, e-Way Bill and compliance built-in","Works on web, desktop and mobile"})
                                    {
                                        <li style="display:flex;align-items:center;gap:10px;font-size:14px;color:rgba(255,255,255,0.65);">
                                            <span style="width:20px;height:20px;background:rgba(37,99,235,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                                <i class="bi bi-check2" style="font-size:12px;color:#60A5FA;"></i>
                                            </span>
                                            @feat
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                                @foreach (var (title, desc, icon, color) in new[]{
                                    ("Real-Time Analytics","Live dashboards with KPI tracking and business intelligence.","bi-speedometer2","#60A5FA"),
                                    ("Cloud Ready","Deploy on cloud or on-premise. Mobile and desktop support.","bi-cloud-check-fill","#34D399"),
                                    ("ISO Compliant","Industry standards with full audit trail and compliance reporting.","bi-shield-check-fill","#FBBF24"),
                                    ("24/7 Support","Dedicated support team available round the clock for all clients.","bi-headset","#A78BFA")
                                })
                                {
                                    <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:16px;padding:24px;">
                                        <i class="bi @icon" style="font-size:22px;color:@color;display:block;margin-bottom:12px;"></i>
                                        <div style="font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;color:#fff;margin-bottom:6px;">@title</div>
                                        <div style="font-size:13px;color:rgba(255,255,255,0.40);line-height:1.5;">@desc</div>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </section>

                <!-- ── CTA / CONTACT ───────────────────────────── -->
                <section class="ng-section" id="contact" style="background:#03050E;">
                    <div style="max-width:1200px;margin:0 auto;">
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;">

                            <div>
                                <p class="ng-section-eyebrow">Get in Touch</p>
                                <h2 class="ng-section-title">Ready to Transform<br/>Your Business?</h2>
                                <div style="display:flex;flex-direction:column;gap:20px;margin-top:32px;">
                                    @foreach (var (icon, label, val) in new[]{
                                        ("bi-geo-alt-fill","Headquarters","Bangalore, Karnataka, India"),
                                        ("bi-telephone-fill","Phone","+91 9844046791  ·  +91 9035046791"),
                                        ("bi-envelope-fill","Email","contactbspl@nexgenerp.com")
                                    })
                                    {
                                        <div style="display:flex;gap:14px;align-items:flex-start;">
                                            <div style="width:38px;height:38px;background:rgba(37,99,235,0.12);border:1px solid rgba(37,99,235,0.2);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                                <i class="bi @icon" style="color:#60A5FA;font-size:16px;"></i>
                                            </div>
                                            <div>
                                                <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.35);margin-bottom:3px;">@label</div>
                                                <div style="font-size:14px;color:rgba(255,255,255,0.7);">@val</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:24px;padding:40px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px;">
                                <div style="width:60px;height:60px;background:rgba(37,99,235,0.15);border-radius:18px;display:flex;align-items:center;justify-content:center;">
                                    <i class="bi bi-rocket-takeoff-fill" style="font-size:24px;color:#60A5FA;"></i>
                                </div>
                                <h4 style="font-family:'DM Sans',sans-serif;font-size:20px;font-weight:700;color:#fff;margin:0;letter-spacing:-0.02em;">
                                    Start Your Journey
                                </h4>
                                <p style="font-size:14px;color:rgba(255,255,255,0.45);margin:0;line-height:1.6;max-width:320px;">
                                    Access your personalised ERP workspace and take control of every business process.
                                </p>
                                <button class="ng-cta-primary" @onclick="GoLogin" style="width:100%;justify-content:center;margin-top:8px;">
                                    <i class="bi bi-box-arrow-in-right"></i> Login to NexGenERP
                                </button>
                                <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:rgba(255,255,255,0.30);">
                                    <i class="bi bi-shield-lock-fill"></i> Secure · Encrypted · Enterprise-Grade
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

            </NotAuthorized>
        </AuthorizeView>

        <!-- ── AUTHORIZED: WORKSPACE ───────────────────────────── -->
        <AuthorizeView Roles="Administrator,ERPAdmin,User">
            <Authorized>

                <div style="min-height:100vh;background:var(--ng-bg,#F0F4FA);font-family:'Inter',sans-serif;">

                    <!-- Workspace Header -->
                    <div style="background:var(--ng-surface-0,#fff);border-bottom:1px solid var(--ng-border-0,rgba(15,23,42,0.06));padding:24px 32px;display:flex;align-items:center;justify-content:space-between;gap:16px;">
                        <div>
                            <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--ng-text-tertiary,#64748B);margin-bottom:4px;">
                                Welcome back
                            </div>
                            <h1 style="font-family:'DM Sans',sans-serif;font-size:22px;font-weight:700;color:var(--ng-text-primary,#0F172A);margin:0;letter-spacing:-0.02em;">
                                @context.User.Identity?.Name
                            </h1>
                        </div>
                        <div style="display:flex;align-items:center;gap:12px;">
                            <div style="font-size:12px;color:var(--ng-text-tertiary,#64748B);">
                                <i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("ddd, MMM d · h:mm tt")
                            </div>
                            <button class="ng-cta-secondary" style="padding:8px 16px;font-size:13px;" @onclick="GoLogout">
                                <i class="bi bi-box-arrow-right"></i> Sign Out
                            </button>
                        </div>
                    </div>

                    <!-- Module Grid -->
                    <div style="padding:32px;">
                        <div style="margin-bottom:24px;">
                            <h2 style="font-family:'DM Sans',sans-serif;font-size:16px;font-weight:600;color:var(--ng-text-primary,#0F172A);margin:0 0 4px;letter-spacing:-0.01em;">
                                Business Modules
                            </h2>
                            <p style="font-size:13px;color:var(--ng-text-tertiary,#64748B);margin:0;">
                                Select a module to get started
                            </p>
                        </div>

                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;">
                            @foreach (var m in _modules)
                            {
                                var nav = m.Href;
                                <div style="background:var(--ng-surface-0,#fff);border:1px solid var(--ng-border-0,rgba(15,23,42,0.06));border-radius:12px;padding:20px;cursor:pointer;transition:all 0.18s ease;box-shadow:0 1px 3px rgba(15,23,42,0.04);"
                                     @onclick='() => Nav.NavigateTo(nav)'
                                     onmouseenter="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(15,23,42,0.10)';"
                                     onmouseleave="this.style.transform='';this.style.boxShadow='0 1px 3px rgba(15,23,42,0.04)';">
                                    <div style="width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:12px;background:@GetModuleBgLight(m.Ic);color:@GetModuleColor(m.Ic);">
                                        <i class="@m.Icon"></i>
                                    </div>
                                    <div style="font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;color:var(--ng-text-primary,#0F172A);margin-bottom:4px;">@m.Title</div>
                                    <div style="font-size:12px;color:var(--ng-text-tertiary,#64748B);line-height:1.4;">@m.Desc</div>
                                </div>
                            }
                        </div>
                    </div>

                </div>

            </Authorized>

            <NotAuthorized>
                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;gap:16px;text-align:center;padding:40px;">
                    <div style="width:56px;height:56px;background:rgba(37,99,235,0.1);border-radius:16px;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-shield-lock-fill" style="font-size:22px;color:#2563EB;"></i>
                    </div>
                    <h4 style="font-family:'DM Sans',sans-serif;font-size:18px;font-weight:600;color:#fff;margin:0;">Business Modules Require Login</h4>
                    <p style="font-size:14px;color:rgba(255,255,255,0.45);margin:0;">Sign in with your credentials to access the full ERP suite.</p>
                    <button class="ng-cta-primary" @onclick="GoLogin">
                        <i class="bi bi-box-arrow-in-right"></i> Login Now
                    </button>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <!-- ── FOOTER ──────────────────────────────────────────── -->
        <footer style="background:#03050E;border-top:1px solid rgba(255,255,255,0.05);padding:24px 48px;display:flex;align-items:center;justify-content:space-between;font-size:13px;color:rgba(255,255,255,0.3);">
            <span>&copy; @DateTime.Now.Year NexGenERP. All rights reserved.</span>
            <div style="display:flex;gap:20px;">
                <a href="mailto:contactbspl@nexgenerp.com" style="color:rgba(255,255,255,0.4);text-decoration:none;">Contact</a>
                <button style="background:none;border:none;color:rgba(255,255,255,0.4);cursor:pointer;font-size:13px;padding:0;" @onclick="GoLogin">Login</button>
            </div>
        </footer>

    </div>
}

<style>
    @@keyframes ng-spin { to { transform: rotate(360deg); } }
    .ng-home .ng-landing-nav-links { display: flex; }
    @@media (max-width: 768px) {
        .ng-home .ng-landing-nav-links { display: none; }
        .ng-section { padding: 60px 24px !important; }
        .ng-section > div > div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; gap: 40px !important; }
    }
</style>

<script>
    window.erpNavbarInit = function (dotNetRef) {
        const sections = ['home', 'services', 'about', 'contact'];
        function getActiveSection() {
            let current = 'home';
            for (const id of sections) {
                const el = document.getElementById(id);
                if (!el) continue;
                if (el.getBoundingClientRect().top <= 80) current = id;
            }
            return current;
        }
        function onScroll() {
            dotNetRef.invokeMethodAsync('OnScrollUpdate', window.scrollY > 20, getActiveSection());
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
    };
    window.erpScrollTo = function (id) {
        if (id === 'top') { window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
        const el = document.getElementById(id);
        if (!el) return;
        window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 72, behavior: 'smooth' });
    };
</script>

@code {
    private bool isProcessing;
    private bool isDark;
    private bool navScrolled;
    private bool mobileMenuOpen;
    private string activeSection = "home";
    private string? _companyLogoUrl;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            isDark = ThemeStateService.IsDarkMode;
            ThemeStateService.OnChange += ThemeChanged;
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Home page initialization failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("erpNavbarInit", DotNetObjectReference.Create(this));
            await LoadCompanyLogoAsync();
        }
    }

    private async Task LoadCompanyLogoAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                _companyLogoUrl = await _companyService.GetCompanyLogoUrlAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Failed to load company logo.");
            _companyLogoUrl = null;
        }
    }

    [JSInvokable]
    public void OnScrollUpdate(bool scrolled, string section)
    {
        navScrolled = scrolled;
        activeSection = section;
        InvokeAsync(StateHasChanged);
    }

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ThemeStateService.OnChange -= ThemeChanged;
    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private async Task ScrollTo(string id) { mobileMenuOpen = false; await JS.InvokeVoidAsync("erpScrollTo", id); }
    private void GoLogin() => Nav.NavigateTo("/login");
    private void GoLogout() => Nav.NavigateTo("/logout", true);

    private static string GetModuleBg(string ic) => ic switch {
        "ic-teal"   => "rgba(20,184,166,0.15)",
        "ic-amber"  => "rgba(217,119,6,0.15)",
        "ic-purple" => "rgba(124,58,237,0.15)",
        "ic-red"    => "rgba(220,38,38,0.15)",
        "ic-pink"   => "rgba(236,72,153,0.15)",
        "ic-green"  => "rgba(5,150,105,0.15)",
        "ic-blue"   => "rgba(8,145,178,0.15)",
        "ic-orange" => "rgba(234,88,12,0.15)",
        "ic-indigo" => "rgba(37,99,235,0.15)",
        "ic-cyan"   => "rgba(6,182,212,0.15)",
        "ic-lime"   => "rgba(101,163,13,0.15)",
        _           => "rgba(37,99,235,0.15)"
    };

    private static string GetModuleBgLight(string ic) => ic switch {
        "ic-teal"   => "#F0FDF9",
        "ic-amber"  => "#FFFBEB",
        "ic-purple" => "#F5F3FF",
        "ic-red"    => "#FEF2F2",
        "ic-pink"   => "#FDF2F8",
        "ic-green"  => "#ECFDF5",
        "ic-blue"   => "#F0FDFF",
        "ic-orange" => "#FFF7ED",
        "ic-indigo" => "#EFF6FF",
        "ic-cyan"   => "#ECFEFF",
        "ic-lime"   => "#F7FEE7",
        _           => "#EFF6FF"
    };

    private static string GetModuleColor(string ic) => ic switch {
        "ic-teal"   => "#14B8A6",
        "ic-amber"  => "#D97706",
        "ic-purple" => "#7C3AED",
        "ic-red"    => "#DC2626",
        "ic-pink"   => "#EC4899",
        "ic-green"  => "#059669",
        "ic-blue"   => "#0891B2",
        "ic-orange" => "#EA580C",
        "ic-indigo" => "#2563EB",
        "ic-cyan"   => "#06B6D4",
        "ic-lime"   => "#65A30D",
        _           => "#2563EB"
    };

    private readonly (string Title, string Desc, string Icon, string Ic, string[] Tags)[] _services =
    {
        ("Sales & Labour Work",
            "Customer enquiries, quotations, sales orders, labour work tracking and invoice management.",
            "bi bi-cart-check-fill", "ic-teal",
            new[] { "Sales", "Invoice", "Labour Work" }),
        ("Purchase & Subcontract",
            "Vendor management, purchase orders, subcontract processing and GRN tracking.",
            "bi bi-bag-check-fill", "ic-amber",
            new[] { "Purchase", "GRN", "Subcontract" }),
        ("Planning",
            "Production planning, route cards, material requirements and scheduling management.",
            "bi bi-calendar2-week-fill", "ic-purple",
            new[] { "Planning", "MRP", "Schedule" }),
        ("Production",
            "Shop floor control, job orders, BOM handling and manufacturing operations.",
            "bi bi-gear-wide-connected", "ic-red",
            new[] { "Production", "BOM", "WIP" }),
        ("Human Resource Management",
            "Employee records, attendance, leave, payroll and HR operations management.",
            "bi bi-people-fill", "ic-pink",
            new[] { "HRMS", "Payroll", "Attendance" }),
        ("Accounts & Finance",
            "Financial accounting, payments, receipts, ledger and cash flow monitoring.",
            "bi bi-cash-stack", "ic-green",
