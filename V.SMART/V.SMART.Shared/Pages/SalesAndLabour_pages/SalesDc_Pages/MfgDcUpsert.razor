    private async Task AskToShortCloseAsync(MfgDcVM mfgDcvm)
    {
        try
        {
            if (mfgDcvm == null)
            {
                await _js.ToastrError("Invalid Dc selected.");
                return;
            }

            if (mfgDcvm.DcTally)
            {
                await _js.ToastrWarning("This Manuafacturing Dc has already been completed. No further actions are allowed.");
                return;
            }

            if (mfgDcvm.DcCancel)
            {
                await _js.ToastrWarning("This Manuafacturing Dc has already been cancelled. No further actions are allowed.");
                return;
            }

            if (!mfgDcvm.DcShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Manuafacturing Dc?";
                btnText = "ShortClose";
                btnColor = "btn-danger";
                confirmation = "Short-Close";
                showCancelReasonBox = false;
            }
            else 
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Manuafacturing Dc?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "Short-Close";
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while AskToShortCloseAsync enquiry.");
            await _logs.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }

    }

    private async Task ShortClose()
    {
        if (MfgDcVMs == null)
        {
            await _js.ToastrError("No Manufacturing Dc selected.");
            return;
        }
        try
        {
            isProcessing = true;
            MfgDcVMs.DcShortClose = !MfgDcVMs.DcShortClose;
            await mfgDcService.UpdateMfgDcShortCloseAsync(MfgDcVMs);
            StateHasChanged();

            string msg = MfgDcVMs.DcShortClose
                 ? "Manufacturing Dc ShortClose Successfully!"
                 : "Manufacturing Dc ReOpen Successfully!";
            await _js.ToastrSuccess(msg);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while updating ShortClose.Manufacturing Dc");
            await _logs.LogDeveloperError(ex, "Error in ShortClose() Manufacturing Dc");
        }
        finally
        {
            isProcessing = false;
        }
    }

