    private async Task Cancel()
    {
        try
        {
            if(IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("Some Items Transaction Are Made!.. You Can't Cancel the Complete Sales DC");
                return;
            }

            if (!DcId.HasValue || DcId == 0)
            {
                await _js.ToastrWarning("MfgDc  cancel is not allowed before saving the Dc.");
                return;
            }

            if (MfgDcVMs.MfgDcSubVMs.Any(s => s.ItemCancel))
            {
                await _js.ToastrWarning("Dc cannot be cancelled — one or more items are already cancelled.");
                return;
            }

            if (MfgDcVMs.DcShortClose)
            {
                await _js.ToastrError("Sales Dc is already short closed. You can't cancel it.");
                return;
            }

            if(!string.IsNullOrEmpty(MfgDcVMs.EwayBillNo))
            {
                await _js.ToastrWarning("This Dc cannot be Cancel because Eway transactions are done.");
                return;
            }


            if(MfgDcVMs.DcCancel)
            {
                var subs =  await mfgDcService.GetDcDetailsSubByDcIdAsync(MfgDcVMs.DcId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    await mfgDcService.ValidateDcBalanceBeforeRevertAsync(sub);
                }
            }


            if (!MfgDcVMs.DcCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this DC?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this DC?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            MfgDcVMs= await mfgDcService.GetMfgDcByDcIdAsync(MfgDcVMs.DcId);
            await _js.ToastrWarning(ex.Message);
            await _logs.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the DC.Cancel method");
            await _logs.LogDeveloperError(ex, "Error in DC Sales Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

