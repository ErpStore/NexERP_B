@page "/MfgDc/create"
@page "/MfgDc/create/{CustId:int}"
@page "/MfgDc/update/{DcId:int}"


@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.IPurchaseSCNService
@using V.SMART.Shared.Data.OutSourcing.PurchaseGRN
@using V.SMART.Shared.Data.SalesAndLabour.SalesDC
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.SalesDCVM
@using MudBlazor

@inherits BaseUserRightsComponent
@inject ReportService reportService
@inject ICalculationService _calculationService
@inject IMfgDcService mfgDcService
@inject ILoggingService _logs
@inject IPurchaseSCNService _scnService
@inject ICostingService _CostingService

@inject NavigationManager _navigationManager
@inject IJSRuntime _js


<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="@(MfgDcVMs.IsPurchaseReturn?"GRN Details":"PO Details")"
              Columns="@(MfgDcVMs.IsPurchaseReturn?GRNColumns:PoColumns)"
              ColumnFields="@(MfgDcVMs.IsPurchaseReturn?GRNFields:PoFields)"
              HiddenColumns="@(MfgDcVMs.IsPurchaseReturn?GRNHiddenColumns:PoHiddenColumns)"
              Data="@(MfgDcVMs.IsPurchaseReturn?GRNData:PoData)"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="@(MfgDcVMs.IsPurchaseReturn?OnGRNSelectedAsync:OnPoSelectedAsync)">
</DetailsModal>


<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="900px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isCustModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                        refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }else if (ActiveModal == "RejectionRework")
    {
         <RejectionReworkDcModel isRejectReworkDetailsModelVisible=true DcId=@MfgDcVMs.DcId DcType="MfgDc" OnClose="CloseModal" />
    }else if (ActiveModal == "Eway")
    {
         <EwayDcListModel isDcListDetailsModelVisible=true CustId=@MfgDcVMs.CustId.Value Customer=@MfgDcVMs.CustName DcType="MfgDc" OnClose="CloseModal" />
    }

</MasterModal>


<style>
    .freeze-last-col {
  position: sticky;
  right: 0;
  background-color: #f8f9fa;
  z-index: 10;
}
</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if (MfgDcVMs.DcCancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (MfgDcVMs?.DcShortClose == true)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }

            <PageHeader TitleText="@(MfgDcVMs.DcId > 0 ? "Update Sales DC" : "Create Sales DC")"
                TitleIcon="bi bi-tag"
                Breadcrumbs="@DcFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="MfgDcVMs" OnValidSubmit="UpsertDC">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Correspondence Status -->
                        @if (MfgDcVMs.DcId > 0 && !string.IsNullOrWhiteSpace(MfgDcVMs.DcNo))
                        {
                            <CorrespondenceStatus ReferenceType="Manufacturing-Dc"
                                                    ReferenceId="@MfgDcVMs.DcId"
                                                    ReferenceTypeName="@MfgDcVMs.DcNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Customer Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3"
                                            @onclick='() => OpenModal("Customer")'>
                                        <i class="bi bi-person-add me-1"></i> Add Customer
                                    </button>
                                </div>

                                <div class="card-body">

                                    @if (!MfgDcVMs.IsPurchaseReturn)
                                    {
                                        <!-- Customer Autocomplete -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>M/S.*</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <MudAutocomplete T="CustomerVM"
                                                    Value="SelectedCustomer"
                                                    ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                    ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                    SearchFunc="SearchCustomers"
                                                    Dense="true"
                                                    Variant="Variant.Outlined"
                                                    Placeholder="Search Customer"
                                                    Title="Search atleast 3 letters in Customer"
                                                    Class="w-100 autocomplete-sm"
                                                    MaxItems="50"
                                                    Clearable="true"
                                                    ResetValueOnEmptyText="true"
                                                    Required="true"
                                                    AvoidSubmit="true"
                                                    Disabled="@IsSomeItemsTransMade" />
                                            </div>
                                        </div>

                                        <!-- Address -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Address</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                          rows="1" readonly>@MfgDcVMs?.CustAddress</textarea>
                                            </div>
                                        </div>

                                        <!-- Phone -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Phone No</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                       value="@MfgDcVMs?.ContactNo" readonly />
                                            </div>
                                        </div>

                                        <!-- GSTIN -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>GSTIN</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                       value="@MfgDcVMs?.CustGstNo" readonly />
                                            </div>
                                        </div>

                                        <!-- Contact Person -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Contact Person</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select class="form-select form-select-sm rounded-3 w-100"
                                                        @bind="@MfgDcVMs.KindofAttention">
                                                    <option disabled value="">Select Contact Person</option>
                                                    @foreach (var cp in contactPersons)
                                                    {
                                                        <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                    }
                                                </select>
                                                <ValidationMessage For="@(() => MfgDcVMs.KindofAttention)" />
                                            </div>
                                        </div>

                                        <!-- Shipping Address -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Shipping Address</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <div class="form-check form-switch d-flex align-items-center">
                                                    <input class="form-check-input" type="checkbox" id="SameAsShipping"
                                                           checked="@MfgDcVMs.IsSameAsShipping"
                                                           @onchange="OnShippingChange" />
                                                    <label class="form-check-label ms-2 fw-semibold" for="SameAsShipping">
                                                        Same as Shipping
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        @if (!MfgDcVMs.IsSameAsShipping)
                                        {
                                            <!-- Shipping To -->
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Shipping To</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <select value="@MfgDcVMs.ShippingId"
                                                            class="form-select form-select-sm rounded-3 w-100"
                                                            @onchange="OnConsigneeChangedAsync">
                                                        <option value="">Select Shipping Address</option>
                                                        @foreach (var consine in consineeAddress)
                                                        {
                                                            <option value="@consine.AltCustId">@consine.AltCustName</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            @if (MfgDcVMs.ShippingId > 0)
                                            {
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>Address</small>
                                                    </label>
                                                    <div class="col-12 col-lg-9">
                                                        <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                               value="@MfgDcVMs.ShippingAddress" readonly />
                                                    </div>
                                                </div>

                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>Contact No</small>
                                                    </label>
                                                    <div class="col-12 col-sm-9">
                                                        <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                               value="@MfgDcVMs.ShippingPhone" readonly />
                                                    </div>
                                                </div>

                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>GSTIN</small>
                                                    </label>
                                                    <div class="col-12 col-sm-9">
                                                        <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                               value="@MfgDcVMs.ShippingGstNo" readonly />
                                                    </div>
                                                </div>
                                            }
                                        }


                                    }
                                    else
                                    {
                                         <!-- Vendor/Supplier Autocomplete -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>M/S.*</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <MudAutocomplete T="VendorVM"
                                                                 Value="SelectedVendor"
                                                                 ValueChanged="@(async c => await OnVendorChanged(c))"
                                                                 ToStringFunc="@(c => c?.VendorName ?? string.Empty)"
                                                                 SearchFunc="SearchVendors"
                                                                 Dense="true"
                                                                 Variant="Variant.Outlined"
                                                                 Placeholder="Search Vendor/Supplier"
                                                                 Title="Search atleast 3 letters in Vendor"
                                                                 Class="w-100 autocomplete-sm"
                                                                 MaxItems="50"
                                                                 Clearable="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 Required="true"
                                                                 AvoidSubmit="true"
                                                                 Disabled="@IsSomeItemsTransMade" />
                                            </div>
                                        </div>
                                    }

                                    
                                    <!-- Mode Of Transport -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Mode Of Transport</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select @bind="MfgDcVMs.ModeofTrasnport"
                                                    class="form-select form-select-sm rounded-3 w-100">
                                               
                                                <option value="1">By Road</option>
                                                <option value="2">By Railway</option>
                                                <option value="3">By Airway</option>
                                                <option value="4">By Seaway</option>
                                            </select>
                                            <ValidationMessage For="@(() => MfgDcVMs.ModeofTrasnport)" />
                                        </div>
                                    </div>

                                    <!-- Vehicle No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Vehicle No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="MfgDcVMs.VehicleNo" />
                                            <ValidationMessage For="@(() => MfgDcVMs.VehicleNo)" />
                                        </div>
                                    </div>

                                    <!-- Transport From -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Transport From</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="MfgDcVMs.TransFrom" />
                                            <ValidationMessage For="@(() => MfgDcVMs.TransFrom)" />
                                        </div>
                                    </div>
                                    <!-- Transport TO -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Transport To</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="MfgDcVMs.TransTo" />
                                            <ValidationMessage For="@(() => MfgDcVMs.TransTo)" />
                                        </div>
                                    </div>


                                    <div class="accordion mb-3" id="transportAccordion">
                                        <div class="accordion-item border-0 shadow-sm rounded-3">
                                            <h2 class="accordion-header" id="headingTransport">
                                                <button class="accordion-button collapsed fw-semibold text-primary"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#collapseTransport"
                                                        aria-expanded="false"
                                                        aria-controls="collapseTransport">
                                                    <i class="bi bi-truck me-2"></i> Transport Details
                                                </button>
                                            </h2>
                                            <div id="collapseTransport"
                                                 class="accordion-collapse collapse"
                                                 aria-labelledby="headingTransport"
                                                 data-bs-parent="#transportAccordion">
                                                <div class="accordion-body">

                                                     <!-- Transport ID -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>Transport ID</small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind-Value="MfgDcVMs.TransId" />
                                                            <ValidationMessage For="@(() => MfgDcVMs.TransId)" />
                                                        </div>
                                                    </div>

                                                    <!-- Transport Doc No. -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>Transport Doc No.</small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind-Value="MfgDcVMs.TransDocNo" />
                                                            <ValidationMessage For="@(() => MfgDcVMs.TransDocNo)" />
                                                        </div>
                                                    </div>

                                                    <!-- Transport Name -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>Transport Name</small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind-Value="MfgDcVMs.TransName" />
                                                            <ValidationMessage For="@(() => MfgDcVMs.TransName)" />
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>


                    <!-- =================== Dc Detail =================== -->
                    <div class="col-12 col-lg-6 mb-2">
                        <div class="card h-100 shadow-sm">

                            <!-- Header -->
                            <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                <span class="fw-bold fs-6">Delivery Challan Details</span>

                                @if (MfgDcVMs.DcId > 0 && (CanCreate || CanEdit))
                                {
                                    <button type="button"
                                            class="btn btn-sm rounded-3 @(MfgDcVMs.DcCancel ? "btn-success" : "btn-danger")"
                                            @onclick="Cancel">

                                        @if (!MfgDcVMs.DcCancel)
                                        {
                                            <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                        }
                                    </button>

                                     <!-- Short Close / Reopen Button -->
                                    <button type="button"
                                            class="btn btn-sm rounded-3 @(MfgDcVMs.DcShortClose ? "btn-success" : "btn-warning")"
                                            @onclick="() => AskToShortCloseAsync(MfgDcVMs)"
                                            disabled="@MfgDcVMs.DcCancel">

                                        @if (!MfgDcVMs.DcShortClose)
                                        {
                                            <i class="bi bi-box-seam me-1"></i> <span>Short Close</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Re-Open</span>
                                        }
                                    </button>

                                }
                            </div>

                            <div class="card-body">

                                @* Only show if no PoReference Not In Sub *@
                                @if (MfgDcVMs?.MfgDcSubVMs == null || !MfgDcVMs.MfgDcSubVMs.Any(x => !string.IsNullOrEmpty(x.RefPoNo)))
                                {
                                     bool isDisabled = MfgDcVMs.DcId > 0;

                                    <div class="row g-2 mb-2 align-items-stretch">

                                        @if (!MfgDcVMs.IsPurchaseReturn && MfgDcVMs.MfgDcSubVMs.Any(x => !string.IsNullOrEmpty(x.ItemCode)))
                                        {
                                            <!-- Static WithoutPo DC Icon -->
                                           
                                            <div class="col-12 col-sm-6">
                                                <div class="card h-100 shadow-sm border-2 border-success bg-success-subtle">
                                                    <div class="card-body d-flex align-items-center justify-content-center">
                                                       @*  <i class="bi bi-check-circle-fill text-success me-2" style="font-size: 1.5rem;"></i> *@
                                                       <i class="bi @(MfgDcVMs.IsWithoutPoDc ? "bi-check-circle-fill text-success" : "bi-circle text-secondary") me-2"></i>
                                                        <span class="fw-semibold text-success">
                                                            WithoutPo DC
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if(!MfgDcVMs.IsPurchaseReturn)
                                        {
                                                 <!-- WithoutPo DC -->
                                                <div class="col-12 col-sm-6">
                                                    <div class="card h-100 shadow-sm border-2 @(MfgDcVMs.IsWithoutPoDc ? "border-success bg-success-subtle" : "border-light")"
                                                            style="cursor:@(isDisabled ? "not-allowed" : "pointer"); height:60px;"
                                                            @onclick="isDisabled ? null : (() => ToggleDc(true))">                           
                                                        <div class="card-body d-flex align-items-center justify-content-center">
                                                            <i class="bi @(MfgDcVMs.IsWithoutPoDc ? "bi-check-circle-fill text-success" : "bi-circle text-secondary") me-2"></i>
                                                            <span class="fw-semibold text-success">
                                                                WithoutPo DC
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                        }

                                        @if (!MfgDcVMs.IsWithoutPoDc && MfgDcVMs.MfgDcSubVMs.Any(x => !string.IsNullOrEmpty(x.ItemCode)))
                                        {
                                            <!-- Static Purchase Return DC Icon -->
                                            <div class="col-12 col-sm-6">
                                                <div class="card h-100 shadow-sm border-2 border-danger bg-danger-subtle">
                                                    <div class="card-body d-flex align-items-center justify-content-center">
                                                        <i class="bi bi-arrow-repeat text-danger me-2" style="font-size: 1.5rem;"></i>
                                                        <span class="fw-semibold text-danger">
                                                            Purchase Return DC
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if(!MfgDcVMs.IsWithoutPoDc)
                                        {
                                            <!-- Purchase Return DC -->
                                            <div class="col-12 col-sm-6">
                                                <div class="card h-100 shadow-sm border-2 @(MfgDcVMs.IsPurchaseReturn ? "border-danger bg-danger-subtle" : "border-light")"
                                                style="cursor:pointer"
                                                @onclick="() => ToggleDc(false)">
                                                    <div class="card-body d-flex align-items-center justify-content-center">
                                                        <i class="bi bi-arrow-repeat text-danger me-2"></i>
                                                        <span class="fw-semibold text-danger">
                                                            Purchase Return DC
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                    </div>
                                }

                                <div class="row mb-2">
                                    <div class="col-12 d-flex justify-content-end">
                                        <div class="form-check d-flex align-items-center gap-2">
                                                <input type="checkbox"
                                                    class="form-check-input"
                                                    style="border:2px solid #000;"
                                                    @bind="MfgDcVMs.IsManualDcNo" @onclick="()=>ToggleAutoDcNo()" readonly="@MfgDcVMs.DcId>0" />
                                            <label class="form-check-label text-dark">
                                                <small>Is Manual Dc No.</small>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dc No -->
                                <div class="mb-2 row">
                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                        <small>Dc No.</small>
                                    </label>
                                    <div class="col-12 col-sm-9">
                                        <div class="input-group input-group-sm flex-wrap w-100">
                                            <input type="text"
                                                   class="form-control form-control-sm rounded-start"
                                                   placeholder="Prefix"
                                                   maxlength="10"
                                                   @bind="MfgDcVMs.Prefix" />

                                            <input type="text"
                                                   class="form-control form-control-sm"
                                                   placeholder="Dc No."
                                                   @bind="MfgDcVMs.DcNo" readonly="@IsDcNoReadonly"/>

                                            <span class="input-group-text rounded-end">@MfgDcVMs.Suffix</span>
                                        </div>
                                        <ValidationMessage For="@(() => MfgDcVMs.Prefix)" />
                                        <ValidationMessage For="@(() => MfgDcVMs.DcNo)" />
                                        <ValidationMessage For="@(() => MfgDcVMs.Suffix)" />
                                    </div>
                                </div>

                                <!-- Dc Date -->
                                <div class="mb-2 row">
                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                        <small>DC Date</small>
                                    </label>
                                    <div class="col-12 col-sm-9">
                                        <InputDate class="form-control form-control-sm rounded-3"
                                                   @bind-Value="@MfgDcVMs.DcDate" />
                                        <ValidationMessage For="@(() => MfgDcVMs.DcDate)" />
                                    </div>
                                </div>

                                <!-- PO Details -->
                                @if (!MfgDcVMs.IsWithoutPoDc  && poPendingCount > 0 && !MfgDcVMs.IsPurchaseReturn )
                                {
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Ref. PO</small>
                                        </label>
                                        <div class="col-12 col-sm-9 position-relative">
                                            <button type="button"
                                                class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                @onclick="ShowPoDetails">
                                               <i class="bi bi-list-ul me-1"></i>  PO Details
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if (MfgDcVMs.IsPurchaseReturn && GRNPendingCount>0)
                                {
                                    @if (GRNPendingCount>0)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. GRN's</small>
                                            </label>

                                            <div class="col-12 col-sm-9">
                                                 <button type="button"
                                                    class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                    @onclick="ShowGRNDetails">
                                                   <i class="bi bi-list-ul me-1"></i>  GRN Details
                                                </button>

                                                <ValidationMessage For="@(() => MfgDcVMs.RefGRNId)" />
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            
                                            </label>

                                            <div class="col-12 col-sm-9">
                                                    <small class="text-danger">No Pending GRN's found</small>
                                            </div>
                                        </div>
                                    }
                                        
                                }else if(!MfgDcVMs.IsWithoutPoDc  && poPendingCount ==0)
                                {
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                           
                                        </label>
                                        <div class="col-12 col-sm-9 position-relative">
                                            <small class="text-danger">No Pending Po's found'</small>
                                        </div>
                                    </div>
                                        
                                }
                                    <!-- Issue From Store -->
                                <div class="mb-2 row">
                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                        <small>Issue From Store</small>
                                    </label>
                                    <div class="col-12 col-sm-9">
                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                id="MfgDc" value="@MfgDcVMs.IssueStoreId"
                                                @onchange="OnStoreChanged">
                                            <option value="0">--Select Store--</option>
                                            @foreach (var storeid in stores)
                                            {
                                                <option value="@storeid.StoreId">@storeid.StoreName</option>
                                            }
                                        </select>
                                        <ValidationMessage For="@(() => MfgDcVMs.IssueStoreId)" />
                                    </div>
                                </div>

                                <!-- Towards -->
                                <div class="mb-2 row">
                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                        <small>Towards</small>
                                    </label>
                                    <div class="col-12 col-sm-9">
                                        <textarea class="form-control form-control-sm rounded-3 w-100"
                                                  rows="1"
                                                  @bind="MfgDcVMs.Towards"></textarea>
                                        <ValidationMessage For="@(() => MfgDcVMs.Towards)" />
                                    </div>
                                </div>

                                <!-- Remarks -->
                                <div class="mb-2 row">
                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                        <small>Remarks</small>
                                    </label>
                                    <div class="col-12 col-sm-9">
                                        <textarea class="form-control form-control-sm rounded-3 w-100"
                                                  rows="1"
                                                  @bind="MfgDcVMs.MainRemarks"></textarea>
                                        <ValidationMessage For="@(() => MfgDcVMs.MainRemarks)" />
                                    </div>
                                </div>

                               

                                <!-- Sub Supply Type -->
                                <div class="mb-2 row">
                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                        <small>Sub Supply Type</small>
                                    </label>
                                    <div class="col-12 col-sm-9">
                                        <select @bind="MfgDcVMs.SubSuppType"
                                                class="form-select form-select-sm rounded-3 w-100">
                                            <option value="1">Supply</option>
                                            <option value="5">ForOwnUse</option>
                                            <option value="8">Others</option>
                                        </select>
                                        <ValidationMessage For="@(() => MfgDcVMs.SubSuppType)" />
                                    </div>
                                </div>

                                @if (MfgDcVMs.SubSuppType==8)
                                {
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Sub Supply Desc.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="MfgDcVMs.SubSupplyDesc"></textarea>
                                            <ValidationMessage For="@(() => MfgDcVMs.SubSupplyDesc)" />
                                        </div>
                                    </div>
                                }

                                <!-- E-Way Bill No -->
                                <div class="mb-2 row">
                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                        <small>E-Way Bill No</small>
                                    </label>
                                    <div class="col-12 col-sm-9">
                                        <input type="text"
                                               class="form-control form-control-sm rounded-3 w-100"
                                               @bind="MfgDcVMs.EwayBillNo" />
                                    </div>
                                </div>

                                <!-- E-Way Bill Date -->
                                <div class="mb-2 row">
                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                        <small>E-Way Bill Date</small>
                                    </label>
                                    <div class="col-12 col-sm-9">
                                        <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                   @bind-Value="MfgDcVMs.EwayBillDate" />
                                    </div>
                                </div>

                                <!-- Action Row -->
                                <div class="row align-items-end mb-2">
                                    <!-- Rejection Button -->
                                    @if (DcId > 0)
                                    {
                                        <div class="col-auto">
                                            <button type="button"
                                                    class="btn btn-sm btn-danger rounded-3"
                                                    @onclick='() => OpenModal("RejectionRework")'>
                                                <i class="bi bi-plus-circle me-1"></i> Rejections
                                            </button>
                                        </div>
                                    }

                                </div>

                            </div>
                        </div>
                    </div>


                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                               
                                <div class="card-header bg-primary-subtle text-dark">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                                        <!-- Title -->
                                        <span class="fw-bold fs-6">Item Details</span>

                                        <!-- Right Controls -->
                                        <div class="d-flex flex-wrap align-items-center gap-2">

                                            <!-- Add Item Button -->
                                             <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>

                                        </div>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                   @if (SelectedCustomer != null && SelectedCustomer.LineId)
                                                   {
                                                        <th style="width:70px;">Line NO.</th>
                                                   }
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:70px;">HSN</th>
                                                     @if(IsLabourCost)
                                                    {
                                                        <th style="width:100px;">Labour Cost</th>
                                                    }
                                                    <th style="width:120px;">Qty</th>
                                                    <th style="width:120px;">Bal Qty</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                   
                                                     <th style="width:100px;">Stock Qty</th>
                                                    @if (!MfgDcVMs.IsWithoutPoDc && !MfgDcVMs.IsPurchaseReturn)
                                                    {
                                                        <th style="width:110px;">PO BalQty</th>
                                                        <th style="width:110px;">Ref PO No.</th>
                                                        <th style="width:110px;">Ref PO Dt.</th>
                                                        <th style="width:110px;">PO Due Dt.</th>
                                                    }
                                                   
                                                     <th style="width:200px;">Remarks</th>
                                                    <th style="width:110px;">Type of PO</th>
                                                    <th style="width:150px;">Cost-Center</th>
                                                    <th style="width:150px;">Line Id</th>
                                                    <th style="width:130px;">Item Cancel</th>

                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in MfgDcVMs.MfgDcSubVMs)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Line No -->
                                                        @if (SelectedCustomer != null && SelectedCustomer.LineId)
                                                        {
                                                             <td>@subitem.LineId</td>
                                                        }

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @if (subitem.IsEditable  && (subitem.RefPoSubId == 0 || subitem.RefPoSubId == null) 
                                                                    && subitem.Qty.GetValueOrDefault() == subitem.BalQty && !MfgDcVMs.IsPurchaseReturn)
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                            Value="subitem.SelectedItem"
                                                                                            ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                            ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                            SearchFunc="SearchItems"
                                                                                            Dense="true"
                                                                                            Variant="Variant.Outlined"
                                                                                            Placeholder="Search Item Code"
                                                                                            Title="Search Atleast 3 Letters in Item-Code"
                                                                                            Class="w-100 autocomplete-sm"
                                                                                            MaxItems="50" />
                                                                        <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.ItemCode
                                                                    }
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                        Size="Size.Small"
                                                                                        Color="Color.Primary"
                                                                                        OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                        Edge="Edge.End"
                                                                                        Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.MeasureUnit</td>
                                                        <td>@subitem.HSNCode</td>
                                                         @if(IsLabourCost)
                                                         {
                                                              <td>@subitem.LabourCost</td>
                                                         }
                                                       

                                                        <!-- Qty -->
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                  <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Qty"
                                                                           title="Enter Quantity"
                                                                          
                                                                           @bind="subitem.Qty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" step="any" />
                                                                <ValidationMessage For="@(() => subitem.Qty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.Qty</span>
                                                            }
                                                        </td>

                                                        <td>@subitem.BalQty</td>

                                                        <!-- Unit Price -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm" placeholder="Price" title="Enter Unit Price"
                                                                        @bind="subitem.UnitPrice" step="any"/>
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>

                                                        <td class="text-danger">@subitem.StockQty</td>
                                                        
                                                        @if(!MfgDcVMs.IsWithoutPoDc && !MfgDcVMs.IsPurchaseReturn)
                                                        {
                                                            <td>@subitem.PoBalQty</td>
                                                            <td>@subitem.RefPoNo</td>
                                                            <td>@subitem.RefPoDate?.ToString("dd/MM/yyyy")</td>
                                                            <td>@subitem.PoDueDate?.ToString("dd/MM/yyyy")</td>

                                                        }
                                                       <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputTextArea @bind-Value="subitem.Remark"
                                                                   class="form-control form-control-sm"
                                                                   placeholder="Enter Remarks"
                                                                   readonly="@MfgDcVMs.IsPurchaseReturn" title="Enter NV in the Remarks for particulars that do not have invoice values" />
                                                                <ValidationMessage For="@(() => subitem.Remark)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.Remark
                                                            }
                                                        </td>
                                                       

                                                        <!--Typeof Po -->
                                                         <td>@subitem.TypeOfPo</td>
                                                        <!-- Cost Center -->
                                                        <td>
                                                            @subitem.ProjectNo
                                                        </td>

                                                        <td>
                                                            @subitem.LineId
                                                        </td>

                                                        <td class="text-center align-middle">

                                                            <div class="form-check form-switch d-flex justify-content-center">
                                                                <InputCheckbox 
                                                                @bind-Value="subitem.ItemCancel"
                                                                @bind-Value:event="onchange"
                                                                ValueChanged="@(async (value) => await OnItemCancelChanged(subitem))"
                                                                class="form-check-input border border-2 shadow-lg focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                            </div>
                                                            <ValidationMessage For="@(() => subitem.ItemCancel)" 
                                                                class="text-danger fw-semibold small mt-2 d-block" />
                                                        </td>

                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            @if (!MfgDcVMs.DcCancel)
                                                            {
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                            @onclick="async () => await SaveRow(subitem)">
                                                                        <i class="bi bi-check-lg"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                            @onclick="async () => await CancelEdit(subitem, MfgDcVMs)">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-primary btn-icon btn-sm" 
                                                                            title="Edit" 
                                                                            disabled="@subitem.ItemCancel"    
                                                                            @onclick="async () => await EditRowAsync(subitem)">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-danger btn-icon btn-sm"
                                                                            title="Delete" 
                                                                            disabled="@subitem.ItemCancel"
                                                                            @onclick="async () => await RemoveRow(subitem)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                }
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (MfgDcVMs.MfgDcSubVMs?.Any() == true && !MfgDcVMs.IsPurchaseReturn)
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        <td colspan="@(SelectedCustomer.LineId ? 6 : 5)" class="text-end fw-bold">
                                                            Totals:
                                                        </td>
                                                        <td>@MfgDcVMs.TotalQty</td>
                                                        <td>@MfgDcVMs.TotalBalQty</td>
                                                        <td>Avg: @FormatDecimal(MfgDcVMs.AverageUnitPrice)</td>
                                                        <td colspan="10"></td>

                                                    </tr>
                                                </tfoot>
                                            }
                                            else
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        <td colspan="@(MfgDcVMs.IsPurchaseReturn ? 6 : 5)" class="text-end fw-bold">
                                                            Totals:
                                                        </td>
                                                        <td>@MfgDcVMs.TotalQty</td>
                                                        <td>@MfgDcVMs.TotalBalQty</td>
                                                        <td>Avg: @FormatDecimal(MfgDcVMs.AverageUnitPrice)</td>
                                                        <td colspan="11"></td>

                                                    </tr>
                                                </tfoot>
                                            }


                                        </table>
                                    </div>

                                    @if(!MfgDcVMs.DcCancel  && MfgDcVMs.IsWithoutPoDc)
                                    {
                                        <div class="mt-2 text-start">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Action Buttons -->
                            @if (CanCreate || CanEdit)
                            {
                                @if(!MfgDcVMs.DcCancel)
                                {
                                    <div class="col-4 col-md-3 mt-3">
                                        <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                            <i class="bi bi-floppy2-fill me-1"></i> @(MfgDcVMs.DcId > 0 ? "Update" : "Create")
                                        </button>
                                    </div>
                                  
                                }
                            }

                            @if(MfgDcVMs.DcId>0 && string.IsNullOrEmpty(MfgDcVMs.EwayBillNo))
                            {
                                 <div class="col-4 col-md-3 mt-3">
                                    <button type="button" class="btn  btn-success w-100 rounded-3 rounded-3" @onclick='() => OpenModal("Eway")'>
                                        <i class="bi bi-person-add me-1"></i> E-Way
                                    </button>
                            
                                 </div>
                            }

                            <div class="col- col-md-3 mt-3">
                                <SmartBackButton Url="@($"/mfgDcList?currentPage={currentPage}")" />
                            </div>
                            
                        @if (CanCreate || CanEdit && DcId > 0)
                        {
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                    <i class="bi bi-printer me-1"></i>Print
                                </button>
                            </div>
                        }
                        </div>

                    </div>
                </EditForm>
            </div>
        </div>
    </div>
} 


@code {


    #region Parameters & Properties

    protected override string ScreenName => "Manufacturing DC";

    [Parameter] public int? DcId { get; set; }
    [Parameter] public int CustId { get; set; }

    private int screenCode { get; set; }

    private bool isProcessing = true;
    private MfgDcVM MfgDcVMs { get; set; } = new();
    private MfgDcSubVM? rowToDelete;
    private MfgDcSubVM? rowToCancel;

    private bool IsSomeItemsTransMade { get; set; } = false;

    private CustomerVM? SelectedCustomer;
    private List<Store> stores = new();

    private List<PurchaseGRN> purchGRN = new();

    string? pdfBase64;
    
    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private List<ContactPerson> contactPersons = new();
    private List<CustomerIndirect> consineeAddress = new();
    private List<string> fromLocations = new();
    private List<string> toLocations = new();

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private int poPendingCount = 0;

    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private bool IsPoModalVisible = false;
    private List<Dictionary<string, object>>? PoData;

    #region Grn
    private VendorVM? SelectedVendor;
    private int GRNPendingCount = 0;
    private bool IsGRNModalVisible = false;
    private List<Dictionary<string, object>>? GRNData;
    // 🔹 Visible Column Titles
    private List<string> GRNColumns = new()
    {
        "GRNSubId","GRN No", "Suffix", "GRN Date","ItemId",
        "Item Code", "Item Name", "UOM", "HSN Code",
        "Qty", "Bal Qty", "Unit Price","Stock Qty","CostCenterId",
        "Project No", "Remark"
    };

    // 🔹 Field Names (backend binding)
    private List<string> GRNFields = new()
    {
        "GRNSubId","GRNNo", "Suffix", "GRNDate","ItemId",
        "ItemCode", "ItemName", "UOM", "HSNCode",
        "Qty", "BalQty", "UnitPrice","StockQty","CostCenterId",
        "ProjectNo", "Remark"
    };

    // 🔹 Hidden Columns (IDs and internal refs)
    private List<string> GRNHiddenColumns = new()
    {
        "GRNSubId","ItemId", "CostCenterId"
    };

    #endregion

    // 🔹 Visible Column Titles
    private List<string> PoColumns = new()
    {
        "PoSubId", "IsOpenPo","Po No", "Suffix", "Po Date","LineId","ItemId",
        "Item Code", "Item Name", "UOM", "HSN Code",
        "Qty", "Bal Qty", "Unit Price","Stock Qty", "Po Due Date","CostCenterId",
        "Project No", "Remark","Customer"
    };

    // 🔹 Field Names (backend binding)
    private List<string> PoFields = new()
    {
        "PoSubId", "IsOpenPo","PoNo", "Suffix", "PoDate","LineId","ItemId",
        "ItemCode", "ItemName", "UOM", "HSNCode",
        "Qty", "BalQty", "UnitPrice","StockQty", "PoDuedate","CostCenterId",
        "ProjectNo", "Remark","Customer"
    };

    // 🔹 Hidden Columns (IDs and internal refs)
    private List<string> PoHiddenColumns = new()
    {
        "PoSubId","ItemId", "CostCenterId"
    };

    private List<PageHeader.BreadcrumbItem> DcFormBreadcrumbs = new()
    {
        new() { Text = "Sales" },
        new() { Text = "DC-Outgoing", IsLast = true }
    };

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private int DecimalPlaces { get; set; } = 2;
    private bool IsLabourCost { get; set; } = false;

    #endregion

    public bool IsDcNoReadonly =>!(MfgDcVMs.IsManualDcNo ?? false) || DcId == 0;
    private async Task ToggleAutoDcNo()
    {
        if (MfgDcVMs.IsManualDcNo??false)
        {
            MfgDcVMs.DcNo = await mfgDcService.GetDcOutgoingNoAsync(MfgDcVMs.Suffix);
        }
    }


    #region  ToggleDc

    private async Task ToggleDc(bool isWithoutPo)
    {
        if (isWithoutPo)
        {
            // If already selected, unselect
            if (MfgDcVMs.IsWithoutPoDc)
            {
                MfgDcVMs.IsWithoutPoDc = false;
            }
            else
            {
                MfgDcVMs.IsWithoutPoDc = true;
                MfgDcVMs.IsPurchaseReturn = false;

            }
        }
        else
        {
            if (MfgDcVMs.IsPurchaseReturn)
            {
                MfgDcVMs.IsPurchaseReturn = false;

            }
            else
            {
                MfgDcVMs.IsPurchaseReturn = true;
                MfgDcVMs.IsWithoutPoDc = false;

            }
        }
    }

