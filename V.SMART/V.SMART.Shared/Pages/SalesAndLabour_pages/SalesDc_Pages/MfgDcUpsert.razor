    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            DecimalPlaces = await mfgDcService.GetDecimalPlacesAsync();
            screenCode = await mfgDcService.GetScreenCodeByScreenNameAsync(ScreenName);
            IsLabourCost = await _CostingService.IsLabourChargesDisplayEnabledAsync();

            if (DcId.HasValue)
            {
                await LoadExistingDc(DcId.Value);
            }
            else if (CustId > 0)
            {
                await InitializeNewDc(CustId);
            }
            MfgDcVMs.ModeofTrasnport = 1;
            MfgDcVMs.SubSuppType = 1;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingDc(int dcId)
    {
        try
        {
            MfgDcVMs = await mfgDcService.GetMfgDcByDcIdAsync(dcId);
            if (MfgDcVMs == null)
            {
                await _js.ToastrWarning("DC not found.");
                return;
            }

            if(!MfgDcVMs.IsPurchaseReturn)
            {
                SelectedCustomer = await mfgDcService.GetCustomerByIdAsync(MfgDcVMs.CustId.Value);
                if (SelectedCustomer != null)
                    await ApplyCustomerSelectionAsync(SelectedCustomer);
            }else
            {
                SelectedVendor = await _scnService.GetVendorByIdAsync(MfgDcVMs.VendorCode.Value);
                if (SelectedVendor != null)
                    await ApplyVendorSelectionAsync(SelectedVendor);
            }



            decimal stockqty = 0;
            foreach (var dcSub in MfgDcVMs.MfgDcSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[dcSub.ItemId.Value] =
                    await mfgDcService.GetCorrespondenceAttachmentsCountAsync(dcSub.ItemId.Value, "Item");

                if (!string.IsNullOrWhiteSpace(dcSub.RcSubIds))
                {
                    var ids = dcSub.RcSubIds.Replace("'", "")
                        .Split(',', StringSplitOptions.RemoveEmptyEntries);

                    foreach (var rcSubId in ids)
                    {
                        if (int.TryParse(rcSubId, out int rcsubid))
                        {
                            stockqty += await mfgDcService.GetAvailableStockByItemIdAndRcAndScreenAsync(dcSub.ItemId!.Value,MfgDcVMs.IssueStoreId,rcsubid);
                        }
                    }
                    dcSub.StockQty = stockqty;
                }
                else
                {
                    dcSub.StockQty = await mfgDcService.GetStockQtyFromStockManager(dcSub.ItemId.Value, MfgDcVMs.IssueStoreId.Value);
                }
                  if(IsLabourCost)
                  {
                      if (dcSub.UnitPrice < dcSub.LabourCost)
                      {
                          _js.ToastrWarning(
                              $"Unit Price ({dcSub.UnitPrice:0.00}) Is less than Labour Cost ({dcSub.LabourCost:0.00})."
                          );
                      }
                      else if(dcSub.UnitPrice > dcSub.LabourCost)
                      {
                          _js.ToastrWarning(
                          $"Unit Price ({dcSub.UnitPrice:0.00}) Is  Greater than than Labour Cost ({dcSub.LabourCost:0.00})."
                      );

                      }

                  }

            }

            //Check Transaction Completed flag
            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load Existing DC.");
            await _logs.LogDeveloperError(ex, $"LoadExistingDc failed for DcId: {DcId}");
        }
    }

    private bool CheckIsTransMade()
    {
        var list = MfgDcVMs?.MfgDcSubVMs;
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalQty += list[i].Qty.GetValueOrDefault();
            totalBalQty += list[i].BalQty;
        }

        return totalQty != totalBalQty;
    }

    private async Task InitializeNewDc(int custId)
    {
        try
        {
            var customer = await mfgDcService.GetCustomerByIdAsync(custId);
            if (customer != null)
                await ApplyCustomerSelectionAsync(customer);

            MfgDcVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            MfgDcVMs.Prefix = await mfgDcService.GetPrefixFromDb();
            MfgDcVMs.DcNo = await mfgDcService.GetDcOutgoingNoAsync(MfgDcVMs.Suffix);

            var MapStoreForDc = await mfgDcService.GetMappedStoreForFormAsync("SalesDCForm");

            if (MapStoreForDc.StoreId > 0)
            {
                MfgDcVMs.IssueStoreId = MapStoreForDc.StoreId;
                MfgDcVMs.StoreName = MapStoreForDc.StoreName;
            }

        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new po.");
            await _logs.LogDeveloperError(ex, $"InitializeNewPo failed for CustId: {custId}");
        }
    }

