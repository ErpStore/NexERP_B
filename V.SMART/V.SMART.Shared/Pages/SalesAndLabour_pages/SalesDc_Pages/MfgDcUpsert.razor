    private async Task UpsertDC()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            MfgDcVMs.MfgDcSubVMs.RemoveAll(x =>!x.ItemId.HasValue && (x.Qty<=0) && (x.UnitPrice<=0));

            if (!MfgDcVMs.MfgDcSubVMs.Any())
            {
                await _js.ToastrWarning("Cannot save a DC without valid items.");
                return;
            }

            bool main = await ValidateMainTable();
            if (!main) return;

            // Validate each line
            foreach (var line in  MfgDcVMs.MfgDcSubVMs)
            {
                bool isValid = await ValidateDcLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewDc = MfgDcVMs.DcId == 0;
             if(isNewDc)
             {
                 var isduplicate = await mfgDcService.IsDuplicateDcNoAsync(MfgDcVMs.DcNo, MfgDcVMs.Suffix, MfgDcVMs.DcId, MfgDcVMs.CustId);

                 if (isduplicate)
                 {
                     await _js.ToastrWarning("This DC number already exists for the selected customer. Please verify and try again.");
                     return;
                 }
             }

            try
            {
                await mfgDcService.UpsertDCAsync(MfgDcVMs,screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewDc)
                await _js.ToastrSuccess("Sales DC saved successfully.");
            else
                await _js.ToastrSuccess("Sales DC updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/mfgDcList");
        }

        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "UpsertDc failed.");
            await _js.ToastrError("Error saving Sales DC.");
        }
        finally
        {
            isProcessing = false;
        }
    }

