    private async Task<bool> ValidateDcLineAsync(MfgDcSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrWarning("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _js.ToastrWarning($"Item {line.ItemCode}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrWarning($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            if (!MfgDcVMs.IsPurchaseReturn)
            {
                if(string.IsNullOrEmpty(SelectedCustomer.LineId.ToString()))
                {
                    await _js.ToastrWarning($"Item {line.ItemCode}: Line No is Required");
                    return false;
                }
            }
            

            // Qty vs PO / Already Transacted validation
            decimal qtyOut = 0, stkqty = 0;
            int RefPoSubId = 0;
            int.TryParse(line.RefPoSubId.ToString(), out RefPoSubId);

            if (line.DcSubId == 0)
            {
                if (RefPoSubId>0)
                {
                    var isOpenPo = await mfgDcService.IsOpenPoAsync(line.RefPoSubId.Value);
                    var poBalQty = await mfgDcService.GetPoItemBalQtyFromPoSubId(line.RefPoSubId.Value);

                    decimal rcstockqty = 0;
                    if (line.RcSubIds != "" && line.RcSubIds != null)
                    {
                        var ids = line.RcSubIds.Replace("'", "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                        foreach (var rcid in ids)
                        {
                            int.TryParse(rcid.ToString(), out int rsubid);
                            rcstockqty = rcstockqty + await mfgDcService.GetAvailableStockByItemIdAndRcAndScreenAsync(line.ItemId.Value, MfgDcVMs.IssueStoreId.Value, rsubid);
                        }
                    }
                    var stockDict = (line.RcSubIds != "" && line.RcSubIds != null) ? rcstockqty : await mfgDcService.GetStockQtyFromStockManager(line.ItemId.Value, MfgDcVMs.IssueStoreId.Value);

                    decimal.TryParse(stockDict.ToString(), out stkqty);
                    decimal possibleQty = Math.Min(stkqty, poBalQty);


                    if (!isOpenPo && (line.Qty > possibleQty))
                    {
                        line.Qty = possibleQty;
                        line.BalQty = possibleQty;
                        await _js.ToastrWarning($"Qty {line.Qty} cannot exceed Available Po Bal Qty ({possibleQty}). " + $"[Stock Qty: {stkqty}");
                        return false;
                    }

                }

            }
            else if (line.DcSubId > 0)
            {
                var original = await mfgDcService.GetDcSubItemDetailByDcSubIdAsync(line.DcSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty;
                    decimal origQty = original.Qty.GetValueOrDefault();
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ValidatePOLineAsync failed.");
            await _js.ToastrError("Error Validate Manufacturing-PO line.");
            return false;
        }
    }

