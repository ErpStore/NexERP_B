    private async Task ApplyCustomerSelectionAsync(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;
            MfgDcVMs.CustId = customer?.CustId ?? 0;
            MfgDcVMs.CustName = customer?.CustName;
            MfgDcVMs.CustAddress = customer?.CustAddr;
            MfgDcVMs.CustGstNo = customer?.GSTNo;
            MfgDcVMs.ContactNo = customer?.ContactNo;

            if (customer == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                stores.Clear();
                return;
            }

            contactPersons = await mfgDcService.GetContactPersonsAsync(customer.CustId);
            consineeAddress = await mfgDcService.GetConsigneeAddressesAsync(customer.CustId);

            stores = (await mfgDcService.GetAllActiveStoresAsync()).ToList();



            MfgDcVMs.KindofAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPersonName : string.Empty;

            //Pending PoDetails
            poPendingCount = await mfgDcService.GetPendingPoCountAsync(customer.CustId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {customer?.CustId}");
            await _js.ToastrError("Failed to apply customer selection. Please try again.");
        }
    }

    private async Task OnShippingChange(ChangeEventArgs e)
    {
        try
        {
            MfgDcVMs.IsSameAsShipping = (bool)e.Value;

            if (!MfgDcVMs.IsSameAsShipping && SelectedCustomer != null)
            {
                consineeAddress = await mfgDcService.GetConsigneeAddressesAsync(SelectedCustomer.CustId);
            }
            else
            {
                consineeAddress.Clear();
                ResetShippingDefaults();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex,$"Error while toggling shipping address for CustId={SelectedCustomer?.CustId}");
        }
    }

    private void ResetShippingDefaults()
    {
        MfgDcVMs.ShippingId = null;
        MfgDcVMs.ShippingName = null;
        MfgDcVMs.ShippingAddress = null;
        MfgDcVMs.ShippingGstNo = null;
        MfgDcVMs.ShippingPhone = null;
    }

    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                MfgDcVMs.IsSameAsShipping = true; 
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }

            MfgDcVMs.IsSameAsShipping = false; 

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltCustId == selectedId);
            if (selectedConsignee == null)
                return;

            MfgDcVMs.ShippingId = selectedConsignee.AltCustId;
            MfgDcVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltCustAddr1, selectedConsignee.AltCustAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            MfgDcVMs.ShippingGstNo = selectedConsignee.GSTNo ?? string.Empty;
            MfgDcVMs.ShippingPhone = selectedConsignee.ContactNo ?? string.Empty;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

