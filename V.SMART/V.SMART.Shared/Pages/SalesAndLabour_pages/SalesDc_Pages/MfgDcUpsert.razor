    private async Task OnItemChanged(MfgDcSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItem = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.HSNCode = item.HSNCode;
                subitem.MeasureUnit = item.MeasureUnit;
                subitem.LabourCost = item.AssemblyPrice;

                if (MfgDcVMs?.CustId != null && subitem.ItemId.HasValue)
                {
                    var rates = await mfgDcService.GetBulkLastUnitPricesAsync(
                        new List<int> { subitem.ItemId.Value },
                        MfgDcVMs.CustId.Value
                    );

                    if (rates.TryGetValue(subitem.ItemId.Value, out decimal rate))
                    {
                        subitem.UnitPrice = rate;
                    }
                }

                if (subitem.ItemId > 0)
                {
                    var count = await mfgDcService.GetCorrespondenceAttachmentsCountAsync(subitem.ItemId.Value, "Item");
                    attachmentCounts[subitem.ItemId.Value] = count;
                    
                    if (MfgDcVMs.IsWithoutPoDc)
                    {
                        subitem.StockQty = await mfgDcService.GetStockQtyFromStockManager(subitem.ItemId.Value, MfgDcVMs.IssueStoreId.Value);
                    }
                      if(IsLabourCost)
                       {
                           if (subitem.UnitPrice < subitem.LabourCost)
                           {
                               _js.ToastrWarning(
                                   $"Unit Price ({subitem.UnitPrice:0.00}) Is less than Labour Cost ({subitem.LabourCost:0.00})."
                               );
                           }
                           else if(subitem.UnitPrice > subitem.LabourCost)
                           {
                                   _js.ToastrWarning(
                                   $"Unit Price ({subitem.UnitPrice:0.00}) Is  Greater than than Labour Cost ({subitem.LabourCost:0.00})."
                               );

                           }
  
                       }

                }
            }
            else
            {
                // Reset when deselected
                subitem.SelectedItem = null;
                subitem.ItemId = null;
                subitem.ItemCode = null;
                subitem.ItemName = null;
                subitem.HSNCode = null;
                subitem.MeasureUnit = null;
                subitem.UnitPrice = 0m;
                subitem.LabourCost = 0m;
            }

            if (MfgDcVMs != null)
            {
                if (MfgDcVMs.IsWithoutPoDc)
                {
                    subitem.TypeOfPo = "General PO";
                }
                else if (MfgDcVMs.IsPurchaseReturn)
                {
                    subitem.TypeOfPo = "Purchase-GRN";
                }
                else
                {
                    subitem.TypeOfPo = "General PO";
                }
            }


            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"OnItemChanged failed for ItemId: {item?.ItemId}");
            await _js.ToastrError("Failed to apply item selection. Please try again.");
        }
    }

