    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, MfgDcSubVM SubVM)
    {
        try
        {


            int refposubid = 0;
            int.TryParse(SubVM.RefPoSubId.ToString(),out refposubid);

            var isOpenPo = await mfgDcService.IsOpenPoAsync(refposubid);
            decimal stkqty = 0;

            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW Po line
            if (SubVM.DcSubId == 0)
            {
                decimal rcstockqty = 0;
                if (SubVM.RcSubIds != "" && SubVM.RcSubIds != null)
                {
                    var ids = SubVM.RcSubIds.Replace("'", "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                    foreach (var rcid in ids)
                    {
                        int.TryParse(rcid.ToString(), out int rsubid);
                        rcstockqty = rcstockqty + await mfgDcService.GetAvailableStockByItemIdAndRcAndScreenAsync(SubVM.ItemId.Value, MfgDcVMs.IssueStoreId.Value, rsubid);
                    }
                }
                var stockDict = (SubVM.RcSubIds != "" && SubVM.RcSubIds != null) ? rcstockqty : await mfgDcService.GetStockQtyFromStockManager(SubVM.ItemId.Value, MfgDcVMs.IssueStoreId.Value);

                decimal.TryParse(stockDict.ToString(), out stkqty);


                if (refposubid > 0)
                {
                    var poBalQty = await mfgDcService.GetPoItemBalQtyFromPoSubId(refposubid);

                    decimal possibleQty = Math.Min(stkqty, poBalQty);

                    if(isOpenPo)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else if (newQty <= possibleQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = possibleQty;
                        SubVM.BalQty = possibleQty;
                        await _js.ToastrWarning($"Qty cannot exceed Available Po Bal Qty ({poBalQty}). " + $"[Stock Qty: {stkqty}");
                        return;
                    }
                }
                else
                {
                    int refscnsubid = 0;
                    int.TryParse(SubVM.RefSCNSubId.ToString(),out refscnsubid);
                    var scnBalQty = await mfgDcService.GetSCNItemBalQtyFromSCNSubId(refscnsubid);
                    decimal possibleQty = Math.Min(stkqty, scnBalQty);

                    if (refscnsubid>0)
                    {
                        if(newQty<=possibleQty)
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty;
                        }
                        else
                        {
                            SubVM.Qty = possibleQty;
                            SubVM.BalQty = possibleQty;
                            await _js.ToastrWarning($"Qty {newQty} cannot exceed Available SCN Reject Bal Qty ({scnBalQty}). Stock  Qty ({stkqty})");
                            return;
                        }
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }


                }
            }

            // EXISTING DC line
            else
            {
                var original = await mfgDcService.GetDcSubItemDetailByDcSubIdAsync(SubVM.DcSubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.BalQty = 0;
                    await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefPoSubId > 0)
                {
                    var poBalQty = await mfgDcService.GetPoItemBalQtyFromPoSubId(refposubid);
                    var maxAllowedQty = original.Qty + poBalQty;

                    if (newQty > maxAllowedQty && !isOpenPo)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted.GetValueOrDefault();
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted.GetValueOrDefault();
                }
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"OnQtyChange failed for DcSubId: {SubVM?.DcSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

