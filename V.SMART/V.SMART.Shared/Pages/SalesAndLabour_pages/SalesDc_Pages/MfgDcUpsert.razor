    private async Task OnGRNSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (MfgDcVMs.MfgDcSubVMs == null)
            MfgDcVMs.MfgDcSubVMs = new List<MfgDcSubVM>();

        int custId = MfgDcVMs.CustId.Value;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            //var priceDict = await MfgPoService.GetBulkLastUnitPricesAsync(itemIds, custId);

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? grnSubId = item.ContainsKey("GRNSubId") && item["GRNSubId"] != null
                    ? Convert.ToInt32(item["GRNSubId"])
                    : (int?)null;

                if (MfgDcVMs.MfgDcSubVMs.Any(x => x.ItemId == itemId && x.RefSCNSubId == grnSubId))
                    continue;

                var subVm = new MfgDcSubVM
                {
                    RefSCNSubId = grnSubId,
                    RefGRNNo = item.TryGetValue("GRNNo", out var grnNo) ? grnNo?.ToString() : string.Empty,

                    RefGRNDate = item.TryGetValue("GRNDate", out var grnDate) && DateTime.TryParse(grnDate?.ToString(), out var parsedGRNDate)
                        ? parsedGRNDate
                        : (DateTime?)null,

                    ItemId = itemId,
                    ItemCode = item.TryGetValue("ItemCode", out var itemCode) ? itemCode?.ToString() : string.Empty,
                    ItemName = item.TryGetValue("ItemName", out var itemName) ? itemName?.ToString() : string.Empty,
                    MeasureUnit = item.TryGetValue("UOM", out var uom) ? uom?.ToString() : string.Empty,
                    HSNCode = item.TryGetValue("HSNCode", out var hsn) ? hsn?.ToString() : string.Empty,
                  
                    Qty = item.TryGetValue("Qty", out var qtyVal) && decimal.TryParse(qtyVal?.ToString(), out var parsedQty)
                        ? parsedQty
                        : 0m,

                    BalQty = item.TryGetValue("BalQty", out var balQtyVal) && decimal.TryParse(balQtyVal?.ToString(), out var parsedBalQty)
                        ? parsedBalQty
                        : 0m,

                    UnitPrice = item.TryGetValue("UnitPrice", out var unitPrice) && decimal.TryParse(unitPrice?.ToString(), out var parsedPrice)
                        ? parsedPrice
                        : 0m,

                    StockQty=item.TryGetValue("StockQty", out var StockQty) && decimal.TryParse(StockQty?.ToString(), out var parsedStockQty)
                        ? parsedStockQty
                        : 0m,

                    CostId = item.TryGetValue("CostCenterId", out var costId) && int.TryParse(costId?.ToString(), out var parsedCostId) && parsedCostId != 0
                        ? parsedCostId
                        : (int?)null,

                    ProjectNo = item.TryGetValue("ProjectNo", out var projectNo) ? projectNo?.ToString() : string.Empty,

                    Remark=item.TryGetValue("Remark", out var rm) ? rm?.ToString() : string.Empty,

                    TypeOfPo = "",

                    IsEditable = true
                };


                MfgDcVMs.MfgDcSubVMs.Add(subVm);
            }

            int slNo = 1;
            foreach (var row in MfgDcVMs.MfgDcSubVMs)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OnGRNSelectedAsync failed.");
            await _js.ToastrError("Error processing selected OnGRNSelectedAsync items.");
        }
    }
    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(DcId.GetValueOrDefault(), "MfgDC.frx", "DcId", MfgDcVMs.DcCancel, "Manufacturing DC", "Sp_Print_MfgDC");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Manufacturing DC");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Manufacturing DC.");
        }
        finally
        {
            isProcessing = false;
        }
    }

