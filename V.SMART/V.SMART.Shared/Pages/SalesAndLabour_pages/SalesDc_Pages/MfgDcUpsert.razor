    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.DcSubId > 0)
            {
                await mfgDcService.DeleteAndResequenceAsync(rowToDelete, MfgDcVMs,screenCode);

                MfgDcVMs.MfgDcSubVMs = await mfgDcService.GetDcSubByDcIdAsync(MfgDcVMs.DcId);
            }
            else
            {
                MfgDcVMs.MfgDcSubVMs.Remove(rowToDelete);

                if (!MfgDcVMs.MfgDcSubVMs.Any())
                {
                    MfgDcVMs.MfgDcSubVMs.Add(new MfgDcSubVM
                    {
                        DcId = MfgDcVMs.DcId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < MfgDcVMs.MfgDcSubVMs.Count; i++)
                        MfgDcVMs.MfgDcSubVMs[i].SlNo = i + 1;
                }
            }

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error confirming deletion for DcId: {MfgDcVMs.DcId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }


