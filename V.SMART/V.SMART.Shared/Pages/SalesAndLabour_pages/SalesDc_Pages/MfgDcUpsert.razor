    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (MfgDcVMs.MfgDcSubVMs == null)
            MfgDcVMs.MfgDcSubVMs = new List<MfgDcSubVM>();

        int custId = MfgDcVMs.CustId.Value;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            //var priceDict = await MfgPoService.GetBulkLastUnitPricesAsync(itemIds, custId);

            var LabourCost = await _CostingService.GetBulkLabourCostsAsync(itemIds);

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? poSubId = item.ContainsKey("PoSubId") && item["PoSubId"] != null
                    ? Convert.ToInt32(item["PoSubId"])
                    : (int?)null;

                if (MfgDcVMs.MfgDcSubVMs.Any(x => x.ItemId == itemId && x.RefPoSubId == poSubId))
                    continue;

                var subVm = new MfgDcSubVM
                {
                    RefPoSubId = poSubId,
                    RefPoNo = item.TryGetValue("PoNo", out var poNo) ? poNo?.ToString() : string.Empty,

                    RefPoDate = item.TryGetValue("PoDate", out var poDate) && DateTime.TryParse(poDate?.ToString(), out var parsedPoDate)
                        ? parsedPoDate
                        : (DateTime?)null,

                    LineId = item.TryGetValue("LineId", out var lineId) ? lineId?.ToString() : string.Empty,
                    ItemId = itemId,
                    ItemCode = item.TryGetValue("ItemCode", out var itemCode) ? itemCode?.ToString() : string.Empty,
                    ItemName = item.TryGetValue("ItemName", out var itemName) ? itemName?.ToString() : string.Empty,
                    MeasureUnit = item.TryGetValue("UOM", out var uom) ? uom?.ToString() : string.Empty,
                    HSNCode = item.TryGetValue("HSNCode", out var hsn) ? hsn?.ToString() : string.Empty,

                    Qty = item.TryGetValue("Qty", out var qtyVal) && decimal.TryParse(qtyVal?.ToString(), out var parsedQty)
                        ? parsedQty
                        : 0m,

                    BalQty = item.TryGetValue("BalQty", out var balQtyVal) && decimal.TryParse(balQtyVal?.ToString(), out var parsedBalQty)
                        ? parsedBalQty
                        : 0m,

                    PoBalQty = item.TryGetValue("BalQty", out var poBalQtyVal) && decimal.TryParse(poBalQtyVal?.ToString(), out var parsedPoBalQty)
                        ? parsedPoBalQty
                        : 0m,

                    UnitPrice = item.TryGetValue("UnitPrice", out var unitPrice) && decimal.TryParse(unitPrice?.ToString(), out var parsedPrice)
                        ? parsedPrice
                        : 0m,
                    LabourCost = LabourCost.TryGetValue(itemId, out var LabourCosts) ? LabourCosts : 0,  

                    StockQty=item.TryGetValue("StockQty", out var StockQty) && decimal.TryParse(StockQty?.ToString(), out var parsedStockQty)
                        ? parsedStockQty
                        : 0m,

                    PoDueDate = item.TryGetValue("PoDuedate", out var dueDate) && DateTime.TryParse(dueDate?.ToString(), out var parsedDueDate)
                        ? parsedDueDate
                        : (DateTime?)null,

                    CostId = item.TryGetValue("CostCenterId", out var costId) && int.TryParse(costId?.ToString(), out var parsedCostId) && parsedCostId != 0
                        ? parsedCostId
                        : (int?)null,

                    ProjectNo = item.TryGetValue("ProjectNo", out var projectNo) ? projectNo?.ToString() : string.Empty,

                    RcSubIds = item.ContainsKey("RcSubId") ? item["RcSubId"]?.ToString() : "",

                    TypeOfPo = "General PO",

                    IsEditable = true
                };


                MfgDcVMs.MfgDcSubVMs.Add(subVm);
            }

            int slNo = 1;
            foreach (var row in MfgDcVMs.MfgDcSubVMs)
            {
                row.SlNo = slNo++;
            }
              if(IsLabourCost)
               {
                    foreach (var row in MfgDcVMs.MfgDcSubVMs)
                    {
                 
                        if (row.UnitPrice < row.LabourCost)
                        {
                            _js.ToastrWarning(
                                $"Unit Price ({row.UnitPrice:0.00}) Is less than Labour Cost ({row.LabourCost:0.00})."
                            );
                        }
                        else if(row.UnitPrice > row.LabourCost)
                        {
                            _js.ToastrWarning(
                            $"Unit Price ({row.UnitPrice:0.00}) Is  Greater than than Labour Cost ({row.LabourCost:0.00})."
                        );

                        }

                    }
             }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _js.ToastrError("Error processing selected PoSelected items.");
        }
    }

