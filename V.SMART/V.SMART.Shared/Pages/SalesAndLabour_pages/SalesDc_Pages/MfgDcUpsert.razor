    #region Row Operations

    private async Task<bool> ValidateRowAsync(MfgDcSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (row.Qty <= 0)
                errors.Add("Quantity must be greater than 0.");

            if (row.UnitPrice <= 0)
                errors.Add("Unit Price must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await _logs.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = MfgDcVMs.MfgDcSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await _logs.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (!await ValidateLastRowAsync()) return;

            MfgDcVMs.MfgDcSubVMs.Add(new MfgDcSubVM
            {
                DcId = MfgDcVMs.DcId,
                IsEditable = true
            });

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await _logs.LogDeveloperError(ex, "AddRow failed.");
        }
    }

    private async Task SaveRow(MfgDcSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            if (!MfgDcVMs.MfgDcSubVMs.Any(x => x.IsEditable))
            {
                if (MfgDcVMs.IsWithoutPoDc)
                {
                    MfgDcVMs.MfgDcSubVMs.Add(new MfgDcSubVM
                    {
                        DcId = MfgDcVMs.DcId,
                        IsEditable = true
                    });
                }
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"SaveRow failed for DcSubId: {item?.DcSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(MfgDcSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItem == null && item.ItemId > 0)
            {
                item.SelectedItem = await mfgDcService.GetItemByItemIdAsync(item.ItemId);
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"EditRowAsync failed for DcSubId: {item?.DcSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(MfgDcSubVM? item, MfgDcVM? parentDc)
    {
        try
        {
            if (item == null || parentDc == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (item.Qty.GetValueOrDefault() <= 0) ||
                (item.UnitPrice <= 0);

            if (isEmptyOrInvalid)
            {
                parentDc.MfgDcSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CancelEdit failed for DcSubId: {item?.DcSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(MfgDcSubVM item)
    {
        try
        {
            if (MfgDcVMs.MfgDcSubVMs.Count == 1 && item.DcSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }else if (MfgDcVMs.MfgDcSubVMs.Count == 1 && !MfgDcVMs.IsWithoutPoDc)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if (item.Qty.GetValueOrDefault() != item.BalQty)
            {
                await _js.ToastrWarning("This row cannot be deleted because some transactions are done.");
                return;
            }

            if(!string.IsNullOrEmpty(MfgDcVMs.EwayBillNo))
            {
                await _js.ToastrWarning("This row cannot be deleted because Eway transactions are done.");
                return;
            }

            if (item.ItemId == 0)
            {
                MfgDcVMs.MfgDcSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"RemoveRow failed for DcSubId: {item?.DcSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in MfgDcVMs.MfgDcSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to reset row serial numbers.");
        }
    }

