    private async Task CancelItem(MfgDcSubVM rowToCancel)
    {
        if (rowToCancel == null) return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!rowToCancel.ItemCancel)
            {
                rowToCancel.ItemCancel = true;
                rowToCancel.ItemCancelReason = cancelReason;

                await mfgDcService.UpdateItemCancelAndAddorRevertAsync(rowToCancel,screenCode);

                await _logs.LogUserAction(
                username, machine, ip,
                screen: "Manufacturing Dc",
                action: $"Cancelled Dc No: {MfgDcVMs.DcNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }
            else
            {
                rowToCancel.ItemCancel = false;
                rowToCancel.ItemCancelReason = string.Empty;

                await mfgDcService.UpdateItemCancelAndAddorRevertAsync(rowToCancel,screenCode);

                await _logs.LogUserAction(
                username, machine, ip,
                screen: "Manufacturing Dc",
                action: $"Reverted Dc No: {MfgDcVMs.DcNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }
            MfgDcVMs.MfgDcSubVMs = await mfgDcService.GetDcSubByDcIdAsync(MfgDcVMs.DcId);

            decimal stockqty = 0;
            foreach (var dcSub in MfgDcVMs.MfgDcSubVMs.Where(q => q.ItemId > 0))
            {
                if (!string.IsNullOrWhiteSpace(dcSub.RcSubIds))
                {
                    var ids = dcSub.RcSubIds.Replace("'", "")
                        .Split(',', StringSplitOptions.RemoveEmptyEntries);

                    foreach (var rcSubId in ids)
                    {
                        if (int.TryParse(rcSubId, out int rcsubid))
                        {
                            stockqty += await mfgDcService.GetAvailableStockByItemIdAndRcAndScreenAsync(dcSub.ItemId!.Value,MfgDcVMs.IssueStoreId,rcsubid);
                        }
                    }
                    dcSub.StockQty = stockqty;
                }
                else
                {
                    dcSub.StockQty = await mfgDcService.GetStockQtyFromStockManager(dcSub.ItemId.Value, MfgDcVMs.IssueStoreId.Value);
                }

            }

            await ResetSlno();

            var toastMessage = rowToCancel.ItemCancel
                ? "Item cancelled successfully."
                : "Item has been reverted successfully.";

            await _js.ToastrSuccess(toastMessage);
            rowToCancel = null;
            cancelReason = string.Empty;

            StateHasChanged();

        }
        catch (Exception ex)
        {
            rowToCancel = null;
            await _js.ToastrWarning("Cannot revert because PO balance  is less than required quantity.");
            await _logs.LogDeveloperError(ex, $"Item Cancel/Reverse failed for DcId: {MfgDcVMs.DcId}");
        }
        finally
        {
            rowToCancel = null;
            isProcessing = false;
        }
    }

