@page "/mfgDc/details/{DcId:int}"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ISalesService
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.QuotationVM
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.SalesDCVM
@inject IMfgDcService _mfgDcService
@inject IJSRuntime _js
@inject ReportService reportService
@inject ILoggingService LoggingService

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

        <!-- Company Details Section -->
        <MyCompanyDetails />

        <hr class="border-2 border-primary-subtle mb-4" />

        @if ((MfgDcVMs?.DcCancel ?? false))
        {
            <div class="cancelWatermark">CANCELLED</div>
        }
        else if (MfgDcVMs?.DcShortClose == true)
        {
            <div class="cancelWatermark">SHORT CLOSED</div>
        }

        <!-- Customer & Document Details Section -->
        <div class="row g-3 mb-4">
            <!-- Customer Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Customer Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.CustName) ? MfgDcVMs.CustName : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.CustAddress) ? MfgDcVMs.CustAddress : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.CustGstNo) ? MfgDcVMs.CustGstNo : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.ContactNo) ? MfgDcVMs.ContactNo : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Contact Person</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.KindofAttention) ? MfgDcVMs.KindofAttention : "N/A")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Document Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Document Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>DC No</strong></td>
                                    <td>@(MfgDcVMs != null ? $"{MfgDcVMs.Prefix}{MfgDcVMs.DcNo}{MfgDcVMs.Suffix}" : "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>DC Date</strong></td>
                                    <td>@(MfgDcVMs?.DcDate.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Issue From Store</strong></td>
                                    <td>@MfgDcVMs.StoreName</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Consignee & Other Terms Section -->
        <div class="row g-3 mb-4">
            <!-- Consignee Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2 small">
                        Consignee Details
                    </div>
                    <div class="card-body p-2 small">
                        @if (MfgDcVMs.IsSameAsShipping)
                        {
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.CustName) ? MfgDcVMs.CustName : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.CustAddress) ? MfgDcVMs.CustAddress : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.CustGstNo) ? MfgDcVMs.CustGstNo : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.ContactNo) ? MfgDcVMs.ContactNo : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact Person</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.KindofAttention) ? MfgDcVMs.KindofAttention : "N/A")</td></tr>
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.ShippingName) ? MfgDcVMs.ShippingName : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.ShippingAddress) ? MfgDcVMs.ShippingAddress : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.ShippingGstNo) ? MfgDcVMs.ShippingGstNo : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(MfgDcVMs?.ShippingPhone) ? MfgDcVMs.ShippingPhone : "N/A")</td></tr>
                                </tbody>
                            </table>
                        }

                    </div>
                </div>
            </div>

            <!-- Transportation Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2 small">
                        Transportation Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Mode Of Transport</strong></td>
                                    @if (MfgDcVMs.ModeofTrasnport == 1)
                                    {
                                        <td>By Road</td>
                                    }
                                    else if (MfgDcVMs.ModeofTrasnport == 2)
                                    {
                                        <td>By Railway</td>
                                    }
                                    else if (MfgDcVMs?.ModeofTrasnport == 3)
                                    {
                                        <td>By Airway</td>
                                    }
                                    else if (MfgDcVMs?.ModeofTrasnport == 4)
                                    {
                                        <td>By Seaway</td>
                                    }

                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Vehicle No</strong></td>
                                    <td>@(MfgDcVMs?.VehicleNo ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Transport From</strong></td>
                                    <td>@(MfgDcVMs?.TransFrom ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Transport To</strong></td>
                                    <td>@(MfgDcVMs?.TransTo ?? "N/A")</td>
                                </tr>
                               
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Transportation Details-->

            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Transporter Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Transporter Id</strong></td>
                                    <td>@(MfgDcVMs?.TransId ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Transporter Document No.</strong></td>
                                    <td>@(MfgDcVMs?.TransDocNo ?? "N/A")</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Transporter Name.</strong></td>
                                    <td>@(MfgDcVMs?.TransName ?? "N/A")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Payment, Delivery, and Other Terms -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        E-Way and Other Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Towards</strong></td>
                                    <td>@(MfgDcVMs?.Towards ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Main Remarks</strong></td>
                                    <td>@(MfgDcVMs?.MainRemarks ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Sub Supply Type.</strong></td>
                                    @if (MfgDcVMs.SubSuppType == 1)
                                    {
                                        <td>Supply</td>
                                    }
                                    else if (MfgDcVMs.SubSuppType == 5)
                                    {
                                        <td>ForOwnUse</td>
                                    }
                                    else if (MfgDcVMs.SubSuppType == 8)
                                    {
                                        <td>Others</td>
                                    }

                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>E-Way No.</strong></td>
                                    <td>@(MfgDcVMs?.EwayBillNo ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>E-Way Date</strong></td>
                                    <td>@(MfgDcVMs?.EwayBillDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <!-- DC Items Section -->
        <div class="card border-1 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                Delivery Challan Items
            </div>
            <div class="table-responsive" style="overflow-x:auto;">
                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                    <thead class="custom-blue">
                        <tr>
                            <th>Sl No.</th>
                            <th>Item Code</th>
                            <th>Description</th>
                            <th>UOM</th>
                            <th>HSN</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                            <th>Basic Amount</th>
                            @if (!MfgDcVMs.IsWithoutPoDc)
                            {
                                <th>Po BalQty</th>
                                <th>Ref. PoNo</th>
                                <th>Ref PoDate</th>
                            }
                            
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody class="custom-size">
                        @if (MfgDcVMs?.MfgDcSubVMs != null && MfgDcVMs.MfgDcSubVMs.Any())
                        {
                            @foreach (var item in MfgDcVMs.MfgDcSubVMs)
                            {
                                <tr>
                                    <td>@item.SlNo</td>
                                    <td>@(item.ItemCode ?? "—")</td>
                                    <td>@(item.ItemName ?? "—")</td>
                                    <td>@item.MeasureUnit</td>
                                    <td>@item.HSNCode</td>
                                    <td>@FormatDecimal(item.Qty)</td>
                                    <td>@FormatDecimal(item.UnitPrice)</td>
                                    <td>@FormatDecimal(item.Qty * item.UnitPrice)</td>

                                    @if (!MfgDcVMs.IsWithoutPoDc)
                                    {
                                        <td>@item.PoBalQty</td>
                                        <td>@item.RefPoNo</td>
                                        <td>@item.RefPoDate</td>
                                    }
                                   
                                    <td>@item.Remark</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" class="text-center text-muted">No items found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2 justify-content-end">

            <a href="@($"/mfgDcList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                <i class="bi bi-arrow-bar-left me-1"></i> Back To List
            </a>

            <a href="@($"/mfgDc/update/{DcId}")" class="btn btn-outline-primary">
                <i class="bi bi-pencil-square"></i> Modify
            </a>

            <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                <i class="bi bi-printer"></i> Print
            </button>

        </div>
    </div>
}

@code {
    [Parameter]
    public int DcId { get; set; }

    private bool isProcessing { get; set; } = true;
    private MfgDcVM MfgDcVMs { get; set; } = new MfgDcVM();
    private CustomerVM CustomerVMs { get; set; } = new CustomerVM();
    string? pdfBase64;
    private Companydetails company { get; set; } = new Companydetails();
    private List<MfgDcSubVM> refPos = new();
    private string refPoNosDisplay = "N/A";
    private string refPoDatesDisplay = "N/A";
    private int Decimalplaces { get; set; } = 2;

    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private string FormatDecimal(decimal? value)
    {
        if (value == null) return "0";
        return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
    }


    protected override async Task OnInitializedAsync()
    {
        company = await _mfgDcService.GetCompanyDetailsAsync();
        await LoadDcDetails();
        isProcessing = false;
    }

    private async Task LoadDcDetails()
    {
        if (DcId > 0)
        {
            var dc = await _mfgDcService.GetMfgDcByDcIdAsync(DcId);
            if (dc != null)
            {
                MfgDcVMs = dc;
            }

            Decimalplaces = await _mfgDcService.GetDecimalPlacesAsync();
            CustomerVMs = await _mfgDcService.GetCustomerByIdAsync(MfgDcVMs.CustId.Value);
            refPos = await _mfgDcService.GetDistinctRefPoByDcIdAsync(MfgDcVMs.DcId);

            if (refPos.Any())
            {
                // Only join the existing items, no extra commas
                refPoNosDisplay = string.Join(", ", refPos.Select(e => e.RefPoNo).Where(n => !string.IsNullOrEmpty(n)));
                refPoDatesDisplay = string.Join(", ", refPos
                    .Select(e => e.RefPoDate.HasValue ? e.RefPoDate.Value.ToString("dd/MM/yyyy") : null)
                    .Where(d => !string.IsNullOrEmpty(d)));
            }
        }
    }


    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(DcId, "MfgDC.frx", "DcId", MfgDcVMs.DcCancel, "Manufacturing DC", "Sp_Print_MfgDC");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Manufacturing DC");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Manufacturing DC.");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
