    private async Task CancelSCN()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!LabourSCNVMs.SCNCancel)
            {
                LabourSCNVMs.SCNCancel = true;
                LabourSCNVMs.CancelReason = cancelReason;
                LabourSCNVMs.CanceledBy = username;
                await _scnService.UpdatedCancelStatusAndAddOrRevertQty(LabourSCNVMs, screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Labour SCN",
                    action: $"Cancelled Labour SCN No: {LabourSCNVMs.SCNNo}",
                    additionalInfo: $"SCN Id: {LabourSCNVMs.SCNId}"
                );

                await _JS.ToastrSuccess("Labour SCN cancelled successfully.");
            }
            else
            {
                LabourSCNVMs.SCNCancel = false;
                LabourSCNVMs.CancelDate = null;
                LabourSCNVMs.CancelReason = string.Empty;
                LabourSCNVMs.CanceledBy = string.Empty;

                await _scnService.UpdatedCancelStatusAndAddOrRevertQty(LabourSCNVMs, screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Labour SCN",
                    action: $"Reverted Labour SCN No: {LabourSCNVMs.SCNNo}",
                    additionalInfo: $"SCN Id: {LabourSCNVMs.SCNId}"
                );

                await _JS.ToastrSuccess("Labour SCN has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            if(SCNId.HasValue && SCNId>0)
                await LoadExistingSCN(SCNId.Value);

            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"CancelSCN failed for SCNId: {LabourSCNVMs.SCNId}");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the Labour SCN.");
            await LoggingService.LogDeveloperError(ex, $"Cancel Labour SCN failed for SCNId: {LabourSCNVMs.SCNId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.SCNSubId > 0)
            {
                await _scnService.DeleteAndResequenceAsync(rowToDelete, LabourSCNVMs, screenCode);

                if(SCNId.HasValue && SCNId>0)
                    await LoadExistingSCN(SCNId.Value);
            }
            else
            {
                LabourSCNVMs.LabourSCNSubVMs.Remove(rowToDelete);

                if (!LabourSCNVMs.LabourSCNSubVMs.Any())
                {
                    LabourSCNVMs.LabourSCNSubVMs.Add(new LabourSCNSubVM
                    {
                        SCNId = LabourSCNVMs.SCNId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    await ResetSlno();
                }
            }

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for SCNId:{LabourSCNVMs.SCNId} ");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

