    private async Task Cancel()
    {
        try
        {
            if (!SCNId.HasValue || SCNId == 0)
            {
                await _JS.ToastrError("Labour SCN cancel is not allowed before saving the Labour SCN.");
                return;
            }
            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Labour SCN");
                return;
            }

            if (LabourSCNVMs.ShortClose)
            {
                await _JS.ToastrError("Labour SCN  is already short closed. You can't cancel it.");
                return;
            }

            // If ANY item is already cancelled → stop GRN cancel
            if (LabourSCNVMs.LabourSCNSubVMs.Any(s => s.ItemCancel))
            {
                await _JS.ToastrWarning("SCN cannot be cancelled — one or more items are already cancelled.");
                return;
            }

            if(LabourSCNVMs.SCNCancel)
            {
                var subs = await _scnService.GetSCNSubDetailsBySCNIdAsync(LabourSCNVMs.SCNId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    await _scnService.ValidateGRNBalanceBeforeRevertAsync(sub);

                }
            }

            if (!LabourSCNVMs.SCNCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this SCN?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this SCN?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            LabourSCNVMs = await _scnService.GetLabourSCNByIdAsync(LabourSCNVMs.SCNId);
            await _JS.ToastrError( "Cannot revert SCN. Issued quantity exceeds the available GRN balance Qty.");
            await LoggingService.LogDeveloperError(ex, "Error in Labour SCN  Cancel() method");

        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Labour SCN.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Labour SCN  Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnItemCancelChanged(LabourSCNSubVM subitem)
    {
        try
        {

            if(subitem.SCNSubId ==0 )
            {
                await _JS.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if (LabourSCNVMs.SCNCancel)
            {
                await _JS.ToastrWarning("Item cannot be cancelled — SCN is already cancelled.");
                return;
            }

            if (subitem.AcceptQty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _JS.ToastrError("Item cannot be cancelled/Revert — some transactions have been made on it.");
                return;
            }

            if(subitem.ItemCancel)
                await _scnService.ValidateBeforeRevertAsync(subitem.SCNSubId);


            var (canDelete, message) = await _scnService.CanCancelAndRevokelabourSCNAsync(subitem.SCNId,subitem.SCNSubId);
            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _JS.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _JS.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingSCN(SCNId.Value);
            await _JS.ToastrError( "Cannot revert SCN. Issued quantity exceeds the available GRN balance Qty.");
            await LoggingService.LogDeveloperError(ex, "Error in Labour SCN  Cancel() method");

        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in SCN labour");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {

        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;
                case "Cancel":
                case "Revert":
                    await CancelSCN();
                    break;
                case "ItemCancel":
                    await CancelItem(rowToCancel);
                    break;
                case "ShortClose":
                    await ShortCloseLabourSCN();
                    break;

                default:
                    await _JS.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action in LabourSCNUpsert: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action in LabourSCNUpsert. Please try again.");
        }


    }
