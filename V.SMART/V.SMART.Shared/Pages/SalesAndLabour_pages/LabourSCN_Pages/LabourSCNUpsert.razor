    #region Insert Operations

    private async Task UpsertSCN()
    {
        try
        {
            isProcessing = true;

            LabourSCNVMs.LabourSCNSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.AcceptQty.HasValue || x.AcceptQty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!LabourSCNVMs.LabourSCNSubVMs.Any())
            {
                await _JS.ToastrWarning("Cannot save a Labour SCN without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in LabourSCNVMs.LabourSCNSubVMs)
            {
                bool isValid = await ValidateDcLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewDc = LabourSCNVMs.SCNId == 0;

            try
            {
                await _scnService.UpsertSCNAsync(LabourSCNVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewDc)
                await _JS.ToastrSuccess("Labour SCN saved successfully.");
            else
                await _JS.ToastrSuccess("Labour SCN updated successfully.");
                
            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigation.NavigateTo("/labourSCNList");
        }

        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertSCN failed.");
            await _JS.ToastrError("Error saving labour SCN.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateDcLineAsync(LabourSCNSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _JS.ToastrWarning("One or more items are missing Item selection.");
                return false;
            }


            decimal acceptQty = line.AcceptQty ?? 0m;
            decimal rejectQty = line.RejectQty ?? 0m;
            decimal reworkQty = line.ReworkQty ?? 0m;
            decimal enteredTotal = acceptQty + rejectQty + reworkQty;

            decimal stockQty = await _scnService.GetStockQtyFromStockManager(line.ItemId.Value, LabourSCNVMs.StoreIssId.Value);

            if (LabourSCNVMs.SCNId == 0 && stockQty <= 0)
            {
                await _JS.ToastrWarning($"AcceptQty+RejectQty+ReworkQty Quantity should not be greater than Stock Qty.");
                return false;
            }

            decimal totalEnteredForSameItem = LabourSCNVMs.LabourSCNSubVMs.Where(x => x.ItemId == line.ItemId)
            .Sum(x => (x.AcceptQty ?? 0) + (x.RejectQty ?? 0) + (x.ReworkQty ?? 0));

            if (enteredTotal > (totalEnteredForSameItem + stockQty))
            {
                await _JS.ToastrWarning(
                    $"Total issued quantity for Item {line.ItemCode} ({totalEnteredForSameItem}) " +
                    $"cannot exceed Available Stock ({stockQty})."
                );
                return false;
            }
            

             if (totalEnteredForSameItem <= 0m)
                {
                    await _JS.ToastrWarning($"AcceptQty+RejectQty+ReworkQty Quantity should be greater 0");
                    return false;
                }



            if ((line.AcceptQty + line.RejectQty + line.ReworkQty) > line.QtyReceived)
            {
                await _JS.ToastrWarning($"AcceptQty+RejectQty+ReworkQty Quantity should not be greater than Qty Received.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _JS.ToastrWarning($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            if (LabourSCNVMs.StoreIssId == LabourSCNVMs.AddStoreId)
            {
                await _JS.ToastrWarning($"Add Store and Issue Store should not be the same.");
                return false;
            }



            // Qty vs PO / Already Transacted validation
            if (line.SCNSubId == 0 && line.RefGRNSubId > 0)
            {

                var grnBalQty = await _scnService.GetGRNItemBalQtyFromGRNSubId(line.RefGRNSubId.Value);

                if ((line.AcceptQty > grnBalQty))
                {
                    line.BalQty = grnBalQty;
                    line.AcceptQty = grnBalQty;
                    await _JS.ToastrWarning($"Qty cannot exceed SCN Balance Qty ({grnBalQty}).");
                    return false;
                }
            }
            else if (line.SCNSubId > 0)
            {
                    var grnBalQty = await _scnService.GetGRNItemBalQtyFromGRNSubId(line.RefGRNSubId.Value);

                    var original = await _scnService.GetSCNSubItemDetailBySCNSubIdAsync(line.SCNSubId);

                    decimal originalAccp = original?.AcceptQty ?? 0;
                    decimal originalRej = original?.RejectQty ?? 0;
                    decimal originalRew = original?.ReworkQty ?? 0;

                    var originalTotal = originalAccp + originalRej + originalRew;

                    var maxAllowed = grnBalQty + originalTotal;
                    var total = line.AcceptQty + line.ReworkQty + line.RejectQty;
                      var alreadyTransacted = originalTotal - (original.BalQty+original.SCNBalQty);

                    // Cannot decrease below transacted quantity
                    if (total < alreadyTransacted)
                    {
                        if (line.AcceptQty>0)
                        {
                            line.AcceptQty = maxAllowed - (line.RejectQty + line.ReworkQty);
                           
                        }

                        else if (line.RejectQty > 0)
                            line.RejectQty = maxAllowed - (line.AcceptQty + line.ReworkQty);

                        else if (line.ReworkQty > 0)
                            line.ReworkQty = maxAllowed - (line.AcceptQty + line.RejectQty);

                        await _JS.ToastrWarning($"Qty cannot be less than {maxAllowed} (already transacted).");
                        return false;
                    }
                    else if (total > maxAllowed)
                    {
                        if (line.AcceptQty>0)
                        {
                            line.AcceptQty = maxAllowed - (line.RejectQty + line.ReworkQty);
                           
                        }

                        else if (line.RejectQty > 0)
                            line.RejectQty = maxAllowed - (line.AcceptQty + line.ReworkQty);

                        else if (line.ReworkQty > 0)
                            line.ReworkQty = maxAllowed - (line.AcceptQty + line.RejectQty);

                        await _JS.ToastrWarning(
                            $" Qty change exceeded limit. Max allowed total is {maxAllowed}. Auto-adjusted.");
                        return false;
                    }

            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateDcLineAsync failed.");
            await _JS.ToastrError("Error Validate Labour-SCN line.");
            return false;
        }
    }
