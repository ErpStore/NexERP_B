    private async Task CancelItem(LabourSCNSubVM rowToCancel)
    {
        if (rowToCancel == null || isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            bool isCancelling = !rowToCancel.ItemCancel;

            if (isCancelling && string.IsNullOrWhiteSpace(cancelReason))
            {
                await _JS.ToastrWarning("Cancel reason is required.");
                return;
            }

            rowToCancel.ItemCancel = isCancelling;
            rowToCancel.CancelItemReason = isCancelling ? cancelReason : string.Empty;

            await _scnService.UpdateItemCancelAndAddorRevertAsync(rowToCancel, screenCode, LabourSCNVMs.SCNNo, LabourSCNVMs.AddStoreId.Value, LabourSCNVMs.SCNDate);

            string actionText = isCancelling ? "Cancelled" : "Reverted";

            await LoggingService.LogUserAction(
                username,
                machine,
                ip,
                screen: "Labour SCN",
                action: $"{actionText} SCN No: {LabourSCNVMs.SCNNo}, ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {(isCancelling ? cancelReason : "Reverted")}"
            );

            LabourSCNVMs = await _scnService.GetLabourSCNByIdAsync(LabourSCNVMs.SCNId);

            await ResetSlno();

            await _JS.ToastrSuccess($"Item has been {actionText.ToLower()} successfully.");

            cancelReason = string.Empty;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            LabourSCNVMs = await _scnService.GetLabourSCNByIdAsync(LabourSCNVMs.SCNId);
            await _JS.ToastrWarning(ex.Message);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the Item.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Reverse failed for SCNId: {LabourSCNVMs.SCNId}");
