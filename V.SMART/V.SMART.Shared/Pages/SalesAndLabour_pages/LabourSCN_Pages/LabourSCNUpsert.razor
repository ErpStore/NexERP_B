    private async Task AskToShortCloseAsync(LabourSCNVM LabourSCNVMs)
    {
        try
        {
            if (LabourSCNVMs == null)
            {
                await _JS.ToastrError("Invalid Labour SCN selected.");
                return;
            }

            if (!SCNId.HasValue || SCNId == 0)
            {
                await _JS.ToastrError("Labour SCN Short Close is not allowed before saving the Labour SCN.");
                return;
            }

            if (LabourSCNVMs.SCNTally)
            {
                await _JS.ToastrWarning("This Labour SCN is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (LabourSCNVMs.SCNCancel)
            {
                await _JS.ToastrWarning("This Labour SCN is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!LabourSCNVMs.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Labour SCN?";
                btnText = "Short Close";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Labour SCN?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while AskToShortCloseAsync Labour SCN.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

