    private async Task CancelEdit(LabourSCNSubVM? item, LabourSCNVM? parentDc)
    {
        try
        {
            if (item == null || parentDc == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (item.AcceptQty.GetValueOrDefault() <= 0) ||
                (item.UnitPrice <= 0);

            if (isEmptyOrInvalid)
            {
                parentDc.LabourSCNSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for SCNSubId: {item?.SCNSubId}");
            await _JS.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(LabourSCNSubVM item)
    {
        try
        {
            if (LabourSCNVMs.LabourSCNSubVMs.Count == 1 && item.SCNSubId > 0)
            {
                await _JS.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if (LabourSCNVMs.SCNCancel)
            {
                await _JS.ToastrError("This SCN is already cancelled. Row deletion is not allowed.");
                return;
            }

            if (LabourSCNVMs.ShortClose)
            {
                await _JS.ToastrError("This SCN is already short closed. Row deletion is not allowed.");
                return;
            }

            if (item.ItemCancel)
            {
                await _JS.ToastrError("This item is already cancelled and cannot be deleted.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if (item.ItemId == 0)
            {
                LabourSCNVMs.LabourSCNSubVMs.Remove(item);
                await _JS.ToastrSuccess("New item row removed successfully.");


                if (!LabourSCNVMs.LabourSCNSubVMs.Any())
                    LabourSCNVMs.LabourSCNSubVMs = new List<LabourSCNSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";

            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for SCNSubId: {item?.SCNSubId}");
            await _JS.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
