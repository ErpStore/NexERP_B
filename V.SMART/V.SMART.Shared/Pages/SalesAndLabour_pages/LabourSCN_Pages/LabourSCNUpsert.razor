    private async Task OnGRNSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (LabourSCNVMs.LabourSCNSubVMs == null)
            LabourSCNVMs.LabourSCNSubVMs = new List<LabourSCNSubVM>();

        int storeid = LabourSCNVMs.StoreIssId.Value;
        var selectedStore = IssStores.FirstOrDefault(s => s.StoreId == storeid);

        try
        {
            foreach (var item in selectedItems)
            {
                string grnStoreName = GetString(item, "Store Name").Trim();

                // Store validation
                if (!string.Equals(grnStoreName, selectedStore?.StoreName, StringComparison.OrdinalIgnoreCase))
                    continue;

                int itemId = GetInt(item, "ItemId");
                int? grnSubId = GetNullableInt(item, "GRNSubId");

                if (LabourSCNVMs.LabourSCNSubVMs.Any(x => x.ItemId == itemId && x.RefGRNSubId == grnSubId))
                    continue;

                decimal qtyReceived = GetDecimal(item, "BalQty");
                decimal extraQty = GetDecimal(item, "Extra Qty");
                decimal stockQty = GetDecimal(item, "Stock Qty");
                decimal unitConvert = Math.Max(GetDecimal(item, "UnitConvert"), 1);

                decimal totalQty = qtyReceived + extraQty;

                decimal unitPrice = GetDecimal(item, "UnitPrice");
                decimal altRate = GetDecimal(item, "AltRate");

                //======== Important==============
                // If alternate rate is available and conversion > 0, use alternate
                if (altRate > 0 && unitConvert > 0)
                {
                    unitPrice = altRate;
                }

                //======== Important==============
                // Qty conversion
                decimal qtyConvert = (unitConvert > 0) ? qtyReceived * unitConvert : qtyReceived;

                DateTime? grnDate = GetDate(item, "GRNDate");
                DateTime? dcDate = GetDate(item, "RefDcDate");

                var subVm = new LabourSCNSubVM
                {
                    RefGRNSubId = grnSubId,
                    RefGRNNo = GetString(item, "GRNNo"),
                    RefGRNDate = grnDate,

                    ItemId = itemId,
                    ItemCode = GetString(item, "ItemCode"),
                    ItemName = GetString(item, "ItemName"),
                    Specification = GetString(item, "Specification"),
                    MeasureUnit = GetString(item, "UOM"),
                    HSNCode = GetString(item, "HSNCode"),
                    Category = GetString(item, "Category"),

                    QtyReceived = qtyReceived,
                    AcceptQty = totalQty,
                    BalQty = totalQty,

                    UnitPrice = unitPrice,

                    StockQty = stockQty,
                    UnitConvert = unitConvert,

                    BatchNo = GetString(item, "BatchNo"),
                    HeatNo = GetString(item, "HeatNo"),

                    RefDcNo = GetString(item, "RefDcNo"),
                    RefDcDate = dcDate,

                    CostId = GetNullableInt(item, "CostCenterId"),
                    ProjectNo = GetString(item, "ProjectNo"),

                    IsEditable = true
                };

                LabourSCNVMs.LabourSCNSubVMs.Add(subVm);
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnGRNSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected SCNSelected items.");
        }
    }

    private string GetString(Dictionary<string, object> dic, string key)
    {
        return dic.TryGetValue(key, out var val) ? val?.ToString() ?? "" : "";
    }

    private int GetInt(Dictionary<string, object> dic, string key)
    {
        return dic.TryGetValue(key, out var val) && int.TryParse(val?.ToString(), out var result)
            ? result : 0;
    }

    private int? GetNullableInt(Dictionary<string, object> dic, string key)
    {
        return dic.TryGetValue(key, out var val) && int.TryParse(val?.ToString(), out var result) && result != 0
            ? result : (int?)null;
    }

    private decimal GetDecimal(Dictionary<string, object> dic, string key)
    {
        return dic.TryGetValue(key, out var val) && decimal.TryParse(val?.ToString(), out var result)
            ? result : 0;
    }

    private DateTime? GetDate(Dictionary<string, object> dic, string key)
    {
        return dic.TryGetValue(key, out var val) && DateTime.TryParse(val?.ToString(), out var result)
            ? result : (DateTime?)null;
    }


