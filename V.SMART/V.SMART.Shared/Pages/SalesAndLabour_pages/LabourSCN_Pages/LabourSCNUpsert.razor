@page "/labourSCN/create"
@page "/labourSCN/create/{CustId:int}"
@page "/labourSCN/update/{SCNId:int}"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ILabourServices
@using V.SMART.Shared.Data.SalesAndLabour.Labour_SCN
@using V.SMART.Shared.Repository.IRepository.IMasterRepository.IAdmins
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.LabourSCN_VM
@using MudBlazor

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ILabourSCNService _scnService
@inject IUserAuthorityRepository userAuthority
@inject ReportService reportService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">

</BsModal>

<DetailsModal Title="GRN Details"
              Columns="@GRNColumns"
              ColumnFields="@GRNFields"
              HiddenColumns="@GRNHiddenColumns"
              Data="@GRNData"
              IsVisible="@IsGRNModalVisible"
              IsVisibleChanged="@((val) => IsGRNModalVisible = val)"
              OnSelectedItems="OnGRNSelectedAsync">
</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }

</MasterModal>


<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }

</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <!-- Cancelled Watermark -->
            @if (LabourSCNVMs.SCNCancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (LabourSCNVMs.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }
            <PageHeader TitleText="@(LabourSCNVMs.SCNId > 0 ? "Update Store Credit Note" : "Create Store Credit Note")"
                        TitleIcon="bi bi-tag" Breadcrumbs="@LabourSCNBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="LabourSCNVMs" OnValidSubmit="UpsertSCN">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Correspondence Status -->
                        @if (LabourSCNVMs.SCNId > 0 && !string.IsNullOrWhiteSpace(LabourSCNVMs.SCNNo))
                        {
                            <CorrespondenceStatus ReferenceType="Labour-SCN"
                                                  ReferenceId="@LabourSCNVMs.SCNId"
                                                  ReferenceTypeName="@LabourSCNVMs.SCNNo" />
                        }
                    </div>
                    <div class="row g-3 mb-2">
                         <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header equal-card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Customer Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3"
                                            @onclick='() => OpenModal("Customer")'>
                                        <i class="bi bi-person-add me-1"></i> Add Customer
                                    </button>
                                </div>
                                <div class="card-body">

                                    <!-- Vendor/Supplier Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="CustomerVM"
                                                             Value="SelectedCustomer"
                                                             ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                             ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                             SearchFunc="SearchCustomers"
                                                             Dense="true"
                                                             Variant="Variant.Outlined"
                                                             Placeholder="Search Customer"
                                                             Title="Search atleast 3 letters in Customer"
                                                             Class="w-100 autocomplete-sm"
                                                             MaxItems="50"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             Required="true"
                                                             AvoidSubmit="true"
                                                             Disabled="@IsSomeItemsTransMade" />
                                        </div>
                                    </div>
                                    <!-- Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                  rows="2" readonly>@LabourSCNVMs?.CustAddress</textarea>
                                        </div>
                                    </div>

                                    <!-- GSTIN -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GSTIN</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@LabourSCNVMs?.CustGst" readonly />
                                        </div>
                                    </div>
                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    @bind="@LabourSCNVMs.KindofAttention">
                                                <option disabled value="">Select Contact Person</option>
                                                @foreach (var cp in contactPersons)
                                                {
                                                    <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => LabourSCNVMs.KindofAttention)" />
                                        </div>
                                    </div>
                                    <!-- Phone -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Phone No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@LabourSCNVMs?.CustContactNo" readonly />
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>

                         <!-- =================== SCN Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header equal-card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Labour SCN Details</span>
                                    @if (LabourSCNVMs.SCNId > 0 && (CanCreate || CanEdit))
                                    {
                                   
                                         <div class="d-flex gap-2">
                                                <button type="button"
                                                        class="btn btn-sm rounded-3 @(LabourSCNVMs.SCNCancel ? "btn-success" : "btn-danger")"
                                                        @onclick="Cancel">

                                                    @if (!LabourSCNVMs.SCNCancel)
                                                    {
                                                        <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                                    }
                                                </button>
                                              <!-- Short Close / Re-Open -->
                                                <button type="button"
                                                    class="btn btn-sm rounded-3 @(LabourSCNVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                    @onclick="() => AskToShortCloseAsync(LabourSCNVMs)"
                                                    disabled="@LabourSCNVMs.SCNCancel">

                                                    @if (!LabourSCNVMs.ShortClose)
                                                    {
                                                        <i class="bi bi-box-seam me-1"></i>
                                                        <span>Short Close</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                        <span>Re-Open</span>
                                                    }
                                                </button>
                                        </div>
                                    
                                    }
                                </div>

                                <div class="card-body">

                                    <!-- SCN No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>SCN No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm flex-wrap w-100">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="SCN No."
                                                       @bind="LabourSCNVMs.SCNNo" />

                                                <span class="input-group-text rounded-end">@LabourSCNVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => LabourSCNVMs.SCNNo)" />
                                            <ValidationMessage For="@(() => LabourSCNVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- SCN Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>SCN Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@LabourSCNVMs.SCNDate" />
                                            <ValidationMessage For="@(() => LabourSCNVMs.SCNDate)" />
                                        </div>
                                    </div>

                                    <!-- GRN Details -->
                                    @if (GRNPendingCount > 0 && LabourSCNVMs.SCNId == 0)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. GRN</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowGRNDetails">
                                                    <i class="bi bi-list-ul me-1"></i> GRN Details
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Issue from Store --> 
                                    <div class="mb-2 row"> 
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark"> 
                                        <small>Issue from Store</small> </label> 
                                        <div class="col-12 col-sm-9"> 
                                            
                                            <select value="@LabourSCNVMs.StoreIssId"
                                                    @onchange="OnStoreChanged"
                                                    class="form-select form-select-sm rounded-3 w-100"
                                                    id="labourscn"
                                                    disabled="@(LabourSCNVMs.SCNId > 0)">
                                                <option value="0">--Select Issue Store--</option>
                                                @foreach (var storeid in IssStores)
                                                {
                                                    <option value="@storeid.StoreId">@storeid.StoreName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => LabourSCNVMs.StoreIssId)" /> 
                                                
                                         </div> 
                                    </div> 
                                    
                                    <!-- Add To Store --> 
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark"> 
                                            <small>Add To Store</small> 
                                         </label> 
                                         <div class="col-12 col-sm-9"> 
                                             <select @bind="LabourSCNVMs.AddStoreId" 
                                                 class="form-select form-select-sm rounded-3 w-100" 
                                                 id="Purchasescn" disabled="@(LabourSCNVMs.SCNId>0)"> 
                                                 <option value="0">--Select Add Store--</option> 
                                                 @foreach (var storeid in AddStores)
                                                 { 
                                                     <option value="@storeid.StoreId">@storeid.StoreName</option> 
                                                 } 
                                             </select> 
                                             <ValidationMessage For="@(() => LabourSCNVMs.AddStoreId)" /> 
                                         </div> 
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="LabourSCNVMs.MainRemarks"></textarea>
                                            <ValidationMessage For="@(() => LabourSCNVMs.MainRemarks)" />
                                        </div>
                                    </div>
                              
                                     @if(LabourSCNVMs.SCNCancel)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="LabourSCNVMs.CancelReason"
                                                            readonly></textarea>
                                                <ValidationMessage For="@(() => LabourSCNVMs.CancelReason)" />
                                            </div>
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Date</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="date" class="form-control form-control-sm rounded-3 w-100"
                                                            @bind="LabourSCNVMs.CancelDate"
                                                            readonly></input>
                                                <ValidationMessage For="@(() => LabourSCNVMs.CancelDate)" />
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                         <!--=====================Item Details=========================-->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header bg-primary-subtle text-dark">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                                        <!-- Title -->
                                        <span class="fw-bold fs-6">SCN Item Details</span>

                                        <!-- Right Controls -->
                                        <div class="d-flex flex-wrap align-items-center gap-2">

                                            <!-- Add Item Button -->
                                            <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>

                                        </div>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:300px;">Item Code</th>
                                                    <th style="width:250px;">Item Name</th>
                                                    <th style="width:300px;">Item Specification</th>

                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:70px;">HSN</th>
                                                    <th style="width:120px;">Qty Received</th>
                                                    <th style="width:120px;">Accept Qty</th>
                                                    <th style="width:120px;">Reject Qty</th>
                                                      
                                                    <th style="width:120px;">Rework Qty</th>
                                                    @if(LabourSCNVMs.SCNId>0)
                                                    {
                                                       <th style="width:100px;">Bal Qty</th>
                                                    }
                                                    <th style="width:100px;">Stock Qty</th>
                                                      @if(IsRejectionSelection)
                                                    {
                                                        <th style="width:200px;">RejectionCode</th>
                                                    }
                                                      <th style="width:200px;">Remarks</th>
                                                    <th style="width:100px;">Qty To Stock</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:120px;">Ref GRN No.</th>
                                                    <th style="width:120px;">Ref GRN Date</th>
                                                    <th style="width:120px;">Ref Dc No.</th>
                                                    <th style="width:110px;">Ref Dc Date</th> 
                                                    <th style="width:110px;">Inspectio No.</th>
                                                    <th style="width:120px;">NCR No.</th>
                                                    <th style="width:120px;">Batch No.</th>
                                                    <th style="width:120px;">Heat No.</th>
                                                    <th style="width:120px;">Weight</th>
                                                  
                                                    <th style="width:150px;">Cost-Center</th>
                                             
                                                    <th style="width:170px;">Category</th>

                                                     @if (!LabourSCNVMs.SCNCancel && (SCNId.HasValue || SCNId > 0))
                                                    {
                                                        <th style="width:130px;">Item Cancel</th>
                                                        <th style="width:160px;">Cancel Reason</th>
                                                    }
                                                    @if (!LabourSCNVMs.SCNCancel && !LabourSCNVMs.ShortClose)
                                                    {
                                                        <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                    }
                                                  @*   <th style="width:90px;" class="freeze-last-col text-end">Action</th> *@
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in LabourSCNVMs.LabourSCNSubVMs)
                                                {
                                                    <tr @key="subitem" class="@(subitem.ItemCancel ? "table-danger" : "")">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @if (subitem.IsEditable && (subitem.RefGRNSubId == 0 || subitem.RefGRNSubId == null)
                                                                                                                                && subitem.AcceptQty.GetValueOrDefault() == subitem.BalQty)
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                         Value="subitem.SelectedItem"
                                                                                         ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                         ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                         SearchFunc="SearchItems"
                                                                                         Dense="true"
                                                                                         Variant="Variant.Outlined"
                                                                                         Placeholder="Search Item Code"
                                                                                         Title="Search Atleast 3 Letters in Item-Code"
                                                                                         Class="w-100 autocomplete-sm"
                                                                                         MaxItems="50" />
                                                                        <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.ItemCode
                                                                    }
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0  && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                       Size="Size.Small"
                                                                                       Color="Color.Primary"
                                                                                       OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                       Edge="Edge.End"
                                                                                       Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.Specification</td>
                                                        
                                                        <td>@subitem.MeasureUnit</td>
                                                        <td>@subitem.HSNCode</td>
                                                         <!-- Qty-->
                                                        <td>
                                                            <span>@subitem.RecievedQty</span>
                                                        </td>
                                                        
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="AcceptQty"
                                                                       title="Enter AcceptQty"
                                                                       step="any"
                                                                       @bind="subitem.AcceptQty"
                                                                       @bind:event="oninput"
                                                                       @onchange="@(e => OnAccpQtyChange(subitem.AcceptQty, subitem))"/>
                                                                <ValidationMessage For="@(() => subitem.AcceptQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.AcceptQty?.ToString("0.###")</span>
                                                            }
                                                        </td>
                                                         <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Reject Qty"
                                                                       title="Enter RejectQty"
                                                                       step="any"
                                                                       @bind="subitem.RejectQty"
                                                                       @bind:event="oninput"
                                                                       @onchange="@(e => OnRejQtyChange(subitem.RejectQty, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.RejectQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.RejectQty</span>
                                                            }
                                                        </td>


                                                         <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Rework Qty"
                                                                       title="Enter ReworkQty"
                                                                       step="any"
                                                                       @bind="subitem.ReworkQty"
                                                                       @bind:event="oninput"
                                                                       @onchange="@(e => OnRewQtyChange(subitem.ReworkQty, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.ReworkQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.ReworkQty</span>
                                                            }
                                                        </td>

                                                        @if (LabourSCNVMs.SCNId > 0)
                                                        {
                                                            <td>
                                                                <span>@subitem.BalQty?.ToString("0.###")</span>
                                                            </td>
                                                        }

                                                        <td>
                                                            <span class="text-danger">@subitem.StockQty?.ToString("0.###")</span>
                                                        </td>
                                                          @if (IsRejectionSelection)
                                                          {
                                                              <td>
                                                                  @if (subitem.IsEditable)
                                                                  {
                                                                      <select class="form-select"
                                                                              @bind="subitem.RejectionId"
                                                                              @bind:after="() => OnRejectionChanged(subitem)">

                                                                          <option value="">-- Select Rejection --</option>

                                                                          @foreach (var rejection in RejectionMasterVMs)
                                                                          {
                                                                              <option value="@rejection.RejectionId">
                                                                                  @rejection.RejectionCode
                                                                              </option>
                                                                          }
                                                                      </select>
                                                                  }
                                                                  else
                                                                  {
                                                                      @(RejectionMasterVMs
                                                                          .FirstOrDefault(x => x.RejectionId == subitem.RejectionId)
                                                                          ?.RejectionCode ?? "")
                                                                  }
                                                              </td>
           
           
                                                          }
                                                           <!-- Remarks -->
                                                        
                                                   

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputTextArea @bind-Value="subitem.Remark"
                                                                                    class="form-control form-control-sm"
                                                                                    placeholder="Enter Remarks" 
                                                                                    rows ="1"/>
                                                                    <ValidationMessage For="@(() => subitem.Remark)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.Remark
                                                                }
                                                            </td>
                                                        
                                                         
                                                        <td>
                                                            <span>@subitem.QtyConvert?.ToString("0.###")</span>
                                                        </td>
                                                        
                                                        <!-- Unit Price -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm"  placeholder="Price" title="Enter Unit Price"
                                                                       @bind="subitem.UnitPrice" step="any"/>
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>
                                                         <!-- Ref GRN -->
                                                        <td>@subitem.RefGRNNo</td>
                                                        <td>@subitem.RefGRNDate?.ToString("dd/MM/yyyy")</td>
                                                         <td>@subitem.RefDcNo</td>
                                                        <td>@subitem.RefDcDate?.ToString("dd/MM/yyyy")</td>
                                                        
                                                         <!-- Ins No -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="text"
                                                                       class="form-control form-control-sm "
                                                                       placeholder="Inspection No"
                                                                       title="Enter Inspection No"
                                                                       @bind="subitem.InspectionNo"/>
                                                                <ValidationMessage For="@(() => subitem.InspectionNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.InspectionNo
                                                            }
                                                        </td>
                                                        <!--NCR No-->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="text"
                                                                       class="form-control form-control-sm "
                                                                       placeholder="NCR No"
                                                                       title="Enter NCR No"
                                                                       @bind="subitem.NCRNo"/>
                                                                <ValidationMessage For="@(() => subitem.NCRNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.NCRNo
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="text"
                                                                       class="form-control form-control-sm "
                                                                       placeholder="Batch No"
                                                                       title="Enter Batch No"
                                                                       @bind="subitem.BatchNo"/>
                                                                <ValidationMessage For="@(() => subitem.BatchNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.BatchNo
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="text"
                                                                       class="form-control form-control-sm "
                                                                       placeholder="Heat No"
                                                                       title="Enter Heat No"
                                                                       @bind="subitem.HeatNo"/>
                                                                <ValidationMessage For="@(() => subitem.HeatNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.HeatNo
                                                            }
                                                        </td>

                                                         <td>@subitem.Weight</td>

                                                        

                                                        <!-- Cost Center -->
                                                        <td>
                                                            @if (subitem.IsEditable && (subitem.RefGRNSubId == 0 || subitem.RefGRNSubId == null) && subitem.BalQty == subitem.AcceptQty)
                                                            {
                                                                <select class="form-select form-select-sm" 
                                                                    value="@subitem.CostId"
                                                                    @onchange="(e => OnCostCenterChanged(e, subitem))">
                                                                    <option value="">select CostCentre</option>
                                                                    @foreach (var cost in CostCenterVMs.Where(c =>
                                                                        !LabourSCNVMs.LabourSCNSubVMs.Any(r => r != subitem && r.CostId == c.Id)))
                                                                    {
                                                                        <option value="@cost.Id">@cost.ProjectNo</option>
                                                                    }
                                                                </select>
                                                                <ValidationMessage For="@(() => subitem.CostId)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.ProjectNo
                                                            }
                                                        </td>
                                                        <td>@subitem.Category</td>
                                                        @if (!LabourSCNVMs.SCNCancel  && (SCNId.HasValue || SCNId> 0))
                                                        {
                                                            <td class="text-center align-middle">

                                                                <div class="form-check form-switch d-flex justify-content-center">
                                                                    <InputCheckbox 
                                                                    @bind-Value="subitem.ItemCancel"
                                                                    @bind-Value:event="onchange"
                                                                    ValueChanged="@(async (value) => await OnItemCancelChanged(subitem))"
                                                                    class="form-check-input border border-2 shadow-lg focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                                </div>
                                                                <ValidationMessage For="@(() => subitem.ItemCancel)" 
                                                                    class="text-danger fw-semibold small mt-2 d-block" />
                                                            </td>
                                                             <td>
                                                                      @subitem.CancelItemReason 
                                                             </td>
                                                         }
                                                        <!-- Action Buttons -->
                                                        @if (!LabourSCNVMs.SCNCancel && !LabourSCNVMs.ShortClose)
                                                        {
                                                            <td class="freeze-last-col text-end">

                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                    @onclick="async () => await SaveRow(subitem)" disabled="@subitem.ItemCancel">
                                                                        <i class="bi bi-check-lg"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                    @onclick="async () => await CancelEdit(subitem, LabourSCNVMs)" disabled="@subitem.ItemCancel">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                    @onclick="async () => await EditRowAsync(subitem)" disabled="@subitem.ItemCancel">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                    @onclick="async () => await RemoveRow(subitem)" disabled="@subitem.ItemCancel">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                }

                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>


                                        </table>
                                    </div>
                                </div>


                                <!--------------Instraction---------->
                                <button class="btn btn-sm btn-outline-secondary mb-2"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#docInstructionBox">
                                    <i class="bi bi-info-circle"></i> Instructions
                                </button>

                                <div id="docInstructionBox" class="collapse">
                                       <div class="alert alert-light mt-2 py-2 small">
                                            <i class="bi bi-lightbulb me-1"></i>
                                            <strong>Document Instructions:</strong>

                                            <hr class="my-2" />

                                            <ul class="mb-0 mt-1">
                                                <li>
                                                    <b>Cancel:</b> Marks this SCN as cancelled and reverses the stock movement. 
                                                    <span class="text-muted">
                                                        (Stock will move back from <b>Main Store → Labour Store</b> • GRN balance restored)
                                                    </span>
                                                </li>

                                                <li>
                                                    <b>Revert:</b> Re-activates a cancelled SCN and applies the stock movement again. 
                                                    <span class="text-muted">
                                                        (Stock will move from <b>Labour Store → Main Store</b> • GRN balance reduced)
                                                    </span>
                                                </li>

                                                <li>
                                                    <b>Short Close:</b> Closes the document to prevent further processing. 
                                                    <span class="text-muted">
                                                        (Status only • No stock or balance change)
                                                    </span>
                                                </li>

                                                <li>
                                                    <b>Item-wise Cancel:</b> Cancels the selected item and reverses its stock movement. 
                                                    <span class="text-muted">
                                                        (Item stock moves back to <b>Labour Store</b> • Balance restored)
                                                    </span>
                                                </li>

                                                <li>
                                                    <b>Item-wise Revert:</b> Re-activates the cancelled item and applies stock movement again. 
                                                    <span class="text-muted">
                                                        (Item stock moves to <b>Main Store</b> • Balance reduced)
                                                    </span>
                                                </li>

                                            </ul>
                                        </div>
                                   </div>

                            </div>
                        </div>

                        @if (LabourSCNVMs.SCNId > 0)
                        {
                             <hr style="border: 0; height: 1px; background-color: #007bff; margin: 10px 0;" />
                            <div class="row g-3">
                                <div class="col-6 col-md-3">
                                    <div class="form-floating">
                                        <InputText @bind-Value="LabourSCNVMs.CreatedBy" class="form-control" id="CreatedBy" placeholder="Created By" CssClass="form-control" disabled />
                                        <label for="CreatedBy">Created By</label>
                                    </div>
                                </div>

                                <div class="col-6 col-md-3">
                                    <div class="form-floating">
                                        <input class="form-control" id="CreatedDate" value="@LabourSCNVMs.CreatedDate?.ToString("dd/MM/yyyy hh:mm:ss")" disabled />
                                        <label for="CreatedDate">Created Date</label>
                                    </div>
                                </div>

                                <div class="col-6 col-md-3">
                                    <div class="form-floating">
                                        <InputText @bind-Value="LabourSCNVMs.ModifiedBy" class="form-control" id="ModifiedBy" placeholder="Modified By" CssClass="form-control" disabled />
                                        <label for="ModifiedBy">Modified By</label>
                                    </div>
                                </div>

                                <div class="col-6 col-md-3">
                                    <div class="form-floating">
                                        <input class="form-control" id="ModifiedDate" value="@LabourSCNVMs.ModifiedDate?.ToString("dd/MM/yyyy  hh:mm:ss")" disabled />
                                        <label for="ModifiedDate">Modified Date</label>
                                    </div>
                                </div>
                            </div>
                             <hr style="border: 0; height: 1px; background-color: #007bff; margin: 10px 0;" />
                        }

                        <div class="row g-3">
                            <!-- Action Buttons -->
                            @if (CanCreate || CanEdit)
                            {
                                @if(!LabourSCNVMs.SCNCancel)
                                {
                                    <div class="col-6 col-md-3 mt-3">
                                        <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                            <i class="bi bi-floppy2-fill me-1"></i> @(LabourSCNVMs.SCNId > 0 ? "Update" : "Create")
                                        </button>
                                    </div>
                                  
                                }
                            }

                            <div class="col-6 col-md-3 mt-3">
                                <SmartBackButton Url="@($"/labourSCNList?currentPage={currentPage}")" />
                            </div>

                            @if ((!Autharization) || (Autharization && LabourSCNVMs.Authorized))
                            {
                                <div class="col-12 col-md-3">
                                     <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                        <i class="bi bi-printer me-1"></i>Print
                                    </button>
                                 </div>
                            }
                            else if (Autharization && !LabourSCNVMs.Authorized)
                            {

                                <button class="btn btn-danger" disabled title="Authorization required to generate PDF">
                                    <i class="bi bi-file-earmark-pdf"></i> Authorization Required
                                </button>

                            }
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

}



@code
{
    #region Parameters & Properties


    protected override string ScreenName => "Labour SCN";
    [Parameter] public int? SCNId { get; set; }
    [Parameter] public int CustId { get; set; }
    private bool isProcessing = false;
    private int screenCode { get; set; }

    private LabourSCNVM LabourSCNVMs { get; set; } = new();
    private List<ContactPerson> contactPersons = new();
    private List<CostCenterVM> CostCenterVMs = new();
    private CustomerVM? SelectedCustomer;
    private LabourSCNSubVM? rowToDelete;
    private LabourSCNSubVM? rowToCancel;

    private List<Store> AddStores = new();
    private List<Store> IssStores = new();

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;
    public bool Autharization = false;
     string? pdfBase64;

    private int GRNPendingCount = 0;
    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();
    private bool IsSomeItemsTransMade { get; set; } = false;

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private int DecimalPlaces { get; set; } = 2;
    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    // 🔹 Visible Column Titles
    private bool IsGRNModalVisible = false;
    private List<Dictionary<string, object>>? GRNData;

    private bool ParameterRequired{ get; set; } = false;

    #endregion

    private List<string> GRNColumns = new()
    {
        "GRNSubId","GRNId","GRN No.", "GRN Date","ItemId",
        "Item Code", "Item Name","Specification","UOM", "HSN Code",
        "Qty", "Bal Qty", "Unit Price","Stock Qty","Ref Dc No.","Ref DcDate","CostId",
        "Project No", "Remarks","Store Name","Customer"
    };

    // 🔹 Field Names (backend binding)
    private List<string> GRNFields = new()
    {
        "GRNSubId","GRNId","GRNNo", "GRNDate","ItemId",
        "ItemCode", "ItemName","Specification", "UOM", "HSNCode",
        "Qty", "BalQty", "UnitPrice","Stock Qty","RefDcNo","RefDcDate","CostId",
        "ProjectNo", "MainRemarks","Store Name","Customer"
    };

    // 🔹 Hidden Columns (IDs and internal refs)
    private List<string> GRNHiddenColumns = new()
    {
        "GRNSubId","ItemId", "CostId","GRNId"
    };

    private List<PageHeader.BreadcrumbItem> LabourSCNBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Labour" },
        new PageHeader.BreadcrumbItem { Text = "Store Credit Note", IsLast = true }
    };

    private bool IsRejectionSelection{ get; set; } = false;

    private List<RejectionMasterVM> RejectionMasterVMs = new();

    #region Initialization
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            ParameterRequired=await _scnService.GetParamemterLisAsync();
            DecimalPlaces = await _scnService.GetDecimalPlacesAsync();
            screenCode = await _scnService.GetScreenCodeByScreenNameAsync(ScreenName);
            IsRejectionSelection = await _scnService.GetRejectionSelectionEnableAsync();
            RejectionMasterVMs = await _scnService.GetAllRejectionReasonAsync();

            if (SCNId.HasValue)
            {
                await LoadExistingSCN(SCNId.Value);
            }
            else if (CustId > 0)
            {
                await InitializeNewGRN(CustId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingSCN(int scnId)
    {
        try
        {
            LabourSCNVMs = await _scnService.GetLabourSCNByIdAsync(scnId);
            if (LabourSCNVMs == null)
            {
                await _JS.ToastrWarning("SCN not found.");
                return;
            }

            SelectedCustomer = await _scnService.GetCustomerByIdAsync(LabourSCNVMs.CustId.Value);
            if (SelectedCustomer != null)
            {
                Autharization = (await userAuthority.GetAllWithUserAsync()).Any(x => x.IsLabourSCN == true);
                await ApplyCustomerSelectionAsync(SelectedCustomer);
            }

            foreach (var dcSub in LabourSCNVMs.LabourSCNSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[dcSub.ItemId.Value] =
                    await _scnService.GetCorrespondenceAttachmentsCountAsync(dcSub.ItemId.Value, "Item");
            }

            //Check Transaction Completed flag
            IsSomeItemsTransMade = await CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load Existing LabourSCN.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingDc failed in LabourSCN for SCNId: {scnId}");
        }
    }

    private async Task<bool> CheckIsTransMade()
    {
        try
        {
            if (!SCNId.HasValue)
                return false;

            return await _scnService.IsSCNTransactionsMatchedAsync(SCNId.Value, LabourSCNVMs);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to check transaction exists.");
            await LoggingService.LogDeveloperError(ex, "[CheckIsTransMade] failed");
            return false;
        }
    }


    private async Task InitializeNewGRN(int CustId)
    {
        try
        {
            var customer = await _scnService.GetCustomerByIdAsync(CustId);
            if (customer != null)
                await setStores();
            await ApplyCustomerSelectionAsync(customer);

            LabourSCNVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            LabourSCNVMs.SCNNo = await _scnService.GetLastSCNNumberAsync(LabourSCNVMs.Suffix);


        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to initialize new po.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewPo failed for CustId: {CustId}");
        }
    }
    private async Task setStores()
    {
        var MapStoreForGRN = await _scnService.GetMappedStoreForFormAsync("LabourDCInForm");

        if (MapStoreForGRN.StoreId > 0)
        {
            LabourSCNVMs.StoreIssId = MapStoreForGRN.StoreId;
            LabourSCNVMs.IssueStoreName = MapStoreForGRN.StoreName;

        }

        var MapStoreForDc = await _scnService.GetMappedStoreForFormAsync("SCNLabourForm");

        if (MapStoreForDc.StoreId > 0)
        {
            LabourSCNVMs.AddStoreId = MapStoreForDc.StoreId;
            LabourSCNVMs.AddStoreName = MapStoreForDc.StoreName;
        }

    }

    #endregion



    #region Customer data Handlers
    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<CustomerVM>();

        try
        {
            var results = await _scnService.SearchCustomersAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<CustomerVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<CustomerVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"In LabourSCNUpsert SearchCustomer failed for value: {value}");
            await _JS.ToastrError("Failed to search Customer in LabourSCNUpsert. Please try again.");
            return Enumerable.Empty<CustomerVM>();
        }
    }

    private async Task OnCustomerChanged(CustomerVM? customer)
    {
        try
        {
            await ApplyCustomerSelectionAsync(customer);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error in OnCustomerChanged: {ex}");
            await LoggingService.LogDeveloperError(ex, "Error in OnCustomerChanged");
            await _JS.ToastrError("Error while selecting");

        }
    }

    private async Task ApplyCustomerSelectionAsync(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;
            LabourSCNVMs.CustId = customer?.CustId ?? 0;
            LabourSCNVMs.CustName = customer?.CustName;
            LabourSCNVMs.CustAddress = customer?.CustAddr;
            LabourSCNVMs.CustGst = customer?.GSTNo;
            LabourSCNVMs.CustContactNo = customer?.ContactNo;

            if (customer == null)
            {
                AddStores.Clear();
                IssStores.Clear();
                return;
            }
            contactPersons = await _scnService.GetContactPersonsCustomerAsync(customer.CustId);

            AddStores = (await _scnService.GetAllAddStoresAsync()).ToList();
            IssStores = (await _scnService.GetAllIssueStoresAsync()).ToList();


            LabourSCNVMs.KindofAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPersonName : string.Empty;

            //Pending PoDetails
            GRNPendingCount = await _scnService.GetPendingGRNCountAsync(customer.CustId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {customer?.CustId}");
            await _JS.ToastrError("Failed to apply Customer selection. Please try again.");
        }
    }
    #endregion

    #region Item Handlers

    private async Task<IEnumerable<ItemVM>> SearchItems(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        try
        {
            var results = await _scnService.SearchItemsAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<ItemVM>();
        }
        catch (OperationCanceledException)
        {
            // Typing too fast, search canceled - silently ignore
            return Enumerable.Empty<ItemVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchItems failed for value: {value}");
            await _JS.ToastrError("Failed to search items. Please try again.");
            return Enumerable.Empty<ItemVM>();
        }
    }

    private async Task OnItemChanged(LabourSCNSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItem = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.HSNCode = item.HSNCode;
                subitem.MeasureUnit = item.MeasureUnit;
                subitem.Specification = item.Specification;
                subitem.Category = item.CategoryName;

                if (LabourSCNVMs?.CustId != null && subitem.ItemId.HasValue)
                {
                    var rates = await _scnService.GetBulkLastUnitPricesAsync(new List<int> { subitem.ItemId.Value }, LabourSCNVMs.CustId.Value);
                    if (rates.TryGetValue(subitem.ItemId.Value, out decimal rate))
                    {
                        subitem.UnitPrice = rate;
                    }
                }

                if (subitem.ItemId > 0)
                {
                    var count = await _scnService.GetCorrespondenceAttachmentsCountAsync(subitem.ItemId.Value, "Item");
                    attachmentCounts[subitem.ItemId.Value] = count;
                }
            }
            else
            {
                // Reset when deselected
                subitem.SelectedItem = null;
                subitem.ItemId = null;
                subitem.ItemCode = null;
                subitem.ItemName = null;
                subitem.HSNCode = null;
                subitem.MeasureUnit = null;
                subitem.UnitPrice = 0m;
                subitem.Specification = null;
                subitem.Category = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"In LabourSCNUpsert OnItemChanged failed for ItemId: {item?.ItemId}");
            await _JS.ToastrError("Failed to apply item selection  in LabourSCNUpsert. Please try again.");
        }
    }

    private bool IsItemAlreadySelected(int itemId, int? currentItemId)
    {
        return LabourSCNVMs.LabourSCNSubVMs?.Any(q => q.ItemId == itemId && q.ItemId != currentItemId) == true;
    }
    #endregion

    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, LabourSCNSubVM SubVM)
    {
        try
        {

            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty < 0)
            {
                await _JS.ToastrWarning("Issue Qty must be a positive number.");
                return;
            }
            decimal acceptQty = SubVM.AcceptQty ?? 0m;
            decimal rejectQty = SubVM.RejectQty ?? 0m;
            decimal reworkQty = SubVM.ReworkQty ?? 0m;
            decimal enteredTotal = acceptQty + rejectQty + reworkQty;

            decimal stockQty = await _scnService.GetStockQtyFromStockManager(SubVM.ItemId.Value, LabourSCNVMs.StoreIssId.Value);
            if (stockQty <= 0)
            {
                await _JS.ToastrWarning("No stock available for this item.");
                return;
            }

            // NEW Po line
            if (SubVM.SCNSubId == 0)
            {
                if (enteredTotal > stockQty)
                {
                    await _JS.ToastrWarning($"AcceptQty+RejectQty+ReworkQty.{enteredTotal} Quantity should not be greater than StockQty.");
                    SubVM.AcceptQty = stockQty;
                    SubVM.RejectQty = 0;
                    SubVM.ReworkQty = 0;
                    return;
                }

                if (SubVM.RefGRNSubId > 0)
                {
                    var grnBalQty = await _scnService.GetGRNItemBalQtyFromGRNSubId(SubVM.RefGRNSubId.Value);

                    // Validation
                    if (enteredTotal > grnBalQty)
                    {

                        // Optionally reset to available balance
                        SubVM.AcceptQty = grnBalQty;
                        SubVM.BalQty = grnBalQty;
                    }
                    else
                    {
                        SubVM.AcceptQty = enteredTotal;
                        SubVM.BalQty = enteredTotal;
                    }
                }
                else
                {
                    SubVM.AcceptQty = newQty;
                    SubVM.BalQty = newQty;
                }
            }

            // Modify SCN line
            else
            {
                var original = await _scnService.GetSCNSubItemDetailBySCNSubIdAsync(SubVM.SCNSubId);
                if (original == null) return;

                var alreadyTransacted = original.AcceptQty - original.BalQty;


                var effectiveStock = (stockQty + original.AcceptQty);

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.AcceptQty = alreadyTransacted;
                    SubVM.BalQty = 0;
                    await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefGRNSubId > 0)
                {
                    var grnBalQty = await _scnService.GetGRNItemBalQtyFromGRNSubId(SubVM.RefGRNSubId.Value);
                    var maxAllowedQty = original.AcceptQty + grnBalQty;

                    var allowedQty = Math.Min(maxAllowedQty.GetValueOrDefault(), effectiveStock.GetValueOrDefault());

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.AcceptQty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();
                        await _JS.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.OR Available Stock ({effectiveStock}) ");
                    }
                    else
                    {

                        SubVM.AcceptQty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted.GetValueOrDefault();
                    }
                }
                else
                {
                    var allowedQty = effectiveStock;

                    if (newQty > allowedQty)
                    {
                        SubVM.AcceptQty = allowedQty;
                        SubVM.BalQty = allowedQty - alreadyTransacted;

                        await _JS.ToastrWarning($"Issue Qty cannot exceed Stock Qty ({effectiveStock})."
                        );
                    }
                    else
                    {
                        SubVM.AcceptQty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }

                }
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for SCNSubId: {SubVM?.SCNSubId}");
            await _JS.ToastrError("Failed to update quantity. Please try again.");
        }
        finally
        {

        }

    }

    private async Task OnAccpQtyChange(decimal? newValue, LabourSCNSubVM subVM)
    {
        try
        {
            var accp = newValue.GetValueOrDefault();
            if (accp < 0)
            {
                subVM.AcceptQty = 0;
                await _JS.ToastrWarning("Accepted Qty must be positive.");
                return;
            }

            var rej = subVM.RejectQty.GetValueOrDefault();
            var rew = subVM.ReworkQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, "Accepted"))
            {
                subVM.AcceptQty = accp;
                subVM.BalQty = subVM.BalQty;
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnAccpQtyChange failed");
            await _JS.ToastrError("Failed to update Accepted Qty.");
        }
    }

    private async Task AdjustQty( LabourSCNSubVM subVM,  string field, decimal max, decimal accp, decimal rej, decimal rew)
    {
        switch (field)
        {
            case "Accepted":
                subVM.AcceptQty = max - (rej + rew);
                break;

            case "Rejected":
                subVM.RejectQty = max - (accp + rew);

                break;

            case "Rework":
                subVM.ReworkQty = max - (accp + rej);

                break;
        }

    }


    private async Task<bool> ValidateAndAdjustAsync( LabourSCNSubVM subVM,  decimal newAccp,  decimal newRej,  decimal newRew,  string fieldName)
    {
        var grnBalQty = await _scnService
            .GetGRNItemBalQtyFromGRNSubId(subVM.RefGRNSubId!.Value);

        var original = subVM.SCNSubId > 0
            ? await _scnService.GetSCNSubItemDetailBySCNSubIdAsync(subVM.SCNSubId)
            : null;

        decimal origAccp = original?.AcceptQty ?? 0;
        decimal origRej  = original?.RejectQty ?? 0;
        decimal origRew  = original?.ReworkQty ?? 0;
        decimal origBal  = original?.BalQty ?? 0;
        decimal origSCnBal  = original?.SCNBalQty ?? 0;

        decimal originalTotal = origAccp + origRej + origRew;
        decimal maxAllowed = grnBalQty + originalTotal;
        decimal total = newAccp + newRej + newRew;
        decimal totalRejRew =  newRej + newRew;


        decimal originalRejRewTotal =  origRej + origRew;

        decimal alreadyTransacted = 0;
        decimal alreadyTransactedSCN = 0;

        if( original != null)
        {
            alreadyTransacted = originalTotal - (origBal + origRej + origRew);
            alreadyTransactedSCN=originalRejRewTotal - origSCnBal;
        }
        else
        {
            alreadyTransacted = 0;
        }

        if (subVM.SCNSubId > 0 && total < alreadyTransacted)
        {
            alreadyTransacted = alreadyTransacted + origRej + origRew;

            await AdjustQty(subVM, fieldName, alreadyTransacted, newAccp, newRej, newRew);
            subVM.BalQty = 0m;

            if(originalRejRewTotal < alreadyTransactedSCN)
            {
                subVM.SCNBalQty = 0m;
            }

            await _JS.ToastrWarning(
                $"Total Qty cannot be less than {alreadyTransacted} (already transacted).");
            return false;
        }
        if(subVM.SCNSubId > 0 && totalRejRew < alreadyTransactedSCN)
        {
            alreadyTransactedSCN = originalTotal - alreadyTransactedSCN;

            await AdjustQty(subVM, fieldName, alreadyTransactedSCN, newAccp, newRej, newRew);
            subVM.SCNBalQty = 0m;

            await _JS.ToastrWarning(
                $"Total Qty cannot be less than {alreadyTransacted} (already transacted).");
            return false;
        }

        if (total > maxAllowed)
        {
            await AdjustQty(subVM, fieldName, maxAllowed, newAccp, newRej, newRew);

            if (original != null)
            {
                var diff = subVM.AcceptQty.GetValueOrDefault() - origAccp;
                subVM.BalQty = Math.Max(0m, origBal + diff);

                var Diffrej =(subVM.RejectQty.GetValueOrDefault() + subVM.ReworkQty.GetValueOrDefault()) - originalRejRewTotal;
                subVM.SCNBalQty = Math.Max(0m, alreadyTransactedSCN + Diffrej);


            }
            else
            {
                subVM.BalQty = subVM.AcceptQty;
                subVM.SCNBalQty =
                   subVM.RejectQty.GetValueOrDefault()
                  + subVM.ReworkQty.GetValueOrDefault();

            }

            await _JS.ToastrWarning($"{fieldName} change exceeded limit. Max allowed total is {maxAllowed}.");
            return false;
        }

        if (original != null)
        {
            var diff = subVM.AcceptQty.GetValueOrDefault() - origAccp;

            subVM.BalQty = Math.Max(0m, origBal + diff);

            var Diffrej =(subVM.RejectQty.GetValueOrDefault() + subVM.ReworkQty.GetValueOrDefault()) - originalRejRewTotal;
            subVM.SCNBalQty = Math.Max(0m, alreadyTransactedSCN + Diffrej);

        }
        else
        {
            subVM.BalQty = subVM.AcceptQty;
            subVM.SCNBalQty =subVM.RejectQty.GetValueOrDefault() + subVM.ReworkQty.GetValueOrDefault();
        }

        return true;
    }



