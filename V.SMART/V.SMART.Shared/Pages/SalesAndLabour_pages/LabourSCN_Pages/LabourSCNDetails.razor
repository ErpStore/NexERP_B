@page "/labourSCN/details/{SCNId:int}"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ILabourServices
@using V.SMART.Shared.Repository.IRepository.IMasterRepository.IAdmins
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.LabourSCN_VM

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ILabourSCNService _scnService
@inject IUserAuthorityRepository userAuthority
@inject ReportService reportService

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

        <!-- Company Details Section -->
        <div class="row align-items-center mb-4 g-4">
            <div class="col-12 col-lg-3 text-center">
                @if (!string.IsNullOrEmpty(company?.LogoUrl))
                {
                    <img src="@company.LogoUrl" alt="Company Logo" class="img-fluid rounded-3" style="max-height:120px;" />
                }
            </div>
            <div class="col-12 col-lg-9 text-lg-start text-center">
                <h2 class="text-primary fw-bold mb-1">@company?.CompanyName</h2>
                <p class="text-muted mb-1">@company?.RegisteredAddress</p>
                <p class="text-muted mb-0"><strong>GST No:</strong> @(company?.GSTIN ?? "N/A")</p>
            </div>
        </div>

        <hr class="border-2 border-primary-subtle mb-4" />

        <!-- CustOmer & Document Details Section -->
        <div class="row g-3 mb-4">
            <!-- CustOmer Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Customer Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(LabourSCNVMs?.CustName) ? LabourSCNVMs.CustName : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(LabourSCNVMs?.CustAddress) ? LabourSCNVMs.CustAddress : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>GSTIN</strong></td><td>@(!string.IsNullOrEmpty(LabourSCNVMs?.CustGst) ? LabourSCNVMs.CustGst : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(LabourSCNVMs?.CustContactNo) ? LabourSCNVMs.CustContactNo : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Contact Person</strong></td><td>@(!string.IsNullOrEmpty(LabourSCNVMs?.KindofAttention) ? LabourSCNVMs.KindofAttention : "N/A")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Document Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Document Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>SCN No</strong></td>
                                    <td>@(LabourSCNVMs != null ? $"{LabourSCNVMs.SCNNo}{LabourSCNVMs.Suffix}" : "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>SCN Date</strong></td>
                                    <td>@(LabourSCNVMs?.SCNDate.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Issue Store.</strong></td>
                                    <td>@(LabourSCNVMs?.IssueStoreName.ToString() ?? "N/A")</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Add Store.</strong></td>
                                    <td>@(LabourSCNVMs?.AddStoreName?.ToString() ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Remarks.</strong></td>
                                    <td>@(LabourSCNVMs?.MainRemarks ?? "N/A")</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- DC Items Section -->
        <div class="card border-1 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                Purchase GRN Items
            </div>
            <div class="table-responsive" style="overflow-x:auto;">
                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                    <thead class="custom-blue">
                        <tr>
                            <th>Sl No.</th>
                            <th>Item Code</th>
                            <th>Description</th>
                            <th>UOM</th>
                            <th>HSN</th>
                            <th>Accept Qty</th>
                            <th>Reject Qty</th>
                            <th>Rework Qty</th>
                            <th>Unit Price</th>
                            <th>Basic Amount</th>
                            <th>Ref GRN No</th>
                            <th>Ref GRN Date</th>
                            <th>Ref Dc No</th>
                            <th>Ref Dc Date</th>
                            <th>Inspectio No.</th>
                            <th>NCR No.</th>
                            <th>Batch No.</th>
                            <th>Heat No.</th>
                            <th>Remarks</th>
                            <th>Cost-Center</th>
                            <th>Item Cancel</th>
                            <th>Specification</th>
                            <th>Category</th>
                        </tr>
                    </thead>
                    <tbody class="custom-size">
                        @if (LabourSCNVMs?.LabourSCNSubVMs != null && LabourSCNVMs.LabourSCNSubVMs.Any())
                        {
                            @foreach (var item in LabourSCNVMs.LabourSCNSubVMs)
                            {
                                <tr>
                                    <td>@item.SlNo</td>
                                    <td>@(item.ItemCode ?? "—")</td>
                                    <td>@(item.ItemName ?? "—")</td>
                                    <td>@item.MeasureUnit</td>
                                    <td>@item.HSNCode</td>
                                    <td>@FormatDecimal(item.AcceptQty)</td>
                                    <td>@FormatDecimal(item.RejectQty)</td>
                                    <td>@FormatDecimal(item.ReworkQty)</td>
                                    <td>@FormatDecimal(item.UnitPrice)</td>
                                    <td>@FormatDecimal(item.AcceptQty * item.UnitPrice)</td>
                                    <td>@item.RefGRNNo </td>
                                    <td>@item.RefGRNDate </td>
                                    <td>@item.RefDcNo</td>
                                    <td>@item.RefDcDate </td>
                                    <td>@item.InspectionNo </td>
                                    <td>@item.NCRNo </td>
                                    <td>@item.BatchNo </td>
                                    <td>@item.HeatNo </td>
                                   
                                    <td>@item.Remark </td>
                                    <td>@item.ProjectNo </td>
                                    <td>@item.ItemCancel </td>
                                    <td>@item.Specification </td>
                                    <td>@item.Category </td>
                                   
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" class="text-center text-muted">No items found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Actions -->
        @if (isOtherScreen == false)
        {
            <div class="d-flex gap-2 justify-content-end">
                <a href="@($"/labourSCNList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                    <i class="bi bi-arrow-bar-left me-1"></i> Back To List
                </a>
                <a href="@($"/labourSCN/update/{SCNId}")" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Modify
                </a>

                @if ((!Autharization) || (Autharization && LabourSCNVMs.Authorized))
                {
                    <button class="btn btn-outline-danger" @onclick="GenerateInspectionprint">
                        <i class="bi bi-check2-square"></i> Inspection Print
                    </button>

                    <button class="btn btn-outline-warning" @onclick="GenerateTagsprint">
                        <i class="bi bi-tags"></i> Tags Print
                    </button>

                    <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                        <i class="bi bi-printer"></i> Print
                    </button>
                }
                else if (Autharization && !LabourSCNVMs.Authorized)
                {

                    <button class="btn btn-danger" disabled title="Authorization required to generate PDF">
                        <i class="bi bi-file-earmark-pdf"></i> Authorization Required
                    </button>

                }


            </div>

        }

    </div>
}


@code
{
    protected override string ScreenName => "Labour SCN";

    [Parameter] public int SCNId { get; set; }
    [Parameter] public bool isOtherScreen { get; set; }
    string? pdfBase64;
    private bool isProcessing { get; set; } = true;

    private LabourSCNVM LabourSCNVMs { get; set; } = new LabourSCNVM();
    private CustomerVM CustomerVMs { get; set; } = new CustomerVM();

    private Companydetails company { get; set; } = new Companydetails();
    public bool Autharization = false;

    private List<LabourSCNSubVM> refGRNs = new();
    private string refGRNNosDisplay = "N/A";
    private string refGRNDatesDisplay = "N/A";

    private int Decimalplaces { get; set; } = 2;

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private string FormatDecimal(decimal? value)
    {
        if (value == null) return "0";
        return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            company = await _scnService.GetCompanyDetailsAsync();
            await LoadDcDetails();
            isProcessing = false;
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Faild in OnInitializedAsync purchase SCN");
        }
    }

    private async Task LoadDcDetails()
    {
        if (SCNId > 0)
        {
            var grn = await _scnService.GetLabourSCNByIdAsync(SCNId);
            if (grn != null)
            {
                LabourSCNVMs = grn;
                Autharization = (await userAuthority.GetAllWithUserAsync()).Any(x => x.IsPurchSCN == true);
            }

            Decimalplaces = await _scnService.GetDecimalPlacesAsync();

            CustomerVMs = await _scnService.GetCustomerByIdAsync(LabourSCNVMs.CustId.Value);

            // refGRNs = await _scnService.GetDistinctRefGRNBySCNIdAsync(LabourSCNVMs.SCNId);

            if (refGRNs.Any())
            {
                // Only join the existing items, no extra commas
                refGRNNosDisplay = string.Join(", ", refGRNs.Select(e => e.RefGRNNo).Where(n => !string.IsNullOrEmpty(n)));
                refGRNDatesDisplay = string.Join(", ", refGRNs
                    .Select(e => e.RefGRNDate.HasValue ? e.RefGRNDate.Value.ToString("dd/MM/yyyy") : null)
                    .Where(d => !string.IsNullOrEmpty(d)));
            }
        }
    }


    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(SCNId, "LabourSCN.frx", "SCNId", LabourSCNVMs.SCNCancel, "Labour SCN", "Sp_Print_LabourSCN");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _JS.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _JS.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _JS.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf LabourSCN");
            await _JS.ToastrError("An unexpected error occurred while generating the PDF in LabourSCN.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task GenerateTagsprint()
    {
        isProcessing = true;
        pdfBase64 = null;

        var pdfBytes = await reportService.Generate_Report(SCNId, "LabGRNPrintingStickerLabel.frx", "GRNId", LabourSCNVMs.SCNCancel, "Tags", "Sp_Print_GRNDetailsLabelPrint");

        if (pdfBytes != null && pdfBytes.Length > 0)
        {
            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _JS.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
    }
    private async Task GenerateInspectionprint()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(SCNId, "IncomingInspection.frx", "SCNId", LabourSCNVMs.SCNCancel, "FinalInspection", "Sp_Print_LabourSCN");

            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _JS.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateInspectionprint Labour GRN");
            await _JS.ToastrError("An unexpected error occurred while generating the GenerateInspectionprint.");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
