@page "/enquirySales"

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ExcelExportService ExcelExportService
@inject IEnquirySalesService enquirySalesService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Sales Enquiry List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@EnqBreadcrumbs" />

            <div class="card-body p-4">

                 <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                 value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Short Closed">Short Closed</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                       <div class="col-6 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewEnquiry">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </button>
                       </div>
                    }

                </div>

                @if (EnquirySalesVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="EnquirySalesVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Any(c => c.IsVisible))
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                <div>
                                    @switch (col.Field)
                                    {
                                        case "EnquiryId":
                                            <PropertyColumn Title="Enquiry ID" Property="@(c => c.EnquiryId)" />
                                            break;

                                        case "Prefix":
                                            <PropertyColumn Title="Prefix" Property="@(c => c.Prefix)" />
                                            break;

                                         case "EnquiryNo":
                                            <PropertyColumn Title="Enquiry No"
                                                            Property="@(c => $"{c.EnquiryNo}{c.Suffix ?? string.Empty}")"
                                                            Sortable="true" />
                                            break;

                                        case "EnquiryDate":
                                            <PropertyColumn Title="Enquiry Date"
                                                            Property="@(c => c.EnquiryDate)"
                                                            Format="dd/MM/yyyy"
                                                            Sortable="true" />
                                            break;

                                        case "MfgORLab":
                                            <TemplateColumn Title="Type" Context="c">
                                                @if (c.MfgORLab)
                                                {
                                                    <span class="badge text-bg-primary bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-gear-fill me-1"></i> Manufacturing
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-info bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-people-fill me-1"></i> Labour
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        case "CustId":
                                            <PropertyColumn Title="Customer ID" Property="@(c => c.CustId)" />
                                            break;

                                        case "CustomerName":
                                            <PropertyColumn Title="Customer Name"
                                                            Property="@(c => c.CustomerName)"
                                                            Sortable="true" />
                                            break;

                                        case "NoOfItems":
                                            <PropertyColumn Title="No Of Items"
                                                            Property="@(c => c.NoOfItems)" />
                                            break;

                                        case "TotalValue":
                                            <PropertyColumn Title="Total Value"
                                                            Property="@(c => c.TotalValue)"
                                                            Format="N2" />
                                            break;

                                        case "KindOfAttention":
                                            <PropertyColumn Title="Kind Of Attention"
                                                            Property="@(c => c.KindOfAttention)" />
                                            break;

                                        case "MainRemarks":
                                            <PropertyColumn Title="Remarks"
                                                            Property="@(c => c.MainRemarks)" />
                                            break;

                                        case "ExpectedReplyDate":
                                            <TemplateColumn Title="Expected Reply Date" Context="c">
                                                @if (!c.EnquiryTally && !c.Cancel && !c.ShortClose && c.ExpectedReplyDate.HasValue)
                                                {
                                                    var dueDays = (DateTime.Today - c.ExpectedReplyDate.Value.Date).Days;

                                                    if (dueDays > 0)
                                                    {
                                                        <span class="badge text-bg-danger bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-exclamation-circle me-1"></i>
                                                            @dueDays Due Day@(dueDays > 1 ? "s" : "")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">
                                                            @c.ExpectedReplyDate.Value.ToString("dd/MM/yyyy")
                                                        </span>
                                                    }
                                                }
                                                else if (c.ExpectedReplyDate.HasValue)
                                                {
                                                    <span class="text-muted">
                                                        @c.ExpectedReplyDate.Value.ToString("dd/MM/yyyy")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </TemplateColumn>
                                            break;


                                        case "status":
                                            <TemplateColumn Title="Enquiry Status" Context="c">
                                                @if (c.Cancel)
                                                {
                                                    <span class="badge text-bg-danger bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-x-circle me-1"></i> Cancelled
                                                    </span>
                                                }
                                                else if (c.ShortClose)
                                                {
                                                    <span class="badge text-bg-secondary bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-slash-circle me-1"></i> Short Closed
                                                    </span>
                                                }
                                                else if (c.EnquiryTally)
                                                {
                                                    <span class="badge text-bg-success bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-check-circle me-1"></i> Completed
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-warning bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-hourglass-split me-1"></i> Pending
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        case "CancelReason":
                                            <PropertyColumn Title="Cancel Reason"
                                                            Property="@(c => c.CancelReason)" />
                                            break;

                                        case "CancelDate":
                                            <PropertyColumn Title="Cancel Date"
                                                            Property="@(c => c.CancelDate)"
                                                            Format="dd/MM/yyyy" />
                                            break;

                                        case "CancelBy":
                                            <PropertyColumn Title="Cancel By"
                                                            Property="@(c => c.CancelBy)" />
                                            break;

                                        case "CreatedBy":
                                            <PropertyColumn Title="Created By"
                                                            Property="@(c => c.CreatedBy)" />
                                            break;

                                        case "CreatedDate":
                                            <PropertyColumn Title="Created Date"
                                                            Property="@(c => c.CreatedDate)"
                                                            Format="dd/MM/yyyy" />
                                            break;

                                        case "ModifiedBy":
                                            <PropertyColumn Title="Modified By"
                                                            Property="@(c => c.ModifiedBy)" />
                                            break;

                                        case "ModifiedDate":
                                            <PropertyColumn Title="Modified Date"
                                                            Property="@(c => c.ModifiedDate)"
                                                            Format="dd/MM/yyyy" />
                                            break;
                                    }
                                </div>
                            }
                        }

                            
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"enquirySales/update/{c.EnquiryId}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Job Order">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"enquiryDetails/{c.EnquiryId}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View JobOrder">
                                           <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete Item"
                                                @onclick="() => HandleDelete(c.EnquiryId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>
                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="container-fluid">

                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="fw-semibold small px-1">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                                <button class="btn btn-success btn-sm d-flex align-items-center ms-5"
                                        @onclick="HandleExport">

                                    <i class="bi bi-download me-1"></i>
                                    Export Enquiry's

                                </button>

                            </div>

                        </div>

                    </div>
                    

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}


@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Enquiry Sales";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteEnqId = 0;
    private string searchText = string.Empty;
    private string selectedStatus = "";

    private List<EnquirySalesVM> EnquirySalesVMs = new();

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> EnqBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Sales" },
        new PageHeader.BreadcrumbItem { Text = "Enquiry-Inward", IsLast = true }
    };

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllEnquiries();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    #region === Data Loading ===

    private async Task LoadAllEnquiries()
    {
        try
        {
            var result = await enquirySalesService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            EnquirySalesVMs = result.enquirySalesVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading data in Sales-EnquiryList");
            await _JS.ToastrError("Failed to load Sales Enquiry List.");
        }
    }

    private void AddNewEnquiry()
    {
        _navigation.NavigateTo("/Customer/Select?ReturnUrl=enquirySales/create/{id}");
    }

    #endregion



    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "Enquiry ID", Field = "EnquiryId", IsVisible = false },

                new() { Title = "Prefix", Field = "Prefix", IsVisible = false },

                new() { Title = "Enquiry No", Field = "EnquiryNo", IsVisible = true },
                new() { Title = "Enquiry Date", Field = "EnquiryDate", IsVisible = true },

                new() { Title = "Manufacturing / Labour", Field = "MfgORLab", IsVisible = true },

                new() { Title = "Customer ID", Field = "CustId", IsVisible = false },
                new() { Title = "Customer Name", Field = "CustomerName", IsVisible = true },

                new() { Title = "No Of Items", Field = "NoOfItems", IsVisible = true },

                new() { Title = "Total Value", Field = "TotalValue", IsVisible = false },

                new() { Title = "Kind Of Attention", Field = "KindOfAttention", IsVisible = true },

                new() { Title = "Remarks", Field = "MainRemarks", IsVisible = false },

                new() { Title = "Expected Reply Date", Field = "ExpectedReplyDate", IsVisible = false },

                new() { Title = "Enquiry Status", Field = "status", IsVisible = true },

                new() { Title = "Cancel Reason", Field = "CancelReason", IsVisible = false },
                new() { Title = "Cancel Date", Field = "CancelDate", IsVisible = false },
                new() { Title = "Cancel By", Field = "CancelBy", IsVisible = false },

                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },

                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }

            };

            if (!Hidden)
            {
                // Columns.AddRange(new[]
                // {
                //     new GridColumn { Title = "Extra Column 1", Field = "Extra1", IsVisible = false },
                //     new GridColumn { Title = "Extra Column 2", Field = "Extra2", IsVisible = false },
                // });
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for SalesEnquiryList");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the SalesEnquiryList HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllEnquiries();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in SalesEnquiryList");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllEnquiries();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in SalesEnquiryList");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllEnquiries();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in SalesEnquiryList");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllEnquiries();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in SalesEnquiryList");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllEnquiries();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in SalesEnquiryList");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllEnquiries();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing SalesEnquiryList page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int enqId)
    {
        try
        {

            var (canDelete, message) = await enquirySalesService.CanDeleteSalesEnquiryAsync(enqId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteEnqId = enqId;


            ModalTitle = "Are you sure you want to delete this Enquiry";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for EnquiryId: {enqId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;

            var deleted = await enquirySalesService.DeleteEnquiryAsync(DeleteEnqId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Sales Enquiry deleted successfully.");
                await LoadAllEnquiries();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Enquiry could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting EnquiryId: {DeleteEnqId}");
            await _JS.ToastrError("Failed to delete Sales Enquiry.");
        }
        finally
        {
            DeleteEnqId = 0;
            isProcessing = false;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
            {
                await ConfirmDelete_Click(isConfirmed);
            }
            else if (confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllEnquiries();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in SalesEnquiryList");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion


    #region Job order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

           if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;


            currentPage = 1;
            await LoadAllEnquiries();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in SalesEnquiryList");
            await _JS.ToastrError("Failed to Load Sales Enquiry List filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion 

    private async Task HandleExport()
    {

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }
    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var dt = await enquirySalesService.GetSalesandLabeourEnquiryPendingList(selectedStatus);

            var exportData = dt.AsEnumerable()
                .Select(row => dt.Columns.Cast<DataColumn>()
                    .ToDictionary(col => col.ColumnName, col => row[col]))
                .ToList();

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "SalesEnquiry", "Sales and Labour Enquiry's Pending List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "SalesandLabourEnquiryExport.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (Sales and Labour Enquiry's)");
            await _JS.ToastrError("Error while exporting Sales and Labour!");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
