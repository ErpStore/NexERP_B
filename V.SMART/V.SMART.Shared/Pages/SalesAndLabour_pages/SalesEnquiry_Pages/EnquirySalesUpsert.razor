    #region Upsert / Validation

    private async Task UpsertEnquirySales()
    {
        isProcessing = true;
        try
        {
            EnquirySalesVM.EnquirySalesSubVM.RemoveAll(x =>
                (x.ItemId.GetValueOrDefault() == 0) &&
                (x.Qty.GetValueOrDefault() <= 0));

            if (await toValidateEnuiry())
            {
                var isNewEnquiry = EnquirySalesVM.EnquiryId == 0;

                @if (isNewEnquiry)
                {
                    bool isDuplicate = await enquiryService.IsDuplicateEnquiryAsync(EnquirySalesVM.EnquiryNo, EnquirySalesVM.Suffix, EnquirySalesVM.EnquiryId, EnquirySalesVM.CustId);
                    if (isDuplicate)
                    {
                        await _js.ToastrError($"Enquiry No '{EnquirySalesVM.EnquiryNo}' with Customer '{EnquirySalesVM.CustomerName}' already exists.");
                        return;
                    }
                }

                await enquiryService.UpsertEnquirySalesAsync(EnquirySalesVM);

                if (isNewEnquiry)
                {
                //     ModalTitle = "Are you sure you want to print created enquiry?";
                //     btnColor = "btn-success";
                //     btnText = "Yes! Print";
                //     confirmation = "Print";
                //     showCancelReasonBox = false;

                    await _js.ToastrSuccess("Enquiry saved successfully.");
                }else
                {
                    await _js.ToastrSuccess("Enquiry updated successfully.");
                }

                // Discard popup Clear
                await _js.InvokeVoidAsync("NavigationGuard.clear");

                _navigationManager.NavigateTo("/enquirySales");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertEnquirySales");
            await _js.ToastrError("Error saving enquiry.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> toValidateEnuiry()
    {
        bool valid = true;

        if (EnquirySalesVM.MfgORLab == null)
        {
            await _js.ToastrWarning("Please select Manufacturing Or Labour");
            valid = false;
        }
        else if (string.IsNullOrEmpty(EnquirySalesVM.EnquiryNo))
        {
            await _js.ToastrWarning("Please enter Enquiry No.");
            valid = false;
        }
        else if (EnquirySalesVM.CustId == 0)
        {
            await _js.ToastrWarning("Please select Customer.");
            valid = false;
        }
        else if (!EnquirySalesVM.EnquirySalesSubVM.Any())
        {
            await _js.ToastrWarning("At least one row item is required.");
            valid = false;
        }
        else
        {
            foreach (var line in EnquirySalesVM.EnquirySalesSubVM)
            {
                if (line.ItemId.GetValueOrDefault() == 0)
                {
                    await _js.ToastrWarning("Please select Item for all rows.");
                    valid = false;
                    break;
                }
                if (line.Qty <= 0)
                {
                    await _js.ToastrWarning("Quantity must be greater than 0 for all rows.");
                    valid = false;
                    break;
                }
            }
        }

        return valid;
    }
    #endregion


    #region Item Cancel or Cancel or Short- Close

    private async Task OnItemCancelChanged(EnquirySalesSubVM subitem)
    {
        try
        {
            if (subitem.EnquirySubId == 0)
            {
                await _js.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if(subitem.Qty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _js.ToastrError("some Sales Quotation transactions made. You can't cancel Item.");
                return;
            }

            if (EnquirySalesVM.Cancel)
            {
                await _js.ToastrError("Enquiry is already Cancel. You can't cancel Item.");
                return;
            }

            var (CanItemCancel, message) = await enquiryService.CanEnquiryItemCancelCheckAsync(subitem);

            if (!CanItemCancel)
            {
                await _js.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _js.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _js.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in Material Requisition");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CancelItem(EnquirySalesSubVM rowToCancel)
    {
        if (rowToCancel == null) return;
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!rowToCancel.ItemCancel)
            {
                rowToCancel.ItemCancel = true;
                rowToCancel.ItemCancelReason = cancelReason;

                await enquiryService.UpdateItemCancelAndAddorRevertAsync(rowToCancel, EnquiryId.GetValueOrDefault());

                await LoggingService.LogUserAction(
                username, machine, ip,
                screen: "Enquiry Sales",
                action: $"Cancelled EnquirySales No: {EnquirySalesVM.EnquiryNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }
            else
            {
                rowToCancel.ItemCancel = false;
                rowToCancel.ItemCancelReason = cancelReason;

                await enquiryService.UpdateItemCancelAndAddorRevertAsync(rowToCancel, EnquiryId.GetValueOrDefault());

                await LoggingService.LogUserAction(
                username, machine, ip,
                screen: "Enquiry Sales",
                action: $"Reverted EnquirySales No: {EnquirySalesVM.EnquiryNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }

            EnquirySalesVM.EnquirySalesSubVM = await enquiryService
                   .GetEnqSubByEnquiryIdAsync(EnquirySalesVM.EnquiryId);

            await ResetSlno();

            var toastMessage = rowToCancel.ItemCancel
                ? "Item cancelled successfully."
                : "Item has been reverted successfully.";

            await _js.ToastrSuccess(toastMessage);
            rowToCancel = null;
            cancelReason = string.Empty;

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrWarning(ex.Message);
        }
        catch (Exception ex)
        {
            rowToCancel = null;
            await _js.ToastrError("An error occurred while cancelling/reverting the Item in Enquiry Sales.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Reverse failed for EnqId: {EnquirySalesVM.EnquiryId}");
        }
        finally
        {
            rowToCancel = null;
            isProcessing = false;
        }
    }


    private async Task AskToShortCloseAsync(EnquirySalesVM enqSalesVM)
    {
        try
        {
            if (enqSalesVM == null)
            {
                await _js.ToastrError("Invalid Sales Enquiry selected.");
                return;
            }

            if (!EnquiryId.HasValue || EnquiryId == 0)
            {
                await _js.ToastrError("Enquiry ShortClose is not allowed before saving the enquiry.");
                return;
            }

            if (enqSalesVM.EnquiryTally)
            {
                await _js.ToastrWarning("This Sales Enquiry is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (enqSalesVM.Cancel)
            {
                await _js.ToastrWarning("This Sales Enquiry is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!enqSalesVM.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Sales Enquiry?";
                btnText = "Short Closed";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Sales Enquiry?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while AskToShortCloseAsync Sales Enquiry.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }


