    #region Search Methods
    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<CustomerVM>();

        try
        {
            var results = await enquiryService.SearchCustomersAsync(value);
            return results.Take(50);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error searching customers");
            return Enumerable.Empty<CustomerVM>();
        }
    }


    private async Task<IEnumerable<ItemVM>> SearchItems(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();
        var results = await enquiryService.SearchItemsAsync(value,EnquirySalesVM.CustId);

        return results.Take(50);
    }
