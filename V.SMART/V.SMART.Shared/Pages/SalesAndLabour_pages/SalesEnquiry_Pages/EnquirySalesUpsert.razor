    #region Receive Items from Excel Upload
    private async Task ReceiveItems(List<ExcelUploadVM> items)
    {
        try
        {
            if (items == null || !items.Any()) return;

            // Map each ExcelUploadVM to LabourGRNSUB
            var newItems = items
           .Where(i => !EnquirySalesVM.EnquirySalesSubVM.Any(e => e.ItemId == i.ItemId))
           .Select(item => new EnquirySalesSubVM 
            {
                SlNo = item.SlNo,
                ItemId = item.ItemId,
                ItemCode = item.ItemCode,
                ItemName = item.ItemName,
                UOM = item.MeasureUnit,
                HsnCode=item.HSNCode,
                Qty = item.Qty,
                BalQty=item.Qty,
                UnitPrice = item.UnitPrice??0,
                Remark = item.RowRemarks
            });

            EnquirySalesVM.EnquirySalesSubVM.AddRange(newItems);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ReceiveItems() failed.");
            await _js.ToastrError("Error processing ReceiveItems() items.");
        }
    }
    #endregion



