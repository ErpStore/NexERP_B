    private async Task DownloadTemplate()
    {
        isProcessing = true;
        StateHasChanged();

        try
        {
            // Generate Excel
            var bytes = await enquiryService.CreateTemplateAsync(UploadTypes.EquirySales);

            var base64 = Convert.ToBase64String(bytes);
            await _js.InvokeVoidAsync("downloadExcelFile", base64, "EnquirySalesTemplate.xlsx");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
