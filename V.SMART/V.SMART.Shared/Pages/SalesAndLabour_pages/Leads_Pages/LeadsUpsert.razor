    private async Task LoadCustomerTypesForBusinessType(string? busiType)
    {
        try
        {
            Leads.BusiType = busiType;
            CustomerTypes.Clear();

            if (string.IsNullOrEmpty(busiType))

                return;

            switch (busiType)
            {
                case "Local":
                case "InterState": // InterState
                    CustomerTypes.AddRange(new[] { "B2B", "SEZWP", "SEZWOP" });

                    if (string.IsNullOrEmpty(Leads.SupType) || !CustomerTypes.Contains(Leads.SupType))
                        Leads.SupType = "B2B";
                    break;

                case "Imports": // Imports
                case "Exports": // Exports
                    CustomerTypes.AddRange(new[] { "SEZWP", "SEZWOP", "EXPWP", "EXPWOP" });

                    if (string.IsNullOrEmpty(Leads.SupType) || !CustomerTypes.Contains(Leads.SupType))
                        Leads.SupType = "SEZWP";
                    break;

                default:
                    Leads.SupType = null;
                    break;

            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Leads LoadCustomerTypesForBusinessType Method");

        }
    }

