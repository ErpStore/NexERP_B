@page "/Leads-details/create"
@page "/Leads-details/update/{LeadId:int}"

@inject HttpClient Http
@inherits BaseUserRightsComponent
@inject CurrentUserService _userService
@inject ILoggingService LoggingService
@inject IUnitOfWork _unitOfWork
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@using System.Collections.Generic;
@using System.Linq;
@using V.SMART.Shared.Data.SalesAndLabour.Leads
@using V.SMART.Shared.Pages.Master_Module_pages.Currency_Pages
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.MfgLeadsVM
@inject ILeadService LeadService;

<BsModal OnModalConfirmation="confirmDelete_Click"
         Title="@ModalTitle"
         ButtonText="@ModalButtonText"
         ButtonBootstrapStyle="@ModalButtonStyle">
</BsModal>

    <!-- Styles -->
    <style>
        .row.align-items-stretch > [class*='col-']
        {
            display: flex;
        }
        .row.align-items-stretch .card {
            flex: 1 1 auto;
        }
        .contact-table thead {
            background-color: #004c91;
            color: white;
            font-size: 11px;
        }

        .contact-table tbody {
            background-color: #f4f9ff;
        }

        .contact-table tbody tr:hover {
            background-color: #dceeff;
            }

        .contact-table th,
        .contact-table td {
            vertical-align: middle;
            font-size: 11px;
        }
        .label-formal {
                                                        
            font-size: 0.750rem; 
            font-weight: 500;
            color:black; 
           /*  color:#495057;  */
            letter-spacing: 0.3px; 
                                                       
        }
        .input-formal {
            font-size: 0.750rem;
            letter-spacing: 0.3px;
             font-weight: 500;
        width: 100% !important;
    }
                                                    
                                                           
        .status-hot {
            background-color: #ffe6e6; 
            color: #b30000;
            font-weight: 600;
        }
        .status-warm {
            background-color: #fff4e6; 
            color: #cc7a00;
            font-weight: 600;
        }
        .status-cold {
            background-color: #e6f3ff;
            color: #004c99;
            font-weight: 600;
        }
                                             
    </style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container-fluid px-2 px-md-5 mt-4">
            <div class="card shadow-sm border-1">

                <PageHeader TitleText="@(Leads.LeadId > 0 ? "Update Leads" : "Create Leads")"
                            TitleIcon="bi bi-tag"
                            Breadcrumbs="@LeadsFormBreadcrumbs" />
                <div class="card-body">

                    <EditForm Model="Leads" OnValidSubmit="UpsertLeads">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-lg-12">
                                     <div class="row mb-3">
                                        <!-- Company Details -->
                                        <div class="col-xxl-6 col-12 mb-2">

                                            <div class="card h-100">
                                                <div class="card-header fw-bold" 
                                                     style="background-color:aquamarine; color:black; border-radius:0px; padding:10px 15px;">
                                                    <i class="bi bi-building me-2"></i> Business Info
                                                </div>

                                                <div class="card-body">
                                                    <!-- Company Name -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-12 col-md-3 col-form-label label-formal" style="width: 120px;">Company Name</label>
                                                        <div class="col-12 col-md-9">
                                                            <TrimmedInputText @bind-Value="Leads.LeadName" class="form-control input-formal"  CssClass="form-control input-formal"/>
                                                        </div>
                                                        <ValidationMessage For="@(() => Leads.LeadName)" />
                                                    </div>

                                                    <!-- Contact Person Name -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 120px;">Name</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <TrimmedInputText @bind-Value="Leads.ContactPerson" class="form-control input-formal"  CssClass="form-control input-formal" />
                                                        </div>
                                                    </div>

                                                    <!-- Title / Designation -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 120px;">Title</label>
                                                         <div class="col-12 col-xxl-9">
                                                            <input list="designationList"
                                                                   class="form-control input-formal"  CssClass="form-control input-formal"
                                                                   id="designationList"
                                                                   @bind="Leads.Designation"
                                                                   @onkeydown="HandleEnter" />
                                                            <datalist id="designationList">
                                                                @foreach (var item in DesignationList)
                                                                {
                                                                    <option value="@item" />
                                                                }
                                                            </datalist>
                                                        </div>
                                                    </div>

                                                    <!-- Mobile Number -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 120px;">Mobile Number</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <TrimmedInputText id="Phone" @bind-Value="Leads.PhoneNo" 
                                                                              class="form-control input-formal"   CssClass="form-control input-formal"
                                                                              maxlength="13" inputmode="tel"
                                                                              onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || (event.charCode == 43 && this.selectionStart == 0)" />
                                                        </div>
                                                    </div>

                                                    <!-- Email -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 120px;">Email</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <TrimmedInputText id="Email" @bind-Value="Leads.Email" class="form-control input-formal"  CssClass="form-control input-formal" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Lead Info -->
                                        <div class="col-xxl-6 col-12 mb-2">
                                            <div class="card h-100">
                                                <div class="card-header fw-bold rounded-top" style="background-color:khaki; color:black; border-radius:0px; padding:10px 15px;">
                                                    <i class="bi bi-person me-2"></i> Lead Info
                                                </div>

                                                <div class="card-body">
                                                    <!-- State -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 100px;">State</label>
                                                        <div class="col-12 col-xxl-9">
                                                            @if (PostOffices?.Any() == true)
                                                            {
                                                                <select class="form-select input-formal" @bind="Leads.StateName" disabled>
                                                                    <option value="">--Select a State--</option>
                                                                    @foreach (var sta in state)
                                                                    {
                                                                        <option value="@sta.StateName">@sta.StateName</option>
                                                                    }
                                                                </select>
                                                            }
                                                            else
                                                            {
                                                                <select class="form-select input-formal" @onchange="OnStateChanged" value="@Leads.StateId">
                                                                    <option value="">--Select a State--</option>
                                                                    @foreach (var sta in state)
                                                                    {
                                                                        <option value="@sta.StateCode">@sta.StateName</option>
                                                                    }
                                                                </select>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- Lead Owner -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 100px;">Lead Owner</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <InputSelect class="form-control input-formal"
                                                                         @bind-Value="Leads.LeadOwner"
                                                                         disabled="@string.IsNullOrWhiteSpace(Leads.StateName)"
                                                                         title="Please select the State first">
                                                                <option value="">--Please select the State first--</option>
                                                                @foreach (var Owner in Users)
                                                                {
                                                                    <option value="@Owner.UserName">@Owner.UserName</option>
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                    </div>

                                                    <!-- Source -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 100px;">Source</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <input list="LeadSource"
                                                                   @bind="Leads.LeadSource"
                                                                   class="form-control input-formal"
                                                                   @onkeydown="HandleEnterSource" />
                                                            <datalist id="LeadSource">
                                                                @foreach (var source in LeadSourceList)
                                                                {
                                                                    <option value="@source" />
                                                                }
                                                            </datalist>
                                                        </div>
                                                    </div>

                                                    <!-- Status -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 100px;">Status</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <InputSelect @bind-Value="Leads.LeadStatus" class=@($"form-select input-formal {GetStatusClass()}")>
                                                                <option value="">--Select Lead Status--</option>
                                                                <option value="Hot">Hot</option>
                                                                <option value="Warm">Warm</option>
                                                                <option value="Cold">Cold</option>
                                                            </InputSelect>
                                                        </div>
                                                    </div>

                                                    <!-- Website -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 100px;">Website</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <InputText @bind-Value="Leads.WebSite" class="form-control input-formal" />
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                  
                                    <!-- Address Info -->
                                    <div class="row mb-3">
                                        <div class="col-12">
                                            <div class="card h-100 shadow-sm">
                                                <div class="card-header fw-bold rounded-top"
                                                     style="background-color:cornflowerblue; color:black; border-radius:0px; padding:10px 15px;">
                                                    <i class="bi bi-geo-alt me-2"></i> Address Information
                                                </div>
                                                <div class="card-body">
                                                    <div class="row g-2">

                                                        <!-- Address -->
                                                        <div class="col-12 mb-2">
                                                            <div class="d-flex flex-column flex-sm-row align-items-start align-sm-center gap-2">
                                                                <label class="label-formal mb-1 mb-sm-0" style="min-width: 100px;">Address</label>
                                                                <InputTextArea @bind-Value="Leads.Address" class="form-control input-formal flex-grow-1" style="height: 35px;" />
                                                            </div>
                                                        </div>

                                                        <!-- Zip Code -->
                                                        <div class="col-lg-6 col-md-12 mb-2">
                                                            <div class="d-flex flex-column flex-sm-row align-items-start align-sm-center gap-2">
                                                                <label class="label-formal mb-1 mb-sm-0" style="min-width: 100px;">Zip Code</label>
                                                                <InputText @bind-Value="Leads.PinCode" class="form-control input-formal flex-grow-1"
                                                                           @onblur="FetchAddressFromPincode" />
                                                            </div>
                                                        </div>

                                                        <!-- Location -->
                                                        <div class="col-lg-6 col-md-12 mb-2">
                                                            <div class="d-flex flex-column flex-sm-row align-items-start align-sm-center gap-2">
                                                                <label class="label-formal mb-1 mb-sm-0" style="min-width: 100px;">Location</label>
                                                                @if (PostOffices?.Any() == true)
                                                                {
                                                                    <InputSelect class="form-control input-formal flex-grow-1" @bind-Value="Leads.City">
                                                                        <option value="">-- Select Location --</option>
                                                                        @foreach (var po in PostOffices)
                                                                        {
                                                                            <option value="@po.Name">@po.Name</option>
                                                                        }
                                                                    </InputSelect>
                                                                }
                                                                else
                                                                {
                                                                    <InputText @bind-Value="Leads.City" class="form-control input-formal flex-grow-1" />
                                                                }
                                                            </div>
                                                        </div>

                                                        <!-- Country -->
                                                        <div class="col-lg-6 col-md-12 mb-2">
                                                            <div class="d-flex flex-column flex-sm-row align-items-start align-sm-center gap-2">
                                                                <label class="label-formal mb-1 mb-sm-0" style="min-width: 100px;">Country</label>
                                                                <InputText @bind-Value="Leads.Country" class="form-control input-formal flex-grow-1" />
                                                            </div>
                                                        </div>

                                                        <!-- State -->
                                                        <div class="col-lg-6 col-md-12 mb-2">
                                                            <div class="d-flex flex-column flex-sm-row align-items-start align-sm-center gap-2">
                                                                <label class="label-formal mb-1 mb-sm-0" style="min-width: 100px;">State</label>
                                                                @if (PostOffices?.Any() == true)
                                                                {
                                                                    <select class="form-select input-formal flex-grow-1" @bind="Leads.StateName" disabled>
                                                                        <option value="">-- Select a State --</option>
                                                                        @foreach (var sta in state)
                                                                        {
                                                                            <option value="@sta.StateName">@sta.StateName</option>
                                                                        }
                                                                    </select>
                                                                }
                                                                else
                                                                {
                                                                    <select class="form-select input-formal flex-grow-1" @onchange="OnStateChanged" value="@Leads.StateId">
                                                                        <option value="">-- Select a State --</option>
                                                                        @foreach (var sta in state)
                                                                        {
                                                                            <option value="@sta.StateCode">@sta.StateName</option>
                                                                        }
                                                                    </select>
                                                                }
                                                            </div>
                                                        </div>

                                                        <!-- State Code -->
                                                        <div class="col-lg-6 col-md-12 mb-2">
                                                            <div class="d-flex flex-column flex-sm-row align-items-start align-sm-center gap-2">
                                                                <label class="label-formal mb-1 mb-sm-0" style="min-width: 100px;">State Code</label>
                                                                <input class="form-control input-formal flex-grow-1" value="@Leads.StateId" readonly />
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>



                                    <div class=" row mb-3 align-items-stretch">
                                        <div class="col-xxl-6 col-12 mb-2">
                                            <div class="card h-100 shadow-sm">
                                                <div class="card-header fw-bold d-flex align-items-center rounded-top"
                                                        style="background-color:paleturquoise; color:black; border-radius:0px; padding:15px 15px;">
                                                            <i class="bi bi-person-vcard me-2"></i> Business Information
                                                </div>

                                                <div class="card-body">

                                                    <!-- Business Type -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 120px;">Business Type</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <select class="form-select input-formal" @onchange="OnBusinessTypeChanged" value="@Leads.BusiType">
                                                                <option value="">--Select Business Type--</option>
                                                                @foreach (var item in BusinessTypes)
                                                                {
                                                                    <option>@item.Name</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <!-- Customer Type -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 120px;">Customer Type</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <InputSelect class="form-select input-formal" @bind-Value="Leads.SupType">
                                                                <option value="">--Select Customer Type--</option>
                                                                @foreach (var type in CustomerTypes)
                                                                {
                                                                    <option>@type</option>
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                    </div>

                                                    <!-- GST No -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 120px;">GST No</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <InputText class="form-control input-formal" @bind-Value="Leads.GSTNo" maxlength="15" @oninput="OnVATChanged" />
                                                        </div>
                                                    </div>

                                                    <!-- PAN No -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 120px;">PAN No</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <InputText class="form-control input-formal" @bind-Value="Leads.PANNo" readonly maxlength="10" />
                                                        </div>
                                                    </div>
                                                    <!-- Currency Dropdown -->
                                                    <div class="row align-items-center mb-3">
                                                    <label class="col-md-3 col-form-label label-formal" style="width: 120px;">Currency</label>
                                                    <div class="col-12 col-xxl-9">
                                                        <select class="form-select input-formal" @onchange="OnCurrencyChange" value="@Leads.CurrId">
                                                            <option value="">--Select Currency--</option>
                                                                @foreach (var curr in Currency)
                                                            {
                                                                <option value="@curr.CurrId">@curr.CurrName</option>
                                                            }
                                                            <option value="-1">+ Add New Currency</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                    @if (ShowModal)
                                                    {
                                                        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                                                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                                                <div class="modal-content">
                                                                    <div class="modal-header bg-primary text-white">
                                                                        <h5 class="modal-title">Add New Currency</h5>
                                                                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <CurrencyUpsert IsModal="true" OnSaved="HandleSaved" />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                   
                                                    <!-- Remarks -->
                                                    <div class="row align-items-center mb-3">
                                                        <label class="col-md-3 col-form-label label-formal" style="width: 120px;">Remarks</label>
                                                        <div class="col-12 col-xxl-9">
                                                            <InputTextArea class="form-control input-formal" @bind-Value="Leads.Remarks" />
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>


                                        <!-- Contact Notes -->
                                        <div class="col-xxl-6 col-12 mb-2">
                                            <div class="card h-100 shadow-sm">
                                                <!-- Card Header -->
                                                <div class="card-header fw-bold d-flex justify-content-between align-items-center rounded-top" style="background-color:lightpink; color:black; border-radius:0px; padding:10px 15px;">
                                                    <span><i class="bi bi-chat-text me-2"></i>Contact Notes</span>
                                                    <button type="button" class="btn btn-sm btn-outline-dark"  @onclick="AddContact">
                                                        <i class="bi bi-plus-lg me-1"></i> Add
                                                    </button>
                                                </div>

                                                <!-- Table -->
                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-sm align-middle text-center table-hover contact-table">
                                                        <thead>
                                                            <tr>
                                                                <th style="width: 160px;">Contact Name</th>
                                                                <th style="width: 160px;">Phone Number</th>
                                                                <th style="width: 160px;">Email</th>
                                                                <th style="width: 80px;">Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @if (Contacts != null && Contacts.Any())
                                                            {
                                                                @foreach (var contact in Contacts)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            <InputText class="form-control input-formal" @bind-Value="contact.ContactPersonName" />
                                                                        </td>
                                                                        <td>
                                                                            <InputText class="form-control input-formal" @bind-Value="contact.PhoneNo" maxlength="13" inputmode="tel" onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || (event.charCode == 43 && this.selectionStart == 0)" />
                                                                        </td>
                                                                        <td>
                                                                            <InputText class="form-control input-formal" @bind-Value="contact.Email" />
                                                                        </td>
                                                                        <td>
                                                                            <button type="button" class="btn btn-danger btn-sm"
                                                                                   @onclick="() => AskToRemoveAsync(contact, ContactType)" title="Remove">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <tr>
                                                                    <td colspan="6" class="text-muted">
                                                                           <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border" 
                                                                                style="width: 60px; height: 60px;">
                                                                               <i class="bi bi-person fs-1 text-secondary"></i>
                                                                           </span>
                                                                    <div class="mt-2">No contacts added yet</div>
                                                                </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                  
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Section: Save -->
                                   
                                        <div class="row mt-4 mb-2">
                                            @if (CanCreate || CanEdit)
                                            {
                                                <div class="col-6 col-lg-3">
                                                    <button type="submit" class="btn btn-primary w-100" disabled="@isProcessing">
                                                        <i class="bi bi-floppy2-fill me-1"></i> @(LeadId == 0 || LeadId == null ? "Create" : "Update")
                                                    </button>
                                                </div>
                                            }

                                            <div class="col-6 col-lg-3 mb-2">
                                                <SmartBackButton Url="/Leads" />
                                            </div>

                                            @if (!IsCustomer)
                                            {
                                            <div class="col-6 col-lg-3 mb-2">
                                                    <button type="button" class="btn btn-warning w-100" disabled="@isProcessing" @onclick="() => AskToMasterConvertAsync(Leads.LeadName, MasterConvert)">
                                                        Master Convert
                                                    </button>
                                                </div>
                                            }
                                       </div>
                                </div>

                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

    }
}

@code {
    protected override string ScreenName => "Leads";

    [Parameter]
    public int? LeadId { get; set; }
    public string CustIndPanNo = "";
    private bool isProcessing = true;
    private Leads Leads { get; set; } = new Leads();
    private Customer customer { get; set; } = new Customer();
    private List<ContactPerson> Contacts { get; set; } = new();
    private List<string> DesignationList = new();
    private List<string> LeadSourceList = new();
    private List<Currency> Currency = new();
    private List<State> state = new();
    private List<User> Users = new();
    private int SelectedBusinessType;
    private Currency NewCurrency { get; set; } = new();

    public List<string> CustomerTypes { get; set; } = new();
    private List<PostOffice> PostOffices = new();
    private List<Country> countries = new();
    private List<string> cities = new();

    string selectedCountry = "";
    string selectedState = "";

    private string username;
    private object? PendingDeleteItem;
    private string? DeleteType;

    private const string ContactType = "Contact";
    private const string MasterConvert = "MasterConvert";

    private string ModalTitle = "Are You Want To Sure";
    private string ModalButtonText = "Confirm";
    private string ModalButtonStyle = "btn-primary";

    private bool ShowAddCurrencyCard { get; set; } = false;

    private bool IsCustomer;

    private bool ShowModal = false;

    private List<PageHeader.BreadcrumbItem> LeadsFormBreadcrumbs = new()
    {
        new() { Text = "Sales" },
        new() { Text = "Leads", IsLast = true }
    };

    private void HandleCurrencySaved(int newCurrencyId)
    {
        // Change modal title to Edit after saving
        ModalTitle = "Edit Currency";
    }
    private async Task CloseModal()
    {
        ShowModal = false;
    }

    private string GetStatusClass()
    {
        return Leads.LeadStatus?.ToLower() switch
        {
            "hot"  => "status-hot",
            "warm" => "status-warm",
            "cold" => "status-cold",
