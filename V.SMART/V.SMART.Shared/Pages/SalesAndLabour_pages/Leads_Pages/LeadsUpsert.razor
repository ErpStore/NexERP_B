    private async Task AskToMasterConvertAsync(object item,string type)
    {
        try
        {
            var errors = new List<string>();

            if(string.IsNullOrWhiteSpace(Leads.LeadName) || string.IsNullOrWhiteSpace(Leads.Address))
            {
                errors.Add("Please Enter Company Name and Leads Address");
            }

            if(string.IsNullOrWhiteSpace(Leads.SupType))
            {
                errors.Add("Please Enter Select Supply Type");
            }
            if(string.IsNullOrWhiteSpace(Leads.PinCode))
            {
                errors.Add("Please Enter the Pincode");
                
            }
            if (string.IsNullOrWhiteSpace(Leads.City))
            {
                errors.Add("Please Enter the Location");

            }
            var existingCustomer = await LeadService.GetCustomerByNameAsync(Leads.LeadName);
            bool isDuplicate = existingCustomer != null;
            if (isDuplicate)
            {
                errors.Add("Customer name already exists.");
                isProcessing = false;
            }

            string busiType = Leads.BusiType?.ToString()?.Trim(); // Make sure it's string

            //Case 1: IMPORTS or EXPORTS (assuming BusiType is numeric: 3 = Imports, 4 = Exports)
            if (busiType == "Imports" || busiType == "Exports")
            {
                if (!string.Equals(Leads.GSTNo, "URP", StringComparison.OrdinalIgnoreCase))
                {
                    errors.Add("For Imports/Exports, GST No must be 'URP'.");
                }
            }
            else
            {
                //Validate GST No
                if (string.IsNullOrWhiteSpace(Leads.GSTNo))
                {
                    errors.Add("Please enter GST No.");
                }
                else if (Leads.GSTNo.Length != 15)
                {
                    errors.Add("GST No must be 15 characters.");
                }
                else if (!Regex.IsMatch(Leads.GSTNo, @"^(URP|[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1})$"))
                {
                    errors.Add("Invalid GST No format.");
                }

                // Validate PAN No
                if (string.IsNullOrWhiteSpace(Leads.PANNo))
                {
                    errors.Add("Please enter PAN No.");
                }
                else if (!Regex.IsMatch(Leads.PANNo, @"^[A-Z]{5}[0-9]{4}[A-Z]{1}$"))
                {
                    errors.Add("Invalid PAN No format.");
                }

            }

            // Validate State
            var matchedState = state.FirstOrDefault(s => s.StateCode == Leads.StateId);
            if (Leads.StateId == 0 || matchedState == null)
            {
                errors.Add("Please select a valid State.");
                isProcessing = false;

            }

            if(matchedState != null)
            {
                Leads.StateName = matchedState.StateName;
            }

            if(Leads.CurrId == null)
            {
                errors.Add("Please select a valid Currency.");

            }
            // Show accumulated validation errors
            if (errors.Count > 0)
            {
                foreach (var err in errors)
                {
                    await _js.ToastrError(err);
                }

                isProcessing = false;
                return;
            }

            PendingDeleteItem = item;
            DeleteType = type;
            ModalTitle = "Are you sure you want to Master Customer Create?";
            ModalButtonText = "Create";
            ModalButtonStyle = "btn-danger";
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Customer OnBusinessTypeChanged event");
        }

    }

