    private async Task FetchAddressFromPincode()
    {

        if (!string.IsNullOrWhiteSpace(Leads.PinCode))
        {
            try
            {
                var response = await Http.GetFromJsonAsync<List<PincodeResponse>>(
                    $"https://api.postalpincode.in/pincode/{Leads.PinCode}");

                if (response?.FirstOrDefault()?.Status == "Success")
                {
                    var postOffices = response.First().PostOffice;

                    PostOffices = postOffices.Select(po => new PostOffice
                    {
                        Name = po.Name,
                    }).ToList();

                    var post = response?.FirstOrDefault()?.PostOffice?.FirstOrDefault();
                    if (post != null)
                    {
                        Leads.Country = post.Country;

                        if (!string.IsNullOrWhiteSpace(post.State))
                        {

                            var matchedState = state
                                .FirstOrDefault(s => string.Equals(
                                    s.StateName.Trim(),
                                    post.State.Trim(),
                                    StringComparison.OrdinalIgnoreCase));

                            if (matchedState != null)
                            {
                                Leads.StateId = matchedState.StateCode; 
                                Leads.StateName = matchedState.StateName;

                                var leadStates = Leads.StateId.ToString();
                                var allUsers = await LeadService.GetAllUsersAsync();

                                if (allUsers?.Any() == true)
                                {
                                    Users = allUsers
                                    .Where(u => !string.IsNullOrWhiteSpace(u.StateCodesCsv) && u.StateCodesCsv
                                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                    .Select(code => code.Trim())
                                    .Any(code => leadStates.Contains(code))).ToList();
                                }
                            }
                            else
                            {
                                Leads.State = null;
                            }
                        }
                    }
                    else
                    {
                        Leads.State = null;
                        Leads.Country = string.Empty;
                    }
                }
                else
                {
                    Leads.State = null;
                    Leads.Country = string.Empty;
                }
            }
            catch (HttpRequestException ex)
            {
                await LoggingService.LogDeveloperError(ex, "An error occurred while handling the FetchAddressFromPincode event");

            }
            catch (Exception ex)
            {
                await LoggingService.LogDeveloperError(ex, "An error occurred while handling the FetchAddressFromPincode event");
            }

        }
    }
