    private async Task UpsertLeads()
    {
        isProcessing = true;
        try
        {
            Contacts = Contacts
               .Where(c =>
                   !string.IsNullOrWhiteSpace(c.ContactPersonName) ||
                   !string.IsNullOrWhiteSpace(c.Email) ||
                   !string.IsNullOrWhiteSpace(c.PhoneNo))
               .ToList();
            if (Leads.LeadId==0)
            {
                var isDuplicate = await LeadService.IsDuplicateLeadsNameAsync(Leads.LeadName, Leads.LeadId == 0 ? null : Leads.LeadId);
                
                if (isDuplicate)
                {
                    await _js.ToastrError("Leads name already exists.");

                    isProcessing = false;
                    return;
                }
                
            }
           

            var errors = new List<string>();
            string busiType = Leads.BusiType?.ToString()?.Trim(); // Make sure it's string

            if (errors.Count > 0)
            {
                foreach (var err in errors)
                {
                    await _js.ToastrError(err);
                }

                isProcessing = false;
                return;
            }
            await LeadService.CreateleadsAsync(Leads);
            await LeadService.CreateOrUpdateContactsAsync(Leads.LeadId, Leads.LeadName, Contacts);
            if (Leads.LeadId == 0)
            {
                await _js.ToastrSuccess("Leads Created Successfully");
            }
            else
            {
                await _js.ToastrSuccess("Leads Updated Successfully");
            }

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/Leads");

        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while saving the Leads.");
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Leads UpsertLeads() Method");
        }
        finally
        {
            isProcessing = false;
        }
    }

