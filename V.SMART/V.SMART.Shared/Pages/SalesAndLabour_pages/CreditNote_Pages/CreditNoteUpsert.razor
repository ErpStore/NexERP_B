                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(CreditNoteVMs.TotalIGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

