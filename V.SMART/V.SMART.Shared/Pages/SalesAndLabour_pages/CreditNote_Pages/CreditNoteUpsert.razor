                subitem.UnitPrice = null;
            }

            await _calculationService.UpdateTotalsAsync(CreditNoteVMs);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnItemChanged failed for ItemId: {item?.ItemId}");
            await _js.ToastrError("Failed to apply item selection. Please try again.");
        }
    }

    private bool IsItemAlreadySelected(int itemId, int? currentItemId)
    {
        return CreditNoteVMs.CreditNoteSubVMs?.Any(q => q.ItemId == itemId && q.ItemId != currentItemId) == true;
    }

    #endregion

    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, CreditNoteSubVM SubVM) 
    {
        try
        {
            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.CrBalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }
            decimal stkqty=0;
            string cate = CreditNoteVMs.Rejection.Value ? "Reject" : "Cr/Dr";
            // NEW quote line
            if (SubVM.CrSubId == 0)
            {
                int.TryParse(SubVM.RefInvSubId.ToString(),out int RefInvSubId);
                int.TryParse(SubVM.LabInvSubId.ToString(),out int RefLabInvSubId);
                int.TryParse(SubVM.ExpInvSubId.ToString(), out int RefExpInvSubId);
                decimal invBalQty = 0;
                if (RefInvSubId > 0)
                {

                    invBalQty = await GetInvBalQty(RefInvSubId);

                    if (newQty <= invBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.CrBalQty = newQty;
                        if (CreditNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = newQty;
                        }
                        else
                        {
                            SubVM.CrDrQty = newQty;
                        }

                    }
                    else
                    {
                        SubVM.Qty = invBalQty;
                        SubVM.CrBalQty = invBalQty;
                        if (CreditNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = invBalQty;
                        }
                        else
                        {
                            SubVM.CrDrQty = invBalQty;
                        }
                        await _js.ToastrWarning($"{cate} Qty {newQty} can't be greater than  Qty ({invBalQty}).");
                        return;
                    }
                }else if (RefLabInvSubId>0)
                {
                    invBalQty = await GetInvBalQty(RefLabInvSubId);
                    if (newQty <= invBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.CrBalQty = newQty;
                        if (CreditNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = newQty;
                        }
                        else
                        {
                            SubVM.CrDrQty = newQty;
                        }

                    }
                    else
                    {
                        SubVM.Qty = invBalQty;
                        SubVM.CrBalQty = invBalQty;
                        if (CreditNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = invBalQty;
                        }
                        else
                        {
                            SubVM.CrDrQty = invBalQty;
                        }
                        await _js.ToastrWarning($"{cate} Qty {newQty} can't be greater than  Qty ({invBalQty}).");
                        return;
                    }


                }else if (RefExpInvSubId>0)
                {
                    invBalQty = await GetInvBalQty(RefExpInvSubId);
                    if (newQty <= invBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.CrBalQty = newQty;
                        if (CreditNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = newQty;
                        }
                        else
                        {
                            SubVM.CrDrQty = newQty;
                        }

                    }
                    else
                    {
                        SubVM.Qty = invBalQty;
                        SubVM.CrBalQty = invBalQty;
                        if (CreditNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = invBalQty;
                        }
                        else
                        {
                            SubVM.CrDrQty = invBalQty;
                        }
                        await _js.ToastrWarning($"{cate} Qty {newQty} can't be greater than  Qty ({invBalQty}).");
                        return;
                    }


                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.CrBalQty = newQty;
                    if (CreditNoteVMs.Rejection.Value)
                    {
                        SubVM.RejQty = newQty;
                    }
                    else
                    {
                        SubVM.CrDrQty = newQty;
                    }
                }

            }
            // EXISTING quote line
            else
            {
                var reason = CreditNoteVMs.Rejection ?? false ? "Rejection" : "RateDifference";

                var original = await _creditNoteService.GetCreditNoteSubItemDetailByCrSubIdAsync(SubVM.CrSubId,reason);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.RejQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.CrBalQty = 0;
                    SubVM.RejQty=0;
                    SubVM.CrDrQty = 0;
                    await _js.ToastrWarning($"{cate} Qty  cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefInvSubId > 0)
                {
                    decimal invBalQty = 0;

                    invBalQty = await GetInvBalQty(SubVM.RefInvSubId.Value);

                    var maxAllowedQty = original.Qty + invBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.CrBalQty = maxAllowedQty - alreadyTransacted;

                        if (CreditNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = SubVM.CrBalQty.Value;
                        }
                        else
                        {
                            SubVM.CrDrQty = SubVM.CrBalQty.Value;
                        }
                        await _js.ToastrWarning($"{cate} Qty cannot be greater than {maxAllowedQty}.");
                        return ;
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.CrBalQty = newQty - alreadyTransacted;
                        if (CreditNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = SubVM.CrBalQty.Value;
                        }
                        else
                        {
                            SubVM.CrDrQty = SubVM.CrBalQty.Value;
                        }
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.CrBalQty = newQty - alreadyTransacted;
                    if (CreditNoteVMs.Rejection.Value)
                    {
                        SubVM.RejQty = SubVM.CrBalQty.Value;
                    }
                    else
                    {
                        SubVM.CrDrQty = SubVM.CrBalQty.Value;
                    }
                }


            }
            await _calculationService.UpdateTotalsAsync(CreditNoteVMs);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for InvSubId: {SubVM?.CrSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

