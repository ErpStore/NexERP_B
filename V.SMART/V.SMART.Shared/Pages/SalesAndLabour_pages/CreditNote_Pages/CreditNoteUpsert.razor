    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                isProcessing = false;
                StateHasChanged();
                _navigationManager.NavigateTo("/access-denied", true);
                return;
            }

            Currencies = await _creditNoteService.GetCurrenciesAsync();
            DecimalPlaces = await _creditNoteService.GetDecimalPlacesAsync();
            screenCode = await _creditNoteService.GetScreenCodeByScreenNameAsync(ScreenName);

            if (CrId.HasValue)
                await LoadExistingCreditNote(CrId.Value);
            else if (CustId > 0)
                await InitializeNewCreditNote(CustId);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadExistingCreditNote(int CrId)
    {
        try
        {
            CreditNoteVMs = await _creditNoteService.GetCreditNoteBycrIdAsync(CrId);

            if (CreditNoteVMs == null)
            {
                await _js.ToastrWarning("CreditNote not found.");
                return;
            }

            SelectedCustomer = await _creditNoteService.GetCustomerByIdAsync(CreditNoteVMs.CustId.Value);
            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

            if (CreditNoteVMs.CurrId > 0)
                await ApplyCurrencyChange(CreditNoteVMs.CurrId);

            foreach (var savedSub in CreditNoteVMs.CreditNoteSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[savedSub.ItemId] = await _creditNoteService.GetCorrespondenceAttachmentsCountAsync(savedSub.ItemId, "Item");
            }

            CreditNoteVMs.SignedInvoiceQrCode = await _creditNoteService.GenerateQrBase64(CreditNoteVMs.SignedInvoiceQrCode);

            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing CreditNote.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingCreditNote failed for CrId: {CrId}");
        }
    }

    private bool CheckIsTransMade()
    {
        return (string.IsNullOrEmpty(CreditNoteVMs.ACKNO) && string.IsNullOrEmpty(CreditNoteVMs.IRNNo)) ? false : true;
    }

    private async Task InitializeNewCreditNote(int custId)
    {
        try
        {
            var customer = await _creditNoteService.GetCustomerByIdAsync(custId);
            if (customer != null)
            {

                await ApplyCustomerSelectionAsync(customer);
            }
            CreditNoteVMs.Prefix = await _creditNoteService.GetPrefixFromDb();
            CreditNoteVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            CreditNoteVMs.CreditNo = await _creditNoteService.GetCreditNoteNumberAsync(CreditNoteVMs.Suffix);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new quotation.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewQuote failed for CustId: {custId}");
        }
    }


    #region Customer data, Currency And Tax  Handlers

    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        if (!CreditNoteVMs.Sales.Value && !CreditNoteVMs.Labour.Value && !CreditNoteVMs.Export.Value)
        {
            await _js.ToastrWarning("Please select the Credit Note Type first.");
            return Enumerable.Empty<CustomerVM>(); ;
        }

        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<CustomerVM>();

        try
        {
            if (!CreditNoteVMs.Export.Value)
            {
                var results = await _creditNoteService.SearchCustomersAsync(value);
                return results?.Take(50) ?? Enumerable.Empty<CustomerVM>();
            }
            else
            {
                var results = await _creditNoteService.SearchExportCustomersAsync(value);
                return results?.Take(50) ?? Enumerable.Empty<CustomerVM>();
            }

        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<CustomerVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchCustomers failed for value: {value}");
            await _js.ToastrError("Failed to search customers. Please try again.");
            return Enumerable.Empty<CustomerVM>();
        }
    }

    private async Task OnCustomerChanged(CustomerVM? customer)
    {
        try
        {

            await ApplyCustomerSelectionAsync(customer);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error in OnCustomerChanged: {ex}");
            await LoggingService.LogDeveloperError(ex, "Error in OnCustomerChanged");
            await _js.ToastrError("Error while selecting");
            contactPersons.Clear();
            await ResetCreditNoteDefaults();
        }
    }

    private async Task ApplyCustomerSelectionAsync(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;
            CreditNoteVMs.CustId = customer?.CustId ?? 0;
            CreditNoteVMs.CustName = customer?.CustName;
            CreditNoteVMs.CustAddress = customer?.CustAddr;
            CreditNoteVMs.GSTNo = customer?.GSTNo;
            CreditNoteVMs.ContactNo = customer?.ContactNo;
            CreditNoteVMs.BusiType = customer?.BusiType;

            if (customer == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                CostCenterVMs.Clear();
                await ResetCreditNoteDefaults();
                return;
            }

            contactPersons = await _creditNoteService.GetContactPersonsAsync(customer.CustId);
            consineeAddress = await _creditNoteService.GetConsigneeAddressesAsync(customer.CustId);

            var usedCostCenters = CreditNoteVMs.CreditNoteSubVMs
                .Where(x => x.CostId.HasValue && (x.RefInvSubId == 0))
                .Select(x => x.CostId.Value)
                .ToHashSet();

            CostCenterVMs = await _creditNoteService.GetCostCenterDetailsByCustId(customer.CustId, usedCostCenters);

            CreditNoteVMs.KindOfAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPersonName : string.Empty;

            // Tax logic
            if (!customer.TaxValidate)
            {
                var lastInvoice = await _creditNoteService.GetLastcreditNoteAsync(customer.CustId);
                if (lastInvoice != null)
                {
                    CreditNoteVMs.CGstRate = lastInvoice.CGstRate;
                    CreditNoteVMs.SGstRate = lastInvoice.SGstRate;
                    CreditNoteVMs.IGstRate = lastInvoice.IGstRate;
                }
                else
                {
                    if (string.Equals(customer.BusiType, "Local", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false)
                    {
                        CreditNoteVMs.CGstRate = CommonConstants.GetGST(9.000m);
                        CreditNoteVMs.SGstRate = CommonConstants.GetGST(9.000m);
                        CreditNoteVMs.IGstRate = CommonConstants.GetIGST(0.000m);
                    }
                    else if (string.Equals(customer.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false)
                    {
                        CreditNoteVMs.CGstRate = CommonConstants.GetGST(0.000m);
                        CreditNoteVMs.SGstRate = CommonConstants.GetGST(0.000m);
                        CreditNoteVMs.IGstRate = CommonConstants.GetIGST(18.000m);
                    }
                }
            }

            CreditNoteVMs.CurrId = (customer.CurrId.HasValue && customer.CurrId > 0) ? customer.CurrId.Value : 1;
            await ApplyCurrencyChange(CreditNoteVMs.CurrId);


            await CountPendingInvs();

            await _calculationService.UpdateTotalsAsync(CreditNoteVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {customer?.CustId}");
            await _js.ToastrError("Failed to apply customer selection. Please try again.");
        }
    }

    private async Task CountPendingInvs()
    {
        if (CreditNoteVMs.Sales.Value)
        {
            InvPendingCount = await _creditNoteService.GetPendingInvCountAsync(CreditNoteVMs.CustId.Value, "Sales");
        }
        else if (CreditNoteVMs.Labour.Value)
        {
            InvPendingCount = await _creditNoteService.GetPendingInvCountAsync(CreditNoteVMs.CustId.Value, "Labour");
        }
        else if (CreditNoteVMs.Export.Value)
        {
            InvPendingCount = await _creditNoteService.GetPendingInvCountAsync(CreditNoteVMs.CustId.Value, "Export");
        }


    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
            await ApplyCurrencyChange(selectedId);
    }

    private async Task ApplyCurrencyChange(int currencyId)
    {
        var selectedCurrency = await _creditNoteService.GetCurrencyByIdAsync(currencyId);
        if (selectedCurrency == null) return;

        CreditNoteVMs.CurrName = selectedCurrency.CurrName;
        CreditNoteVMs.Symbol = selectedCurrency.Symbol;
        CreditNoteVMs.CurrId = selectedCurrency.CurrId;

        if (currencyId > 1)
            CreditNoteVMs.TodayVal = await _creditNoteService.GetLatestCurrencyValueAsync(currencyId) ?? 0m;
    }

    private async Task ResetCreditNoteDefaults()
    {
        CreditNoteVMs.CGstRate = 0m;
        CreditNoteVMs.SGstRate = 0m;
        CreditNoteVMs.IGstRate = 0m;
    }

    private async Task OnShippingChange(ChangeEventArgs e)
    {
        try
        {
            CreditNoteVMs.IsSameAsShipping = (bool)e.Value;

            if (!CreditNoteVMs.IsSameAsShipping && SelectedCustomer != null)
            {
                consineeAddress = await _creditNoteService.GetConsigneeAddressesAsync(SelectedCustomer.CustId);
            }
            else
            {
                consineeAddress.Clear();
                ResetShippingDefaults();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                $"Error while toggling shipping address for CustId={SelectedCustomer?.CustId}");
        }
    }

    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                CreditNoteVMs.IsSameAsShipping = true;
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }
            CreditNoteVMs.IsSameAsShipping = false;

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltCustId == selectedId);
            if (selectedConsignee == null)
                return;

            CreditNoteVMs.ShipAddrsId = selectedConsignee.AltCustId;
            CreditNoteVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltCustAddr1, selectedConsignee.AltCustAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            CreditNoteVMs.ShippingGstin = selectedConsignee.GSTNo ?? string.Empty;
            CreditNoteVMs.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(CreditNoteVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

    private void ResetShippingDefaults()
    {
        CreditNoteVMs.ShipAddrsId = null;
        CreditNoteVMs.ShippingName = null;
        CreditNoteVMs.ShippingAddress = null;
        CreditNoteVMs.ShippingGstin = null;
        CreditNoteVMs.ShippingContactNo = null;
    }

    #endregion

    #region Item Handlers

    private async Task<IEnumerable<ItemVM>> SearchItems(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        try
        {
            var results = await _creditNoteService.SearchItemsAsync(value);
