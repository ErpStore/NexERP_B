                                            <label class="btn btn-outline-primary" for="packingToggleRs"><small>@CreditNoteVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="packingToggle" id="packingTogglePercent"
                                                   @onchange="() => SetPAndFType(false)" checked="@(!CreditNoteVMs.PackingAmtOrPer)"  disabled="true"/>
                                            <label class="btn btn-outline-primary" for="packingTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
