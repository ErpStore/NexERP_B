    private async Task CancelEdit(CreditNoteSubVM? item, CreditNoteVM? parentQuote)
    {
        try
        {
            if (item == null || parentQuote == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentQuote.CreditNoteSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for CrSubId: {item?.CrId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(CreditNoteSubVM item)
    {
        try
        {
            if (CreditNoteVMs.CreditNoteSubVMs.Count == 1 && item.CrSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }else if (CreditNoteVMs.CreditNoteSubVMs.Count == 1)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if(IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if(!string.IsNullOrEmpty(CreditNoteVMs.ACKNO) && !string.IsNullOrEmpty(CreditNoteVMs.IRNNo))
            {
                await _js.ToastrWarning("This Credit Note has been done e-invoice so cannot be modified.");
                return;                
            }



            if (item.ItemId == 0)
            {
                CreditNoteVMs.CreditNoteSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!CreditNoteVMs.CreditNoteSubVMs.Any())
                    CreditNoteVMs.CreditNoteSubVMs = new List<CreditNoteSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(CreditNoteVMs);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for InvoiceSubId: {item?.CrSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

