    private async Task ShowInvoiceDetails()
    {
        if (CreditNoteVMs?.CustId != 0)
        {
            try
            {
                isProcessing = true;
                if (CreditNoteVMs.Sales.Value)
                {
                    InvData = await _creditNoteService.GetMfgInvoiceDetailsByCustId(CreditNoteVMs.CustId.Value);
                }
                else if (CreditNoteVMs.Labour.Value)
                {
                    InvData = await _creditNoteService.GetLabourInvoiceDetailsByCustId(CreditNoteVMs.CustId.Value);
                }
                else if (CreditNoteVMs.Export.Value)
                {
                    InvData = await _creditNoteService.GetExportInvoiceDetailsByCustId(CreditNoteVMs.CustId.Value);
                }

                if (InvData != null && InvData.Any())
                {
                    decimal discamt = 0,disPercent=0,frieghtValue=0,PackPercent=0,packValue=0,Insuperce=0,InsuVal=0,tcsPerc=0,tcsVal=0,otherVal=0;
                    var firstItem = InvData.FirstOrDefault();
                    if (firstItem != null)
                    {
                        // cast the object to the correct type (decimal, double, or int)

                        //Discount--------------------
                        bool DiscAmtOrPer = firstItem.ContainsKey("DiscAmtOrPer") && firstItem["DiscAmtOrPer"] != null
                                            ? Convert.ToBoolean(firstItem["DiscAmtOrPer"]) : false;
                        CreditNoteVMs.DiscAmtOrPer = DiscAmtOrPer;

                        if (firstItem.TryGetValue("DiscountPercent", out var discperc))
                        {
                            decimal.TryParse(discperc?.ToString(), out disPercent);
                        }

                        CreditNoteVMs.DiscountPercent = disPercent;

                        if (firstItem.TryGetValue("DiscountAmount", out var discamtValue))
                        {
                            decimal.TryParse(discamtValue?.ToString(), out discamt);
                        }
                        CreditNoteVMs.DiscountAmount = discamt;
                        //---------------------------------------


                        //FreightCharges------------------------------
                        if (firstItem.TryGetValue("FreightCharges", out var fcharge))
                        {
                            decimal.TryParse(fcharge?.ToString(), out frieghtValue);
                        }
                        CreditNoteVMs.FreightCharges = frieghtValue;
                        //-----------------------------------------------

                        //P and F------------------------------------------
                        bool panfAmtOrPer = firstItem.ContainsKey("PackingAmtOrPer") && firstItem["PackingAmtOrPer"] != null
                                            ? Convert.ToBoolean(firstItem["PackingAmtOrPer"]) : false;
                        CreditNoteVMs.PackingAmtOrPer = panfAmtOrPer;

                        if (firstItem.TryGetValue("PackingPercent", out var packperc))
                        {
                            decimal.TryParse(packperc?.ToString(), out PackPercent);
                        }
                        CreditNoteVMs.PackingPercent = PackPercent;

                        if (firstItem.TryGetValue("PackingCharges", out var packcharges))
                        {
                            decimal.TryParse(packcharges?.ToString(), out packValue);
                        }
                        CreditNoteVMs.PackingCharges = packValue;
                        //------------------------------------------------------

                        //Insurance------------------------------------------
                        bool insuAmtOrPer = firstItem.ContainsKey("InsuranceAmtOrPer") && firstItem["InsuranceAmtOrPer"] != null
                                            ? Convert.ToBoolean(firstItem["InsuranceAmtOrPer"]) : false;
                        CreditNoteVMs.InsuranceAmtOrPer = insuAmtOrPer;

                        if (firstItem.TryGetValue("InsurancePercent", out var perc))
                        {
                            decimal.TryParse(perc?.ToString(), out Insuperce);
                        }
                        CreditNoteVMs.InsurancePercent = Insuperce;

                        if (firstItem.TryGetValue("InsuranceCharges", out var insucharges))
                        {
                            decimal.TryParse(insucharges?.ToString(), out InsuVal);
                        }
                        CreditNoteVMs.InsuranceCharges = InsuVal;
                        //------------------------------------------------------

                        //TCS-------------------------------------
                        bool tcsAmtOrPer = firstItem.ContainsKey("TCSAmtOrPer") && firstItem["TCSAmtOrPer"] != null
                                            ? Convert.ToBoolean(firstItem["TCSAmtOrPer"]) : false;
                        CreditNoteVMs.TCSAmtOrPer = tcsAmtOrPer;

                        if (firstItem.TryGetValue("TCSPercent", out var TCSperc))
                        {
                            decimal.TryParse(TCSperc?.ToString(), out tcsPerc);
                        }
                        CreditNoteVMs.TCSPercent = tcsPerc;

                        if (firstItem.TryGetValue("TCSAmount", out var tcscharges))
                        {
                            decimal.TryParse(tcscharges?.ToString(), out tcsVal);
                        }
                        CreditNoteVMs.TCSAmount = tcsVal;

                        //----------------------------------------

                        //OtherCharges------------------------------
                        if (firstItem.TryGetValue("OtherCharges", out var othercharge))
                        {
                            decimal.TryParse(othercharge?.ToString(), out otherVal);
                        }
                        CreditNoteVMs.OtherCharges = otherVal;
                    }
                }

                IsDcModalVisible = true;
            }
            catch (Exception ex)
            {
                await LoggingService.LogDeveloperError(ex, "ShowPoDetails failed.");
                await _js.ToastrError("Error fetching Po details.");
            }
            finally
            {
                isProcessing = false;
            }
        }
    }

    private async Task OnInvoiceSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (CreditNoteVMs.CreditNoteSubVMs == null)
            CreditNoteVMs.CreditNoteSubVMs = new List<CreditNoteSubVM>();

        int custId = CreditNoteVMs.CustId.Value;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();



            decimal balQty = 0;
            decimal price = 0;

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefInvSubId = item.ContainsKey("InvSubId") && item["InvSubId"] != null
                    ? Convert.ToInt32(item["InvSubId"])
                    : (int?)null;

                int? RefDcSubId = item.ContainsKey("DcSubId") && item["DcSubId"] != null
                    ? Convert.ToInt32(item["DcSubId"])
                    : (int?)null;

                int? RefPoSubId = item.ContainsKey("PoSubId") && item["PoSubId"] != null
                    ? Convert.ToInt32(item["PoSubId"])
                    : (int?)null;

                if (item.TryGetValue("CrBalQty", out var balQtyValue))
                {
                    decimal.TryParse(balQtyValue?.ToString(), out balQty);
                }

                if (item.TryGetValue("UnitPrice", out var unitprice))
                {
                    decimal.TryParse(unitprice?.ToString(), out price);
                }



                if (CreditNoteVMs.CreditNoteSubVMs.Any(x => x.ItemId == itemId && x.RefInvSubId == RefInvSubId))
                    continue;

                var subVm = new CreditNoteSubVM
                {
                    RefInvSubId = CreditNoteVMs.Sales == true ? RefInvSubId : null,
                    LabInvSubId = CreditNoteVMs.Labour == true ? RefInvSubId : null,
                    ExpInvSubId = CreditNoteVMs.Export == true ? RefInvSubId : null,


                    RefInvNo = item.ContainsKey("InvNo") ? item["InvNo"]?.ToString() : "",
                    RefInvDate = item.ContainsKey("InvDate") && item["InvDate"] != null
                        ? Convert.ToDateTime(item["InvDate"]) : null,
                    RefPoSubId=RefPoSubId,

                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    Qty = balQty,
                    // CrDrQty = balQty,
                    CrBalQty = balQty,
                    UnitPrice = price,

                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,
                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",

                    Specification = item.ContainsKey("Specification") ? item["Specification"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("UOM") ? item["UOM"]?.ToString() : "",
                    HsnCode = item.ContainsKey("HSNCode") ? item["HSNCode"]?.ToString() : "",

                    Category = item.ContainsKey("Category") ? item["Category"]?.ToString() : "",

                    IsEditable = true,

                    CreditNote =CreditNoteVMs,
                };

                CreditNoteVMs.CreditNoteSubVMs.Add(subVm);
                await _calculationService.UpdateTotalsAsync(CreditNoteVMs);
            }

            int slNo = 1;
            foreach (var row in CreditNoteVMs.CreditNoteSubVMs)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnDcSelectedAsync failed.");
            await _js.ToastrError("Error processing selected Dc items.");
        }
    }

    // Common decimal formatter
    private string FormatDecimal(decimal? value) 
    {
        return value?.ToString($"F{DecimalPlaces}") ?? (0m).ToString($"F{DecimalPlaces}");
    }

    private async Task UpsertCreditNote()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            CreditNoteVMs.CreditNoteSubVMs.RemoveAll(x => x.ItemId!=0 && (!x.Qty.HasValue || x.Qty == 0) && (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!CreditNoteVMs.CreditNoteSubVMs.Any())
            {
                await _js.ToastrWarning("Cannot save a CreditNote without valid items.");
                return;
            }

            if (string.IsNullOrWhiteSpace(CreditNoteVMs.CreditNo))
            {
                await _js.ToastrWarning("Please enter the CreditNote number");
                return;
            }

            if (CreditNoteVMs.CustId==0)
            {
                await _js.ToastrWarning("Please select  Customer");
                return;
            }


            // Validate each line
            foreach (var line in CreditNoteVMs.CreditNoteSubVMs)
            {
                bool isValid = await ValidateCreditNoteLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewCredit = CreditNoteVMs.CrId == 0;

            try
            {

                if (CreditNoteVMs.Sales.Value)
                {
                    await _creditNoteService.UpsertCreditNoteAsync(CreditNoteVMs,screenCode,"Sales");
                }
                else if (CreditNoteVMs.Labour.Value)
                {
                    await _creditNoteService.UpsertCreditNoteAsync(CreditNoteVMs,screenCode,"Labour");
                }
                else if (CreditNoteVMs.Export.Value)
                {
                    await _creditNoteService.UpsertCreditNoteAsync(CreditNoteVMs,screenCode,"Export");
                }
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewCredit)
                await _js.ToastrSuccess("Credit Note saved successfully.");
            else
                await _js.ToastrSuccess("Credit Note  updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/creditNoteList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertInvoic failed.");
            await _js.ToastrError("Error saving Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateCreditNoteLineAsync(CreditNoteSubVM line)
    {
        try
        {
            if (line.ItemId==0)
            {
                await _js.ToastrWarning ("One or more items are missing Item selection.");
                return false;
            }

            if (line.RejQty <= 0 && line.CrDrQty<=0)
            {
                await _js.ToastrWarning($"Item {line.ItemId}: Reject or CrDrQty Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrWarning($"Item {line.ItemId}: Unit Price must be greater than 0.");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            decimal qtyOut = 0,stkqty=0;

            int RefInvSubId = 0, RefLabInvSubId = 0, RefExpInvSubId=0;

            int.TryParse(line.RefInvSubId.ToString(),out RefInvSubId);
            int.TryParse(line.LabInvSubId.ToString(),out RefLabInvSubId);
            int.TryParse(line.ExpInvSubId.ToString(), out RefExpInvSubId);


            if (line.CrSubId == 0)
            {
                decimal invBalQty = 0;
                if(RefInvSubId>0)
                {
                    invBalQty = await GetInvBalQty(RefInvSubId);
                    if (line.Qty > invBalQty)
                    {
                        line.Qty = invBalQty;
                        line.RejQty = invBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Invoice Balance Qty ({invBalQty}).");
                        return false;
                    }
                }else if (RefLabInvSubId>0)
                {
                    invBalQty = await GetInvBalQty(RefLabInvSubId);
                    if (line.Qty > invBalQty)
                    {
                        line.Qty = invBalQty;
                        line.RejQty = invBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Invoice Balance Qty ({invBalQty}).");
                        return false;
                    }

                }else if (RefExpInvSubId>0)
                {
                    invBalQty = await GetInvBalQty(RefExpInvSubId);
                    if (line.Qty > invBalQty)
                    {
                        line.Qty = invBalQty;
                        line.RejQty = invBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Invoice Balance Qty ({invBalQty}).");
                        return false;
                    }
                    
                }

            }
            else if (line.CrSubId > 0)
            {
                var reason = CreditNoteVMs.Rejection ?? false ? "Rejection" : "RateDifference";

                var original = await _creditNoteService.GetCreditNoteSubItemDetailByCrSubIdAsync(line.CrSubId,reason);

                if (original != null)
                {
                    decimal origBalQty =reason=="Rejection"?original.RejQty:original.CrDrQty;
                    decimal origQty = original.Qty ?? 0m;
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.RejQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.RejQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateInvoiceLineAsync failed.");
            await _js.ToastrError("Error validating Invoice line.");
            return false;
        }
    }

