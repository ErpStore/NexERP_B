    //Cancel CreditNote
    private async Task Cancel()
    {
        try
        {
            if (CrId == 0)
            {
                await _js.ToastrWarning("Credit Note  cancel is not allowed before saving the Credit Note.");
                return;
            }

            if(CreditNoteVMs.Cancel)
            {
                var subs = await _creditNoteService.GetCreditSubDetailsByCrIdAsync(CreditNoteVMs.CrId.GetValueOrDefault());

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    await _creditNoteService.ValidateCreditNoteBalanceBeforeRevertAsync(sub);
                }
            }

             
            if (!CreditNoteVMs.Cancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Credit Note?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Credit Note?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
           
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the CreditNote.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Credit Note Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CancelInvoice()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!CreditNoteVMs.Cancel)
            {
                CreditNoteVMs.Cancel = true;
                CreditNoteVMs.CancelReason = cancelReason;

                await _creditNoteService.UpdatedCancelStatusAndAddOrRevertQty(CreditNoteVMs,screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "CreditNote",
                    action: $"Cancelled CreditNote: {CreditNoteVMs.CreditNo}",
                    additionalInfo: $"Invoice Id: {CreditNoteVMs.CrId}"
                );

                await _js.ToastrSuccess("CreditNote cancelled successfully.");
            }
            else
            {
                CreditNoteVMs.Cancel = false;
                CreditNoteVMs.CancelReason = string.Empty;

                await _creditNoteService.UpdatedCancelStatusAndAddOrRevertQty(CreditNoteVMs,screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "CreditNote",
                    action: $"Reverted CreditNote: {CreditNoteVMs.CreditNo}",
                    additionalInfo: $"CreditNote Id: {CreditNoteVMs.CrId}"
                );

                await _js.ToastrSuccess("CreditNote has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the CreditNote.");
            await LoggingService.LogDeveloperError(ex, $"DebitNote failed for CrId: {CreditNoteVMs.CrId}");
        }
        finally
        {
            isProcessing = false;
        }
    }



