                                                   type="number" @bind="CreditNoteVMs.PackingCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)' readonly />
                                            <ValidationMessage For="@(() => CreditNoteVMs.PackingCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="CreditNoteVMs.PackingPercent"
                                                   @bind:after="() => OnPandFPercentChanged()" readonly />
                                            <ValidationMessage For="@(() => CreditNoteVMs.PackingPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(CreditNoteVMs.PackingCharges) </small>
                                        }
                                    </div>
                                </div>

                                <!-- Insurance Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Insurance Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceToggleRs"
                                                   @onchange="() => SetInsuranceType(true)" disabled="true" />
                                            <label class="btn btn-outline-primary" for="insuranceToggleRs"><small>@CreditNoteVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceTogglePercent"
                                                   @onchange="() => SetInsuranceType(false)" disabled="true" />
                                            <label class="btn btn-outline-primary" for="insuranceTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (CreditNoteVMs.InsuranceAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="CreditNoteVMs.InsuranceCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)' readonly/>
                                            <ValidationMessage For="@(() => CreditNoteVMs.InsuranceCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="CreditNoteVMs.InsurancePercent"
                                                   @bind:after="() => OnInsurancePercentChanged()" readonly />
                                            <ValidationMessage For="@(() => CreditNoteVMs.InsurancePercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(CreditNoteVMs.InsuranceCharges)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Total Taxable -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Total Taxable</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               value="@FormatDecimal(CreditNoteVMs.TotalTaxable)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Taxes (CGST/SGST/IGST) -->
                                @if (SelectedCustomer?.TaxValidate == false)
                                {
                                    <div class="mb-2">
                                        @if (SelectedCustomer?.BusiType == "Local")
                                        {
                                            <!-- CGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>CGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!CreditNoteVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="CreditNoteVMs.CGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(CreditNoteVMs.CGstRate) " disabled >
                                                            <option value="0" >-- Select CGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => CreditNoteVMs.CGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(CreditNoteVMs.TotalCGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>

                                            <!-- SGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>SGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!CreditNoteVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="CreditNoteVMs.SGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(CreditNoteVMs.SGstRate)" disabled>
                                                            <option value="0" disabled>-- Select SGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => CreditNoteVMs.SGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(CreditNoteVMs.TotalSGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                        else if (SelectedCustomer?.BusiType == "InterState")
                                        {
                                            <!-- IGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>IGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!CreditNoteVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="CreditNoteVMs.IGstRate"
                                                                @bind:after="() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)"
                                                                disabled >
                                                            <option value="0" >-- Select IGST % --</option>
                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => CreditNoteVMs.IGstRate)" />
