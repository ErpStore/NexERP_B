@page "/creditNote/create"
@page "/creditNote/create/{CustId:int}"
@page "/creditNote/update/{CrId:int}"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IEInvoiceAPI
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.CreditNote_VM
@using MudBlazor

@inherits BaseUserRightsComponent
@inject ICalculationService _calculationService
@inject ILoggingService LoggingService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject IEinvoiceDatabaseService _einvoiceService

@inject ICreditNoteService _creditNoteService
@inject ReportService reportService

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="Invoice Details"
              Columns="InvColumns"
              ColumnFields="InvFields"
              HiddenColumns="InvHiddenColumns"
              Data="InvData"
              IsVisible="@IsDcModalVisible"
              IsVisibleChanged="@((val) => IsDcModalVisible = val)"
              OnSelectedItems="OnInvoiceSelectedAsync">
</DetailsModal>

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">

    if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                   refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

             <!-- Cancelled Watermark -->
            @if ((CreditNoteVMs?.Cancel ?? false))
            {
                <div class="cancelWatermark">CANCELLED</div>
            }

            <PageHeader TitleText="@(CreditNoteVMs.CrId > 0 ? "Update Credit Note" : "Create Credit Note")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@CreditNoteFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="CreditNoteVMs" OnValidSubmit="UpsertCreditNote">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 justify-content-end">

                        <!-- Correspondence Status -->
                        <div class="col-12 col-md-6 d-flex align-items-center justify-content-end">
                            @if (CreditNoteVMs.CrId > 0 && !string.IsNullOrWhiteSpace(CreditNoteVMs.CrId.ToString()))
                            {
                                <CorrespondenceStatus ReferenceType="@ScreenName"
                                                      ReferenceId="@CreditNoteVMs.CrId.Value"
                                                      ReferenceTypeName="@CreditNoteVMs.CreditNo" />
                            }
                        </div>
                    </div>
                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">

                            <div class="card h-100 shadow-sm">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Customer Information</span>
                                </div>
                                <div class="card-body">

                                    <div class="mb-2 row">
                                        
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Credit Note Type</small>
                                        </label>

                                        <div class="col-12 col-sm-9">

                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input border-3"
                                                       type="radio" name="cnType" checked="@CreditNoteVMs.Sales"
                                                       @onchange="(e) => OnSalesToggle(e)" />
                                                <label class="form-check-label fw-semibold" style="color:blue;">
                                                    Manufacturing
                                                </label>
                                            </div>

                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input border-3" type="radio" name="cnType" checked="@CreditNoteVMs.Labour"
                                                @onchange="(e) => OnLabourToggle(e)" />
                                                <label class="form-check-label fw-semibold" style="color:orange;">
                                                    Labour
                                                </label>
                                            </div>

                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input border-3" type="radio" name="cnType" checked="@CreditNoteVMs.Export"
                                                       @onchange="(e) => OnExportToggle(e)" />
                                                <label class="form-check-label fw-semibold" style="color:green;">
                                                    Export
                                                </label>
                                            </div>

                                        </div>
                                    </div>
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="CustomerVM"
                                                                 Value="SelectedCustomer"
                                                                 ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                                 ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                                 SearchFunc="SearchCustomers"
                                                                 Dense="true"
                                                                 Variant="Variant.Outlined"
                                                                 Placeholder="Search Customer"
                                                                 Title="Search atleast 3 letters in Customer"
                                                                 Class="w-100 autocomplete-sm"
                                                                 MaxItems="50"
                                                                 Clearable="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 Required="true"
                                                                 AvoidSubmit="true" 
                                                                 Disabled="@IsSomeItemsTransMade"/>
                                        </div>
                                    </div>
                                    <!-- Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                  rows="1" readonly>@CreditNoteVMs?.CustAddress</textarea>
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Phone No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@CreditNoteVMs?.ContactNo" readonly />
                                        </div>
                                    </div>

                                    <!-- GSTIN -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GSTIN</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@CreditNoteVMs?.GSTNo" readonly />
                                        </div>
                                    </div>

                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    @bind="@CreditNoteVMs.KindOfAttention">
                                                <option disabled value="">Select Contact Person</option>
                                                @foreach (var cp in contactPersons)
                                                {
                                                    <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => CreditNoteVMs.KindOfAttention)" />
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(CreditNoteVMs.ACKNO) && !string.IsNullOrEmpty(CreditNoteVMs.IRNNo))
                                    {
                                        <div class="accordion mb-3" id="transportEinvoice">
                                            <div class="accordion-item border-0 shadow-sm rounded-3">

                                                <h2 class="accordion-header" id="headingEInvoice">
                                                    <button class="accordion-button collapsed fw-semibold text-primary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseEInvoice"
                                                            aria-expanded="false"
                                                            aria-controls="collapseEInvoice">
                                                        <i class="bi bi-truck me-2"></i> E-Invoice Details
                                                    </button>
                                                </h2>

                                                <div id="collapseEInvoice"
                                                     class="accordion-collapse collapse"
                                                     aria-labelledby="headingEInvoice"
                                                     data-bs-parent="#transportEinvoice">

                                                    <div class="accordion-body">

                                                        <!-- ACK No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>ACK No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <input type="text"
                                                                       class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind="CreditNoteVMs.ACKNO"
                                                                       readonly />
                                                            </div>
                                                        </div>

                                                        <!-- ACK Date -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>ACK Date</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="CreditNoteVMs.ACKNODate"
                                                                           disabled />
                                                            </div>
                                                        </div>

                                                        <!-- IRN No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>IRN No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="CreditNoteVMs.IRNNo" />
                                                                <ValidationMessage For="@(() => CreditNoteVMs.IRNNo)" />
                                                            </div>
                                                        </div>

                                                        <!-- QR Code -->
                                                        <div class="mb-2 row align-items-center">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>QR Code</small>
                                                            </label>

                                                            <div class="col-12 col-sm-9">
                                                                @if (!string.IsNullOrEmpty(CreditNoteVMs.SignedInvoiceQrCode))
                                                                {
                                                                    <img src="@($"data:image/png;base64,{CreditNoteVMs.SignedInvoiceQrCode}")"
                                                                         class="bg-white p-2"
                                                                         style="width:150px;height:auto;" />
                                                                }
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    }



                                </div>

                            </div>
                        </div>

                         <!-- =================== Invoice Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">
                                 <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Credit Note Details</span>

                                    @if (CreditNoteVMs.CrId > 0  && (CanCreate || CanEdit) )
                                    {
                                        <button type="button"
                                                class="btn btn-sm rounded-3 @(CreditNoteVMs.Cancel ? "btn-success" : "btn-danger")"
                                                 @onclick="Cancel">

                                            @if (!CreditNoteVMs.Cancel)
                                            {
                                                <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                            }
                                        </button>

                                    }


                                </div>
                                <div class="card-body">

                                    <!-- Credit No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Credit Note No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                           placeholder="Prefix"
                                                           maxlength="10"
                                                           @bind-Value="@CreditNoteVMs.Prefix"
                                                           style="flex:0 0 130px;" />

                                                <InputText class="form-control form-control-sm rounded-3"
                                                           placeholder="Invoice No."
                                                           maxlength="30"
                                                           @bind-Value="@CreditNoteVMs.CreditNo"
                                                           readonly="@IsInvNoReadonly" />

                                                <span class="input-group-text rounded-3">@CreditNoteVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => CreditNoteVMs.Prefix)" />
                                            <ValidationMessage For="@(() => CreditNoteVMs.CreditNo)" />
                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Credit Note Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@CreditNoteVMs.CreditDate" />
                                            <ValidationMessage For="@(() => CreditNoteVMs.CreditDate)" />
                                        </div>
                                    </div>

                                    <div class="mb-2 row">

                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Credit Note Reason:</small>
                                        </label>

                                        <div class="col-12 col-sm-9">

                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input border-3"
                                                       type="radio" name="rejType" checked="@CreditNoteVMs.Rejection"
                                                       @onchange="(e) => OnRejectionToggle(e)" />
                                                <label class="form-check-label fw-semibold">
                                                    Rejection
                                                </label>
                                            </div>

                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input border-3" type="radio" name="rejType" checked="@CreditNoteVMs.RateDifference"
                                                       @onchange="(e) => OnRateDiffToggle(e)" />
                                                <label class="form-check-label fw-semibold">
                                                    Rate Difference
                                                </label>
                                            </div>


                                        </div>
                                    </div>

                                    @if (InvPendingCount > 0)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Our Invoice</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowInvoiceDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Invoice Details
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Currency -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Currency</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value="@CreditNoteVMs.CurrId"
                                                    @onchange="OnCurrencyChanged"
                                                    disabled>
                                                @foreach (var currency in Currencies)
                                                {
                                                    <option value="@currency.CurrId">@currency.CurrName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="CreditNoteVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => CreditNoteVMs.MainRemark)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <!-- Discount Toggle -->
                                        <div class="d-flex align-items-center">
                                            <label class="me-2 mb-0"><small>Discount : </small></label>
                                            <div class="btn-group btn-group-sm rounded-pill border" role="group" aria-label="Toggle Discount Rs and %">
                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountToggleRs" 
                                                        @onchange='() => SetDiscountMode(true)' 
                                                        checked="@CreditNoteVMs.IsItemWiseDiscAmtOrPerReq" />
                                                <label class="btn btn-outline-primary rounded-start-pill" for="discountToggleRs">@CreditNoteVMs.Symbol</label>

                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountTogglePercent" 
                                                        @onchange='() => SetDiscountMode(false)' 
                                                        checked="@(!CreditNoteVMs.IsItemWiseDiscAmtOrPerReq)" />
                                                <label class="btn btn-outline-primary rounded-end-pill" for="discountTogglePercent">%</label>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl No.</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:90px;">HSNCODE</th>
                                                    <th style="width:120px;">Qty</th>
                                                     <th style="width:120px;">Reject Qty</th>
                                                    <th style="width:120px;">UnitPrice</th>
                                                    
                                                    <th style="width:130px;">Gross Amount</th>

                                                    @if (!CreditNoteVMs.IsItemWiseDiscAmtOrPerReq)
                                                    {
                                                        <th style="width:110px;">Disc %</th>
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }
                                                    <th style="width:120px;">Rework Qty</th>
                                                    <th style="width:120px;">Cr/Dr Qty</th>
                                                    <th style="width:120px;">Cr/Dr UnitPrice</th>

                                                   @*  @if (SelectedCustomer?.TaxValidate == false)
                                                    {
                                                        @if (SelectedCustomer?.BusiType == "Local")
                                                        {
                                                            <th style="width:110px;">CGST %</th>
                                                            <th style="width:110px;">SGST %</th>
                                                        }
                                                        else if(SelectedCustomer?.BusiType == "InterState")
                                                        {
                                                            <th style="width:110px;">IGST %</th>
                                                        }
                                                    } *@

                                                    <th style="width:130px;">Basic Amount</th>
                                                    <th style="width:200px;">Remarks</th>

                                                    <th style="width:110px;">Ref Invoice No.</th>
                                                    <th style="width:110px;">Ref Invoice Date</th>

                                                
                                                    <th style="width:150px;">Cost-Center</th>
                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">

                                                @if (CreditNoteVMs.CreditNoteSubVMs != null && CreditNoteVMs.CreditNoteSubVMs.Any())
                                                {
                                                @foreach (var subitem in CreditNoteVMs.CreditNoteSubVMs)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                        @subitem.ItemCode
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId!=0 && subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                        Size="Size.Small"
                                                                                        Color="Color.Primary"
                                                                                        OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId, count))"
                                                                                        Edge="Edge.End"
                                                                                        Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.MeasureUnit</td>
                                                        <td>@subitem.HsnCode</td>

                                                        <!-- Qty -->
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                  <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           step="any"
                                                                           placeholder="Qty"
                                                                           title="Enter Quantity"
                                                                           @bind="subitem.Qty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" readonly />
                                                                <ValidationMessage For="@(() => subitem.Qty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.Qty</span>
                                                            }
                                                           
                                                        </td>

                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                  <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           step="any"
                                                                           placeholder="RejQty"
                                                                           title="Enter Rej Quantity"
                                                                           @bind="subitem.RejQty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" readonly="@(!CreditNoteVMs.Rejection)" />
                                                                <ValidationMessage For="@(() => subitem.RejQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.RejQty</span>
                                                            }
                                                           
                                                        </td>

                                                        <!-- Unit Price -->
                                                        <td>
                                                           
                                                            @FormatDecimal(subitem.UnitPrice)
                                                        </td>

                                                        <!-- Line Gross -->
                                                        <td>@FormatDecimal(subitem.LineGross)</td>

                                                        <!-- Discount -->
                                                        @if (!CreditNoteVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm"  step="any" placeholder="Disc %" title="Enter Discount %"
                                                                            @bind="subitem.LineDiscountPercent" @bind:event="oninput"
                                                                            @bind:after='() => OnLineDiscountPercentChanged(subitem)'  />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountPercent)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountPercent)
                                                                }
                                                            </td>
                                                            <td>@FormatDecimal(subitem.LineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                        <input type="number" class="form-control form-control-sm" step="any" placeholder="Disc Amt" title="Enter Discount Amount"
                                                                            @bind="subitem.LineDiscountAmount" @bind:event="oninput"
                                                                            @bind:after='() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)'  />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountAmount)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountAmount)
                                                                }
                                                            </td>
                                                        }

                                                        <!-- Taxes -->
                                                        @* @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if (SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
