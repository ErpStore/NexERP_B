    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.CrSubId > 0)
            {
                if (CreditNoteVMs.Sales.Value)
                {
                    await _creditNoteService.DeleteAndResequenceAsync(rowToDelete, CreditNoteVMs,screenCode,"Sales");
                }
                else if (CreditNoteVMs.Labour.Value)
                {
                    await _creditNoteService.DeleteAndResequenceAsync(rowToDelete, CreditNoteVMs,screenCode,"Labour");
                }
                else if (CreditNoteVMs.Export.Value)
                {
                    await _creditNoteService.DeleteAndResequenceAsync(rowToDelete, CreditNoteVMs,screenCode,"Export");
                }


                CreditNoteVMs.CreditNoteSubVMs = await _creditNoteService.GetCreditNoteSubByCrIdAsync(CreditNoteVMs.CrId.Value);

                await CountPendingInvs();
            }
            else
            {
                CreditNoteVMs.CreditNoteSubVMs.Remove(rowToDelete);

                if (!CreditNoteVMs.CreditNoteSubVMs.Any())
                {
                    CreditNoteVMs.CreditNoteSubVMs.Add(new CreditNoteSubVM
                    {
                        CrId = CreditNoteVMs.CrId.Value,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    await ResetSlno();
                }
            }

            await _calculationService.UpdateTotalsAsync(CreditNoteVMs);

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for InvId: {CreditNoteVMs.CrId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

