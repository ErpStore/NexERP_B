                                                        <td>@CreditNoteVMs.TotalQty</td>
                                                         <td>@CreditNoteVMs.TotalRejQty</td>
                                                        <td>Avg: @FormatDecimal(CreditNoteVMs.AvgUnitPrice)</td>
                                                        <td>@FormatDecimal(CreditNoteVMs.TotalLineGross)</td>

                                                        @if (!CreditNoteVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td></td>
                                                            <td>@FormatDecimal(CreditNoteVMs.TotalLineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@FormatDecimal(CreditNoteVMs.TotalLineDiscountAmount)</td>
                                                        }

                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if(SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td></td>
                                                                <td></td>

                                                            }
                                                            else if(SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td></td>

                                                            }

                                                        }

                                                        <td>@FormatDecimal(CreditNoteVMs.TotalLineBasicAmount)</td>
                                                        <td colspan="10"></td>
                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>
                                  
                                </div>
                            </div>
                        </div>

                          <div class="col-12 col-lg-6 mb-3">
                            
                        </div>

                        <!-- =================== Tax Details Section =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm rounded-4 border-0 p-3">

                                <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Tax & Charges
                                </h6>

                                <!-- Total Gross -->
                                <div class="row mb-2 gx-3">
                                    <label for="TotalGross" class="col-5 col-md-4 col-form-label text-dark">
                                        <small>Total Gross</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input id="TotalGross"
                                               class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               value="@FormatDecimal(CreditNoteVMs.TotalGrossAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Discount -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Discount</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="discountToggle" id="discountRs"  step="any"
                                                   @onchange="() => SetDiscountType(true)"
                                                   checked="@CreditNoteVMs.DiscAmtOrPer" disabled="true" />
                                            <label class="btn btn-outline-primary" for="discountRs">
                                                <small>@CreditNoteVMs.Symbol</small>
                                            </label>

                                            <input type="radio" class="btn-check" name="discountToggle" id="discountPercent"  step="any"
                                                   @onchange="() => SetDiscountType(false)"
                                                   checked="@(!CreditNoteVMs.DiscAmtOrPer)" disabled="true"   />
                                            <label class="btn btn-outline-primary" for="discountPercent"><small>%</small></label>
                                        </div>
                                    </div>

                                    <div class="col-3 col-md-5">
                                        @if (CreditNoteVMs.DiscAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number"
                                                   @bind="CreditNoteVMs.DiscountAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)'
                                                   disabled="@(CreditNoteVMs.TotalLineDiscountAmount > 0)" readonly />
                                            <ValidationMessage For="@(() => CreditNoteVMs.DiscountAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number"
                                                   @bind="CreditNoteVMs.DiscountPercent"
                                                   @bind:after="OnDiscountPercentChanged"
                                                   disabled="@(CreditNoteVMs.TotalLineDiscountAmount > 0)" readonly />
                                            <ValidationMessage For="@(() => CreditNoteVMs.DiscountPercent)" />
                                            <small class="text-muted d-block text-end">
                                                Amt: @FormatDecimal(CreditNoteVMs.DiscountAmount)
                                            </small>
                                        }
                                    </div>
                                </div>

                                <!-- SubTotal -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>SubTotal</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number" 
                                               value="@FormatDecimal(CreditNoteVMs.TotalBasicAmount)" 
                                               readonly />
                                    </div>
                                </div>

                                <!-- Freight Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Freight Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                               type="number" @bind="CreditNoteVMs.FreightCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)' readonly />
                                        <ValidationMessage For="@(() => CreditNoteVMs.FreightCharges)" />
