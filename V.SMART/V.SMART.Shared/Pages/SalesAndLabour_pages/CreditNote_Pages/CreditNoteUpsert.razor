                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="CreditNoteVMs.OtherCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)' readonly />
                                        <ValidationMessage For="@(() => CreditNoteVMs.OtherCharges)" />
                                    </div>
                                </div>

                                <!-- Round Off -->
                                <div class="row mb-2 gx-2 align-items-center">
                                    <div class="col-5 col-md-4 d-flex align-items-center">
                                        <small class="me-2 text-dark">Round Off</small>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="roundOffSwitch"
                                                   @bind="CreditNoteVMs.IsRoundOffEnabled"
                                                   @bind:after="() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)" >
                                            <label class="form-check-label" for="roundOffSwitch"></label>
                                        </div>
                                    </div>
                                    <div class="col-7 col-md-8">
                                       <input class="form-control form-control-sm rounded-3 text-end"
                                               value="@FormatDecimal(CreditNoteVMs.RoundOff)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Grand Total -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label fw-bold text-dark">
                                        <small>Grand Total</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                               value="@FormatDecimal(CreditNoteVMs.GrandTotal)"
                                               readonly />
                                        @if (CreditNoteVMs.CurrId > 1)
                                        {
                                            <div class="mt-1 text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @CreditNoteVMs.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((CreditNoteVMs.GrandTotal * CreditNoteVMs.TodayVal).ToString("0.00"))
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Amount in Words -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Amount in Words</small></label>
                                    <div class="col-7 col-md-8 pt-1">
                                        @if (CreditNoteVMs.CurrId > 1)
                                        {
                                            <small class="fw-bold text-success d-block">
                                                Converted Value in Rs: @FormatDecimal(CreditNoteVMs.GrandTotal * CreditNoteVMs.TodayVal)
                                            </small>
                                        }
                                        else
                                        {
                                            <strong>@NumberToWordsHelper.ConvertNumberToWords(CreditNoteVMs.GrandTotal)</strong>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                         <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            
                            <div class="col-6 col-md-3 mt-3">
                                <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                    <i class="bi bi-floppy2-fill me-1"></i> @(CreditNoteVMs.CrId > 0 ? "Update" : "Create")
                                </button>
                            </div>
                            
                        }
                        

                        @if(CreditNoteVMs.CrId>0 && string.IsNullOrEmpty(CreditNoteVMs.ACKNO) && string.IsNullOrEmpty(CreditNoteVMs.IRNNo) && !CreditNoteVMs.Cancel)
                        {
                            <div class="col-4 col-md-3 mt-3">
                            <button type="button" class="btn  btn-success w-100 rounded-3 rounded-3" @onclick='() => ConfirmEinvoice()'>
                                <i class="bi bi-person-add me-1"></i> E-Invoice
                            </button>
                            
                            </div>
                        }

                        <div class="col-6 col-md-3 mt-3">
                            <SmartBackButton Url="@($"/creditNoteList?currentPage={currentPage}")" />
                        </div>

                        @if (CanCreate || CanEdit && CrId > 0)
                        {
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                    <i class="bi bi-printer me-1"></i>Print
                                </button>
                            </div>
                        }

                    </div>

                </EditForm>
            </div>

        </div>
    </div>
}

