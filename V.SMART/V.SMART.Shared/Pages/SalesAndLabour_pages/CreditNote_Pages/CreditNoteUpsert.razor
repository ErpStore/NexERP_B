                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsToggleRs"
                                                   @onchange="() => SetTCSType(true)" disabled="true" />
                                            <label class="btn btn-outline-primary" for="tcsToggleRs"><small>@CreditNoteVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsTogglePercent"
                                                   @onchange="() => SetTCSType(false)" disabled="true" />
                                            <label class="btn btn-outline-primary" for="tcsTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (CreditNoteVMs.TCSAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="CreditNoteVMs.TCSAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)' readonly />
                                            <ValidationMessage For="@(() => CreditNoteVMs.TCSAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="CreditNoteVMs.TCSPercent"
                                                   @bind:after="() => OnTCSPercentChanged()" readonly />
                                            <ValidationMessage For="@(() => CreditNoteVMs.TCSPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @CreditNoteVMs.TCSAmount</small>
                                        }
