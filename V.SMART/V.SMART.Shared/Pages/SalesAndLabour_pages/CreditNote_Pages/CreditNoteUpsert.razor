                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.CrDrQty</span>
                                                            }
                                                           
                                                        </td>
                                                         
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm"  step="any" placeholder="Price" title="Enter Cr/Dr Unit Price"
                                                                        @bind="subitem.CrDrUnitPrice" @bind:event="oninput"
                                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(CreditNoteVMs)' readonly="@(!CreditNoteVMs.RateDifference)" />
