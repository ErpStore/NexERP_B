    private async Task HandleExport()
    {

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }
    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var dt = await mfgQuotationService.GetMfgLabQuotePendingList(selectedStatus);

            var exportData = dt.AsEnumerable()
                .Select(row => dt.Columns.Cast<DataColumn>()
                    .ToDictionary(col => col.ColumnName, col => row[col]))
                .ToList();

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "SalesandlabourQuotationPending", "Manufacturing and Labour Quotation's Pending List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "SalesandlabourQuotationPendingExport.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (SalesLabourExport)");
            await _JS.ToastrError("Error while exporting MfgPo!");
        }
        finally
        {
            isProcessing = false;
        }
    }
