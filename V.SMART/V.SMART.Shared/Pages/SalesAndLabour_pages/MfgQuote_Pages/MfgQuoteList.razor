    #region === Deletion Flow ===

    private async Task HandleDelete(int quoteId)
    {
        try
        {
            var (canDelete, message) = await mfgQuotationService.CanDeleteSalesQuotationAsync(quoteId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteQuoteId = quoteId;

            ModalTitle = "Are you sure you want to delete this Quotation";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for QuotationId: {quoteId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;

            var deleted = await mfgQuotationService.DeleteQuotationByQuoteIdAsync(DeleteQuoteId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Sales Quoatation deleted successfully.");
                await LoadAllQuotations();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Quotation could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting QuotationId: {DeleteQuoteId}");
            await _JS.ToastrError("Failed to delete Sales Quotation.");
        }
        finally
        {
            DeleteQuoteId = 0;
            isProcessing = false;
        }
    }

