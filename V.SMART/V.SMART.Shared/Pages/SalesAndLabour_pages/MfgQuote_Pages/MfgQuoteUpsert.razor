    private async Task AskToShortCloseAsync(MfgQuoteVM mfgQuoteVM)
    {
        try
        {
            if (mfgQuoteVM == null)
            {
                await _js.ToastrError("Invalid Sales Quotation selected.");
                return;
            }

            if (!QuoteId.HasValue || QuoteId == 0)
            {
                await _js.ToastrError("Quotation Short Closed is not allowed before saving the Quotation.");
                return;
            }

            if (mfgQuoteVM.QuotationTally)
            {
                await _js.ToastrWarning("This Sales Quotation is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (mfgQuoteVM.IsCancel)
            {
                await _js.ToastrWarning("This Sales Quotation is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!mfgQuoteVM.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Sales Quotation?";
                btnText = "Short Closed";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Sales Quotation?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while AskToShortCloseAsync Sales Quotation.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnItemCancelChanged(MfgQuoteSubVM subitem)
    {
        try
        {
            if (subitem.QuoteSubId == 0)
            {
                await _js.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if (subitem.Qty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _js.ToastrError("Item cannot be cancelled — Sales Order transactions have been made on it.");
                return;
            }

            if (MfgQuoteVM.IsCancel)
            {
                await _js.ToastrError("Quotation is already Cancel. You can't cancel Item.");
                return;
            }

            if(subitem.ItemCancel)
                await mfgQuotationService.ValidateBeforeRevertAsync(subitem.QuoteSubId);

            var (CanItemCancel, message) = await mfgQuotationService.CanQuoteItemCancelCheckAsync(subitem);

            if (!CanItemCancel)
            {
                await _js.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _js.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _js.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingQuote(QuoteId.Value);
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling Item in Sales Quotation");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in Sales Quotation");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CancelItem()
    {
        if (rowToCancel == null || isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            bool isCancelling = !rowToCancel.ItemCancel;

            if (isCancelling && string.IsNullOrWhiteSpace(cancelReason))
            {
                await _js.ToastrWarning("Cancel reason is required.");
                return;
            }

            rowToCancel.ItemCancel = isCancelling;
            rowToCancel.ItemCancelReason = isCancelling ? cancelReason : string.Empty;

            await mfgQuotationService.UpdateItemCancelAndAddorRevertAsync(
                rowToCancel,
                QuoteId.GetValueOrDefault()
            );

            string actionText = isCancelling ? "Cancelled" : "Reverted";

            await LoggingService.LogUserAction(
                username,
                machine,
                ip,
                screen: "Manufacturing Quotation",
                action: $"{actionText} Quotation No: {MfgQuoteVM.QuoteNo}, ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: isCancelling
                    ? $"Reason: {cancelReason}"
                    : "Item revert operation"
            );

            MfgQuoteVM = await mfgQuotationService.GetQuotationByQuoteIdAsync(MfgQuoteVM.QuoteId);

            await ResetSlno();
            await _calculationService.UpdateTotalsAsync(MfgQuoteVM);

            await _js.ToastrSuccess($"Item has been {actionText.ToLower()} successfully.");

            cancelReason = string.Empty;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrWarning(ex.Message);
            MfgQuoteVM = await mfgQuotationService.GetQuotationByQuoteIdAsync(MfgQuoteVM.QuoteId);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the item.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Revert failed for QuoteId: {MfgQuoteVM?.QuoteId}");
        }
        finally
        {
            isProcessing = false;
        }
    }


