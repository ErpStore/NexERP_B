    #region Quotation Operations

    private async Task UpsertQuote()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            MfgQuoteVM.MfgQuoteSubVM.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!MfgQuoteVM.MfgQuoteSubVM.Any())
            {
                await _js.ToastrError("Cannot save a quotation without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in MfgQuoteVM.MfgQuoteSubVM)
            {
                bool isValid = await ValidateQuoteLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewQuote = MfgQuoteVM.QuoteId == 0;

            try
            {
                await mfgQuotationService.UpsertQuoteAsync(MfgQuoteVM);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewQuote)
                await _js.ToastrSuccess("Quotation saved successfully.");
            else
                await _js.ToastrSuccess("Quotation updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/mfgQuoteList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertQuote failed.");
            await _js.ToastrError("Error saving quotation.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateQuoteLineAsync(MfgQuoteSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Unit Price must be greater than 0.");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            if (line.QuoteSubId == 0 && line.RefEnqSubId > 0)
            {
                var enqBalQty = await mfgQuotationService.GetEnquiryItemBalQtyFromEnqSubId(line.RefEnqSubId.Value);
                if (line.Qty > enqBalQty && !MfgQuoteVM.IsRevisionNo)
                {
                    line.Qty = enqBalQty;
                    line.BalQty = enqBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed Enquiry Balance Qty ({enqBalQty}).");
                    return false;
                }
            }
            else if (line.QuoteSubId > 0)
            {
                var original = await mfgQuotationService.GetQuoteSubItemDetailByQuoteSubIdAsync(line.QuoteSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty ?? 0m;
                    decimal origQty = original.Qty ?? 0m;
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateQuoteLineAsync failed.");
            await _js.ToastrError("Error validating quotation line.");
            return false;
        }
    }

