    private async Task OnEnquirySelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (MfgQuoteVM.MfgQuoteSubVM == null)
            MfgQuoteVM.MfgQuoteSubVM = new List<MfgQuoteSubVM>();

        int custId = MfgQuoteVM.CustId;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            var priceDict = await mfgQuotationService.GetBulkLastUnitPricesAsync(itemIds, custId);

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefEnqSubId = item.ContainsKey("RefEnqSubId") && item["RefEnqSubId"] != null
                    ? Convert.ToInt32(item["RefEnqSubId"])
                    : (int?)null;

                if (MfgQuoteVM.MfgQuoteSubVM.Any(x => x.ItemId == itemId && x.RefEnqSubId == RefEnqSubId))
                    continue;

                var subVm = new MfgQuoteSubVM
                {
                    RefEnqSubId = RefEnqSubId,
                    RefEnqNo = item.ContainsKey("EnquiryNo") ? item["EnquiryNo"]?.ToString() : "",
                    RefEnqDate = item.ContainsKey("EnquiryDate") && item["EnquiryDate"] != null
                        ? Convert.ToDateTime(item["EnquiryDate"])
                        : null,
                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("UOM") ? item["UOM"]?.ToString() : "",
                    HsnCode = item.ContainsKey("HSNCode") ? item["HSNCode"]?.ToString() : "",

                    Qty = item.ContainsKey("BalQty") && item["BalQty"] != null 
                            ? Convert.ToDecimal(item["BalQty"]) 
                            : (decimal?)0,

                    BalQty = item.ContainsKey("BalQty") && item["BalQty"] != null 
                            ? Convert.ToDecimal(item["BalQty"]) 
                            : (decimal?)0,

                    UnitPrice = priceDict.TryGetValue(itemId, out var price) ? price : 0,
                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,
                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",
                    IsEditable = true
                };

                MfgQuoteVM.MfgQuoteSubVM.Add(subVm);
                await _calculationService.UpdateTotalsAsync(MfgQuoteVM);
            }

            await ResetSlno();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnEnquirySelectedAsync failed.");
            await _js.ToastrError("Error processing selected enquiry items.");
        }
    }

