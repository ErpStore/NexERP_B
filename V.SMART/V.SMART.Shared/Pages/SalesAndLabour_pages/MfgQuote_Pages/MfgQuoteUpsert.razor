    private async Task CancelEdit(MfgQuoteSubVM? item, MfgQuoteVM? parentQuote)
    {
        try
        {
            if (item == null || parentQuote == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentQuote.MfgQuoteSubVM.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for QuoteSubId: {item?.QuoteSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(MfgQuoteSubVM item)
    {
        try
        {
            if (MfgQuoteVM.MfgQuoteSubVM.Count == 1 && MfgQuoteVM.QuoteId > 0)
            {
                await _js.ToastrWarning("At least one item must be present in the quotation.");
                return;
            }

            if (MfgQuoteVM.IsCancel)
            {
                await _js.ToastrError("This Quotation is already cancelled. Row deletion is not allowed.");
                return;
            }

            if (MfgQuoteVM.ShortClose)
            {
                await _js.ToastrError("This Quotation is already short closed. Row deletion is not allowed.");
                return;
            }

            if (item.ItemCancel)
            {
                await _js.ToastrError("This item is already cancelled and cannot be deleted.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction integrity.");
                return;
            }

            if (item.ItemId == 0)
            {
                MfgQuoteVM.MfgQuoteSubVM.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!MfgQuoteVM.MfgQuoteSubVM.Any())
                    MfgQuoteVM.MfgQuoteSubVM = new List<MfgQuoteSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(MfgQuoteVM);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for QuoteSubId: {item?.QuoteSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in MfgQuoteVM.MfgQuoteSubVM)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to reset row serial numbers.");
        }
    }

