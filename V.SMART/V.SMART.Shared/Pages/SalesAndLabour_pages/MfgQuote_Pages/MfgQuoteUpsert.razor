    private async Task Cancel()
    {
        try
        {
            if (await mfgQuotationService.CheckreviseQuoteByQuoteIdAsyn(MfgQuoteVM.QuoteNo))
            {
                await _js.ToastrError("This quotation has already been revised. You cannot revoke this quotation.");
                return;
            }

            if (!QuoteId.HasValue || QuoteId == 0)
            {
                await _js.ToastrError("Quotation cancel is not allowed before saving the enquiry.");
                return;
            }

            if(IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Quotation");
                return;
            }

            if (MfgQuoteVM.ShortClose)
            {
                await _js.ToastrError("Quotation is already short closed. You can't cancel it.");
                return;
            }

            if (MfgQuoteVM.MfgQuoteSubVM?.Any(x => x.ItemCancel) == true)
            {
                await _js.ToastrError("Some items are already cancelled. Complete Quotation cancellation is not allowed.");
                return;
            }

            if (MfgQuoteVM.IsCancel)
            {
                var subs = await mfgQuotationService.GetQuoteSubByQuoteIdAsync(MfgQuoteVM.QuoteId); 

                foreach (var sub in subs)
                {
                    await mfgQuotationService.ValidateEnquiryBalanceBeforeRevertAsync(sub);
                }
            }

            if (!MfgQuoteVM.IsCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Quotation?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Quotation?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            MfgQuoteVM= await mfgQuotationService.GetQuotationByQuoteIdAsync(MfgQuoteVM.QuoteId);
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Quotation.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Quotation Sales Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
                    await CancelQuotation();
                    break;

                case "ItemCancel":
                    await CancelItem();
                    break;
                case "Revise":
                    await ReviseQuote();
                    break;
                case "ShortClose":
                    await ShortCloseQuotation();
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

