    private async Task CancelQuotation()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!MfgQuoteVM.IsCancel)
            {
                MfgQuoteVM.IsCancel = true;
                MfgQuoteVM.CancelDate = DateTime.Now;
                MfgQuoteVM.CancelReason = cancelReason;
                MfgQuoteVM.CancelBy = username;

                await mfgQuotationService.UpdatedCancelStatusAndAddOrRevertQty(MfgQuoteVM);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Quotation",
                    action: $"Cancelled Quotation: {MfgQuoteVM.QuoteNo}",
                    additionalInfo: $"Quotation Id: {MfgQuoteVM.QuoteId}"
                );

                await _js.ToastrSuccess("Quotation cancelled successfully.");
            }
            else
            {
                MfgQuoteVM.IsCancel = false;
                MfgQuoteVM.CancelDate = null ;
                MfgQuoteVM.CancelReason = string.Empty;
                MfgQuoteVM.CancelBy = string.Empty;

                await mfgQuotationService.UpdatedCancelStatusAndAddOrRevertQty(MfgQuoteVM);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Quotation",
                    action: $"Reverted Quotation: {MfgQuoteVM.QuoteNo}",
                    additionalInfo: $"Quotation Id: {MfgQuoteVM.QuoteId}"
                );

                await _js.ToastrSuccess("Quotation has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            MfgQuoteVM= await mfgQuotationService.GetQuotationByQuoteIdAsync(MfgQuoteVM.QuoteId);
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"CancelQuotation failed for QuoteId: {MfgQuoteVM.QuoteId}");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the quotation.");
            await LoggingService.LogDeveloperError(ex, $"CancelQuotation failed for QuoteId: {MfgQuoteVM.QuoteId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.QuoteSubId > 0)
            {
                await mfgQuotationService.DeleteAndResequenceAsync(rowToDelete, MfgQuoteVM);

                MfgQuoteVM = await mfgQuotationService.GetQuotationByQuoteIdAsync(MfgQuoteVM.QuoteId);
            }
            else
            {
                MfgQuoteVM.MfgQuoteSubVM.Remove(rowToDelete);

                if (!MfgQuoteVM.MfgQuoteSubVM.Any())
                {
                    MfgQuoteVM.MfgQuoteSubVM.Add(new MfgQuoteSubVM
                    {
                        QuoteId = MfgQuoteVM.QuoteId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    await ResetSlno();
                }
            }

            await _calculationService.UpdateTotalsAsync(MfgQuoteVM);

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for QuoteId: {MfgQuoteVM.QuoteId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

