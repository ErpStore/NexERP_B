    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, MfgQuoteSubVM SubVM)
    {
        try
        {
            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW quote line
            if (SubVM.QuoteSubId == 0)
            {
                if (SubVM.RefEnqSubId > 0)
                {
                    var enqBalQty = await mfgQuotationService.GetEnquiryItemBalQtyFromEnqSubId(SubVM.RefEnqSubId.Value);

                    if (newQty <= enqBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = enqBalQty;
                        SubVM.BalQty = enqBalQty;
                        await _js.ToastrWarning($"Qty can't be greater than Enquiry Balance Qty ({enqBalQty}).");
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty;
                }
            }
            // EXISTING quote line
            else
            {
                var original = await mfgQuotationService.GetQuoteSubItemDetailByQuoteSubIdAsync(SubVM.QuoteSubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.BalQty = 0;
                    await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefEnqSubId > 0)
                {
                    var enqBalQty = await mfgQuotationService.GetEnquiryItemBalQtyFromEnqSubId(SubVM.RefEnqSubId.Value);
                    var maxAllowedQty = original.Qty + enqBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty - alreadyTransacted;
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted;
                }
            }
            await _calculationService.UpdateTotalsAsync(MfgQuoteVM);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for QuoteSubId: {SubVM?.QuoteSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

