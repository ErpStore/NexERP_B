    #region Row Operations

    private async Task<bool> ValidateRowAsync(MfgQuoteSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (row.Qty == null || row.Qty <= 0)
                errors.Add("Quantity must be greater than 0.");

            if (row.UnitPrice == null || row.UnitPrice <= 0)
                errors.Add("Unit Price must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = MfgQuoteVM.MfgQuoteSubVM.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (!await ValidateLastRowAsync()) return;

            MfgQuoteVM.MfgQuoteSubVM.Add(new MfgQuoteSubVM
            {
                QuoteId = MfgQuoteVM.QuoteId,
                IsEditable = true
            });

            await ResetSlno();
            await _calculationService.UpdateTotalsAsync(MfgQuoteVM);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await LoggingService.LogDeveloperError(ex, "AddRow failed.");
        }
    }

    private async Task SaveRow(MfgQuoteSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            // Ensure at least one editable row exists for new entries
            if (!MfgQuoteVM.MfgQuoteSubVM.Any(x => x.IsEditable))
            {
                MfgQuoteVM.MfgQuoteSubVM.Add(new MfgQuoteSubVM
                {
                    QuoteId = MfgQuoteVM.QuoteId,
                    IsEditable = true
                });
            }

            await ResetSlno();
            await _calculationService.UpdateTotalsAsync(MfgQuoteVM);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for QuoteSubId: {item?.QuoteSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(MfgQuoteSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItem == null && item.ItemId > 0)
            {
                item.SelectedItem = await mfgQuotationService.GetItemByItemIdAsync(item.ItemId);
            }
