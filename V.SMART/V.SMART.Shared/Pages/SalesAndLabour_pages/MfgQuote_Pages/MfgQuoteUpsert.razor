@page "/MfgQuote/create"
@page "/MfgQuote/create/{CustId:int}"
@page "/MfgQuote/update/{QuoteId:int}"


@using V.SMART.Shared.Repository.IRepository.IMasterRepository.IAdmins
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IMfgQuotationService mfgQuotationService
@inject ILoggingService LoggingService
@inject ICostingService _CostingService

@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject ReportService reportService
@inject IUserAuthorityRepository userAuthority

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="Enquiry Details"
              Columns="@EnquiryColumns"
              ColumnFields="@EnquiryFields"
              HiddenColumns="@EnquiryHiddenColumns"
              Data="@EnquiryData"
              IsVisible="@IsEnquiryModalVisible"
              IsVisibleChanged="@((val) => IsEnquiryModalVisible = val)"
              OnSelectedItems="OnEnquirySelectedAsync">
</DetailsModal>


<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isCustModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "ExcelUpload")
    { 
        <ExcelUpload isModelVisible=true CustomerId=CustId OnClose="CloseModal" uploadType="MfgQuote" OnUploadCompleted="ReceiveItems"/>
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if(ActiveModal == "Terms")
    {
        <TermsUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
  position: sticky;
  right: 0;
  background-color: #f8f9fa;
  z-index: 10;
}
</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{

    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if (MfgQuoteVM.IsCancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (MfgQuoteVM.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }


            <PageHeader TitleText="@(MfgQuoteVM.QuoteId > 0 ? "Update Sales Quotation" : "Create Sales Quotation")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@QuoteFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="MfgQuoteVM" OnValidSubmit="UpsertQuote">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Manufacturing / Labour Toggle -->
                        <div class="col-12 col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex justify-content-around align-items-center">

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="ManufacturingSwitch"
                                                checked="@MfgQuoteVM.MfgOrLab"
                                                @onchange="(e) => OnManufacturingToggle(e)" 
                                                disabled ="@IsSomeItemsTransMade"/>
                                        <label class="form-check-label fw-semibold @(MfgQuoteVM.MfgOrLab ? "text-success" : "")"
                                                for="ManufacturingSwitch">
                                            <i class="bi bi-gear-fill me-1"></i> Manufacturing
                                        </label>
                                    </div>

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="LabourSwitch"
                                                checked="@(!MfgQuoteVM.MfgOrLab)"
                                                @onchange="(e) => OnLabourToggle(e)" 
                                                disabled ="@IsSomeItemsTransMade"/>
                                        <label class="form-check-label fw-semibold @(!MfgQuoteVM.MfgOrLab ? "text-danger" : "")"
                                                for="LabourSwitch">
                                            <i class="bi bi-people-fill me-1"></i> Labour
                                        </label>
                                    </div>
                                </div>
                                <ValidationMessage For="@(() => MfgQuoteVM.MfgOrLab)" />
                            </div>
                        </div>

                        <!-- Correspondence Status -->
                        <div class="col-12 col-md-6 d-flex justify-content-end align-items-center">
                            @if (MfgQuoteVM.QuoteId > 0 && !string.IsNullOrWhiteSpace(MfgQuoteVM.QuoteNo))
                            {
                                <CorrespondenceStatus 
                                    ReferenceType="Manufacturing-Quotation"
                                    ReferenceId="@MfgQuoteVM.QuoteId"
                                    ReferenceTypeName="@MfgQuoteVM.QuoteNo" />
                            }
                        </div>
                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Customer Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Customer")'>
                                        <i class="bi bi-person-add me-1"></i> Add Customer
                                    </button>
                                </div>

                                <div class="card-body">
                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="CustomerVM"
                                                                 Value="SelectedCustomer"
                                                                 ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                                 ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                                 SearchFunc="SearchCustomers"
                                                                 Dense="true"
                                                                 Variant="Variant.Outlined"
                                                                 Placeholder="Search Customer"
                                                                 Title="Search atleast 3 letters in Customer"
                                                                 Class="w-100 autocomplete-sm"
                                                                 MaxItems="50"
                                                                 Clearable="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 Required="true"
                                                                 AvoidSubmit="true" 
                                                                 Disabled="@IsSomeItemsTransMade"/>
                                        </div>
                                    </div>

                                    <!-- Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1" readonly>@MfgQuoteVM?.CustAddress</textarea>
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Phone No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@MfgQuoteVM?.ContactNo" readonly />
                                        </div>
                                    </div>

                                    <!-- GSTIN -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GSTIN</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@MfgQuoteVM?.GSTNo" readonly />
                                        </div>
                                    </div>

                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                             <select class="form-select form-select-sm rounded-3 w-100"
                                                        @bind="@MfgQuoteVM.KindOfAttention">
                                                    <option disabled value="">Select Contact Person</option>
                                                    @foreach (var cp in contactPersons)
                                                    {
                                                        <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                    }
                                            </select>
                                            <ValidationMessage For="@(() => MfgQuoteVM.KindOfAttention)" />
                                        </div>
                                    </div>

                                    <!-- Shipping Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Shipping Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="form-check form-switch d-flex align-items-center">
                                                <input class="form-check-input" type="checkbox" id="SameAsShipping"
                                                       checked="@MfgQuoteVM.IsSameAsShipping"
                                                       @onchange="OnShippingChange" />
                                                <label class="form-check-label ms-2 fw-semibold"
                                                       for="SameAsShipping">Same as Shipping</label>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!MfgQuoteVM.IsSameAsShipping)
                                    {
                                        <!-- Shipping To -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Shipping To</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select value="@MfgQuoteVM.ShipAddrsId"
                                                        class="form-select form-select-sm rounded-3 w-100"
                                                        @onchange="OnConsigneeChangedAsync">
                                                    <option value="">Select Shipping Address</option>
                                                    @foreach (var consine in consineeAddress)
                                                    {
                                                        <option value="@consine.AltCustId">@consine.AltCustName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        @if (MfgQuoteVM.ShipAddrsId > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Address</small>
                                                </label>
                                                <div class="col-12 col-lg-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@MfgQuoteVM.ShippingAddress" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Contact No</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@MfgQuoteVM.ShippingContactNo" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>GSTIN</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@MfgQuoteVM.ShippingGstin" readonly />
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- =================== Quotation Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Quotation Details</span>

                                    @if (MfgQuoteVM.QuoteId > 0 && (CanCreate || CanEdit))
                                    {
                                        <div class="d-flex gap-2">

                                            @if (MfgQuoteVM.MfgQuoteSubVM == null ||
                                                        !MfgQuoteVM.MfgQuoteSubVM.Any(x => x.ItemCancel))
                                            {
                                                <!-- Cancel / Revert -->
                                                <button type="button"
                                                class="btn btn-sm rounded-3 @(MfgQuoteVM.IsCancel ? "btn-success" : "btn-danger")"
                                                @onclick="Cancel"
                                                disabled ="@MfgQuoteVM.ShortClose">

                                                    @if (!MfgQuoteVM.IsCancel)
                                                    {
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        <span>Cancel</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                        <span>Revert</span>
                                                    }
                                                </button>
                                            }
                                            <!-- Short Closed / Re-Open -->
                                            <button type="button"
                                                class="btn btn-sm rounded-3 @(MfgQuoteVM.ShortClose ? "btn-success" : "btn-warning")"
                                                @onclick="() => AskToShortCloseAsync(MfgQuoteVM)"
                                                disabled="@MfgQuoteVM.IsCancel">

                                                @if (!MfgQuoteVM.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Closed</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>
                                        </div>
                                    }
                                </div>


                                <div class="card-body">

                                    <!-- Quotation No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Quotation No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Prefix"
                                                            maxlength="10"
                                                            @bind-Value="@MfgQuoteVM.Prefix"
                                                            style="flex:0 0 70px;" />

                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Quotation No."
                                                            maxlength="30"
                                                            @bind-Value="@MfgQuoteVM.QuoteNo" 
                                                            readonly />

                                                <!-- Revision Number -->
                                                @if (MfgQuoteVM.RevisionQuoteNo > 0)
                                                {
                                                    <span class="input-group-text text-dark"
                                                          style="min-width: 70px; text-align: center;">
                                                        <small>@($"R{MfgQuoteVM.RevisionQuoteNo}")</small>
                                                    </span>
                                                }


                                                <span class="input-group-text rounded-3">@MfgQuoteVM.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => MfgQuoteVM.Prefix)" />
                                            <ValidationMessage For="@(() => MfgQuoteVM.QuoteNo)" />
                                        </div>
                                    </div>

                                    <!-- Quotation Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Quotation Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                        @bind-Value="@MfgQuoteVM.QuoteDate" />
                                            <ValidationMessage For="@(() => MfgQuoteVM.QuoteDate)" />
                                        </div>
                                    </div>

                                     

                                     <!-- Reference Enquiry -->
                                    @if (enqPendingCount > 0 && MfgQuoteVM != null && !MfgQuoteVM.IsCancel && !MfgQuoteVM.ShortClose)
                                    {

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. Enquiry</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowEnquiryDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Enquiry Details
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    
                                    <!-- Currency -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Currency</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value="@MfgQuoteVM.CurrId"
                                                    @onchange="OnCurrencyChanged"
                                                    disabled>
                                                @foreach (var currency in Currencies)
                                                {
                                                    <option value="@currency.CurrId">@currency.CurrName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Payment Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Payment Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="MfgQuoteVM.PayTerms"></textarea>
                                            <ValidationMessage For="@(() => MfgQuoteVM.PayTerms)" />
                                        </div>
                                    </div>

                                    <!-- Delivery Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Delivery Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="MfgQuoteVM.DeliveryTems"></textarea>
                                            <ValidationMessage For="@(() => MfgQuoteVM.DeliveryTems)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="MfgQuoteVM.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => MfgQuoteVM.MainRemark)" />
                                        </div>
                                    </div>

                                    <!-- Cancel Remarks -->
                                    @if(MfgQuoteVM.IsCancel)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="MfgQuoteVM.CancelReason"
                                                            readonly></textarea>
                                                <ValidationMessage For="@(() => MfgQuoteVM.CancelReason)" />
                                            </div>
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Date</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="date" class="form-control form-control-sm rounded-3 w-100"
                                                            @bind="MfgQuoteVM.CancelDate"
                                                            readonly></input>
                                                <ValidationMessage For="@(() => MfgQuoteVM.CancelDate)" />
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <!-- Discount Toggle -->
                                        <div class="d-flex align-items-center">
                                            <label class="me-2 mb-0"><small>Discount : </small></label>
                                            <div class="btn-group btn-group-sm rounded-pill border" role="group" aria-label="Toggle Discount Rs and %">
                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountToggleRs" 
                                                        @onchange='() => SetDiscountMode(true)' 
                                                        checked="@MfgQuoteVM.IsItemWiseDiscAmtOrPerReq" />
                                                <label class="btn btn-outline-primary rounded-start-pill" for="discountToggleRs">@MfgQuoteVM.Symbol</label>

                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountTogglePercent" 
                                                        @onchange='() => SetDiscountMode(false)' 
                                                        checked="@(!MfgQuoteVM.IsItemWiseDiscAmtOrPerReq)" />
                                                <label class="btn btn-outline-primary rounded-end-pill" for="discountTogglePercent">%</label>
                                            </div>
                                        </div>

                                        <!-- Add Item Button -->
                                        <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                            <i class="bi bi-plus-circle me-1"></i> Create New Item
                                        </button>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:70px;">Ref. No</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:70px;">HSN</th>
                                                    <th style="width:60px;">UOM</th>
                                                    @if (IsLabourCost)
                                                    {
                                                        <th style="width:100px;">Labour Cost</th>

                                                    }

                                                    <th style="width:120px;">Qty</th>
                                                    <th style="width:120px;">Price</th>
                                                    <th style="width:130px;">Gross Amount</th>

                                                    @if (!MfgQuoteVM.IsItemWiseDiscAmtOrPerReq)
                                                    {
                                                        <th style="width:110px;">Disc %</th>
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }

                                                    @if (SelectedCustomer?.TaxValidate == false)
                                                    {
                                                        @if (SelectedCustomer?.BusiType == "Local")
                                                        {
                                                            <th style="width:110px;">CGST %</th>
                                                            <th style="width:110px;">SGST %</th>
                                                        }
                                                        else if(SelectedCustomer?.BusiType == "InterState")
                                                        {
                                                            <th style="width:110px;">IGST %</th>
                                                        }
                                                    }

                                                    <th style="width:130px;">Basic Amount</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:110px;">Ref Enq No.</th>
                                                    <th style="width:110px;">Ref Enq Date</th>
                                                    <th style="width:150px;">Cost-Center</th>
                                                    @if (!MfgQuoteVM.IsCancel && (QuoteId.HasValue || QuoteId > 0))
                                                    {
                                                        <th style="width:130px;">Item Cancel</th>
                                                        <th style="width:160px;">Cancel Reason</th>
                                                    }
                                                    @if (!MfgQuoteVM.IsCancel && !MfgQuoteVM.ShortClose)
                                                    {
                                                        <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                    }
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">

                                                @if (MfgQuoteVM.MfgQuoteSubVM != null && MfgQuoteVM.MfgQuoteSubVM.Any())
                                                {
                                                    @foreach (var subitem in MfgQuoteVM.MfgQuoteSubVM)
                                                    {
                                                        <tr @key="subitem" class="@(subitem.ItemCancel ? "table-danger text-danger fw-bold" : "")">
                                                            <td>@subitem.SlNo</td>

                                                            <!-- Ref No -->
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" placeholder="RFQ"  title="Enter RFQ" @bind="subitem.RFQ" />
                                                                    <ValidationMessage For="@(() => subitem.RFQ)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.RFQ
                                                                }
                                                            </td>

                                                            <!-- Item Code + Attachments -->
                                                            <td>
                                                                <div class="row g-1 align-items-center">
                                                                    <div class="col-10">
                                                                        @if (subitem.IsEditable  && subitem.CanEditItem)
                                                                        {
                                                                            <MudAutocomplete T="ItemVM"
                                                                                                Value="subitem.SelectedItem"
                                                                                                ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                                ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                                SearchFunc="SearchItems"
                                                                                                Dense="true"
                                                                                                Variant="Variant.Outlined"
                                                                                                Placeholder="Search Item Code"
                                                                                                Title="Search Atleast 3 Letters in Item-Code"
                                                                                                Class="w-100 autocomplete-sm"
                                                                                                MaxItems="50" />
                                                                            <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                        }
                                                                        else
                                                                        {
                                                                            @subitem.ItemCode
                                                                        }
                                                                    </div>
                                                                    <div class="col-2 text-center">
                                                                        @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                                && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                            Size="Size.Small"
                                                                                            Color="Color.Primary"
                                                                                            OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                            Edge="Edge.End"
                                                                                            Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </td>

                                                            <td>@subitem.ItemName</td>
                                                            <td>@subitem.HsnCode</td>
                                                            <td>@subitem.MeasureUnit</td>
                                                            @if (IsLabourCost)
                                                            {
                                                                <td>@subitem.LabourCost</td>
                                                            }


                                                            <!-- Qty -->
                                                            <td>

                                                                @if (subitem.IsEditable)
                                                                {
                                                                      <input type="number"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="Qty"
                                                                               step="any"
                                                                               title="Enter Quantity"
                                                                               @bind="subitem.Qty"
                                                                               @bind:event="oninput"
                                                                               @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                    <ValidationMessage For="@(() => subitem.Qty)" />
                                                                }
                                                                else
                                                                {
                                                                    <span>@subitem.Qty</span>
                                                                }
                                                            </td>

                                                            <!-- Unit Price -->
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" placeholder="Price" title="Enter Unit Price"
                                                                            step="any"
                                                                            @bind="subitem.UnitPrice" @bind:event="oninput"
                                                                            @bind:after='() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)' />
                                                                    <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.UnitPrice)
                                                                }
                                                            </td>

                                                            <!-- Line Gross -->
                                                            <td>@FormatDecimal(subitem.LineGross)</td>

                                                            <!-- Discount -->
                                                            @if (!MfgQuoteVM.IsItemWiseDiscAmtOrPerReq)
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <input type="number" class="form-control form-control-sm" placeholder="Disc %" title="Enter Discount %"
                                                                                step="any"
                                                                                @bind="subitem.LineDiscountPercent" @bind:event="oninput"
                                                                                @bind:after='() => OnLineDiscountPercentChanged(subitem)' />
                                                                        <ValidationMessage For="@(() => subitem.LineDiscountPercent)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineDiscountPercent)
                                                                    }
                                                                </td>
                                                                <td>@FormatDecimal(subitem.LineDiscountAmount)</td>
                                                            }
                                                            else
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <input type="number" class="form-control form-control-sm" placeholder="Disc Amt" title="Enter Discount Amount"
                                                                                step="any"
                                                                                @bind="subitem.LineDiscountAmount" @bind:event="oninput"
                                                                                @bind:after='() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)' />
                                                                        <ValidationMessage For="@(() => subitem.LineDiscountAmount)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineDiscountAmount)
                                                                    }
                                                                </td>
                                                            }

                                                            <!-- Taxes -->
                                                            @if (SelectedCustomer?.TaxValidate == false)
                                                            {
                                                                @if (SelectedCustomer?.BusiType == "Local")
                                                                {
                                                                    <td>
                                                                        @if (subitem.IsEditable)
                                                                        {
                                                                            <select class="form-select form-select-sm"
                                                                                    value="@subitem.LineCGSTRate"
                                                                                    @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                                <option value="">-- CGST % --</option>

                                                                                @foreach (var rate in CommonConstants.GSTRates)
                                                                                {
                                                                                    <option value="@rate">@rate</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        else
                                                                        {
                                                                            @FormatDecimal(subitem.LineCGSTRate)
                                                                        }
                                                                    </td>


                                                                    <td>
                                                                        @if (subitem.IsEditable)

                                                                        {
                                                                            <select class="form-select form-select-sm"
                                                                                    value="@subitem.LineSGSTRate"
                                                                                    @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                                <option value="">-- SGST % --</option>

                                                                                @foreach (var rate in CommonConstants.GSTRates)
                                                                                {
                                                                                    <option value="@rate">@rate</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        else
                                                                        {
                                                                            @FormatDecimal(subitem.LineSGSTRate)
                                                                        }
                                                                    </td>
                                                                }
                                                                else if (SelectedCustomer?.BusiType == "InterState")
                                                                {
                                                                    <td>
                                                                        @if (subitem.IsEditable)
                                                                        {
                                                                            <select class="form-select form-select-sm"
                                                                                    @bind="subitem.LineIGSTRate"
                                                                                    @bind:after="() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)">
                                                                                <option value="0">-- IGST % --</option>
                                                                                @foreach (var rate in CommonConstants.IGSTRates)
                                                                                {
                                                                                    <option value="@((decimal)rate)">@rate</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        else
                                                                        {
                                                                            @FormatDecimal(subitem.LineIGSTRate)
                                                                        }
                                                                    </td>
                                                                }
                                                            }

                                                            <!-- Basic Amount -->
                                                            <td>@FormatDecimal(subitem.LineBasicAmount)</td>

                                                            <!-- Remarks -->
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputText @bind-Value="subitem.Remarks" class="form-control form-control-sm" placeholder="Enter Remarks" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.Remarks
                                                                }
                                                            </td>

                                                            <!-- Ref Enquiry -->
                                                            <td>@subitem.RefEnqNo</td>
                                                            <td>@subitem.RefEnqDate?.ToString("dd/MM/yyyy")</td>

                                                            <!-- Cost Center -->
                                                            <td>
                                                                @if (subitem.IsEditable && (subitem.RefEnqSubId == 0 || subitem.RefEnqSubId == null) && subitem.Qty == subitem.BalQty)
                                                                {
                                                                    <select class="form-select form-select-sm" 
                                                                        value="@subitem.CostId"
                                                                        @onchange="(e => OnCostCenterChanged(e, subitem))">
                                                                        <option value="">select CostCentre</option>
                                                                        @foreach (var cost in CostCenterVMs.Where(c =>
                                                                            !MfgQuoteVM.MfgQuoteSubVM.Any(r => r != subitem && r.CostId == c.Id)))
                                                                        {
                                                                            <option value="@cost.Id">@cost.ProjectNo</option>
                                                                        }
                                                                    </select>
                                                                    <ValidationMessage For="@(() => subitem.CostId)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.ProjectNo
                                                                }
                                                            </td>

                                                            @if (!MfgQuoteVM.IsCancel  && (QuoteId.HasValue || QuoteId > 0))
                                                            {
                                                                <td class="text-center align-middle">
                                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                                        <InputCheckbox @bind-Value="subitem.ItemCancel"
                                                                        @bind-Value:event="onchange"
                                                                        ValueChanged="@(async (value) => await OnItemCancelChanged(subitem))"
                                                                        class="form-check-input border border-2 shadow-lg 
                                                                                            focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                                    </div>
                                                                    <ValidationMessage For="@(() => subitem.ItemCancel)"
                                                                    class="text-danger fw-semibold small mt-2 d-block" />
                                                                </td>

                                                                <td>
                                                                    @subitem.ItemCancelReason 
                                                                </td>
                                                            }

                                                            @if (!MfgQuoteVM.IsCancel && !MfgQuoteVM.ShortClose)
                                                            {
                                                                <!-- Action Buttons -->
                                                                <td class="freeze-last-col text-end align-middle">
                                                                    <div class="d-inline-flex gap-1 justify-content-end w-100">

                                                                        @if (subitem.IsEditable)
                                                                        {
                                                                            <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                                    @onclick="async () => await SaveRow(subitem)"
                                                                                    disabled="@subitem.ItemCancel">
                                                                                <i class="bi bi-check-lg"></i>
                                                                            </button>

                                                                            <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                                    @onclick="async () => await CancelEdit(subitem, MfgQuoteVM)"
                                                                                    disabled="@subitem.ItemCancel">
                                                                                <i class="bi bi-x-lg"></i>
                                                                            </button>
                                                                        }
                                                                        else
                                                                        {
                                                                            <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                                    @onclick="async () => await EditRowAsync(subitem)"
                                                                                    disabled="@subitem.ItemCancel">
                                                                                <i class="bi bi-pencil"></i>
                                                                            </button>

                                                                            <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                                    @onclick="async () => await RemoveRow(subitem)"
                                                                                    disabled="@subitem.ItemCancel">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        }

                                                                    </div>
                                                                </td>

                                                            }
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="22" style="height:150px;" class="text-center align-middle text-muted fs-6 fw-semibold">
                                                            <div class="d-flex justify-content-center align-items-center" style="min-height:100px;">
                                                                <i class="bi bi-info-circle me-2 text-secondary"></i>
                                                                No items to display
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (MfgQuoteVM.MfgQuoteSubVM?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        <td colspan="6" class="text-end fw-bold">Totals:</td>
                                                        <td>@MfgQuoteVM.TotalQty</td>
                                                        <td>Avg: @FormatDecimal(MfgQuoteVM.AvgUnitPrice)</td>
                                                        <td>@FormatDecimal(MfgQuoteVM.TotalLineGross)</td>

                                                        @if (!MfgQuoteVM.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td></td>
                                                            <td>@FormatDecimal(MfgQuoteVM.TotalLineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@FormatDecimal(MfgQuoteVM.TotalLineDiscountAmount)</td>
                                                        }

                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if(SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td></td>
                                                                <td></td>

                                                            }
                                                            else if(SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td></td>
                                                            }
                                                        }
                                                        <td>@FormatDecimal(MfgQuoteVM.TotalLineBasicAmount)</td>
                                                        <td colspan="7"></td>
                                                    </tr>
                                                </tfoot>
                                            }
                                        </table>
                                    </div>

                                    @if (!MfgQuoteVM.IsCancel && !MfgQuoteVM.ShortClose)
                                    {
                                        <div class="mt-2 text-start">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- ===================Other Details Terms and Conditions ===================-->
                        <div class="col-12 col-lg-6 mb-3">
                            <div class="card shadow-sm rounded-4 border-0">
                                <div class="card-body">
                                    <div class="row g-3">

                                        <!-- ================= Due Date ================= -->
                                        <div class="col-12 col-md-7">
                                            <label class="form-label fw-semibold text-dark">
                                                <i class="bi bi-calendar3 me-1 text-primary"></i> Due Date
                                            </label>
                                            <input type="date" class="form-control form-control-sm rounded-3 shadow-sm"
                                                   @bind="MfgQuoteVM.DueDate" />
                                            <ValidationMessage For="@(() => MfgQuoteVM.DueDate)" />
                                        </div>

                                        <!-- ================= Terms & Conditions ================= -->
                                        <div class="row g-2 align-items-end">

                                            <!-- ================= Terms & Conditions ================= -->
                                            <div class="col-12 col-md-7">
                                                <label class="form-label fw-semibold text-dark">
                                                    <i class="bi bi-file-text me-1 text-primary"></i> Terms & Conditions
                                                </label>

                                                <select class="form-select form-select-sm rounded-3 shadow-sm h-100"
                                                        value="@MfgQuoteVM.TermsId"
                                                        @onchange="OnTermsChanged">
                                                    <option value="">-- Select Terms --</option>
                                                    @if (TermsList?.Any() == true)
                                                    {
                                                        @foreach (var term in TermsList)
                                                        {
                                                            <option value="@term.Id">@term.Title</option>
                                                        }
                                                    }
                                                </select>

                                                <ValidationMessage For="@(() => MfgQuoteVM.TermsId)" />
                                            </div>

                                            <!-- ================= Create New Terms ================= -->
                                            <div class="col-12 col-md-5">
                                                <label class="form-label fw-semibold text-dark invisible">
                                                    Placeholder
                                                </label>

                                                <button type="button"
                                                        class="btn btn-sm btn-success rounded-3 shadow-sm w-100 h-100"
                                                        @onclick='() => OpenModal("Terms")'>
                                                    <i class="bi bi-plus-circle me-1"></i> New Terms
                                                </button>
                                            </div>

                                        </div>


                                        <!-- ================= Selected Terms Display ================= -->

                                        @if (!string.IsNullOrEmpty(MfgQuoteVM.Details))
                                        {
                                            <div class="col-12">
                                                <div class="p-3 border rounded-3 bg-light shadow-sm">
                                                    <h6 class="fw-bold text-primary mb-1">Details</h6>
                                                    <p class="mb-0 text-muted" style="white-space: pre-line;">
                                                        @MfgQuoteVM.Details
                                                    </p>
                                                </div>
                                            </div>
                                        }
                                        
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- =================== Tax Details Section =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm rounded-4 border-0 p-3">

                                <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Tax & Charges
                                </h6>

                                <!-- Total Gross -->
                                <div class="row mb-2 gx-3">
                                    <label for="TotalGross" class="col-5 col-md-4 col-form-label text-dark">
                                        <small>Total Gross</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input id="TotalGross"
                                               class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               value="@FormatDecimal(MfgQuoteVM.TotalGrossAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Discount -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Discount</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="discountToggle" id="discountRs"
                                                   @onchange="() => SetDiscountType(true)"
                                                   checked="@MfgQuoteVM.DiscAmtOrPer"
                                                   disabled="@(MfgQuoteVM.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountRs">
                                                <small>@MfgQuoteVM.Symbol</small>
                                            </label>

                                            <input type="radio" class="btn-check" name="discountToggle" id="discountPercent"
                                                   @onchange="() => SetDiscountType(false)"
                                                   checked="@(!MfgQuoteVM.DiscAmtOrPer)"
                                                   disabled="@(MfgQuoteVM.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountPercent"><small>%</small></label>
                                        </div>
                                    </div>

                                    <div class="col-3 col-md-5">
                                        @if (MfgQuoteVM.DiscAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   step="any"
                                                   @bind="MfgQuoteVM.DiscountAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)'
                                                   disabled="@(MfgQuoteVM.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => MfgQuoteVM.DiscountAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   step="any"
                                                   @bind="MfgQuoteVM.DiscountPercent"
                                                   @bind:after="OnDiscountPercentChanged"
                                                   disabled="@(MfgQuoteVM.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => MfgQuoteVM.DiscountPercent)" />
                                            <small class="text-muted d-block text-end">
                                                Amt: @FormatDecimal(MfgQuoteVM.DiscountAmount)
                                            </small>
                                        }
                                    </div>

                                </div>

                                <!-- SubTotal -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>SubTotal</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number" 
                                               value="@FormatDecimal(MfgQuoteVM.TotalBasicAmount)" 
                                               readonly />
                                    </div>
                                </div>

                                <!-- Freight Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Freight Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="MfgQuoteVM.FreightCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)' />
                                        <ValidationMessage For="@(() => MfgQuoteVM.FreightCharges)" />
                                    </div>
                                </div>

                                <!-- P & F Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>P & F Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="packingToggle" id="packingToggleRs"
                                                   @onchange="() => SetPAndFType(true)" checked="@MfgQuoteVM.PackingAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="packingToggleRs"><small>@MfgQuoteVM.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="packingToggle" id="packingTogglePercent"
                                                   @onchange="() => SetPAndFType(false)" checked="@(!MfgQuoteVM.PackingAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="packingTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (MfgQuoteVM.PackingAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="MfgQuoteVM.PackingCharges"
                                                   step="any"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)' />
                                            <ValidationMessage For="@(() => MfgQuoteVM.PackingCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="MfgQuoteVM.PackingPercent"
                                                   step="any"
                                                   @bind:after="() => OnPandFPercentChanged()" />
                                            <ValidationMessage For="@(() => MfgQuoteVM.PackingPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(MfgQuoteVM.PackingCharges) </small>
                                        }
                                    </div>
                                </div>

                                <!-- Insurance Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Insurance Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceToggleRs"
                                                   @onchange="() => SetInsuranceType(true)" checked="@MfgQuoteVM.InsuranceAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="insuranceToggleRs"><small>@MfgQuoteVM.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceTogglePercent"
                                                   @onchange="() => SetInsuranceType(false)" checked="@(!MfgQuoteVM.InsuranceAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="insuranceTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (MfgQuoteVM.InsuranceAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="MfgQuoteVM.InsuranceCharges"
                                                   step="any"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)' />
                                            <ValidationMessage For="@(() => MfgQuoteVM.InsuranceCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="MfgQuoteVM.InsurancePercent"
                                                   step="any"
                                                   @bind:after="() => OnInsurancePercentChanged()" />
                                            <ValidationMessage For="@(() => MfgQuoteVM.InsurancePercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(MfgQuoteVM.InsuranceCharges)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Total Taxable -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Total Taxable</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               value="@FormatDecimal(MfgQuoteVM.TotalTaxable)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Taxes (CGST/SGST/IGST) -->
                                @if (SelectedCustomer?.TaxValidate == false)
                                {
                                    <div class="mb-2">
                                        @if (SelectedCustomer?.BusiType == "Local")
                                        {
                                            <!-- CGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>CGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!MfgQuoteVM.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="MfgQuoteVM.CGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(MfgQuoteVM.CGstRate)">
                                                            <option value="0">-- Select CGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => MfgQuoteVM.CGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(MfgQuoteVM.TotalCGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>

                                            <!-- SGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>SGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!MfgQuoteVM.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="MfgQuoteVM.SGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(MfgQuoteVM.SGstRate)">
                                                            <option value="0">-- Select SGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => MfgQuoteVM.SGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(MfgQuoteVM.TotalSGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                        else if (SelectedCustomer?.BusiType == "InterState")
                                        {
                                            <!-- IGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>IGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!MfgQuoteVM.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="MfgQuoteVM.IGstRate"
                                                                @bind:after="() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)"
                                                                disabled="@(SelectedCustomer?.TaxValidate == true)">
                                                            <option value="0">-- Select IGST % --</option>
                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => MfgQuoteVM.IGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(MfgQuoteVM.TotalIGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- TCS Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>TCS Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsToggleRs"
                                                   @onchange="() => SetTCSType(true)" checked="@MfgQuoteVM.TCSAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="tcsToggleRs"><small>@MfgQuoteVM.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsTogglePercent"
                                                   @onchange="() => SetTCSType(false)" checked="@(!MfgQuoteVM.TCSAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="tcsTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (MfgQuoteVM.TCSAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="MfgQuoteVM.TCSAmount"
                                                   step="any"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)' />
                                            <ValidationMessage For="@(() => MfgQuoteVM.TCSAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="MfgQuoteVM.TCSPercent"
                                                   @bind:after="() => OnTCSPercentChanged()" />
                                            <ValidationMessage For="@(() => MfgQuoteVM.TCSPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(MfgQuoteVM.TCSAmount)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Other Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Other Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="MfgQuoteVM.OtherCharges"
                                               step="any"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)' />
                                        <ValidationMessage For="@(() => MfgQuoteVM.OtherCharges)" />
                                    </div>
                                </div>

                                <!-- Round Off -->
                                <div class="row mb-2 gx-2 align-items-center">
                                    <div class="col-5 col-md-4 d-flex align-items-center">
                                        <small class="me-2 text-dark">Round Off</small>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="roundOffSwitch"
                                                   @bind="MfgQuoteVM.IsRoundOffEnabled"
                                                   @bind:after="() => _calculationService.UpdateTotalsAsync(MfgQuoteVM)" >
                                            <label class="form-check-label" for="roundOffSwitch"></label>
                                        </div>
                                    </div>
                                    <div class="col-7 col-md-8">
                                       <input class="form-control form-control-sm rounded-3 text-end"
                                               value="@FormatDecimal(MfgQuoteVM.RoundOff)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Grand Total -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label fw-bold text-dark">
                                        <small>Grand Total</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                               value="@FormatDecimal(MfgQuoteVM.GrandTotal)"
                                               readonly />
                                        @if (MfgQuoteVM.CurrId > 1)
                                        {
                                            <div class="mt-1 text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @MfgQuoteVM.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((MfgQuoteVM.GrandTotal * MfgQuoteVM.TodayVal).ToString("0.00"))
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Amount in Words -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Amount in Words</small></label>
                                    <div class="col-7 col-md-8 pt-1">
                                        @if (MfgQuoteVM.CurrId > 1)
                                        {
                                            <small class="fw-bold text-success d-block">
                                                Converted Value in Rs: @FormatDecimal(MfgQuoteVM.GrandTotal * MfgQuoteVM.TodayVal)
                                            </small>
                                        }
                                        else
                                        {
                                            <strong>@NumberToWordsHelper.ConvertNumberToWords(MfgQuoteVM.GrandTotal)</strong>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            @if(!MfgQuoteVM.IsCancel && !MfgQuoteVM.ShortClose)
                            {
                                 <div class="col-6 col-md-3 mt-3">
                                    <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                        <i class="bi bi-floppy2-fill me-1"></i> @(MfgQuoteVM.QuoteId > 0 ? "Update" : "Create")
                                    </button>
                                </div>

                                @if (CanRevisePO)
                                {
                                    <div class="col-6 col-md-3 mt-3">
                                        <button type="button" class="btn btn-success w-100 rounded-3"
                                                disabled="@isProcessing"
                                                @onclick="Revise">
                                            <i class="bi bi-check2-circle me-1"></i> Revise
                                        </button>
                                    </div>
                                }
                            }
                        }

                        <div class="col-6 col-md-3 mt-3">
                            <SmartBackButton Url="/mfgQuoteList" />
                        </div>

                        @if (QuoteId == 0 || QuoteId == null)
                        {
                            <!-- Download Template -->
                            <div class="col-12 col-md-3">
                                <button type="button"
                                class="btn btn-primary w-100 rounded-3 d-flex align-items-center justify-content-center"
                                @onclick="DownloadTemplate" disabled="@isProcessing">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Preparing Template...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-download me-2"></i>
                                        <span>Download Template</span>
                                    }
                                </button>
                            </div>

                            <!-- Upload Excel -->
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 w-100" @onclick='() => OpenModal("ExcelUpload")'>
                                    <i class="bi bi-upload me-1"></i> Import
                                </button>
                            </div>
                        }


                        @if (CanCreate || CanEdit && QuoteId > 0 && (!Autharization || (Autharization && MfgQuoteVM.IsAuthorized)))
                        {
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                    <i class="bi bi-printer me-1"></i>Print
                                </button>
                            </div>
                        }
                        else if (Autharization && !MfgQuoteVM.IsAuthorized)
                        {
                            <button class="btn btn-danger" disabled title="Authorization required to generate PDF">
                                <i class="bi bi-file-earmark-pdf"></i> Authorization Required
                            </button>
                        }

                    </div>
                   
                </EditForm>
            </div>
        </div>
    </div>
} 


@code {

    #region Parameters & Properties

    protected override string ScreenName => "Manufacturing Quotation";

    [Parameter] public int? QuoteId { get; set; }
    [Parameter] public int CustId { get; set; }

    private bool isProcessing = true;
    private MfgQuoteVM MfgQuoteVM { get; set; } = new();
    private MfgQuoteSubVM? rowToDelete;
    private MfgQuoteSubVM? rowToCancel;

    private int enqPendingCount = 0;
    private CustomerVM? SelectedCustomer;
    private List<ContactPerson> contactPersons = new();
    private List<CustomerIndirect> consineeAddress = new();
    private List<Currency> Currencies = new();
    private List<CostCenterVM> CostCenterVMs = new();

    private List<TermsAndConditions> TermsList = new();
    private bool IsSomeItemsTransMade { get; set; } = false;

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private bool IsEnquiryModalVisible = false;
    private List<Dictionary<string, object>>? EnquiryData;
    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private List<string> EnquiryColumns = new() { "Ref EnqSub Id","Enquiry No", "Enquiry Date","Item Id", "Item Code", "Item Name","UOM", "Qty","Bal Qty.","Cost-Center Id","Project No","Customer" };
    private List<string> EnquiryFields = new() { "RefEnqSubId", "EnquiryNo", "EnquiryDate", "ItemId", "ItemCode", "ItemName", "UOM", "Qty", "BalQty", "CostCenterId", "ProjectNo", "Customer" };
    private List<string> EnquiryHiddenColumns = new() { "Ref EnqSub Id", "Item Id", "Cost-Center Id" };

    private List<PageHeader.BreadcrumbItem> QuoteFormBreadcrumbs = new()
    {
        new() { Text = "Sales" },
        new() { Text = "Quotation-OutWard", IsLast = true }
    };

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private int DecimalPlaces { get; set; } = 2;

    private bool IsLabourCost { get; set; } = false;

    private string? pdfBase64;
    public bool Autharization = false;

    private bool CanRevisePO =>MfgQuoteVM.QuoteId > 0 && !MfgQuoteVM.IsCancel && !MfgQuoteVM.ShortClose && !IsSomeItemsTransMade &&
        !MfgQuoteVM.MfgQuoteSubVM.Any(x => x.ItemCancel);

    #endregion


    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            Currencies = await mfgQuotationService.GetCurrenciesAsync();
            TermsList = await mfgQuotationService.GetTermsAsync();
            DecimalPlaces = await mfgQuotationService.GetDecimalPlacesAsync();
            IsLabourCost = await _CostingService.IsLabourChargesDisplayEnabledAsync();

            if (QuoteId.HasValue)
            {
                await LoadExistingQuote(QuoteId.Value);
            }
            else if (CustId > 0)
            {
                await InitializeNewQuote(CustId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingQuote(int quoteId)
    {
        try
        {
            MfgQuoteVM = await mfgQuotationService.GetQuotationByQuoteIdAsync(quoteId);

            if (MfgQuoteVM == null)
            {
                await _js.ToastrWarning("Quotation not found.");
                return;
            }

            SelectedCustomer = await mfgQuotationService.GetCustomerByIdAsync(MfgQuoteVM.CustId);
            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

            if (MfgQuoteVM.CurrId > 0)
            {
                Autharization = (await userAuthority.GetAllWithUserAsync()).Any(x => x.IsMfgQuote == true);
                await ApplyCurrencyChange(MfgQuoteVM.CurrId);
            }


            foreach (var quoteSub in MfgQuoteVM.MfgQuoteSubVM.Where(q => q.ItemId > 0))
            {
                attachmentCounts[quoteSub.ItemId.Value] =
                    await mfgQuotationService.GetCorrespondenceAttachmentsCountAsync(quoteSub.ItemId.Value, "Item");

                if (IsLabourCost)
                {
                    if (quoteSub.UnitPrice < quoteSub.LabourCost)
                    {
                        _js.ToastrWarning(
                            $"Unit Price ({quoteSub.UnitPrice:0.00}) Is less than Labour Cost ({quoteSub.LabourCost:0.00})."
                        );
                    }
                    else if (quoteSub.UnitPrice > quoteSub.LabourCost)
                    {
                        _js.ToastrWarning(
                        $"Unit Price ({quoteSub.UnitPrice:0.00}) Is  Greater than than Labour Cost ({quoteSub.LabourCost:0.00})."
                    );

                    }

                }
            }

            IsSomeItemsTransMade = await CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing quotation.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingQuote failed for QuoteId: {quoteId}");
        }
    }


    private async Task<bool> CheckIsTransMade()
    {
        try
        {
            if (!QuoteId.HasValue)
                return false;

            return await mfgQuotationService.IsQuoteTransactionsMatchedAsync(QuoteId.Value, MfgQuoteVM);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to check transaction exists.");
            await LoggingService.LogDeveloperError(ex, "[CheckIsTransMade] failed");
            return false;
        }
    }



    private async Task InitializeNewQuote(int custId)
    {
        try
        {
            var customer = await mfgQuotationService.GetCustomerByIdAsync(custId);
            if (customer != null)
                await ApplyCustomerSelectionAsync(customer);

            MfgQuoteVM.Prefix = await mfgQuotationService.GetPrefixFromDb();
            MfgQuoteVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            MfgQuoteVM.QuoteNo = await mfgQuotationService.GetQuotationNumberAsync(MfgQuoteVM.Suffix);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new quotation.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewQuote failed for CustId: {custId}");
        }
    }

    #endregion


    #region Customer data, Currency And Tax  Handlers

    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3) 
            return Enumerable.Empty<CustomerVM>();

        try
        {
            var results = await mfgQuotationService.SearchCustomersAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<CustomerVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<CustomerVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchCustomers failed for value: {value}");
            await _js.ToastrError("Failed to search customers. Please try again.");
            return Enumerable.Empty<CustomerVM>();
        }
    }

    private async Task OnCustomerChanged(CustomerVM? customer)
    {
        try
        {
            await ApplyCustomerSelectionAsync(customer);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error in OnCustomerChanged: {ex}");
            await LoggingService.LogDeveloperError(ex, "Error in OnCustomerChanged");
            await _js.ToastrError("Error while selecting");
            contactPersons.Clear();
            await ResetQuoteDefaults();
        }
    }

    private async Task ApplyCustomerSelectionAsync(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;
            MfgQuoteVM.CustId = customer?.CustId ?? 0;
            MfgQuoteVM.CustName = customer?.CustName;
            MfgQuoteVM.CustAddress = customer?.CustAddr;
            MfgQuoteVM.GSTNo = customer?.GSTNo;
            MfgQuoteVM.ContactNo = customer?.ContactNo;

            if (customer == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                CostCenterVMs.Clear();
                await ResetQuoteDefaults();
                return;
            }

            contactPersons = await mfgQuotationService.GetContactPersonsAsync(customer.CustId);
            consineeAddress = await mfgQuotationService.GetConsigneeAddressesAsync(customer.CustId);

            var usedCostCenters = MfgQuoteVM.MfgQuoteSubVM
                .Where(x => x.CostId.HasValue && (x.RefEnqSubId == null || x.RefEnqSubId == 0))
                .Select(x => x.CostId.Value)
                .ToHashSet();

            CostCenterVMs = await mfgQuotationService.GetCostCenterDetailsByCustId(customer.CustId, usedCostCenters);

            MfgQuoteVM.KindOfAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPersonName : string.Empty;

            // Tax logic
            if (!customer.TaxValidate)
            {
                var lastQuote = await mfgQuotationService.GetLastQuoteAsync(customer.CustId);
                if (lastQuote != null)
                {
                    MfgQuoteVM.CGstRate = lastQuote.CGstRate;
                    MfgQuoteVM.SGstRate = lastQuote.SGstRate;
                    MfgQuoteVM.IGstRate = lastQuote.IGstRate;
                }
                else
                {
                    if (string.Equals(customer.BusiType, "Local", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false )
                    {
                        MfgQuoteVM.CGstRate = CommonConstants.GetGST(9.000m);
                        MfgQuoteVM.SGstRate = CommonConstants.GetGST(9.000m);
                        MfgQuoteVM.IGstRate = CommonConstants.GetIGST(0.000m);
                    }
                    else if (string.Equals(customer.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false )
                    {
                        MfgQuoteVM.CGstRate = CommonConstants.GetGST(0.000m);
                        MfgQuoteVM.SGstRate = CommonConstants.GetGST(0.000m);
                        MfgQuoteVM.IGstRate = CommonConstants.GetIGST(18.000m);
                    }
                }
            }

            MfgQuoteVM.CurrId = (customer.CurrId.HasValue && customer.CurrId > 0) ? customer.CurrId.Value : 1;
            await ApplyCurrencyChange(MfgQuoteVM.CurrId);

            enqPendingCount = await mfgQuotationService.GetPendingEnquiryCountAsync(customer.CustId);

            await _calculationService.UpdateTotalsAsync(MfgQuoteVM);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {customer?.CustId}");
            await _js.ToastrError("Failed to apply customer selection. Please try again.");
        }
    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
            await ApplyCurrencyChange(selectedId);
    }

    private async Task ApplyCurrencyChange(int currencyId)
    {
        var selectedCurrency = await mfgQuotationService.GetCurrencyByIdAsync(currencyId);
        if (selectedCurrency == null) return;

        MfgQuoteVM.CurrName = selectedCurrency.CurrName;
        MfgQuoteVM.Symbol = selectedCurrency.Symbol;
        MfgQuoteVM.CurrId = selectedCurrency.CurrId;

        if (currencyId > 1)
            MfgQuoteVM.TodayVal = await mfgQuotationService.GetLatestCurrencyValueAsync(currencyId) ?? 0m;
    }

    private async Task ResetQuoteDefaults()
    {
        MfgQuoteVM.CGstRate = 0m;
        MfgQuoteVM.SGstRate = 0m;
        MfgQuoteVM.IGstRate = 0m;
    }

    private async Task OnShippingChange(ChangeEventArgs e)
    {
        try
        {
            MfgQuoteVM.IsSameAsShipping = (bool)e.Value;

            if (!MfgQuoteVM.IsSameAsShipping && SelectedCustomer != null)
            {
                consineeAddress = await mfgQuotationService.GetConsigneeAddressesAsync(SelectedCustomer.CustId);
            }
            else
            {
                consineeAddress.Clear();
                ResetShippingDefaults();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                $"Error while toggling shipping address for CustId={SelectedCustomer?.CustId}");
        }
    }

    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                MfgQuoteVM.IsSameAsShipping = true; 
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }
            MfgQuoteVM.IsSameAsShipping = false; 

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltCustId == selectedId);
            if (selectedConsignee == null)
                return;

            MfgQuoteVM.ShipAddrsId = selectedConsignee.AltCustId;
            MfgQuoteVM.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltCustAddr1, selectedConsignee.AltCustAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            MfgQuoteVM.ShippingGstin = selectedConsignee.GSTNo ?? string.Empty;
            MfgQuoteVM.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(MfgQuoteVM);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

    private void ResetShippingDefaults()
    {
        MfgQuoteVM.ShipAddrsId = null;
        MfgQuoteVM.ShippingName = null;
        MfgQuoteVM.ShippingAddress = null;
        MfgQuoteVM.ShippingGstin = null;
        MfgQuoteVM.ShippingContactNo = null;
    }

    #endregion


    #region Item Handlers

    private async Task<IEnumerable<ItemVM>> SearchItems(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        try
        {
            var results = await mfgQuotationService.SearchItemsAsync(value, MfgQuoteVM.QuoteId);
            return results?.Take(50) ?? Enumerable.Empty<ItemVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<ItemVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchItems failed for value: {value}");
            await _js.ToastrError("Failed to search items. Please try again.");
            return Enumerable.Empty<ItemVM>();
        }
    }

    private async Task OnItemChanged(MfgQuoteSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItem = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.HsnCode = item.HSNCode;
                subitem.MeasureUnit = item.MeasureUnit;
                subitem.LabourCost = item.AssemblyPrice;

                if (MfgQuoteVM?.CustId != null && subitem.ItemId.HasValue)
                {
                    var rates = await mfgQuotationService.GetBulkLastUnitPricesAsync(
                        new List<int> { subitem.ItemId.Value },
                        MfgQuoteVM.CustId
                    );

                    if (rates.TryGetValue(subitem.ItemId.Value, out decimal rate))
                    {
                        subitem.UnitPrice = rate;
                    }

                }

                if (subitem.ItemId > 0)
                {
                    var count = await mfgQuotationService.GetCorrespondenceAttachmentsCountAsync(subitem.ItemId.Value, "Item");
                    attachmentCounts[subitem.ItemId.Value] = count;

                    if (IsLabourCost)
                    {
                        if (subitem.UnitPrice < subitem.LabourCost)
                        {
                            _js.ToastrWarning(
                                $"Unit Price ({subitem.UnitPrice:0.00}) Is less than Labour Cost ({subitem.LabourCost:0.00})."
                            );
                        }
                        else if (subitem.UnitPrice > subitem.LabourCost)
                        {
                            _js.ToastrWarning(
                               $"Unit Price ({subitem.UnitPrice:0.00}) Is  Greater than than Labour Cost ({subitem.LabourCost:0.00})."
                           );

                        }

                    }
                }
            }
            else
            {
                subitem.SelectedItem = null;
                subitem.ItemId = null;
                subitem.ItemCode = null;
                subitem.ItemName = null;
                subitem.HsnCode = null;
                subitem.MeasureUnit = null;
                subitem.UnitPrice = null;
            }

            await _calculationService.UpdateTotalsAsync(MfgQuoteVM);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnItemChanged failed for ItemId: {item?.ItemId}");
            await _js.ToastrError("Failed to apply item selection. Please try again.");
