@page "/contractReviewCheckList"

@inherits BaseUserRightsComponent

@inject CurrentUserService currentUserService
@inject ILoggingService LoggingService
@inject IJSRuntime _js
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject IContractReviewService _contractReview

<BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="btn-danger"
         ButtonText="Delete"
         Title="Are you sure you want to delete this Contract Review CheckList?">
</BsModal>

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">

    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch isModelVisible="true" 
            Screen="@ScreenName" Filters="SearchFilters"
            OnClose="CloseModal" OnSearch="ApplySearchFilters" />
    }
</MasterModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Contract Review Check List"
                        TitleIcon="bi bi-list-check"
                        Breadcrumbs="@ContractreviewCheckListBreadcrumbs" />

            <div class="card-body p-4">
                <div class="row g-2 g-md-3 mb-3">

                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible="int.MaxValue"
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                @onchange="OnPageSizeChanged"
                                title="Select number of records per page">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                        <div class="col-12 col-md-2 ms-md-auto text-end">
                            <a href="/contractReviewCheckList/create"
                               class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                               title="Create a new ContractReviewCheckList">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </a>
                        </div>
                    }

                </div>

                @if (ContractReviewVMs.Any())
                {
                    <div class="table-responsive">
                        <QuickGrid Items="ContractReviewVMs.AsQueryable()"
                                   Pagination="@pagination"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Any(c => c.IsVisible))
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    @switch (col.Field)
                                    {
                                        case "Id":
                                            <PropertyColumn Title="ID" Property="@(c => c.Id)" Sortable="true" />
                                            break;

                                        case "Prefix":
                                            <PropertyColumn Title="Prefix" Property="@(c => c.Prefix)" Sortable="true" />
                                            break;

                                        case "ContractNo":
                                            <PropertyColumn Title="Contract No"
                                                            Property="@(c => $"{c.ContractNo}{c.Suffix}")"
                                                            Sortable="true" />
                                            break;

                                        case "ContractDate":
                                            <PropertyColumn Title="Contract Date"
                                                            Property="@(c => c.ContractDate)"
                                                            Format="dd/MM/yyyy"
                                                            Sortable="true" />
                                            break;

                                        case "ContractDateNow":
                                            <PropertyColumn Title="Contract Date Now"
                                                            Property="@(c => c.ContractDateNow)"
                                                            Format="dd/MM/yyyy" />
                                            break;

                                        case "PoId":
                                            <PropertyColumn Title="PO ID" Property="@(c => c.PoId)" />
                                            break;

                                        case "PoNo":
                                            <PropertyColumn Title="PO No" Property="@(c => c.PoNo)" Sortable="true" />
                                            break;

                                        case "CustName":
                                            <PropertyColumn Title="Customer Name" Property="@(c => c.CustName)" Sortable="true" />
                                            break;

                                        case "CustAddress":
                                            <PropertyColumn Title="Customer Address" Property="@(c => c.CustAddress)" />
                                            break;

                                        case "CustGst":
                                            <PropertyColumn Title="Customer GST" Property="@(c => c.CustGst)" />
                                            break;

                                        case "CustContactNo":
                                            <PropertyColumn Title="Customer Contact No" Property="@(c => c.CustContactNo)" />
                                            break;

                                        case "RevisedBy":
                                            <PropertyColumn Title="Revised By" Property="@(c => c.RevisedBy)" />
                                            break;

                                        case "ApprovedBy":
                                            <PropertyColumn Title="Approved By" Property="@(c => c.ApprovedBy)" />
                                            break;

                                        case "ReviewResult":
                                            <TemplateColumn Title="Review Result" Context="c">
                                                @(c.ReviewResult == true ? "Approved"
                                                  : c.ReviewResult == false ? "Rejected"
                                                  : "Pending")
                                            </TemplateColumn>
                                            break;

                                        case "ReviewJson":
                                            <PropertyColumn Title="Review Json" Property="@(c => c.ReviewJson)" />
                                            break;

                                        case "OANo":
                                            <PropertyColumn Title="OA No" Property="@(c => c.OANo)" />
                                            break;

                                        case "OADate":
                                            <PropertyColumn Title="OA Date"
                                                            Property="@(c => c.OADate)"
                                                            Format="dd/MM/yyyy" />
                                            break;

                                        case "CreatedBy":
                                            <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                            break;

                                        case "CreatedDate":
                                            <PropertyColumn Title="Created Date"
                                                            Property="@(c => c.CreatedDate)"
                                                            Format="dd/MM/yyyy" />
                                            break;

                                        case "ModifiedBy":
                                            <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                            break;

                                        case "ModifiedDate":
                                            <PropertyColumn Title="Modified Date"
                                                            Property="@(c => c.ModifiedDate)"
                                                            Format="dd/MM/yyyy" />
                                            break;
                                    }
                                }
                            }

                            <!-- Actions -->
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"contractReviewCheckList/update/{c.Id}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit ContractReview">
                                           <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete ContractReview"
                                                @onclick="() => HandleDelete(c)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>

                    </div>
                   
                     <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>
                }
                else
                {
                    <p class="text-center">No ContractReview Check List found.</p>
                }
       

            </div>
        </div>
    </div>
}

@code
{
    protected override string ScreenName => "Contract Review CheckList";
    private bool isProcessing = true;
    private int DeleteId = 0;
    private string? UserName;

    private int totalItems;
    private int currentPage = 1;
    private int pageSize = 10;
    private string searchTerm;
    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);
    private PaginationState pagination = new() { ItemsPerPage = 10 };

    // Instant Search filter parameter
    [SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    public List<GridColumn> Columns { get; set; }
    private List<ContractReviewVM> ContractReviewVMs = new();

    private List<PageHeader.BreadcrumbItem> ContractreviewCheckListBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Sales" },
        new PageHeader.BreadcrumbItem { Text = "Contract Review Check", IsLast = true }
    };


    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await InitializeColumns(IsHidden);
            UserName = await currentUserService.GetUsernameAsync();

            await LoadAllContractReviewCheckListAsync();

            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);
            if (saved?.Any() == true)
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(s => s.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ContractReviewCheckList OnInitializedAsync() method");

        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "ID", Field = "Id", IsVisible = false },

                new() { Title = "Prefix", Field = "Prefix", IsVisible = false },

                new() { Title = "Contract No", Field = "ContractNo", IsVisible = true },

                new() { Title = "Contract Date", Field = "ContractDate", IsVisible = true },

                new() { Title = "Contract Date Now", Field = "ContractDateNow", IsVisible = false },

                new() { Title = "PO ID", Field = "PoId", IsVisible = false },

                new() { Title = "PO No", Field = "PoNo", IsVisible = true },

                new() { Title = "Customer Name", Field = "CustName", IsVisible = true },

                new() { Title = "Customer Address", Field = "CustAddress", IsVisible = false },

                new() { Title = "Customer GST", Field = "CustGst", IsVisible = false },

                new() { Title = "Customer Contact No", Field = "CustContactNo", IsVisible = false },

                new() { Title = "Revised By", Field = "RevisedBy", IsVisible = false },

                new() { Title = "Approved By", Field = "ApprovedBy", IsVisible = false },

                new() { Title = "Review Result", Field = "ReviewResult", IsVisible = false },

                new() { Title = "Review Json", Field = "ReviewJson", IsVisible = false },

                new() { Title = "OA No", Field = "OANo", IsVisible = false },

                new() { Title = "OA Date", Field = "OADate", IsVisible = false },

                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },

                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },

                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },

                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ContractReviewCheckList InitializeColumns() method");
            await _js.ToastrError("An error occurred while handling the ContractReviewCheckList InitializeColumns() method");
        }
    }

    private async Task LoadAllContractReviewCheckListAsync()
    {
        try
        {
            var result = await _contractReview.SearchWithDynamicFilterAsync(pageNumber: currentPage, pageSize: pageSize, filters: SearchFilters);
            ContractReviewVMs = result.Review;
            totalItems = result.TotalCount;


        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadAllContractReviewCheckListAsync");
            await _js.ToastrError("Failed to load ContractReviewCheckList data.");

        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated ?? new List<GridColumn>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "HandleColumnChange in ContractReviewCheckList");
            await _js.ToastrError("Failed to update column preferences in ContractReviewCheckList .");
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            if (e?.Value is not null && int.TryParse(e.Value.ToString(), out int pageSize))
            {
                pagination.ItemsPerPage = pageSize;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnPageSizeChanged in OnPageSizeChanged");
            await _js.ToastrError("Failed to update page size in OnPageSizeChanged.");
        }
    }

    #region nav buttons
    private async Task FirstPage()
    {
        if (currentPage != 1)
        {
            currentPage = 1;
            await LoadAllContractReviewCheckListAsync();
        }
    }
    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadAllContractReviewCheckListAsync();
        }
    }
    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadAllContractReviewCheckListAsync();
        }
    }
    private async Task LastPage()
    {
        if (currentPage != totalPages)
        {
            currentPage = totalPages;
            await LoadAllContractReviewCheckListAsync();
        }
    }
    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllContractReviewCheckListAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Purchase Invoice  page");
            await _js.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    #endregion

    #region Delete details
    private async Task HandleDelete(ContractReviewVM review)
    {
        try
        {
            DeleteId = review.Id;
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error while HandleDelete in ContractReviewCheck List");
            await _js.ToastrError("Failed to  HandleDelete data.");
        }
    }

    private async Task confirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            bool deleted = await _contractReview.DeleteContractReviewByIdAsync(DeleteId);
            if (deleted)
            {
                await _js.ToastrSuccess("ContractReviewCheckList deleted successfully.");
                await LoadAllContractReviewCheckListAsync();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _js.ToastrWarning("ContractReviewCheckList could not be deleted. It may have dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting in ContractReviewCheckList FesId: {DeleteId}");
            await _js.ToastrError("Failed to delete ContractReviewCheckList.");
        }
        finally
        {
            DeleteId = 0;
        }
    }
    #endregion


    #region instant search
    public void Search()
    {
        isProcessing = true;
        isModalVisible = true;
        ActiveModal = "InstantSearch";
        isProcessing = false;

    }
    private void HandleSCNSearch(List<ContractReviewVM> list)
    {
        ContractReviewVMs = list;
        isModalVisible = false;   // Close popup
        StateHasChanged();
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _js.ToastrError("Failed to close modal. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _js.ToastrError("Failed to open modal. Please try again.");
        }
    }

    #endregion

    #region SEARCH FILTERS
    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllContractReviewCheckListAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in ContractReviewCheckList");
            await _js.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }
    #endregion
}
