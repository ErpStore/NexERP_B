    private async Task OnPoNoChanged(ChangeEventArgs e)
    {
        try
        {
            selectedPoNo = e.Value?.ToString();
            if (!string.IsNullOrEmpty(selectedPoNo))
            {
                var selectedmfgPo = LoadNewmfgPos.FirstOrDefault(x => x.PONo == selectedPoNo);
                if (selectedmfgPo != null)
                {
                    var existingReview =await _contractReview.GetPoDetailsByPoIdAsync(selectedmfgPo.PoId);
                    ContractReviewVMS = existingReview;

                    var masterList = await _contractReview.GetMasterAsync();

                    MasterReview = masterList.Select((m, index) => new ContractReviewMasterVM
                    {
                        SlNo = index + 1,
                        Description = m.Description,
                        Remarks = ResolveAutoRemark(m.Description, existingReview) ?? string.Empty
                    }).ToList();
                    await autoIncreamentNo();
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "OnPoNoChanged in  Contractreview upsert");
            await _js.ToastrError("Failed to OnPoNoChanged  in Contractreview upsert.");
        }
    }

    private static string? ResolveAutoRemark(string description,ContractReviewVM po)
    {
        //  description = description.ToLowerInvariant();

        if (description.Contains("Company name."))
            return po.CustName;

        if (description.Contains("Company billing address."))
            return po.CustAddress;

        if (description.Contains("Ship to address."))
            return po.CustAddress;

        if (description.Contains("Contact name."))
            return "";


        if (description.Contains("Contact phone number."))
            return po.CustContactNo;

        if (description.Contains("P.O.No"))
            return po.PoNo;

        return null;                                                                     
    }

    private async Task UpsertContractReview()
    {
        isProcessing = true;
        try
        {

            if (await toValidateContractReview())
            {
                ContractReviewVMS.ReviewJson = JsonSerializer.Serialize(MasterReview, new JsonSerializerOptions
                {
                    WriteIndented = false
                });

                var isNewContractReview = ContractReviewVMS.Id == 0;
                await _contractReview.UpsertContractReview(ContractReviewVMS);
                if (ContractReviewVMS.ReviewResult == true)
                {
                    isModalVisible = true;   
                }
                if (isModalVisible && ContractReviewVMS.ReviewResult==true)
                {
                    await OrderAcceptance();
                }

                if (isNewContractReview)
                    await _js.ToastrSuccess("ContractReview saved successfully.");
                else
                    await _js.ToastrSuccess("ContractReview updated successfully.");

                // Discard popup Clear
                await _js.InvokeVoidAsync("NavigationGuard.clear");
                // _navigationManager.NavigateTo("/contractReviewCheckList");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertContractReview");
            await _js.ToastrError("Error saving UpsertContractReview.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> toValidateContractReview()
    {
        bool valid = true;

        if (string.IsNullOrEmpty(ContractReviewVMS.ContractNo))
        {
            await _js.ToastrWarning("ContractReview No. should not be empty");
            valid = false;
        }
        else if (ContractReviewVMS.ContractDate == default(DateTime))
        {
            await _js.ToastrWarning("Please enter ContractReviewVMS Date.");
            valid = false;
        }
        else if (string.IsNullOrWhiteSpace(ContractReviewVMS.PoNo))
        {
            await _js.ToastrWarning("Ref PoNo. should not be empty");
            valid = false;
        }

        else if (!ContractReviewVMS.ContractReviewSubVMS.Any())
        {
            await _js.ToastrWarning("At least one row item is required.");
            valid = false;
        }
        else if (string.IsNullOrWhiteSpace(ContractReviewVMS.RevisedBy))
        {
            await _js.ToastrWarning("Please select Revised By");
            valid = false;
        }
        else if (string.IsNullOrWhiteSpace(ContractReviewVMS.ApprovedBy))
        {
            await _js.ToastrWarning("Please select Approved By");
            valid = false;
        }
        return valid;
    }

    #region for OrderAcceptance
    private async Task OrderAcceptance()
    {
        try
        {
            isProcessing = true;

            if (ContractReviewVMS.PoId <= 0)
            {
                await _js.ToastrError("Invalid PO.");
                return;
            }

            if(string.IsNullOrEmpty(ContractReviewVMS.OANo))
            {
                var generatedOANo = await _contractReview.GetNextOANumberAsync(ContractReviewVMS.Suffix);
                ContractReviewVMS.OANo = generatedOANo;
                ContractReviewVMS.OADate = DateTime.Now;

                OAbuttonText = "Save";
            }
            else
            {
                OAbuttonText = "Update";
            }
            ActiveModal = "OA";
            ModalTitle = "Order Accecptance";
            isModalVisible = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OrderAcceptance");
            await _js.ToastrError("Failed to generate OA Number.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task SaveOrderAcceptance()
    {
        try
        {
            isProcessing = true;
            
            if (ContractReviewVMS.ContractNo!=null)
            {
                 
                 await _contractReview.UpdateOADetails(ContractReviewVMS.ContractNo,ContractReviewVMS.OANo,ContractReviewVMS.OADate,ContractReviewVMS.PoId.Value);
            }
           

            if(OAbuttonText == "Save")
            {
                await _js.ToastrSuccess("Order Acceptance saved successfully!");
                OAbuttonText = "Update";
            }
            else
            {
                await _js.ToastrSuccess("Order Acceptance Modified successfully!");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in SaveOrderAcceptance");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public void CloseOrderAcceptance()
    {
        isModalVisible = false;      // 🔥 CLOSE MODAL
        _navigationManager.NavigateTo("/contractReviewCheckList");
    }

    #endregion
    
