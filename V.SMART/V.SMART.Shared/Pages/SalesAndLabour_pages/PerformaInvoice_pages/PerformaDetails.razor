@page "/performaInv/details/{InvId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ISalesService
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.PerformaInvoiceVM
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.QuotationVM

@inherits BaseUserRightsComponent

@inject NavigationManager _navigationManager
@inject IPerformaInvService _performaService
@inject IJSRuntime _js
@inject NavigationManager _navigationManager
@inject ILoggingService LoggingService
@inject ReportService reportService

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
        return;
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <!-- Company Details Section -->
            <MyCompanyDetails />

            <!-- Cancelled Watermark -->
            @if (PerformaInvVMs.InvCancl)
            {
                <div class="cancelWatermark ms-20 mt-10">CANCELLED</div>
            }

            <hr class="border-2 border-primary-subtle mb-4" />
            <div class="text-center">
                <h4 class="fw-semibold mt-3">Perfoma Invoice  Details</h4>
            </div>

            <hr class="border-2 border-primary-subtle mb-4" />

            <!-- Customer & Document Details Section -->
            <div class="row g-3 mb-4">

                <!-- Customer Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Customer Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.CustName) ? PerformaInvVMs.CustName : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.CustAddress) ? PerformaInvVMs.CustAddress : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.CustGst) ? PerformaInvVMs.CustGst : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.CustContactNo) ? PerformaInvVMs.CustContactNo : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact Person</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.KindOfAttention) ? PerformaInvVMs.KindOfAttention : "N/A")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Document Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Document Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Performa Inv No</strong></td>
                                        <td>@(PerformaInvVMs != null ? $"{PerformaInvVMs.Prefix}{PerformaInvVMs.InvNo}{PerformaInvVMs.Suffix}" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Performa Inv Date</strong></td>
                                        <td>@(PerformaInvVMs?.InvDate.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Currency</strong></td>
                                        <td>@(!string.IsNullOrEmpty(PerformaInvVMs?.CurrName) ? PerformaInvVMs.CurrName : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Po No.</strong></td>
                                        <td>@refPoNosDisplay</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Po Dt.</strong></td>
                                        <td>@refPoDatesDisplay</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Consignee & Other Terms Section -->
            <div class="row g-3 mb-4">
                <!-- Consignee Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2 small">
                            Consignee Details
                        </div>
                        <div class="card-body p-2 small">
                            @if (PerformaInvVMs.IsSameAsShipping)
                            {
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.CustName) ? PerformaInvVMs.CustName : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.CustAddress) ? PerformaInvVMs.CustAddress : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.CustGst) ? PerformaInvVMs.CustGst : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.CustContactNo) ? PerformaInvVMs.CustContactNo : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Contact Person</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.KindOfAttention) ? PerformaInvVMs.KindOfAttention : "N/A")</td></tr>
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.ShippingName) ? PerformaInvVMs.ShippingName : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.ShippingAddress) ? PerformaInvVMs.ShippingAddress : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.ShippingGstin) ? PerformaInvVMs.ShippingGstin : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(PerformaInvVMs?.ShippingContactNo) ? PerformaInvVMs.ShippingContactNo : "N/A")</td></tr>
                                    </tbody>
                                </table>
                            }

                        </div>
                    </div>
                </div>

                <!-- Payment, Delivery, and Other Terms -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2 small">
                            Payment, Delivery, and Other Terms
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Payment Terms</strong></td>
                                        <td>@(PerformaInvVMs?.PayTerms ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Delivery Terms</strong></td>
                                        <td>@(PerformaInvVMs?.DeliveryTerms ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Main Remarks</strong></td>
                                        <td>@(PerformaInvVMs?.MainRemark ?? "N/A")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Quotation Items Section -->
            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    Quotation Items
                </div>
                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                        <thead class="custom-blue">
                            <tr>
                                <th>Sl No.</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>UOM</th>
                                <th>HSN</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Discount</th>
                                <th>Basic Amount</th>
                                @if (CustomerVMs.TaxValidate == false)
                                {
                                    @if (CustomerVMs.BusiType == "Local")
                                    {
                                        <th>CGST</th>
                                        <th>SGST</th>
                                    }
                                    else if (CustomerVMs.BusiType == "InterState")
                                    {
                                        <th>IGST</th>
                                    }
                                }
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody class="custom-size">
                            @if (PerformaInvVMs?.PerformaInvSubVMs != null && PerformaInvVMs.PerformaInvSubVMs.Any())
                            {
                                @foreach (var item in PerformaInvVMs.PerformaInvSubVMs)
                                {
                                    <tr>
                                        <td>@item.SlNo</td>
                                        <td>@(item.ItemCode ?? "—")</td>
                                        <td>@(item.ItemName ?? "—")</td>
                                        <td>@item.MeasureUnit</td>
                                        <td>@item.HSNCode</td>
                                        <td>@FormatDecimal(item.Qty)</td>
                                        <td>@FormatDecimal(item.UnitPrice)</td>
                                        <td>@FormatDecimal(item.LineDiscountAmount)</td>
                                        <td>@FormatDecimal(item.LineBasicAmount)</td>

                                        @if (CustomerVMs.TaxValidate == false)
                                        {
                                            @if (CustomerVMs.BusiType == "Local")
                                            {
                                                <td class="text-end">@FormatDecimal(item.LineCGSTAmount)</td>
                                                <td class="text-end">@FormatDecimal(item.LineSGSTAmount)</td>
                                            }
                                            else if (CustomerVMs.BusiType == "InterState")
                                            {
                                                <td class="text-end">@FormatDecimal(item.LineIGSTAmount)</td>
                                            }
                                        }

                                        <td>@item.Remark</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Due Date & Tax Totals Section -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                </div>

                <!-- Tax Totals -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-success-subtle text-success-emphasis fw-semibold p-2 small">
                            Totals & Taxes
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-secondary">Total Gross Amount</td><td class="text-end">@FormatDecimal(PerformaInvVMs.TotalLineGross)</td></tr>
                                    <tr><td class="text-secondary">Total Discount</td><td class="text-end">@FormatDecimal(PerformaInvVMs.DiscountAmount)</td></tr>
                                    <tr><td class="text-secondary">Total Basic Amount</td><td class="text-end">@FormatDecimal(PerformaInvVMs.TotalLineBasicAmount)</td></tr>
                                    <tr><td class="text-secondary">Freight Charges</td><td class="text-end">@FormatDecimal(PerformaInvVMs.FreightCharges)</td></tr>
                                    <tr><td class="text-secondary">Packing Charges</td><td class="text-end">@FormatDecimal(PerformaInvVMs.PackingCharges)</td></tr>
                                    <tr><td class="text-secondary">Insurance Charges</td><td class="text-end">@FormatDecimal(PerformaInvVMs.InsuranceCharges)</td></tr>
                                    <tr><td class="text-secondary">Total Taxable</td><td class="text-end">@FormatDecimal(PerformaInvVMs.TotalTaxable)</td></tr>
                                    @if (CustomerVMs.TaxValidate == false)
                                    {
                                        @if (CustomerVMs.BusiType == "Local")
                                        {
                                            <tr><td class="text-secondary">Total CGST</td><td class="text-end">@FormatDecimal(PerformaInvVMs.TotalCGSTAmount)</td></tr>
                                            <tr><td class="text-secondary">Total SGST</td><td class="text-end">@FormatDecimal(PerformaInvVMs.TotalSGSTAmount)</td></tr>
                                        }
                                        else if (CustomerVMs.BusiType == "InterState")
                                        {
                                            <tr><td class="text-secondary">Total IGST</td><td class="text-end">@FormatDecimal(PerformaInvVMs.TotalIGSTAmount)</td></tr>
                                        }
                                    }
                                    <tr><td class="text-secondary">TCS</td><td class="text-end">@FormatDecimal(PerformaInvVMs.TCSAmount)</td></tr>
                                    <tr><td class="text-secondary">Other Charges</td><td class="text-end">@FormatDecimal(PerformaInvVMs.OtherCharges)</td></tr>
                                    <tr><td class="text-secondary">Round Off</td><td class="text-end">@FormatDecimal(PerformaInvVMs.RoundOff)</td></tr>
                                    <tr class="fw-bold fs-6 text-primary">
                                        <td>Grand Total</td>
                                        <td class="text-end">@FormatDecimal(PerformaInvVMs.GrandTotal)</td>
                                    </tr>

                                    @if (PerformaInvVMs.CurrId > 1)
                                    {
                                        <tr>
                                            <td colspan="2" class="text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @PerformaInvVMs.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((PerformaInvVMs.GrandTotal * PerformaInvVMs.TodayVal).ToString("0.00"))
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <!-- Due Date & Terms and Conditions -->
                <div class="col-md-12">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-warning-subtle text-warning-emphasis fw-semibold p-2 small">
                            Total Amount in Words
                        </div>
                        <div class="card-body p-2 small">
                            <p class="mb-0">
                                @if (PerformaInvVMs.CurrId > 1 && PerformaInvVMs.TodayVal > 0)
                                {
                                    <small class="fw-bold text-success d-block">
                                        Converted Value in Rs:
                                        @NumberToWordsHelper.ConvertNumberToWords(PerformaInvVMs.GrandTotal * PerformaInvVMs.TodayVal)
                                    </small>
                                }
                                else
                                {
                                    <strong>@NumberToWordsHelper.ConvertNumberToWords(PerformaInvVMs.GrandTotal)</strong>
                                }
                            </p>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 justify-content-end">
                <a href="/PerformaInvList" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Back To List
                </a>
                <a href="@($"/PerformaInv/update/{InvId}")" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Modify
                </a>

                <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>
        </div>
    }
}

@code {

    protected override string ScreenName => "Performa Invoice";

    [Parameter]
    public int InvId { get; set; }

    private bool isProcessing { get; set; } = true;
    private PerformaInvVM PerformaInvVMs { get; set; } = new PerformaInvVM();
    private CustomerVM CustomerVMs { get; set; } = new CustomerVM();
    private string? pdfBase64;
    private List<PerformaInvSubVM> refPos = new();
    private int Decimalplaces { get; set; } = 2;

    private string refPoNosDisplay = "N/A";
    private string refPoDatesDisplay = "N/A";

    private string FormatDecimal(decimal? value)
    {
        try
        {
            if (value == null) return "0";
            return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
        }
        catch (Exception ex)
        {
            return value?.ToString() ?? "2";
        }
    }


    protected override async Task OnInitializedAsync()
    {

        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            await LoadPerformaInv();

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error Occured in  FormatDecimal() in PerformaDetails");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadPerformaInv()
    {
        try
        {
            if (InvId > 0)
            {
                var performaInv = await _performaService.GetPerformaByInvIdAsync(InvId);
                if (performaInv != null)
                {
                    PerformaInvVMs = performaInv;
                }

                Decimalplaces = await _performaService.GetDecimalPlacesAsync();
                CustomerVMs = await _performaService.GetCustomerByIdAsync(PerformaInvVMs.CustId.Value);
                refPos = await _performaService.GetDistinctRefPoByPerformaInvIdAsync(PerformaInvVMs.InvId);

                if (refPos.Any())
                {
                    // Only join the existing items, no extra commas
                    refPoNosDisplay = string.Join(", ", refPos.Select(e => e.RefPoNo).Where(n => !string.IsNullOrEmpty(n)));
                    refPoDatesDisplay = string.Join(", ", refPos
                        .Select(e => e.RefPoDate.HasValue ? e.RefPoDate.Value.ToString("dd/MM/yyyy") : null)
                        .Where(d => !string.IsNullOrEmpty(d)));
                }
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error Occured in  LoadPerformaInv() in PerformaDetails");
            await LoggingService.LogDeveloperError(ex, "Error Occured in  LoadPerformaInv() in PerformaDetails");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(InvId, "PerformaInvoice.frx", "InvId", PerformaInvVMs.InvCancl, ScreenName, "Sp_Print_PerformaInvoice");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Performa Invoice");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Performa Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }

}
