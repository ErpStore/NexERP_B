    private async Task Cancel()
    {
        try
        {

            if (!InvId.HasValue || InvId == 0)
            {
                await _js.ToastrError("cancel is not allowed before saving the Performa Invoice.");
                return;
            }

            if (PerformaInvVMs.InvCancl)
            {
                var subs = await _performaInvService.GetPerformaSubByInvIdAsync(PerformaInvVMs.InvId); 

                foreach (var sub in subs)
                {
                    await _performaInvService.ValidatePoBalanceBeforeRevertAsync(sub);
                }
            }

            if (!PerformaInvVMs.InvCancl)
            {
                ModalTitle = "Are you sure you want to Cancel this Performa Invoice?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Performa Invoice?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Performa invoice.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Performa invoice Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
                    await CancelPI();
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task CancelPI()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!PerformaInvVMs.InvCancl)
            {
                PerformaInvVMs.InvCancl = true;
                PerformaInvVMs.CancelDate = DateTime.Now;
                PerformaInvVMs.CancelReason = cancelReason;
                PerformaInvVMs.CancelBy = username;

                await _performaInvService.UpdatedCancelStatusAndAddOrRevertQty(PerformaInvVMs);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Performa Invoice",
                    action: $"Cancelled Performa invoice: {PerformaInvVMs.InvNo}",
                    additionalInfo: $"Performa Invoice Id: {PerformaInvVMs.InvId}"
                );

                await _js.ToastrSuccess("Performa Invoice cancelled successfully.");
            }
            else
            {
                PerformaInvVMs.InvCancl = false;
                PerformaInvVMs.CancelDate = null ;
                PerformaInvVMs.CancelReason = string.Empty;
                PerformaInvVMs.CancelBy = string.Empty;

                await _performaInvService.UpdatedCancelStatusAndAddOrRevertQty(PerformaInvVMs);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Performa Invoice",
                    action: $"Reverted Performa Invoice: {PerformaInvVMs.InvNo}",
                    additionalInfo: $"Perfroma invoice Id: {PerformaInvVMs.InvId}"
                );

                await _js.ToastrSuccess("Performa Invoice has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            PerformaInvVMs = await _performaInvService.GetPerformaByInvIdAsync(PerformaInvVMs.InvId);
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"CancelPI failed for InvId: {PerformaInvVMs.InvId}");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the quotation.");
            await LoggingService.LogDeveloperError(ex, $"CancelPI failed for InvId: {PerformaInvVMs.InvId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

   

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.InvSubId > 0)
            {
                await _performaInvService.DeleteAndResequenceAsync(rowToDelete, PerformaInvVMs);

                PerformaInvVMs = await _performaInvService.GetPerformaByInvIdAsync(PerformaInvVMs.InvId);
            }
            else
            {
                PerformaInvVMs.PerformaInvSubVMs.Remove(rowToDelete);

                if (!PerformaInvVMs.PerformaInvSubVMs.Any())
                {
                    PerformaInvVMs.PerformaInvSubVMs.Add(new PerformaInvSubVM
                    {
                        InvId = PerformaInvVMs.InvId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < PerformaInvVMs.PerformaInvSubVMs.Count; i++)
                        PerformaInvVMs.PerformaInvSubVMs[i].SlNo = i + 1;
                }
            }

            await _calculationService.UpdateTotalsAsync(PerformaInvVMs);

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for InvId: {PerformaInvVMs.InvId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

