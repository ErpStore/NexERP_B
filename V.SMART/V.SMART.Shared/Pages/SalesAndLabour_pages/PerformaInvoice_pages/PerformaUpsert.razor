    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3) 
            return Enumerable.Empty<CustomerVM>();

        try
        {
            var results = await _performaInvService.SearchCustomersAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<CustomerVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<CustomerVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchCustomers failed for value: {value}");
            await _js.ToastrError("Failed to search customers. Please try again.");
            return Enumerable.Empty<CustomerVM>();
        }
    }

    private async Task OnCustomerChanged(CustomerVM? customer)
    {
        try
        {
            await ApplyCustomerSelectionAsync(customer);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error in OnCustomerChanged: {ex}");
            await LoggingService.LogDeveloperError(ex, "Error in OnCustomerChanged");
            await _js.ToastrError("Error while selecting");
            contactPersons.Clear();
            await ResetQuoteDefaults();
        }
    }

    private async Task ApplyCustomerSelectionAsync(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;
            PerformaInvVMs.CustId = customer?.CustId ?? 0;
            PerformaInvVMs.CustName = customer?.CustName;
            PerformaInvVMs.CustAddress = customer?.CustAddr;
            PerformaInvVMs.CustGst = customer?.GSTNo;
            PerformaInvVMs.CustContactNo = customer?.ContactNo;

            if (customer == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                await ResetQuoteDefaults();
                return;
            }

            contactPersons = await _performaInvService.GetContactPersonsAsync(customer.CustId);
            consineeAddress = await _performaInvService.GetConsigneeAddressesAsync(customer.CustId);

            PerformaInvVMs.KindOfAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPersonName : string.Empty;

            // Tax logic
            if (!customer.TaxValidate)
            {

                if (string.Equals(customer.BusiType, "Local", StringComparison.OrdinalIgnoreCase)  && customer.TaxValidate == false)
                {
                    PerformaInvVMs.CGstRate = CommonConstants.GetGST(9.000m);
                    PerformaInvVMs.SGstRate = CommonConstants.GetGST(9.000m);
                    PerformaInvVMs.IGstRate = CommonConstants.GetIGST(0.000m);
                }
                else if (string.Equals(customer.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false )
                {
                    PerformaInvVMs.CGstRate = CommonConstants.GetGST(0.000m);
                    PerformaInvVMs.SGstRate = CommonConstants.GetGST(0.000m);
                    PerformaInvVMs.IGstRate = CommonConstants.GetIGST(18.000m);
                }
            }

            // Currency
            PerformaInvVMs.CurrId = (customer.CurrId.HasValue && customer.CurrId > 0) ? customer.CurrId.Value : 1;
            await ApplyCurrencyChange(PerformaInvVMs.CurrId.Value);

            //Pending POs Count
            poPendingCount = await _performaInvService.GetPendingPoCountAsync(customer.CustId);

            // Update totals
            await _calculationService.UpdateTotalsAsync(PerformaInvVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {customer?.CustId}");
            await _js.ToastrError("Failed to apply customer selection. Please try again.");
        }
    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
            await ApplyCurrencyChange(selectedId);
    }

    private async Task ApplyCurrencyChange(int currencyId)
    {
        var selectedCurrency = await _performaInvService.GetCurrencyByIdAsync(currencyId);
        if (selectedCurrency == null) return;

        PerformaInvVMs.CurrName = selectedCurrency.CurrName;
        PerformaInvVMs.Symbol = selectedCurrency.Symbol;
        PerformaInvVMs.CurrId = selectedCurrency.CurrId;

        if (currencyId > 1)
            PerformaInvVMs.TodayVal = await _performaInvService.GetLatestCurrencyValueAsync(currencyId) ?? 0m;
    }

    private async Task ResetQuoteDefaults()
    {
        PerformaInvVMs.CGstRate = 0m;
        PerformaInvVMs.SGstRate = 0m;
        PerformaInvVMs.IGstRate = 0m;
    }

    private async Task OnShippingChange(ChangeEventArgs e)
    {
        try
        {
            PerformaInvVMs.IsSameAsShipping = (bool)e.Value;

            if (!PerformaInvVMs.IsSameAsShipping && SelectedCustomer != null)
            {
                consineeAddress = await _performaInvService.GetConsigneeAddressesAsync(SelectedCustomer.CustId);
            }
            else
            {
                consineeAddress.Clear();
                ResetShippingDefaults();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                $"Error while toggling shipping address for CustId={SelectedCustomer?.CustId}");
        }
    }

    private void ResetShippingDefaults()
    {
        PerformaInvVMs.ShipAddrsId = null;
        PerformaInvVMs.ShippingName = null;
        PerformaInvVMs.ShippingAddress = null;
        PerformaInvVMs.ShippingGstin = null;
        PerformaInvVMs.ShippingContactNo = null;
    }

    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                PerformaInvVMs.IsSameAsShipping = true; 
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }

            PerformaInvVMs.IsSameAsShipping = false; 

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltCustId == selectedId);
            if (selectedConsignee == null)
                return;

            PerformaInvVMs.ShipAddrsId = selectedConsignee.AltCustId;
            PerformaInvVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltCustAddr1, selectedConsignee.AltCustAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            PerformaInvVMs.ShippingGstin = selectedConsignee.GSTNo ?? string.Empty;
            PerformaInvVMs.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(PerformaInvVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

    private async Task OnBankChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                PerformaInvVMs.BankId = null;
                PerformaInvVMs.BankName = null;

                StateHasChanged();
                return;
            }

            var selectedBank = banks.FirstOrDefault(c => c.BankId == selectedId);
            if (selectedBank == null)
                return;

            PerformaInvVMs.BankId = selectedBank.BankId;
            PerformaInvVMs.BankName = selectedBank.BankName ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(PerformaInvVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnBankChangedAsync");
        }
    }

