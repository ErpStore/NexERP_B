    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, PerformaInvSubVM SubVM)
    {
        try
        {
            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW quote line
            if (SubVM.InvSubId == 0)
            {
                if (SubVM.RefPoSubId > 0)
                {
                    var poBalQty = await _performaInvService.GetPoItemPerformaBalQtyFromPoSubId(SubVM.RefPoSubId.Value);

                    if (newQty <= poBalQty)
                    {
                        SubVM.Qty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = poBalQty;
                        await _js.ToastrWarning($"Qty can't be greater than Po Balance Qty ({poBalQty}).");
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                }
            }

            // EXISTING quote line
            else
            {
                if (SubVM.RefPoSubId > 0)
                {
                    var performabalQty = await _performaInvService.GetPoItemPerformaBalQtyFromPoSubId(SubVM.RefPoSubId.Value);
                    var OrginalQty = await _performaInvService.GetExistingPerformaQtyByInvSubId(SubVM.InvSubId);


                    var maxAllowedQty = performabalQty + OrginalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                }
            }

            await _calculationService.UpdateTotalsAsync(PerformaInvVMs);

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for PerformsSubId: {SubVM?.InvSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

