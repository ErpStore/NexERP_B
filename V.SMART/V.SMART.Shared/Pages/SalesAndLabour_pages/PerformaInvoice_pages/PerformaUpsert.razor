    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            Currencies = await _performaInvService.GetCurrenciesAsync();
            DecimalPlaces = await _performaInvService.GetDecimalPlacesAsync();
            banks = await _performaInvService.GetAllActiveBanksDetailaAsync();

            if (InvId.HasValue)
            {
                await LoadExistingPerforma(InvId.Value);
            }
            else if (CustId > 0)
            {
                await InitializeNewPerformaInv(CustId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingPerforma(int InvId)
    {
        try
        {
            PerformaInvVMs = await _performaInvService.GetPerformaByInvIdAsync(InvId);
            if (PerformaInvVMs == null)
            {
                await _js.ToastrWarning("Performa Invoice not found.");
                return;
            }

            SelectedCustomer = await _performaInvService.GetCustomerByIdAsync(PerformaInvVMs.CustId.Value);
            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

            if (PerformaInvVMs.CurrId > 0)
                await ApplyCurrencyChange(PerformaInvVMs.CurrId.Value);

            foreach (var poSub in PerformaInvVMs.PerformaInvSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[poSub.ItemId.Value] =
                    await _performaInvService.GetCorrespondenceAttachmentsCountAsync(poSub.ItemId.Value, "Item");
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to Load Existing Performa Invoice.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingPerforma failed for InvId: {InvId}");
        }
    }

    private async Task InitializeNewPerformaInv(int custId)
    {
        try
        {
            var customer = await _performaInvService.GetCustomerByIdAsync(custId);
            if (customer != null)
                await ApplyCustomerSelectionAsync(customer);

            PerformaInvVMs.Prefix = await _performaInvService.GetPrefixFromDb();
            PerformaInvVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            PerformaInvVMs.InvNo = await _performaInvService.GetPerformaInvNumberAsync(PerformaInvVMs.Suffix);

        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to Initialize New PerformaInv.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewPerformaInv failed for CustId: {custId}");
        }
    }

