    #region Performa-Invoice Operations

    private async Task UpsertPerformainvoice()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            PerformaInvVMs.PerformaInvSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (! PerformaInvVMs.PerformaInvSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a Performa-Invoice without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in  PerformaInvVMs.PerformaInvSubVMs)
            {
                bool isValid = await ValidatePOLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewPo = PerformaInvVMs.InvId == 0;

            @if(isNewPo)
            {
                bool isDuplicate = await _performaInvService.IsDuplicatePoAsync(PerformaInvVMs.InvNo, PerformaInvVMs.Suffix, PerformaInvVMs.InvId, PerformaInvVMs.CustId);
                if (isDuplicate)
                {
                   await _js.ToastrError($"Performa invoice No '{PerformaInvVMs.InvNo}' with Suffix '{PerformaInvVMs.Suffix}' already exists.");
                    return;
                }
            }

            try
            {
                await _performaInvService.UpsertPerformaInvAsync(PerformaInvVMs);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewPo)
                await _js.ToastrSuccess("Performa Invoice saved successfully.");
            else
                await _js.ToastrSuccess("Performa Invoice updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/PerformaInvList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertPerformainvoice failed.");
            await _js.ToastrError("Error saving Performa Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidatePOLineAsync(PerformaInvSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            if(SelectedCustomer.LineId)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Line No is Required");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            if (line.InvSubId == 0 && line.RefPoSubId > 0)
            {
                var poSubBalQty = await _performaInvService.GetPoItemPerformaBalQtyFromPoSubId(line.RefPoSubId.Value);
                if (line.Qty > poSubBalQty)
                {
                    line.Qty = poSubBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed PO Balance Qty ({poSubBalQty}).");
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidatePOLineAsync failed.");
            await _js.ToastrError("Error Validate Manufacturing-PO line.");
            return false;
        }
    }

