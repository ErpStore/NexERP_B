    #region Row Operations

    private async Task<bool> ValidateRowAsync(PerformaInvSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (row.Qty == null || row.Qty <= 0)
                errors.Add("Quantity must be greater than 0.");

            if (row.UnitPrice == null || row.UnitPrice <= 0)
                errors.Add("Unit Price must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = PerformaInvVMs.PerformaInvSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task SaveRow(PerformaInvSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            await ResetSlno();
            await _calculationService.UpdateTotalsAsync(PerformaInvVMs);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for PerformaSubId: {item?.InvSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(PerformaInvSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItem == null && item.ItemId > 0)
            {
                item.SelectedItem = await _performaInvService.GetItemByItemIdAsync(item.ItemId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for PerformaSubId: {item?.InvSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(PerformaInvSubVM? item, PerformaInvVM? parentPerforma)
    {
        try
        {
            if (item == null || parentPerforma == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentPerforma.PerformaInvSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for PerformaSubId: {item?.InvSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(PerformaInvSubVM item)
    {
        try
        {
            if (PerformaInvVMs.PerformaInvSubVMs.Count == 1 && item.InvSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if(PerformaInvVMs.InvCancl)
            {
                await _js.ToastrWarning("Cannot remove row from a cancelled Performa Invoice.");
                return;
            }


            if (item.ItemId == 0)
            {
                PerformaInvVMs.PerformaInvSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!PerformaInvVMs.PerformaInvSubVMs.Any())
                    PerformaInvVMs.PerformaInvSubVMs = new List<PerformaInvSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(PerformaInvVMs);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for PerformaSubId: {item?.InvSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in PerformaInvVMs.PerformaInvSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to reset row serial numbers.");
        }
    }

    private async Task UpdateDueDate()
    {
        try
        {
            if (DueDate == null)
                return;

            foreach (var subItem in PerformaInvVMs.PerformaInvSubVMs)
            {
                subItem.DueDate = DueDate.Value;
            }
            StateHasChanged();
        }
        catch(Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to Update DueDate.");
        }
    }

