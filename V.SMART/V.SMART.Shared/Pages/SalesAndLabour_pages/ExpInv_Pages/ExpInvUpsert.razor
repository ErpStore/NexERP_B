    private async Task ApplyCustomerSelectionAsync(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;
            ExpInvVMs.CustId = customer?.CustId ?? 0;
            ExpInvVMs.CustName = customer?.CustName;
            ExpInvVMs.CustAddress = customer?.CustAddr;
            ExpInvVMs.GSTNo = customer?.GSTNo;
            ExpInvVMs.ContactNo = customer?.ContactNo;
            ExpInvVMs.BusiType = customer?.BusiType;

            if (customer == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                CostCenterVMs.Clear();
                await ResetQuoteDefaults();
                return;
            }

            contactPersons = await _expInvService.GetContactPersonsAsync(customer.CustId);
            consineeAddress = await _expInvService.GetConsigneeAddressesAsync(customer.CustId);

            var usedCostCenters = ExpInvVMs.ExpSubInvVMs
                .Where(x => x.CostId.HasValue && (x.RefDcSubId == null || x.RefDcSubId == 0))
                .Select(x => x.CostId.Value)
                .ToHashSet();

            CostCenterVMs = await _expInvService.GetCostCenterDetailsByCustId(customer.CustId, usedCostCenters);

            ExpInvVMs.KindOfAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPersonName : string.Empty;

            // Tax logic
            if (!customer.TaxValidate)
            {
                var lastInvoice = await _expInvService.GetLastExpInvoiceAsync(customer.CustId);
                if (lastInvoice != null)
                {
                    ExpInvVMs.CGstRate = lastInvoice.CGstRate;
                    ExpInvVMs.SGstRate = lastInvoice.SGstRate;
                    ExpInvVMs.IGstRate = lastInvoice.IGstRate;
                }
                else
                {
                    if (string.Equals(customer.BusiType, "Local", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false)
                    {
                        ExpInvVMs.CGstRate = CommonConstants.GetGST(9.000m);
                        ExpInvVMs.SGstRate = CommonConstants.GetGST(9.000m);
                        ExpInvVMs.IGstRate = CommonConstants.GetIGST(0.000m);
                    }
                    else if (string.Equals(customer.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false)
                    {
                        ExpInvVMs.CGstRate = CommonConstants.GetGST(0.000m);
                        ExpInvVMs.SGstRate = CommonConstants.GetGST(0.000m);
                        ExpInvVMs.IGstRate = CommonConstants.GetIGST(18.000m);
                    }
                }
            }

            ExpInvVMs.CurrId = (customer.CurrId.HasValue && customer.CurrId > 0) ? customer.CurrId.Value : 1;
            await ApplyCurrencyChange(ExpInvVMs.CurrId);

            await CountPendingposDcs();


            await _calculationService.UpdateTotalsAsync(ExpInvVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {customer?.CustId}");
            await _js.ToastrError("Failed to apply customer selection. Please try again.");
        }
    }

