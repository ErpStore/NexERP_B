                var recalculatedDiscount = (gross * poDiscPercent) / 100m;

                var subVm = new ExpInvSubVM
                {
                    RefPoSubId = RefPoSubId,
                    RefPoNo = item.ContainsKey("PONo") ? item["PONo"]?.ToString() : "",
                    RefPoDate = item.ContainsKey("PODate") && item["PODate"] != null
                        ? Convert.ToDateTime(item["PODate"]) : null,
                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    Qty = item.ContainsKey("BalQty") && item["BalQty"] != null ? Convert.ToInt32(item["BalQty"]) : 0,
                    BalQty = item.ContainsKey("BalQty") && item["BalQty"] != null ? Convert.ToInt32(item["BalQty"]) : 0,
                    UnitPrice = priceDict.TryGetValue(itemId, out var price) ? price : 0,
                    CrBalQty=item.ContainsKey("BalQty") && item["BalQty"] != null ? Convert.ToInt32(item["BalQty"]) : 0,
                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,
                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",

                    Specification = item.ContainsKey("Specification") ? item["Specification"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("UOM") ? item["UOM"]?.ToString() : "",
                    HsnCode = item.ContainsKey("HSNCode") ? item["HSNCode"]?.ToString() : "",
                    TypeOfPo = "General Po",
                    Category = item.ContainsKey("Category") ? item["Category"]?.ToString() : "",
                    PoBalQty = item.ContainsKey("BalQty") && item["BalQty"] != null ? Convert.ToInt32(item["BalQty"]) : 0,
                    StockQty = item.ContainsKey("StockQty") && item["StockQty"] != null ? Convert.ToInt32(item["StockQty"]) : 0,
                    PartWeight=weight,
                    RcSubIds = item.ContainsKey("RcSubId") ? item["RcSubId"]?.ToString() : "",

                     CreditNos = new List<string>(),    
                     CreditDates = new List<DateTime>(),

                    LineDiscountPercent = poDiscPercent,
                    LineDiscountAmount = recalculatedDiscount, 

                    LineCGSTRate = CommonConstants.GetGST(poCgstRate),
                    LineSGSTRate = CommonConstants.GetGST(poSgstRate),
                    LineIGSTRate = CommonConstants.GetIGST(poIgstRate),


                    IsEditable = true
                };

                ExpInvVMs.ExpSubInvVMs.Add(subVm);
                await _calculationService.UpdateTotalsAsync(ExpInvVMs);
            }

            int slNo = 1;
            foreach (var row in ExpInvVMs.ExpSubInvVMs)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnEnquirySelectedAsync failed.");
            await _js.ToastrError("Error processing selected enquiry items.");
        }
    }

