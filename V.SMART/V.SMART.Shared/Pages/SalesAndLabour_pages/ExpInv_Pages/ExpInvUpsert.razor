                                </div>

                                <!-- Insurance Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Insurance Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceToggleRs"
                                                   @onchange="() => SetInsuranceType(true)" checked="@ExpInvVMs.InsuranceAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="insuranceToggleRs"><small>@ExpInvVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceTogglePercent"
                                                   @onchange="() => SetInsuranceType(false)" checked="@(!ExpInvVMs.InsuranceAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="insuranceTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (ExpInvVMs.InsuranceAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="ExpInvVMs.InsuranceCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(ExpInvVMs)' />
                                            <ValidationMessage For="@(() => ExpInvVMs.InsuranceCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="ExpInvVMs.InsurancePercent"
                                                   @bind:after="() => OnInsurancePercentChanged()" />
                                            <ValidationMessage For="@(() => ExpInvVMs.InsurancePercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(ExpInvVMs.InsuranceCharges)</small>
                                        }
