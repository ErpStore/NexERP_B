    private async Task ApplyCurrencyChange(int currencyId)
    {
        var selectedCurrency = await _expInvService.GetCurrencyByIdAsync(currencyId);
        if (selectedCurrency == null) return;

        ExpInvVMs.CurrName = selectedCurrency.CurrName;
        ExpInvVMs.Symbol = selectedCurrency.Symbol;
        ExpInvVMs.CurrId = selectedCurrency.CurrId;

        if (currencyId > 1)
            ExpInvVMs.TodayVal = await _expInvService.GetLatestCurrencyValueAsync(currencyId) ?? 0m;
    }

