    }

    private async Task OnShippingChange(ChangeEventArgs e)
    {
        try
        {
            ExpInvVMs.IsSameAsShipping = (bool)e.Value;

            if (!ExpInvVMs.IsSameAsShipping && SelectedCustomer != null)
            {
                consineeAddress = await _expInvService.GetConsigneeAddressesAsync(SelectedCustomer.CustId);
            }
            else
            {
                consineeAddress.Clear();
                ResetShippingDefaults();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                $"Error while toggling shipping address for CustId={SelectedCustomer?.CustId}");
        }
    }

    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                ExpInvVMs.IsSameAsShipping = true;
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }
            ExpInvVMs.IsSameAsShipping = false;

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltCustId == selectedId);
            if (selectedConsignee == null)
                return;

            ExpInvVMs.ShipAddrsId = selectedConsignee.AltCustId;
            ExpInvVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltCustAddr1, selectedConsignee.AltCustAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            ExpInvVMs.ShippingGstin = selectedConsignee.GSTNo ?? string.Empty;
            ExpInvVMs.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(ExpInvVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

    private void ResetShippingDefaults()
    {
        ExpInvVMs.ShipAddrsId = null;
        ExpInvVMs.ShippingName = null;
        ExpInvVMs.ShippingAddress = null;
        ExpInvVMs.ShippingGstin = null;
        ExpInvVMs.ShippingContactNo = null;
    }

