    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            Currencies = await _expInvService.GetCurrenciesAsync();
            TermsList = await _expInvService.GetTermsAsync();
            DecimalPlaces = await _expInvService.GetDecimalPlacesAsync();
            screenCode = await _expInvService.GetScreenCodeByScreenNameAsync(ScreenName);

            if (ExpInvId.HasValue)
            {
                await LoadExistingInvoice(ExpInvId.Value);
            }
            else if (CustId > 0)
            {
                await InitializeNewExport(CustId);
                
            }
            
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingInvoice(int ExpInvId)
    {
        try
        {
            ExpInvVMs = await _expInvService.GetExpInvoiceByExpInvIdAsync(ExpInvId);

            if (ExpInvVMs == null)
            {
                await _js.ToastrWarning("Quotation not found.");
                return;
            }

            SelectedCustomer = await _expInvService.GetCustomerByIdAsync(ExpInvVMs.CustId.Value);
            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

            if (ExpInvVMs.CurrId > 0)
                await ApplyCurrencyChange(ExpInvVMs.CurrId);

            foreach (var savedSub in ExpInvVMs.ExpSubInvVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[savedSub.ItemId] =
                    await _expInvService.GetCorrespondenceAttachmentsCountAsync(savedSub.ItemId, "Item");

                if (ExpInvVMs.DcCumInv)
                {
                    savedSub.StockQty = await _expInvService.GetStockQtyFromStockManager(savedSub.ItemId, ExpInvVMs.StoreIssId.Value);
                }

            }

            ExpInvVMs.SignedInvoiceQrCode =await _expInvService.GenerateQrBase64(ExpInvVMs.SignedInvoiceQrCode);
            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing Invoice.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingQuote failed for ExpInvId: {ExpInvId}");
        }
    }


    private bool CheckIsTransMade()
    {
        var list = ExpInvVMs?.ExpSubInvVMs;
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalQty += list[i].Qty.GetValueOrDefault();
            totalBalQty += list[i].BalQty.GetValueOrDefault();
        }

        return totalQty != totalBalQty;
    }


