    #region Export Invoice Operations

    private async Task UpsertInvoic()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            ExpInvVMs.ExpSubInvVMs.RemoveAll(x => x.ItemId != 0 && (!x.Qty.HasValue || x.Qty == 0) && (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!ExpInvVMs.ExpSubInvVMs.Any())
            {
                await _js.ToastrError("Cannot save a Invoice without valid items.");
                return;
            }
            bool main = await ValidateMainTable();
            if (!main) return;

            // Validate each line
            foreach (var line in ExpInvVMs.ExpSubInvVMs)
            {
                bool isValid = await ValidateInvoiceLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewQuote = ExpInvVMs.ExpInvId == 0;
            if(isNewQuote)
            {
                var isduplicate = await _expInvService.IsDuplicateExportNoAsync(ExpInvVMs.ExpInvNo, ExpInvVMs.Suffix, ExpInvVMs.ExpInvId, ExpInvVMs.CustId);

                if (isduplicate)
                {
                    await _js.ToastrWarning("This Export Invoice number already exists for the selected customer. Please verify and try again.");
                    return;
                }
            }

            try
            {
                await _expInvService.UpsertInvoiceAsync(ExpInvVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewQuote)
                await _js.ToastrSuccess("Export Invoice saved successfully.");
            else
                await _js.ToastrSuccess("Export Invoice updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/expInvList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Export UpsertInvoic failed.");
            await _js.ToastrError("Error saving Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateMainTable()
    {
        try
        {
            var errors = new List<string>();

            if (string.IsNullOrWhiteSpace(ExpInvVMs.ExpInvNo))
            {
                errors.Add($"Please enter the Invoice number");

            }

            if (ExpInvVMs.CustId == 0)
            {
                errors.Add($"Please select  Customer");

            }

            if (ExpInvVMs.DcCumInv)
            {
                if (ExpInvVMs.StoreIssId == 0)
                {
                    errors.Add($"Please select  Issue store. ");

                }
                if (string.IsNullOrEmpty(ExpInvVMs.TransportMode.ToString()))
                {
                    errors.Add($"Please select  Mode Of Transport");

                }
                if (string.IsNullOrEmpty(ExpInvVMs.VehicleNo))
                {
                    errors.Add($"Please enter valid Vehicle No");

                }
                if (string.IsNullOrEmpty(ExpInvVMs.TransFrom))
                {
                    errors.Add($"Please enter valid Transport From");

                }
                if (string.IsNullOrEmpty(ExpInvVMs.TransTo))
                {
                    errors.Add($"Please enter valid Transport To");

                }
                if (string.IsNullOrEmpty(ExpInvVMs.SubSupplyType.ToString()))
                {
                    errors.Add($"Please select valid Sub Supply Type");

                }

            }
            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrWarning(message);
                return false;
            }
            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateMainTable failed.");
            await _js.ToastrError("Error validating Invoice line.");
            return false;
        }
    }

    private async Task<bool> ValidateInvoiceLineAsync(ExpInvSubVM line)
    {
        try
        {
            decimal PartWeight = 0;
            if (line.ItemId == 0)
            {
                await _js.ToastrWarning("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _js.ToastrWarning($"Item {line.ItemId}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrWarning($"Item {line.ItemId}: Unit Price must be greater than 0.");
                return false;
            }

            decimal.TryParse(line.PartWeight.ToString(), out PartWeight);

            if (PartWeight<= 0)
            {
                await _js.ToastrWarning($"Sorry Part Weight  is mandatory for all item\n Go to the Master-Inventory-item:In Part Weight.?");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            decimal qtyOut = 0, stkqty = 0;
            int RefDcSubId = 0, RefPoSubId = 0;
            int.TryParse(line.RefDcSubId.ToString(), out RefDcSubId);
            int.TryParse(line.RefPoSubId.ToString(), out RefPoSubId);

            if (line.ExpInvSubId == 0)
            {
                if (RefDcSubId > 0)
                {
                    var dcBalQty = await _expInvService.GetDcItemBalQtyFromDcSubId(line.RefDcSubId.Value);
                    if (line.Qty > dcBalQty)
                    {
                        line.Qty = dcBalQty;
                        line.BalQty = dcBalQty;
                        line.CrBalQty = dcBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Dc Balance Qty ({dcBalQty}).");
                        return false;
                    }
                }
                if (RefPoSubId > 0)
                {
                    decimal rcstockqty = 0;
                    var PoBalQty = await _expInvService.GetPoItemBalQtyFromDcSubId(line.RefPoSubId.Value);
                    if (line.RcSubIds != "" && line.RcSubIds != null)
                    {
                        var ids = line.RcSubIds.Replace("'", "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                        foreach (var rcid in ids)
                        {
                            int.TryParse(rcid.ToString(), out int rsubid);
                            rcstockqty = rcstockqty + await _expInvService.GetAvailableStockByItemIdAndRcAndScreenAsync(line.ItemId, ExpInvVMs.StoreIssId.Value, rsubid);
                        }
                    }

                    var stockDict = (line.RcSubIds != "" && line.RcSubIds != null) ? rcstockqty : await _expInvService.GetStockQtyFromStockManager(line.ItemId, ExpInvVMs.StoreIssId.Value);

                    decimal.TryParse(stockDict.ToString(), out stkqty);
                    decimal possibleQty = Math.Min(stkqty, PoBalQty);

                    if (line.Qty > possibleQty)
                    {
                        line.Qty = PoBalQty;
                        line.BalQty = PoBalQty;
                        line.CrBalQty = PoBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Available Po Bal Qty ({possibleQty}). " + $"[Stock Qty: {stkqty}");
                        return false;
                    }

                }


            }
            else if (line.ExpInvSubId > 0)
            {
                bool exist = false;
                exist = await _expInvService.HasAnyItemOrInvoiceCreditNoteAsync(line.ExpInvSubId);
                if (exist)
                {
                    await _js.ToastrWarning("Cannot modify this invoice. Credit Note already exists for this invoice or its items.");
                    return false;
                }

                var original = await _expInvService.GetInvSubItemDetailByInvSubIdAsync(line.ExpInvSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty ?? 0m;
                    decimal origQty = original.Qty ?? 0m;
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        line.CrBalQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                        line.CrBalQty = line.BalQty;
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateInvoiceLineAsync failed.");
            await _js.ToastrError("Error validating Invoice line.");
            return false;
        }
    }

