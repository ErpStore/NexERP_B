    private async Task CancelEdit(ExpInvSubVM? item, ExpInvVM? parentQuote)
    {
        try
        {
            if (item == null || parentQuote == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentQuote.ExpSubInvVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for QuoteSubId: {item?.ExpInvId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(ExpInvSubVM item)
    {
        try
        {
            if (ExpInvVMs.ExpSubInvVMs.Count == 1 && item.ExpInvSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }else if (ExpInvVMs.ExpSubInvVMs.Count == 1)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if (ExpInvVMs.IsCancel)
            {
                await _js.ToastrWarning("This Invoice has been cancelled and cannot be modified.");
                return;
            }

            if (item.ItemCancel)
            {
                await _js.ToastrWarning("This item has already been cancelled and cannot be removed.");
                return;
            }

            if ((item.Qty ?? 0) != (item.BalQty ?? 0))
            {
                await _js.ToastrWarning("This row cannot be deleted because some transactions are done.");
                return;
            }

            bool exist = false;

            exist = await _expInvService.HasAnyItemOrInvoiceCreditNoteAsync(item.ExpInvSubId);
            if (exist)
            {
                await _js.ToastrWarning("Cannot delete this Item. Credit Note already exists for this   item.");
                return;
            }



            if (item.ItemId == 0)
            {
                ExpInvVMs.ExpSubInvVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!ExpInvVMs.ExpSubInvVMs.Any())
                    ExpInvVMs.ExpSubInvVMs = new List<ExpInvSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(ExpInvVMs);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for InvoiceSubId: {item?.ExpInvSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

