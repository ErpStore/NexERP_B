                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>IGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!ExpInvVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="ExpInvVMs.IGstRate"
                                                                @bind:after="() => _calculationService.UpdateTotalsAsync(ExpInvVMs)"
                                                                disabled="@(SelectedCustomer?.TaxValidate == true)">
                                                            <option value="0">-- Select IGST % --</option>
                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => ExpInvVMs.IGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(ExpInvVMs.TotalIGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }

                                    </div>
                                }

                               

                                <!-- TCS Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>TCS Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsToggleRs"
                                                   @onchange="() => SetTCSType(true)" checked="@ExpInvVMs.TCSAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="tcsToggleRs"><small>@ExpInvVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsTogglePercent"
                                                   @onchange="() => SetTCSType(false)" checked="@(!ExpInvVMs.TCSAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="tcsTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (ExpInvVMs.TCSAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="ExpInvVMs.TCSAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(ExpInvVMs)' />
                                            <ValidationMessage For="@(() => ExpInvVMs.TCSAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="ExpInvVMs.TCSPercent"
                                                   @bind:after="() => OnTCSPercentChanged()" />
                                            <ValidationMessage For="@(() => ExpInvVMs.TCSPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @ExpInvVMs.TCSAmount</small>
                                        }
                                    </div>
                                </div>

                                <!-- Other Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Other Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="ExpInvVMs.OtherCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(ExpInvVMs)' />
                                        <ValidationMessage For="@(() => ExpInvVMs.OtherCharges)" />
                                    </div>
                                </div>

                                <!-- Round Off -->
                                <div class="row mb-2 gx-2 align-items-center">
                                    <div class="col-5 col-md-4 d-flex align-items-center">
                                        <small class="me-2 text-dark">Round Off</small>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="roundOffSwitch"
                                                   @bind="ExpInvVMs.IsRoundOffEnabled"
                                                   @bind:after="() => _calculationService.UpdateTotalsAsync(ExpInvVMs)" >
                                            <label class="form-check-label" for="roundOffSwitch"></label>
                                        </div>
                                    </div>
                                    <div class="col-7 col-md-8">
                                       <input class="form-control form-control-sm rounded-3 text-end"
                                               value="@FormatDecimal(ExpInvVMs.RoundOff)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Grand Total -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label fw-bold text-dark">
                                        <small>Grand Total</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                               value="@FormatDecimal(ExpInvVMs.GrandTotal)"
                                               readonly />
                                        @if (ExpInvVMs.CurrId > 1)
                                        {
                                            <div class="mt-1 text-end">
                                                <small class="text-muted d-block fw-bold">
                                                    Today's value: @ExpInvVMs.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((ExpInvVMs.GrandTotal * ExpInvVMs.TodayVal).ToString("0.00"))
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Amount in Words -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label fw-bold text-dark"><small>Amount in Words</small></label>
                                    <div class="col-7 col-md-8 pt-1">
                                        @if (ExpInvVMs.CurrId > 1)
                                        {
                                            
                                             //decimal finalInvValue = ExpInvVMs.GrandTotal * ExpInvVMs.TodayVal;
                                            
                                            <strong>
                                                @* @NumberToWordsHelper.ConvertNumberToWords(finalInvValue) *@
                                                @ExpInvVMs.CurrName @NumberToWordsHelper.ConvertNumberToWords(ExpInvVMs.GrandTotal) 
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong>@NumberToWordsHelper.ConvertNumberToWords(ExpInvVMs.GrandTotal)</strong>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            @if(!ExpInvVMs.IsCancel)
                            {
                                 <div class="col-4 col-md-3 mt-3">
                                    <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                        <i class="bi bi-floppy2-fill me-1"></i> @(ExpInvVMs.ExpInvId > 0 ? "Update" : "Create")
                                    </button>
                                </div>
                            }
                           
                        }

                        
                        @if(ExpInvVMs.ExpInvId>0 && string.IsNullOrEmpty(ExpInvVMs.ACKNO) && string.IsNullOrEmpty(ExpInvVMs.IRNNo) 
                        && !ExpInvVMs.IsCancel && !ExpInvVMs.InvShortClose)
                        {
                                <div class="col-3 col-md-3 mt-3">
                                <button type="button" class="btn  btn-success w-100 rounded-3 rounded-3" @onclick='() => ConfirmEinvoice()'>
                                    <i class="bi bi-person-add me-1"></i> E-Invoice
                                </button>
                            
                                </div>
                        }


                        <div class="col-4 col-md-3 mt-3">
                            <SmartBackButton Url="@($"/expInvList?currentPage={currentPage}")" />
                        </div>
                        @if(ExpInvVMs.ExpInvId>0)
                        {
                             <div class="col-4 col-md-3 mt-3">
                                <button type="button" class="btn btn-sm btn-success w-100 rounded-3 rounded-3" @onclick='() => OpenModal("ExpDetails")'>
                                    <i class="bi bi-person-add me-1"></i> Print
                                </button>
                            
                             </div>
                        }
                        
                    </div>
                   
                </EditForm>
            </div>
        </div>
    </div>
} 


@code 
{
    #region Parameters & Properties

    protected override string ScreenName => "Export Invoice";

    [Parameter] public int? ExpInvId { get; set; }
    [Parameter] public int CustId { get; set; }

    private bool isProcessing = true;
    private ExpInvVM ExpInvVMs { get; set; } = new();
    private ExpInvSubVM? rowToDelete;
    private ExpInvSubVM? rowToCancel;

    private List<Store> stores = new();

    
    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private int DcPendingCount = 0;
    private int PoPendingCount = 0;

    private int screenCode { get; set; }

    private CustomerVM? SelectedCustomer;
    private List<ContactPerson> contactPersons = new();
    private List<CustomerIndirect> consineeAddress = new();
    private List<Currency> Currencies = new();
    private List<CostCenterVM> CostCenterVMs = new();

    private List<TermsAndConditions> TermsList = new();
    private bool IsSomeItemsTransMade { get; set; } = false;

    // Modal properties
