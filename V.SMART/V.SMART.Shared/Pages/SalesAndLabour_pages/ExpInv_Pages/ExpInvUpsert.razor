                                                            <td>@FormatDecimal(ExpInvVMs.TotalLineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@FormatDecimal(ExpInvVMs.TotalLineDiscountAmount)</td>
                                                        }

                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if(SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td></td>
                                                                <td></td>

                                                            }
                                                            else if(SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td></td>

                                                            }

                                                        }

                                                        <td>@FormatDecimal(ExpInvVMs.TotalLineBasicAmount)</td>
                                                       @if(ExpInvVMs?.ExpSubInvVMs?.Any(x=>x?.CreditNos!=null && x.CreditNos.Count>0)==true)
                                                        {
                                                             <td colspan="9"></td>

                                                        }else{
                                                             <td colspan="7"></td>
                                                        }
                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>
                                  @* 
                                    @if(!ExpInvVMs.IsCancel)
