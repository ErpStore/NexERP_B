    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.ExpInvSubId > 0)
            {
                await _expInvService.DeleteAndResequenceAsync(rowToDelete, ExpInvVMs, screenCode);

                ExpInvVMs.ExpSubInvVMs = await _expInvService.GetExpInvoiceDetailsSubByInvIdAsync(ExpInvVMs.ExpInvId);

                await CountPendingposDcs();                                          
            }
            else
            {
                ExpInvVMs.ExpSubInvVMs.Remove(rowToDelete);

                if (!ExpInvVMs.ExpSubInvVMs.Any())
                {
                    ExpInvVMs.ExpSubInvVMs.Add(new ExpInvSubVM
                    {
                        ExpInvId = ExpInvVMs.ExpInvId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < ExpInvVMs.ExpSubInvVMs.Count; i++)
                        ExpInvVMs.ExpSubInvVMs[i].SlNo = i + 1;
                }
            }

            await _calculationService.UpdateTotalsAsync(ExpInvVMs);

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for InvId: {ExpInvVMs.ExpInvId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

