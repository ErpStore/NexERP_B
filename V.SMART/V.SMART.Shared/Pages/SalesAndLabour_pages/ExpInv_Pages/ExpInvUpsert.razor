@page "/expInv/create"
@page "/expInv/create/{CustId:int}"
@page "/expInv/update/{ExpInvId:int}"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IEInvoiceAPI
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.ExpInv_VM
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IExpInvService _expInvService
@inject ILoggingService LoggingService

@inject IEinvoiceDatabaseService _einvoiceService


@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="@(!ExpInvVMs.DcCumInv ? "Dc Details" : "PO Details")"
              Columns="@(!ExpInvVMs.DcCumInv?DcColumns:PoColumns)"
              ColumnFields="@(!ExpInvVMs.DcCumInv?DcFields:PoFields)"
              HiddenColumns="@(!ExpInvVMs.DcCumInv?DcHiddenColumns:PoHiddenColumns)"
              Data="@(!ExpInvVMs.DcCumInv?DcData:PoData)"
              IsVisible="@IsDcModalVisible"
              IsVisibleChanged="@((val) => IsDcModalVisible = val)"
              OnSelectedItems="@(!ExpInvVMs.DcCumInv?OnDcSelectedAsync:OnPoSelectedAsync)">
</DetailsModal>



<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isCustModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Terms")
    {
        <TermsUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
        refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
    else if (ActiveModal == "ExpDetails")
    {
         <ExportInvModel isExportDetailsModelVisible=true ExpInvId=@ExpInvVMs.ExpInvId OnClose="CloseModal" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <div class="position-fixed top-50 start-50 translate-middle d-flex align-items-center justify-content-center"
         style="width: 100vw; height: 100vh; background-color: rgba(255,255,255,0.5); z-index: 1050;">
        <img src="/_content/V.SMART.Shared/images/loading.gif" alt="Loading..." />
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{

    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if ((ExpInvVMs?.IsCancel ?? false))
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (ExpInvVMs?.InvShortClose == true)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }


            <PageHeader TitleText="@(ExpInvVMs.ExpInvId > 0 ? "Update Export Invoice" : "Create Export Invoice")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@ExportFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="ExpInvVMs" OnValidSubmit="UpsertInvoic">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                   <div class="row g-3 mb-2 align-items-center">

                        <!-- Dc Cum Invoice (LEFT) -->
                        <div class="col-12 col-md-6 d-flex align-items-center justify-content-center">

                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox"
                                       id="ManufacturingSwitch"
                                       checked="@ExpInvVMs.DcCumInv"
                                       @onchange="OnManufacturingToggle"
                                       disabled="@IsSomeItemsTransMade" />

                                <label class="form-check-label fw-semibold @(ExpInvVMs.DcCumInv ? "text-success" : "")"
                                       for="ManufacturingSwitch">
                                    <i class="bi bi-gear-fill me-1"></i> Dc Cum Invoice
                                </label>
                            </div>

                            <ValidationMessage For="@(() => ExpInvVMs.DcCumInv)" />
                        </div>

                        <!-- Correspondence Status (RIGHT) -->
                        <div class="col-12 col-md-6 d-flex align-items-center justify-content-end">
                            @if (ExpInvVMs.ExpInvId > 0)
                            {
                                <CorrespondenceStatus 
                                    ReferenceType="Export-Invoice"
                                    ReferenceId="@ExpInvVMs.ExpInvId"
                                    ReferenceTypeName="@ExpInvVMs.ExpInvNo" />
                            }
                        </div>

                   </div>

                   
                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Customer Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Customer")'>
                                        <i class="bi bi-person-add me-1"></i> Add Customer
                                    </button>
                                </div>

                                <div class="card-body">
                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="CustomerVM"
                                                                 Value="SelectedCustomer"
                                                                 ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                                 ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                                 SearchFunc="SearchCustomers"
                                                                 Dense="true"
                                                                 Variant="Variant.Outlined"
                                                                 Placeholder="Search Customer"
                                                                 Title="Search atleast 3 letters in Customer"
                                                                 Class="w-100 autocomplete-sm"
                                                                 MaxItems="50"
                                                                 Clearable="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 Required="true"
                                                                 AvoidSubmit="true" 
                                                                 Disabled="@IsSomeItemsTransMade"/>
                                        </div>
                                    </div>
                                    @if(!ExpInvVMs.DcCumInv)
                                    {
                                        <!-- Address -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Address</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                          rows="1" readonly>@ExpInvVMs?.CustAddress</textarea>
                                            </div>
                                        </div>

                                        <!-- Phone -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Phone No</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                       value="@ExpInvVMs?.ContactNo" readonly />
                                            </div>
                                        </div>

                                        <!-- GSTIN -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>GSTIN</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                       value="@ExpInvVMs?.GSTNo" readonly />
                                            </div>
                                        </div>
                                    }

                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                             <select class="form-select form-select-sm rounded-3 w-100"
                                                        @bind="@ExpInvVMs.KindOfAttention">
                                                    <option disabled value="">Select Contact Person</option>
                                                    @foreach (var cp in contactPersons)
                                                    {
                                                        <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                    }
                                            </select>
                                            <ValidationMessage For="@(() => ExpInvVMs.KindOfAttention)" />
                                        </div>
                                    </div>

                                    <!-- Shipping Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Shipping Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="form-check form-switch d-flex align-items-center">
                                                <input class="form-check-input" type="checkbox" id="SameAsShipping"
                                                       checked="@ExpInvVMs.IsSameAsShipping"
                                                       @onchange="OnShippingChange" />
                                                <label class="form-check-label ms-2 fw-semibold"
                                                       for="SameAsShipping">Same as Shipping</label>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!ExpInvVMs.IsSameAsShipping)
                                    {
                                        <!-- Shipping To -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Shipping To</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select value="@ExpInvVMs.ShipAddrsId"
                                                        class="form-select form-select-sm rounded-3 w-100"
                                                        @onchange="OnConsigneeChangedAsync">
                                                    <option value="">Select Shipping Address</option>
                                                    @foreach (var consine in consineeAddress)
                                                    {
                                                        <option value="@consine.AltCustId">@consine.AltCustName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        @if (ExpInvVMs.ShipAddrsId > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Address</small>
                                                </label>
                                                <div class="col-12 col-lg-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@ExpInvVMs.ShippingAddress" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Contact No</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@ExpInvVMs.ShippingContactNo" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>GSTIN</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@ExpInvVMs.ShippingGstin" readonly />
                                                </div>
                                            </div>
                                        }
                                    }

                                    @if (ExpInvVMs.DcCumInv)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Mode Of Transport</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select class="form-select form-select-sm"
                                                        @bind="ExpInvVMs.TransportMode">
                                                    <option value="1">By Road</option>
                                                    <option value="2">By Railway</option>
                                                    <option value="3">By Airway</option>
                                                    <option value="4">By Seaway</option>
                                                </select>
                                                 <ValidationMessage For="@(() => ExpInvVMs.TransportMode)" />
                                            </div>
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Vehicle No</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputText  class="form-control form-control-sm rounded-3 w-100" @bind-Value="ExpInvVMs.VehicleNo" />
                                            </div>
                                             <ValidationMessage For="@(() => ExpInvVMs.VehicleNo)" />
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Transport From</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputText  class="form-control form-control-sm rounded-3 w-100" @bind-Value="ExpInvVMs.TransFrom" />
                                            </div>
                                             <ValidationMessage For="@(() => ExpInvVMs.TransFrom)" />
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Transport To</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputText class="form-control form-control-sm rounded-3 w-100" @bind-Value="ExpInvVMs.TransTo" />
                                            </div>
                                             <ValidationMessage For="@(() => ExpInvVMs.TransTo)" />
                                        </div>

                                         <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Driver No.</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputText  class="form-control form-control-sm rounded-3 w-100" @bind-Value="ExpInvVMs.DriverNo" maxlength="13" />
                                            </div>
                                             <ValidationMessage For="@(() => ExpInvVMs.DriverNo)" />
                                        </div>

                                        <div class="accordion mb-3" id="transportAccordion">
                                            <div class="accordion-item border-0 shadow-sm rounded-3">
                                                <h2 class="accordion-header" id="headingTransport">
                                                    <button class="accordion-button collapsed fw-semibold text-primary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseTransport"
                                                            aria-expanded="false"
                                                            aria-controls="collapseTransport">
                                                        <i class="bi bi-truck me-2"></i> E-way and  Transport Details
                                                    </button>
                                                </h2>
                                                <div id="collapseTransport"
                                                     class="accordion-collapse collapse"
                                                     aria-labelledby="headingTransport"
                                                     data-bs-parent="#transportAccordion">
                                                    <div class="accordion-body">

                                                         <!-- E-Way Bill No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>E-Way Bill No</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <input type="text"
                                                                        class="form-control form-control-sm rounded-3 w-100"
                                                                        @bind="ExpInvVMs.EWayNo" />
                                                            </div>
                                                        </div>

                                                        <!-- E-Way Bill Date -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>E-Way Bill Date</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                                            @bind-Value="ExpInvVMs.EWayDate" />
                                                            </div>
                                                        </div>
                                                       
                                                         <!-- Transport ID -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>Transport ID</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="ExpInvVMs.TransId" />
                                                                <ValidationMessage For="@(() => ExpInvVMs.TransId)" />
                                                            </div>
                                                        </div>

                                                        <!-- Transport Doc No. -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>Transport Doc No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="ExpInvVMs.TransDocNo" />
                                                                <ValidationMessage For="@(() => ExpInvVMs.TransDocNo)" />
                                                            </div>
                                                        </div>

                                                        <!-- Transport Name -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>Transport Name</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="ExpInvVMs.TransName" />
                                                                <ValidationMessage For="@(() => ExpInvVMs.TransName)" />
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    }

                                    @if(!string.IsNullOrEmpty(ExpInvVMs.ACKNO) && !string.IsNullOrEmpty(ExpInvVMs.IRNNo))
                                    {
                                        <div class="accordion mb-3" id="transportEinvoice">
                                            <div class="accordion-item border-0 shadow-sm rounded-3">

                                                <h2 class="accordion-header" id="headingEInvoice">
                                                    <button class="accordion-button collapsed fw-semibold text-primary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseEInvoice"
                                                            aria-expanded="false"
                                                            aria-controls="collapseEInvoice">
                                                        <i class="bi bi-truck me-2"></i> E-Invoice Details
                                                    </button>
                                                </h2>

                                                <div id="collapseEInvoice"
                                                     class="accordion-collapse collapse"
                                                     aria-labelledby="headingEInvoice"
                                                     data-bs-parent="#transportEinvoice">

                                                    <div class="accordion-body">

                                                        <!-- ACK No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>ACK No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <input type="text"
                                                                       class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind="ExpInvVMs.ACKNO"
                                                                       readonly />
                                                            </div>
                                                        </div>

                                                        <!-- ACK Date -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>ACK Date</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="ExpInvVMs.ACKNODate"
                                                                           disabled />
                                                            </div>
                                                        </div>

                                                        <!-- IRN No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>IRN No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="ExpInvVMs.IRNNo" />
                                                                <ValidationMessage For="@(() => ExpInvVMs.IRNNo)" />
                                                            </div>
                                                        </div>

                                                        <!-- QR Code -->
                                                        <div class="mb-2 row align-items-center">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>QR Code</small>
                                                            </label>

                                                            <div class="col-12 col-sm-9">
                                                                @if (!string.IsNullOrEmpty(ExpInvVMs.SignedInvoiceQrCode))
                                                                {
                                                                     <img src="@($"data:image/png;base64,{ExpInvVMs.SignedInvoiceQrCode}")"
                                                                         class="bg-white p-2"
                                                                         style="width:150px;height:auto;" />
                                                                }
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    }



                                    <!-- =================== InvoiceRemovalDate =================== -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Invoice RemovalDate</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="datetime-local"
                                                   class="form-control form-control-sm rounded-3"
                                                   @bind="ExpInvVMs.InvoiceRemovalDate"
                                                   step="1"
                                                   disabled />
                                            <ValidationMessage For="@(() => ExpInvVMs.InvoiceRemovalDate)" />
                                        </div>
                                    </div>

                                    <!-- =================== GoodsRemovalDate =================== -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Goods RemovalDate</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="datetime-local"
                                                   class="form-control form-control-sm rounded-3"
                                                   @bind="ExpInvVMs.GoodsRemovalDate"
                                                   step="1" />
                                            <ValidationMessage For="@(() => ExpInvVMs.GoodsRemovalDate)" />
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>

                        <!-- =================== Export Invoice Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Invoice Details</span>
                                    @if (ExpInvVMs.ExpInvId > 0 && (ExpInvVMs.ExpSubInvVMs == null || !ExpInvVMs.ExpSubInvVMs.Any(x => x.ItemCancel)) && (CanCreate || CanEdit))
                                    {
                                        <button type="button"
                                                class="btn btn-sm rounded-3 @(ExpInvVMs.IsCancel ? "btn-success" : "btn-danger")"
                                                 @onclick="Cancel">

                                            @if (!ExpInvVMs.IsCancel)
                                            {
                                                <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                            }
                                        </button>

                                        <!-- Short Close / Reopen Button -->
                                        <button type="button"
                                                class="btn btn-sm rounded-3 @(ExpInvVMs.InvShortClose ? "btn-success" : "btn-warning")"
                                                @onclick="() => AskToShortCloseAsync(ExpInvVMs)"
                                                disabled="@ExpInvVMs.IsCancel">

                                            @if (!ExpInvVMs.InvShortClose)
                                            {
                                                <i class="bi bi-box-seam me-1"></i> <span>Short Close</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Re-Open</span>
                                            }
                                        </button>

                                    }
                                </div>

                                <div class="card-body">

                                    <div class="row g-3 mb-2 align-items-center">

                                        @if (ExpInvVMs.DcCumInv)
                                        {
                                           
                                             bool isDisabled = ExpInvVMs.ExpInvId > 0;
                                            <!-- Tax Required -->
                                            <div class="col-12 col-sm-6">
                                                <div class="card shadow-sm border-2
                                                     @(ExpInvVMs.IsTaxRequired ? "border-success bg-success-subtle" : "border-light")
                                                     @(isDisabled ? "opacity-50" : "")"
                                                     style="cursor:@(isDisabled ? "not-allowed" : "pointer"); height:60px;"
                                                     @onclick="isDisabled ? null : (() => TaxRequired(true))">

                                                    <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                        <i class="bi @(ExpInvVMs.IsTaxRequired
                                                            ? "bi-check-circle-fill text-success"
                                                            : "bi-circle text-secondary") me-2"></i>

                                                        <span class="fw-semibold text-success">
                                                            Tax Required
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                    </div>

                                     <div class="row mb-2">
                                        <div class="col-12 d-flex justify-content-end">
                                            <div class="form-check d-flex align-items-center gap-2">
                                                    <input type="checkbox"
                                                        class="form-check-input"
                                                        style="border:2px solid #000;"
                                                        @bind="ExpInvVMs.IsManualInvNo" @onclick="()=>ToggleAutoInvNo()" readonly="@ExpInvVMs.ExpInvNo>0" />
                                                <label class="form-check-label text-dark">
                                                    <small>Is Manual ExpInv No.</small>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Invoice No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Invoice No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Prefix"
                                                            maxlength="10"
                                                            @bind-Value="@ExpInvVMs.Prefix"
                                                            style="flex:0 0 130px;" />

                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Exp Invoice No."
                                                            maxlength="30"
                                                            @bind-Value="@ExpInvVMs.ExpInvNo" 
                                                            readonly="@IsInvNoReadonly" />

                                                <span class="input-group-text rounded-3">@ExpInvVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => ExpInvVMs.Prefix)" />
                                            <ValidationMessage For="@(() => ExpInvVMs.ExpInvNo)" />
                                        </div>
                                    </div>

                                    <!-- Invoice Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Exp Invoice Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                        @bind-Value="@ExpInvVMs.ExpInvDate" />
                                            <ValidationMessage For="@(() => ExpInvVMs.ExpInvDate)" />
                                        </div>
                                    </div>

                                     

                                     <!-- Reference Dc -->
                                    @if(DcPendingCount >0)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Our DC</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowDcDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Dc Details
                                                </button>
                                            </div>
                                        </div>
                                    }else if(PoPendingCount >0)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. Po</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowPoDetails">
                                                    <i class="bi bi-list-ul me-1"></i> PO Details
                                                </button>
                                            </div>
                                        </div>

                                    }else
                                    {
                                        
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <span class="text-danger align-items-center">
                                                    @((ExpInvVMs.DcCumInv) ? "No Pending Po's Found" : "No Pending Dc's Found")
                                                </span>
                                            </div>
                                        </div>

                                    }
                                    

                                    <!-- Currency -->
                                    <div class="mb-2 row mt-1">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Currency</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value="@ExpInvVMs.CurrId"
                                                    @onchange="OnCurrencyChanged"
                                                    disabled>
                                                @foreach (var currency in Currencies)
                                                {
                                                    <option value="@currency.CurrId">@currency.CurrName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    @if(ExpInvVMs.DcCumInv)
                                    {
                                        <div class="mb-2 row mt-1">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Issue From Store</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select value="@ExpInvVMs.StoreIssId"
                                                        @onchange="OnStoreChanged"
                                                        class="form-select form-select-sm rounded-3 w-100">
                                                    <option value="0" selected>--Select Store--</option>

                                                    @if (stores != null)
                                                    {
                                                        foreach (var store in stores)
                                                        {
                                                            <option value="@store.StoreId">@store.StoreName</option>
                                                        }
                                                    }
                                                </select>
                                                <ValidationMessage For="@(() => ExpInvVMs.StoreIssId)" />
                                            </div>
                                        </div>

                                    }
                                    <!-- Payment Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Payment Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="ExpInvVMs.PayTerms"></textarea>
                                            <ValidationMessage For="@(() => ExpInvVMs.PayTerms)" />
                                        </div>
                                    </div>

                                    <!-- Delivery Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Delivery Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="ExpInvVMs.DeliveryTems"></textarea>
                                            <ValidationMessage For="@(() => ExpInvVMs.DeliveryTems)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="ExpInvVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => ExpInvVMs.MainRemark)" />
                                        </div>
                                    </div>
                                     <!-- Sub Supply Type -->
                                     @if(ExpInvVMs.DcCumInv)
                                     {
                                         <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Sub Supply Type</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select @bind="ExpInvVMs.SubSupplyType"
                                                        class="form-select form-select-sm rounded-3 w-100">
                                                   
                                                    <option value="1">Supply</option
                                                    <option value="5">ForOwnUse</option>
                                                    <option value="8">Others</option>
                                                </select>
                                                <ValidationMessage For="@(() => ExpInvVMs.SubSupplyType)" />
                                            </div>
                                        </div>

                                        @if (ExpInvVMs.SubSupplyType==8)
                                        {
                                                <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Sub Supply Desc.</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <textarea class="form-control form-control-sm rounded-3 w-100"
                                                                rows="1"
                                                                @bind="ExpInvVMs.SubSupplyDesc"></textarea>
                                                    <ValidationMessage For="@(() => ExpInvVMs.SubSupplyDesc)" />
                                                </div>
                                            </div>
                                        }

                                     }
                                    

                                    <!-- Cancel Remarks -->
                                    @if(ExpInvVMs.IsCancel)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="ExpInvVMs.CancelReason"
                                                            disabled></textarea>
                                                <ValidationMessage For="@(() => ExpInvVMs.CancelReason)" />
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <!-- Discount Toggle -->
                                        <div class="d-flex align-items-center">
                                            <label class="me-2 mb-0"><small>Discount : </small></label>
                                            <div class="btn-group btn-group-sm rounded-pill border" role="group" aria-label="Toggle Discount Rs and %">
                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountToggleRs" 
                                                        @onchange='() => SetDiscountMode(true)' 
                                                        checked="@ExpInvVMs.IsItemWiseDiscAmtOrPerReq" />
                                                <label class="btn btn-outline-primary rounded-start-pill" for="discountToggleRs">@ExpInvVMs.Symbol</label>

                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountTogglePercent" 
                                                        @onchange='() => SetDiscountMode(false)' 
                                                        checked="@(!ExpInvVMs.IsItemWiseDiscAmtOrPerReq)" />
                                                <label class="btn btn-outline-primary rounded-end-pill" for="discountTogglePercent">%</label>
                                            </div>
                                        </div>

                                       @*  <!-- Add Item Button -->
                                        <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                            <i class="bi bi-plus-circle me-1"></i> Create New Item
                                        </button> *@
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:90px;">HSNCODE</th>
                                                    <th style="width:120px;">Qty</th>
                                                    <th style="width:120px;">Price</th>
                                                    <th style="width:130px;">Gross Amount</th>

                                                    @if (!ExpInvVMs.IsItemWiseDiscAmtOrPerReq)
                                                    {
                                                        <th style="width:110px;">Disc %</th>
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }

                                                    @if (SelectedCustomer?.TaxValidate == false)
                                                    {
                                                        @if (SelectedCustomer?.BusiType == "Local")
                                                        {
                                                            <th style="width:110px;">CGST %</th>
                                                            <th style="width:110px;">SGST %</th>
                                                        }
                                                        else if(SelectedCustomer?.BusiType == "InterState")
                                                        {
                                                            <th style="width:110px;">IGST %</th>
                                                        }
                                                        if(ExpInvVMs.IsTaxRequired)
                                                        {
                                                              <th style="width:110px;">IGST %</th>
                                                        }
                                                        
                                                    }

                                                    

                                                    <th style="width:130px;">Basic Amount</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    @if(!ExpInvVMs.DcCumInv)
                                                    {
                                                        <th style="width:110px;"> Dc Bal Qty</th>
                                                        <th style="width:110px;">Ref Dc No.</th>
                                                        <th style="width:110px;">Ref Dc Date</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:110px;">Stock Qty</th>
                                                        <th style="width:110px;"> PO Bal Qty</th>
                                                        <th style="width:110px;">Ref PO No.</th>
                                                        <th style="width:110px;">Ref PO Date</th>
                                                        <th style="width:110px;">Type Of PO</th>
                                                    }

                                                    <th style="width:150px;">Cost-Center</th>

                                                    <th style="width:150px;">Weight/Piece</th>
                                                    <th style="width:150px;">Packing Details</th>

                                                    <th style="width:150px;">CreditNote No.</th>
                                                    <th style="width:150px;">CreditNote Date</th>


                                                   @*  @if (!ExpInvVMs.IsCancel)
                                                    {
                                                        <th style="width:130px;">Item Cancel</th>
                                                    } *@
                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">

                                                @if (ExpInvVMs.ExpSubInvVMs != null && ExpInvVMs.ExpSubInvVMs.Any())
                                                {
                                                @foreach (var subitem in ExpInvVMs.ExpSubInvVMs)
                                                {
                                                    <tr @key="subitem" class="@(subitem.ItemCancel ? "table-danger text-danger fw-bold" : "")">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                        @subitem.ItemCode
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId!=0 && subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                        Size="Size.Small"
                                                                                        Color="Color.Primary"
                                                                                        OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId, count))"
                                                                                        Edge="Edge.End"
                                                                                        Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.MeasureUnit</td>
                                                        <td>@subitem.HsnCode</td>

                                                        <!-- Qty -->
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                  <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           step="any"
                                                                           placeholder="Qty"
                                                                           title="Enter Quantity"
                                                                           @bind="subitem.Qty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))"  />
                                                                <ValidationMessage For="@(() => subitem.Qty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.Qty</span>
                                                            }
                                                        </td>

                                                        <!-- Unit Price -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm"  step="any" placeholder="Price" title="Enter Unit Price"
                                                                        @bind="subitem.UnitPrice" @bind:event="oninput"
                                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(ExpInvVMs)' />
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>

                                                        <!-- Line Gross -->
                                                        <td>@FormatDecimal(subitem.LineGross)</td>

                                                        <!-- Discount -->
                                                        @if (!ExpInvVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm"  step="any" placeholder="Disc %" title="Enter Discount %"
                                                                            @bind="subitem.LineDiscountPercent" @bind:event="oninput"
                                                                            @bind:after='() => OnLineDiscountPercentChanged(subitem)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountPercent)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountPercent)
                                                                }
                                                            </td>
                                                            <td>@FormatDecimal(subitem.LineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" step="any" placeholder="Disc Amt" title="Enter Discount Amount"
                                                                            @bind="subitem.LineDiscountAmount" @bind:event="oninput"
                                                                            @bind:after='() => _calculationService.UpdateTotalsAsync(ExpInvVMs)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountAmount)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountAmount)
                                                                }
                                                            </td>
                                                        }

                                                        <!-- Taxes -->
                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if (SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                            <option value="" disabled selected>CGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineCGSTRate)
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                            <option value="" disabled selected>SGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineSGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                            else if (SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @bind="subitem.LineIGSTRate" @bind:event="oninput"
                                                                                @bind:after='() => _calculationService.UpdateTotalsAsync(ExpInvVMs)'>
                                                                            <option value="" disabled selected>IGST %</option>
                                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineIGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                            @if(ExpInvVMs.IsTaxRequired)
                                                            {
                                                                <td>
                                                                        @if (subitem.IsEditable)
                                                                        {
                                                                            <select class="form-select form-select-sm" @bind="subitem.LineIGSTRate" @bind:event="oninput"
                                                                                    @bind:after='() => _calculationService.UpdateTotalsAsync(ExpInvVMs)'>
                                                                                <option value="" disabled selected>IGST %</option>
                                                                                @foreach (var rate in CommonConstants.IGSTRates)
                                                                                {
                                                                                    <option value="@rate">@rate</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        else
                                                                        {
                                                                            @FormatDecimal(subitem.LineIGSTRate)
                                                                        }
                                                                </td>
                                                            }
                                                        }

                                                        

                                                        <!-- Basic Amount -->
                                                        <td>@FormatDecimal(subitem.LineBasicAmount)</td>

                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.Remarks" class="form-control form-control-sm" placeholder="Enter Remarks" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.Remarks
                                                            }
                                                        </td>
                                                        @if(!ExpInvVMs.DcCumInv)
                                                        {
                                                             <!-- Ref Enquiry -->
                                                            <td>@subitem.DcBalQty</td>
                                                            <td>@subitem.RefDcNo</td>
                                                            <td>@subitem.RefDcDate?.ToString("dd/MM/yyyy")</td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-danger">@subitem.StockQty</td>
                                                            <td>@subitem.PoBalQty</td>
                                                            <td>@subitem.RefPoNo</td>
                                                            <td>@subitem.RefPoDate?.ToString("dd/MM/yyyy")</td>
                                                            <td>General Po</td> 
                                                        }


                                                        <!-- Cost Center -->
                                                        <td>
                                                            @if (subitem.IsEditable && (subitem.RefDcSubId == 0 || subitem.RefDcSubId == null) && subitem.Qty == subitem.BalQty)
                                                            {
                                                                <select class="form-select form-select-sm" 
                                                                    value="@subitem.CostId"
                                                                    @onchange="(e => OnCostCenterChanged(e, subitem))">
                                                                    <option value="">select CostCentre</option>
                                                                    @foreach (var cost in CostCenterVMs.Where(c =>
                                                                        !ExpInvVMs.ExpSubInvVMs.Any(r => r != subitem && r.CostId == c.Id)))
                                                                    {
                                                                        <option value="@cost.Id">@cost.ProjectNo</option>
                                                                    }
                                                                </select>
                                                                <ValidationMessage For="@(() => subitem.CostId)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.ProjectNo
                                                            }
                                                        </td>

                                                        <td>
                                                               @subitem.PartWeight
                                                        </td>
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.PackateDetails" class="form-control form-control-sm" placeholder="Packate Details" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.PackateDetails
                                                            }
                                                        </td>


                                                        @if(subitem.CreditNos.Count>0)
                                                        {
                                                             <td>@string.Join(", ", subitem.CreditNos)</td>
                                                             <td>@string.Join(", ", subitem.CreditDates.Select(d => d.ToString("dd/MM/yyyy")))</td>
                                                        }
                                                       



                                                       @*  @if (!ExpInvVMs.IsCancel)
                                                        {
                                                            <td class="text-center align-middle">
                                                                <div class="form-check form-switch d-flex justify-content-center">
                                                                    <InputCheckbox @bind-Value="subitem.ItemCancel"
                                                                    @bind-Value:event="onchange"
                                                                    ValueChanged="@(async (value) => await OnItemCancelChanged(subitem))"
                                                                    class="form-check-input border border-2 shadow-lg 
                                                                                        focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                                </div>
                                                                <ValidationMessage For="@(() => subitem.ItemCancel)"
                                                                class="text-danger fw-semibold small mt-2 d-block" />
                                                            </td>
                                                        }
 *@
                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            @if (!ExpInvVMs.IsCancel)
                                                            {
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                            @onclick="async () => await SaveRow(subitem)">
                                                                        <i class="bi bi-check-lg"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                            @onclick="async () => await CancelEdit(subitem, ExpInvVMs)">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit" 
                                                                            @onclick="async () => await EditRowAsync(subitem)">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete" 
                                                                            @onclick="async () => await RemoveRow(subitem)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                }
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="22" style="height:150px;" class="text-center align-middle text-muted fs-6 fw-semibold">
                                                            <div class="d-flex justify-content-center align-items-center" style="min-height:100px;">
                                                                <i class="bi bi-info-circle me-2 text-secondary"></i>
                                                                No items to display
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
