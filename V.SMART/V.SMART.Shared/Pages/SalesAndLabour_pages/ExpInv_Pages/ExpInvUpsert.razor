    private async Task Cancel()
    {
        try
        {
            if (ExpInvVMs.GrandTotal != ExpInvVMs.Balance)
            {
                await _js.ToastrWarning("Invoice cannot be cancelled — Some transaction are already done.");
                return;
            }

            if (!ExpInvId.HasValue || ExpInvId == 0)
            {
                await _js.ToastrWarning("MfgInvoice  cancel is not allowed before saving the Invoice.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Invoice");
                return;
            }

            if (ExpInvVMs.ExpSubInvVMs.Any(s => s.ItemCancel))
            {
                await _js.ToastrWarning("Invoice cannot be cancelled — one or more items are already cancelled.");
                return;
            }

            bool exist = false;
            foreach (var refId in ExpInvVMs.ExpSubInvVMs)
            {
                exist = await _expInvService.HasAnyItemOrInvoiceCreditNoteAsync(refId.ExpInvSubId);
                if (exist)
                { 
                    await _js.ToastrWarning("Cannot cancel this invoice. Credit Note already exists for this invoice or its items.");
                    return;
                }
            }

            // if(!string.IsNullOrEmpty(ExpInvVMs.ACKNO) && !string.IsNullOrEmpty(ExpInvVMs.IRNNo))
            // {
            //      await _js.ToastrWarning("Cannot delete this invoice. E-Invoice already exists for this invoice or its items.");
            //      return;
            // }



            if (ExpInvVMs.IsCancel)
            {
                var subs = await _expInvService.GetExpInvoiceSubByInvIdAsync(ExpInvVMs.ExpInvId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    await _expInvService.ValidateExpInvoiceBalanceBeforeRevertAsync(sub);
                }
            }
            if (!ExpInvVMs.IsCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Export Invoice?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Export Invoice?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            ExpInvVMs= await _expInvService.GetExpInvoiceByExpInvIdAsync(ExpInvVMs.ExpInvId);
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Export Invoice.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Export Invoice Sales Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
