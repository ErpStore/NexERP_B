    # region Short Close
    private async Task AskToShortCloseAsync(ExpInvVM expinvvm)
    {
        try
        {
            if (expinvvm == null)
            {
                await _js.ToastrError("Invalid Invoice selected.");
                return;
            }

            if (expinvvm.InvTally)
            {
                await _js.ToastrWarning("This Manuafacturing Invoice has already been completed. No further actions are allowed.");
                return;
            }

            if (expinvvm.IsCancel)
            {
                await _js.ToastrWarning("This Manuafacturing Invoice has already been cancelled. No further actions are allowed.");
                return;
            }

            if (!expinvvm.InvShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Export Invoice?";
                btnText = "ShortClose";
                btnColor = "btn-danger";
                confirmation = "Short-Close";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Export Invoice?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "Short-Close";
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while AskToShortCloseAsync Export Invoice.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync() Export Invoice");
        }
        finally
        {
            isProcessing = false;
        }

    }

    private async Task ShortClose()
    {
        if (ExpInvVMs == null)
        {
            await _js.ToastrError("No Manufacturing Invoice selected.");
            return;
        }
        try
        {
            isProcessing = true;
            ExpInvVMs.InvShortClose = !ExpInvVMs.InvShortClose;
            await _expInvService.UpdateExportInvShortCloseAsync(ExpInvVMs);
            StateHasChanged();

            string msg = ExpInvVMs.InvShortClose
                 ? "Export Invoice ShortClose Successfully!"
                 : "Export Invoice ReOpen Successfully!";
            await _js.ToastrSuccess(msg);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while updating ShortClose Export Invoice");
            await LoggingService.LogDeveloperError(ex, "Error in ShortClose() Export Invoice");
        }
        finally
        {
            isProcessing = false;
        }
    }
