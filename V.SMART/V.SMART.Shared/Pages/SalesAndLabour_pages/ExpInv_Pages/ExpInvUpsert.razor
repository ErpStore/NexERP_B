    private async Task OnManufacturingToggle(ChangeEventArgs e)
    {
        bool isChecked = (bool)e.Value;
        ExpInvVMs.DcCumInv = isChecked;

        if (ExpInvVMs.DcCumInv)
        {
            stores = (await _expInvService.GetAllActiveStoresAsync()).ToList();
            await SetStores();
            PoPendingCount = await _expInvService.GetPendingPoCountAsync(ExpInvVMs.CustId.Value);
            DcPendingCount = 0;
            if(ExpInvVMs.DcCumInv)
            {
                ExpInvVMs.TransportMode = 1;
                ExpInvVMs.SubSupplyType = 1;
            }
        }
        else
        {
            stores.Clear();
            ExpInvVMs.StoreIssId = 0;

            ExpInvVMs.TransportMode = 0;
            ExpInvVMs.VehicleNo = "";
            ExpInvVMs.TransFrom = "";
            ExpInvVMs.TransTo = "";

            ExpInvVMs.TransId = "";
            ExpInvVMs.TransName = "";
            ExpInvVMs.TransDocNo = "";

            PoPendingCount = 0;
            DcPendingCount = await _expInvService.GetPendingDcCountAsync(ExpInvVMs.CustId.Value);
        }
        ExpInvVMs.ExpSubInvVMs.Clear();
    }
