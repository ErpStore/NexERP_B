    #region Quantity Handler
    private async Task OnQtyChange(ChangeEventArgs e, ExpInvSubVM SubVM)
    {
        try
        {
            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                SubVM.CrBalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }
            decimal stkqty = 0;
            // NEW quote line
            if (SubVM.ExpInvSubId == 0)
            {
                if (SubVM.RefDcSubId > 0)
                {
                    var dcBalQty = await _expInvService.GetDcItemBalQtyFromDcSubId(SubVM.RefDcSubId.Value);

                    if (newQty <= dcBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;

                        SubVM.CrBalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = dcBalQty;
                        SubVM.BalQty = dcBalQty;

                        SubVM.CrBalQty = dcBalQty;
                        await _js.ToastrWarning($"Qty can't be greater than Dc Balance Qty ({dcBalQty}).");
                        return;
                    }
                }
                else if (SubVM.RefPoSubId > 0)
                {
                    var poBalQty = await _expInvService.GetPoItemBalQtyFromDcSubId(SubVM.RefPoSubId.Value);
                    decimal rcstockqty = 0;
                    if (SubVM.RcSubIds != "" && SubVM.RcSubIds != null)
                    {
                        var ids = SubVM.RcSubIds.Replace("'", "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                        foreach (var rcid in ids)
                        {
                            int.TryParse(rcid.ToString(), out int rsubid);
                            rcstockqty = rcstockqty + await _expInvService.GetAvailableStockByItemIdAndRcAndScreenAsync(SubVM.ItemId, ExpInvVMs.StoreIssId.Value, rsubid);
                        }
                    }

                    var stockDict = (SubVM.RcSubIds != "" && SubVM.RcSubIds != null) ? rcstockqty : await _expInvService.GetStockQtyFromStockManager(SubVM.ItemId, ExpInvVMs.StoreIssId.Value);


                    // var stockDict = await _expInvService.GetStockQtyFromStockManager(SubVM.ItemId, ExpInvVMs.StoreIssId.Value);

                    decimal.TryParse(stockDict.ToString(), out stkqty);
                    decimal possibleQty = Math.Min(stkqty, poBalQty);

                    if (newQty <= possibleQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;

                        SubVM.CrBalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = possibleQty;
                        SubVM.BalQty = possibleQty;

                        SubVM.CrBalQty = possibleQty;
                        await _js.ToastrWarning($"Qty cannot exceed Available Po Bal Qty ({possibleQty}). " + $"[Stock Qty: {stkqty}");
                        return;
                    }

                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty;

                    SubVM.CrBalQty = newQty;
                }



            }
            // EXISTING quote line
            else
            {
                var original = await _expInvService.GetInvSubItemDetailByInvSubIdAsync(SubVM.ExpInvSubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.BalQty = 0;

                    SubVM.CrBalQty = 0;
                    await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefDcSubId > 0)
                {
                    var DcBalQty = await _expInvService.GetDcItemBalQtyFromDcSubId(SubVM.RefDcSubId.Value);
                    var maxAllowedQty = original.Qty + DcBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty - alreadyTransacted;

                        SubVM.CrBalQty = SubVM.BalQty;
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                        return;
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;

                        SubVM.CrBalQty = SubVM.BalQty;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted;

                    SubVM.CrBalQty = SubVM.BalQty;
                }

                if (SubVM.RefPoSubId > 0)
                {
                    var PoBalQty = await _expInvService.GetPoItemBalQtyFromDcSubId(SubVM.RefPoSubId.Value);
                    var maxAllowedQty = original.Qty + PoBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty - alreadyTransacted;

                        SubVM.CrBalQty = SubVM.BalQty;
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                        return;
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                        SubVM.CrBalQty=SubVM.BalQty;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted;

                    SubVM.CrBalQty = SubVM.BalQty;
                }
            }
            await _calculationService.UpdateTotalsAsync(ExpInvVMs);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for ExpInvSubId: {SubVM?.ExpInvSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

