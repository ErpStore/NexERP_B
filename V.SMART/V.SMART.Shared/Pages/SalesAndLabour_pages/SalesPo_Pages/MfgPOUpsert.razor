    #region MFG-PO Operations

    private async Task UpsertPo()
    {
        try
        {
            isProcessing = true;

            MfgPoVMs.MfgPOSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!MfgPoVMs.MfgPOSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a SalesOrder without valid items.");
                return;
            }

            if (AtoGenPo && string.IsNullOrEmpty(MfgPoVMs.SaleOrderNo))
            {
                await _js.ToastrError("Generate the SalesOrder No.");
                return;
            }

            foreach (var line in MfgPoVMs.MfgPOSubVMs)
            {
                bool isValid = await ValidatePOLineAsync(line);
                if (!isValid) return;
            }

            var isNewPo = MfgPoVMs.PoId == 0;

            @if (isNewPo)
            {
                bool isDuplicate = await mfgPoService.IsDuplicatePoAsync(MfgPoVMs.PONo, MfgPoVMs.Suffix, MfgPoVMs.PoId, MfgPoVMs.CustId);
                if (isDuplicate)
                {
                    await _js.ToastrError($"PO No '{MfgPoVMs.PONo}' with Suffix '{MfgPoVMs.Suffix}' already exists.");
                    return;
                }
            }

            try
            {
                await mfgPoService.UpsertPoAsync(MfgPoVMs);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewPo)
                await _js.ToastrSuccess("Sales Order saved successfully.");
            else
                await _js.ToastrSuccess("Sales order updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/mfgPOList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertPo failed.");
            await _js.ToastrError("Error saving Sales Order.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidatePOLineAsync(MfgPoSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }


            if (!MfgPoVMs.IsOpenPO && (!line.Qty.HasValue || line.Qty <= 0))
            {
                await _js.ToastrError($"Item {line.ItemCode}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            if (SelectedCustomer?.LineId == true && (!line.LineNo.HasValue || line.LineNo == 0))
            {
                await _js.ToastrError($"Item {line.ItemCode}: Line No is required.");
                return false;
            }


            // Qty vs Enquiry / Already Transacted validation
            if (line.PoSubId == 0 && line.RefQuoteSubId > 0)
            {
                var enqBalQty = await mfgPoService.GetQuoteItemBalQtyFromQuoteSubId(line.RefQuoteSubId.Value);
                if (line.Qty > enqBalQty)
                {
                    line.Qty = enqBalQty;
                    line.BalQty = enqBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed Enquiry Balance Qty ({enqBalQty}).");
                    return false;

                }
            }
            else if (line.PoSubId > 0)
            {
                var original = await mfgPoService.GetPoSubItemDetailByPoSubIdAsync(line.PoSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty.GetValueOrDefault();
                    decimal origQty = original.Qty.GetValueOrDefault();
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;

                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidatePOLineAsync failed.");
            await _js.ToastrError("Error Validate Manufacturing-PO line.");
            return false;
        }
    }

