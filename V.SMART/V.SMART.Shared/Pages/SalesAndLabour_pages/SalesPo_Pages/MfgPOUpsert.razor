            {
                await _js.ToastrWarning("Po not found.");
                return;
            }

            SelectedCustomer = await mfgPoService.GetCustomerByIdAsync(MfgPoVMs.CustId);
            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

            if (MfgPoVMs.CurrId > 0)
                await ApplyCurrencyChange(MfgPoVMs.CurrId.Value);

            foreach (var poSub in MfgPoVMs.MfgPOSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[poSub.ItemId.Value] =
                    await mfgPoService.GetCorrespondenceAttachmentsCountAsync(poSub.ItemId.Value, "Item");

                if (IsLabourCost)
                {
                    if (poSub.UnitPrice < poSub.LabourCost)
                    {
                        _js.ToastrWarning(
                            $"Unit Price ({poSub.UnitPrice:0.00}) Is less than Labour Cost ({poSub.LabourCost:0.00})."
                        );
                    }
                    else if (poSub.UnitPrice > poSub.LabourCost)
                    {
                        _js.ToastrWarning(
                        $"Unit Price ({poSub.UnitPrice:0.00}) Is  Greater than than Labour Cost ({poSub.LabourCost:0.00})."
                    );

