    private async Task CancelItem(MfgPoSubVM rowToCancel)
    {
        if (rowToCancel == null || isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            bool isCancelling = !rowToCancel.ItemCancel;

            if (isCancelling && string.IsNullOrWhiteSpace(cancelReason))
            {
                await _js.ToastrWarning("Cancel reason is required.");
                return;
            }

            rowToCancel.ItemCancel = isCancelling;
            rowToCancel.ItemCancelReason = isCancelling ? cancelReason : string.Empty;

            await mfgPoService.UpdateItemCancelAndAddorRevertAsync(
                rowToCancel,
                PoId.GetValueOrDefault()
            );

            string actionText = isCancelling ? "Cancelled" : "Reverted";

            await LoggingService.LogUserAction(
                username,
                machine,
                ip,
                screen: "Sales Order",
                action: $"{actionText} PO No: {MfgPoVMs.PONo}, ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {(isCancelling ? cancelReason : "Reverted")}"
            );

            MfgPoVMs = await mfgPoService.GetPoByPoIdAsync(MfgPoVMs.PoId);

            await ResetSlno();
            await _calculationService.UpdateTotalsAsync(MfgPoVMs);

            await _js.ToastrSuccess($"Item has been {actionText.ToLower()} successfully.");

            cancelReason = string.Empty;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            MfgPoVMs = await mfgPoService.GetPoByPoIdAsync(MfgPoVMs.PoId);
            await _js.ToastrWarning(ex.Message);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the item.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Revert failed for POId: {MfgPoVMs?.PoId}");
        }
        finally
        {
            rowToCancel = null;
            isProcessing = false;
        }
    }


    private async Task CancelPO()
    {
        if (isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (MfgPoVMs == null || MfgPoVMs.PoId == 0)
            {
                await _js.ToastrWarning("Please select a valid PO.");
                return;
            }

            bool isCancelling = !MfgPoVMs.PoCancl;

            if (isCancelling && string.IsNullOrWhiteSpace(cancelReason))
            {
                await _js.ToastrWarning("Cancel reason is required.");
                return;
            }

            MfgPoVMs.PoCancl = isCancelling;
            MfgPoVMs.CancelDate = isCancelling ? DateTime.Now : null;
            MfgPoVMs.CancelReason = isCancelling ? cancelReason : string.Empty;
            MfgPoVMs.CancelBy = isCancelling ? username : string.Empty;

            await mfgPoService.UpdatedCancelStatusAndAddOrRevertQty(MfgPoVMs);

            string actionText = isCancelling ? "Cancelled" : "Reverted";

            await LoggingService.LogUserAction(
                UserName: username,
                Machine: machine,
                IP_Address: ip,
                screen: "Manufacturing PO",
                action: $"{actionText} PO No: {MfgPoVMs.PONo}",
                additionalInfo: $"PO Id: {MfgPoVMs.PoId}"
            );

            await _js.ToastrSuccess($"PO has been {actionText.ToLower()} successfully.");

            // Reload updated PO
            MfgPoVMs = await mfgPoService.GetPoByPoIdAsync(MfgPoVMs.PoId);

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            MfgPoVMs = await mfgPoService.GetPoByPoIdAsync(MfgPoVMs.PoId);
            await _js.ToastrWarning(ex.Message);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the PO.");
            await LoggingService.LogDeveloperError(ex, $"CancelPO failed for POId: {MfgPoVMs?.PoId}");
        }
        finally
        {
            isProcessing = false;
        }
    }



    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.PoSubId > 0)
            {
                await mfgPoService.DeleteAndResequenceAsync(rowToDelete, MfgPoVMs);

                MfgPoVMs = await mfgPoService.GetPoByPoIdAsync(MfgPoVMs.PoId);
            }
            else
            {
                MfgPoVMs.MfgPOSubVMs.Remove(rowToDelete);

                if (!MfgPoVMs.MfgPOSubVMs.Any())
                {
                    MfgPoVMs.MfgPOSubVMs.Add(new MfgPoSubVM
                    {
                        PoId = MfgPoVMs.PoId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < MfgPoVMs.MfgPOSubVMs.Count; i++)
                        MfgPoVMs.MfgPOSubVMs[i].SlNo = i + 1;
                }
            }

            await _calculationService.UpdateTotalsAsync(MfgPoVMs);

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for PoId: {MfgPoVMs.PoId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

