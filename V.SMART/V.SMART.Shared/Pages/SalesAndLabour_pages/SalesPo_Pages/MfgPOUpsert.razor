    private async Task ApplyCustomerSelectionAsync(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;
            MfgPoVMs.CustId = customer?.CustId ?? 0;
            MfgPoVMs.CustName = customer?.CustName;
            MfgPoVMs.CustAddress = customer?.CustAddr;
            MfgPoVMs.CustGst = customer?.GSTNo;
            MfgPoVMs.CustContactNo = customer?.ContactNo;

            if (customer == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                CostCenterVMs.Clear();
                await ResetQuoteDefaults();
                return;
            }

            contactPersons = await mfgPoService.GetContactPersonsAsync(customer.CustId);
            consineeAddress = await mfgPoService.GetConsigneeAddressesAsync(customer.CustId);

            var usedCostCenters = MfgPoVMs.MfgPOSubVMs
                .Where(x => x.CostId.HasValue && (x.RefQuoteSubId == null || x.RefQuoteSubId == 0))
                .Select(x => x.CostId.Value)
                .ToHashSet();

            CostCenterVMs = await mfgPoService.GetCostCenterDetailsByCustId(customer.CustId, usedCostCenters);

            MfgPoVMs.KindOfAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPersonName : string.Empty;

            // Tax logic
            if (!customer.TaxValidate)
            {
                var lastQuote = await mfgPoService.GetLastPoAsync(customer.CustId);
                if (lastQuote != null)
                {
                    MfgPoVMs.CGstRate = lastQuote.CGstRate;
                    MfgPoVMs.SGstRate = lastQuote.SGstRate;
                    MfgPoVMs.IGstRate = lastQuote.IGstRate;
                }
                else
                {
                    if (string.Equals(customer.BusiType, "Local", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false)
                    {
                        MfgPoVMs.CGstRate = CommonConstants.GetGST(9.000m);
                        MfgPoVMs.SGstRate = CommonConstants.GetGST(9.000m);
                        MfgPoVMs.IGstRate = CommonConstants.GetIGST(0.000m);
                    }
                    else if (string.Equals(customer.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false)
                    {
                        MfgPoVMs.CGstRate = CommonConstants.GetGST(0.000m);
                        MfgPoVMs.SGstRate = CommonConstants.GetGST(0.000m);
                        MfgPoVMs.IGstRate = CommonConstants.GetIGST(18.000m);
                    }
                }
            }

            // Currency
            MfgPoVMs.CurrId = (customer.CurrId.HasValue && customer.CurrId > 0) ? customer.CurrId.Value : 1;
            await ApplyCurrencyChange(MfgPoVMs.CurrId.Value);

            //Pending QuotationDetails
            quotePendingCount = await mfgPoService.GetPendingQuoteCountAsync(customer.CustId);


            // Update totals
            await _calculationService.UpdateTotalsAsync(MfgPoVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {customer?.CustId}");
            await _js.ToastrError("Failed to apply customer selection. Please try again.");
        }
