@page "/MfgPO/create"
@page "/MfgPO/create/{CustId:int}"
@page "/MfgPO/update/{PoId:int}"

@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using MudBlazor
@inject ReportService reportService

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IMfgPoService mfgPoService
@inject ILoggingService LoggingService
@inject ICostingService _CostingService

@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="Quotation Details"
              Columns="@QuoteColumns"
              ColumnFields="@QuoteFields"
              HiddenColumns="@QuoteHiddenColumns"
              Data="@QuoteData"
              IsVisible="@IsQuoteModalVisible"
              IsVisibleChanged="@((val) => IsQuoteModalVisible = val)"
              OnSelectedItems="OnQuoteSelectedAsync">
</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isCustModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "ExcelUpload")
    {
        <ExcelUpload isModelVisible=true OnClose="CloseModal" CustomerId=CustId uploadType="SalesPo" OnUploadCompleted="ReceiveItems" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Terms")
    {
        <TermsUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
    else if (ActiveModal == "POType")
    {
        <PoTypeUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "OA")
    {
        <OrderAccecptance MfgPoVMs="MfgPoVMs" />
        <div class="modal-footer">
            <button class="btn btn-primary" @onclick="SaveOrderAcceptance" disabled="@isProcessing">
                <i class="bi bi-save me-1"></i> @OAbuttonText
            </button>

            <button class="btn btn-info text-white" @onclick="PrintOrderAcceptance" disabled="@isProcessing">
                <i class="bi bi-printer me-1"></i> Print
            </button>

            <button class="btn btn-secondary" @onclick="CloseModal" disabled="@isProcessing">
                <i class="bi bi-x-circle me-1"></i> Close
            </button>
        </div>
    }
</MasterModal>


<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if (MfgPoVMs.PoCancl)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (MfgPoVMs.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }

            <PageHeader TitleText="@(MfgPoVMs.PoId > 0 ? "Update Sales Order" : "Create Sales Order")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@PoFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="MfgPoVMs" OnValidSubmit="UpsertPo">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">

                            <!-- Manufacturing / Labour -->
                            <div class="col-12 col-lg-6">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-body">

                                        <div class="d-flex flex-column flex-md-row justify-content-around align-items-md-center gap-3">

                                            <!-- Manufacturing -->
                                            <div class="form-check form-switch d-flex align-items-center gap-2">

                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="ManufacturingSwitch"
                                                       checked="@MfgPoVMs.MfgORLab"
                                                       @onchange="OnManufacturingToggle"
                                                       disabled="@IsSomeItemsTransMade" />

                                                <label class="form-check-label fw-semibold @(MfgPoVMs.MfgORLab ? "text-success" : "text-secondary")"
                                                       for="ManufacturingSwitch">

                                                    <i class="bi bi-gear-fill me-1"></i>
                                                    Manufacturing

                                                </label>

                                            </div>

                                            <!-- Labour -->
                                            <div class="form-check form-switch d-flex align-items-center gap-2">

                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="LabourSwitch"
                                                       checked="@(!MfgPoVMs.MfgORLab)"
                                                       @onchange="OnLabourToggle"
                                                       disabled="@IsSomeItemsTransMade" />

                                                <label class="form-check-label fw-semibold @(!MfgPoVMs.MfgORLab ? "text-danger" : "text-secondary")"
                                                       for="LabourSwitch">

                                                    <i class="bi bi-people-fill me-1"></i>
                                                    Labour

                                                </label>

                                            </div>

                                        </div>

                                        <ValidationMessage For="@(() => MfgPoVMs.MfgORLab)" />

                                    </div>
                                </div>
                            </div>

                            <!-- Open PO -->
                            @if (!MfgPoVMs.MfgPOSubVMs.Any(x => x.RefQuoteSubId > 0))
                            {
                                <div class="col-12 col-md-3 col-lg-2">

                                    <div class="card shadow-sm border-0 h-100">
                                        <div class="card-body d-flex align-items-center justify-content-center">

                                            <div class="form-check form-switch d-flex align-items-center gap-2">

                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="OpenPOSwitch"
                                                       checked="@MfgPoVMs.IsOpenPO"
                                                       disabled="@MfgPoVMs.MfgPOSubVMs.Any(x => !string.IsNullOrEmpty(x.ItemCode))"
                                                       @onchange="OnOpenPOToggle" />

                                                <label class="form-check-label fw-semibold @(MfgPoVMs.IsOpenPO ? "text-primary" : "text-secondary")"
                                                       for="OpenPOSwitch">

                                                    <i class="bi bi-folder2-open me-1"></i>
                                                    Open PO

                                                </label>

                                            </div>

                                        </div>
                                    </div>

                                </div>
                            }

                            <!-- Service Bill -->
                            <div class="col-12 col-md-3 col-lg-2">

                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-body d-flex align-items-center justify-content-center">

                                        <div class="form-check form-switch d-flex align-items-center gap-2">

                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="ServiceBillSwitch"
                                                   checked="@(MfgPoVMs.IsServiceBill ?? false)"
                                                   disabled="@MfgPoVMs.MfgPOSubVMs.Any(x => !string.IsNullOrEmpty(x.ItemCode))"
                                                   @onchange="OnServiceBillToggle" />

                                            <label class="form-check-label fw-semibold @((MfgPoVMs.IsServiceBill ?? false) ? "text-primary" : "text-secondary")"
                                                   for="ServiceBillSwitch">

                                                <i class="bi bi-receipt me-1"></i>
                                                Service Bill

                                            </label>

                                        </div>

                                    </div>
                                </div>

                            </div>


                      

                        <!-- Correspondence Status -->
                        <div class="col-12 col-lg-2 d-flex justify-content-end align-items-center">
                            @if (MfgPoVMs.PoId > 0 && !string.IsNullOrWhiteSpace(MfgPoVMs.PONo))
                            {
                                <CorrespondenceStatus ReferenceType="Manufacturing-PO"
                                                      ReferenceId="@MfgPoVMs.PoId"
                                                      ReferenceTypeName="@MfgPoVMs.PONo" />
                            }
                        </div>

                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Customer Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Customer")'>
                                        <i class="bi bi-person-add me-1"></i> Add Customer
                                    </button>
                                </div>

                                <div class="card-body">
                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="CustomerVM"
                                                             Value="SelectedCustomer"
                                                             ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                             ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                             SearchFunc="SearchCustomers"
                                                             Dense="true"
                                                             Variant="Variant.Outlined"
                                                             Placeholder="Search Customer"
                                                             Title="Search atleast 3 letters in Customer"
                                                             Class="w-100 autocomplete-sm"
                                                             MaxItems="50"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             Required="true"
                                                             AvoidSubmit="true"
                                                             Disabled="@IsSomeItemsTransMade" />
                                        </div>
                                    </div>

                                    <!-- Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                  rows="1" readonly>@MfgPoVMs?.CustAddress</textarea>
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Phone No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@MfgPoVMs?.CustContactNo" readonly />
                                        </div>
                                    </div>

                                    <!-- GSTIN -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GSTIN</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@MfgPoVMs?.CustGst" readonly />
                                        </div>
                                    </div>

                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    @bind="@MfgPoVMs.KindOfAttention">
                                                <option disabled value="">Select Contact Person</option>
                                                @foreach (var cp in contactPersons)
                                                {
                                                    <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => MfgPoVMs.KindOfAttention)" />
                                        </div>
                                    </div>

                                    <!-- Shipping Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Shipping Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="form-check form-switch d-flex align-items-center">
                                                <input class="form-check-input" type="checkbox" id="SameAsShipping"
                                                       checked="@MfgPoVMs.IsSameAsShipping"
                                                       @onchange="OnShippingChange" />
                                                <label class="form-check-label ms-2 fw-semibold"
                                                       for="SameAsShipping">Same as Shipping</label>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!MfgPoVMs.IsSameAsShipping)
                                    {
                                        <!-- Shipping To -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Shipping To</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select value="@MfgPoVMs.ShipAddrsId"
                                                        class="form-select form-select-sm rounded-3 w-100"
                                                        @onchange="OnConsigneeChangedAsync">
                                                    <option value="">Select Shipping Address</option>
                                                    @foreach (var consine in consineeAddress)
                                                    {
                                                        <option value="@consine.AltCustId">@consine.AltCustName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        @if (MfgPoVMs.ShipAddrsId > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Address</small>
                                                </label>
                                                <div class="col-12 col-lg-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@MfgPoVMs.ShippingAddress" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Contact No</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@MfgPoVMs.ShippingContactNo" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>GSTIN</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@MfgPoVMs.ShippingGstin" readonly />
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- =================== PO Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark px-3 py-2">

                                    <!-- Title -->
                                    <span class="fw-bold fs-6">
                                        <i class="bi bi-receipt me-1"></i> Sales Order Details
                                    </span>

                                    @if (MfgPoVMs.PoId > 0 && (CanCreate || CanEdit))
                                    {
                                        <div class="d-flex align-items-center gap-2">

                                            @if (MfgPoVMs.MfgPOSubVMs == null ||
                                                                                !MfgPoVMs.MfgPOSubVMs.Any(x => x.ItemCancel))
                                            {
                                                <!-- Cancel / Revert -->
                                                <button type="button"
                                                        class="btn btn-sm px-3 rounded-3 d-flex align-items-center
                                                                                           @(MfgPoVMs.PoCancl ? "btn-success" : "btn-danger")"
                                                        @onclick="Cancel"
                                                        disabled="@MfgPoVMs.ShortClose">

                                                    @if (!MfgPoVMs.PoCancl)
                                                    {
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        <span>Cancel</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                        <span>Revert</span>
                                                    }
                                                </button>
                                            }

                                            <!-- Short Closed / Re-Open -->
                                            <button type="button"
                                                    class="btn btn-sm px-3 rounded-3 d-flex align-items-center
                                                                           @(MfgPoVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                    @onclick="() => AskToShortCloseAsync(MfgPoVMs)"
                                                    disabled="@MfgPoVMs.PoCancl">

                                                @if (!MfgPoVMs.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Closed</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>

                                        </div>
                                    }
                                </div>


                                <div class="card-body">

                                    <!-- Auto generate PONO-->
                                    @if (AtoGenPo)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>SalesOrder No.</small>
                                            </label>

                                            <div class="col-12 col-sm-9">
                                                <div class="input-group input-group-sm rounded-3 w-100">
                                                    <select class="form-select form-select-sm"
                                                            value="@MfgPoVMs.PoTypeId"
                                                            @onchange="OnPoTypeChanged">
                                                        <option value="">-- Select PoType --</option>
                                                        @foreach (var poType in poTypes)
                                                        {
                                                            <option value="@poType.Id">@poType.TypeName</option>
                                                        }
                                                    </select>

                                                    <!-- Auto-generated Sale Order No -->
                                                    <InputText class="form-control form-control-sm"
                                                               placeholder="AutoGenerate PO No."
                                                               @bind-Value="@MfgPoVMs.SaleOrderNo"
                                                               readonly />

                                                    <!-- Add New PoType Button -->
                                                    <button type="button" class="btn btn-outline-primary btn-sm"
                                                            @onclick="AddPoType">
                                                        <i class="bi bi-plus-circle me-1"></i> Add
                                                    </button>
                                                </div>
                                                <ValidationMessage For="@(() => MfgPoVMs.PoTypeId)" />
                                            </div>
                                        </div>
                                    }

                                    <!--Incoming PO No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Incoming PO No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                           placeholder="Incoming PO No."
                                                           maxlength="30"
                                                           @bind-Value="@MfgPoVMs.PONo" />
                                                <span class="input-group-text rounded-3">@MfgPoVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => MfgPoVMs.PONo)" />
                                        </div>
                                    </div>

                                    <!-- PO Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Incoming PO Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@MfgPoVMs.PODate" />
                                            <ValidationMessage For="@(() => MfgPoVMs.PODate)" />
                                        </div>
                                    </div>

                                    <!-- Reference Quotation -->
                                    @if (quotePendingCount > 0 && !MfgPoVMs.IsOpenPO && !MfgPoVMs.PoCancl && !MfgPoVMs.ShortClose)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. Quotation</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowQuotationDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Quotation Details
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Currency -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Currency</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value="@MfgPoVMs.CurrId"
                                                    @onchange="OnCurrencyChanged"
                                                    disabled>
                                                @foreach (var currency in Currencies)
                                                {
                                                    <option value="@currency.CurrId">@currency.CurrName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Payment Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Payment Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="MfgPoVMs.PayTerms"></textarea>
                                            <ValidationMessage For="@(() => MfgPoVMs.PayTerms)" />
                                        </div>
                                    </div>

                                    <!-- Delivery Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Delivery Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="MfgPoVMs.DeliveryTerms"></textarea>
                                            <ValidationMessage For="@(() => MfgPoVMs.DeliveryTerms)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="MfgPoVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => MfgPoVMs.MainRemark)" />
                                        </div>
                                    </div>

                                    @if (MfgPoVMs.PoCancl)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                          rows="1"
                                                          @bind="MfgPoVMs.CancelReason"
                                                          readonly></textarea>
                                                <ValidationMessage For="@(() => MfgPoVMs.CancelReason)" />
                                            </div>
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Date</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="date" class="form-control form-control-sm rounded-3 w-100"
                                                       @bind="MfgPoVMs.CancelDate"
                                                       readonly></input>
                                                <ValidationMessage For="@(() => MfgPoVMs.CancelDate)" />
                                            </div>
                                        </div>
                                    }

                                    <!-- Rejection & Re-track Required Checkbox -->
                                    <div class="form-check mt-1">
                                        <InputCheckbox @bind-Value="MfgPoVMs.isRejTrackReq"
                                                       id="isRejectionReq"
                                                       class="form-check-input"
                                                       disabled="@IsSomeItemsTransMade" />
                                        <label class="form-check-label text-danger"
                                               for="isRejectionReq"
                                               title="Check this if rejection and re-tracking are required for this PO">
                                            Rejection & Re-track Required
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header bg-primary-subtle text-dark">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                                        <!-- Title -->
                                        <span class="fw-bold fs-6">Item Details</span>

                                        <!-- Right Controls -->
                                        <div class="d-flex flex-wrap align-items-center gap-2">

                                            <!-- Due Date + Update -->
                                            <div class="d-flex align-items-center gap-2">
                                                <label class="mb-0 fw-semibold">Due Date:</label>
                                                <InputDate @bind-Value="DueDate" class="form-control form-control-sm" style="width:150px;" />
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="UpdateDueDate">
                                                    <i class="bi bi-pencil-square me-1"></i> Update
                                                </button>
                                            </div>

                                            <!-- Discount Toggle -->
                                            <div class="d-flex align-items-center gap-2">
                                                <label class="mb-0"><small>Discount:</small></label>
                                                <div class="btn-group btn-group-sm rounded-pill border" role="group">
                                                    <input type="radio" class="btn-check" name="toggleDiscount" id="discountToggleRs"
                                                           @onchange='() => SetDiscountMode(true)'
                                                           checked="@MfgPoVMs.IsItemWiseDiscAmtOrPerReq" />
                                                    <label class="btn btn-outline-primary rounded-start-pill" for="discountToggleRs">@MfgPoVMs.Symbol</label>

                                                    <input type="radio" class="btn-check" name="toggleDiscount" id="discountTogglePercent"
                                                           @onchange='() => SetDiscountMode(false)'
                                                           checked="@(!MfgPoVMs.IsItemWiseDiscAmtOrPerReq)" />
                                                    <label class="btn btn-outline-primary rounded-end-pill" for="discountTogglePercent">%</label>
                                                </div>
                                            </div>

                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                        type="button"
                                                        data-bs-toggle="dropdown">
                                                    <i class="bi bi-layout-three-columns"></i> Columns
                                                </button>

                                                <div class="dropdown-menu p-2" style="max-height:300px;overflow-y:auto;min-width:250px;">
                                                    @foreach (var col in Columns.OrderBy(x => x.Title))
                                                    {
                                                        <div class="form-check">
                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   checked="@col.IsVisible"
                                                                   @onchange="@(async (e) => await OnColumnChanged(col, e))" />

                                                            <label class="form-check-label">
                                                                @col.Title
                                                            </label>
                                                        </div>
                                                    }

                                                </div>
                                            </div>
                                            <!-- Add Item Button -->
                                            <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>

                                        </div>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="max-height:600px; overflow-x:auto; overflow-y:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    @if (ShowColumn(nameof(MfgPoSubVM.SlNo)))
                                                    {
                                                        <th style="width:50px;">Sl.No</th>
                                                    }
                                                    @if (SelectedCustomer?.LineId == true)
                                                    {
                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineNo)))
                                                        {
                                                            <th style="width:70px;">Line NO.</th>
                                                        }
                                                    }

                                                    @if (ShowColumn(nameof(MfgPoSubVM.ItemCode)))
                                                    {
                                                        <th style="width:250px;">Item Code</th>
                                                    }

                                                    @if (ShowColumn(nameof(MfgPoSubVM.ItemName)))
                                                    {
                                                        <th style="width:200px;">Item Name</th>

                                                    }

                                                    @if (ShowColumn(nameof(MfgPoSubVM.ItemSpecification)))
                                                    {
                                                        <th style="width:250px;">Item Specification</th>
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.MeasureUnit)))
                                                    {
                                                        <th style="width:60px;">UOM</th>
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.HSNCode)))
                                                    {
                                                        <th style="width:70px;">HSN</th>
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.Qty)))
                                                    {
                                                        <th style="width:120px;">Qty</th>
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.UnitPrice)))
                                                    {
                                                        <th style="width:120px;">Unit Price</th>
                                                    }

                                                    @if (IsLabourCost)
                                                    {
                                                        @if (ShowColumn(nameof(MfgPoSubVM.LabourCost)))
                                                        {
                                                            <th style="width:100px;">LabourCost</th>
                                                        }
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.LineGross)))
                                                    {
                                                        <th style="width:130px;">Gross Amount</th>
                                                    }

                                                    @if (!MfgPoVMs.IsItemWiseDiscAmtOrPerReq)
                                                    {
                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineDiscountPercent)))
                                                        {
                                                            <th style="width:110px;">Disc %</th>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineDiscountAmount)))
                                                        {
                                                            <th style="width:110px;">Disc Amt</th>
                                                        }
                                                    }
                                                    else
                                                    {

                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineDiscountAmount)))
                                                        {
                                                            <th style="width:110px;">Disc Amt</th>
                                                        }
                                                    }

                                                    @if (SelectedCustomer?.TaxValidate == false)
                                                    {
                                                        @if (SelectedCustomer?.BusiType == "Local")
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LineCGSTRate)))
                                                            {
                                                                <th style="width:110px;">CGST %</th>
                                                            }
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LineSGSTRate)))
                                                            {
                                                                <th style="width:110px;">SGST %</th>
                                                            }
                                                        }
                                                        else if (SelectedCustomer?.BusiType == "InterState")
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LineIGSTRate)))
                                                            {
                                                                <th style="width:110px;">IGST %</th>
                                                            }
                                                        }
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.LineBasicAmount)))
                                                    {
                                                        <th style="width:130px;">Basic Amount</th>
                                                    }
                                                    @if (SelectedCustomer?.IsWoNoReq==true)
                                                    {
                                                        @if (ShowColumn(nameof(MfgPoSubVM.WoNO)))
                                                        {
                                                            <th style="width:140px;">WO No.</th>
                                                        }
                                                    }
                                                    @if (SelectedCustomer?.LineId==true)
                                                    {
                                                        @if (ShowColumn(nameof(MfgPoSubVM.PoDate)))
                                                        {
                                                            <th style="width:130px;"> Po Date</th>
                                                        }
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.DueDate)))
                                                    {
                                                        <th style="width:130px;"> Due Date</th>
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.Remark)))
                                                    {
                                                        <th style="width:200px;">Remarks</th>
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.RefQuoteNo)))
                                                    {
                                                        <th style="width:110px;">Ref Quote No.</th>
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.RefQuoteDate)))
                                                    {
                                                        <th style="width:110px;">Ref Quote Dt.</th>
                                                    }
                                                    @if (ShowColumn(nameof(MfgPoSubVM.ProjectNo)))
                                                    {
                                                        <th style="width:150px;">Cost-Center</th>
                                                    }
                                                    @if (!MfgPoVMs.PoCancl && (PoId.HasValue || PoId > 0))
                                                    {
                                                        @if (ShowColumn(nameof(MfgPoSubVM.ItemCancel)))
                                                        {
                                                            <th style="width:130px;">Item Cancel</th>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.IsAnnexure)))
                                                        {
                                                            <th style="width:130px;">IsAnnexure</th>
                                                        }
                                                    }
                                                    @if (!MfgPoVMs.PoCancl && !MfgPoVMs.ShortClose)
                                                    {
                                                        <th style="width:140px;"
                                                            class="freeze-last-col">

                                                            <div class="d-flex align-items-center justify-content-end gap-2">

                                                                <button type="button"
                                                                        class="btn btn-sm @(IsAllEditable
                                                                                                                                                                                                 ? "btn-success"
                                                                                                                                                                                                 : "btn-danger")"
                                                                title="Lock / Unlock All Rows"
                                                                @onclick="ToggleAllEditable">

                                                                    <i class="bi @(IsAllEditable
                                                                                                                                                                   ? "bi-unlock-fill"
                                                                                                                                                                   : "bi-lock-fill")"></i>

                                                        </button>

                                                                <span>Action</span>

                                                            </div>

                                                        </th>

                                                                                                }
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">

                                                @foreach (var subitem in MfgPoVMs.MfgPOSubVMs)
                                                {
                                                    <tr @key="subitem" class="@(subitem.ItemCancel ? "table-danger text-danger fw-bold" : "")">

                                                        @if (ShowColumn(nameof(MfgPoSubVM.SlNo)))
                                                        {
                                                            <td>@subitem.SlNo</td>
                                                        }

                                                        <!-- Line No -->
                                                        @if (SelectedCustomer?.LineId==true)
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LineNo)))
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <input type="number"
                                                                               step="any"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="RFQ"
                                                                               title="Enter RFQ"
                                                                               @bind="subitem.LineNo" />
                                                                        <ValidationMessage For="@(() => subitem.LineNo)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.LineNo
                                                                    }
                                                                </td>
                                                            }
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.ItemCode)))
                                                        {
                                                            <!-- Item Code + Attachments -->
                                                            <td>
                                                                <div class="row g-1 align-items-center">
                                                                    <div class="col-10">
                                                                        @if (subitem.IsEditable && subitem.CanEditItem)
                                                                        {
                                                                            <MudAutocomplete T="ItemVM"
                                                                                             Value="subitem.SelectedItem"
                                                                                             ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                             ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                             SearchFunc="SearchItems"
                                                                                             Dense="true"
                                                                                             Variant="Variant.Outlined"
                                                                                             Placeholder="Search Item Code"
                                                                                             Title="Search Atleast 3 Letters in Item-Code"
                                                                                             Class="w-100 autocomplete-sm"
                                                                                             MaxItems="50" />
                                                                            <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                        }
                                                                        else
                                                                        {
                                                                            @subitem.ItemCode
                                                                        }
                                                                    </div>
                                                                    <div class="col-2 text-center">
                                                                        @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                                                                                    && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                           Size="Size.Small"
                                                                                           Color="Color.Primary"
                                                                                           OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                           Edge="Edge.End"
                                                                                           Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.ItemName)))
                                                        {
                                                            <td>@subitem.ItemName</td>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.ItemSpecification)))
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="text"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Item Specification"
                                                                           title="Enter Item Specification"
                                                                           @bind="subitem.ItemSpecification"
                                                                           @bind:event="oninput" />

                                                                    <ValidationMessage For="@(() => subitem.ItemSpecification)" />
                                                                }
                                                                else
                                                                {
                                                                    <span>@subitem.ItemSpecification</span>
                                                                }
                                                            </td>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.MeasureUnit)))
                                                        {
                                                            <td>@subitem.MeasureUnit</td>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.HSNCode)))
                                                        {
                                                            <td>@subitem.HSNCode</td>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.Qty)))
                                                        {

                                                            <!-- Qty -->
                                                            <td>

                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           step="any"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Qty"
                                                                           title="Enter Quantity"
                                                                           @bind="subitem.Qty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                    <ValidationMessage For="@(() => subitem.Qty)" />
                                                                }
                                                                else
                                                                {
                                                                    <span>@subitem.Qty</span>
                                                                }
                                                            </td>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.UnitPrice)))
                                                        {
                                                            <!-- Unit Price -->
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           step="any"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Price" title="Enter Unit Price"
                                                                           @bind="subitem.UnitPrice" @bind:event="oninput"
                                                                           @bind:after='() => _calculationService.UpdateTotalsAsync(MfgPoVMs)' />
                                                                    <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.UnitPrice)
                                                                }
                                                            </td>
                                                        }
                                                        @if (IsLabourCost)
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LabourCost)))
                                                            {
                                                                <td>@subitem.LabourCost</td>
                                                            }
                                                        }

                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineGross)))
                                                        {
                                                            <!-- Line Gross -->
                                                            <td>@FormatDecimal(subitem.LineGross)</td>
                                                        }
                                                        <!-- Discount -->
                                                        @if (!MfgPoVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LineDiscountPercent)))
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <input type="number"
                                                                               step="any"
                                                                               class="form-control form-control-sm" placeholder="Disc %" title="Enter Discount %"
                                                                               @bind="subitem.LineDiscountPercent" @bind:event="oninput"
                                                                               @bind:after='() => OnLineDiscountPercentChanged(subitem)' />
                                                                        <ValidationMessage For="@(() => subitem.LineDiscountPercent)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineDiscountPercent)
                                                                    }
                                                                </td>

                                                            }
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LineDiscountAmount)))
                                                            {
                                                                <td>@FormatDecimal(subitem.LineDiscountAmount)</td>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LineDiscountAmount)))
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <input type="number"
                                                                               step="any"
                                                                               class="form-control form-control-sm" placeholder="Disc Amt" title="Enter Discount Amount"
                                                                               @bind="subitem.LineDiscountAmount" @bind:event="oninput"
                                                                               @bind:after='() => _calculationService.UpdateTotalsAsync(MfgPoVMs)' />
                                                                        <ValidationMessage For="@(() => subitem.LineDiscountAmount)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineDiscountAmount)
                                                                    }

                                                                </td>
                                                            }
                                                        }

                                                        <!-- Taxes -->
                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if (SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                @if (ShowColumn(nameof(MfgPoSubVM.LineCGSTRate)))
                                                                {
                                                                    <td>
                                                                        @if (subitem.IsEditable)
                                                                        {
                                                                            <select class="form-select form-select-sm"
                                                                                    value="@subitem.LineCGSTRate"
                                                                                    @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                                <option value="" disabled selected>CGST %</option>
                                                                                @foreach (var rate in CommonConstants.GSTRates)
                                                                                {
                                                                                    <option value="@rate">@rate</option>
                                                                                }
                                                                            </select>
                                                                            <ValidationMessage For="@(() => subitem.LineCGSTRate)" />
                                                                        }
                                                                        else
                                                                        {
                                                                            @FormatDecimal(subitem.LineCGSTRate)
                                                                        }
                                                                    </td>
                                                                }
                                                                @if (ShowColumn(nameof(MfgPoSubVM.LineSGSTRate)))
                                                                {
                                                                    <td>
                                                                        @if (subitem.IsEditable)
                                                                        {
                                                                            <select class="form-select form-select-sm"
                                                                                    value="@subitem.LineSGSTRate"
                                                                                    @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                                <option value="" disabled selected>SGST %</option>
                                                                                @foreach (var rate in CommonConstants.GSTRates)
                                                                                {
                                                                                    <option value="@rate">@rate</option>
                                                                                }
                                                                            </select>
                                                                            <ValidationMessage For="@(() => subitem.LineSGSTRate)" />

                                                                        }
                                                                        else
                                                                        {
                                                                            @FormatDecimal(subitem.LineSGSTRate)
                                                                        }
                                                                    </td>
                                                                }
                                                            }
                                                            else if (SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                @if (ShowColumn(nameof(MfgPoSubVM.LineIGSTRate)))
                                                                {
                                                                    <td>
                                                                        @if (subitem.IsEditable)
                                                                        {
                                                                            <select class="form-select form-select-sm" @bind="subitem.LineIGSTRate" @bind:event="oninput"
                                                                                    @bind:after='() => _calculationService.UpdateTotalsAsync(MfgPoVMs)'>
                                                                                <option value="" disabled selected>IGST %</option>
                                                                                @foreach (var rate in CommonConstants.IGSTRates)
                                                                                {
                                                                                    <option value="@rate">@rate</option>
                                                                                }
                                                                            </select>
                                                                            <ValidationMessage For="@(() => subitem.LineIGSTRate)" />
                                                                        }
                                                                        else
                                                                        {
                                                                            @FormatDecimal(subitem.LineIGSTRate)
                                                                        }
                                                                    </td>
                                                                }
                                                            }
                                                        }

                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineBasicAmount)))
                                                        {
                                                            <!-- Basic Amount -->
                                                            <td>@FormatDecimal(subitem.LineBasicAmount)</td>
                                                        }

                                                        @if (SelectedCustomer?.IsWoNoReq==true)
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.WoNO)))
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <InputText @bind-Value="subitem.WoNO"
                                                                                   class="form-control form-control-sm"
                                                                                   placeholder="Enter WONO." />
                                                                        <ValidationMessage For="@(() => subitem.WoNO)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.WoNO
                                                                    }
                                                                </td>
                                                            }
                                                        }
                                                        @if (SelectedCustomer?.LineId==true)
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.PoDate)))
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <InputDate @bind-Value="subitem.PoDate"
                                                                                   class="form-control form-control-sm"
                                                                                   placeholder="Enter PO Date" />
                                                                        <ValidationMessage For="@(() => subitem.PoDate)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.PoDate.ToString("dd/MM/yyyy")
                                                                    }
                                                                </td>
                                                            }

                                                        }

                                                        @if (ShowColumn(nameof(MfgPoSubVM.DueDate)))
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputDate @bind-Value="subitem.DueDate"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="Enter Due Date" />
                                                                    <ValidationMessage For="@(() => subitem.DueDate)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.DueDate.ToString("dd/MM/yyyy")
                                                                }
                                                            </td>
                                                        }

                                                        @if (ShowColumn(nameof(MfgPoSubVM.Remark)))
                                                        {
                                                            <!-- Remarks -->
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputTextArea @bind-Value="subitem.Remark"
                                                                                   class="form-control form-control-sm"
                                                                                   rows="1"
                                                                                   placeholder="Enter Remarks" />
                                                                    <ValidationMessage For="@(() => subitem.Remark)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.Remark
                                                                }
                                                            </td>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.RefQuoteNo)))
                                                        {
                                                            <td>@subitem.RefQuoteNo</td>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.RefQuoteDate)))
                                                        {
                                                            <td>@subitem.RefQuoteDate?.ToString("dd/MM/yyyy")</td>
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.ProjectNo)))
                                                        {

                                                            <td>
                                                                @if (subitem.IsEditable && (subitem.RefQuoteSubId == 0 || subitem.RefQuoteSubId == null) && subitem.Qty == subitem.BalQty)
                                                                {
                                                                    <select class="form-select form-select-sm"
                                                                            value="@subitem.CostId"
                                                                            @onchange="(e => OnCostCenterChanged(e, subitem))">
                                                                        <option value="">select CostCentre</option>
                                                                        @foreach (var cost in CostCenterVMs.Where(c =>
                                                                                                                                !MfgPoVMs.MfgPOSubVMs.Any(r => r != subitem && r.CostId == c.Id)))
                                                                        {
                                                                            <option value="@cost.Id">@cost.ProjectNo</option>
                                                                        }
                                                                    </select>
                                                                    <ValidationMessage For="@(() => subitem.CostId)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.ProjectNo
                                                                }
                                                            </td>
                                                        }

                                                        @if (!MfgPoVMs.PoCancl && (PoId.HasValue || PoId > 0))
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.ItemCancel)))
                                                            {
                                                                <td class="text-center align-middle">
                                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                                        <InputCheckbox @bind-Value="subitem.ItemCancel"
                                                                                       @bind-Value:event="onchange"
                                                                                       ValueChanged="@(async (value) => await OnItemCancelChanged(subitem))"
                                                                                       class="form-check-input border border-2 shadow-lg focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                                    </div>
                                                                    <ValidationMessage For="@(() => subitem.ItemCancel)"
                                                                                       class="text-danger fw-semibold small mt-2 d-block" />
                                                                </td>
                                                            }

                                                            @if (ShowColumn(nameof(MfgPoSubVM.IsAnnexure)))
                                                            {
                                                                <td class="text-center align-middle">
                                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                                        <InputCheckbox @bind-Value="subitem.IsAnnexure"
                                                                                       @bind-Value:event="onchange"
                                                                                       ValueChanged="@(async (value) => await OnItemAnnexureChanged(subitem))"
                                                                                       class="form-check-input border border-2 shadow-lg focus-ring focus-ring-success p-2 fs-4 rounded-pill" />
                                                                    </div>
                                                                    <ValidationMessage For="@(() => subitem.IsAnnexure)"
                                                                                       class="text-danger fw-semibold small mt-2 d-block" />
                                                                </td>
                                                            }
                                                        }

                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end align-middle">
                                                            @if (MfgPoVMs != null && !MfgPoVMs.PoCancl && !MfgPoVMs.ShortClose)
                                                            {
                                                                <div class="d-inline-flex gap-1 justify-content-end w-100">

                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                                @onclick="async () => await SaveRow(subitem)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-check-lg"></i>
                                                                        </button>

                                                                        <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                                @onclick="async () => await CancelEdit(subitem, MfgPoVMs)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-x-lg"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                                @onclick="async () => await EditRowAsync(subitem)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>

                                                                        <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                                @onclick="async () => await RemoveRow(subitem)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    }

                                                                </div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (MfgPoVMs.MfgPOSubVMs?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark">
                                                  
                                                    <tr>

                                                        <td colspan="@GetVisibleColumnsBeforeQty()"
                                                            class="text-end fw-bold">
                                                            Totals:
                                                        </td>

                                                        @if (ShowColumn(nameof(MfgPoSubVM.Qty)))
                                                        {
                                                            <td>@MfgPoVMs.TotalQty</td>
                                                        }

                                                        @if (ShowColumn(nameof(MfgPoSubVM.UnitPrice)))
                                                        {
                                                            <td>Avg: @FormatDecimal(MfgPoVMs.AvgUnitPrice)</td>
                                                        }



                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineGross)))
                                                        {
                                                            <td>@FormatDecimal(MfgPoVMs.TotalLineGross)</td>
                                                        }

                                                        @if (!MfgPoVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LineDiscountPercent)))
                                                            {
                                                                <td></td>
                                                            }
                                                        }
                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineDiscountAmount)))
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineCGSTRate)))
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineSGSTRate)))
                                                        {
                                                            <td></td>
                                                        }
                                                        @if (SelectedCustomer?.BusiType == "InterState")
                                                        {
                                                            @if (ShowColumn(nameof(MfgPoSubVM.LineIGSTRate)))
                                                            {
                                                                <td></td>
                                                            }
                                                        }

                                                        @if (ShowColumn(nameof(MfgPoSubVM.LineBasicAmount)))
                                                        {
                                                            <td>@FormatDecimal(MfgPoVMs.TotalLineBasicAmount)</td>
                                                        }
                                                        <td colspan="@GetRemainingFooterColumns()"></td>


                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>

                                    @if (!MfgPoVMs.PoCancl && !MfgPoVMs.ShortClose)
                                    {
                                        <div class="mt-2 text-start">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- ===================Other Details Terms and Conditions ===================-->
                        <div class="col-12 col-lg-6 mb-3">
                            <div class="card shadow-sm rounded-4 border-0">
                                <div class="card-body">
                                </div>
                            </div>
                        </div>

                        <!-- =================== Tax Details Section =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm rounded-4 border-0 p-3">

                                <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Tax & Charges
                                </h6>

                                <!-- Total Gross -->
                                <div class="row mb-2 gx-3">
                                    <label for="TotalGross" class="col-5 col-md-4 col-form-label text-dark">
                                        <small>Total Gross</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input id="TotalGross"
                                               step="any"
                                               class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               value="@FormatDecimal(MfgPoVMs.TotalGrossAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Discount -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Discount</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="discountToggle" id="discountRs"
                                                   @onchange="() => SetDiscountType(true)"
                                                   checked="@MfgPoVMs.DiscAmtOrPer"
                                                   disabled="@(MfgPoVMs.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountRs">
                                                <small>@MfgPoVMs.Symbol</small>
                                            </label>

                                            <input type="radio" class="btn-check" name="discountToggle" id="discountPercent"
                                                   @onchange="() => SetDiscountType(false)"
                                                   checked="@(!MfgPoVMs.DiscAmtOrPer)"
                                                   disabled="@(MfgPoVMs.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountPercent"><small>%</small></label>
                                        </div>
                                    </div>

                                    <div class="col-3 col-md-5">
                                        @if (MfgPoVMs.DiscAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   step="any"
                                                   @bind="MfgPoVMs.DiscountAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgPoVMs)'
                                                   disabled="@(MfgPoVMs.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => MfgPoVMs.DiscountAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   step="any"
                                                   @bind="MfgPoVMs.DiscountPercent"
                                                   @bind:after="OnDiscountPercentChanged"
                                                   disabled="@(MfgPoVMs.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => MfgPoVMs.DiscountPercent)" />
                                            <small class="text-muted d-block text-end">
                                                Amt: @FormatDecimal(MfgPoVMs.DiscountAmount)
                                            </small>
                                        }
                                    </div>
                                </div>

                                <!-- SubTotal -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>SubTotal</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               step="any"
                                               value="@FormatDecimal(MfgPoVMs.TotalBasicAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Freight Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Freight Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               step="any"
                                               type="number" @bind="MfgPoVMs.FreightCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(MfgPoVMs)' />
                                        <ValidationMessage For="@(() => MfgPoVMs.FreightCharges)" />
                                    </div>
                                </div>

                                <!-- P & F Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>P & F Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="packingToggle" id="packingToggleRs"
                                                   @onchange="() => SetPAndFType(true)" checked="@MfgPoVMs.PackingAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="packingToggleRs"><small>@MfgPoVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="packingToggle" id="packingTogglePercent"
                                                   @onchange="() => SetPAndFType(false)" checked="@(!MfgPoVMs.PackingAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="packingTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (MfgPoVMs.PackingAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   step="any"
                                                   type="number" @bind="MfgPoVMs.PackingCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgPoVMs)' />
                                            <ValidationMessage For="@(() => MfgPoVMs.PackingCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   step="any"
                                                   type="number" @bind="MfgPoVMs.PackingPercent"
                                                   @bind:after="() => OnPandFPercentChanged()" />
                                            <ValidationMessage For="@(() => MfgPoVMs.PackingPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(MfgPoVMs.PackingCharges)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Insurance Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Insurance Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceToggleRs"
                                                   @onchange="() => SetInsuranceType(true)" checked="@MfgPoVMs.InsuranceAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="insuranceToggleRs"><small>@MfgPoVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceTogglePercent"
                                                   @onchange="() => SetInsuranceType(false)" checked="@(!MfgPoVMs.InsuranceAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="insuranceTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (MfgPoVMs.InsuranceAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   step="any"
                                                   type="number" @bind="MfgPoVMs.InsuranceCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgPoVMs)' />
                                            <ValidationMessage For="@(() => MfgPoVMs.InsuranceCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   step="any"
                                                   type="number" @bind="MfgPoVMs.InsurancePercent"
                                                   @bind:after="() => OnInsurancePercentChanged()" />
                                            <ValidationMessage For="@(() => MfgPoVMs.InsurancePercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(MfgPoVMs.InsuranceCharges)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Total Taxable -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Total Taxable</small></label>
                                    <div class="col-7 col-md-8">
                                        <input type="number"
                                               class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               step="any"
                                               value="@FormatDecimal(MfgPoVMs.TotalTaxable)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Taxes (CGST/SGST/IGST) -->
                                @if (SelectedCustomer?.TaxValidate == false)
                                {
                                    <div class="mb-2">
                                        @if (SelectedCustomer?.BusiType == "Local")
                                        {
                                            <!-- CGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>CGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!MfgPoVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="MfgPoVMs.CGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(MfgPoVMs.CGstRate)">
                                                            <option value="0">-- Select CGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => MfgPoVMs.CGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(MfgPoVMs.TotalCGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>

                                            <!-- SGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>SGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!MfgPoVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="MfgPoVMs.SGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(MfgPoVMs.SGstRate)">
                                                            <option value="0">-- Select SGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => MfgPoVMs.SGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(MfgPoVMs.TotalSGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                        else if (SelectedCustomer?.BusiType == "InterState")
                                        {
                                            <!-- IGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>IGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!MfgPoVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="MfgPoVMs.IGstRate"
                                                                @bind:after="() => _calculationService.UpdateTotalsAsync(MfgPoVMs)"
                                                                disabled="@(SelectedCustomer?.TaxValidate == true)">
                                                            <option value="0">-- Select IGST % --</option>
                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => MfgPoVMs.IGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(MfgPoVMs.TotalIGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- TCS Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>TCS Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsToggleRs"
                                                   @onchange="() => SetTCSType(true)" checked="@MfgPoVMs.TCSAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="tcsToggleRs"><small>@MfgPoVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsTogglePercent"
                                                   @onchange="() => SetTCSType(false)" checked="@(!MfgPoVMs.TCSAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="tcsTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (MfgPoVMs.TCSAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   step="any"
                                                   type="number" @bind="MfgPoVMs.TCSAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgPoVMs)' />
                                            <ValidationMessage For="@(() => MfgPoVMs.TCSAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   step="any"
                                                   type="number" @bind="MfgPoVMs.TCSPercent"
                                                   @bind:after="() => OnTCSPercentChanged()" />
                                            <ValidationMessage For="@(() => MfgPoVMs.TCSPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @MfgPoVMs.TCSAmount</small>
                                        }
                                    </div>
                                </div>

                                <!-- Other Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Other Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               step="any"
                                               type="number" @bind="MfgPoVMs.OtherCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(MfgPoVMs)' />
                                        <ValidationMessage For="@(() => MfgPoVMs.OtherCharges)" />
                                    </div>
                                </div>

                                <!-- Round Off -->
                                <div class="row mb-2 gx-2 align-items-center">
                                    <div class="col-5 col-md-4 d-flex align-items-center">
                                        <small class="me-2 text-dark">Round Off</small>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="roundOffSwitch"
                                                   @bind="MfgPoVMs.IsRoundOffEnabled"
                                                   @bind:after="() => _calculationService.UpdateTotalsAsync(MfgPoVMs)">
                                            <label class="form-check-label" for="roundOffSwitch"></label>
                                        </div>
                                    </div>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               value="@FormatDecimal(MfgPoVMs.RoundOff)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Grand Total -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label fw-bold text-dark">
                                        <small>Grand Total</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                               value="@FormatDecimal(MfgPoVMs.GrandTotal)"
                                               readonly />
                                        @if (MfgPoVMs.CurrId > 1)
                                        {
                                            <div class="mt-1 text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @MfgPoVMs.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((MfgPoVMs.GrandTotal * MfgPoVMs.TodayVal).ToString("0.00"))
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Amount in Words -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Amount in Words</small></label>
                                    <div class="col-7 col-md-8 pt-1">
                                        @if (MfgPoVMs.CurrId > 1)
                                        {
                                            <small class="fw-bold text-success d-block">
                                                Converted Value in Rs: @FormatDecimal(MfgPoVMs.GrandTotal * MfgPoVMs.TodayVal)
                                            </small>
                                        }
                                        else
                                        {
                                            <strong>@NumberToWordsHelper.ConvertNumberToWords(MfgPoVMs.GrandTotal)</strong>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>


                        <div class="row g-2 row-cols-2 row-cols-md-5">

                            @if (CanCreate || CanEdit)
                            {
                                @if (!MfgPoVMs.PoCancl && !MfgPoVMs.ShortClose)
                                {
                                    <div>
                                        <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                            <i class="bi bi-floppy2-fill me-1"></i>
                                            @(MfgPoVMs.PoId > 0 ? "Update" : "Create")
                                        </button>
                                    </div>

                                    @if (MfgPoVMs.PoId > 0)
                                    {
                                        <div>
                                            <button type="button" class="btn btn-success w-100 rounded-3"
                                                    disabled="@isProcessing"
                                                    @onclick="OrderAcceptance">
                                                <i class="bi bi-check2-circle me-1"></i> Order Acceptance
                                            </button>
                                        </div>
                                    }
                                }
                            }
                        
                            <div>
                                <button type="button"
                                        class="btn btn-primary w-100 rounded-3 d-flex align-items-center justify-content-center"
                                        @onclick="DownloadTemplate" disabled="@isProcessing">
                                    @if (isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Preparing...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-download me-2"></i>
                                        <span>Download Template</span>
                                    }
                                </button>
                            </div>

                            <div>
                                <button type="button"
                                        class="btn btn-outline-success w-100 rounded-3"
                                        @onclick='() => OpenModal("ExcelUpload")'>
                                    <i class="bi bi-upload me-1"></i> Import
                                </button>
                            </div>

                            <div>
                                <SmartBackButton Url="@($"mfgPOList?currentPage={currentPage}")" />
                            </div>

                        </div>
                  @*       <div class="row g-3">
                            <!-- Action Buttons -->
                            @if (CanCreate || CanEdit)
                            {
