    private int GetVisibleColumnsBeforeQty()
    {
        int count = 0;

        if (ShowColumn(nameof(MfgPoSubVM.SlNo))) count++;

        @if (SelectedCustomer?.LineId==true)
        {
            if (ShowColumn(nameof(MfgPoSubVM.LineNo))) count++;
        }

        @if (IsLabourCost)
        {
            @if (ShowColumn(nameof(MfgPoSubVM.LabourCost))) count++;
        }
        if (ShowColumn(nameof(MfgPoSubVM.ItemCode))) count++;
        if (ShowColumn(nameof(MfgPoSubVM.ItemName))) count++;
        if (ShowColumn(nameof(MfgPoSubVM.ItemSpecification))) count++;
        if (ShowColumn(nameof(MfgPoSubVM.MeasureUnit))) count++;
        if (ShowColumn(nameof(MfgPoSubVM.HSNCode))) count++;

        return count;
    }
    private int GetRemainingFooterColumns()
    {
        int totalVisible = Columns.Count(x => x.IsVisible);

        int usedColumns = 0;

        @if (ShowColumn(nameof(MfgPoSubVM.DueDate)))
        {
            usedColumns++;
        }
        @if (ShowColumn(nameof(MfgPoSubVM.Remark)))
        {
            usedColumns++;
        }
        @if (ShowColumn(nameof(MfgPoSubVM.RefQuoteNo)))
        {
            usedColumns++;
        }
        @if (ShowColumn(nameof(MfgPoSubVM.RefQuoteDate)))
        {
            usedColumns++;
        }
        @if (ShowColumn(nameof(MfgPoSubVM.ProjectNo)))
        {
            usedColumns++;
        }
        @if (!MfgPoVMs.PoCancl && (PoId.HasValue || PoId > 0))
        {
            @if (ShowColumn(nameof(MfgPoSubVM.ItemCancel)))
            {
                usedColumns++;
            }

        }
        @if (ShowColumn(nameof(MfgPoSubVM.IsAnnexure)))
        {
            usedColumns++;
        }
        @if (ShowColumn(nameof(MfgPoSubVM.PoDate)))
        {
            usedColumns++;
        }

        return Math.Max(0, usedColumns + 1);
    }


