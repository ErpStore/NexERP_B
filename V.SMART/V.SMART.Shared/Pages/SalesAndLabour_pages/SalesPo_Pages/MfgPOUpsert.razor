    private async Task AskToShortCloseAsync(MfgPoVM mfgPoVM)
    {
        try
        {

            if (!PoId.HasValue || PoId == 0)
            {
                await _js.ToastrError("Short Closed is not allowed before saving the Sales Order.");
                return;
            }

            if (mfgPoVM == null)
            {
                await _js.ToastrError("Invalid Sales Order selected.");
                return;
            }

            if (mfgPoVM.PoTally)
            {
                await _js.ToastrWarning("This Sales Order is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (mfgPoVM.PoCancl)
            {
                await _js.ToastrWarning("This Sales Order is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!mfgPoVM.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Sales Order?";
                btnText = "Short Closed";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Sales Order?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while AskToShortCloseAsync Sales Order.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task Cancel()
    {
        try
        {
            if (!PoId.HasValue || PoId == 0)
            {
                await _js.ToastrError("Cancellation is not allowed before saving the Sales order.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Sales order");
                return;
            }

            if (MfgPoVMs.ShortClose)
            {
                await _js.ToastrError("Sales Order is already short closed. You can't cancel it.");
                return;
            }

            if (MfgPoVMs.MfgPOSubVMs?.Any(x => x.ItemCancel) == true)
            {
                await _js.ToastrError("Some items are already cancelled. Complete Sales order cancellation is not allowed.");
                return;
            }

            if (MfgPoVMs.PoCancl)
            {
                var subs = await mfgPoService.GetPOSubByPoIdAsync(MfgPoVMs.PoId);

                foreach (var sub in subs)
                {
                    await mfgPoService.ValidateQuotationBalanceBeforeRevertAsync(sub);
                }
            }

            if (!MfgPoVMs.PoCancl)
            {
                ModalTitle = "Are you sure you want to Cancel this Sales Order?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Sales Order?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            MfgPoVMs = await mfgPoService.GetPoByPoIdAsync(MfgPoVMs.PoId);
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Sales Order.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Sales Order Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnItemCancelChanged(MfgPoSubVM subitem)
    {
        try
        {
            if (subitem.PoSubId == 0)
            {
                await _js.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if (MfgPoVMs.PoCancl)
            {
                await _js.ToastrError("Sales Order is already Cancel. You can't cancel Item.");
                return;
            }

            if (subitem.Qty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _js.ToastrError("Item cannot be cancelled — some transactions have been made on it.");
                return;
            }

            if (subitem.ItemCancel)
                await mfgPoService.ValidateBeforeRevertAsync(subitem.PoSubId);

            var (CanItemCancel, message) = await mfgPoService.CanSalesOrderItemCancelCheckAsync(subitem);

            if (!CanItemCancel)
            {
                await _js.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _js.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _js.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingPo(PoId.Value);
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling Item in Sales Order");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in PO Sales");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnItemAnnexureChanged(MfgPoSubVM subitem)
    {
        if (subitem == null) return;

        try
        {
            if (!subitem.ItemId.HasValue)
            {
                await _js.ToastrError("ItemCode is missing or invalid.");
                subitem.IsAnnexure = false;
                return;
            }

            bool bomExists = await mfgPoService.CheckAssemblyExistsAsync(subitem.ItemId.Value);

            if (!bomExists)
            {
                await _js.ToastrError("Assembly Item doesn't exist for the selected item.");
                subitem.IsAnnexure = false;
                return;
            }

            if (subitem.IsAnnexure)
            {
                subitem.IsAnnexure = false;
            }
            else
            {
                subitem.IsAnnexure = true;
            }

        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Item Annexure.");
            await LoggingService.LogDeveloperError(ex, "Error in Item Annexure in PO Sales");
        }
        finally
        {
            isProcessing = false;
        }
