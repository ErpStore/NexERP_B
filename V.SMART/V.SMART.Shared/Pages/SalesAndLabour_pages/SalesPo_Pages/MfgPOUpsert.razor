    private void OnLineDiscountPercentChanged(MfgPoSubVM subitem)
    {
        if (subitem.Qty > 0 && subitem.UnitPrice > 0)
        {
            var gross = subitem.Qty * subitem.UnitPrice;
            subitem.LineDiscountAmount = (gross * subitem.LineDiscountPercent / 100m);
        }
        else
        {
            subitem.LineDiscountAmount = 0;
        }
        _calculationService.UpdateTotalsAsync(MfgPoVMs);
        StateHasChanged();
    }

    private void OnDiscountPercentChanged()
    {
        _calculationService.UpdateTotalsAsync(MfgPoVMs);
        StateHasChanged();
    }

