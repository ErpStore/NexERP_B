    private async Task OnQuoteSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (MfgPoVMs.MfgPOSubVMs == null)
            MfgPoVMs.MfgPOSubVMs = new List<MfgPoSubVM>();

        int custId = MfgPoVMs.CustId;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            //SNS
            var LabourCost = await _CostingService.GetBulkLabourCostsAsync(itemIds);

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? quoteSubId = item.ContainsKey("QuoteSubId") && item["QuoteSubId"] != null
                    ? Convert.ToInt32(item["QuoteSubId"])
                    : (int?)null;

                if (MfgPoVMs.MfgPOSubVMs.Any(x => x.ItemId == itemId && x.RefQuoteSubId == quoteSubId))
                    continue;

                decimal balQty = 0m;
                if (item.ContainsKey("BalQty") && item["BalQty"] != null)
                    decimal.TryParse(item["BalQty"].ToString(), out balQty);

                var subVm = new MfgPoSubVM
                {
                    RefQuoteSubId = quoteSubId,
                    RefQuoteNo = item.ContainsKey("QuoteNo") ? item["QuoteNo"]?.ToString() : "",

                    RefQuoteDate = item.ContainsKey("QuoteDate") && item["QuoteDate"] != null
                        ? Convert.ToDateTime(item["QuoteDate"])
                        : (DateTime?)null,

                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("UOM") ? item["UOM"]?.ToString() : "",
                    HSNCode = item.ContainsKey("HSNCode") ? item["HSNCode"]?.ToString() : "",

                    Qty = balQty,
                    BalQty = balQty,
                    IndentBalQty = balQty,
                    WOBalQty = balQty,
                    PerformaBalQty = balQty,
                    RouteCardBalQty = balQty,
                    ProdCompBalQty = balQty,

                    UnitPrice = item.ContainsKey("UnitPrice") && item["UnitPrice"] != null
                        ? Convert.ToDecimal(item["UnitPrice"])
                        : 0m,
                    LabourCost = LabourCost.TryGetValue(itemId, out var price) ? price : 0,

                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                        ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                        : (int?)null,

                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",

                    IsEditable = true
                };

                subVm.WoNO = await mfgPoService.GenerateNextWoNoAsync(
                    MfgPoVMs.MfgPOSubVMs
                        .TakeWhile(x => !(x.ItemId == itemId && x.RefQuoteSubId == quoteSubId)));

                MfgPoVMs.MfgPOSubVMs.Add(subVm);

                await _calculationService.UpdateTotalsAsync(MfgPoVMs);
            }

            await ResetSlno();
            //SNS
            if (IsLabourCost)
            {
                foreach (var subVm in MfgPoVMs.MfgPOSubVMs)
                {
                    if (subVm.UnitPrice < subVm.LabourCost)
                    {
                        _js.ToastrWarning($"Unit Price ({subVm.UnitPrice:0.00}) Is less than Labour Cost ({subVm.LabourCost:0.00}).");
                    }
                    else if (subVm.UnitPrice > subVm.LabourCost)
                    {
                        _js.ToastrWarning($"Unit Price ({subVm.UnitPrice:0.00}) Is  Greater than than Labour Cost ({subVm.LabourCost:0.00}).");

                    }


                }
            }


            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnQuoteSelectedAsync failed.");
            await _js.ToastrError("Error processing selected quote items.");
        }
    }

