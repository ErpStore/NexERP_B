    private bool IsItemAlreadySelected(int itemId, int? currentItemId)
    {
        return MfgPoVMs.MfgPOSubVMs?.Any(q => q.ItemId == itemId && q.ItemId != currentItemId) == true;
    }

    #endregion


    #region Quantity Handlers


    private async Task OnQtyChange(ChangeEventArgs e, MfgPoSubVM SubVM)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                UpdateQuantities(SubVM, 0);
                await _js.ToastrWarning("Quantity must be a positive number.");
                return;
            }

            if (SubVM.PoSubId == 0)
            {
                if (SubVM.RefQuoteSubId > 0)
                {
                    var quoteBalQty = await mfgPoService.GetQuoteItemBalQtyFromQuoteSubId(SubVM.RefQuoteSubId.Value);
                    if (newQty > quoteBalQty)
                    {
                        newQty = quoteBalQty;
                        await _js.ToastrWarning($"Quantity cannot be greater than Quotation Balance Qty ({quoteBalQty}).");
                    }
                }
                UpdateQuantities(SubVM, newQty);
            }
            else
            {
                var original = await mfgPoService.GetPoSubItemDetailByPoSubIdAsync(SubVM.PoSubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                if (newQty < alreadyTransacted)
                {
                    UpdateQuantities(SubVM, alreadyTransacted.GetValueOrDefault(), alreadyTransacted);
                    await _js.ToastrWarning($"Quantity cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefQuoteSubId > 0)
                {
                    var quoteBalQty = await mfgPoService.GetQuoteItemBalQtyFromQuoteSubId(SubVM.RefQuoteSubId.Value);
                    var maxAllowedQty = original.Qty + quoteBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        newQty = maxAllowedQty.GetValueOrDefault();
                        await _js.ToastrWarning($"Quantity cannot be greater than {maxAllowedQty}.");
                    }
                }

                UpdateQuantities(SubVM, newQty, alreadyTransacted);
            }

            await _calculationService.UpdateTotalsAsync(MfgPoVMs);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for PoSubId: {SubVM?.PoSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    private void UpdateQuantities(MfgPoSubVM subVM, decimal newQty, decimal? alreadyTransacted = null)
    {
        subVM.Qty = newQty;

        subVM.BalQty = alreadyTransacted.HasValue
            ? Math.Max(newQty - alreadyTransacted.Value, 0)
            : newQty;

        subVM.IndentBalQty = newQty;
        subVM.WOBalQty = newQty;
        subVM.PerformaBalQty = newQty;
        subVM.RouteCardBalQty = newQty;
        subVM.ProdCompBalQty = newQty;

    }

    #endregion




    #region Row Operations

    private async Task<bool> ValidateRowAsync(MfgPoSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (!MfgPoVMs.IsOpenPO && (row.Qty == null || row.Qty <= 0))
                errors.Add("Quantity must be greater than 0.");

            if (row.UnitPrice == null || row.UnitPrice <= 0)
                errors.Add("Unit Price must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = MfgPoVMs.MfgPOSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (!await ValidateLastRowAsync()) return;

            MfgPoVMs.MfgPOSubVMs.Add(new MfgPoSubVM
            {
                PoId = MfgPoVMs.PoId,
                IsEditable = true
            });

            await ResetSlno();
            await _calculationService.UpdateTotalsAsync(MfgPoVMs);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await LoggingService.LogDeveloperError(ex, "AddRow failed.");
        }
    }

    private async Task SaveRow(MfgPoSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            if (!MfgPoVMs.MfgPOSubVMs.Any(x => x.IsEditable))
            {
                MfgPoVMs.MfgPOSubVMs.Add(new MfgPoSubVM
                {
                    PoId = MfgPoVMs.PoId,
                    IsEditable = true
                });
            }

            await ResetSlno();
            await _calculationService.UpdateTotalsAsync(MfgPoVMs);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for PoSubId: {item?.PoSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(MfgPoSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItem == null && item.ItemId > 0)
            {
                item.SelectedItem = await mfgPoService.GetItemByItemIdAsync(item.ItemId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for PoSubId: {item?.PoSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(MfgPoSubVM? item, MfgPoVM? parentPo)
    {
        try
        {
            if (item == null || parentPo == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentPo.MfgPOSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for PoSubId: {item?.PoSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(MfgPoSubVM item)
    {
        try
        {
            if (MfgPoVMs.MfgPOSubVMs.Count == 1 && item.PoSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            // if (IsSomeItemsTransMade)
            // {
            //     await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
            //     return;
            // }
            if (await mfgPoService.IsPoTransactionsMatchedRowRemoveAsync(item?.PoSubId, MfgPoVMs))
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;

            }

            if (item.ItemCancel)
            {
                await _js.ToastrWarning("This item has already been cancelled and cannot be removed.");
                return;
            }

            if (MfgPoVMs.PoCancl)
            {
                await _js.ToastrError("This Sales Order is already cancelled. Row deletion is not allowed.");
                return;
            }

            if (MfgPoVMs.ShortClose)
            {
                await _js.ToastrError("This Sales Order is already short closed. Row deletion is not allowed.");
                return;
            }

            if (item.ItemId == 0)
            {
                MfgPoVMs.MfgPOSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!MfgPoVMs.MfgPOSubVMs.Any())
                    MfgPoVMs.MfgPOSubVMs = new List<MfgPoSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(MfgPoVMs);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for PoSubId: {item?.PoSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

