    #region Receive Items from Excel Upload
    private async Task ReceiveItems(List<ExcelUploadVM> items)
    {
        try
        {
            if (items == null || !items.Any()) return;

            // Ensure list exists
            if (MfgPoVMs.MfgPOSubVMs == null)
                MfgPoVMs.MfgPOSubVMs = new List<MfgPoSubVM>();

            foreach (var item in items)
            {

                var existing = MfgPoVMs.MfgPOSubVMs
                    .FirstOrDefault(x => x.ItemId == item.ItemId && x.LineNo == item.LineNo && x.DueDate == item.DueDate);

                if (existing != null)
                {
                    existing.Qty += item.Qty ?? 0;
                    existing.BalQty += item.Qty ?? 0;
                    existing.IndentBalQty += item.Qty ?? 0;
                    existing.WOBalQty += item.Qty ?? 0;
                    existing.PerformaBalQty += item.Qty ?? 0;
                    existing.RouteCardBalQty += item.Qty ?? 0;
                    existing.ProdCompBalQty += item.Qty ?? 0;

                    existing.UnitPrice = item.UnitPrice;
                    existing.LineDiscountAmount = item.LineDiscountAmount;
                }
                else
                {
                    MfgPoVMs.MfgPOSubVMs.Add(new MfgPoSubVM
                    {
                        SlNo = item.SlNo,
                        ItemId = item.ItemId,
                        LineNo = item.LineNo,
                        ItemCode = item.ItemCode,
                        ItemName = item.ItemName,
                        Qty = item.Qty,
                        BalQty = item.Qty,
                        ItemSpecification = item.ItemSpeification,
                        IndentBalQty = item.Qty ?? 0,
                        WOBalQty = item.Qty ?? 0,
                        PerformaBalQty = item.Qty ?? 0,
                        RouteCardBalQty = item.Qty ?? 0,
                        ProdCompBalQty = item.Qty ?? 0,
                        UnitPrice = item.UnitPrice,
                        MeasureUnit = item.MeasureUnit,
                        HSNCode = item.HSNCode,
                        LineDiscountAmount = item.LineDiscountAmount,
                        LineDiscountPercent = item.LineDiscountPercent,
                        LineCGSTRate = item.LineCGSTRate,
                        LineSGSTRate = item.LineSGSTRate,
                        LineIGSTRate = item.LineIGSTRate,
                        DueDate = item.DueDate ?? DateTime.Now,
                        PoDate = item.PoDate ?? DateTime.Now
                    });
                }
            }


            int i = 1;
            foreach (var row in MfgPoVMs.MfgPOSubVMs)
            {
                row.SlNo = i++;
            }

            await _calculationService.UpdateTotalsAsync(MfgPoVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ReceiveItems() failed.");
            await _js.ToastrError("Error processing ReceiveItems() items.");
        }
    }
