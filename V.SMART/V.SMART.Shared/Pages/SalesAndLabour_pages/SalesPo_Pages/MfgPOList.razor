    #region === Deletion Flow ===

    private async Task HandleDelete(int poId)
    {
        try
        {
            var (canDelete, message) = await mfgPoService.CanDeleteSalesOrderAsync(poId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeletePoId = poId;

            ModalTitle = "Are you sure you want to delete this Quotation";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for PoId: {poId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            isProcessing = true;

            var deleted = await mfgPoService.DeletePOByPOIdAsync(DeletePoId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Sales Quoatation deleted successfully.");
                await LoadAllPos();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Sales Order could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting PoId: {DeletePoId}");
            await _JS.ToastrError("Failed to delete Sales Order.");
        }
        finally
        {
            DeletePoId = 0;
            isProcessing = false;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else if (confirmation == "Export")
            {
                isProcessing = true;
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
        finally
        {
            isProcessing = false;
        }
    }

