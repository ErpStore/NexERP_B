            {
                currentPage = 1;
                await LoadAllPos();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Sales Order List");
            await _JS.ToastrError("Failed to navigate to first page.");
