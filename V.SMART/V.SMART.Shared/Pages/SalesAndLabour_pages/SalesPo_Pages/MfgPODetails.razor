@page "/mfgPO/details/{PoId:int}"
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel

@inherits BaseUserRightsComponent

@inject NavigationManager _navigationManager
@inject IMfgPoService _mfgPoService
@inject IJSRuntime _js
@inject ILoggingService LoggingService

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <!-- Company Details Section -->
            <MyCompanyDetails />

            <!-- Cancelled Watermark -->
            @if (MfgPoVMs.PoCancl)
            {
                <div class="cancelWatermark ms-20 mt-10">CANCELLED</div>
            }
            else if (MfgPoVMs.ShortClose)
            {
                <div class="cancelWatermark ms-20 mt-10">SHORT CLOSED</div>
            }

            <hr class="border-2 border-primary-subtle mb-4" />
            <div class="text-center">
                <h4 class="fw-semibold mt-3">Purchase Order Details</h4>
            </div>
            <hr class="border-2 border-primary-subtle mb-4" />

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Customer Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.CustName) ? MfgPoVMs.CustName : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.CustAddress) ? MfgPoVMs.CustAddress : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.CustGst) ? MfgPoVMs.CustGst : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.CustContactNo) ? MfgPoVMs.CustContactNo : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact Person</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.KindOfAttention) ? MfgPoVMs.KindOfAttention : "N/A")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Document Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Document Type</strong></td>
                                        <td>@(MfgPoVMs.MfgORLab ? "Manufacturing" : "Labour")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>PO No</strong></td>
                                        <td>@(MfgPoVMs != null ? $"{MfgPoVMs.PONo}{MfgPoVMs.Suffix}" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>PO Date</strong></td>
                                        <td>@(MfgPoVMs?.PODate.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Currency</strong></td>
                                        <td>@(!string.IsNullOrEmpty(MfgPoVMs?.CurrName) ? MfgPoVMs.CurrName : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Quote No.</strong></td>
                                        <td>@refQuoteNosDisplay</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Quote Dt.</strong></td>
                                        <td>@refQuoteDatesDisplay</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2 small">
                            Consignee Details
                        </div>
                        <div class="card-body p-2 small">
                            @if (MfgPoVMs.IsSameAsShipping)
                            {
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.CustName) ? MfgPoVMs.CustName : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.CustAddress) ? MfgPoVMs.CustAddress : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.CustGst) ? MfgPoVMs.CustGst : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.CustContactNo) ? MfgPoVMs.CustContactNo : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Contact Person</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.KindOfAttention) ? MfgPoVMs.KindOfAttention : "N/A")</td></tr>
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.ShippingName) ? MfgPoVMs.ShippingName : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.ShippingAddress) ? MfgPoVMs.ShippingAddress : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.ShippingGstin) ? MfgPoVMs.ShippingGstin : "N/A")</td></tr>
                                        <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(MfgPoVMs?.ShippingContactNo) ? MfgPoVMs.ShippingContactNo : "N/A")</td></tr>
                                    </tbody>
                                </table>
                            }

                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2 small">
                            Payment, Delivery, and Other Terms
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Payment Terms</strong></td>
                                        <td>@(MfgPoVMs?.PayTerms ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Delivery Terms</strong></td>
                                        <td>@(MfgPoVMs?.DeliveryTerms ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Main Remarks</strong></td>
                                        <td>@(MfgPoVMs?.MainRemark ?? "N/A")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    Quotation Items
                </div>
                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                        <thead class="custom-blue">
                            <tr>
                                <th>Sl No.</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>UOM</th>
                                <th>HSN</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Discount</th>
                                <th>Basic Amount</th>
                                @if (CustomerVMs.TaxValidate == false)
                                {
                                    @if (CustomerVMs.BusiType == "Local")
                                    {
                                        <th>CGST</th>
                                        <th>SGST</th>
                                    }
                                    else if (CustomerVMs.BusiType == "InterState")
                                    {
                                        <th>IGST</th>
                                    }
                                }
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody class="custom-size">
                            @if (MfgPoVMs?.MfgPOSubVMs != null && MfgPoVMs.MfgPOSubVMs.Any())
                            {
                                @foreach (var item in MfgPoVMs.MfgPOSubVMs)
                                {
                                    <tr>
                                        <td>@item.SlNo</td>
                                        <td>@(item.ItemCode ?? "—")</td>
                                        <td>@(item.ItemName ?? "—")</td>
                                        <td>@item.MeasureUnit</td>
                                        <td>@item.HSNCode</td>
                                        <td>@FormatDecimal(item.Qty)</td>
                                        <td>@FormatDecimal(item.UnitPrice)</td>
                                        <td>@FormatDecimal(item.LineDiscountAmount)</td>
                                        <td>@FormatDecimal(item.LineBasicAmount)</td>

                                        @if (CustomerVMs.TaxValidate == false)
                                        {
                                            @if (CustomerVMs.BusiType == "Local")
                                            {
                                                <td>@FormatDecimal(item.LineCGSTAmount)</td>
                                                <td>@FormatDecimal(item.LineSGSTAmount)</td>
                                            }
                                            else if (CustomerVMs.BusiType == "InterState")
                                            {
                                                <td>@FormatDecimal(item.LineIGSTAmount)</td>
                                            }
                                        }

                                        <td>@item.Remark</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-success-subtle text-success-emphasis fw-semibold p-2 small">
                            Totals & Taxes
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-secondary">Total Gross Amount</td><td class="text-end">@FormatDecimal(MfgPoVMs.TotalLineGross)</td></tr>
                                    <tr><td class="text-secondary">Total Discount</td><td class="text-end">@FormatDecimal(MfgPoVMs.DiscountAmount)</td></tr>
                                    <tr><td class="text-secondary">Total Basic Amount</td><td class="text-end">@FormatDecimal(MfgPoVMs.TotalLineBasicAmount)</td></tr>
                                    <tr><td class="text-secondary">Freight Charges</td><td class="text-end">@FormatDecimal(MfgPoVMs.FreightCharges)</td></tr>
                                    <tr><td class="text-secondary">Packing Charges</td><td class="text-end">@FormatDecimal(MfgPoVMs.PackingCharges)</td></tr>
                                    <tr><td class="text-secondary">Insurance Charges</td><td class="text-end">@FormatDecimal(MfgPoVMs.InsuranceCharges)</td></tr>
                                    <tr><td class="text-secondary">Total Taxable</td><td class="text-end">@FormatDecimal(MfgPoVMs.TotalTaxable)</td></tr>
                                    @if (CustomerVMs.TaxValidate == false)
                                    {
                                        @if (CustomerVMs.BusiType == "Local")
                                        {
                                            <tr><td class="text-secondary">Total CGST</td><td class="text-end">@FormatDecimal(MfgPoVMs.TotalCGSTAmount)</td></tr>
                                            <tr><td class="text-secondary">Total SGST</td><td class="text-end">@FormatDecimal(MfgPoVMs.TotalSGSTAmount)</td></tr>
                                        }
                                        else if (CustomerVMs.BusiType == "InterState")
                                        {
                                            <tr><td class="text-secondary">Total IGST</td><td class="text-end">@FormatDecimal(MfgPoVMs.TotalIGSTAmount)</td></tr>
                                        }
                                    }
                                    <tr><td class="text-secondary">TCS</td><td class="text-end">@FormatDecimal(MfgPoVMs.TCSAmount)</td></tr>
                                    <tr><td class="text-secondary">Other Charges</td><td class="text-end">@FormatDecimal(MfgPoVMs.OtherCharges)</td></tr>
                                    <tr><td class="text-secondary">Round Off</td><td class="text-end">@FormatDecimal(MfgPoVMs.RoundOff)</td></tr>
                                    <tr class="fw-bold fs-6 text-primary">
                                        <td>Grand Total</td>
                                        <td class="text-end">@FormatDecimal(MfgPoVMs.GrandTotal)</td>
                                    </tr>

                                    @if (MfgPoVMs.CurrId > 1)
                                    {
                                        <tr>
                                            <td colspan="2" class="text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @MfgPoVMs.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((MfgPoVMs.GrandTotal * MfgPoVMs.TodayVal).ToString("0.00"))
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <!-- Due Date & Terms and Conditions -->
                <div class="col-md-12">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-warning-subtle text-warning-emphasis fw-semibold p-2 small">
                            Total Amount in Words
                        </div>
                        <div class="card-body p-2 small">
                            <p class="mb-0">
                                @if (MfgPoVMs.CurrId > 1 && MfgPoVMs.TodayVal > 0)
                                {
                                    <small class="fw-bold text-success d-block">
                                        Converted Value in Rs:
                                        @NumberToWordsHelper.ConvertNumberToWords(MfgPoVMs.GrandTotal * MfgPoVMs.TodayVal)
                                    </small>
                                }
                                else
                                {
                                    <strong>@NumberToWordsHelper.ConvertNumberToWords(MfgPoVMs.GrandTotal)</strong>
                                }
                            </p>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Actions -->
            <!--new code -->
            @if (isOtherScreen == false)
            {
                <div class="d-flex gap-2 justify-content-end">
                    
                    <a href="@($"/mfgPOList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                        <i class="bi bi-arrow-bar-left me-1"></i> Back To List
                    </a>

                    <a href="@($"/MfgPO/update/{PoId}")" class="btn btn-outline-primary">
                        <i class="bi bi-pencil-square"></i> Modify
                    </a>


                    <button class="btn btn-outline-success" onclick="window.print()">
                        <i class="bi bi-printer"></i> Print
                    </button>


                </div>
            }
        </div>
    }
}

@code {

    protected override string ScreenName => "Sales Order";

    [Parameter]
    public int PoId { get; set; }

    [Parameter]
    public bool isOtherScreen { get; set; }

    private bool isProcessing { get; set; } = true;
    private MfgPoVM MfgPoVMs { get; set; } = new MfgPoVM();
    private CustomerVM CustomerVMs { get; set; } = new CustomerVM();

    private Companydetails company { get; set; } = new Companydetails();
    private List<MfgPoSubVM> refQuotations = new();
    private string refQuoteNosDisplay = "N/A";
    private string refQuoteDatesDisplay = "N/A";
    private int Decimalplaces { get; set; } = 2;


    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private string FormatDecimal(decimal? value)
    {
        try
        {
            if (value == null) return "0";
            return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
        }
        catch (Exception ex)
        {
            _js.ToastrError("Error while Loading FormatDecimal in MfgPODetails()");
            LoggingService.LogDeveloperError(ex, "Error while Loading FormatDecimal in MfgPODetails()");
            return "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            else
            {
                company = await _mfgPoService.GetCompanyDetailsAsync();
                await LoadManufacturingPo();
                isProcessing = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error while Loading OnInitializedAsync() in MfgPODetails()");
        }
    }

    private async Task LoadManufacturingPo()
    {
        try
        {
            if (PoId > 0)
            {
                var po = await _mfgPoService.GetPoByPoIdAsync(PoId);
                if (po != null)
                {
                    MfgPoVMs = po;
                }

                Decimalplaces = await _mfgPoService.GetDecimalPlacesAsync();
                CustomerVMs = await _mfgPoService.GetCustomerByIdAsync(MfgPoVMs.CustId);
                refQuotations = await _mfgPoService.GetDistinctRefQuoteByPoIdAsync(MfgPoVMs.PoId);

                if (refQuotations.Any())
                {
                    // Only join the existing items, no extra commas
                    refQuoteNosDisplay = string.Join(", ", refQuotations.Select(e => e.RefQuoteNo).Where(n => !string.IsNullOrEmpty(n)));
                    refQuoteDatesDisplay = string.Join(", ", refQuotations
                        .Select(e => e.RefQuoteDate.HasValue ? e.RefQuoteDate.Value.ToString("dd/MM/yyyy") : null)
                        .Where(d => !string.IsNullOrEmpty(d)));
                }
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error while Loading LoadManufacturingPo() in MfgPODetails()");
            await LoggingService.LogDeveloperError(ex, "Error while Loading LoadManufacturingPo() in MfgPODetails()");
        }
    }
}
