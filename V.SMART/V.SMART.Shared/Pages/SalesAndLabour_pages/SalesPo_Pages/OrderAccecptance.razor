@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.ManufacturingPoVM
<EditForm Model="@MfgPoVMs" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3" />

    <div class="container-fluid">

        <!-- Row 1: OA No and OA Date -->
        <div class="row g-3 mb-3">

            <div class="col-md-6">
                <div class="form-floating">
                    <InputText @bind-Value="MfgPoVMs.OANo" class="form-control" id="oaNo" placeholder="Enter OA No" readonly />
                    <label for="oaNo">OA No</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <InputDate @bind-Value="MfgPoVMs.OADate" class="form-control" id="oaDate" placeholder="Select OA Date" />
                    <label for="oaDate">OA Date </label>
                    <ValidationMessage For="@(() => MfgPoVMs.OADate)" class="text-danger small" />
                </div>
            </div>

        </div>

        <!-- Row 2: Work Order No and Work Order Date -->
        <div class="row g-3 mb-3">

            <div class="col-md-6">
                <div class="form-floating">
                    <InputText @bind-Value="MfgPoVMs.OAWONO" class="form-control" id="woNo" placeholder="Enter Work Order No" readonly />
                    <label for="woNo">Work Order No</label>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-floating">
                    <InputDate @bind-Value="MfgPoVMs.OAWODate" class="form-control" id="woDate" placeholder="Select Work Order Date" />
                    <label for="woDate">Work Order Date</label>
                    <ValidationMessage For="@(() => MfgPoVMs.OAWODate)" class="text-danger small" />
                </div>
            </div>

        </div>

        <!-- Row 3: OA Remarks -->
        <div class="row g-3 mb-3">
            <div class="col-12">
                <div class="form-floating">
                    <InputTextArea @bind-Value="MfgPoVMs.OARemarks" class="form-control" id="oaRemarks" placeholder="Enter OA Remarks" rows="3" />
                    <label for="oaRemarks">OA Remarks</label>
                    <ValidationMessage For="@(() => MfgPoVMs.OARemarks)" class="text-danger small" />
                </div>
            </div>
        </div>

        <!-- Row 4: OA Terms & Conditions -->
        <div class="row g-3 mb-3">
            <div class="col-12">
                <div class="form-floating">
                    <InputTextArea @bind-Value="MfgPoVMs.OATerms" class="form-control" id="oaTerms" placeholder="Enter OA Terms & Conditions" rows="4" />
                    <label for="oaTerms">OA Terms & Conditions </label>
                    <ValidationMessage For="@(() => MfgPoVMs.OATerms)" class="text-danger small" />
                </div>
            </div>
        </div>

    </div>
</EditForm>

@code {
    [Parameter] public MfgPoVM MfgPoVMs { get; set; } = new MfgPoVM();
    [Parameter] public EventCallback OnValidSubmitCallback { get; set; }

    private async Task HandleValidSubmit()
    {
        if (OnValidSubmitCallback.HasDelegate)
            await OnValidSubmitCallback.InvokeAsync(null);
    }
}
