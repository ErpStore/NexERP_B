    #region Row Operations

    private async Task<bool> ValidateRowAsync(LabourGRNSubVM row)
    {
        try
        {
            var errors = new List<string>();
            int itemid = 0;
            decimal  qty = 0;

            int.TryParse(row.ItemId.ToString(), out itemid);
            decimal.TryParse(row.Qty.ToString(), out qty);

            if (row.ItemId == null && LabourGRNVMs.LabourGRNSubVMs.Count==1)
                errors.Add("Please select an Item ");

            if (itemid>0 && qty<= 0 && LabourGRNVMs.LabourGRNSubVMs.Count>=1)
                errors.Add("Quantity out must be greater than 0.");

            if (row.UnitPrice <= 0 && LabourGRNVMs.LabourGRNSubVMs.Count==1)
                errors.Add("Unit Price must be greater than 0.");

            if (itemid==0 &&  LabourGRNVMs.LabourGRNSubVMs.Count==1)
            {
                await _JS.ToastrWarning("Please select item Out");
                return false;
            }

            if (itemid>0  && LabourGRNVMs.LabourGRNSubVMs.Count>=1 && qty<=0)
            {
                await _JS.ToastrWarning($"Item {row.ItemCode}: Quantity out must be greater than 0.");
                return false;
            }

            if (!row.UnitPrice.HasValue || row.UnitPrice <= 0)
            {
                await _JS.ToastrWarning($"Item {row.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            // Qty vs PO / Already Transacted validation
            if (row.GRNSubId == 0 && row.RefPoSubId > 0 && !row.isOpenPo)
            {
                var poBalQty = await _grnService.GetPoItemBalQtyFromPoSubId(row.RefPoSubId.Value);

                if ((row.Qty > poBalQty))
                {
                    row.Qty = poBalQty;
                    row.BalQty = poBalQty;
                    await _JS.ToastrWarning($"Qty cannot exceed Po Balance Qty ({poBalQty}).");
                    return false;
                }
            }
            else if (row.GRNSubId > 0)
            {
                var original = await _grnService.GetGRNSubItemDetailByGRNSubIdAsync(row.GRNSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty.Value;
                    decimal origQty = original.Qty.GetValueOrDefault();
                    var alreadyTransacted = origQty - origBalQty;

                    if (row.Qty < alreadyTransacted)
                    {
                        row.Qty = alreadyTransacted;
                        row.BalQty = 0m;
                        await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = row.Qty.GetValueOrDefault() - origQty;
                        row.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }
            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _JS.ToastrWarning(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = LabourGRNVMs.LabourGRNSubVMs.LastOrDefault();


            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

