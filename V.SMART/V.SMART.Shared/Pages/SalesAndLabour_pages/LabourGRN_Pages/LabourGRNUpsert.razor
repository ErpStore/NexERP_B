    #region Receive Items from Excel Upload

    private async Task ReceiveItems(List<ExcelUploadVM> items)
    {
        try
        {
            if (items == null || !items.Any()) return;

            // Map each ExcelUploadVM to LabourGRNSUB
            if (LabourGRNVMs.LabourGRNSubVMs == null || LabourGRNVMs.WithoutPoGRN)
            {
                LabourGRNVMs.LabourGRNSubVMs = new List<LabourGRNSubVM>();
            }

            var newItems = items
           .Where(i => !LabourGRNVMs.LabourGRNSubVMs.Any(e => e.ItemId == i.ItemId))
           .Select(item => new LabourGRNSubVM
            {
                SlNo = item.SlNo,
                TransType = item.TransType,
                ItemId = item.ItemId,
                ItemCode = item.ItemCode,
                ItemName = item.ItemName,
                ItemSpecification=item.ItemSpeification,
                DCQty = item.DCQty,
                Qty = item.Qty,
                BalQty=item.RecievedQty,
                
                UnitPrice = item.UnitPrice,
                MeasureUnit = item.MeasureUnit,

                HSNCode = item.HSNCode,
                WONo = item.WONo,
                RowRemarks = item.RowRemarks,
                BatchNo = item.BatchNo,
                HeatNo = item.HeatNo
            });

            LabourGRNVMs.LabourGRNSubVMs.AddRange(newItems);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ReceiveItems() failed.");
            await _JS.ToastrError("Error processing ReceiveItems() items.");
        }
    }
    #endregion


    #region Display SlNo From In Items

    private int GetDisplaySlNo(LabourGRNSubVM item)
    {
        if (!LabourGRNVMs.IsOutItemSameAsInItem)
            return item.SlNo;

        var list = LabourGRNVMs.LabourGRNSubVMs
                    .Where(x => x.TransType == "In")
                    .ToList();

        var index = list.IndexOf(item);

        return index >= 0 ? index + 1 : 0;
    }
    #endregion

    #region Calculate GroupId For IN and OUT items

    private void RecalculateGroupIds()
    {
        try
        {
            var list = LabourGRNVMs?.LabourGRNSubVMs;

            if (list == null || !list.Any())
                return;

            int groupId = 1;
            bool inStarted = false;

            foreach (var row in list)
            {
                if (row.TransType == "Out")
                {
                    if (inStarted)
                    {
                        groupId++;
                        inStarted = false;
                    }

                    row.GroupId = groupId;
                }
                else if (row.TransType == "In")
                {
                    row.GroupId = groupId;
                    inStarted = true;
                }
            }
        }
        catch (Exception ex)
        {
            LoggingService.LogDeveloperError(ex, "RecalculateGroupIds() failed.");
        }
    }

    #endregion


    private async Task AddToGroup(LabourGRNSubVM item)
    {
        try
        {
            if (item == null)
            {
                await _JS.ToastrWarning("Invalid row selected.");
                return;
            }

            var list = LabourGRNVMs?.LabourGRNSubVMs;

            if (list == null || !list.Any())
            {
                await _JS.ToastrWarning("No rows available.");
                return;
            }

            if (LabourGRNVMs.IsOutItemSameAsInItem)
            {
                await _JS.ToastrWarning("Out Item Same As In Item enabled. Cannot add group row.");
                return;
            }

            int insertIndex = list.IndexOf(item);

            if (insertIndex < 0)
                insertIndex = list.Count - 1;

            var newRow = new LabourGRNSubVM
            {
                TransType = "In",
                IsEditable = true
            };

            list.Insert(insertIndex + 1, newRow);

            // Recalculate GroupIds based on Out/In logic
            RecalculateGroupIds();

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"AddToGroup() failed. ItemId: {item?.ItemId}");
            await _JS.ToastrError("Error processing AddToGroup().");
        }
    }

