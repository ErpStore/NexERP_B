        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for GRNSubId: {item?.GRNSubId}");
            await _JS.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(LabourGRNSubVM item)
    {
        try
        {
            if (LabourGRNVMs.LabourGRNSubVMs.Count == 1 && item.GRNSubId > 0)
            {
                await _JS.ToastrWarning("At least 1 row item is required.");
                return;
            }

            // New validation
            var grnItems = LabourGRNVMs.LabourGRNSubVMs
                    .Where(x => x.GRNId == item.GRNId)
                    .ToList();

            int grnCount = grnItems.Count();
            int inCount = grnItems.Count(x => x.TransType == "In");
            int outCount = grnItems.Count(x => x.TransType == "Out");

            bool isOnlyOneGRN = grnCount <= 1;
            bool isOnlyOneInItem = inCount <= 1 && item.TransType == "In";
            bool isOnlyOneOutItem = outCount <= 1 && item.TransType == "Out";
            bool isExistingGRNSub = item.GRNSubId > 0;

            if ((isOnlyOneGRN || isOnlyOneInItem || isOnlyOneOutItem) && isExistingGRNSub)
            {
                await _JS.ToastrWarning("Cannot delete. At least one In and one Out item required.");
                return;
            }

            if (LabourGRNVMs.DcCancel)
            {
                await _JS.ToastrError("This Labour GRN is already cancelled. Row deletion is not allowed.");
                return;
            }

            if (LabourGRNVMs.ShortClose)
            {
                await _JS.ToastrError("This Quotation is already short closed. Row deletion is not allowed.");
                return;
            }

            if (item.ItemCancel)
            {
                await _JS.ToastrWarning("This item has already been cancelled and cannot be removed.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }


            if (item.ItemId == 0)
            {
                LabourGRNVMs.LabourGRNSubVMs.Remove(item);
                await _JS.ToastrSuccess("New item row removed successfully.");


                if (!LabourGRNVMs.LabourGRNSubVMs.Any())
                    LabourGRNVMs.LabourGRNSubVMs = new List<LabourGRNSubVM>();

                await ResetSlno();

                RecalculateGroupIds();

                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";

            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for GRNSubId: {item?.GRNSubId}");
            await _JS.ToastrError("Failed to remove the row. Please try again.");
        }
    }

