    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (LabourGRNVMs.LabourGRNSubVMs == null)
            LabourGRNVMs.LabourGRNSubVMs = new();

        if (LabourGRNVMs.AddStoreId == 0)
        {
            await _JS.ToastrWarning("Please select Purchase Store");
            return;
        }

        try
        {
            foreach (var item in selectedItems)
            {
                var itemId = GetInt(item, "ItemId");
                var poSubId = GetInt(item, "PoSubId");
                var categoryCode = GetInt(item, "CategoryCode");

                if (LabourGRNVMs.LabourGRNSubVMs.Any(x => x.ItemId == itemId && x.RefPoSubId == poSubId ))
                    continue;

                var parentVm = CreateParentVM(item, itemId, poSubId);

                LabourGRNVMs.LabourGRNSubVMs.Add(parentVm);

                if (LabourGRNVMs.IsOutItemSameAsInItem)
                {
                    await AddSameItemChildAsync(parentVm);
                }
                else if (categoryCode == 3 || categoryCode == 7)
                {
                    await AddAssemblyChildrenAsync(parentVm, itemId);
                }
                else if (categoryCode == 2)
                {
                    await AddRawMaterialChildAsync(parentVm, itemId);
                }
            }

            RecalculateGroupIds();
            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected items.");
        }
    }

