@code
{
    protected override string ScreenName => "Labour GRN";
    private bool isProcessing = false;
    [Parameter] public int? GRNId { get; set; }
    [Parameter] public int CustId { get; set; }
    private int screenCode { get; set; }
    private int poPendingCount = 0;
    private bool IsSomeItemsTransMade { get; set; } = false;
    private bool pricelock{ get; set; } = false;

    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;
    string? pdfBase64;

    private LabourGRNVM LabourGRNVMs = new();
    private CustomerVM? SelectedCustomer;
    private List<Store> stores = new();
    private List<ContactPerson> contactPersons = new();
    private List<CostCenterVM> CostCenterVMs = new();
    private LabourGRNSubVM? rowToDelete;
    private LabourGRNSubVM? rowToCancel;

    private bool IsPoModalVisible = false;
    private List<Dictionary<string, object>>? PoData;

    private HashSet<int> StockErrorSlNos = new();

    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    private int DecimalPlaces { get; set; } = 2;
    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";
    private bool IsLabourCost { get; set; } = false;
    private bool IsLabourMaterial { get; set; } = false;

    private bool IsBatchNoRequired { get; set; } = false;   

    // Visible Column Titles
    private List<string> PoColumns = new()
    {
        "Selected","PoSubId","PoId","Is Open Po","LineNo","Po No","Po Date","ItemId","Item Code","Item Name","Item Specification","UOM","HSN Code","Category","Qty",
        "Bal Qty","Unit Price","Po Due Date","CostCenterId","Project No","Remark","Main Discount %","Main Discount Amt","Packing %","Packing Amt",
        "Insurance %","Insurance Amt","Freight Amt","Today Value","Total Gross Amt","Total Basic Amt","Line Gross","Sub Discount %","Sub Discount Amt","Line Basic Amt",
        "Total Qty","CategoryCode","Customer"
    };

    // Field Names (backend binding)
    private List<string> PoFields = new()
    {
        "Selected","PoSubId","PoId","IsOpenPo","LineNo","PoNo","PoDate","ItemId","ItemCode","ItemName","ItemSpecification","UOM","HSNCode","Category","Qty",
        "BalQty","UnitPrice","PoDuedate","CostCenterId","ProjectNo","Remark","MainDiscPercent","MainDiscAmt","PackingPercent","PackingAmt",
        "InsurancePercent","InsuranceAmt","FreightAmt","TodayVal","TotalGrossAmt","TotalBasicAmt","LineGross","SubDiscPercent","SubDiscAmt","LineBasicAmt","TotalQty","CategoryCode","Customer"
    };

    // Hidden Columns (IDs and internal refs)
    private List<string> PoHiddenColumns = new()
    {
        "PoSubId","PoId","ItemId", "CostCenterId","CategoryCode"
    };

    private List<PageHeader.BreadcrumbItem> LabourGRNBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Labour" },
        new PageHeader.BreadcrumbItem { Text = "Goods Received Note cum DC", IsLast = true }
    };


    #region OnSameItemChanged

    private async Task OnSameItemChanged(ChangeEventArgs e)
    {
        bool isChecked = Convert.ToBoolean(e.Value);

        if (isChecked && LabourGRNVMs.WithoutPoGRN)
        {
            LabourGRNVMs.IsOutItemSameAsInItem = false;

            await _JS.ToastrWarning("'Out Item Same as In Item' cannot be used when 'Without PO GRN' is enabled.");
            return;
        }

        LabourGRNVMs.IsOutItemSameAsInItem = isChecked;
    }

    #endregion

    private async Task OnTransTypeChanged(LabourGRNSubVM subitem)
    {
        if (subitem.TransType == "Out" && LabourGRNVMs.IsOutItemSameAsInItem)
        {
            await _JS.ToastrWarning("Out Item cannot be selected when 'Out Item Same as In Item' is enabled.");

            subitem.TransType = "In";
        }
    }

    private async Task ToggleGRN(bool isWithoutPo)
    {
        if (LabourGRNVMs.IsOutItemSameAsInItem)
        {
            LabourGRNVMs.WithoutPoGRN = false;
            await _JS.ToastrWarning("Cannot enable 'Without PO GRN' when 'Out Item Same as In Item' is active.");
            return;
        }

        LabourGRNVMs.WithoutPoGRN = isWithoutPo && !LabourGRNVMs.WithoutPoGRN;

        if (LabourGRNVMs.WithoutPoGRN)
            LabourGRNVMs.LabourGRNSubVMs.Clear();
    }

    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            pricelock = await _grnService.GetPriceLockStatusAsync();    
            screenCode = await _grnService.GetScreenCodeByScreenNameAsync(ScreenName);
            IsLabourCost = await _CostingService.IsLabourChargesDisplayEnabledAsync();
            IsLabourMaterial = await _CostingService.IsLabourMaterialValidateEnabledAsync();
            IsBatchNoRequired = await _grnService.BatchNoOption();

            if (GRNId.HasValue)
            {
                await LoadExistingGRN(GRNId.Value);
            }
            else if (CustId > 0)
            {
                await InitializeNewGRN(CustId);

                LabourGRNVMs.IsOutItemSameAsInItem = await _grnService.GetIsSameItemasInAsync();    
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingGRN(int grnId)
    {
        try
        {
            LabourGRNVMs = await _grnService.GetLabourGRNByIdAsync(grnId);
            if (LabourGRNVMs == null)
            {
                await _JS.ToastrWarning("GRN not found.");
                return;
            }

            SelectedCustomer = await _grnService.GetCustomerByIdAsync(LabourGRNVMs.CustId);
            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

            foreach (var dcSub in LabourGRNVMs.LabourGRNSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[dcSub.ItemId.Value] =
                    await _grnService.GetCorrespondenceAttachmentsCountAsync(dcSub.ItemId.Value, "Item");
                if(IsLabourCost)
                {
                    if (dcSub.UnitPrice < dcSub.LabourCost)
                    {
                        _JS.ToastrWarning($"Unit Price ({dcSub.UnitPrice:0.00}) Is less than Labour Cost ({dcSub.LabourCost:0.00})." );
                    }
                    else if(dcSub.UnitPrice > dcSub.LabourCost)
                    {
                        _JS.ToastrWarning($"Unit Price ({dcSub.UnitPrice:0.00}) Is  Greater than than Labour Cost ({dcSub.LabourCost:0.00})."     );

                    }

                }
            }

            //Check Transaction Completed flag
            IsSomeItemsTransMade = await CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load Existing PurchaseGRN.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingDc failed in PurchaseGRN for GRNId: {grnId}");
        }
    }

    private async Task<bool> CheckIsTransMade()
    {
        try
        {
            if (!GRNId.HasValue)
                return false;

            return await _grnService.IsLabourGRNTransactionsMatchedAsync(GRNId.Value, LabourGRNVMs);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to check transaction exists.");
            await LoggingService.LogDeveloperError(ex, "[CheckIsTransMade] failed");
            return false;
        }
    }

