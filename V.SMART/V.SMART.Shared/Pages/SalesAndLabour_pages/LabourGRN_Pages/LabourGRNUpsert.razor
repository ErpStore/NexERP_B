    private async Task CancelEdit(LabourGRNSubVM? item, LabourGRNVM? parentDc)
    {
        try
        {
            if (item == null || parentDc == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (item.Qty.GetValueOrDefault() <= 0) ||
                (item.UnitPrice <= 0);

            if (isEmptyOrInvalid)
            {
                parentDc.LabourGRNSubVMs.Remove(item);
                RecalculateGroupIds();
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
