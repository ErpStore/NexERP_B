    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.GRNSubId > 0)
            {
                await _grnService.DeleteAndResequenceAsync(rowToDelete, LabourGRNVMs,screenCode);

                LabourGRNVMs = await _grnService.GetLabourGRNByIdAsync(LabourGRNVMs.GRNId);
            }
            else
            {
                var list = LabourGRNVMs.LabourGRNSubVMs;

                var groupItems = list
                    .Where(x => x.GroupId == rowToDelete.GroupId)
                    .ToList();

                var outItems = groupItems.Where(x => x.TransType == "Out").ToList();
                var inItems = groupItems.Where(x => x.TransType == "In").ToList();

                list.Remove(rowToDelete);

                // OUT row deleted
                if (rowToDelete.TransType == "Out")
                {
                    if (outItems.Count == 1)
                    {
                        foreach (var item in inItems)
                            list.Remove(item);
                    }
                }

                // IN row deleted
                else if (rowToDelete.TransType == "In")
                {
                    if (inItems.Count == 1)
                    {
                        foreach (var item in outItems)
                            list.Remove(item);
                    }
                }

                // If list empty add new row
                if (!list.Any())
                {
                    list.Add(new LabourGRNSubVM
                    {
                        GRNId = LabourGRNVMs.GRNId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    await ResetSlno();
                    RecalculateGroupIds();
                }
            }

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for GRNId:{LabourGRNVMs.GRNId} ");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

