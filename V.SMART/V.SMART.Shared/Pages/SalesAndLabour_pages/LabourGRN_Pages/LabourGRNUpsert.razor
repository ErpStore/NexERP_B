@page "/labourGRN/create"
@page "/labourGRN/create/{CustId:int}"
@page "/labourGRN/update/{GRNId:int}"


@using MudBlazor
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ILabourGRNService _grnService
@inject ICostingService _CostingService
@inject ReportService reportService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">

</BsModal>

<DetailsModal Title="PO Details"
              Columns="@PoColumns"
              ColumnFields="@PoFields"
              HiddenColumns="@PoHiddenColumns"
              Data="@PoData"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="OnPoSelectedAsync">
</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "ExcelUpload")
    { 
        <ExcelUpload isModelVisible=true OnClose="CloseModal" uploadType="LabourGRN" OnUploadCompleted="ReceiveItems"/>
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }

</MasterModal>


<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }

</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{

    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <!-- Cancelled Watermark -->
            @if (LabourGRNVMs.DcCancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (LabourGRNVMs.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }

            <PageHeader TitleText="@(LabourGRNVMs.GRNId > 0 ? "Update Goods Received Note cum DC" : "Create Goods Received Note cum DC")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@LabourGRNBreadcrumbs" />
            <div class="card-body bg-light">
                <EditForm Model="LabourGRNVMs" OnValidSubmit="UpsertGRN">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Correspondence Status -->
                        @if (LabourGRNVMs.GRNId > 0 && !string.IsNullOrWhiteSpace(LabourGRNVMs.GRNNo))
                        {
                            <CorrespondenceStatus ReferenceType="Labour-GRN"
                                                  ReferenceId="@LabourGRNVMs.GRNId"
                                                  ReferenceTypeName="@LabourGRNVMs.GRNNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header equal-card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <!-- Title -->
                                    <span class="fw-bold fs-6 mb-0">Customer Information</span>
                                    <!-- Right Section -->
                                    <div class="d-flex align-items-center gap-3">

                                       <!-- Checkbox -->
                                        @if(!LabourGRNVMs.WithoutPoGRN)
                                        {
                                            <div class="form-check d-flex align-items-center mb-0">
                                                <input class="form-check-input me-2 mt-0"
                                                        type="checkbox"
                                                        id="chkSameItem"
                                                        style="border:2px solid #6c757d;"
                                                        checked="@LabourGRNVMs.IsOutItemSameAsInItem"
                                                        @onchange="OnSameItemChanged"
                                                        disabled="@(LabourGRNVMs.GRNId > 0 || (LabourGRNVMs.LabourGRNSubVMs?.Any(x => (x.ItemId ?? 0) > 0) ?? false))">

                                                <label class="form-check-label small mb-0" for="chkSameItem">
                                                    Out Item Same as In Item
                                                </label>
                                            </div>                                   
                                        }
                                        
                                        <!-- Button -->
                                        <button type="button"
                                                class="btn btn-sm btn-success rounded-3 d-flex align-items-center"
                                                @onclick='() => OpenModal("Customer")'>
                                            <i class="bi bi-person-add me-1"></i> Add Customer
                                        </button>
                                    </div>
                                </div>

                                <div class="card-body">
                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="CustomerVM"
                                                             Value="SelectedCustomer"
                                                             ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                             ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                             SearchFunc="SearchCustomers"
                                                             Dense="true"
                                                             Variant="Variant.Outlined"
                                                             Placeholder="Search Customer"
                                                             Title="Search atleast 3 letters in Customer"
                                                             Class="w-100 autocomplete-sm"
                                                             MaxItems="50"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             Required="true"
                                                             AvoidSubmit="true"
                                                             Disabled="@IsSomeItemsTransMade" />
                                        </div>
                                    </div>

                               
                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    @bind="@LabourGRNVMs.KindofAttention">
                                                <option disabled value="">Select Contact Person</option>
                                                @foreach (var cp in contactPersons)
                                                {
                                                    <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => LabourGRNVMs.KindofAttention)" />
                                        </div>
                                    </div>

                                
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Mode Of Transport</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm"
                                                    @bind="LabourGRNVMs.TransportMode">
                                                <option value="">-- Select Transport Mode --</option>
                                                <option value="Road">By Road</option>
                                                <option value="Railway">By Railway</option>
                                                <option value="Airway">By Airway</option>
                                                <option value="Seaway">By Seaway</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Vehicle No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100" @bind="LabourGRNVMs.VehicleNo" />
                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Transport From</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100" @bind="LabourGRNVMs.TransFrom" />
                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Transport To</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100" @bind="LabourGRNVMs.TransTo" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- =================== GRN Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                 <!-- Header -->
                                <div class="card-header equal-card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Labour GRN Details</span>

                                    @if (LabourGRNVMs.GRNId > 0 && (CanCreate || CanEdit))
                                    {
                                        <div class="d-flex gap-2">
                                            <button type="button"
                                                    class="btn btn-sm rounded-3 @(LabourGRNVMs.DcCancel ? "btn-success" : "btn-danger")"
                                                    @onclick="Cancel">

                                                @if (!LabourGRNVMs.DcCancel)
                                                {
                                                    <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                                }
                                            </button>
                                            <!-- Short Close / Re-Open -->
                                            <button type="button"
                                                class="btn btn-sm rounded-3 @(LabourGRNVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                @onclick="() => AskToShortCloseAsync(LabourGRNVMs)"
                                                disabled="@LabourGRNVMs.DcCancel">

                                                @if (!LabourGRNVMs.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Close</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>
                                        </div>
                                    }
                                </div>
                                <div class="card-body">

                                    @if (LabourGRNVMs?.LabourGRNSubVMs == null
                                            || !LabourGRNVMs.LabourGRNSubVMs.Any(x => !string.IsNullOrEmpty(x.RefPoNo)))
                                    {
                                        <div class="row g-2 mb-2 align-items-stretch">
                                               <div class="col-12 col-sm-6">

                                                    <div class="card shadow-sm border-2
                                                         @(LabourGRNVMs.WithoutPoGRN
                                                             ? "border-success bg-success-subtle selected-card"
                                                             : "border-light")
                                                         @(LabourGRNVMs.GRNId > 0 ? "disabled-card" : "")"
                                                         style="cursor:@(LabourGRNVMs.GRNId > 0 ? "not-allowed" : "pointer"); height:60px;"
                                                         @onclick="LabourGRNVMs.GRNId > 0 ? null : (() => ToggleGRN(true))">

                                                        <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                            <i class="bi 
                                                                @(LabourGRNVMs.WithoutPoGRN
                                                                    ? "bi-check-circle-fill text-success"
                                                                    : "bi-circle text-muted") me-2"></i>

                                                            <span class="fw-semibold
                                                                @(LabourGRNVMs.WithoutPoGRN
                                                                    ? "text-success"
                                                                    : "text-dark")">
                                                               Without PO
                                                            </span>

                                                        </div>
                                                </div>
                                                 
                                           </div>

                                        </div>
                                    }
                                    
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GRN No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm flex-wrap w-100">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="GRN No."
                                                       @bind="LabourGRNVMs.GRNNo" disabled="@(LabourGRNVMs.GRNId>0)"/>

                                                <span class="input-group-text rounded-end">@LabourGRNVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => LabourGRNVMs.GRNNo)" />
                                            <ValidationMessage For="@(() => LabourGRNVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- GRN Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GRN Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@LabourGRNVMs.GRNDate" />
                                            <ValidationMessage For="@(() => LabourGRNVMs.GRNDate)" />
                                        </div>
                                    </div>

                                    <!-- PO Details -->
@*                                     @if (poPendingCount > 0 && !LabourGRNVMs.WithoutPoGRN)
                                    { *@
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. PO</small>
                                            </label>
                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                    class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                    @onclick="ShowPoDetails">
                                                   <i class="bi bi-list-ul me-1"></i>  PO Details
                                                </button>
                                            </div>
                                        </div>
                                    @* } *@

                                    @if (IsBatchNoRequired)
                                    {

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Batch No.</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <div class="input-group input-group-sm flex-wrap w-100">
                                                        <input type="text"
                                                        class="form-control form-control-sm"
                                                        placeholder="Batch No."
                                                        @bind="LabourGRNVMs.BatchNo"/>
                                                    </div>
                                                    <ValidationMessage For="@(() => LabourGRNVMs.BatchNo)" />
                                                </div>
                                            </div>

                                     }

                                    <!-- Dc No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Customer Dc</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="LabourGRNVMs.RefDcNo" />
                                            <ValidationMessage For="@(() => LabourGRNVMs.RefDcNo)" />
                                        </div>
                                    </div>

                                    <!-- RefDC Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>DC Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="LabourGRNVMs.RefDcDate" />
                                            <ValidationMessage For="@(() => LabourGRNVMs.RefDcDate)" />
                                        </div>
                                    </div>

                                      <!---for Sharadha company only->
                                    @if (!IsBatchNoRequired)
                                    {
                                        <!-- Add to Store -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Add To Store</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select @bind="LabourGRNVMs.AddStoreId"
                                                        class="form-select form-select-sm rounded-3 w-100"
                                                        id="PurchaseGRN" disabled>
                                                    <option value="0" disabled selected>--Select Store--</option>
                                                    @foreach (var storeid in stores)
                                                    {
                                                        <option value="@storeid.StoreId">@storeid.StoreName</option>
                                                    }
                                                </select>
                                                <ValidationMessage For="@(() => LabourGRNVMs.AddStoreId)" />
                                            </div>
                                        </div>
                                    }

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="LabourGRNVMs.Remarks"></textarea>
                                            <ValidationMessage For="@(() => LabourGRNVMs.Remarks)" />
                                        </div>
                                    </div>

                                      <!-- Cancel Remarks -->
                                    @if(LabourGRNVMs.DcCancel)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="LabourGRNVMs.CancelReason"
                                                            readonly></textarea>
                                                <ValidationMessage For="@(() => LabourGRNVMs.CancelReason)" />
                                            </div>
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Date</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="date" class="form-control form-control-sm rounded-3 w-100"
                                                            @bind="LabourGRNVMs.CancelDate"
                                                            readonly></input>
                                                <ValidationMessage For="@(() => LabourGRNVMs.CancelDate)" />
                                            </div>
                                        </div>
                                    }

                                </div>

                            </div>
                        </div>

                          <!-- =================== Item Details =================== -->
                        <div class="col-12">

                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header bg-primary-subtle text-dark">

                                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                                        <span class="fw-bold fs-6">GRN Item Details</span>

                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>

                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                         <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed;min-width: 1700px;">
                                             
                                             <thead class="custom-blue">
                                                 <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:80px;">Group</th>
                                                    <th style="width:90px;">Trans Type</th>
                                                    <th style="width:300px;">Item-Code</th>
                                                    <th style="width:200px;">Item Name</th>
                                                    <th style="width:300px;">Item Specification</th>
                                                    <th style="width:90px;">UOM</th>
                                                     @if (IsLabourCost)
                                                    {
                                                        <th style="width:100px;">LabourCost</th>
                                                    }
                                                    <th style="width:100px;">DC Qty</th>
                                                   
                                                    <th style="width:100px;">Recd. Qty.</th>
                                                     @if(LabourGRNVMs.GRNId>0)
                                                     {
                                                        <th style="width:110px;">Bal Qty</th>
                                                     } 
                                                 
                                                    <th style="width:110px;">Unit Price</th>

                                                    @if (LabourGRNVMs.LabourGRNSubVMs.Any(x => x.RefPoSubId > 0))
                                                    {
                                                        <th style="width:110px;">PO Bal.Qty</th>
                                                        <th style="width:110px;">Ref. PO No</th>
                                                        <th style="width:110px;">Ref. PO Dt.</th>
                                                        <th style="width:110px;">LineNo</th>
                                                    }

                                                    <th style="width:120px;">WoNo.</th>
                                                    <th style="width:150px;">Remarks</th>
                                                    <th style="width:130px;">Cost Center</th>
                                                    <th style="width:110px;">Batch No.</th>
                                                    <th style="width:110px;">Heat No.</th>
                                                    
                                                    @if (!LabourGRNVMs.DcCancel && (GRNId.HasValue || GRNId > 0))
                                                    {
                                                        <th style="width:130px;">Item Cancel</th>
                                                        <th style="width:160px;">Cancel Reason</th>
                                                    }
                                                    @if (!LabourGRNVMs.DcCancel && !LabourGRNVMs.ShortClose)
                                                    {
                                                        <th style="width:130px;" class="freeze-last-col text-end">Action</th>
                                                    }
                                                 </tr>
                                             </thead>

                                             <tbody class="custom-size">

                                                @foreach (var subitem in LabourGRNVMs.LabourGRNSubVMs)
                                                {
                                                     // Hide OUT rows in UI
                                                     if (subitem.TransType == "Out" && LabourGRNVMs.IsOutItemSameAsInItem && !LabourGRNVMs.WithoutPoGRN)
                                                     {
                                                         continue;
                                                     }

                                                    <tr @key="subitem" class="@(subitem.ItemCancel ? "table-danger" : "")">

                                                        @if(!LabourGRNVMs.IsOutItemSameAsInItem)
                                                        {
                                                        <td>@subitem.SlNo</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@GetDisplaySlNo(subitem)</td>
                                                        }

                                                        <td>@subitem.GroupId</td>

                                                        <!-- Item Code + Attachments -->
                                                        @if ((subitem.RefPoSubId == 0 || subitem.RefPoSubId == null) && subitem.IsEditable)
                                                        {
                                                            <td style="width:120px;">
                                                                <select class="form-select form-select-sm"
                                                                        @bind="subitem.TransType"
                                                                        @bind:after="() => OnTransTypeChanged(subitem)">

                                                                    @if (LabourGRNVMs.WithoutPoGRN)
                                                                    {
                                                                        <option value="Out">Out</option>
                                                                        <option value="In">In</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="In">In</option>
                                                                    }

                                                                </select>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td style="width:120px;">
                                                                @subitem.TransType
                                                            </td>
                                                        }

                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    
                                                                    @if(subitem.IsEditable && subitem.CanEditItem
                                                                        && (subitem.TransType=="In" && !LabourGRNVMs.IsOutItemSameAsInItem || LabourGRNVMs.WithoutPoGRN))
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                            Value="subitem.SelectedItemOut"
                                                                                            ValueChanged="@(async item => await OnItemOutChanged(subitem, item))"
                                                                                            ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                            SearchFunc="SearchItems"
                                                                                            Dense="true"
                                                                                            Variant="Variant.Outlined"
                                                                                            Placeholder="Search Item Code"
                                                                                            Title="Search Atleast 3 Letters in Item-Code"
                                                                                            Class="w-100 autocomplete-sm"
                                                                                            MaxItems="50" />
                                                                        <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.ItemCode
                                                                    }
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0  && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                       Size="Size.Small"
                                                                                       Color="Color.Primary"
                                                                                       OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                       Edge="Edge.End"
                                                                                       Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
