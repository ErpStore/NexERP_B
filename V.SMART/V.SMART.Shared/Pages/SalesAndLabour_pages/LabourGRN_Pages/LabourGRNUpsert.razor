    private async Task OnDCQtyChanged(ChangeEventArgs e, LabourGRNSubVM subitem)
    {
        try
        {
            if (decimal.TryParse(e.Value?.ToString(), out decimal qty))
            {
                subitem.DCQty = qty;

                // Auto fill Qty
                subitem.Qty = qty;
                subitem.BalQty = qty;
                subitem.ProdCompBalQty = qty;

                // GROUP SYNC LOGIC (ADD THIS PART)  $$ Important For manual &&
                if (LabourGRNVMs.IsOutItemSameAsInItem && subitem.GroupId.HasValue)
                {
                    var groupItems = LabourGRNVMs.LabourGRNSubVMs
                        .Where(x => x.GroupId == subitem.GroupId && x != subitem && x.TransType == "Out")
                        .ToList();

                    foreach (var item in groupItems)
                    {
                        item.Qty = subitem.Qty;
                        item.BalQty = subitem.BalQty;
                        item.DCQty = subitem.DCQty;
                        item.ProdCompBalQty = subitem.ProdCompBalQty;
                    }
                }
            }
            else
            {
                subitem.DCQty = 0;
                subitem.Qty = 0;
                subitem.BalQty = 0;
                subitem.ProdCompBalQty = 0;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"In OnDCQtyChanged()");
            await _JS.ToastrError("Failed to apply item selection  in OnDCQtyChanged Please try again.");
        }

    }
    private async Task OnQtyOutChange(ChangeEventArgs e, LabourGRNSubVM SubVM)
    {
        try
        {

            // Common validation
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                SubVM.ProdCompBalQty = 0;
                await _JS.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW PO line
            if (SubVM.GRNSubId == 0)
            {
                if (SubVM.RefPoSubId > 0)
                {
                    var poBalQty = await _grnService.GetPoItemBalQtyFromPoSubId(SubVM.RefPoSubId.Value);

                    if (SubVM.isOpenPo)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                        SubVM.ProdCompBalQty = newQty;
                    }
                    else
                    {
                        if (newQty <= poBalQty)
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty;
                            SubVM.ProdCompBalQty = newQty;
                        }
                        else
                        {
                            if (LabourGRNVMs.IsOutItemSameAsInItem || SubVM.TransType == "Out")
                            {
                                SubVM.Qty = poBalQty;
                                SubVM.BalQty = poBalQty;
                                SubVM.ProdCompBalQty = poBalQty;

                                await _JS.ToastrWarning($"Qty can't be greater than PO Balance Qty ({poBalQty}).");
                            }
                            else
                            {
                                SubVM.Qty = newQty;
                                SubVM.BalQty = newQty;
                                SubVM.ProdCompBalQty = newQty;
                            }
                        }
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty;
                    SubVM.ProdCompBalQty = newQty;
                }
            }

            // EXISTING DC line
            else
            {
                var original = await _grnService.GetDcSubItemDetailByDcSubIdAsync(SubVM.GRNSubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                var alreadyTransactedProd = original.Qty - original.ProdCompBalQty;


                if (newQty < alreadyTransacted )
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.BalQty = 0;
                  

                    await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                   if (newQty < alreadyTransactedProd )
                {
                    SubVM.Qty = alreadyTransactedProd;
                    SubVM.ProdCompBalQty = 0;

                    await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted In Production Componet Issues).");
                    return;
                }
                if (SubVM.RefPoSubId > 0 && !SubVM.isOpenPo)
                {
                    var poBalQty = await _grnService.GetPoItemBalQtyFromPoSubId(SubVM.RefPoSubId.Value);
                    var maxAllowedQty = original.Qty + poBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();

                        await _JS.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted.GetValueOrDefault();
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted.GetValueOrDefault();
                    SubVM.ProdCompBalQty=newQty- alreadyTransactedProd.GetValueOrDefault();
                }
            }

            // GROUP SYNC LOGIC (ADD THIS PART)  $$ Important For manual &&
            if (LabourGRNVMs.IsOutItemSameAsInItem && SubVM.GroupId.HasValue)
            {
                var groupItems = LabourGRNVMs.LabourGRNSubVMs
                    .Where(x => x.GroupId == SubVM.GroupId && x != SubVM && x.TransType == "Out")
                    .ToList();

                foreach (var item in groupItems)
                {
                    item.Qty = SubVM.Qty;
                    item.BalQty = SubVM.BalQty;
                    item.DCQty = SubVM.DCQty;
                    item.ProdCompBalQty = SubVM.ProdCompBalQty;
                }
            }
        }
        catch (Exception)
        {
            throw;
        }
    }


