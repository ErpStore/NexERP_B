    private async Task AddAssemblyChildrenAsync(LabourGRNSubVM parentVm, int? itemId)
    {
        var asmItems = await _grnService.GetAssemblyItemsAsync(itemId ?? 0);

        if(IsLabourMaterial)
        {
            asmItems = asmItems.Where(x => x.IsLabourMaterial).ToList();
        }

        var ids = asmItems.Where(x => x.ItemId.HasValue).Select(x => x.ItemId.Value).ToList();

        var prices = await _grnService.GetBulkLastUnitPricesAsync(ids, LabourGRNVMs.CustId);

        foreach (var rm in asmItems)
        {
            var qtyCalc = Math.Round(parentVm.Qty.GetValueOrDefault() * rm.UtilQty.GetValueOrDefault(), 3);

            LabourGRNVMs.LabourGRNSubVMs.Add(new LabourGRNSubVM
            {
                TransType = "In",

                SelectedItemOut = await _grnService.GetItemByItemIdAsync(rm.ItemId),

                ItemId = rm.ItemId,
                ItemCode = rm.PartItemCode,
                ItemName = rm.PartItemName,
                MeasureUnit = rm.UOM,
                ItemSpecification = rm.PartSpecification,
                Category = rm.CategoryName,

                Qty = qtyCalc,
                BalQty = qtyCalc,
                DCQty = qtyCalc,
                ProdCompBalQty = qtyCalc,

                UnitPrice = prices.ContainsKey(rm.ItemId.Value) ? prices[rm.ItemId.Value] : 0,

                CostId = parentVm.CostId,
                ProjectNo = parentVm.ProjectNo,
                IsEditable = true
            });
        }
    }

    private async Task AddRawMaterialChildAsync(LabourGRNSubVM parentVm, int? itemId)
    {
        var rmItem = await _grnService.GetRawMaterialItemAsync(itemId ?? 0);

        if (rmItem == null) return;

        var prices = await _grnService.GetBulkLastUnitPricesAsync(new List<int> { rmItem.ItemId }, LabourGRNVMs.CustId);

        var qtyCalc = Math.Round(parentVm.Qty.GetValueOrDefault() * rmItem.Weight, 3);

        LabourGRNVMs.LabourGRNSubVMs.Add(new LabourGRNSubVM
        {
            SelectedItemOut = rmItem,

            TransType = "In",
            ItemId = rmItem.ItemId,
            ItemCode = rmItem.ItemCode,
            ItemName = rmItem.ItemName,
            MeasureUnit = rmItem.MeasureUnit,
            ItemSpecification = rmItem.Specification,
            Category = rmItem.CategoryName,

            Qty = qtyCalc,
            BalQty = qtyCalc,
            DCQty = qtyCalc,
            ProdCompBalQty = qtyCalc,

            UnitPrice = prices.ContainsKey(rmItem.ItemId) ? prices[rmItem.ItemId] : 0,

            CostId = parentVm.CostId,
            ProjectNo = parentVm.ProjectNo,
            IsEditable = true
        });
    }

    #endregion

    private decimal CalculateLandedStockPrice(decimal qty, decimal totalQty, decimal itemBasicWithoutDisc,decimal subDiscPercent, 
        decimal subDiscAmt, decimal mainDiscPercent, decimal mainDiscAmt,decimal packingPercent,
        decimal packingAmt, decimal insurancePercent, decimal insuranceAmt, decimal freightAmt, decimal totalBasicAmt, decimal todayVal)
    {
        if (qty <= 0) return 0;

        decimal itemBasic = itemBasicWithoutDisc;

        if (subDiscAmt > 0)
            itemBasic -= subDiscAmt;
        else if (subDiscPercent > 0)
            itemBasic -= (itemBasicWithoutDisc * subDiscPercent / 100);

        if (subDiscAmt == 0 && subDiscPercent == 0)
        {
            if (mainDiscAmt > 0 && totalBasicAmt > 0)
            {
                decimal proportion = itemBasicWithoutDisc / totalBasicAmt;
                itemBasic -= proportion * mainDiscAmt;
            }
            else if (mainDiscPercent > 0)
            {
                itemBasic -= (itemBasicWithoutDisc * mainDiscPercent / 100);
            }
        }

        if (packingAmt > 0 && totalBasicAmt > 0)
            itemBasic += (itemBasicWithoutDisc / totalBasicAmt) * packingAmt;
        else if (packingPercent > 0)
            itemBasic += (itemBasicWithoutDisc * packingPercent / 100);

        if (insuranceAmt > 0 && totalBasicAmt > 0)
            itemBasic += (itemBasicWithoutDisc / totalBasicAmt) * insuranceAmt;
        else if (insurancePercent > 0)
            itemBasic += (itemBasicWithoutDisc * insurancePercent / 100);

        if (freightAmt > 0 && totalQty > 0)
            itemBasic += (qty / totalQty) * freightAmt;

        decimal unitPrice = itemBasic / qty;

        if (todayVal > 1)
            unitPrice *= todayVal;

        return unitPrice = Math.Round(unitPrice, 3, MidpointRounding.AwayFromZero);
    }

