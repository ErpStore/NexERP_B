    private async Task UpsertGRN()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            LabourGRNVMs.LabourGRNSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!LabourGRNVMs.LabourGRNSubVMs.Any())
            {
                await _JS.ToastrWarning("Cannot save a Labour GRN without valid items.");
                return;
            }
            bool hasIn = LabourGRNVMs.LabourGRNSubVMs
                .Any(x => x.TransType?.Equals("Out", StringComparison.OrdinalIgnoreCase) == true);

            bool hasOut = LabourGRNVMs.LabourGRNSubVMs
                .Any(x => x.TransType?.Equals("In", StringComparison.OrdinalIgnoreCase) == true);

            if (!hasIn || !hasOut)
            {
                await _JS.ToastrError("At least one IN item and one OUT item are required.");
                return;
            }

            // Validate Group-wise IN and OUT
            var invalidGroups = LabourGRNVMs.LabourGRNSubVMs
                .GroupBy(x => x.GroupId)
                .Where(g =>
                    !g.Any(x => x.TransType?.Equals("Out", StringComparison.OrdinalIgnoreCase) == true) ||
                    !g.Any(x => x.TransType?.Equals("In", StringComparison.OrdinalIgnoreCase) == true))
                .Select(g => g.Key)
                .ToList();

            if (invalidGroups.Any())
            {
                await _JS.ToastrError($"Group {string.Join(", ", invalidGroups)} must contain at least one OUT item and one IN item.");
                return;
            }


            if (LabourGRNVMs.AddStoreId == 0)
            {
                await _JS.ToastrError("Store selection is required.");
                return;
            }

            if (string.IsNullOrWhiteSpace(LabourGRNVMs.RefDcNo))
            {
                await _JS.ToastrWarning($"Please enter the DC number");
                return;
            }


            // Validate each line
            foreach (var line in LabourGRNVMs.LabourGRNSubVMs)
            {
                bool isValid = await ValidateRowAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewDc = LabourGRNVMs.GRNId == 0;
            if (isNewDc)
            {
                if (await _grnService.IsDuplicateDcNoAsync(LabourGRNVMs.CustId, LabourGRNVMs.RefDcNo, LabourGRNVMs.Suffix))
                {
                    await _JS.ToastrWarning($"The same Customer {LabourGRNVMs.CustName} and DC No {LabourGRNVMs.RefDcNo} already exist. Please enter a different DC No.");
                    return;
                }
            }
            try
            {
                await _grnService.UpsertGRNAsync(LabourGRNVMs, screenCode);

            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewDc)
                await _JS.ToastrSuccess("Labour GRN saved successfully.");
            else
                await _JS.ToastrSuccess("Labour GRN updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigation.NavigateTo("/labourGRNList");
        }

        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertGRN failed.");
            await _JS.ToastrError("Error saving  Labour GRN.");
        }
        finally
        {
            isProcessing = false;
        }
    }

