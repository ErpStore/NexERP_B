    private decimal GetDecimal(Dictionary<string, object> item, string key)
    {
        return item.TryGetValue(key, out var val) && decimal.TryParse(val?.ToString(), out var parsed)
            ? parsed
            : 0;
    }

    private int? GetInt(Dictionary<string, object> item, string key)
    {
        return item.TryGetValue(key, out var val) && int.TryParse(val?.ToString(), out var parsed)
            ? parsed
            : (int?)null;
    }

    private string GetString(Dictionary<string, object> item, string key)
    {
        return item.TryGetValue(key, out var val)
            ? val?.ToString() ?? string.Empty
            : string.Empty;
    }

    private DateTime? GetDate(Dictionary<string, object> item, string key)
    {
        return item.TryGetValue(key, out var val) && DateTime.TryParse(val?.ToString(), out var parsed)
            ? parsed
            : (DateTime?)null;
    }

