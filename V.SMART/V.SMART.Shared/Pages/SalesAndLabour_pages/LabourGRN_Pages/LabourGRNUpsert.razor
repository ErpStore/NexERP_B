    private async Task AskToShortCloseAsync(LabourGRNVM LabourGRNVMs)
    {
        try
        {
            if (LabourGRNVMs == null)
            {
                await _JS.ToastrError("Invalid Labour GRN  selected.");
                return;
            }

            if (!GRNId.HasValue || GRNId == 0)
            {
                await _JS.ToastrError("Labour GRN Short Close is not allowed before saving the Labour GRN.");
                return;
            }

            if (LabourGRNVMs.DcTally)
            {
                await _JS.ToastrWarning("This Labour GRN is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (LabourGRNVMs.DcCancel)
            {
                await _JS.ToastrWarning("This Labour GRN is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!LabourGRNVMs.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Labour GRN?";
                btnText = "Short Close";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Labour GRN?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while AskToShortCloseAsync Labour GRN.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

