    private async Task Cancel()
    {
        try
        {
            if (!GRNId.HasValue || GRNId == 0)
            {
                await _JS.ToastrError("Labour GRN cancel is not allowed before saving the Labbor GRN.");
                return;
            }
            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrWarning("Some Items Transaction Are Made!.. You Can't Cancel the Complete Labour GRN");
                return;
            }

            if (LabourGRNVMs.ShortClose)
            {
                await _JS.ToastrError("Quotation is already short closed. You can't cancel it.");
                return;
            }
            // If ANY item is already cancelled → stop GRN cancel
            if (LabourGRNVMs.LabourGRNSubVMs.Any(s => s.ItemCancel))
            {
                await _JS.ToastrWarning("GRN cannot be cancelled — one or more items are already cancelled.");
                return;
            }

            if(LabourGRNVMs.DcCancel)
            {

                var subs = await _grnService.GetlabourGRNSubDetailsByDcIdAsync(LabourGRNVMs.GRNId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    if(sub.TransType =="Out")
                    {
                        await _grnService.ValidatePoBalanceBeforeRevertAsync(sub);
                    }
                }
            }

            if (!LabourGRNVMs.DcCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this GRN?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this GRN?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            LabourGRNVMs= await _grnService.GetLabourGRNByIdAsync(GRNId.Value);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Labour GRN.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Labour GRN  Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnItemCancelChanged(LabourGRNSubVM subitem)
    {
        try
        {
            if (subitem.GRNSubId == 0)
            {
                await _JS.ToastrError("Labour GRN cancel is not allowed before saving.");
                return;
            }
            if (subitem.Qty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _JS.ToastrWarning("Item cannot be cancelled/Revert — some transactions have been made on it.");
                return;
            }
            if (LabourGRNVMs.DcCancel)
            {
                await _JS.ToastrWarning("Item cannot be cancelled — GRN is already cancelled.");
                return;
            }

            var (CanItemCancel, message) = await _grnService.CanLabourGRNItemCancelCheckAsync(subitem);

            if (!CanItemCancel)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _JS.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _JS.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingGRN(GRNId.Value);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling Item in Labour GRN");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in PO Purchase");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {

        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;
                case "Cancel":
                case "Revert":
                    await CancelGRN();
                    break;
                case "ItemCancel":
                    await CancelItem(rowToCancel);
                    break;
                case "ShortClose":
                    await ShortCloseLabourGRN();
                    break;
                default:
                    await _JS.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action in LabourGRNUpsert: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action in LabourGRNUpsert. Please try again.");
        }


    }

