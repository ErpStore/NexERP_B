@page "/labourDcoutgoingList"

@using System.Text.Json
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.LabourDc_VM

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ILabourDcOutgoingService _dcService

@inject ExcelExportService ExcelExportService



<style>
    .pagination-fixed {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1030; /* keeps above table */
    }

    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">

    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch isModelVisible="true"
                       Screen="@ScreenName"
                       Filters="SearchFilters"
                       OnClose="CloseModal"
                       OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="@(confirmation != "Export" ? "btn-danger" : btnColor)"
         ButtonText="@(confirmation != "Export" ? "Delete" : btnText)"
         Title="@(confirmation != "Export"
                               ? "Are you sure you want to delete this Labour Dc Outgoing?"
                               : ModalTitle)">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <PageHeader TitleText="LabourDc Outgoing List"
                        TitleIcon="bi bi-list-check"
                        Breadcrumbs="@LabourDcBreadcrumbs" />

            <div class="card-body p-4">

                <div class="row g-2 g-md-3 mb-3">

                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="LabourDcList"
                                    UserId="@UserName"
                                    MaxVisible="int.MaxValue"
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>


                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm" value="@pageSize"
                                @onchange="OnPageSizeChanged"
                                title="Select number of records per page">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select status of records">
                            <option value="">-- Select Status --</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Short Closed">Short Closed</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                        <div class="col-12 col-lg-2 ms-md-auto text-end">
                            <button type="button" class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewDc">
                                <i class="bi bi-plus-square me-1"></i> Add New Dc
                            </button>
                        </div>
                    }

                </div>

                @if (LabourDcOutgoingVMs.Any())
                {
                    <div class="table-responsive">
                        <QuickGrid Items="@LabourDcOutgoingVMs.AsQueryable()"
                                  
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
                            {

                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            // 🔹 Main
                                            case "DcId":
                                                <PropertyColumn Title="Dc ID" Property="@(c => c.DcId)" />
                                                break;

                                            case "Prefix":
                                                <PropertyColumn Title="Prefix" Property="@(c => c.Prefix)" />
                                                break;

                                            case "DcNo":
                                                <PropertyColumn Title="Dc No." Property="@(c => $"{c.DcNo}{c.Suffix}")" Sortable="true" />
                                                break;

                                            case "DcDate":
                                                <PropertyColumn Title="Dc Date" Property="@(c => c.DcDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "NoOfItems":
                                                <PropertyColumn Title="No Of Items" Property="@(c => c.NoOfItems)" />
                                                break;

                                            case "Remarks":
                                                <PropertyColumn Title="Remarks" Property="@(c => c.Remarks)" />
                                                break;

                                            case "Manual":
                                                <TemplateColumn Title="Manual DC" Context="c">
                                                    @(c.Manual ? "Yes" : "No")
                                                </TemplateColumn>
                                                break;

                                            case "NonReturnDc":
                                                <TemplateColumn Title="Non Return DC" Context="c">
                                                    @(c.NonReturnDc ? "Yes" : "No")
                                                </TemplateColumn>
                                                break;


                                            // 🔹 Customer
                                            case "CustId":
                                                <PropertyColumn Title="Customer ID" Property="@(c => c.CustId)" />
                                                break;

                                            case "CustName":
                                                <PropertyColumn Title="Customer Name" Property="@(c => c.CustName)" Sortable="true" />
                                                break;

                                            case "CustAddress":
                                                <PropertyColumn Title="Customer Address" Property="@(c => c.CustAddress)" />
                                                break;

                                            case "CustGstNo":
                                                <PropertyColumn Title="Customer GST No" Property="@(c => c.CustGstNo)" />
                                                break;

                                            case "ContactNo":
                                                <PropertyColumn Title="Contact No" Property="@(c => c.ContactNo)" />
                                                break;

                                            case "KindofAttention":
                                                <PropertyColumn Title="Kind of Attention" Property="@(c => c.KindofAttention)" />
                                                break;


                                            // 🔹 Shipping
                                            case "IsSameAsShipping":
                                                <TemplateColumn Title="Same As Shipping" Context="c">
                                                    @(c.IsSameAsShipping ? "Yes" : "No")
                                                </TemplateColumn>
                                                break;

                                            case "ShippingId":
                                                <PropertyColumn Title="Shipping ID" Property="@(c => c.ShippingId)" />
                                                break;

                                            case "ShippingName":
                                                <PropertyColumn Title="Shipping Name" Property="@(c => c.ShippingName)" />
                                                break;

                                            case "ShippingAddress":
                                                <PropertyColumn Title="Shipping Address" Property="@(c => c.ShippingAddress)" />
                                                break;

                                            case "ShippingGstNo":
                                                <PropertyColumn Title="Shipping GST" Property="@(c => c.ShippingGstNo)" />
                                                break;

                                            case "ShippingPhone":
                                                <PropertyColumn Title="Shipping Phone" Property="@(c => c.ShippingPhone)" />
                                                break;


                                            // 🔹 Store
                                            case "StoreIssId":
                                                <PropertyColumn Title="Issue Store ID" Property="@(c => c.StoreIssId)" />
                                                break;

                                            case "StoreName":
                                                <PropertyColumn Title="Store Name" Property="@(c => c.StoreName)" />
                                                break;


                                            // 🔹 Transport
                                            case "TransportMode":
                                                <PropertyColumn Title="Transport Mode" Property="@(c => c.TransportMode)" />
                                                break;

                                            case "VehicleNo":
                                                <PropertyColumn Title="Vehicle No" Property="@(c => c.VehicleNo)" />
                                                break;

                                            case "TransFrom":
                                                <PropertyColumn Title="Transport From" Property="@(c => c.TransFrom)" />
                                                break;

                                            case "TransTo":
                                                <PropertyColumn Title="Transport To" Property="@(c => c.TransTo)" />
                                                break;

                                            case "TransId":
                                                <PropertyColumn Title="Transport Id" Property="@(c => c.TransId)" />
                                                break;

                                            case "TransDocNo":
                                                <PropertyColumn Title="Transport Doc No" Property="@(c => c.TransDocNo)" />
                                                break;

                                            case "TransName":
                                                <PropertyColumn Title="Transport Name" Property="@(c => c.TransName)" />
                                                break;


                                            // 🔹 EWay
                                            case "SubSupplyType":
                                                <PropertyColumn Title="Sub Supply Type" Property="@(c => c.SubSupplyType)" />
                                                break;

                                            case "SubSupplyDesc":
                                                <PropertyColumn Title="Sub Supply Desc" Property="@(c => c.SubSupplyDesc)" />
                                                break;

                                            case "EwayNo":
                                                <PropertyColumn Title="E-Way Bill No" Property="@(c => c.EwayNo)" />
                                                break;

                                            case "EwayDate":
                                                <PropertyColumn Title="E-Way Bill Date" Property="@(c => c.EwayDate)" Format="dd/MM/yyyy" />
                                                break;
                                            //Sathish
                                            case "CorrespondenceStatus":
                                                <TemplateColumn Title="Correspondence Status">
                                                    @if (UploadStatus.ContainsKey(context.DcId)
                                                                                && UploadStatus[context.DcId])
                                                    {
                                                        <span class="badge bg-success">Uploaded</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Not Uploaded</span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            // 🔹 Status
                                            case "Status":
                                                <TemplateColumn Title="DC Status" Context="c">
                                                    @if (c.DcCancel)
                                                    {
                                                        <span class="badge bg-danger">Cancelled</span>
                                                    }
                                                    else if (c.ShortClose)
                                                    {
                                                        <span class="badge bg-secondary">Short Closed</span>
                                                    }
                                                    else if (c.DcTally || c.ReceivedReturnRM)
                                                    {
                                                        <span class="badge bg-success">Completed</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    }
                                                </TemplateColumn>
                                                break;


                                            // 🔹 Audit
                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date" Property="@(c => c.ModifiedDate)" Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }
                            }

                            <!-- Actions -->
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"labourDcOutgoing/update/{c.DcId}?currentPage={currentPage}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Dc">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"labourDcOutgoing/details/{c.DcId}?currentPage={currentPage}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View DC">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete DC"
                                                @onclick="() => HandleDelete(c)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>

                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="container-fluid">

                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="fw-semibold small px-1">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                                <button class="btn btn-success btn-sm d-flex align-items-center ms-5" @onclick="HandleExport">

                                    <i class="bi bi-download me-1"></i>
                                    Export Dc's

                                </button>

                            </div>

                        </div>

                    </div>

                }
                else
                {
                    <p class="text-center">No Labour Dc Outgoing found.</p>
                }

            </div>
        </div>
    </div>
}


@code
{
    protected override string ScreenName => "Labour Delivery Challan";

    private bool isProcessing = false;
    private string? UserName;
    private int DeleteDcID = 0;
    private string selectedStatus = string.Empty;
    private PaginationState pagination = new() { ItemsPerPage = 10 };
    public List<GridColumn> Columns { get; set; }

    private int screenCode { get; set; }

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private int totalItems;
   // private int currentPage = 1;
    private int pageSize = 10;
    private string searchTerm;
    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    private List<LabourDcOutgoingVM> LabourDcOutgoingVMs = new();

    [SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";
    private bool IsPoWiseLabDcOut { get; set; } = false;


    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = "";
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    //Sathish
    private Dictionary<int, bool> UploadStatus = new();

    private void AddNewLabourDc()
    {
        _navigation.NavigateTo("/Customer/Select?ReturnUrl=/labourDcoutgoingList/create/{id}");
    }

    private List<PageHeader.BreadcrumbItem> LabourDcBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Labour" },
        new PageHeader.BreadcrumbItem { Text = "Delivery challan", IsLast = true }
    };


    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await InitializeColumns(IsHidden);
            UserName = await CurrentUserService.GetUsernameAsync();
            IsPoWiseLabDcOut = await _dcService.IsPOWiseLabDcOutEnabledAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }
            //Sathish
            if (currentPage < 1)
            {
                currentPage = 1;
            }
            await LoadAllLabourDcDetailsAsync();
            screenCode = await _dcService.GetScreenCodeByScreenNameAsync(ScreenName);


            var saved = await PreferenceService.LoadPreferencesAsync("LabourDcList", UserName);
            if (saved?.Any() == true)
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(s => s.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }

            isProcessing = false;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the LabourDcList OnInitializedAsync() method");

        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {

            Columns = new List<GridColumn>
            {
                new() { Title = "Dc ID", Field = "DcId", IsVisible = false },
                new() { Title = "Prefix", Field = "Prefix", IsVisible = false },
                new() { Title = "Dc No.", Field = "DcNo", IsVisible = true },
                new() { Title = "Dc Date", Field = "DcDate", IsVisible = true },

                new() { Title = "No of Items", Field = "NoOfItems", IsVisible = false },
                new() { Title = "Remarks", Field = "Remarks", IsVisible = false },

                new() { Title = "Manual", Field = "Manual", IsVisible = false },

                new() { Title = "Non Return DC", Field = "NonReturnDc", IsVisible = false },

                // Customer
                new() { Title = "Customer ID", Field = "CustId", IsVisible = false },
                new() { Title = "Customer Name", Field = "CustName", IsVisible = true },
                new() { Title = "Customer Address", Field = "CustAddress", IsVisible = false },
                new() { Title = "Customer GST No", Field = "CustGstNo", IsVisible = false },
                new() { Title = "Customer Contact No", Field = "ContactNo", IsVisible = false },
                new() { Title = "Kind of Attention", Field = "KindofAttention", IsVisible = false },

                // Shipping
                new() { Title = "Same As Shipping", Field = "IsSameAsShipping", IsVisible = false },
                new() { Title = "Shipping ID", Field = "ShippingId", IsVisible = false },
                new() { Title = "Shipping Name", Field = "ShippingName", IsVisible = false },
                new() { Title = "Shipping Address", Field = "ShippingAddress", IsVisible = false },
                new() { Title = "Shipping GST", Field = "ShippingGstNo", IsVisible = false },
                new() { Title = "Shipping Phone", Field = "ShippingPhone", IsVisible = false },

                // Store
                new() { Title = "Issue Store ID", Field = "StoreIssId", IsVisible = false },
                new() { Title = "Store Name", Field = "StoreName", IsVisible = true },
                 //Sathish
                new() { Title = "Correspondence Status", Field = "CorrespondenceStatus", IsVisible = false },
                // Transport
                new() { Title = "Transport Mode", Field = "TransportMode", IsVisible = false },
                new() { Title = "Vehicle No", Field = "VehicleNo", IsVisible = false },
                new() { Title = "Transport From", Field = "TransFrom", IsVisible = false },
                new() { Title = "Transport To", Field = "TransTo", IsVisible = false },
                new() { Title = "Transport Id", Field = "TransId", IsVisible = false },
                new() { Title = "Transport Doc No", Field = "TransDocNo", IsVisible = false },
                new() { Title = "Transport Name", Field = "TransName", IsVisible = false },

                // EWay
                new() { Title = "Sub Supply Type", Field = "SubSupplyType", IsVisible = false },
                new() { Title = "Sub Supply Desc", Field = "SubSupplyDesc", IsVisible = false },

                new() { Title = "E-Way Bill No", Field = "EwayNo", IsVisible = false },
                new() { Title = "E-Way Bill Date", Field = "EwayDate", IsVisible = false },

                // Status
                new() { Title = "DC Status", Field = "Status", IsVisible = true },


                // Audit
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };

            if (!Hidden)
            {

            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the LabourGRNList InitializeColumns() method");
            await _JS.ToastrError("An error occurred while handling the LabourGRNList InitializeColumns() method");
        }
    }

    private async Task LoadAllLabourDcDetailsAsync()
    {
        isProcessing = true;
        try
        {
            var result = await _dcService.SearchWithDynamicFilterAsync(pageNumber: currentPage, pageSize: pageSize, filters: SearchFilters);
            LabourDcOutgoingVMs = result.Grns;
            this.totalItems = result.TotalCount;

            foreach (var item in LabourDcOutgoingVMs)
            {
                UploadStatus[item.DcId] = await _dcService.IsDocumentUploaded(item.DcId);
            }


        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadAllLabourDcDetailsAsync in LabourDcList");
            await _JS.ToastrError("Failed to load LoadAllLabourDcDetailsAsync data in LabourDcList");

        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated ?? new List<GridColumn>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "HandleColumnChange in LabourDcList");
            await _JS.ToastrError("Failed to update column preferences in LabourDcList .");
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllLabourDcDetailsAsync();
   
            await InvokeAsync(StateHasChanged);
        
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnPageSizeChanged in LabourDcList");
            await _JS.ToastrError("Failed to update page size in LabourDcList.");
        }
    }

    private void AddNewDc()
    {
        var returnUrl = Uri.EscapeDataString("labourDcOutgoing/create/{id}");
        _navigation.NavigateTo($"/Customer/Select?ReturnUrl={returnUrl}");
    }

    private async Task HandleDelete(LabourDcOutgoingVM dc)
    {
        try
        {
            var totalQty = dc.LabourDcOutgoingSubVMs
               .Where(s => s.TransType == "Out")   // or enum
               .Sum(s => s.Qty);

            var totalBalQty = dc.LabourDcOutgoingSubVMs
                .Where(s => s.TransType == "Out")
                .Sum(s => s.BalQty);

            if ((totalQty != totalBalQty) || dc.DcTally)
            {
                await _JS.ToastrError("Oops! You can't delete this DC because some items have already been processed.");
                return;

            }
            bool hasAnyItemOrGRNCancel = await _dcService.HasAnyItemOrLabourDcCancelAsync(dc.DcId);
            if (hasAnyItemOrGRNCancel)
            {
                await _JS.ToastrWarning("Cannot delete this Labour Dc as it or one of its items has been cancelled.");
                return;
            }

            if (!string.IsNullOrEmpty(dc.EwayNo))
            {
                await _JS.ToastrWarning("This Dc cannot be delete because Eway transactions are done.");
                return;
            }

            var (canDelete, message) = await _dcService.CanDeleteLabourDcOutgoingAsync(dc.DcId, screenCode, dc.DcNo);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteDcID = dc.DcId;
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error while HandleDelete in LabourDcoutgooing List");
            await _JS.ToastrError("Failed to  HandleDelete data.");
        }
    }

    private async Task confirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (isConfirmed && DeleteDcID > 0 && confirmation=="")
            {

                isProcessing = true;
                bool success = false;
                if (IsPoWiseLabDcOut)
                {
                    success = await _dcService.DeleteLabourDcPoWiseByIdAsync(DeleteDcID, screenCode);
                }
                else
                {
                    success = await _dcService.DeleteLabourDcByIdAsync(DeleteDcID, screenCode);
                }

                //bool success = await _dcService.DeleteLabourDcByIdAsync(DeleteDcID, screenCode);
                if (success)
                {
                    await _JS.ToastrSuccess("DC Deleted successfully.");
                    await LoadAllLabourDcDetailsAsync();
                }
                else
                {
                    await _JS.ToastrWarning("Dc Delete failed.");


                }
                isProcessing = false;
                DeleteDcID = 0;
            }
            else if (isConfirmed && confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
                confirmation = "";
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the LabourDcList confirmDelete_Click() method");
            await _JS.ToastrError("An error occurred while handling the LabourDcList confirmDelete_Click() method");
        }
    }


    private async Task FirstPage()
    {
        if (currentPage != 1)
        {
            currentPage = 1;
            await LoadAllLabourDcDetailsAsync();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadAllLabourDcDetailsAsync();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadAllLabourDcDetailsAsync();
        }
    }

    private async Task LastPage()
    {
        if (currentPage != totalPages)
        {
            currentPage = totalPages;
            await LoadAllLabourDcDetailsAsync();
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllLabourDcDetailsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing LabourDcOutgoingList  page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type} in LabourDcOutgoingList");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal} in LabourDcOutgoingList");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }


    #region SEARCH FILTERS
    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllLabourDcDetailsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in  LabourDcOutgoingList");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }
    #endregion
    #region Search order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? "";


        if (string.IsNullOrWhiteSpace(selectedStatus))
            SearchFilters.Remove("Status");
        else
            SearchFilters["Status"] = selectedStatus;


        currentPage = 1;
        await LoadAllLabourDcDetailsAsync();
    }

    #endregion

    private async Task HandleExport()
    {
        selectedStatus = selectedStatus == "" ? "All" : selectedStatus;

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var exportData = await _dcService.GetLabourDcStatusListAsync(selectedStatus);

            if (exportData == null || !exportData.Any())
                return;

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "LabourDc", "Labour Dc's Status List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "LabourDCExport.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (Dc's)");
            await _JS.ToastrError("Error while exporting Labour Dc!");
        }
        finally
        {
            isProcessing = false;
        }
    }

}
