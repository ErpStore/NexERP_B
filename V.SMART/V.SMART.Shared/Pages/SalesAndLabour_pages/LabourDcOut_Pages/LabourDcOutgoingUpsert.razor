                                                           class="form-control form-control-sm"
                                                           style="flex:1;"
                                                           placeholder="@(LabourDcOutgoingVMs.WithoutPoDc ? "Search Ref Dc No." : "Search PO No.")"
                                                           @bind="SearchTextPo"
                                                           @bind:event="oninput" />

                                                    <!-- Select All -->
                                                    <div class="form-check m-0">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@IsAllPoSelected"
                                                               @onchange="ToggleAllPO" />
                                                        <label class="form-check-label small fw-semibold">
                                                            All
                                                        </label>
                                                    </div>

                                                </div>
                                              @* <input type="text"
                                                     class="form-control form-control-sm mb-1"
                                                     placeholder="@(LabourDcOutgoingVMs.WithoutPoDc ? "Search Ref Dc No." : "Search PO No.")"
                                                     @bind="SearchTextPo"
                                                     @bind:event="oninput" /> *@

                                              <div class="border rounded-3 p-2 po-scroll" style="height: 90px; overflow-y: auto;">
                                                  @if (LabourDcOutgoingVMs.WithoutPoDc)
                                                  {
                                                      @foreach (var dc in FilteredDc)
                                                      {
                                                          <div class="form-check border-bottom py-1 @(dc.IsSelected ? "bg-light" : "")"
                                                               @key="dc.GRNId">
                                                              <input type="checkbox"
                                                                     class="form-check-input"
                                                                     id="po_@dc.GRNId"
                                                                     checked="@dc.IsSelected"
                                                                     @onchange="e => OnDCCheckedChanged(dc, (bool)e.Value)" />
                                                              <label class="form-check-label ms-1 small fw-semibold"
                                                                     for="po_@dc.GRNId">@dc.RefDcNo
                                                              </label>
                                                          </div>
                                                      }

                                                  }
                                                  else
                                                  {
                                                      @if (scnPendingCount>0)
                                                      {
                                                          @foreach (var po in FilteredPos)
                                                          {
                                                              <div class="form-check border-bottom py-1 @(po.IsSelected ? "bg-light" : "")"
                                                                   @key="po.PoId">
                                                                  <input type="checkbox"
                                                                         class="form-check-input"
                                                                         id="po_@po.PoId"
                                                                         checked="@po.IsSelected"
                                                                         @onchange="e => OnPoCheckedChanged(po, (bool)e.Value)" />
                                                                  <label class="form-check-label ms-1 small fw-semibold"
                                                                         for="po_@po.PoId">@po.PONo
                                                                  </label>
                                                              </div>
                                                      }
                                                  }
                                                  else
                                                  {
                                                       <div class="text-muted small text-center py-3">
                                                          No Pos available
                                                      </div>
                                                  }

                                              }
                 
                                              </div>
                                          </div>

                                          <!-- RIGHT : SCN LIST -->
                                          <div class="col-6">

                                               <div class="d-flex align-items-center gap-2 mb-1">

                                                   <!-- Search -->
                                                   <input type="text"
                                                          class="form-control form-control-sm"
                                                          style="flex:1;"
                                                          placeholder="Search SCN No..."
                                                          @bind="SearchTextSCN"
                                                          @bind:event="oninput" />

                                                   <!-- Select All -->
                                                   <div class="form-check m-0">
                                                       <input class="form-check-input"
                                                              type="checkbox"
                                                              checked="@IsAllScnSelected"
                                                              @onchange="ToggleAllSCN" />
                                                       <label class="form-check-label small fw-semibold ms-1">
                                                           All
                                                       </label>
                                                   </div>

                                               </div>
                                               @* <input type="text"
                                                     class="form-control form-control-sm mb-1"
                                                     placeholder="Search SCN No..."
                                                     @bind="SearchTextSCN"
                                                     @bind:event="oninput" /> *@

                                              <div class="border rounded-3 p-2 po-scroll" style="height: 90px; overflow-y: auto;">
                                                  @if (scns.Count > 0)
                                                  {
                                                      @foreach (var scn in FilteredSCNs)
                                                      {
                                                          <div class="form-check border-bottom py-1 @(scn.IsSelected ? "bg-light" : "")"
                                                               @key="scn.SCNId">
                                                              <input type="checkbox"
                                                                     class="form-check-input"
                                                                     id="scn_@scn.SCNId"
                                                                     @bind="scn.IsSelected" />
                                                              <label class="form-check-label ms-1 small fw-semibold"
                                                                     for="scn_@scn.SCNId"> @scn.SCNNo
                                                              </label>
                                                          </div>
                                                      }
                                                  }
                                                  else
                                                  {
                                                      <div class="text-muted small text-center py-3">
                                                          No SCNs available
                                                      </div>
                                                  }
                                              </div>

                                             <div class="text-end mt-2">
                                                  <button type="button"
                                                          class="btn btn-sm btn-primary"
                                                          disabled="@(!scns.Any(p => p.IsSelected))"
                                                          @onclick="Loadpos">
                                                      @(!LabourDcOutgoingVMs.WithoutPoDc ? "Load POs" : "Load GRN")
                                                  </button>
                                              </div>
                                          </div>

                                      </div>

                                  }
                                  else
                                  {         
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Reference.</small>
                                        </label>

                                        <div class="col-12 col-sm-9 position-relative">
                                            <button type="button"
                                                    class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                    @onclick="ShowCustomerDcDetails">
                                                <i class="bi bi-list-ul me-1"></i> Customer DC Details
                                            </button>
                                        </div>
                                    </div>

                                    }
                                    <!-- Issue From Store -->
                                    <div class="mb-2 row mt-1">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issue From Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select value="@LabourDcOutgoingVMs.StoreIssId"
                                                    @onchange="OnStoreChanged"
                                                    class="form-select form-select-sm rounded-3 w-100">
                                                <option value="0" selected>--Select Store--</option>

                                                @if (stores != null)
                                                {
                                                    foreach (var store in stores)
                                                    {
                                                        <option value="@store.StoreId">@store.StoreName</option>
                                                    }
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.StoreIssId)" />
                                        </div>
                                    </div>

                                    <!-- Sub Supply Type -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Sub Supply Type</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select @bind="LabourDcOutgoingVMs.SubSupplyType"
                                                    class="form-select form-select-sm rounded-3 w-100">
                                                <option value="0">--Select SupplyType--</option>
                                                <option value="1">Supply</option>
                                                 <option value="4">JobWork</option>
                                                <option value="5">ForOwnUse</option>
                                                <option value="8">Others</option>
                                            </select>
                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.SubSupplyType)" />
                                        </div>
                                    </div>

                                     <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="LabourDcOutgoingVMs.Remarks"></textarea>
                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.Remarks)" />
                                        </div>

                                    </div>
                                    @if(LabourDcOutgoingVMs.ReceivedReturnRM)
                                    {
                                         <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small></small>
                                            </label>

                                            <div class="col-12 col-sm-9">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           id="RejectReworkQty"
                                                           @bind="LabourDcOutgoingVMs.SCNRejectReworkReturn" />

                                                    <label class="form-check-label small fw-semibold"
                                                           for="RejectReworkQty">
                                                        SCN Reject / Rework Qty Return
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    }


                                      @if(LabourDcOutgoingVMs.DcCancel)
                                     {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="LabourDcOutgoingVMs.CancelReason"
                                                            readonly></textarea>
                                                <ValidationMessage For="@(() => LabourDcOutgoingVMs.CancelReason)" />
                                            </div>
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Date</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="date" class="form-control form-control-sm rounded-3 w-100"
                                                            @bind="LabourDcOutgoingVMs.CanceledDate"
                                                            readonly />
                                                <ValidationMessage For="@(() => LabourDcOutgoingVMs.CanceledDate)" />
                                            </div>
                                        </div>
                                    }
                                    @if (LabourDcOutgoingVMs.DcId > 0 && !LabourDcOutgoingVMs.ReceivedReturnRM)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Rejection Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                rows="1"
                                                @bind="LabourDcOutgoingVMs.RejectionReason"
                                                readonly></textarea>
                                                <ValidationMessage For="@(() => LabourDcOutgoingVMs.RejectionReason)" />
                                            </div>
                                        </div>


                                         <div class="mb-2 row align-items-center">
                                                <div class="col-12 col-sm-9 offset-sm-3">
                                                    <div class="form-check d-flex align-items-center">
                                                        <input type="checkbox"
                                                        class="form-check-input me-2"
                                                         checked="@LabourDcOutgoingVMs.ReduceInvAsPerRej"
                                                         @onchange="OnReduceInvChanged"
                                                        disabled="@(isTrasactionmade && LabourDcOutgoingVMs.ReduceInvAsPerRej)"/>

                                                        <label class="form-check-label text-danger fw-bold">
                                                            <small>Reduce Invoice Value as per Below Rejections & Rework Qty</small>
                                                        </label>
                                                    </div>
                                                </div>
                                         </div>

                                    }


                                </div>

                            </div>
                         </div>

                         <!------------------Item Details----------------------->
                         <div class="col-12">
                             <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                                 <div class="card-header bg-primary-subtle text-dark">
                                     <div class="d-flex justify-content-between align-items-center flex-wrap">

                                        <!-- Title -->
                                        <span class="fw-bold fs-6">Item Details</span>

                                        <!-- Right Controls -->
                                        <div class="d-flex flex-wrap align-items-center gap-2">

                                            <!-- Add Item Button -->
                                                <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>

                                        </div>
                                    </div>
                                 </div>
                                 <div class="card-body p-2">

                                    <div class="table-responsive" style="overflow-x:auto;">

                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">

                                            <thead class="custom-blue">

                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:90px;">Trans Type</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:70px;">HSN</th>
                                                    <th style="width:120px;">Qty</th>
                                                    @if(LabourDcOutgoingVMs.DcId>0)
                                                    {
                                                        <th style="width:120px;">Dc Bal.Qty</th>
                                                    }
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:120px;">Possible Qty</th>
                                                    <th style="width:120px;">Stock Qty</th>

                                                     @if (LabourDcOutgoingVMs.DcId>0 && !LabourDcOutgoingVMs.ReceivedReturnRM)
                                                     {
                                                         <th style="width:120px;">Reject Qty</th>
                                                         <th style="width:120px;">Rework Qty</th>
                                                         <th style="width:120px;">RejRowRem</th>
                                                     }

                                                    @if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Any(x=>x.RefPoSubId>0))
                                                    {
                                                     
                                                        <th style="width:110px;">Ref PO No.</th>
                                                        <th style="width:110px;">Ref PO Dt.</th>
                                                        <th style="width:110px;">LineNo</th>

                                                        <th style="width:110px;">Ref GRN No.</th>
                                                        <th style="width:110px;">Ref GRN Dt.</th>

                                                        <th style="width:110px;">Ref Dc No.</th>
                                                        <th style="width:110px;">Ref Dc Dt.</th>
                                                    }

                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:150px;">Cost-Center</th>

                                                    @if (!LabourDcOutgoingVMs.DcCancel && !LabourDcOutgoingVMs.ShortClose)
                                                    {
                                                        <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                    }
                                                </tr>

                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in LabourDcOutgoingVMs.LabourDcOutgoingSubVMs)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>
                                                       
                                                        <td style="width:120px;">
                                                            @subitem.TransType
                                                        </td>
                                                    
                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">

                                                                <div class="col-10">
                                                                    @subitem.ItemCode 
                                                                </div>

                                                                @if(subitem.TransType=="Out")
                                                                {
                                                                    <div class="col-2 text-center">
                                                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                                                           Size="Size.Small"
                                                                                           Color="Color.Info"
                                                                                           OnClick="@(async () => await OpenReceivedItems(subitem))"
                                                                                           Edge="Edge.End"
                                                                                           Title="View Item Details" />
                                                                      </div>
                                                                }

                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                        Size="Size.Small"
                                                                                        Color="Color.Primary"
                                                                                        OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId, count))"
                                                                                        Edge="Edge.End"
                                                                                        Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>

                                                            </div>
                                                        </td>
                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.MeasureUnit</td>
                                                        <td>@subitem.HSNCode</td>
                                                         <!-- Qty -->
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                    <input type="number"
                                                                            class="form-control form-control-sm"
                                                                            placeholder="Qty" step="any"
                                                                            title="Enter Quantity"
                                                                            @bind="subitem.Qty"
                                                                            @bind:event="oninput"
                                                                            @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.Qty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.Qty</span>
                                                            }
                                                        </td>
                                                        @if(LabourDcOutgoingVMs.DcId>0)
                                                        {
                                                            <td>@subitem.BalQty</td>
                                                        }
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm" placeholder="Price" step="any" title="Enter Unit Price"
                                                                        @bind="subitem.UnitPrice" readonly="@pricelock"/>
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>
                                                        <td class="text-danger">@subitem.PossibleQty</td>
                                                        <td class="text-danger">@subitem.StockQty</td>
                                                          @if (LabourDcOutgoingVMs.DcId>0 && !LabourDcOutgoingVMs.ReceivedReturnRM)
                                                          {
                                                                <td>

                                                                   @if (subitem.IsEditable)
                                                                   {
                                                                       <input type="number"
                                                                              class="form-control form-control-sm"
                                                                              placeholder="Reject Qty"
                                                                              title="Enter RejectQty"
                                                                              step="any"
                                                                              @bind="subitem.RejectQty"
                                                                              @bind:event="oninput"
                                                                              @onchange="@(e => OnRejQtyChange(subitem.RejectQty, subitem))" disabled="@(subitem.TransType=="In")"/>
                                                                       <ValidationMessage For="@(() => subitem.RejectQty)" />
                                                                   }
                                                                   else
                                                                   {
                                                                       <span>@subitem.RejectQty</span>
                                                                   }
                                                               </td>
                                                                <td>

                                                                   @if (subitem.IsEditable)
                                                                   {
                                                                       <input type="number"
                                                                              class="form-control form-control-sm"
                                                                              placeholder="Rework Qty"
                                                                              title="Enter ReworkQty"
                                                                              step="any"
                                                                              @bind="subitem.ReworkQty"
                                                                              @bind:event="oninput"
                                                                              @onchange="@(e => OnRewQtyChange(subitem.ReworkQty, subitem))"  disabled="@(subitem.TransType=="In")"/>
                                                                       <ValidationMessage For="@(() => subitem.ReworkQty)"  />
                                                                   }
                                                                   else
                                                                   {
                                                                       <span>@subitem.ReworkQty</span>
                                                                   }
                                                               </td>
                                                                 <td>
                                                                   @if (subitem.IsEditable)
                                                                   {
                                                                       <InputTextArea @bind-Value="subitem.RejectRowRem"
                                                                                   class="form-control form-control-sm" 
                                                                                   placeholder="Enter RejRowRem" />
                                                                       <ValidationMessage For="@(() => subitem.RejectRowRem)"  disabled="@(subitem.TransType=="In")"/>
                                                                   }
                                                                   else
                                                                   {
                                                                       @subitem.RejectRowRem
                                                                   }
                                                               </td>
                                                          }

                                                        @if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Any(x=>x.RefPoSubId>0))
                                                        {
                                                            <td>@subitem.RefPoNo</td>
                                                            <td>@subitem.RefPoDate?.ToString("dd/MM/yyyy")</td>
                                                            <td>@subitem.LineNo</td>

                                                            <td>@subitem.RefGRNNo</td>
                                                            <td>@subitem.RefGRNDate?.ToString("dd/MM/yyyy")</td>

                                                            @if(subitem.TransType == "Out")
                                                            {
                                                                <td>@(subitem.RefDcNos != null ? string.Join(", ", subitem.RefDcNos) : "")</td>
                                                                <td>@(subitem.RefDCDates != null ? string.Join(", ", subitem.RefDCDates) : "")</td>
                                                            }
                                                            else
                                                            {
                                                                <td>@subitem.RefDcNo</td>
                                                                <td>@subitem.RefDcDate?.ToString("dd/MM/yyyy")</td>
                                                            }
                                                        }

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                 <InputTextArea @bind-Value="subitem.DcRowRem"
                                                                            class="form-control form-control-sm" 
                                                                            placeholder="Enter Row Remarks" 
                                                                            rows = "1"/>
                                                                <ValidationMessage For="@(() => subitem.DcRowRem)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.DcRowRem
                                                            }
                                                        </td>
                                                        <td>
                                                            @subitem.ProjectNo
                                                        </td>

                                                        <!-- Action Buttons -->
                                                          @if (!LabourDcOutgoingVMs.DcCancel && !LabourDcOutgoingVMs.ShortClose)
                                                        {
                                                            <td class="freeze-last-col text-end">
                                                                @if (!LabourDcOutgoingVMs.DcCancel)
                                                                {
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                        @onclick="async () => await SaveRow(subitem)" disabled="@(subitem.ItemCancel)">
                                                                            <i class="bi bi-check-lg"></i>
                                                                        </button>
                                                                        <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                        @onclick="async () => await CancelEdit(subitem, LabourDcOutgoingVMs)"  disabled="@(subitem.ItemCancel)">
                                                                            <i class="bi bi-x-lg"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit" 
                                                                        @onclick="async () => await EditRowAsync(subitem)"  disabled="@(subitem.ItemCancel)">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>
