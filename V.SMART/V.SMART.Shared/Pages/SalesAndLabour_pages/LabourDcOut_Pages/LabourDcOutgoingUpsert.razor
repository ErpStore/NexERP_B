                {
                    await _JS.ToastrWarning("Please select item");
                    return false;
                }

                if (itemidOut > 0 && LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Count >= 1 && qtyOut <= 0)
                {
                    await _JS.ToastrWarning($"Item {row.ItemCode}: Quantity out must be greater than 0.");
                    return false;
                }

                if (!row.UnitPrice.HasValue || row.UnitPrice <= 0)
                {
                    await _JS.ToastrWarning($"Item {row.ItemCode}: Unit Price must be greater than 0.");
                    return false;
                }
                if (qtyOut > stkqty && row.DcSubId == 0)
                {
                    await _JS.ToastrWarning($"Qty  {row.Qty}:Should not be greater than stock Qty {row.StockQty}.");
                    return false;
                }
                // Reference RC Stock Check
                if ( row.DcSubId == 0)
                {

                    decimal rcstockqty = 0;
                    decimal stockqty = 0;

                    decimal POBalQty = await _dcService.GetLaboourPoBalQtyByPoSubId(row.RefPoSubId ?? 0) ?? 0;

                    if(row.RcSubIds!="" && row.RcSubIds!=null && (row.CategoryCode==2))
                    {
                        var ids = row.RcSubIds.Replace("'", "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                        foreach (var rcid in ids)
                        {
                            int.TryParse(rcid.ToString(), out int rsubid);

                            rcstockqty = rcstockqty +  await _dcService.GetStockForItemRcSubIdAsync(itemidOut, LabourDcOutgoingVMs.StoreIssId.Value, rsubid);
                        }
                        if (qtyOut > rcstockqty)
                        {
                            await _JS.ToastrWarning(
                                 $"Row {row.SlNo} - Qty {row.Qty} should not be greater than Reference RC Balance Qty {rcstockqty}."
                             );
                            return false;
                        }
                    }

                    if((row.RcSubIds=="" || row.RcSubIds==null) || (row.CategoryCode==3 || row.CategoryCode ==7)) 
                    {
                        stockqty= await _dcService.GetStockForItemRcSubIdAsync(row.ItemId, LabourDcOutgoingVMs.StoreIssId.Value,null);

                        if (qtyOut > stockqty)
                        {
                            await _JS.ToastrWarning(
                                 $"Row {row.SlNo} - Qty {row.Qty} should not be greater than Reference RC Balance Qty {rcstockqty}."
                             );
                            return false;
                        }
                    }


                }


            }
            // Qty vs PO / Already Transacted validation
            if (row.DcSubId == 0 && row.RefSCNSubId > 0)
            {
                // var scnBalQty = await _dcService.GetScnItemBalQtyFromSCNSubId(row.RefSCNSubId.Value);

                decimal PossibleQty = row.PossibleQty ?? 0;
                decimal poBalQty,possibleQty = 0;
                if(row.RefPoSubId>0)
                {  poBalQty = row.PoBalQty ?? 0;
                    decimal minVal = Math.Min(stkqty, poBalQty);
                    possibleQty=Math.Min(minVal, PossibleQty);
                }
                else
                {
                    possibleQty = PossibleQty;
                }

                if ((row.Qty > possibleQty))
                {
                    row.Qty = possibleQty;
                    row.BalQty = possibleQty;
                    await _JS.ToastrWarning($"Qty cannot exceed Available Qty ({possibleQty}). " + $"[Stock: {stkqty}");
                    return false;
                }


            }
            else if (row.DcSubId > 0)
            {
                if (row.TransType == "Out")
                {
                    var original = await _dcService.GetSCNSubItemDetailByDcSubIdAsync(row.DcSubId);
                    if (original != null)
                    {
                        decimal origBalQty = original.BalQty;
                        decimal origQty = original.Qty.GetValueOrDefault();
                        var alreadyTransacted = origQty - origBalQty;

                        if (row.Qty < alreadyTransacted)
                        {
                            row.Qty = alreadyTransacted;
                            row.BalQty = 0m;
                            await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                            return false;
                        }
                        else
                        {
                            var difference = row.Qty.GetValueOrDefault() - origQty;
                            row.BalQty = Math.Max(0m, origBalQty + difference);
                        }



                        decimal rcstockqty = 0; 
                        decimal stockqty = 0;
                        decimal POBalQty = await _dcService.GetLaboourPoBalQtyByPoSubId(row.RefPoSubId ?? 0) ?? 0;

                        if(row.RcSubIds!="" && row.RcSubIds!=null && row.CategoryCode==2)
                        {
                            var ids = row.RcSubIds.Replace("'", "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                            foreach (var rcid in ids)
                            {
                                int.TryParse(rcid.ToString(), out int rsubid);

                                rcstockqty = rcstockqty +  await _dcService.GetStockForItemRcSubIdAsync(itemidOut, LabourDcOutgoingVMs.StoreIssId.Value, rsubid);
                            }

                            if (qtyOut > (rcstockqty+origQty))
                            {
                                await _JS.ToastrWarning(
                                    $"Row {row.SlNo} - Qty {row.Qty} should not be greater than Reference RC Balance Qty {rcstockqty}."
                                );
                                return false;
                            }

                        }

                        if((row.RcSubIds=="" || row.RcSubIds==null)|| (row.CategoryCode==3 || row.CategoryCode ==7) )
                        {
                            stockqty= await _dcService.GetStockForItemRcSubIdAsync(row.ItemId, LabourDcOutgoingVMs.StoreIssId.Value,null);

                            if (qtyOut > (stockqty+origQty))
                            {
                                await _JS.ToastrWarning(
                                    $"Row {row.SlNo} - Qty {row.Qty} should not be greater than Reference RC Balance Qty {rcstockqty}."
                                );
                                return false;
                            }

                        }

                        if (await ValidateAndAdjustAsync(row, row.Qty??0, row.RejectQty??0, row.ReworkQty??0, "Rejected",LabourDcOutgoingVMs.ReduceInvAsPerRej))
                            row.RejectQty = row.RejectQty;


                    }
                }
                else
                {

                    var originalSub = await _dcService
                             .GetScnDetailsBySCNSubIdAsync(row.RefSCNSubId ?? 0);

                    if (originalSub == null)
                        return false;

                    var originalQty = originalSub.AcceptQty ?? 0m;
                    var originalBalQty = originalSub.BalQty ?? 0m;


                    if (row.Qty > originalQty)
                    {
                        row.Qty = originalQty;
                        row.BalQty = originalBalQty;

                        await _JS.ToastrWarning(
                            $"Qty cannot be greater than original qty ({originalQty}).");
                        return false; 
                    }

                }
            }

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _JS.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
