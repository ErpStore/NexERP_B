    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                LabourDcOutgoingVMs.IsSameAsShipping = true;
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }

            LabourDcOutgoingVMs.IsSameAsShipping = false;

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltCustId == selectedId);
            if (selectedConsignee == null)
                return;

            LabourDcOutgoingVMs.ShippingId = selectedConsignee.AltCustId;
            LabourDcOutgoingVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltCustAddr1, selectedConsignee.AltCustAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            LabourDcOutgoingVMs.ShippingGstNo = selectedConsignee.GSTNo ?? string.Empty;
            LabourDcOutgoingVMs.ShippingPhone = selectedConsignee.ContactNo ?? string.Empty;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }
