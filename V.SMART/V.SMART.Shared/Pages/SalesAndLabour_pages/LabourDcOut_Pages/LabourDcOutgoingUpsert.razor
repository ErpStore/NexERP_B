    private void ToggleIsWithoutPoDc(bool value)
    {

        if(value)
        {
            if(LabourDcOutgoingVMs.WithoutPoDc)
            {
                LabourDcOutgoingVMs.WithoutPoDc = false;
                LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Clear();
                    scns.Clear();
                    getPos.Clear();
            }
            else
            {
                LabourDcOutgoingVMs.WithoutPoDc = true;
                LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Clear();
                    scns.Clear();
                    getPos.Clear();
            }


        }
        else
        {
            LabourDcOutgoingVMs.WithoutPoDc = false;
            LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Clear();
            scns.Clear();
            getPos.Clear();
            
        }


    }
