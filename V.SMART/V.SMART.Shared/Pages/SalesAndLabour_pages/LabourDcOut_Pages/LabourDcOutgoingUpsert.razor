    private async Task OnCutomerGRNDCSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        try
        {
            // 🔹 INIT
            LabourDcOutgoingVMs.LabourDcOutgoingSubVMs ??= new List<LabourDcOutgoingSubVM>();
            LabourSCNVMs.LabourSCNSubVMs ??= new List<LabourSCNSubVM>();

            if (LabourDcOutgoingVMs.StoreIssId == 0)
            {
                await _JS.ToastrWarning("Please select Purchase Store");
                return;
            }

            int storeId = LabourDcOutgoingVMs.StoreIssId.Value;

            // 🔹 GET GRN IDS
            var grnIds = selectedItems
                .Where(x => x.ContainsKey("GRNId") && x["GRNId"] != null)
                .Select(x => Convert.ToInt32(x["GRNId"]))
                .Distinct()
                .ToList();

            var scnIds = await _dcService.GetSCNIdsByGRNIds(grnIds);

            // 🔹 GET SCN DATA
            var scnData = scnIds.Any()
                ? await _dcService.GetLabourSCNQtyByReceivedIdsAsync(scnIds)
                : new List<LabourSCNSubVM>();

            //  STATIC LOOKUP (FOR BOM / RM ONLY — DO NOT MODIFY)
            var receivedLookup = scnData
                .GroupBy(x => x.ItemId)
                .ToDictionary(g => g.Key, g => g.Sum(x => x.BalQty ?? 0));

            // 🔹 LOOP ITEMS
            foreach (var item in selectedItems)
            {
                int itemId = GetInt(item, "ItemId");
                int? poSubId = GetNullableInt(item, "RefPoSubId");
                int? grnSubId = GetNullableInt(item, "GRNSubId");
                int? categoryCode = GetNullableInt(item, "CategoryCode");

                decimal balQty = GetDecimal(item, "BalQty");
                decimal price = GetDecimal(item, "UnitPrice");
                decimal stockQty = GetDecimal(item, "StockQty");

                // 🔹 DUPLICATE CHECK
                if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs
                    .Any(x => x.ItemId == itemId && x.RefGRNSubId == grnSubId))
                    continue;

                decimal possibleQty = balQty;

                if (!LabourDcOutgoingVMs.Manual)
                {
                    bool isSameItem = false;

                    if (poSubId.HasValue)
                        isSameItem = await _dcService.CheckIsSameAsOutItemByPoSubId(poSubId.Value);

                    // ✅ CASE 1: SAME ITEM (RUNNING BALANCE ✅)
                    if (isSameItem)
                    {
                        if (receivedLookup.TryGetValue(itemId, out decimal availableQty))
                        {
                            decimal allocatedQty = Math.Min(availableQty, balQty);

                            possibleQty = allocatedQty;

                            //  Reduce ONLY in scnBalance
                            receivedLookup[itemId] = availableQty - allocatedQty;
                        }
                        else
                        {
                            possibleQty = 0;
                        }
                    }

                    // ✅ CASE 2: BOM / RM (NO BALANCE REDUCTION HERE ❗)
                    else if (!LabourDcOutgoingVMs.ReceivedReturnRM)
                    {
                        if (categoryCode == 3 || categoryCode == 7)
                        {
                            var bomItems = await _dcService.GetAssemblyItemsAsync(itemId);

                            decimal? min = null;

                            foreach (var bom in bomItems)
                            {
                                if (!receivedLookup.TryGetValue(bom.ItemId, out decimal recQty) || bom.UtilQty <= 0)
                                    continue;

                                decimal calc = recQty / bom.UtilQty.GetValueOrDefault();
                                min = min == null ? calc : Math.Min(min.Value, calc);
                            }

                            possibleQty = Math.Min(min ?? 0, balQty);
                        }
                        else if (categoryCode == 2)
                        {
                            var rmItems = await _dcService.GetRawMaterialItemsAsync(itemId);

                            decimal? min = null;

                            foreach (var rm in rmItems)
                            {
                                if (!receivedLookup.TryGetValue(rm.ItemId, out decimal recQty) || rm.Weight <= 0)
                                    continue;

                                decimal calc = recQty / rm.Weight;
                                min = min == null ? calc : Math.Min(min.Value, calc);
                            }

                            possibleQty = Math.Min(min ?? 0, balQty);
                        }
                    }
                }

                // FINAL QTY (WITH STOCK CHECK)
                decimal finalQty = Math.Min(possibleQty, stockQty);

                // CREATE VM
                var vm = new LabourDcOutgoingSubVM
                {
                    TransType = "Out",
                    ItemId = itemId,
                    ItemCode = GetString(item, "ItemCode"),
                    ItemName = GetString(item, "ItemName"),
                    Specification = GetString(item, "ItemSpecification"),
                    MeasureUnit = GetString(item, "MeasureUnit"),
                    HSNCode = GetString(item, "HSNCode"),
                    Category = GetString(item, "Category"),

                    Qty = finalQty,
                    BalQty = finalQty,
                    PossibleQty = possibleQty,

                    UnitPrice = price,
                    StockQty = stockQty,

                    RefGRNSubId = grnSubId,
                    RefGRNNo = GetString(item, "GRNNo"),
                    RefGRNDate = GetDate(item, "GRNDate"),

                    RefPoSubId = poSubId,
                    RefPoNo = GetString(item, "RefPoNo") ,
                    RefPoDate = GetDate(item, "RefPoDate"),
                    LineNo = GetInt(item, "LineNo"),

                    RefDcNo = GetString(item, "RefDcNo"),
                    RefDcDate = GetDate(item, "RefDcDate"),


                    IsEditable = true
                };

                LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Add(vm);
            }

            // 🔹 MANUAL MODE
            if (LabourDcOutgoingVMs.Manual && scnIds.Any())
            {
                foreach (var scn in scnData)
                {
                    if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs
                        .Any(x => x.RefSCNSubId == scn.SCNSubId))
                        continue;

                    decimal stockQty = await _dcService.GetStockForItemRcSubIdAsync(
                        scn.ItemId ?? 0, storeId, null);

                    var vm = new LabourDcOutgoingSubVM
                    {
                        RefSCNSubId = scn.SCNSubId,
                        ItemId = scn.ItemId ?? 0,
                        ItemCode = scn.ItemCode,
                        ItemName = scn.ItemName,
                        MeasureUnit = scn.MeasureUnit,
                        UnitPrice = scn.UnitPrice,
                        HSNCode = scn.HSNCode,

                        TransType = LabourDcOutgoingVMs.ReceivedReturnRM ? "Out" : "In",

                        Qty = scn.BalQty.GetValueOrDefault(),
                        BalQty = scn.BalQty.GetValueOrDefault(),
                        PossibleQty = scn.BalQty,

                        StockQty = stockQty,
                        IsEditable = false
                    };

                    LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Add(vm);
                }
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnGRNDCSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected items.");
        }
    }

    private int GetInt(Dictionary<string, object> dict, string key)
    {
        return dict.ContainsKey(key) && dict[key] != null
            ? Convert.ToInt32(dict[key])
            : 0;
    }

    private int? GetNullableInt(Dictionary<string, object> dict, string key)
    {
        return dict.ContainsKey(key) && dict[key] != null
            ? Convert.ToInt32(dict[key])
            : (int?)null;
    }

    private decimal GetDecimal(Dictionary<string, object> dict, string key)
    {
        return dict.ContainsKey(key) && dict[key] != null
            ? Convert.ToDecimal(dict[key])
            : 0;
    }

    private string GetString(Dictionary<string, object> dict, string key)
    {
        return dict.ContainsKey(key)
            ? dict[key]?.ToString() ?? ""
            : "";
    }

    private DateTime? GetDate(Dictionary<string, object> dict, string key)
    {
        if (dict.ContainsKey(key) && DateTime.TryParse(dict[key]?.ToString(), out var dt))
            return dt;

        return null;
    }

    #endregion

    #region Formatting
    private string FormatDecimal(decimal? value)
    {
        return value?.ToString($"F{DecimalPlaces}") ?? (0m).ToString($"F{DecimalPlaces}");
    }
    #endregion


    #region Dc upsert Operations

    private async Task UpsertDcOutgoing()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.RemoveAll(x =>
                 x.ItemId == 0 &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Any())
            {
                await _JS.ToastrWarning("Cannot save a Labour Dc without valid items.");
                return;
            }

            if (string.IsNullOrWhiteSpace(LabourDcOutgoingVMs.DcNo))
            {
                await _JS.ToastrWarning($"Please enter the DC number");
                return ;
            }

            if (LabourDcOutgoingVMs.StoreIssId==0)
            {
                await _JS.ToastrWarning($"Please select  store. ");
                return ;
            }

          

                if(IsPoWiseLabDcOut)
                {
                     foreach (var line in LabourDcOutgoingVMs.LabourDcOutgoingSubVMs)
                              {
                                  bool isValid =  await ValidateRowForPoWiseAsync(line);
                                  if (!isValid) return;
                              }
                   
                }
                else
                {
                            foreach (var line in LabourDcOutgoingVMs.LabourDcOutgoingSubVMs)
                              {
                                  bool isValid = await ValidateRowAsync(line);
                                  if (!isValid) return;
                              }

                }

               
            

            // Save
            var isNewDc = LabourDcOutgoingVMs.DcId == 0;

            if (isNewDc)
            {
                if (await _dcService.IsDuplicateDcNoAsync(LabourDcOutgoingVMs.CustId.Value, LabourDcOutgoingVMs.DcNo, LabourDcOutgoingVMs.Suffix))
                {
                    await _JS.ToastrWarning($"The same Customer {LabourDcOutgoingVMs.CustName} and DC No {LabourDcOutgoingVMs.DcNo} already exist. Please enter a different DC No.");
                    return;
                }
            }
            try
            {
                  if(IsPoWiseLabDcOut)

                  {
                       await _dcService.UpsertPoWiseDcAsync(LabourDcOutgoingVMs, screenCode);
                  }
                  else
                  {
                        await _dcService.UpsertDcAsync(LabourDcOutgoingVMs, screenCode);
                  }

            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewDc)
                await _JS.ToastrSuccess("Labour Dc saved successfully.");
            else
                await _JS.ToastrSuccess("Labour Dc updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigation.NavigateTo("/labourDcoutgoingList");
        }

        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertDc failed.");
            await _JS.ToastrError("Error saving  Labour Dc.");
        }
        finally
        {
            isProcessing = false;
        }
    }

