                                   decimal PossibleQty = SubVM.PossibleQty ?? 0;
                                   decimal stockQty = SubVM.StockQty ?? 0;
                                   decimal poBalQty = SubVM.PoBalQty ?? 0m;

                                   decimal minVal = Math.Min(stockQty, poBalQty);
