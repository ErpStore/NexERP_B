    private async Task Cancel()
    {
        try
        {
            if (!DcId.HasValue || DcId == 0)
            {
                await _JS.ToastrError("Labour Dc Outgoing cancel is not allowed before saving the enquiry.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Labour Dc Outgoing");
                return;
            }

            if (LabourDcOutgoingVMs.ShortClose)
            {
                await _JS.ToastrError("Labour Dc Outgoing  is already short closed. You can't cancel it.");
                return;
            }

            // If ANY item is already cancelled → stop GRN cancel
            if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Any(s => s.ItemCancel))
            {
                await _JS.ToastrWarning("Labour Dc Outgoing cannot be cancelled — one or more items are already cancelled.");
                return;
            }


            if(!string.IsNullOrEmpty(LabourDcOutgoingVMs.EwayNo))
            {
                await _JS.ToastrWarning("This Dc cannot be cancel because Eway transactions are done.");
                return;
            }

            if(LabourDcOutgoingVMs.DcCancel)
            {
                var subs = await _dcService.GetDcOutgoingSubDetailsBydcIdAsync(LabourDcOutgoingVMs.DcId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    if(IsPoWiseLabDcOut)
                    {
                    await _dcService.ValidateLabourSCNBalanceBeforeRevertPoWiseAsync(sub,LabourDcOutgoingVMs);
                    
                    }
                    else
                    {
                    await _dcService.ValidateLabourSCNBalanceBeforeRevertAsync(sub,LabourDcOutgoingVMs);
                    }

                }
            }

            if (!LabourDcOutgoingVMs.DcCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this DC?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this DC?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            LabourDcOutgoingVMs = await _dcService.GetLabourDcByIdAsync(LabourDcOutgoingVMs.DcId);
            await _JS.ToastrError( "Cannot revert DC. Issued quantity exceeds the available SCN balance Qty.");
            await LoggingService.LogDeveloperError(ex, "Error in DC Sales Cancel() method");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the DC.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in DC Sales Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnItemCancelChanged(LabourDcOutgoingSubVM subitem)
    {
        try
        {

            if(subitem.TransType=="Out")
            {
                if (subitem.Qty != subitem.BalQty)
                {
                    await _JS.ToastrError("Item cannot be cancelled/Revert — some transactions have been made on it.");
                    return;
                }
            }
            if (LabourDcOutgoingVMs.DcCancel)
            {
                await _JS.ToastrWarning("Item cannot be cancelled — Labour Dc Outging is already cancelled.");
                return;
            }

            if(!string.IsNullOrEmpty(LabourDcOutgoingVMs.EwayNo))
            {
                await _JS.ToastrWarning("This Item cannot be cancel because Eway transactions are done.");
                return;
            }

            var (canDelete, message) = await _dcService.CanCancelAndRevokelabourDcOutgoingAsync(subitem.DcId,subitem.DcSubId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            var entity = new LabourDcOutgoingSub
            {
                DcSubId = subitem.DcSubId,
                RefSCNSubId = subitem.RefSCNSubId,
                RefPoSubId=subitem.RefPoSubId,
                RefGRNSubId=subitem.RefGRNSubId,
                Qty = subitem.Qty??0,
                BalQty = subitem.BalQty,
            };

            if(subitem.ItemCancel)
            {
                await _dcService.ValidateLabourSCNBalanceBeforeRevertAsync(entity,LabourDcOutgoingVMs);
            }


            if (subitem.ItemId > 0)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _JS.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _JS.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            LabourDcOutgoingVMs = await _dcService.GetLabourDcByIdAsync(LabourDcOutgoingVMs.DcId);
            await _JS.ToastrError( "Cannot revert DC. Issued quantity exceeds the available SCN balance Qty.");
            await LoggingService.LogDeveloperError(ex, "Error in DC Sales Cancel() method");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in PO Sales");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
                    await CancelDc();
                    break;

                case "ItemCancel":
                    await CancelItem(rowToCancel);
                    break;

                case "ShortClose":
                    await ShortCloseLabourDcOutgoing();
                    break;
                case "Pos":
                      await ShowScnGrnPoDetails();
                      break;
                case "GRNs":
                      await ShowScnGrnPoDetails();
                      break;

                default:
                    await _JS.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
        finally
        {
            IsCancelOutItem = await _dcService.GetLabourDcByIdIsCancelOutItemByAsync(LabourDcOutgoingVMs.DcId);
            isProcessing = false;
        }
    }

