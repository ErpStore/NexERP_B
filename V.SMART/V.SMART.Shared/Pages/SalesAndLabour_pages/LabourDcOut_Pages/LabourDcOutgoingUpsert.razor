    private async Task LoadExistingDc(int dcid)
    {
        try
        {
            LabourDcOutgoingVMs = await _dcService.GetLabourDcByIdAsync(dcid);

            if (LabourDcOutgoingVMs == null)
            {
                await _JS.ToastrWarning("DC not found.");
                return;
            }

            await LoadCustomerAsync();

            if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs != null)
            {
                foreach (var sub in LabourDcOutgoingVMs.LabourDcOutgoingSubVMs)
                {
                    attachmentCounts[sub.ItemId] = await _dcService.GetCorrespondenceAttachmentsCountAsync(sub.ItemId, "Item");
                        if(IsPoWiseLabDcOut)
                        {
                            sub.PossibleQty=await CalculatePossibleQtyPOWiseAsync(sub); 
                        }
                        else
                        {
                           sub.PossibleQty = await CalculatePossibleQtyAsync(sub);
                        }
                }
            }

            var poSubIds = LabourDcOutgoingVMs.LabourDcOutgoingSubVMs
                .Where(x => x.RefPoSubId.HasValue && x.RefPoSubId > 0)
                .Select(x => x.RefPoSubId.Value)
                .Distinct()
                .ToList();

            if (poSubIds.Any())
                ReduceRejRewQty = await _dcService.HasRejectReworkPoAsync(poSubIds);

            var dcSubIds = LabourDcOutgoingVMs.LabourDcOutgoingSubVMs
                .Select(x => x.DcSubId)
                .Distinct()
                .ToList();

            isTrasactionmade = await _dcService.CanlabourDcOutgoingTrasByDcsubIdAsync(dcSubIds);

            IsSomeItemsTransMade = await CheckIsTransMade();

            IsCancelOutItem = await _dcService.GetLabourDcByIdIsCancelOutItemByAsync(dcid);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load DC.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingDc failed for DcId: {dcid}");
        }
    }


    private async Task LoadCustomerAsync()
    {
        try
        {
            if (!LabourDcOutgoingVMs!.CustId.HasValue)
                return;

            SelectedCustomer = await _dcService
                .GetCustomerByIdAsync(LabourDcOutgoingVMs.CustId.Value);

            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load Existing LoadCustomerAsync.");
            await LoggingService.LogDeveloperError(ex,$"LoadExistingDc failed in LoadCustomerAsync for CustName: {SelectedCustomer.CustName}");

        }
    }



    private async Task<decimal> CalculatePossibleQtyAsync(LabourDcOutgoingSubVM sub)
    {
        try
        {
            decimal possibleQty = 0;

            // =============================
            // PO BASED ITEMS
            // =============================
            if (sub.RefPoSubId.GetValueOrDefault() > 0)
            {

                bool IsOutItemSameAsInItem = await _dcService.CheckIsSameAsOutItemByPoSubId(sub.RefPoSubId.Value);

                if (LabourDcOutgoingVMs.Manual)
                {
                    possibleQty = await _dcService.GetLabourGrnItemBalQtyByGrnSubId(sub.RefGRNSubId ?? 0);
                }
                else
                {
                    possibleQty = await CalculatePoBasedQtyAsync(sub, sub.BalQty, IsOutItemSameAsInItem);
                }
            }

            if(sub.RefGRNSubId.GetValueOrDefault() > 0)
            {
                  possibleQty = await CalculatePoBasedQtyAsync(sub, sub.BalQty, false);
            }



            // =============================
            // MANUAL OUT ITEM (GRN)
            // =============================

            else if (LabourDcOutgoingVMs.Manual &&
                     sub.TransType == "Out" &&
                     !LabourDcOutgoingVMs.ReceivedReturnRM)
            {
                possibleQty =
                    (await _dcService.GetLaboourGRnBalQtyByGRNSubId(sub.RefGRNSubId ?? 0))
                    .GetValueOrDefault();
            }

            // =============================
            // SCN BASED ITEMS
            // =============================
            if (sub.TransType == "In" || LabourDcOutgoingVMs.ReceivedReturnRM)
            {
                possibleQty = (await _dcService.GetSCNBalQtyBySCNSubId(
                                sub.RefSCNSubId ?? 0,
                                LabourDcOutgoingVMs.SCNRejectReworkReturn))
                                .GetValueOrDefault();
            }

            // =============================
            // STOCK
            // =============================
            sub.StockQty = await _dcService.GetStockQtyFromStockManager(
                sub.ItemId,
                LabourDcOutgoingVMs.StoreIssId!.Value);

            return Math.Max(0, possibleQty);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to calculate possible quantity.");
            await LoggingService.LogDeveloperError(ex,$"CalculatePossibleQtyAsync failed for DcId: {DcId}");

            return 0;
        }
    }

    private async Task<decimal> CalculatePoBasedQtyAsync(LabourDcOutgoingSubVM sub,decimal balQty, bool IsSameinItemasOutItem)
    {
        try
        {
            decimal grnBalQty = 0;
            var scnIds = await _dcService.GetSCNIdsByGRNSubIdAsync(sub.RefGRNSubId.Value);

            if (IsSameinItemasOutItem)
            {
                var scnData = await _dcService.GetLabourSCNQtyByReceivedIdsAsync(scnIds);

                var receivedLookup = scnData
                    .GroupBy(x => x.ItemId)
                    .ToDictionary(g => g.Key, g => g.Sum(x => x.BalQty ?? 0));
                
                decimal PosibleQty = 0;
                
                if (receivedLookup.TryGetValue(sub.ItemId, out decimal availableQty))
                {
                    decimal allocatedQty = Math.Min(availableQty, balQty);
                    PosibleQty = allocatedQty;
                    receivedLookup[sub.ItemId] = availableQty - allocatedQty;
                }
                else
                {
                    PosibleQty = 0;
                }
                return Math.Min(PosibleQty, balQty);
            }

            // ===============================
            // NORMAL CATEGORY LOGIC
            // ===============================

            var received = scnIds.Any()
                ? await _dcService.GetReceivedQtyByScnSubIdsAsync(scnIds)
                : new List<LabourSCNSubVM>();
            
            var issuedLookup = received
                .Where(x => x.ItemId.HasValue)
                .ToLookup(x => x.ItemId!.Value);
            
            if(sub.RefGRNSubId > 0)
            {
                grnBalQty = await _dcService.GetLabourGrnItemBalQtyByGrnSubId(sub.RefGRNSubId ?? 0); 
            }

            return sub.CategoryCode switch
            {
                3 or 7 => await CalculateAssemblyQtyAsync(sub, issuedLookup, balQty),

                2 => await CalculateRawMaterialQtyAsync(sub, issuedLookup, balQty),

                _ => Math.Min(grnBalQty, balQty)
            };
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to calculate PO based quantity.");
            await LoggingService.LogDeveloperError(
                ex,
                $"CalculatePoBasedQtyAsync failed for DcId: {DcId}");

            return 0;
        }
    }


    private async Task<decimal> CalculateAssemblyQtyAsync(LabourDcOutgoingSubVM sub, ILookup<int, LabourSCNSubVM> issuedLookup, decimal balQty)
    {
        try
        {
            var bomItems = await _dcService.GetAssemblyItemsAsync(sub.ItemId);

            decimal? minPossible = null;

            foreach (var bom in bomItems.Where(b => b.UtilQty > 0))
            {
                // SUM all duplicate rows
                var issuedQty = issuedLookup[bom.ItemId.Value]
                                    .Sum(x => x.BalQty ?? 0m);

                if (issuedQty <= 0)
                    return 0m;

                var possible = issuedQty / bom.UtilQty;

                minPossible = minPossible == null
                    ? possible
                    : Math.Min(minPossible.GetValueOrDefault(), possible.GetValueOrDefault());
            }


            var result = Math.Min(minPossible ?? 0m, balQty);

            return Math.Truncate(result * 100m) / 100m;

            // return Math.Min(minPossible ?? 0m, balQty);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load Existing CalculateAssemblyQtyAsync.");
            await LoggingService.LogDeveloperError(
                ex,
                $"LoadExistingDc failed in CalculateAssemblyQtyAsync for Dcid: {DcId}");
            return 0m;
        }
    }
    private async Task<decimal> CalculateRawMaterialQtyAsync(LabourDcOutgoingSubVM sub, ILookup<int, LabourSCNSubVM> issuedLookup, decimal balQty)
    {
        try
        {
            var compData = await _dcService.GetRawMaterialItemsAsync(sub.ItemId);

            decimal? minPossible = null;

            foreach (var com in compData)
            {
                if (com.Weight <= 0)
                    continue;


                var receivedQty = issuedLookup[com.ItemId]
                                        .Sum(x => x.BalQty ?? 0m);

                if (receivedQty <= 0)
                    return 0m;

                var possible = receivedQty / com.Weight;

                if (minPossible == null || possible < minPossible)
                    minPossible = possible;
            }

            var result = Math.Min(minPossible ?? 0m, balQty);

            return Math.Truncate(result * 100m) / 100m;
            // return Math.Min(minPossible ?? 0m, balQty);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load Existing CalculateRawMaterialQtyAsync.");
            await LoggingService.LogDeveloperError(
                ex,
                $"LoadExistingDc failed in CalculateRawMaterialQtyAsync for Dcid: {DcId}");
            return 0m;
        }
    }


    private async Task<bool> CheckIsTransMade()
    {
        try
        {
            var list = LabourDcOutgoingVMs?.LabourDcOutgoingSubVMs
                        ?.Where(x => x.TransType == "Out")
                        .ToList();

            if (list == null || list.Count == 0)
                return false;

            decimal totalQty = 0, totalBalQty = 0;

            for (int i = 0; i < list.Count; i++)
            {
                totalQty += list[i].Qty.GetValueOrDefault();
                totalBalQty += list[i].BalQty;
            }

            return totalQty != totalBalQty;


            bool dcCancel = await _dcService.GetLabourDcByIdIsCancelAsync(DcId.Value);

            if (!dcCancel)
                return true;

            if (dcCancel)
                return true;

            if (dcCancel)
                return true;

            return false;

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "CheckIsTransMade failed.");
            return false;
        }
    }

