    private async Task OnQtyChange(ChangeEventArgs e, LabourDcOutgoingSubVM SubVM)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                await _JS.ToastrWarning("Qty must be a positive number.");
                return;
            }


            bool rejRetrack = false;
            decimal newAcceptedQty = 0;
            if(!IsPoWiseLabDcOut)
            {
                // NEW Po line
                if (SubVM.DcSubId == 0)
                {
                    if (SubVM.RefGRNSubId > 0)
                    {
                        decimal PossibleQty = SubVM.PossibleQty ?? 0;
                        decimal stockQty = SubVM.StockQty ?? 0;
                        decimal grnBalQty =  await _dcService.GetLabourGrnItemBalQtyByGrnSubId(SubVM.RefGRNSubId ?? 0);

                        decimal minVal = Math.Min(stockQty, grnBalQty);
                        decimal possibleQty=Math.Min(minVal, PossibleQty);

                        if (newQty <= possibleQty)
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty;
                        }
                        else
                        {
                            SubVM.Qty = possibleQty;
                            SubVM.BalQty = possibleQty;
                            await _JS.ToastrWarning($"Qty cannot exceed Available Qty ({possibleQty}). " + $"[Stock: {stockQty}");
                            return;
                        }
                    }
                    else
                    { 
                        var PossibleQty = SubVM.PossibleQty;

                        if (newQty <= PossibleQty)
                        {
                            SubVM.Qty = newQty;
                            if(SubVM.TransType=="Out")
                                SubVM.BalQty = newQty;
                        }
                        else
                        {
                            SubVM.Qty = PossibleQty;
                            if(SubVM.TransType=="Out")
                                SubVM.BalQty = PossibleQty??0m;

                            await _JS.ToastrWarning($"Qty can't be greater than Possible LabourDcOutgoing Qty ({PossibleQty}).");
                        }
                    }
                }

                // EXISTING DC line
                else
                {
                    var original = await _dcService.GetDcSubItemDetailByDcSubIdAsync(SubVM.DcSubId);
                    if (original == null) return;

                    if(SubVM.TransType=="Out")
                    {
                        decimal alreadyTransacted = original.Qty.GetValueOrDefault() - original.BalQty;

                        // Cannot decrease below transacted quantity
                        if (newQty < alreadyTransacted)
                        {
                            SubVM.Qty = alreadyTransacted;
                            SubVM.BalQty = 0;
                            await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");

                            if (await ValidateAndAdjustAsync(SubVM, SubVM.Qty??0, SubVM.RejectQty??0, SubVM.ReworkQty??0, "Rejected",LabourDcOutgoingVMs.ReduceInvAsPerRej))
                                SubVM.RejectQty = SubVM.RejectQty;
                                
                            return;
                        }

                        if (SubVM.RefGRNSubId > 0)
                        {
                            decimal PossibleQty = SubVM.PossibleQty??0;

                            decimal grnBalQty = await _dcService.GetLabourGrnItemBalQtyByGrnSubId(SubVM.RefGRNSubId ?? 0);
                            decimal originalQty = original.Qty ?? 0m;
                            decimal rejectQty   = original.RejectQty ?? 0m;

                            decimal maxAllowedQty = (originalQty - rejectQty) + grnBalQty;

                            if (newQty > maxAllowedQty)
                            {
                                SubVM.Qty = maxAllowedQty;
                                SubVM.BalQty = maxAllowedQty - alreadyTransacted;
                                await _JS.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                            }
                            else
                            {
                                SubVM.Qty = newQty;
                                SubVM.BalQty = newQty - alreadyTransacted;
                            }
                        }
                        else
                        {
                            decimal PossibleQty = SubVM.PossibleQty??0;
                            decimal originalQty = original.Qty??0;
                            decimal rejectQty   = original.RejectQty ?? 0m;

                            decimal maxAllowedQty = (originalQty - rejectQty) + PossibleQty;

                            if (newQty > maxAllowedQty)
