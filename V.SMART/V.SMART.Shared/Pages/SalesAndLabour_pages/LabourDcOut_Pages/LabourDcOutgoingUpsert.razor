    private async Task OpenReceivedItems(LabourDcOutgoingSubVM subItem)
    {
        try
        {
            SelectedItemId = subItem.ItemId;

            List<int> scnIds;

            if (!LabourDcOutgoingVMs.WithoutPoDc)
            {
                scnIds = await _dcService.GetReceivedSCNIdsByRefPoSubId(subItem.RefPoSubId ?? 0);
            }
            else
            {
                scnIds = await _dcService
                    .GetReceivedSCNSubIdsByRefRefGrnSubId(subItem.RefGRNSubId ?? 0);
            }

            var receivedItems = scnIds.Any()
                ? await _dcService.GetReceivedQtyByScnIdsByDetailsAsync(scnIds)
                : new List<LabourSCNSubVM>();

            var result = new List<LabourSCNSubVM>();

            /* =======================
               BOM / Assembly Items
               ======================= */
            if (subItem.CategoryCode == 3 || subItem.CategoryCode == 7)
            {
                var bomItems = await _dcService.GetAssemblyItemsAsync(subItem.ItemId);

                foreach (var bom in bomItems)
                {
                    var receivedForItem = receivedItems
                        .Where(r => r.ItemId == bom.ItemId)
                        .ToList();

                    if (receivedForItem.Any())
                    {
                        foreach (var rec in receivedForItem)
                        {
                            result.Add(new LabourSCNSubVM
                            {
                                ItemId = bom.ItemId,
                                ItemName = rec.ItemName,
                                ItemCode = rec.ItemCode,
                                SCNId = rec.SCNId,
                                RefGRNNo = rec.RefGRNNo,
                                AcceptQty = rec.AcceptQty,
                                BalQty = rec.BalQty,
                                UtilQty = bom.UtilQty
                            });
                        }
                    }
                    else
                    {
                        result.Add(new LabourSCNSubVM
                        {
                            ItemId = bom.ItemId,
                            ItemName = bom.PartItemName,
                            AcceptQty = 0,
                            BalQty = 0,
                            UtilQty = bom.UtilQty
                        });
                    }
                }
            }

            /* =======================
               Component / Raw Material
               ======================= */
            else if (subItem.CategoryCode == 2)
            {
                var compItems = await _dcService.GetRawMaterialItemsAsync(subItem.ItemId);

                foreach (var comp in compItems)
                {
                    var receivedForItem = receivedItems
                        .Where(r => r.ItemId == comp.ItemId)
                        .ToList();

                    if (receivedForItem.Any())
                    {
                        foreach (var rec in receivedForItem)
                        {
                            result.Add(new LabourSCNSubVM
                            {
                                ItemId = rec.ItemId,
                                ItemName = rec.ItemName,
                                ItemCode = rec.ItemCode,
                                SCNId = rec.SCNId,
                                RefGRNNo = rec.RefGRNNo,
                                AcceptQty = rec.AcceptQty,
                                BalQty = rec.BalQty,
                                UtilQty = rec.AcceptQty
                            });
                        }
                    }
                    else
                    {
                        result.Add(new LabourSCNSubVM
                        {
                            ItemId = comp.ItemId,
                            ItemName = comp.ItemName,
                            AcceptQty = 0,
                            BalQty = 0,
                            UtilQty = comp.Weight
                        });
                    }
                }
            }

            /* =======================
               Fallback (No Data)
               ======================= */
            else
            {
                result.Add(new LabourSCNSubVM
                {
                    ItemId = subItem.ItemId,
                    ItemName = subItem.ItemName,
                    AcceptQty = 0,
                    BalQty = 0,
                    UtilQty = subItem.Qty ?? 1
                });
            }

            ViewReceivedItems = result;
            ShowReceivedModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load received items.");
            await LoggingService.LogDeveloperError(ex, "OpenReceivedItems failed");
        }
    }



