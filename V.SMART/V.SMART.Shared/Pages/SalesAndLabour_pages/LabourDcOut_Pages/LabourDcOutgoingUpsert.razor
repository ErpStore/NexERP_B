                            }
                            else
                            {
                                SubVM.Qty = newQty;
                                SubVM.BalQty = newQty - alreadyTransacted;
                            }
                        }
                    }
                    else
                    {
                        decimal PossibleQty = SubVM.PossibleQty??0;
                        decimal maxAllowedQty = original.Qty + PossibleQty??0;

                        if (newQty > maxAllowedQty)
                        {
                            SubVM.Qty = maxAllowedQty;

                            await _JS.ToastrWarning($"Qty cannot be greater than original qty ({maxAllowedQty}).");

