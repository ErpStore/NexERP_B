                LabourDcOutgoingVMs.CancelReason = cancelReason;
                LabourDcOutgoingVMs.CanceledDate = DateTime.Now;
                LabourDcOutgoingVMs.CanceledBy = username;
                  if(IsPoWiseLabDcOut)
                  {
       
                        await _dcService.UpdatedCancelStatusAndAddOrRevertQtyPoWiseAync(LabourDcOutgoingVMs, screenCode);
                  }
                  else
                  {
                       await _dcService.UpdatedCancelStatusAndAddOrRevertQty(LabourDcOutgoingVMs, screenCode);
                  }

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Labour DC",
                    action: $"Cancelled Manufacturing DC No: {LabourDcOutgoingVMs.DcNo}",
                    additionalInfo: $"Labour DC Id: {LabourDcOutgoingVMs.DcId}"
                );

                await _JS.ToastrSuccess("DC cancelled successfully.");
            }
            else
            {
                LabourDcOutgoingVMs.DcCancel = false;
                LabourDcOutgoingVMs.CancelReason = string.Empty;
                if(IsPoWiseLabDcOut)
                 {
                   await _dcService.UpdatedCancelStatusAndAddOrRevertQtyPoWiseAync(LabourDcOutgoingVMs, screenCode);
                 }
                  else
                  {
                     await _dcService.UpdatedCancelStatusAndAddOrRevertQty(LabourDcOutgoingVMs, screenCode);
                  }

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Labour DC",
                    action: $"Reverted Manufacturing DC No: {LabourDcOutgoingVMs.DcNo}",
                    additionalInfo: $"DC Id: {LabourDcOutgoingVMs.DcId}"
                );

                await _JS.ToastrSuccess("DC has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the Sales DC.");
            await LoggingService.LogDeveloperError(ex, $"CancelDc failed for DcId: {LabourDcOutgoingVMs.DcId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.DcSubId > 0)
            {
                 if(IsPoWiseLabDcOut)
                 {
                     await _dcService.DeleteAndResequencePoWiseAsync(rowToDelete, LabourDcOutgoingVMs,screenCode);
                 }
                 else
                 {
                     await _dcService.DeleteAndResequenceAsync(rowToDelete, LabourDcOutgoingVMs,screenCode);
                 }

                LabourDcOutgoingVMs.LabourDcOutgoingSubVMs = await _dcService.GetDcSubByDcIdAsync(LabourDcOutgoingVMs.DcId);
            }
            else
            {
                LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Remove(rowToDelete);

                if (!LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Any())
                {
                    LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Add(new LabourDcOutgoingSubVM
                    {
                        DcId = LabourDcOutgoingVMs.DcId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    ResetSlno();
                }
            }

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for DcId: {LabourDcOutgoingVMs.DcId}");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

