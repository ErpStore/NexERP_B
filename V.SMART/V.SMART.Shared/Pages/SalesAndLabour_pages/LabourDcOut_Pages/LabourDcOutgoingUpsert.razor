    private async Task<decimal> CalculatePossibleQtyPOWiseAsync(LabourDcOutgoingSubVM sub)
    {
        try
        {
            decimal balQty = sub.BalQty;
            decimal possibleQty = balQty;

            // Po Balance Qty 
            if (sub.RefPoSubId.HasValue && sub.RefPoSubId > 0)
            {
                if(LabourDcOutgoingVMs.Manual)
                {
                    possibleQty = (await _dcService.GetLaboourPoBalQtyByPoSubId(sub.RefPoSubId.Value)) .GetValueOrDefault();

                }
                else
                {
                    possibleQty = await CalculatePoBasedQtyAsync(sub, balQty);

                }


            }
            // Manul selction 
            else if (LabourDcOutgoingVMs!.Manual && sub.TransType == "Out" && !LabourDcOutgoingVMs.ReceivedReturnRM)
            {
                possibleQty = (await _dcService
                    .GetLaboourGRnBalQtyByGRNSubId(sub.RefGRNSubId ?? 0)) ?? 0m;
            }

            sub.StockQty = await _dcService
                .GetStockQtyFromStockManager(sub.ItemId, LabourDcOutgoingVMs!.StoreIssId!.Value);

            // SCN Balance Qty 
            if (sub.TransType == "In" || LabourDcOutgoingVMs.ReceivedReturnRM)
            {
                possibleQty=(await _dcService.GetSCNBalQtyBySCNSubId(sub.RefSCNSubId ?? 0,LabourDcOutgoingVMs.SCNRejectReworkReturn)) ?? 0m;
            }


            return Math.Max(0, possibleQty);

        }
        catch (Exception ex) 
        {
            await _JS.ToastrError("Failed to load Existing CalculatePossibleQtyAsync.");
            await LoggingService.LogDeveloperError(ex,$"LoadExistingDc failed in CalculatePossibleQtyAsync for Dcid: {DcId}");
            return 0m;
        }
    }
     private async Task<decimal> CalculatePoBasedQtyAsync(LabourDcOutgoingSubVM sub, decimal balQty)
     {
         try
         {
             var scnIds = await _dcService
                 .GetReceivedSCNSubIdsByRefPoSubId(sub.RefPoSubId!.Value);

             var received = scnIds.Any()
                 ? await _dcService.GetReceivedQtyByScnSubIdsAsync(scnIds)
                 : new List<LabourSCNSubVM>();

             // LOOKUP (keeps duplicates)
             var issuedLookup = received
                 .Where(x => x.ItemId.HasValue)
                 .ToLookup(x => x.ItemId!.Value);

             return sub.CategoryCode switch
             {
                 3 or 7 => await CalculateAssemblyQtyAsync(sub, issuedLookup, balQty),
                 2      => await CalculateRawMaterialQtyAsync(sub, issuedLookup, balQty),
                 _      => sub?.PoBalQty ?? 0m
             };
         }
         catch (Exception ex)
         {
             await _JS.ToastrError("Failed to load Existing CalculatePoBasedQtyAsync.");
             await LoggingService.LogDeveloperError(
                 ex,
                 $"LoadExistingDc failed in CalculatePoBasedQtyAsync for Dcid: {DcId}");
             return 0m;
         }
     }

    public async Task ToggleAllPO(ChangeEventArgs e)
    {
        try
        {
            
            bool isChecked = (bool)e.Value;
            IsAllPoSelected = isChecked;

            if (LabourDcOutgoingVMs.WithoutPoDc)
            {
                foreach (var dc in FilteredDc)
                {
                    dc.IsSelected = isChecked;
                    await OnDCCheckedChanged(dc,isChecked);
                }
        
            }
            else
            {
                foreach (var po in FilteredPos)
                {
                        po.IsSelected = isChecked;
                        await OnPoCheckedChanged(po,isChecked);

                }
           
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ToggleAllPO() failed.");
            await _JS.ToastrError("Error processing ToggleAllPO() items.");
        }

    } 
