    private async Task AskToShortCloseAsync(LabourDcOutgoingVM LabourDcOutgoingVMs)
    {
        try
        {
            if (LabourDcOutgoingVMs == null)
            {
                await _JS.ToastrError("Invalid Labour DcOutgoing selected.");
                return;
            }

            if (!DcId.HasValue || DcId == 0)
            {
                await _JS.ToastrError("Labour DcOutgoing Short Close is not allowed before saving the Labour SCN.");
                return;
            }

            if (LabourDcOutgoingVMs.DcTally)
            {
                await _JS.ToastrWarning("This Labour DcOutgoing is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (LabourDcOutgoingVMs.DcCancel)
            {
                await _JS.ToastrWarning("This Labour DcOutgoing is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!LabourDcOutgoingVMs.DcCancel)
            {
                ModalTitle = "Are you sure you want to Short-Close this Labour DcOutgoing?";
                btnText = "Short Close";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Labour DcOutgoing?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while AskToShortCloseAsync Labour DcOutgoing.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnRejQtyChange(decimal? newValue, LabourDcOutgoingSubVM subVM)
    {
        try
        {
            var rej = newValue.GetValueOrDefault();
            if (rej < 0)
            {
                subVM.RejectQty = 0;
                await _JS.ToastrWarning("Rejected Qty must be positive.");
                return;
            }

            var accp = subVM.Qty.GetValueOrDefault();
            var rew = subVM.ReworkQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, "Rejected",LabourDcOutgoingVMs.ReduceInvAsPerRej))
                subVM.RejectQty = rej;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnRejQtyChange failed");
            await _JS.ToastrError("Failed to update Rejection Qty.");
        }
    }

    private async Task OnRewQtyChange(decimal? newValue, LabourDcOutgoingSubVM subVM)
    {
        try
        {
            var rew = newValue.GetValueOrDefault();
            if (rew < 0)
            {
                subVM.ReworkQty = 0;
                await _JS.ToastrWarning("Rework Qty must be positive.");
                return;
            }

            var accp = subVM.Qty.GetValueOrDefault();
            var rej = subVM.RejectQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, "Rework" ,LabourDcOutgoingVMs.ReduceInvAsPerRej))
                subVM.ReworkQty = rew;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnRewQtyChange failed");
            await _JS.ToastrError("Failed to update Rework Qty.");
        }
    }
    private async Task OnReduceInvChanged(ChangeEventArgs e)
    {
        try
        {
            LabourDcOutgoingVMs.ReduceInvAsPerRej = (bool)e.Value;

            foreach (var sub in LabourDcOutgoingVMs.LabourDcOutgoingSubVMs)
            {
                await ValidateAndAdjustAsync(
                    sub,
                    sub.Qty ?? 0,
                    sub.RejectQty ?? 0,
                    sub.ReworkQty ?? 0,
                    "Accepted",
                    LabourDcOutgoingVMs.ReduceInvAsPerRej
                );
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnReduceInvChanged failed");
            await _JS.ToastrError("Failed to update OnReduceInvChanged");
        } 

    }


    private async Task<bool> ValidateAndAdjustAsync(LabourDcOutgoingSubVM subVM, decimal newAccp,  decimal newRej, decimal newRew,string fieldName, bool ReduceInvAsPerRej)
    {
        try
        {
            decimal total = newRej + newRew;

            if (total > newAccp)
            {
                switch (fieldName)
                {
                    case "Rejected":
                        subVM.RejectQty = Math.Max(0, newAccp - newRew);
                        break;
                    case "Rework":
                        subVM.ReworkQty = Math.Max(0, newAccp - newRej);
                        break;
                    case "Accepted":
                        subVM.Qty = total;
                        break;
                }

                await _JS.ToastrWarning($"Rejected + Rework quantity cannot exceed Accepted Qty ({newAccp}).");

                subVM.BalQty = ReduceInvAsPerRej ? Math.Max(0, newAccp - total) : newAccp;

                return false;
            }

            var original = await _dcService.GetDcSubItemDetailByDcSubIdAsync(subVM.DcSubId);

            bool reducerej =await _dcService.GetLabourDcByIdIsReduceInvoicevalueAsync(subVM.DcId);

            if (original == null)
                return true;


            if (subVM.TransType == "Out")
            {
                decimal alreadyTransacted = original.Qty.GetValueOrDefault() - original.BalQty;

                decimal oldTotal = original.RejectQty.GetValueOrDefault() + original.ReworkQty.GetValueOrDefault();

                decimal oldEffectiveQty = ReduceInvAsPerRej ? original.Qty.GetValueOrDefault() - oldTotal : original.Qty.GetValueOrDefault();

                decimal newEffectiveQty = ReduceInvAsPerRej ? newAccp - total: newAccp;

                bool anyReduce = ReduceInvAsPerRej || reducerej;

                if (anyReduce)
                {
                    if (newEffectiveQty < alreadyTransacted)
                    {
                        subVM.BalQty = 0;

                        await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");

                        return false;
                    }
                }
                subVM.BalQty = Math.Max(0, newEffectiveQty - alreadyTransacted);
            }
            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateAndAdjustAsync");
            await _JS.ToastrError("Error ValidateAndAdjustAsync.");

            return false;
        }
    }

