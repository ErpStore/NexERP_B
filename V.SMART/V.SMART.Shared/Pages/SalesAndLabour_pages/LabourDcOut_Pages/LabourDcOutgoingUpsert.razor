@page "/labourDcOutgoing/create"
@page "/labourDcOutgoing/create/{CustId:int}"
@page "/labourDcOutgoing/update/{DcId:int}"


@using MudBlazor
@using V.SMART.Shared.Data.SalesAndLabour.LabourDC
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.LabourDc_VM
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.LabourSCN_VM

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ILabourDcOutgoingService _dcService
@inject IStockManagerService _stockManagerService
@inject ICostingService _CostingService
@inject ReportService reportService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="@("Customer DC Details")"
        Columns="@( ModelColumns)"
        ColumnFields="@(ModelFields)"
        HiddenColumns="@(ModelHiddenColumns)"
        Data="@(ModelData)"
        IsVisible="@IsCustDCModalVisible"
        IsVisibleChanged="@((val) => IsCustDCModalVisible = val)"
        OnSelectedItems="@(OnCutomerGRNDCSelectedAsync)">
</DetailsModal>
<DetailsModal Title="@(!LabourDcOutgoingVMs.WithoutPoDc ? "PO Details" : "DC Details")"
              Columns="@(!LabourDcOutgoingVMs.WithoutPoDc ? PoColumns:ScnGrnPoFields)"
              ColumnFields="@(!LabourDcOutgoingVMs.WithoutPoDc ? PoFields:ScnGrnPoFields)"
              HiddenColumns="@(!LabourDcOutgoingVMs.WithoutPoDc ? HidePoFields:ScnGrnHiddenColumns)"
              Data="@(!LabourDcOutgoingVMs.WithoutPoDc ? getPos : ScnGrnData)"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="@(!LabourDcOutgoingVMs.WithoutPoDc ? OnPoSelectedAsync:OnGRNDCSelectedAsync)">
</DetailsModal>



<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
    else if (ActiveModal == "Eway")
    {
         <EwayDcListModel isDcListDetailsModelVisible=true CustId=@LabourDcOutgoingVMs.CustId.Value Customer=@LabourDcOutgoingVMs.CustName DcType="LabourDc" OnClose="CloseModal" />
    }else if (ActiveModal == "RejectionRework")
    {
         <RejectionReworkDcModel isRejectReworkDetailsModelVisible=true DcId=@LabourDcOutgoingVMs.DcId DcType="MfgDc" OnClose="CloseModal" />
    }

</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }

</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if (LabourDcOutgoingVMs.DcCancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (LabourDcOutgoingVMs.NonReturnDc && LabourDcOutgoingVMs.DcId>0)
            {
                <div class="cancelWatermark">NON RETURNABLE DC</div>
            }
            else if (LabourDcOutgoingVMs.DcSign && LabourDcOutgoingVMs.DcId>0)
            {
                <div class="cancelWatermark">SIGNED AND RETURNABLE</div>
            }
            else if (LabourDcOutgoingVMs.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }
            <PageHeader TitleText="@(LabourDcOutgoingVMs.DcId > 0 ? "Update Delivery challan" : "Create Delivery challan")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@LabourDcBreadcrumbs" />
            <div class="card-body bg-light">
                <EditForm Model="LabourDcOutgoingVMs" OnValidSubmit="UpsertDcOutgoing">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="row g-3 mb-2 align-items-center">

                        <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">
                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" id="OnSingned"
                                        checked="@LabourDcOutgoingVMs.DcSign"
                                        disabled="@(LabourDcOutgoingVMs.DcId==0)"
                                        @onchange="(e) => OnDcSignedToggle(e)" />
                                <label class="form-check-label ms-2  @(LabourDcOutgoingVMs.DcSign ? "text-success" : "")"
                                        for="OnSingned">
                                    <i class="bi bi-check2-circle me-1"></i> Signed & Returned
                                </label>
                            </div>
                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.DcSign)" />
                            
                        </div>

                        <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">

                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" id="ReceivedReturnRM"
                                        checked="@LabourDcOutgoingVMs.ReceivedReturnRM"
                                        disabled="@(LabourDcOutgoingVMs.DcId > 0)"
                                        @onchange="(e) => OnReceivedMaterialToggle(e)" />
                                <label class="form-check-label fw-semibold @(LabourDcOutgoingVMs.DcSign ? "text-primary" : "")"
                                        for="ReceivedReturnRM">
                                    <i class="bi bi-arrow-repeat me-1"></i> Received Material Return
                                </label>
                            </div>
                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.ReceivedReturnRM)" />
                            
                        </div>

                        <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">

                            <div class="form-check form-switch small">
                                <input class="form-check-input" type="checkbox" id="CheckNonReturn"
                                        checked="@LabourDcOutgoingVMs.NonReturnDc"
                                        disabled="@(LabourDcOutgoingVMs.DcId>0)"
                                        @onchange="(e) => OnDcNonReturnableToggle(e)" />
                                <label class="form-check-label fw-semibold @(LabourDcOutgoingVMs.NonReturnDc ? "text-danger" : "")"
                                        for="CheckNonReturn">
                                    <i class="bi bi-box-seam me-1"></i> Dc Non-Returnable
                                </label>
                            </div>
                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.NonReturnDc)" />
                            
                        </div>

                        <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">
                                    <!-- Correspondence Status -->
                            @if (LabourDcOutgoingVMs.DcId > 0 && !string.IsNullOrWhiteSpace(LabourDcOutgoingVMs.DcNo))
                            {
                                <CorrespondenceStatus ReferenceType="Labour-DcOutgoing"
                                                      ReferenceId="@LabourDcOutgoingVMs.DcId"
                                                      ReferenceTypeName="@LabourDcOutgoingVMs.DcNo" />

                            }
                        </div>
                       
                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header equal-card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <!-- Title -->
                                    <span class="fw-bold fs-6 mb-0">Customer Information</span>
                                    <!-- Right Section -->
                                    <div class="d-flex align-items-center gap-3">
                                        <!-- Button -->
                                        <button type="button"
                                                class="btn btn-sm btn-success rounded-3 d-flex align-items-center"
                                                @onclick='() => OpenModal("Customer")'>
                                            <i class="bi bi-person-add me-1"></i> Add Customer
                                        </button>
                                    </div>
                                </div>

                                <div class="card-body">
                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="CustomerVM"
                                                             Value="SelectedCustomer"
                                                             ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                             ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                             SearchFunc="SearchCustomers"
                                                             Dense="true"
                                                             Variant="Variant.Outlined"
                                                             Placeholder="Search Customer"
                                                             Title="Search atleast 3 letters in Customer"
                                                             Class="w-100 autocomplete-sm"
                                                             MaxItems="50"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             Required="true"
                                                             AvoidSubmit="true"
                                                             Disabled="DcId>0" />
                                        </div>
                                    </div>
                               

                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    @bind="@LabourDcOutgoingVMs.KindofAttention">
                                                <option disabled value="">Select Contact Person</option>
                                                @foreach (var cp in contactPersons)
                                                {
                                                    <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.KindofAttention)" />
                                        </div>
                                    </div>

                                    <!-- Shipping Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Shipping Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="form-check form-switch d-flex align-items-center">
                                                <input class="form-check-input" type="checkbox" id="SameAsShipping"
                                                       checked="@LabourDcOutgoingVMs.IsSameAsShipping"
                                                       @onchange="OnShippingChange" />
                                                <label class="form-check-label ms-2 fw-semibold" for="SameAsShipping">
                                                    Same as Shipping
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    @if (!LabourDcOutgoingVMs.IsSameAsShipping)
                                    {
                                        <!-- Shipping To -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Shipping To</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select value="@LabourDcOutgoingVMs.ShippingId"
                                                        class="form-select form-select-sm rounded-3 w-100"
                                                        @onchange="OnConsigneeChangedAsync">
                                                    <option value="">Select Shipping Address</option>
                                                    @foreach (var consine in consineeAddress)
                                                    {
                                                        <option value="@consine.AltCustId">@consine.AltCustName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        @if (LabourDcOutgoingVMs.ShippingId > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Address</small>
                                                </label>
                                                <div class="col-12 col-lg-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@LabourDcOutgoingVMs.ShippingAddress" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Contact No</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@LabourDcOutgoingVMs.ShippingPhone" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>GSTIN</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@LabourDcOutgoingVMs.ShippingGstNo" readonly />
                                                </div>
                                            </div>
                                        }
                                    }


                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Mode Of Transport</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm"
                                                    @bind="LabourDcOutgoingVMs.TransportMode">
                                                <option value="">-- Select Transport Mode --</option>
                                                <option value="1">By Road</option>
                                                <option value="2">By Railway</option>
                                                <option value="3">By Airway</option>
                                                <option value="4">By Seaway</option>
                                            </select>
                                             <ValidationMessage For="@(() => LabourDcOutgoingVMs.TransportMode)" />
                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                      <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                          <small>Vehicle No</small>
                                      </label>
                                      <div class="col-12 col-sm-9">
                                          <InputText class="form-control form-control-sm rounded-3 w-100"
                                                     @bind-Value="LabourDcOutgoingVMs.VehicleNo" />
                                          <ValidationMessage For="@(() => LabourDcOutgoingVMs.VehicleNo)" />
                                      </div>
                                  </div>


                                     
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Transport From</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                               @bind-Value="LabourDcOutgoingVMs.TransFrom" />
                                        </div>
                                         <ValidationMessage For="@(() => LabourDcOutgoingVMs.TransFrom)" />
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Transport To</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                            @bind-Value="LabourDcOutgoingVMs.TransTo" />
                                        </div>
                                         <ValidationMessage For="@(() => LabourDcOutgoingVMs.TransTo)" />
                                    </div>

                                    <div class="accordion mb-3" id="transportAccordion">
                                        <div class="accordion-item border-0 shadow-sm rounded-3">
                                            <h2 class="accordion-header" id="headingTransport">
                                                <button class="accordion-button collapsed fw-semibold text-primary"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#collapseTransport"
                                                        aria-expanded="false"
                                                        aria-controls="collapseTransport">
                                                    <i class="bi bi-truck me-2"></i> E-way and  Transport Details
                                                </button>
                                            </h2>
                                            <div id="collapseTransport"
                                                 class="accordion-collapse collapse"
                                                 aria-labelledby="headingTransport"
                                                 data-bs-parent="#transportAccordion">
                                                <div class="accordion-body">

                                                     <!-- E-Way Bill No -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>E-Way Bill No</small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                            <InputText
                                                                    class="form-control form-control-sm rounded-3 w-100"
                                                                    @bind-Value="LabourDcOutgoingVMs.EwayNo" />
                                                        </div>
                                                    </div>

                                                    <!-- E-Way Bill Date -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>E-Way Bill Date</small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                            <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                                        @bind-Value="LabourDcOutgoingVMs.EwayDate" />
                                                        </div>
                                                    </div>

                                                     <!-- Transport ID -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>Transport ID</small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind-Value="LabourDcOutgoingVMs.TransId" />
                                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.TransId)" />
                                                        </div>
                                                    </div>

                                                    <!-- Transport Doc No. -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>Transport Doc No.</small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind-Value="LabourDcOutgoingVMs.TransDocNo" />
                                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.TransDocNo)" />
                                                        </div>
                                                    </div>

                                                    <!-- Transport Name -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>Transport Name</small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind-Value="LabourDcOutgoingVMs.TransName" />
                                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.TransName)" />
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        
                        <!-- =================== Dc Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                 <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Delivery Challan Details</span>

                                    @if (LabourDcOutgoingVMs.DcId > 0 && (CanCreate || CanEdit))
                                    {
                                        <div class="d-flex gap-2">
                                                <button type="button"
                                                        class="btn btn-sm rounded-3 @(LabourDcOutgoingVMs.DcCancel ? "btn-success" : "btn-danger")"
                                                        @onclick="Cancel">

                                                    @if (!LabourDcOutgoingVMs.DcCancel)
                                                    {
                                                        <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                                    }
                                                </button>
                                              <!-- Short Close / Re-Open -->
                                                <button type="button"
                                                    class="btn btn-sm rounded-3 @(LabourDcOutgoingVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                    @onclick="() => AskToShortCloseAsync(LabourDcOutgoingVMs)"
                                                    disabled="@LabourDcOutgoingVMs.DcCancel">

                                                    @if (!LabourDcOutgoingVMs.ShortClose)
                                                    {
                                                        <i class="bi bi-box-seam me-1"></i>
                                                        <span>Short Close</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                        <span>Re-Open</span>
                                                    }
                                                </button>
                                        </div>
                                    }
                                </div>

                                <div class="card-body">

                                       <div class="row g-2 mb-2 align-items-stretch">
                                            <div class="row g-3">

                                                   <!-- Manual Selection -->
                                                   <div class="col-12 col-sm-6">
                                                       <div class="card shadow-sm border-2 rounded-4 overflow-hidden
                                                           @(LabourDcOutgoingVMs.Manual || LabourDcOutgoingVMs.ReceivedReturnRM
                                                               ? "border-success bg-success-subtle"
                                                               : "border-light")
                                                           @(LabourDcOutgoingVMs.DcId > 0 || LabourDcOutgoingVMs.ReceivedReturnRM
                                                               ? "opacity-75"
                                                               : "")"

                                                            style="
                                                               cursor:@(LabourDcOutgoingVMs.DcId > 0 || LabourDcOutgoingVMs.ReceivedReturnRM
                                                                   ? "not-allowed"
                                                                   : "pointer");
                                                               min-height:65px;
                                                               transition:0.2s ease-in-out;"

                                                            @onclick="(LabourDcOutgoingVMs.DcId > 0 || LabourDcOutgoingVMs.ReceivedReturnRM)
                                                                   ? null
                                                                   : (() => ToggleManualSelection(true))">

                                                           <div class="card-body d-flex align-items-center justify-content-center py-2 px-3">

                                                               <i class="bi fs-5
                                                                   @(LabourDcOutgoingVMs.Manual
                                                                       ? "bi-check-circle-fill text-success"
                                                                       : "bi-circle text-secondary") me-2">
                                                               </i>

                                                               <span class="fw-semibold
                                                                   @(LabourDcOutgoingVMs.Manual
                                                                       ? "text-success"
                                                                       : "text-dark")">

                                                                   Manual Selection
                                                               </span>
                                                           </div>
                                                       </div>
                                                   </div>

                                                   @if (IsPoWiseLabDcOut)
                                                   {
                                                       <!-- Without PO -->
                                                       <div class="col-12 col-sm-6">
                                                           <div class="card shadow-sm border-2 rounded-4 overflow-hidden
                                                               @(LabourDcOutgoingVMs.WithoutPoDc
                                                                   ? "border-warning bg-warning-subtle"
                                                                   : "border-light")
                                                               @(LabourDcOutgoingVMs.DcId > 0
                                                                   ? "opacity-75"
                                                                   : "")"

                                                                style="
                                                                   cursor:@(LabourDcOutgoingVMs.DcId > 0
                                                                       ? "not-allowed"
                                                                       : "pointer");
                                                                   min-height:65px;
                                                                   transition:0.2s ease-in-out;"

                                                                @onclick="LabourDcOutgoingVMs.DcId > 0
                                                                       ? null
                                                                       : (() => ToggleIsWithoutPoDc(true))">

                                                               <div class="card-body d-flex align-items-center justify-content-center py-2 px-3">

                                                                   <i class="bi fs-5
                                                                       @(LabourDcOutgoingVMs.WithoutPoDc
                                                                           ? "bi-check-circle-fill text-warning"
                                                                           : "bi-circle text-secondary") me-2">
                                                                   </i>

                                                                   <span class="fw-semibold
                                                                       @(LabourDcOutgoingVMs.WithoutPoDc
                                                                           ? "text-warning"
                                                                           : "text-dark")">

                                                                       Without PO
                                                                   </span>
                                                               </div>
                                                           </div>
                                                       </div>
                                                   }

                                               </div>
                                        </div>
                                       
                                        <div class="row mb-2">
                                            <div class="col-12 d-flex justify-content-end">
                                                <div class="form-check d-flex align-items-center gap-2">
                                                        <input type="checkbox"
                                                            class="form-check-input"
                                                            style="border:2px solid #000;"
                                                            @bind="LabourDcOutgoingVMs.IsManualDcNo" @onclick="()=>ToggleAutoDcNo()" readonly="@LabourDcOutgoingVMs.DcId>0" />
                   
                                                    <label class="form-check-label text-dark">
                                                        <small>Is Manual Dc No.</small>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                     <!-- Dc No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Dc No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm flex-wrap w-100">
                                                <input type="text"
                                                       class="form-control form-control-sm rounded-start"
                                                       placeholder="Prefix"
                                                       maxlength="10"
                                                       @bind="LabourDcOutgoingVMs.Prefix" />

                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="Dc No."
                                                       @bind="LabourDcOutgoingVMs.DcNo" readonly="@IsDcNoReadonly"/>

                                                <span class="input-group-text rounded-end">@LabourDcOutgoingVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.Prefix)" />
                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.DcNo)" />
                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.Suffix)" />
                                        </div>
                                    </div>
                                        <!-- Dc Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
