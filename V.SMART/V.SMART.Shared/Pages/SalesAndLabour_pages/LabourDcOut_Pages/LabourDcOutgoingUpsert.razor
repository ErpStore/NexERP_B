    private async Task CancelEdit(LabourDcOutgoingSubVM? item, LabourDcOutgoingVM? parentDc)
    {
        try
        {
            if (item == null || parentDc == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (item.Qty.GetValueOrDefault() <= 0) ||
                (item.UnitPrice <= 0);

            if (isEmptyOrInvalid)
            {
                parentDc.LabourDcOutgoingSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for DcSubId: {item?.DcSubId}");
            await _JS.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(LabourDcOutgoingSubVM item)
    {
        try
        {
            if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Count == 1 && item.DcSubId > 0)
            {
                await _JS.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if (item.Qty.GetValueOrDefault() != item.BalQty && item.TransType=="Out")
            {
                await _JS.ToastrWarning("This row cannot be deleted because some transactions are done.");
                return;
            }
            if(item.ItemCancel)
            {
                await _JS.ToastrWarning("This row cannot be deleted because Item Cancellation are done.");
                return;

            }
            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if(!string.IsNullOrEmpty(LabourDcOutgoingVMs.EwayNo))
            {
                await _JS.ToastrWarning("This Item cannot be delete because Eway transactions are done.");
                return;
            }

            if(LabourDcOutgoingVMs.Manual)
            {
                int OutCount = LabourDcOutgoingVMs.LabourDcOutgoingSubVMs
                 .Count(x => x.TransType?.Equals("Out", StringComparison.OrdinalIgnoreCase) == true);

                int inCount = LabourDcOutgoingVMs.LabourDcOutgoingSubVMs
                     .Count(x => x.TransType?.Equals("In", StringComparison.OrdinalIgnoreCase) == true);


                bool hasMoreThanOneIn = inCount > 1;

                bool hasMoreThanOneOut = OutCount > 1;

                if (item.TransType == "Out")
                {
                    if (!hasMoreThanOneOut)
                    {
                        await _JS.ToastrError("At least one OUT item are required.");
                        return;
                    }

                }
                else
                {
                    if (!hasMoreThanOneIn)
                    {
                        await _JS.ToastrError("At least one IN  item are required.");
                        return;
                    }

                }

            }

            if (item.ItemId == 0)
            {
                LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Remove(item);
                await _JS.ToastrSuccess("New item row removed successfully.");

                await ResetSlno();
                StateHasChanged();
                return;
            }
            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for DcSubId: {item?.DcSubId}");
            await _JS.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in LabourDcOutgoingVMs.LabourDcOutgoingSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _JS.ToastrError("Failed to reset row serial numbers.");
        }
    }

