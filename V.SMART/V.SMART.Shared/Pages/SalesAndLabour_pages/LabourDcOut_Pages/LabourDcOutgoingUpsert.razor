        await _JS.ToastrError("Error processing selected SCN Selected items.");
    }
}
 
 private async Task OnGRNDCSelectedAsync(List<Dictionary<string, object>> selectedItems)
 {
     if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs == null)
         LabourDcOutgoingVMs.LabourDcOutgoingSubVMs = new List<LabourDcOutgoingSubVM>();

     if (LabourSCNVMs.LabourSCNSubVMs == null)
         LabourSCNVMs.LabourSCNSubVMs = new List<LabourSCNSubVM>();

     int custid = LabourDcOutgoingVMs.CustId.Value;

     if (LabourDcOutgoingVMs.StoreIssId == 0)
     {
         await _JS.ToastrWarning("Please select Purchase Store");
         return;
     }
     int storeissueid = LabourDcOutgoingVMs.StoreIssId.Value;


     var selectedSCNIds = scns.Where(p => p.IsSelected).Select(p => p.SCNId).ToList();

     try
     {

         var itemIds = selectedItems
             .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
             .Select(i => Convert.ToInt32(i["ItemId"]))
             .ToList();

         decimal Price = 0, subdiscAmt = 0, qty = 0, totqty = 0,StockQty = 0;
         int i = 0;

         if (!LabourDcOutgoingVMs.ReceivedReturnRM)
         {
             foreach (var item in selectedItems)
             {
                 Price = 0; subdiscAmt = 0; qty = 0;

                 int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                     ? Convert.ToInt32(item["ItemId"])
                     : 0;

                 int? grnSubIdOut = item.ContainsKey("GRNSubId") && item["GRNSubId"] != null
                     ? Convert.ToInt32(item["GRNSubId"])
                     : (int?)null;

                 int? grnSubIdIn = item.ContainsKey("GRNSubIdIn") && item["GRNSubIdIn"] != null
                      ? Convert.ToInt32(item["GRNSubIdIn"])
                      : (int?)null;

                 int? categorycode = item.ContainsKey("CategoryCode") && item["CategoryCode"] != null
                     ? Convert.ToInt32(item["CategoryCode"])
                     : (int?)null;


                 if (item.TryGetValue("BalQty", out var QtyObj))
                     decimal.TryParse(QtyObj?.ToString(), out qty);

                 if (item.TryGetValue("UnitPrice", out var unitpriceObj))
                     decimal.TryParse(unitpriceObj?.ToString(), out Price);

                 if (item.TryGetValue("TotalQty", out var TotalQty))
                     decimal.TryParse(TotalQty?.ToString(), out totqty);

                 if (item.TryGetValue("Stock Qty", out var stkQtyObj))
                     decimal.TryParse(stkQtyObj?.ToString(), out StockQty);

                 string suffix = item.TryGetValue("Suffix", out var Suffix) ? Suffix?.ToString() : string.Empty;


                 if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Any(x => x.ItemId == itemId && x.RefGRNSubId==grnSubIdOut))
                 {
                     continue;
                 }

                 var receivedData = await _dcService.GetReceivedQtyByScnIdsAsync(selectedSCNIds);

                 var ReceivedLookup = receivedData.GroupBy(x => x.ItemId).ToDictionary(g => g.Key, g => g.Sum(x => x.BalQty ?? 0));

                 decimal possibleQty = 0;

                 if(!LabourDcOutgoingVMs.Manual)
                 {


                     if (categorycode == 3 || categorycode == 7)
                     {
                         StockQty = await _dcService.GetStockForItemRcSubIdAsync(itemId,storeissueid,null);
                         var bomData = await _dcService.GetAssemblyItemsAsync(itemId);

                         decimal? minPossible = null;

                         foreach (var bom in bomData)
                         {
                             if (!ReceivedLookup.TryGetValue(bom.ItemId, out decimal receivedQty))
                                 continue;

                             if (bom.UtilQty <= 0)
                                 continue;

                             var possible = receivedQty / bom.UtilQty;

                             if (minPossible == null || possible < minPossible)
                                 minPossible = possible;
                         }

                         possibleQty = Math.Min(minPossible ?? 0, qty);
                     }
                     else if (categorycode == 2)
                     {

                         decimal weight = await _dcService.GetRawMaterialWeightAsync(itemId);

                         var compData = await _dcService.GetRawMaterialItemsAsync(itemId);

                         decimal? minPossible = null;

                         foreach (var com in compData)
                         {
                             if (!ReceivedLookup.TryGetValue(com.ItemId, out decimal receivedQty))
                                 continue;   

                             if (com.Weight <= 0)
                                 continue;

                             var possible = receivedQty / com.Weight;

                             if (minPossible == null || possible < minPossible)
                                 minPossible = possible;
                         }
                         possibleQty = Math.Min(minPossible ?? 0, qty);


                     }

                 }
                 else
                 {
                     possibleQty = qty;
                 }

                 var subVm = new LabourDcOutgoingSubVM();
                 subVm.TransType = "Out";
                 subVm.ItemId = itemId;
                 subVm.ItemCode = item.TryGetValue("ItemCode", out var itemCode) ? itemCode?.ToString() : string.Empty;
                 subVm.ItemName = item.TryGetValue("ItemName", out var itemName) ? itemName?.ToString() : string.Empty;
                 subVm.Specification = item.TryGetValue("Specification", out var Specification) ? Specification?.ToString() : string.Empty;
                 subVm.MeasureUnit = item.TryGetValue("UOM", out var uom) ? uom?.ToString() : string.Empty;
                 subVm.HSNCode = item.TryGetValue("HSNCode", out var hsn) ? hsn?.ToString() : string.Empty;
                 subVm.Category = item.TryGetValue("Category", out var Category) ? Category?.ToString() : string.Empty;
                 subVm.Qty = possibleQty;
                 subVm.BalQty = possibleQty;
                 subVm.UnitPrice = Price;
                 subVm.CostId = item.TryGetValue("CostCenterId", out var costId) && int.TryParse(costId?.ToString(), out var parsedCostId) && parsedCostId != 0 ? parsedCostId : (int?)null;
                 subVm.ProjectNo = item.TryGetValue("ProjectNo", out var projectNo) ? projectNo?.ToString() : string.Empty;

                 subVm.StockQty = StockQty;
                 subVm.PossibleQty = possibleQty;
                 subVm.RefGRNSubId = grnSubIdOut;
                 subVm.RefGRNNo = item.TryGetValue("GRNNo", out var GRNNo) ? GRNNo?.ToString() + "" + (GRNNo == null ? "" : Suffix) : string.Empty;
                 subVm.RefGRNDate = item.TryGetValue("GRNDate", out var GRNDate) && DateTime.TryParse(GRNDate?.ToString(), out var parsedGRNDate) ? parsedGRNDate : (DateTime?)null;

                 subVm.RefDcNo = item.TryGetValue("RefDcNo", out var RefDcNo) ? RefDcNo?.ToString() : string.Empty;
                 subVm.RefDcDate = item.TryGetValue("RefDcDate", out var RefDcDate) && DateTime.TryParse(RefDcDate?.ToString(), out var parsedDcDate) ? parsedDcDate : (DateTime?)null;
                 subVm.GRNSubIdIn = grnSubIdIn.Value;
                 subVm.IsEditable = true;

                 LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Add(subVm);


             }

         }
         // var ReceivedLookup = receivedData.GroupBy(x => x.ItemId).ToDictionary(g => g.Key, g => g.Sum(x => x.BalQty ?? 0));

         var receivedDatas = selectedSCNIds.Any() ? await _dcService.GetLabourSCNQtyByReceivedIdsAsync(selectedSCNIds) : new List<LabourSCNSubVM>();

         
        if(LabourDcOutgoingVMs.ReceivedReturnRM)
        {
            receivedDatas = receivedDatas
                .Where(x => itemIds.Contains(x.ItemId ?? 0))
                .ToList();
        }

         var itemIdss = receivedDatas
             .Where(x => x.ItemId.HasValue)
             .Select(x => x.ItemId.Value)
             .Distinct()
             .ToList();

         var stockDict = await _stockManagerService
             .GetStockForItemsAsync(itemIdss, storeissueid);

         // If Its Manual
         if(LabourDcOutgoingVMs.Manual)
         {

             if (receivedDatas != null && receivedDatas.Any())
             {
                 List<LabourSCNSubVM> receivedData;

                 if (LabourDcOutgoingVMs.SCNRejectReworkReturn)
                 {
                     receivedData = await _dcService.GetReceivedQtyreturnByScnIdsAsync(selectedSCNIds);
                 }
                 else
                 {
                     receivedData = await _dcService.GetReceivedQtyByScnIdsAsync(selectedSCNIds);
                 }


                 var receivedLookup = receivedData
                     .GroupBy(x => x.ItemId)
                     .ToDictionary(g => g.Key, g => g.Sum(x => x.BalQty ?? 0));

                 foreach (var item in selectedItems)
                 {
                     int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                         ? Convert.ToInt32(item["ItemId"])
                         : 0;

                     int? poSubId = item.ContainsKey("RefPoSubId") && item["RefPoSubId"] != null
                         ? Convert.ToInt32(item["RefPoSubId"])
                         : (int?)null;

                     int? categoryCode = item.ContainsKey("CategoryCode") && item["CategoryCode"] != null
                         ? Convert.ToInt32(item["CategoryCode"])
                         : (int?)null;


                     List<int> allowedItemIds = new();
                     if(!LabourDcOutgoingVMs.ReceivedReturnRM)
                     {


                         if (categoryCode == 3 || categoryCode == 7) 
                         {
                             var bomData = await _dcService.GetAssemblyItemsAsync(itemId);

                             if(bomData.Any())
                                 allowedItemIds = bomData.Select(x => x.ItemId.Value).ToList();
                         }
                         else if (categoryCode == 2) 
                         {
                             var compData = await _dcService.GetRawMaterialItemsAsync(itemId);

                             if(compData.Any())
                                 allowedItemIds = compData.Select(x => x.ItemId).ToList();
                         }
                     }
                     // else
                     // {

                     //     allowedItemIds.Add(itemId);
                     // }

                     var filteredReceived = !allowedItemIds.Any()
                            ? receivedDatas.ToList()   
                            : receivedDatas
                                .Where(r => r.ItemId.HasValue && allowedItemIds.Contains(r.ItemId.Value))
                                .ToList();


                     // var filteredReceived = receivedDatas
                     //     .Where(r => r.ItemId.HasValue && allowedItemIds.Contains(r.ItemId.Value))
                     //     .ToList();

                     ////////////////////////////////
                     ///
                     foreach (var outItem in receivedDatas)
                     {
                         if (LabourDcOutgoingVMs.LabourDcOutgoingSubVMs
                             .Any(x => x.ItemId == outItem.ItemId && x.RefSCNSubId == outItem.SCNSubId))
                             continue;

                         stockDict.TryGetValue(outItem.ItemId??0, out decimal stockQty);

                         Decimal? stockqty = await _dcService.GetStockForItemRcSubIdAsync(outItem.ItemId??0,storeissueid,null);

                         string? TransType = "";

                         var outVm = new LabourDcOutgoingSubVM()
                                             {
                                                 RefSCNSubId = outItem.SCNSubId,
                                                 ItemId = outItem.ItemId??0,
                                                 ItemCode = outItem.ItemCode,
                                                 ItemName = outItem.ItemName,
                                                 MeasureUnit = outItem.MeasureUnit,
                                                 UnitPrice=outItem.UnitPrice,
                                                 HSNCode=outItem.HSNCode,

                                                 ProjectNo = outItem.ProjectNo,
                                                 IsEditable = false
                                             };

                         if(LabourDcOutgoingVMs.ReceivedReturnRM)
                         {
                             TransType = "Out";
                             outVm.TransType = TransType;
                             if(LabourDcOutgoingVMs.SCNRejectReworkReturn)
                             {
                                     outVm.BalQty = outItem.SCNBalQty??0;
                                     outVm. Qty = outItem.SCNBalQty;
                                     outVm.PossibleQty = outItem.SCNBalQty;
                             }
                             else
                             {
                                     outVm.BalQty = outItem.BalQty??0;
                                     outVm. Qty = outItem.BalQty;
                                     outVm.PossibleQty = outItem.BalQty ;

                             }
                           
                             outVm.StockQty = stockqty??0;
                         }
                         else
                         {
                             TransType = "In";
                             outVm.TransType = TransType;
                             outVm.Qty = outItem.BalQty;
                             outVm.PossibleQty = outItem.BalQty;
                         }

                         LabourDcOutgoingVMs.LabourDcOutgoingSubVMs.Add(outVm);
                     }

                 }
             }
         }


         int slNo = 1;
         foreach (var row in LabourDcOutgoingVMs.LabourDcOutgoingSubVMs)
         {
             row.SlNo = slNo++;
         }

         StateHasChanged();

     }
     catch (Exception ex)
     {
         await LoggingService.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
         await _JS.ToastrError("Error processing selected SCN Selected items.");
     }
 }


