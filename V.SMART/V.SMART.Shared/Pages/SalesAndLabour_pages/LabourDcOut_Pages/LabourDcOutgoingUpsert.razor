                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@LabourDcOutgoingVMs.DcDate" />
                                            <ValidationMessage For="@(() => LabourDcOutgoingVMs.DcDate)" />
                                        </div>
                                    </div>

                                   @if (IsPoWiseLabDcOut)
                                  {
                                       <!-- PO Details -->
 
  
                                      <div class="row g-2">

                                          <!-- LEFT : PO LIST -->
                                          <div class="col-6">

                                                <div class="d-flex align-items-center gap-2 mb-1">

                                                    <!-- Search -->
