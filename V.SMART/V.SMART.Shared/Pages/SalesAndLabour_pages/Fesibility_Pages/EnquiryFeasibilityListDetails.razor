@page "/enquiryFeasibiltyDetails/{FesId:int}"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ISalesService.IEnquiryFesibility
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.FeasibilityVM

@inherits BaseUserRightsComponent

@inject IEnqiryFeasibilityService _enquiryFeasibility
@inject IJSRuntime _js
@inject ILoggingService LoggingService
@inject ReportService reportService

@inject NavigationManager _navigationManager

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
        return;
    }
    else
    {
       <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

        <!-- Company Details Section -->
        <MyCompanyDetails/>

        <hr class="border-2 border-primary-subtle mb-4" />
        <div class="text-center">
            <h4 class="fw-semibold mt-3">EnquiryFeasibility Details</h4>
        </div>

        <hr class="border-2 border-primary-subtle mb-4" />

        <!-- Customer & Document Info -->
        <div class="row g-3 mb-4">
            <!-- Customer Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Customer Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Reference Enquiry No.:</strong></td><td>@(!string.IsNullOrEmpty(EnquiryFeasibilityVM?.RefEnqNo) ? EnquiryFeasibilityVM.RefEnqNo : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Reference Enquiry Date.:</strong></td><td>@(EnquiryFeasibilityVM?.RefEnqDate != null ? EnquiryFeasibilityVM.RefEnqDate.ToString("dd/MM/yyyy") : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Name:</strong></td><td>@(!string.IsNullOrEmpty(EnquiryFeasibilityVM?.CustomerName) ? EnquiryFeasibilityVM.CustomerName : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Address:</strong></td><td>@(!string.IsNullOrEmpty(EnquiryFeasibilityVM?.CustomerAddress) ? EnquiryFeasibilityVM.CustomerAddress : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.:</strong></td><td>@(!string.IsNullOrEmpty(EnquiryFeasibilityVM?.CustomerGSTNO) ? EnquiryFeasibilityVM.CustomerGSTNO : "N/A")</td></tr>
                                <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.:</strong></td><td>@(!string.IsNullOrEmpty(EnquiryFeasibilityVM?.CustomerPhoneNo) ? EnquiryFeasibilityVM.CustomerPhoneNo : "N/A")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Document Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Document Details
                    </div>

                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>EnquiryFeasibility No.</strong></td>
                                    <td>@(EnquiryFeasibilityVM != null ? $"{EnquiryFeasibilityVM.FesNo}{EnquiryFeasibilityVM.Suffix}" : "N/A")</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>EnquiryFeasibility Date:</strong></td>
                                    <td>@(EnquiryFeasibilityVM != null ? $"{EnquiryFeasibilityVM.FesDate}" : "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Reference Quote No.:</strong></td>
                                    <td>@(EnquiryFeasibilityVM != null ? $"{EnquiryFeasibilityVM.QuotRefNo}" : "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>PreparedBy:</strong></td>
                                    <td>@(EnquiryFeasibilityVM != null ? $"{EnquiryFeasibilityVM.PreparedBy}" : "N/A")</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Enquiry Items -->
        <div class="card border-1 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                Enquiry Items
            </div>

            <div class="table-responsive" style="overflow-x:auto;">
                <table class="table table-bordered table-sm align-middle mb-0" style="table-layout: fixed; min-width: 1700px;">
                    <thead class="custom-blue">
                        <tr>
                            <th>Sl No.</th>
                            <th>Item Code</th>
                            <th>Description</th>
                            <th>UOM</th>
                            <th>HSN</th>
                            <th>Type Of Project</th>
                            <th>Tool Requirement</th>
                            <th>Special Requirement (OutSourcing)</th>
                            <th>Technical Capabilities</th>
                            <th>Delivery Terms</th>
                            <th>Man Hr Requirement</th>
                            <th>Risk If Any</th>
                            <th>Special Requirement (Customer)</th>
                            <th>Remarks</th>
                            <th>Capability Confirmation</th>
                        </tr>
                    </thead>
                    <tbody class="custom-size">
                        @if (EnquiryFeasibilityVM?.EnquiryFeasibilitySubVM != null && EnquiryFeasibilityVM.EnquiryFeasibilitySubVM.Any())
                        {
                            @foreach (var item in EnquiryFeasibilityVM.EnquiryFeasibilitySubVM)
                            {
                                <tr>
                                    <td class="text-center">@item.SlNo</td>
                                    <td>@(item.ItemCode ?? "—")</td>
                                    <td>@(item.ItemName ?? "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.UOM) ? item.UOM : "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.HSNCode) ? item.HSNCode : "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.TypeOfProject) ? item.TypeOfProject : "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.ToolRequired) ? item.ToolRequired : "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.SpclReqOutsource) ? item.SpclReqOutsource : "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.TechCapaBilities) ? item.TechCapaBilities : "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.DelvryTrms) ? item.DelvryTrms : "—")</td>
                                    <td class="text-center">@(item.ManHrReq)</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.RiskIfAny) ? item.RiskIfAny : "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.SpclReqCustomer) ? item.SpclReqCustomer : "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.Remarks) ? item.Remarks : "—")</td>
                                    <td class="text-center">@(!string.IsNullOrEmpty(item.CompbltyConfm) ? item.CompbltyConfm : "—")</td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">No items found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Notes -->
        <div class="card border-1 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-warning-subtle text-primary fw-semibold">
                Notes / Remarks
            </div>
            <div class="card-body small">
                <p class="mb-0">@(string.IsNullOrWhiteSpace(EnquiryFeasibilityVM.Remark) ? "No remarks provided." : EnquiryFeasibilityVM.Remark)</p>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2 justify-content-end">
            <a href="/enquiryfeasibility" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back To List
            </a>
            <a href="@($"/enquiryfeasibility/update/{FesId}")" class="btn btn-outline-primary">
                <i class="bi bi-pencil-square"></i> Modify
            </a>
            <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                <i class="bi bi-printer"></i> Print
            </button>
        </div>
    </div>
    }
}

@code
{
    protected override string ScreenName => "Enquiry Feasibility";
    [Parameter]
    public int FesId { get; set; }
    string? pdfBase64;
    public bool isProcessing { get; set; } = true;

    private EnquiryFeasibilityVM EnquiryFeasibilityVM { get; set; } = new EnquiryFeasibilityVM();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            
            await GetDetails();
           
        }
        catch(Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync() EnquiryFeasibility");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task GetDetails()
    {
        try
        {
            if (FesId > 0)
            {
                var existEnquiryFeasibility = await _enquiryFeasibility.GetEnquiryFeasibilityDetailsByFesIdAsync(FesId);
                if (existEnquiryFeasibility != null)
                {
                    EnquiryFeasibilityVM = existEnquiryFeasibility;
                }
            }
        }
        catch(Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GetDetails() EnquiryFeasibility");
            await _js.ToastrError("An unexpected error occurred while loading GetDetails() in EnquiryFeasibility.");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            pdfBase64 = null;
            var pdfBytes = await reportService.Generate_Report(FesId, "EnquiryFeasibility.frx", "FesId", false, ScreenName, "Sp_Print_EnquiryFeasibility");
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf EnquiryFeasibility");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in EnquiryFeasibility.");
        }
    }
}
