                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(LabInvVMs?.ShippingAddress) ? LabInvVMs.ShippingAddress : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(LabInvVMs?.ShippingGstin) ? LabInvVMs.ShippingGstin : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(LabInvVMs?.ShippingContactNo) ? LabInvVMs.ShippingContactNo : "N/A")</td></tr>
                                </tbody>
