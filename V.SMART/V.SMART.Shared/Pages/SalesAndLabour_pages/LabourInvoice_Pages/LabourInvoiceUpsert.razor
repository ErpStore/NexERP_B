    #region UpsertLabourInvoice Operations

    private async Task UpsertLabourInvoice()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            LabourInvoiceVM.LabourInvoiceSubVM.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!LabourInvoiceVM.LabourInvoiceSubVM.Any())
            {
                await _js.ToastrError("Cannot save a Labour Invoice without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in LabourInvoiceVM.LabourInvoiceSubVM)
            {
                bool isValid = await ValidateLabInvLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewQuote = LabourInvoiceVM.LabInvId== 0;

            try
            {
                await _LabourInvoiceService.UpsertLabourInvoiceAsync(LabourInvoiceVM);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewQuote)
                await _js.ToastrSuccess("Labour Invoice saved successfully.");
            else
                await _js.ToastrSuccess("Labour Invoice  updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/LabourInvoiceList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertLabourInvoice failed.");
            await _js.ToastrError("Error saving Labour Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateLabInvLineAsync(LabInvSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Unit Price must be greater than 0.");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            if (line.LabInvSubId == 0 && line.RefDcSubId > 0)
            {
                var enqBalQty = await _LabourInvoiceService.GetLabourdcOutItemBalQtyFromEnqSubId(line.RefDcSubId.Value);
                if (line.Qty > enqBalQty)
                {
                    line.Qty = enqBalQty;
                    line.BalQty = enqBalQty;
                    line.CrBalQty = enqBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed Enquiry Balance Qty ({enqBalQty}).");
                    return false;
                }
            }
            else if (line.LabInvSubId > 0)
            {
                bool exist = false;
                exist = await _LabourInvoiceService.HasAnyItemOrInvoiceCreditNoteAsync(line.LabInvSubId);
                if (exist)
                {
                    await _js.ToastrWarning("Cannot modify this invoice. Credit Note already exists for this invoice or its items.");
                    return false;
                }
                

                var original = await _LabourInvoiceService.GetInvoiceSubItemDetailByinvoiceSubIdAsync(line.LabInvSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty ?? 0m;
                    decimal origQty = original.Qty ?? 0m;
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        line.CrBalQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                        line.CrBalQty = line.BalQty;
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateQuoteLineAsync failed.");
            await _js.ToastrError("Error validating Labour Invoice line.");
            return false;
        }
    }

