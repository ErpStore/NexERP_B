    private async Task OnDcSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (LabourInvoiceVM.LabourInvoiceSubVM == null)
            LabourInvoiceVM.LabourInvoiceSubVM = new List<LabInvSubVM>();

        int custId = LabourInvoiceVM.CustId;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            var priceDict = await _LabourInvoiceService.GetBulkLastUnitPricesAsync(itemIds, custId ) ;
           var LabourCost = await _CostingService.GetBulkLabourCostsAsync(itemIds);


            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefDcSubId = item.ContainsKey("RefDcSubId") && item["RefDcSubId"] != null
                    ? Convert.ToInt32(item["RefDcSubId"])
                    : (int?)null;
                  

                decimal preSetUnitPrice = await _LabourInvoiceService.GetBulkLastUnitPricesItemIdAsync(itemId, custId , RefDcSubId ??0) ;

                decimal finalUnitPrice = preSetUnitPrice > 0 
                                ? preSetUnitPrice 
                                : (priceDict.TryGetValue(itemId, out var price) ? price : 0);

                if (LabourInvoiceVM.LabourInvoiceSubVM.Any(x => x.ItemId == itemId && x.RefDcSubId == RefDcSubId))
                    continue;

                var subVm = new LabInvSubVM
                {
                    RefDcSubId = RefDcSubId,
                    RefDcNo = item.ContainsKey("DcNo") ? item["DcNo"]?.ToString() : "",
                    RefDcDate = item.ContainsKey("DcDate") && item["DcDate"] != null
                        ? Convert.ToDateTime(item["DcDate"])
                        : null,
                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    SACCode  = item.ContainsKey("SACCode") ? item["SACCode"]?.ToString() : "",
                    MeasureUnit  = item.ContainsKey("UOM") ? item["UOM"]?.ToString() : "",
                    LabourCost=LabourCost.TryGetValue(itemId,out var Labourprice)? Labourprice : 0m,
                    // "DC Qty","Invoice Qty"
                    Qty = item.ContainsKey("BalQty") && item["BalQty"] != null ? Convert.ToInt32(item["BalQty"]) : 0,
                    BalQty = item.ContainsKey("BalQty") && item["BalQty"] != null ? Convert.ToInt32(item["BalQty"]) : 0,
                    CrBalQty=item.ContainsKey("BalQty") && item["BalQty"] != null ? Convert.ToInt32(item["BalQty"]) : 0,
                    UnitPrice = finalUnitPrice,
                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,
                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",
                    RefPoNo = item.ContainsKey("RefPoNo") 
                        ? item["RefPoNo"]?.ToString() 
                        : "",

                    RefPoDate =  item.ContainsKey("RefPoDate") && item["RefPoDate"] != null
                            ? Convert.ToDateTime(item["RefPoDate"])
                            : null,

                    LineNo =item.ContainsKey("LineNo") && item["LineNo"] != null ? Convert.ToInt32(item["LineNo"]) : 0,

                    CreditNos = new List<string>(),    
                    CreditDates = new List<DateTime>(),

                    IsEditable = false
                };

                LabourInvoiceVM.LabourInvoiceSubVM.Add(subVm);
                var taxDetailVM= await _LabourInvoiceService.GetPoTaxDataByRefDcSubIdAsync(RefDcSubId??0);
               await BindPoTaxToInvoice(subVm, LabourInvoiceVM, taxDetailVM);
             
                await _calculationService.UpdateTotalsAsync(LabourInvoiceVM);
            }

            int slNo = 1;
            foreach (var row in LabourInvoiceVM.LabourInvoiceSubVM)
            {
                row.SlNo = slNo++;
            }
            if(IsLabourCost)
            {
                 foreach (var subVm in LabourInvoiceVM.LabourInvoiceSubVM)
                   {
       
                         if (subVm.UnitPrice < subVm.LabourCost)
                         {
                             _js.ToastrWarning($"Unit Price ({subVm.UnitPrice:0.00}) Is less than Labour Cost ({subVm.LabourCost:0.00})." );
                         }
                         else if(subVm.UnitPrice > subVm.LabourCost)
                         {
                                 _js.ToastrWarning($"Unit Price ({subVm.UnitPrice:0.00}) Is  Greater than than Labour Cost ({subVm.LabourCost:0.00})."     );

                         }

                   }
             }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnDcSelectedAsync failed.");
            await _js.ToastrError("Error processing selected labour Invoice Dc Details items.");
        }
    }

