    private async Task<IEnumerable<Process>> SearchProcess(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3) 
            return Enumerable.Empty<Process>();

        try
        {
            var results = await _LabourInvoiceService.SearchProcessAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<Process>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<Process>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchCustomers failed for value: {value}");
            await _js.ToastrError("Failed to search customers. Please try again.");
            return Enumerable.Empty<Process>();
        }
    }
    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(LabInvId.GetValueOrDefault(), "LabInvoice.frx", "LabInvId", LabourInvoiceVM.InvCancel, "Labour Invoice", "Sp_Print_LabourInv");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Labour Delivery Challan");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Labour Delivery Challan.");
        }
        finally
        {
            isProcessing = false;
        }
    }

}