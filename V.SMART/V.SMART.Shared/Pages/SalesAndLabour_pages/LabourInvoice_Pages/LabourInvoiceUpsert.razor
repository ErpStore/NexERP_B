    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, LabInvSubVM SubVM)
    {
        try
        {
            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                SubVM.CrBalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW quote line
            if (SubVM.LabInvSubId == 0)
            {
                if (SubVM.RefDcSubId > 0)
                {
                    var enqBalQty = await _LabourInvoiceService.GetLabourdcOutItemBalQtyFromEnqSubId(SubVM.RefDcSubId.Value);

                    if (newQty <= enqBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                        SubVM.CrBalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = enqBalQty;
                        SubVM.BalQty = enqBalQty;
                        SubVM.CrBalQty = enqBalQty;
                        await _js.ToastrWarning($"Qty can't be greater than Enquiry Balance Qty ({enqBalQty}).");
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty;
                    SubVM.CrBalQty = newQty;
                }
            }
            // EXISTING quote line
            else
            {
                var original = await _LabourInvoiceService.GetInvoiceSubItemDetailByinvoiceSubIdAsync(SubVM.LabInvSubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.BalQty = 0;
                    SubVM.CrBalQty = 0;
                    await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefDcSubId > 0)
                {
                    var enqBalQty = await _LabourInvoiceService.GetLabourdcOutItemBalQtyFromEnqSubId(SubVM.RefDcSubId.Value);
                    var maxAllowedQty = original.Qty + enqBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty - alreadyTransacted;
                        SubVM.CrBalQty = SubVM.BalQty;
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                        SubVM.CrBalQty = SubVM.BalQty;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted;
                    SubVM.CrBalQty = SubVM.BalQty;
                }
            }
            await _calculationService.UpdateTotalsAsync(LabourInvoiceVM);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for LabInvSubId: {SubVM?.RefDcSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

