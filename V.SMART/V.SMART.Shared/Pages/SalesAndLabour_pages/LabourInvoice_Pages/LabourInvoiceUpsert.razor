        }
    }

    private async Task CancelEdit(LabInvSubVM? item, LabInvVM? parentLabInv)
    {
        try
        {
            if(item == null || parentLabInv == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentLabInv.LabourInvoiceSubVM.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for LabInvSubId: {item?.LabInvSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(LabInvSubVM item)
    {
        try
        {
            if (LabourInvoiceVM.LabourInvoiceSubVM.Count == 1 && item.LabInvSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if ((item.Qty ?? 0) != (item.BalQty ?? 0))
            {
                await _js.ToastrWarning("This row cannot be deleted because some transactions are done.");
                return;
            }

            bool exist = false;

            exist = await _LabourInvoiceService.HasAnyItemOrInvoiceCreditNoteAsync(item.LabInvSubId);
            if (exist)
            {
                await _js.ToastrWarning("Cannot delete this invoice. Credit Note already exists for this invoice or its items.");
                return;
            }



            if (item.ItemId == 0)
            {
                LabourInvoiceVM.LabourInvoiceSubVM.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!LabourInvoiceVM.LabourInvoiceSubVM.Any())
                    LabourInvoiceVM.LabourInvoiceSubVM = new List<LabInvSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(LabourInvoiceVM);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for LabInvSubId: {item?.LabInvSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in LabourInvoiceVM.LabourInvoiceSubVM)
