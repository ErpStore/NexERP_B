    private async Task CancelInvoice()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!LabourInvoiceVM.InvCancel)
            {
                LabourInvoiceVM.InvCancel = true;
                LabourInvoiceVM.CancelDate = DateTime.Now;
                LabourInvoiceVM.CancelReason = cancelReason;

                LabourInvoiceVM.CanceledBy = username;

                await _LabourInvoiceService.UpdatedCancelStatusAndAddOrRevertQty(LabourInvoiceVM);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Labour Invoice",
                    action: $"Cancelled Labour Invoice: {LabourInvoiceVM.LabInvNo}",
                    additionalInfo: $"Labour Invoice Id: {LabourInvoiceVM.LabInvId}"
                );

                await _js.ToastrSuccess("Labour Invoice cancelled successfully.");
            }
            else
            {
                LabourInvoiceVM.InvCancel = false;
                LabourInvoiceVM.CancelDate = null ;
                LabourInvoiceVM.CancelReason = string.Empty;

                await _LabourInvoiceService.UpdatedCancelStatusAndAddOrRevertQty(LabourInvoiceVM);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Labour Invoice",
                    action: $"Reverted Labour Invoice: {LabourInvoiceVM.LabInvNo}",
                    additionalInfo: $"Labour Invoice Id: {LabourInvoiceVM.LabInvId}"
                );

                await _js.ToastrSuccess("Quotation has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"CancelInvoice failed for QuoteId: {LabourInvoiceVM.LabInvId}");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the quotation.");
            await LoggingService.LogDeveloperError(ex, $"CancelInvoice failed for QuoteId: {LabourInvoiceVM.LabInvId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.LabInvSubId > 0)
            {
                await _LabourInvoiceService.DeleteAndResequenceAsync(rowToDelete, LabourInvoiceVM);

                LabourInvoiceVM.LabourInvoiceSubVM = await _LabourInvoiceService.GetLabourInvSubByInvIdAsync(LabourInvoiceVM.LabInvId);
            }
            else
            {
                LabourInvoiceVM.LabourInvoiceSubVM.Remove(rowToDelete);

                if (!LabourInvoiceVM.LabourInvoiceSubVM.Any())
                {
                    LabourInvoiceVM.LabourInvoiceSubVM.Add(new LabInvSubVM
                    {
                        LabInvId = LabourInvoiceVM.LabInvId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < LabourInvoiceVM.LabourInvoiceSubVM.Count; i++)
                        LabourInvoiceVM.LabourInvoiceSubVM[i].SlNo = i + 1;
                }
            }

            await _calculationService.UpdateTotalsAsync(LabourInvoiceVM);

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for Labour Invoice Id: {LabourInvoiceVM.LabInvId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

