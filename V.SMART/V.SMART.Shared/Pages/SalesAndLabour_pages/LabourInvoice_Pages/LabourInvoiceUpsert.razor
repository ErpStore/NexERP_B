    private async Task BindPoTaxToInvoice( LabInvSubVM sub,  LabInvVM inv,  PoTaxDetailVM tax)
        {
            if (tax == null) return;

            sub.LineDiscountPercent = tax.LineDiscountPercent;
            sub.LineDiscountAmount  = tax.LineDiscountAmount;

            sub.LineCGSTRate = tax.LineCGSTRate;
            sub.LineSGSTRate = tax.LineSGSTRate;
            sub.LineIGSTRate = tax.LineIGSTRate;

            if (inv.LabourInvoiceSubVM.Count == 1)
            {
                inv.DiscAmtOrPer = tax.DiscAmtOrPer;
                inv.DiscountAmount  = tax.DiscountAmount;

                inv.PackingAmtOrPer   = tax.PackingAmtOrPer;
                inv.InsuranceAmtOrPer = tax.InsuranceAmtOrPer;

                inv.InsuranceCharges = tax.InsuranceCharges;
                inv.FreightCharges   = tax.FreightCharges;
                inv.OtherCharges = tax.OtherCharges;

                inv.TCSAmtOrPer = tax.TCSAmtOrPer;
                inv.TCSAmount   = tax.TCSAmount;

                inv.CGstRate = tax.CGstRate;
                inv.SGstRate = tax.SGstRate;
                inv.IGstRate = tax.IGstRate;
            }
        }

