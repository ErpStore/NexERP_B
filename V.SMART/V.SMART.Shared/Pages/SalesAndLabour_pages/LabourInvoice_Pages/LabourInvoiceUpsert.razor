@page "/LabourInvoice/create"
@page "/LabourInvoice/create/{CustId:int}"
@page "/LabourInvoice/update/{LabInvId:int}"

@using MudBlazor
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IEInvoiceAPI
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.LabourInvoiceVM

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject ILabourInvoiceService _LabourInvoiceService
@inject ILoggingService LoggingService
@inject ICostingService _CostingService

@inject IEinvoiceDatabaseService _einvoiceService
@inject ReportService reportService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js


<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">

</BsModal>
<DetailsModal Title="Dc Details"
              Columns="@DcColumns"
              ColumnFields="@DcFields"
              HiddenColumns="@DcHiddenColumns"
              Data="@DcData"
              IsVisible="@IsDcModalVisible"
              IsVisibleChanged="@((val) => IsDcModalVisible = val)"
              OnSelectedItems="OnDcSelectedAsync">
</DetailsModal>


<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isCustModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if(ActiveModal == "Terms")
    {
        <TermsUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
    else if (ActiveModal == "TDS")
    {
     <TDSEntryModal isDcListDetailsModelVisible=true CustId=@LabourInvoiceVM.CustId Customer=@LabourInvoiceVM.CustName DcType="LabourDc" OnClose="CloseModal" />
    }
</MasterModal>

<style>
    .freeze-last-col {
  position: sticky;
  right: 0;
  background-color: #f8f9fa;
  z-index: 10;
}
</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{

    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if ((LabourInvoiceVM?.InvCancel ?? false))
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (LabourInvoiceVM.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }

            <PageHeader TitleText="@(LabourInvoiceVM.LabInvId > 0 ? "Update Labour Invoice" : "Create Labour Invoice")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@LabourInvoiceFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="LabourInvoiceVM" OnValidSubmit="UpsertLabourInvoice">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                     <div class="row g-3 mb-2 align-items-center">
                         <!-- Correspondence Status -->
                         @if (LabourInvoiceVM.LabInvId > 0 && !string.IsNullOrWhiteSpace(LabourInvoiceVM.LabInvNo))
                            {
                                <CorrespondenceStatus ReferenceType="Labour-Invoice"
                                                        ReferenceId="@LabourInvoiceVM.LabInvId"
                                                        ReferenceTypeName="@LabourInvoiceVM.LabInvNo" />
                            }
                    </div>

                    <div class="row g-3 mb-2">

                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Customer Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Customer")'>
                                        <i class="bi bi-person-add me-1"></i> Add Customer
                                    </button>
                                </div>

                                <div class="card-body">
                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="CustomerVM"
                                                                 Value="SelectedCustomer"
                                                                 ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                                 ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                                 SearchFunc="SearchCustomers"
                                                                 Dense="true"
                                                                 Variant="Variant.Outlined"
                                                                 Placeholder="Search Customer"
                                                                 Title="Search atleast 3 letters in Customer"
                                                                 Class="w-100 autocomplete-sm"
                                                                 MaxItems="50"
                                                                 Clearable="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 Required="true"
                                                                 AvoidSubmit="true" 
                                                                 Disabled="@IsSomeItemsTransMade"/>
                                        </div>
                                    </div>

                                    <!-- Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1" readonly>@LabourInvoiceVM?.CustAddress</textarea>
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Phone No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@LabourInvoiceVM?.ContactNo" readonly />
                                        </div>
                                    </div>

                                    <!-- GSTIN -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GSTIN</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@LabourInvoiceVM?.GSTNo" readonly />
                                        </div>
                                    </div>

                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                             <select class="form-select form-select-sm rounded-3 w-100"
                                                        @bind="@LabourInvoiceVM.KindOfAttention">
                                                    <option disabled value="">Select Contact Person</option>
                                                    @foreach (var cp in contactPersons)
                                                    {
                                                        <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                    }
                                            </select>
                                            <ValidationMessage For="@(() => LabourInvoiceVM.KindOfAttention)" />
                                        </div>
                                    </div>

                                    <!-- Shipping Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Shipping Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="form-check form-switch d-flex align-items-center">
                                                <input class="form-check-input" type="checkbox" id="SameAsShipping"
                                                       checked="@LabourInvoiceVM.IsSameAsShipping"
                                                       @onchange="OnShippingChange" />
                                                <label class="form-check-label ms-2 fw-semibold"
                                                       for="SameAsShipping">Same as Shipping</label>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!LabourInvoiceVM.IsSameAsShipping)
                                    {
                                        <!-- Shipping To -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Shipping To</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select value="@LabourInvoiceVM.ShipAddrsId"
                                                        class="form-select form-select-sm rounded-3 w-100"
                                                        @onchange="OnConsigneeChangedAsync">
                                                    <option value="">Select Shipping Address</option>
                                                    @foreach (var consine in consineeAddress)
                                                    {
                                                        <option value="@consine.AltCustId">@consine.AltCustName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        @if (LabourInvoiceVM.ShipAddrsId > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Address</small>
                                                </label>
                                                <div class="col-12 col-lg-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@LabourInvoiceVM.ShippingAddress" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Contact No</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@LabourInvoiceVM.ShippingContactNo" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>GSTIN</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@LabourInvoiceVM.ShippingGstin" readonly />
                                                </div>
                                            </div>
                                        }
                                    }

                                    @if (IsProcessSelectRequired)
                                    {

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Process</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <MudAutocomplete T="Process"
                                                Value="SelectedProcess"
                                                ValueChanged="@(async c => await OnProcessChanged(c))"
                                                ToStringFunc="@(c => c?.ProcessName ?? string.Empty)"
                                                SearchFunc="SearchProcess"
                                                Dense="true"
                                                Variant="Variant.Outlined"
                                                Placeholder="Search Process"
                                                Title="Search atleast 3 letters in Customer"
                                                Class="w-100 autocomplete-sm"
                                                MaxItems="50"
                                                Clearable="true"
                                                ResetValueOnEmptyText="true"
                                                Required="true"
                                                AvoidSubmit="true" 
                                                Disabled="@IsSomeItemsTransMade"/>
                                            </div>
                                        </div>

                                    }

                                    @if(!string.IsNullOrEmpty(LabourInvoiceVM.ACKNO) && !string.IsNullOrEmpty(LabourInvoiceVM.IRNNo))
                                    {
                                        <div class="accordion mb-3" id="transportEinvoice">
                                            <div class="accordion-item border-0 shadow-sm rounded-3">

                                                <h2 class="accordion-header" id="headingEInvoice">
                                                    <button class="accordion-button collapsed fw-semibold text-primary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseEInvoice"
                                                            aria-expanded="false"
                                                            aria-controls="collapseEInvoice">
                                                        <i class="bi bi-truck me-2"></i> E-Invoice Details
                                                    </button>
                                                </h2>

                                                <div id="collapseEInvoice"
                                                     class="accordion-collapse collapse"
                                                     aria-labelledby="headingEInvoice"
                                                     data-bs-parent="#transportEinvoice">

                                                    <div class="accordion-body">

                                                        <!-- ACK No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>ACK No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <input type="text"
                                                                       class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind="LabourInvoiceVM.ACKNO"
                                                                       readonly />
                                                            </div>
                                                        </div>

                                                        <!-- ACK Date -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>ACK Date</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="LabourInvoiceVM.ACKNODate"
                                                                           disabled />
                                                            </div>
                                                        </div>

                                                        <!-- IRN No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>IRN No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="LabourInvoiceVM.IRNNo" />
                                                                <ValidationMessage For="@(() => LabourInvoiceVM.IRNNo)" />
                                                            </div>
                                                        </div>

                                                        <!-- QR Code -->
                                                        <div class="mb-2 row align-items-center">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>QR Code</small>
                                                            </label>

                                                            <div class="col-12 col-sm-9">
                                                                @if (!string.IsNullOrEmpty(LabourInvoiceVM.SignedInvoiceQrCode))
                                                                {
                                                                     <img src="@($"data:image/png;base64,{LabourInvoiceVM.SignedInvoiceQrCode}")"
                                                                         class="bg-white p-2"
                                                                         style="width:150px;height:auto;" />
                                                                }
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    }


                                </div>
                            </div>
                        </div>

                        <!-- =================== Labour InVoice Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Labour Invoice Details</span>
                                    @if (LabourInvoiceVM.LabInvId > 0)
                                    {
                                          <div class="d-flex gap-2">
                                                <button type="button"
                                                        class="btn btn-sm rounded-3 @(LabourInvoiceVM.InvCancel ? "btn-success" : "btn-danger")"
                                                        @onclick="Cancel">

                                                    @if (!LabourInvoiceVM.InvCancel)
                                                    {
                                                        <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                                    }
                                                </button>
                                              <!-- Short Close / Re-Open -->
                                                <button type="button"
                                                    class="btn btn-sm rounded-3 @(LabourInvoiceVM.ShortClose ? "btn-success" : "btn-warning")"
                                                    @onclick="() => AskToShortCloseAsync(LabourInvoiceVM)"
                                                    disabled="@LabourInvoiceVM.InvCancel">

                                                    @if (!LabourInvoiceVM.ShortClose)
                                                    {
                                                        <i class="bi bi-box-seam me-1"></i>
                                                        <span>Short Close</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                        <span>Re-Open</span>
                                                    }
                                                </button>
                                        </div>
                                    }
                                </div>

                                <div class="card-body">

                                     <div class="row mb-2">
                                        <div class="col-12 d-flex justify-content-end">
                                            <div class="form-check d-flex align-items-center gap-2">
                                                    <input type="checkbox"
                                                        class="form-check-input"
                                                        style="border:2px solid #000;"
                                                        @bind="LabourInvoiceVM.IsManualInvNo" @onclick="()=>ToggleAutoInvNo()" readonly="@LabourInvoiceVM.LabInvId>0" />
                                                <label class="form-check-label text-dark">
                                                    <small>Is Manual Inv No.</small>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Invoice No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Invoice No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Prefix"
                                                            maxlength="10"
                                                            @bind-Value="@LabourInvoiceVM.Prefix"
                                                            style="flex:0 0 130px;" />

                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Invoice No."
                                                            maxlength="30"
                                                            @bind-Value="@LabourInvoiceVM.LabInvNo" 
                                                            readonly="@IsInvNoReadonly" />

                                                <span class="input-group-text rounded-3">@LabourInvoiceVM.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => LabourInvoiceVM.Prefix)" />
                                            <ValidationMessage For="@(() => LabourInvoiceVM.LabInvNo)" />
                                        </div>
                                    </div>

                                    <!-- Invoice Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Invoice Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                        @bind-Value="@LabourInvoiceVM.LabInvDate" />
                                            <ValidationMessage For="@(() => LabourInvoiceVM.LabInvDate)" />
                                        </div>
                                    </div>

                                     <!-- Reference DC -->
                                    @if(DcPendingCount >0)
                                    {
                                        @if (DcPendingCount > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Our DC</small>
                                                </label>

                                                <div class="col-12 col-sm-9 position-relative">
                                                    <button type="button"
                                                            class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                            @onclick="ShowDcDetails">
                                                        <i class="bi bi-list-ul me-1"></i> DC Details
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }
                                    
                                    <!-- Currency -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Currency</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value="@LabourInvoiceVM.CurrId"
                                                    @onchange="OnCurrencyChanged"
                                                    disabled>
                                                @foreach (var currency in Currencies)
                                                {
                                                    <option value="@currency.CurrId">@currency.CurrName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Payment Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Payment Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="LabourInvoiceVM.PayTerms"></textarea>
                                            <ValidationMessage For="@(() => LabourInvoiceVM.PayTerms)" />
                                        </div>
                                    </div>

                                    <!-- Delivery Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Delivery Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="LabourInvoiceVM.DeliveryTems"></textarea>
                                            <ValidationMessage For="@(() => LabourInvoiceVM.DeliveryTems)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="LabourInvoiceVM.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => LabourInvoiceVM.MainRemark)" />
                                        </div>
                                    </div>
                                     @if (LabourInvoiceVM.LabInvId>0)
                                    {
                                         <div class="accordion mb-3" id="transportAccordion">
                                        <div class="accordion-item border-0 shadow-sm rounded-3">
                                            <h2 class="accordion-header" id="headingTransport">
                                                <button class="accordion-button collapsed fw-semibold text-primary"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#collapseTransport"
                                                        aria-expanded="false"
                                                        aria-controls="collapseTransport">
                                                        TDS Details
                                                </button>
                                            </h2>
                                            <div id="collapseTransport"
                                                 class="accordion-collapse collapse"
                                                 aria-labelledby="headingTransport"
                                                 data-bs-parent="#transportAccordion">
                                                <div class="accordion-body">

                                                     <!-- Transport ID -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>TDS Amount (In ₹) </small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                           <div class="d-flex align-items-center">
                                                                <input type="number" step="any"
                                                                       class="form-control form-control-sm rounded-3"
                                                                       @bind="LabourInvoiceVM.TDSAmount" />
                                                            </div>
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mt-1">

                                                    <!-- Center Button Wrapper -->
                                                    <div class="flex-grow-1 d-flex justify-content-center">
                                                        <button type="button" class="btn btn-sm fw-semibold"
                                                                style="background-color:#ffca2c; color:black; border-radius:8px;" @onclick="TDS">
                                                            <span class="me-2"> <i class="bi bi-currency-rupee"></i></span>
                                                            <span class="me-2"> <i class="bi bi-dash-circle"></i> </span>
                                                            Deduct TDS
                                                        </button>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    }
                                   

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <!-- Discount Toggle -->
                                        <div class="d-flex align-items-center">
                                            <label class="me-2 mb-0"><small>Discount : </small></label>
                                            <div class="btn-group btn-group-sm rounded-pill border" role="group" aria-label="Toggle Discount Rs and %">
                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountToggleRs" 
                                                        @onchange='() => SetDiscountMode(true)' 
                                                        checked="@LabourInvoiceVM.IsItemWiseDiscAmtOrPerReq" />
                                                <label class="btn btn-outline-primary rounded-start-pill" for="discountToggleRs">@LabourInvoiceVM.Symbol</label>

                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountTogglePercent" 
                                                        @onchange='() => SetDiscountMode(false)' 
                                                        checked="@(!LabourInvoiceVM.IsItemWiseDiscAmtOrPerReq)" />
                                                <label class="btn btn-outline-primary rounded-end-pill" for="discountTogglePercent">%</label>
                                            </div>
                                        </div>

                                        <!-- Add Item Button -->
                                        <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                            <i class="bi bi-plus-circle me-1"></i> Create New Item
                                        </button>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                              
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:70px;">SAC</th>
                                                    <th style="width:60px;">UOM</th>
                                                      @if(IsLabourCost)
                                                      {
                                                        <th style="width:100px;">Labour Cost</th>
                                                      }

                                                    <th style="width:120px;">Qty</th>
                                                    <th style="width:120px;">Price</th>
                                                    <th style="width:130px;">Gross Amount</th>

                                                    @if (!LabourInvoiceVM.IsItemWiseDiscAmtOrPerReq)
                                                    {
                                                        <th style="width:110px;">Disc %</th>
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }

                                                    @if (SelectedCustomer?.TaxValidate == false)
                                                    {
                                                        @if (SelectedCustomer?.BusiType == "Local")
                                                        {
                                                            <th style="width:110px;">CGST %</th>
                                                            <th style="width:110px;">SGST %</th>
                                                        }
                                                        else if(SelectedCustomer?.BusiType == "InterState")
                                                        {
                                                            <th style="width:110px;">IGST %</th>
                                                        }
                                                    }

                                                    <th style="width:130px;">Basic Amount</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:110px;">Ref DC No.</th>
                                                    <th style="width:110px;">Ref Dc Date</th>
                                                    <th style="width:110px;">Ref PO No.</th>
                                                       <th style="width:110px;">LineNo</th>
                                                        <th style="width:110px;">Ref PO Dt.</th>
                                                       
                                                    <th style="width:150px;">Cost-Center</th>

                                                    @if (LabourInvoiceVM?.LabourInvoiceSubVM?.Any(x=>x?.CreditNos!=null && x.CreditNos.Count>0)==true)
                                                    {
                                                        <th style="width:150px;">CreditNote No.</th> 
                                                        <th style="width:150px;">CreditNote Date</th>
                                                    }

                                                    @if (!LabourInvoiceVM.InvCancel && !LabourInvoiceVM.ShortClose)
                                                    {
                                                        <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                    }
                                                  
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in LabourInvoiceVM.LabourInvoiceSubVM)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @if (subitem.IsEditable  && (subitem.LabInvSubId == 0 || subitem.RefDcSubId == null) && subitem.Qty == subitem.BalQty)
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                            Value="subitem.SelectedItem"
                                                                                            ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                            ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                            SearchFunc="SearchItems"
                                                                                            Dense="true"
                                                                                            Variant="Variant.Outlined"
                                                                                            Placeholder="Search Item Code"
                                                                                            Title="Search Atleast 3 Letters in Item-Code"
                                                                                            Class="w-100 autocomplete-sm"
                                                                                            MaxItems="50" />
                                                                        <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.ItemCode
                                                                    }
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                        Size="Size.Small"
                                                                                        Color="Color.Primary"
                                                                                        OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                        Edge="Edge.End"
                                                                                        Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.SACCode</td>
                                                        <td>@subitem.MeasureUnit</td>

                                                        @if(IsLabourCost)
                                                        {
                                                            <td>@subitem.LabourCost</td>
                                                        }

                                                        <!-- Qty -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                  <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Qty"
                                                                           title="Enter Quantity"
                                                                           step="any"
                                                                           @bind="subitem.Qty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.Qty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.Qty</span>
                                                            }
                                                        </td>

                                                        <!-- Unit Price -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm" placeholder="Price" title="Enter Unit Price"
                                                                        step="any"
                                                                        @bind="subitem.UnitPrice" @bind:event="oninput"
                                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(LabourInvoiceVM)' readonly="@pricelock"/>
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>

                                                        <!-- Line Gross -->
                                                        <td>@FormatDecimal(subitem.LineGross)</td>

                                                        <!-- Discount -->
                                                        @if (!LabourInvoiceVM.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" step="any" placeholder="Disc %" title="Enter Discount %"
                                                                            @bind="subitem.LineDiscountPercent" @bind:event="oninput"
                                                                            @bind:after='() => OnLineDiscountPercentChanged(subitem)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountPercent)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountPercent)
                                                                }
                                                            </td>
                                                            <td>@FormatDecimal(subitem.LineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" step="any" placeholder="Disc Amt" title="Enter Discount Amount"
                                                                            @bind="subitem.LineDiscountAmount" @bind:event="oninput"
                                                                            @bind:after='() => _calculationService.UpdateTotalsAsync(LabourInvoiceVM)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountAmount)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountAmount)
                                                                }
                                                            </td>
                                                        }

                                                        <!-- Taxes -->
                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if (SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                            <option value="" disabled selected>CGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineCGSTRate)
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                            <option value="" disabled selected>SGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineSGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                            else if (SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @bind="subitem.LineIGSTRate" @bind:event="oninput"
                                                                                @bind:after='() => _calculationService.UpdateTotalsAsync(LabourInvoiceVM)'>
                                                                            <option value="" disabled selected>IGST %</option>
                                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineIGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                        }

                                                        <!-- Basic Amount -->
                                                        <td>@FormatDecimal(subitem.LineBasicAmount)</td>

                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.Remarks" class="form-control form-control-sm" placeholder="Enter Remarks" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.Remarks
                                                            }
                                                        </td>

                                                        <!-- Ref Enquiry -->
                                                        <td>@subitem.RefDcNo</td>
                                                        <td>@subitem.RefDcDate?.ToString("dd/MM/yyyy")</td>
                                                         <td>@subitem.RefPoNo</td>
                                                         <td>@subitem.LineNo</td>
                                                         <td>@subitem.RefPoDate?.ToString("dd/MM/yyyy")</td>
                                                         

                                                        <!-- Cost Center -->
                                                        <td>
                                                            @if (subitem.IsEditable && (subitem.RefDcSubId == 0 || subitem.RefDcSubId == null) && subitem.Qty == subitem.BalQty)
                                                            {
                                                                <select class="form-select form-select-sm" 
                                                                    value="@subitem.CostId"
                                                                    @onchange="(e => OnCostCenterChanged(e, subitem))">
                                                                    <option value="">select CostCentre</option>
                                                                    @foreach (var cost in CostCenterVMs.Where(c =>
                                                                        !LabourInvoiceVM.LabourInvoiceSubVM.Any(r => r != subitem && r.CostId == c.Id)))
                                                                    {
                                                                        <option value="@cost.Id">@cost.ProjectNo</option>
                                                                    }
                                                                </select>
                                                                <ValidationMessage For="@(() => subitem.CostId)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.ProjectNo
                                                            }
                                                        </td>

                                                        @if (LabourInvoiceVM?.LabourInvoiceSubVM?.Any(x=>x?.CreditNos!=null && x.CreditNos.Count>0)==true)
                                                        {
                                                            <td>@string.Join(", ", subitem.CreditNos)</td>
                                                            <td>@string.Join(", ", subitem.CreditDates.Select(d => d.ToString("dd/MM/yyyy")))</td>
                                                        }
                                                        
                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            @if (!LabourInvoiceVM.InvCancel)
                                                            {
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                            @onclick="async () => await SaveRow(subitem)" >
                                                                        <i class="bi bi-check-lg"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                            @onclick="async () => await CancelEdit(subitem, LabourInvoiceVM)" >
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit" 
                                                                            @onclick="async () => await EditRowAsync(subitem)" >
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete" 
                                                                            @onclick="async () => await RemoveRow(subitem)" >
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                }
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (LabourInvoiceVM.LabourInvoiceSubVM?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        <td colspan="5" class="text-end fw-bold">Totals:</td>
                                                        <td>@LabourInvoiceVM.TotalQty</td>
                                                        <td>Avg: @FormatDecimal(LabourInvoiceVM.AvgUnitPrice)</td>
                                                        <td>@FormatDecimal(LabourInvoiceVM.TotalLineGross)</td>

                                                        @if (!LabourInvoiceVM.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td></td>
                                                            <td>@FormatDecimal(LabourInvoiceVM.TotalLineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@FormatDecimal(LabourInvoiceVM.TotalLineDiscountAmount)</td>
                                                        }

                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if(SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td></td>
                                                                <td></td>

                                                            }
                                                            else if(SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td></td>
                                                            }
                                                        }

                                                        <td>@FormatDecimal(LabourInvoiceVM.TotalLineBasicAmount)</td>
                                                        @if(LabourInvoiceVM?.LabourInvoiceSubVM?.Any(x=>x?.CreditNos!=null && x.CreditNos.Count>0)==true)
                                                        {
                                                            <td colspan="11"></td>
                                                        }else
                                                        {
                                                            <td colspan="9"></td>
                                                        }
                                                        
                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>

                                    @if(!LabourInvoiceVM.InvCancel)
                                    {
                                       @*  <div class="mt-2 text-start">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div> *@
                                    }
                                </div>

                            </div>
                        </div>

                        <!-- ===================Other Details Terms and Conditions ===================-->
                        <div class="col-12 col-lg-6 mb-3">
                            <div class="card shadow-sm rounded-4 border-0">
                                <div class="card-body">
                                    <div class="row g-3">

                                        <!-- ================= Due Date ================= -->
                                        <div class="col-12 col-md-7">
                                            <label class="form-label fw-semibold text-dark">
                                                <i class="bi bi-calendar3 me-1 text-primary"></i> Due Date
                                            </label>
                                            <input type="date" class="form-control form-control-sm rounded-3 shadow-sm"
                                                   @bind="LabourInvoiceVM.DueDate" />
                                            <ValidationMessage For="@(() => LabourInvoiceVM.DueDate)" />
                                        </div>

                                        <!-- ================= Terms & Conditions ================= -->
                                        <div class="col-12 col-md-7">
                                            <label class="form-label fw-semibold text-dark">
                                                <i class="bi bi-file-text me-1 text-primary"></i> Terms & Conditions
                                            </label>
                                            <select class="form-select form-select-sm rounded-3 shadow-sm"
                                                    value="@LabourInvoiceVM.TermsId"
                                                    @onchange="OnTermsChanged">
                                                <option value="">-- Select Terms --</option>
                                                @if (TermsList != null && TermsList.Any())
                                                {
                                                    @foreach (var term in TermsList)
                                                    {
                                                        <option value="@term.Id">@term.Title</option>
                                                    }
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => LabourInvoiceVM.TermsId)" />
                                        </div>

                                        <!-- ================= Create New Terms Button ================= -->
                                        <div class="col-12 col-md-2 d-flex align-items-end">
                                            <button type="button" class="btn btn-sm btn-success rounded-3 w-100" 
                                                    @onclick='() => OpenModal("Terms")'>
                                                <i class="bi bi-plus-circle me-1"></i> New Terms
                                            </button>
                                        </div>

                                        <!-- ================= Selected Terms Display ================= -->
                                        @if (!string.IsNullOrEmpty(LabourInvoiceVM.Details))
                                        {
                                            <div class="col-12">
                                                <div class="p-3 border rounded-3 bg-light shadow-sm">
                                                    <h6 class="fw-bold text-primary mb-1">Details</h6>
                                                    <p class="mb-0 text-muted">@LabourInvoiceVM.Details</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- =================== Tax Details Section =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm rounded-4 border-0 p-3">

                                <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Tax & Charges
                                </h6>

                                <!-- Total Gross -->
                                <div class="row mb-2 gx-3">
                                    <label for="TotalGross" class="col-5 col-md-4 col-form-label text-dark">
                                        <small>Total Gross</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input id="TotalGross"
                                               class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               value="@FormatDecimal(LabourInvoiceVM.TotalGrossAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Discount -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Discount</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="discountToggle" id="discountRs"
                                                   @onchange="() => SetDiscountType(true)"
                                                   checked="@LabourInvoiceVM.DiscAmtOrPer"
                                                   disabled="@(LabourInvoiceVM.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountRs">
                                                <small>@LabourInvoiceVM.Symbol</small>
                                            </label>

                                            <input type="radio" class="btn-check" name="discountToggle" id="discountPercent"
                                                   @onchange="() => SetDiscountType(false)"
                                                   checked="@(!LabourInvoiceVM.DiscAmtOrPer)"
                                                   disabled="@(LabourInvoiceVM.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountPercent"><small>%</small></label>
                                        </div>
                                    </div>

                                    <div class="col-3 col-md-5">
                                        @if (LabourInvoiceVM.DiscAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   @bind="LabourInvoiceVM.DiscountAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(LabourInvoiceVM)'
                                                   disabled="@(LabourInvoiceVM.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => LabourInvoiceVM.DiscountAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   @bind="LabourInvoiceVM.DiscountPercent"
                                                   @bind:after="OnDiscountPercentChanged"
                                                   disabled="@(LabourInvoiceVM.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => LabourInvoiceVM.DiscountPercent)" />
                                            <small class="text-muted d-block text-end">
                                                Amt: @FormatDecimal(LabourInvoiceVM.DiscountAmount)
                                            </small>
                                        }
                                    </div>
                                </div>

                                <!-- SubTotal -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>SubTotal</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number" 
                                               value="@FormatDecimal(LabourInvoiceVM.TotalBasicAmount)" 
                                               readonly />
                                    </div>
                                </div>

                                <!-- Freight Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Freight Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="LabourInvoiceVM.FreightCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(LabourInvoiceVM)' />
                                        <ValidationMessage For="@(() => LabourInvoiceVM.FreightCharges)" />
                                    </div>
                                </div>

                                <!-- P & F Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>P & F Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="packingToggle" id="packingToggleRs"
                                                   @onchange="() => SetPAndFType(true)" checked="@LabourInvoiceVM.PackingAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="packingToggleRs"><small>@LabourInvoiceVM.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="packingToggle" id="packingTogglePercent"
                                                   @onchange="() => SetPAndFType(false)" checked="@(!LabourInvoiceVM.PackingAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="packingTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (LabourInvoiceVM.PackingAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="LabourInvoiceVM.PackingCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(LabourInvoiceVM)' />
                                            <ValidationMessage For="@(() => LabourInvoiceVM.PackingCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="LabourInvoiceVM.PackingPercent"
                                                   @bind:after="() => OnPandFPercentChanged()" />
                                            <ValidationMessage For="@(() => LabourInvoiceVM.PackingPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(LabourInvoiceVM.PackingCharges) </small>
                                        }
                                    </div>
                                </div>

                                <!-- Insurance Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Insurance Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceToggleRs"
                                                   @onchange="() => SetInsuranceType(true)" checked="@LabourInvoiceVM.InsuranceAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="insuranceToggleRs"><small>@LabourInvoiceVM.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceTogglePercent"
                                                   @onchange="() => SetInsuranceType(false)" checked="@(!LabourInvoiceVM.InsuranceAmtOrPer)" />
