                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="LabourInvoiceVM.OtherCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(LabourInvoiceVM)' />
                                        <ValidationMessage For="@(() => LabourInvoiceVM.OtherCharges)" />
                                    </div>
                                </div>

                                <!-- Round Off -->
                                <div class="row mb-2 gx-2 align-items-center">
                                    <div class="col-5 col-md-4 d-flex align-items-center">
                                        <small class="me-2 text-dark">Round Off</small>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="roundOffSwitch"
                                                   @bind="LabourInvoiceVM.IsRoundOffEnabled"
                                                   @bind:after="() => _calculationService.UpdateTotalsAsync(LabourInvoiceVM)" >
                                            <label class="form-check-label" for="roundOffSwitch"></label>
                                        </div>
                                    </div>
                                    <div class="col-7 col-md-8">
                                       <input class="form-control form-control-sm rounded-3 text-end"
                                               value="@FormatDecimal(LabourInvoiceVM.RoundOff)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Grand Total -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label fw-bold text-dark">
                                        <small>Grand Total</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                               value="@FormatDecimal(LabourInvoiceVM.GrandTotal)"
                                               readonly />
                                        @if (LabourInvoiceVM.CurrId > 1)
                                        {
                                            <div class="mt-1 text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @LabourInvoiceVM.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((LabourInvoiceVM.GrandTotal * LabourInvoiceVM.TodayVal).ToString("0.00"))
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Amount in Words -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Amount in Words</small></label>
                                    <div class="col-7 col-md-8 pt-1">
                                        @if (LabourInvoiceVM.CurrId > 1)
                                        {
                                            <small class="fw-bold text-success d-block">
                                                Converted Value in Rs: @FormatDecimal(LabourInvoiceVM.GrandTotal * LabourInvoiceVM.TodayVal)
                                            </small>
                                        }
                                        else
                                        {
                                            <strong>@NumberToWordsHelper.ConvertNumberToWords(LabourInvoiceVM.GrandTotal)</strong>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            @if(!LabourInvoiceVM.InvCancel)
                            {
                                 <div class="col-4 col-md-3 mt-3">
                                    <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                        <i class="bi bi-floppy2-fill me-1"></i> @(LabourInvoiceVM.LabInvId > 0 ? "Update" : "Create")
                                    </button>
                                </div>
                            }
                           
                        }
                         @if(LabourInvoiceVM.LabInvId>0 && string.IsNullOrEmpty(LabourInvoiceVM.ACKNO) 
                        && string.IsNullOrEmpty(LabourInvoiceVM.IRNNo) && !LabourInvoiceVM.InvCancel && !LabourInvoiceVM.ShortClose)
                        {
                                <div class="col-4 col-md-3 mt-3">
                                <button type="button" class="btn  btn-success w-100 rounded-3 rounded-3" @onclick='() => ConfirmEinvoice()'>
                                    <i class="bi bi-person-add me-1"></i> E-Invoice
                                </button>
                            
                                </div>
                        }

                         @if(LabourInvoiceVM.LabInvId>0)
                         {
                                <div class="col-4 col-md-3 mt-3">
                                     <button type="button" class="btn btn-warning w-100 rounded-3" @onclick='() => OpenModal("TDS")'>
                                         <i class="bi bi-graph-down-arrow"></i> TDS
                                     </button>
                                </div>
                         }


                        <div class="col-4 col-md-3 mt-3">
                            <SmartBackButton Url="@($"/LabourInvoiceList?currentPage={currentPage}")" />
                        </div>
                        @if (CanCreate || CanEdit && LabInvId > 0)
                        {
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                    <i class="bi bi-printer me-1"></i>Print
                                </button>
                            </div>
                        }
                    </div>
                   
                </EditForm>
            </div>
        </div>
    </div>
} 


@code {



    #region Parameters & Properties

    protected override string ScreenName =>"Labour Invoice";

    [Parameter] public int? LabInvId { get; set; }
    [Parameter] public int CustId { get; set; }

    private bool isProcessing = true;
    private LabInvVM LabourInvoiceVM { get; set; } = new();
    private PoTaxDetailVM PoTaxDetailVM { get; set; } = new();

    private LabInvSubVM? rowToDelete;
    private LabInvSubVM? rowToCancel;

    private bool pricelock{ get; set; } = false;

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;
    private string? pdfBase64;


    private int DcPendingCount = 0;
    private CustomerVM? SelectedCustomer;
    private List<ContactPerson> contactPersons = new();
    private List<CustomerIndirect> consineeAddress = new();
    private List<Currency> Currencies = new();
    private List<CostCenterVM> CostCenterVMs = new();

    private List<TermsAndConditions> TermsList = new();
    private bool IsSomeItemsTransMade { get; set; } = false;

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    private bool IsDcModalVisible = false;
    private List<Dictionary<string, object>>? DcData;
    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private List<string> DcColumns = new() { "RefDcSubId","DC No.", "DC Date","ItemId", "Item Code", "Item Name","UOM", "DC Qty","Invoice Qty","CostCenterId","Project No.","Ref PO NO", "Ref PO Date","LineNo" };
    private List<string> DcFields = new() { "RefDcSubId","DcNo","DcDate","ItemId" ,"ItemCode", "ItemName","UOM", "Qty", "BalQty","CostCenterId" ,"ProjectNo","RefPoNo","RefPoDate","LineNo"};
    private List<string> DcHiddenColumns = new() { "RefDcSubId", "ItemId", "CostCenterId" };

    private List<PageHeader.BreadcrumbItem> LabourInvoiceFormBreadcrumbs = new()
    {
        new() { Text = "Sales" },
        new() { Text = "Labour-Invoice", IsLast = true }
    };

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private int DecimalPlaces { get; set; } = 2;

    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private bool IsLabourCost { get; set; } = false;
    private Process SelectedProcess;

    private bool IsEinvoiceCancelRequired { get; set; } = false;
    private bool IsProcessSelectRequired { get; set; } = false;

    #endregion

    public bool IsInvNoReadonly =>!(LabourInvoiceVM.IsManualInvNo ?? false) || LabInvId == 0;
    private async Task ToggleAutoInvNo()
    {
        if (LabourInvoiceVM.IsManualInvNo??false)
        {
            LabourInvoiceVM.LabInvNo = await _LabourInvoiceService.GetInvoiceNumberAsync(LabourInvoiceVM.Suffix);
        }
    }


    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            pricelock = await _LabourInvoiceService.GetPriceLockStatusAsync();    
            Currencies = await _LabourInvoiceService.GetCurrenciesAsync();
            TermsList = await _LabourInvoiceService.GetTermsAsync();
            DecimalPlaces = await _LabourInvoiceService.GetDecimalPlacesAsync();
            IsLabourCost = await _CostingService.IsLabourChargesDisplayEnabledAsync();
            IsEinvoiceCancelRequired = await _LabourInvoiceService.EinvoiceCancelOption();
            IsProcessSelectRequired=await _LabourInvoiceService.ProcessSelectOption();
            if (LabInvId.HasValue)
            {
                await LoadExistingQuote(LabInvId.Value);
            }
            else if (CustId > 0)
            {
                await InitializeNewQuote(CustId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingQuote(int LabInvId)
    {
        try
        {
            LabourInvoiceVM = await _LabourInvoiceService.GetLabourInvByLabInvIdAsync(LabInvId);
            if (LabourInvoiceVM == null)
            {
                await _js.ToastrWarning("Quotation not found.");
                return;
            }

            SelectedCustomer = await _LabourInvoiceService.GetCustomerByIdAsync(LabourInvoiceVM.CustId);
            SelectedProcess = await _LabourInvoiceService.GetProcessByIdAsync(LabourInvoiceVM.ProcessId??0);
            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

            if (LabourInvoiceVM.CurrId > 0)
                await ApplyCurrencyChange(LabourInvoiceVM.CurrId);

            foreach (var LabInvSub in LabourInvoiceVM.LabourInvoiceSubVM.Where(q => q.ItemId > 0))
            {
                attachmentCounts[LabInvSub.ItemId.Value] =
                    await _LabourInvoiceService.GetCorrespondenceAttachmentsCountAsync(LabInvSub.ItemId.Value, "Item");

                if(IsLabourCost)
                {
                    if (LabInvSub.UnitPrice < LabInvSub.LabourCost)
                    {
                        await _js.ToastrWarning( $"Unit Price ({LabInvSub.UnitPrice:0.00}) Is less than Labour Cost ({LabInvSub.LabourCost:0.00}).");
                    }
                    else if(LabInvSub.UnitPrice > LabInvSub.LabourCost)
                    {
                        await _js.ToastrWarning( $"Unit Price ({LabInvSub.UnitPrice:0.00}) Is  Greater than than Labour Cost ({LabInvSub.LabourCost:0.00})." );

                    }

                }
            }

            LabourInvoiceVM.SignedInvoiceQrCode =await _LabourInvoiceService.GenerateQrBase64(LabourInvoiceVM.SignedInvoiceQrCode);
            //Check Transaction Completed flag
            IsSomeItemsTransMade =await CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing quotation.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingQuote failed for Labinvid: {LabInvId}");
        }
    }


    private async Task<bool> CheckIsTransMade()
    {
        var list = LabourInvoiceVM?.LabourInvoiceSubVM;
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalQty += list[i].Qty.GetValueOrDefault();
            totalBalQty += list[i].BalQty.Value;
        }

        return totalQty != totalBalQty;

        return LabourInvoiceVM.GrandTotal != LabourInvoiceVM.Balance;


        bool InvCancel = await _LabourInvoiceService.GetLabourInvoiceByIdIsCancelAsync(LabInvId.Value);

        if (!InvCancel)
            return true; 

        if (InvCancel)
            return true; 

        if (InvCancel)
            return true; 

        return false;
    }


    private async Task InitializeNewQuote(int custId)
    {
        try
        {
            var customer = await _LabourInvoiceService.GetCustomerByIdAsync(custId);
            if (customer != null)
                await ApplyCustomerSelectionAsync(customer);

            LabourInvoiceVM.Prefix = await _LabourInvoiceService.GetPrefixFromDb();
            LabourInvoiceVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            LabourInvoiceVM.LabInvNo = await _LabourInvoiceService.GetInvoiceNumberAsync(LabourInvoiceVM.Suffix);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new quotation.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewQuote failed for CustId: {custId}");
        }
    }

    #endregion


    #region Customer data, Currency And Tax  Handlers

    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3) 
            return Enumerable.Empty<CustomerVM>();

        try
        {
            var results = await _LabourInvoiceService.SearchCustomersAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<CustomerVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<CustomerVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchCustomers failed for value: {value}");
            await _js.ToastrError("Failed to search customers. Please try again.");
            return Enumerable.Empty<CustomerVM>();
        }
    }

    private async Task OnCustomerChanged(CustomerVM? customer)
    {
        try
        {
            await ApplyCustomerSelectionAsync(customer);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error in OnCustomerChanged: {ex}");
            await LoggingService.LogDeveloperError(ex, "Error in OnCustomerChanged");
            await _js.ToastrError("Error while selecting");
            contactPersons.Clear();
            await ResetQuoteDefaults();
        }
    }

    private async Task ApplyCustomerSelectionAsync(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;
            LabourInvoiceVM.CustId = customer?.CustId ?? 0;
            LabourInvoiceVM.CustName = customer?.CustName;
            LabourInvoiceVM.CustAddress = customer?.CustAddr;
            LabourInvoiceVM.GSTNo = customer?.GSTNo;
            LabourInvoiceVM.ContactNo = customer?.ContactNo;

            if (customer == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                CostCenterVMs.Clear();
                await ResetQuoteDefaults();
                return;
            }

            // Load related data
            contactPersons = await _LabourInvoiceService.GetContactPersonsAsync(customer.CustId);
            consineeAddress = await _LabourInvoiceService.GetConsigneeAddressesAsync(customer.CustId);

            var usedCostCenters = LabourInvoiceVM.LabourInvoiceSubVM
                .Where(x => x.CostId.HasValue && (x.RefDcSubId == null || x.RefDcSubId == 0))
                .Select(x => x.CostId.Value)
                .ToHashSet();

            CostCenterVMs = await _LabourInvoiceService.GetCostCenterDetailsByCustId(customer.CustId, usedCostCenters);

            LabourInvoiceVM.KindOfAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPersonName : string.Empty;

            // Tax logic
            if (!customer.TaxValidate)
            {
                var lastInvoice = await _LabourInvoiceService.GetLastinvoiceNoAsync(customer.CustId);
                if (lastInvoice != null)
                {
                    LabourInvoiceVM.CGstRate = lastInvoice.CGstRate;
                    LabourInvoiceVM.SGstRate = lastInvoice.SGstRate;
                    LabourInvoiceVM.IGstRate = lastInvoice.IGstRate;
                }
                else
                {
                    if (string.Equals(customer.BusiType, "Local", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false )
                    {
                        LabourInvoiceVM.CGstRate = CommonConstants.GetGST(9.000m);
                        LabourInvoiceVM.SGstRate = CommonConstants.GetGST(9.000m);
                        LabourInvoiceVM.IGstRate = CommonConstants.GetIGST(0.000m);
                    }
                    else if (string.Equals(customer.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false )
                    {
                        LabourInvoiceVM.CGstRate = CommonConstants.GetGST(0.000m);
                        LabourInvoiceVM.SGstRate = CommonConstants.GetGST(0.000m);
                        LabourInvoiceVM.IGstRate = CommonConstants.GetIGST(18.000m);
                    }
                }
            }

            // Currency
            LabourInvoiceVM.CurrId = (customer.CurrId.HasValue && customer.CurrId > 0) ? customer.CurrId.Value : 1;
            await ApplyCurrencyChange(LabourInvoiceVM.CurrId);

            //Pending EnquiryDetails
            DcPendingCount = await _LabourInvoiceService.GetPendingLabourDcOutCountAsync(customer.CustId);

            // Update totals
            await _calculationService.UpdateTotalsAsync(LabourInvoiceVM);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {customer?.CustId}");
            await _js.ToastrError("Failed to apply customer selection. Please try again.");
        }
    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
            await ApplyCurrencyChange(selectedId);
    }

    private async Task ApplyCurrencyChange(int currencyId)
    {
        var selectedCurrency = await _LabourInvoiceService.GetCurrencyByIdAsync(currencyId);
        if (selectedCurrency == null) return;

        LabourInvoiceVM.CurrName = selectedCurrency.CurrName;
        LabourInvoiceVM.Symbol = selectedCurrency.Symbol;
        LabourInvoiceVM.CurrId = selectedCurrency.CurrId;

        if (currencyId > 1)
            LabourInvoiceVM.TodayVal = await _LabourInvoiceService.GetLatestCurrencyValueAsync(currencyId) ?? 0m;
    }

    private async Task ResetQuoteDefaults()
    {
        LabourInvoiceVM.CGstRate = 0m;
        LabourInvoiceVM.SGstRate = 0m;
        LabourInvoiceVM.IGstRate = 0m;
    }

    private async Task OnShippingChange(ChangeEventArgs e)
    {
        try
        {
            LabourInvoiceVM.IsSameAsShipping = (bool)e.Value;

            if (!LabourInvoiceVM.IsSameAsShipping && SelectedCustomer != null)
            {
                consineeAddress = await _LabourInvoiceService.GetConsigneeAddressesAsync(SelectedCustomer.CustId);
            }
            else
            {
                consineeAddress.Clear();
                ResetShippingDefaults();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                $"Error while toggling shipping address for CustId={SelectedCustomer?.CustId}");
        }
    }

    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                LabourInvoiceVM.IsSameAsShipping = true; 
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }
            LabourInvoiceVM.IsSameAsShipping = false; 

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltCustId == selectedId);
            if (selectedConsignee == null)
                return;

            LabourInvoiceVM.ShipAddrsId = selectedConsignee.AltCustId;
            LabourInvoiceVM.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltCustAddr1, selectedConsignee.AltCustAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            LabourInvoiceVM.ShippingGstin = selectedConsignee.GSTNo ?? string.Empty;
            LabourInvoiceVM.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(LabourInvoiceVM);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

    private void ResetShippingDefaults()
    {
        LabourInvoiceVM.ShipAddrsId = null;
        LabourInvoiceVM.ShippingName = null;
        LabourInvoiceVM.ShippingAddress = null;
        LabourInvoiceVM.ShippingGstin = null;
        LabourInvoiceVM.ShippingContactNo = null;
    }

