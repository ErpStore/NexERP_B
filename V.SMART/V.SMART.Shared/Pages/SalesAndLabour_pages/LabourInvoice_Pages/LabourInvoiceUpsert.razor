    private async Task Cancel()
    {
        try
        {
            if (!LabInvId.HasValue || LabInvId == 0)
            {
                await _js.ToastrError("Labour Invoice cancel is not allowed before saving the enquiry.");
                return;
            }
            if (IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Labour Invoice");
                return;
            }

            if (LabourInvoiceVM.ShortClose)
            {
                await _js.ToastrError("Labour Invoice  is already short closed. You can't cancel it.");
                return;
            }

            // If ANY item is already cancelled → stop GRN cancel
            if (LabourInvoiceVM.LabourInvoiceSubVM.Any(s => s.ItemCancel))
            {
                await _js.ToastrWarning("Labour Invoice cannot be cancelled — one or more items are already cancelled.");
                return;
            }

            if (LabourInvoiceVM.GrandTotal!=LabourInvoiceVM.Balance)
            {
                await _js.ToastrError("Deletion not allowed. Payments have already been processed for this Labour Invoice.");
                return;

            }

            bool exist = false;
            foreach (var refId in LabourInvoiceVM.LabourInvoiceSubVM)
            {
                exist = await _LabourInvoiceService.HasAnyItemOrInvoiceCreditNoteAsync(refId.LabInvSubId);
                if (exist)
                {
                    await _js.ToastrWarning("Cannot Cancel this invoice. Credit Note already exists for this invoice or its items.");
                    return;
                }
            }

            // if (!IsEinvoiceCancelRequired)
            // {
            //     if (!string.IsNullOrEmpty(LabourInvoiceVM.ACKNO) && !string.IsNullOrEmpty(LabourInvoiceVM.IRNNo))
            //     {
            //         await _js.ToastrWarning("Cannot delete this invoice. E-Invoice already exists for this invoice or its items.");
            //         return;
            //     }
            // }

            if(LabourInvoiceVM.InvCancel)
            {
                var subs = await _LabourInvoiceService.GetLabInvSubDetailsByInvIdAsync(LabourInvoiceVM.LabInvId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    await _LabourInvoiceService.ValidateInvoiceBalanceBeforeRevertAsync(sub);
                }
            }

            if(IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Labour Invoice");
                return;
            }


            if (!LabourInvoiceVM.InvCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Labour Invoice?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Labour Invoice?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            LabourInvoiceVM = await _LabourInvoiceService.GetLabourInvByLabInvIdAsync(LabourInvoiceVM.LabInvId);
            await _js.ToastrError( "Cannot revert Labour Invoice. Invoice quantity exceeds the available Labour DC Outgoing balance Qty.");
            await LoggingService.LogDeveloperError(ex, "Error in  Sales Invoice Cancel() method");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Labour Invoice .Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Labour Invoice Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
                    await CancelInvoice();
                    break;
                case "ShortClose":
                    await ShortCloseLabourInvoice();
                    break;
                case "ItemCancel":
                    await CancelItem(rowToCancel);
                    break;
                case "TDS":
                    await UpdateTDS();
                    break;
                case "EInvoice":
                    await GenerateEInvoice();
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task CancelItem(LabInvSubVM rowToCancel)
    {
        if (rowToCancel == null) return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!rowToCancel.ItemCancel)
            {
                rowToCancel.ItemCancel = true;
                rowToCancel.CancelItemReason = cancelReason;

                await _LabourInvoiceService.UpdateItemCancelAndAddorRevertAsync(rowToCancel);
                await LoggingService.LogUserAction(
                UserName: username,
                Machine: machine,
                IP_Address: ip,
                screen: "Labour SCN",
                action: $"Cancelled Labour Invoice No:{LabourInvoiceVM.LabInvNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"SCN No: {LabourInvoiceVM.LabInvNo}");

            }
            else
            {
                rowToCancel.ItemCancel = false;
                rowToCancel.CancelItemReason = string.Empty; ;
                await _LabourInvoiceService.UpdateItemCancelAndAddorRevertAsync(rowToCancel);

                await LoggingService.LogUserAction(
                username, machine, ip,
                screen: "Labour SCN",
                action: $"Reverted Labour SCN No: {LabourInvoiceVM.LabInvNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");
            }

            LabourInvoiceVM.LabourInvoiceSubVM = await _LabourInvoiceService.GetLabourInvSubByInvIdAsync(LabourInvoiceVM.LabInvId);

            await ResetSlno();

            var toastMessage = rowToCancel.ItemCancel
                ? "Item cancelled successfully."
                : "Item has been reverted successfully.";

            await _js.ToastrSuccess(toastMessage);
            rowToCancel = null;

            LabourInvoiceVM = await _LabourInvoiceService.GetLabourInvByLabInvIdAsync(LabourInvoiceVM.LabInvId);
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            LabourInvoiceVM = await _LabourInvoiceService.GetLabourInvByLabInvIdAsync(LabourInvoiceVM.LabInvId);
            await _js.ToastrError("An error occurred while CancelItem the Item.");
            await LoggingService.LogDeveloperError(ex, "[UpdateItemCancelAndAddorRevertAsync] Validation issue");
            throw;
        }
        catch (Exception ex)
        {
            rowToCancel = null;
            await _js.ToastrError("An error occurred while cancelling/reverting the Item.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Reverse failed for SCNId: {LabourInvoiceVM.LabInvId}");
        }
        finally
        {
            rowToCancel = null;
            isProcessing = false;
        }
    }
    private async Task ShortCloseLabourInvoice()
    {
        if (LabourInvoiceVM == null)
        {
            await _js.ToastrError("No Labour SCN selected.");
            return;
        }
        try
        {
            isProcessing = true;
            LabourInvoiceVM.ShortClose = !LabourInvoiceVM.ShortClose;
            await _LabourInvoiceService.UpsertlabourInvoiceShortCloseAsync(LabourInvoiceVM);

            StateHasChanged();

            string msg = LabourInvoiceVM.ShortClose
                 ? "Labour Invoice  ShortClose Successfully!"
                 : "Labour Invoice ReOpen Successfully!";
            await _js.ToastrSuccess(msg);
        }
        catch (Exception ex)
