    private async Task<IEnumerable<ItemVM>> SearchItems(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        try
        {
            var results = await _LabourInvoiceService.SearchItemsAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<ItemVM>();
        }
        catch (OperationCanceledException)
        {
            // Typing too fast, search canceled - silently ignore
            return Enumerable.Empty<ItemVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchItems failed for value: {value}");
            await _js.ToastrError("Failed to search items. Please try again.");
            return Enumerable.Empty<ItemVM>();
        }
    }

    private async Task OnItemChanged(LabInvSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItem = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.SACCode = item.SACCode;
                subitem.MeasureUnit = item.MeasureUnit;
                subitem.LabourCost = item.AssemblyPrice;

                if (LabourInvoiceVM?.CustId != null && subitem.ItemId.HasValue)
                {


                    decimal fetchedPrice = await _LabourInvoiceService.GetBulkLastUnitPricesItemIdAsync( subitem.ItemId ?? 0, LabourInvoiceVM.CustId,subitem.RefDcSubId ?? 0);

                    if (fetchedPrice > 0)
                    {
                        subitem.UnitPrice = fetchedPrice;
                    }
                }
                else
                {
                    var rates = await _LabourInvoiceService.GetBulkLastUnitPricesAsync(
                        new List<int> { subitem.ItemId.Value },
                        LabourInvoiceVM.CustId
                    );

                    if (rates.TryGetValue(subitem.ItemId.Value, out decimal rate))
                    {
                        subitem.UnitPrice = rate;
                    }


                }

                if (subitem.ItemId > 0)
                {
                    var count = await _LabourInvoiceService.GetCorrespondenceAttachmentsCountAsync(subitem.ItemId.Value, "Item");
                    attachmentCounts[subitem.ItemId.Value] = count;


                    if(IsLabourCost)
                    {
                        if (subitem.UnitPrice < subitem.LabourCost)
                        {
                            _js.ToastrWarning( $"Unit Price ({subitem.UnitPrice:0.00}) Is less than Labour Cost ({subitem.LabourCost:0.00}).");
                        }
                        else if(subitem.UnitPrice > subitem.LabourCost)
                        {
                            _js.ToastrWarning( $"Unit Price ({subitem.UnitPrice:0.00}) Is  Greater than than Labour Cost ({subitem.LabourCost:0.00})." );

                        }

                    }
                }
            }
            else
            {
                // Reset when deselected
                subitem.SelectedItem = null;
                subitem.ItemId = null;
                subitem.ItemCode = null;
                subitem.ItemName = null;
                subitem.SACCode = null;
                subitem.MeasureUnit = null;
                subitem.UnitPrice = null;
            }

            await _calculationService.UpdateTotalsAsync(LabourInvoiceVM);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnItemChanged failed for ItemId: {item?.ItemId}");
            await _js.ToastrError("Failed to apply item selection. Please try again.");
        }
    }

