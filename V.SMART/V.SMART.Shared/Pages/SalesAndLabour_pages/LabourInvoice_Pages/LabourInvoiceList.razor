    private async Task HandleDelete(LabInvVM labInv)
    {
        try
        {
            var totalQty = labInv.LabourInvoiceSubVM.Sum(s => s.Qty);

            var totalBalQty = labInv.LabourInvoiceSubVM.Sum(s => s.BalQty);

            if (labInv.GrandTotal!=labInv.Balance)
            {
                await _js.ToastrError("Deletion not allowed. Payments have already been processed for this Labour Invoice.");
                return;

            }
            if ((totalQty != totalBalQty) )
            {
                await _js.ToastrError("Oops! You can't delete this Invoice because some items have already been processed.");
                return;

            }
            bool hasAnyItemOrGRNCancel = await _LabourInvoiceService.HasAnyItemOrLabourInvoiceCancelAsync(labInv.LabInvId);
            if (hasAnyItemOrGRNCancel)
            {
                await _js.ToastrWarning("Cannot delete this Labour Invoice as it or one of its items has been cancelled.");
                return;
            }

            bool exist = false;
            foreach (var refId in labInv.LabourInvoiceSubVM)
            {
                exist = await _LabourInvoiceService.HasAnyItemOrInvoiceCreditNoteAsync(refId.LabInvSubId);
                if (exist)
                {
                    await _js.ToastrWarning("Cannot delete this invoice. Credit Note already exists for this invoice or its items.");
                    return;
                }
            }

            if (!string.IsNullOrEmpty(labInv.ACKNO) && !string.IsNullOrEmpty(labInv.IRNNo))
            {
                await _js.ToastrWarning("Cannot delete this invoice. E-Invoice  already exists for this invoice or its items.");
                return;
            }


            DeleteQuoteID = labInv.LabInvId;
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error initiating delete for Labour Invoice InvId: {labInv.LabInvId}");
            await _js.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            if (isConfirmed && DeleteQuoteID>0 && confirmation=="")
            {
                
                bool deleted = await _LabourInvoiceService.DeleteLabourInvoiceByLabInvIdAsync(DeleteQuoteID);
                if (deleted)
                {
                    await _js.ToastrSuccess("Labour Invoice Deleted successfully.");
                    await LoadAllLabourInvoiceAsync();
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    await _js.ToastrWarning("Labour Invoice could not be deleted. It may not exist or have dependencies.");
                }
            }
            else if (isConfirmed && confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
                confirmation = "";
            }

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error deleting Labour Inv Id: {DeleteQuoteID}");
            await _js.ToastrError("Failed to delete Labour Invoice.");
        }
        finally
        {
            DeleteQuoteID = 0;
        }
    }

