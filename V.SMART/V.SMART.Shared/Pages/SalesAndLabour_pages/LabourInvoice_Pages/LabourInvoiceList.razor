    private async Task HandleExport()
    {
        Status = selectedStatus == "" ? "All" : selectedStatus;

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _js.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _js.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var exportData = await _LabourInvoiceService.GetLabourInvoiceStatusListAsync(Status);

            if (exportData == null || !exportData.Any())
                return;

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "Labour Invoice", "Labour Invoice Status List");

            var base64 = Convert.ToBase64String(bytes);
            await _js.DownloadExcelAsync(base64, "LabourInvoiceExport.xlsx");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex,
                "Error in ExportToExcel (Invoice's)");
            await _js.ToastrError("Error while exporting Labour Invoice!");
        }
        finally
        {
            isProcessing = false;
        }
    }

