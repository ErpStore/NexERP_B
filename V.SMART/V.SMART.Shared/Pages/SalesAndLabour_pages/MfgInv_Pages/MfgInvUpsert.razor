    private async Task<bool> ValidateInvoiceLineAsync(MfgInvSubVM line)
    {
        try
        {
            if (line.ItemId==0)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Unit Price must be greater than 0.");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            decimal qtyOut = 0,stkqty=0;
            int RefDcSubId=0,RefPoSubId=0;
            int.TryParse(line.RefDcSubId.ToString(),out RefDcSubId);
            int.TryParse(line.RefPoSubId.ToString(),out RefPoSubId);

            if (line.InvSubId == 0)
            {
                if(RefDcSubId>0)
                {
                    var dcBalQty = await mfgInvService.GetDcItemBalQtyFromDcSubId(line.RefDcSubId.Value);
                    if (line.Qty > dcBalQty)
                    {
                        line.Qty = dcBalQty;
                        line.BalQty = dcBalQty;
                        line.CrBalQty = dcBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Dc Balance Qty ({dcBalQty}).");
                        return false;
                    }
                }
                if(RefPoSubId>0)
                {
                    decimal rcstockqty = 0;
                    var PoBalQty = await mfgInvService.GetPoItemBalQtyFromDcSubId(line.RefPoSubId.Value);
                    if(line.RcSubIds!="" && line.RcSubIds!=null)
                    {
                        var ids = line.RcSubIds.Replace("'", "").Split(',', StringSplitOptions.RemoveEmptyEntries);
                        foreach (var rcid in ids)
                        {
                            int.TryParse(rcid.ToString(), out int rsubid);
                            rcstockqty = rcstockqty + await mfgInvService.GetAvailableStockByItemIdAndRcAndScreenAsync(line.ItemId,MfgInvVMs.StoreIssId.Value,rsubid);
                        }
                    }

                    var stockDict = (line.RcSubIds!="" && line.RcSubIds!=null) ? rcstockqty: await mfgInvService.GetStockQtyFromStockManager(line.ItemId, MfgInvVMs.StoreIssId.Value);

                    decimal.TryParse(stockDict.ToString(), out stkqty);
                    decimal possibleQty=Math.Min(stkqty, PoBalQty);

                    if (line.Qty > possibleQty)
                    {
                        line.Qty = PoBalQty;
                        line.BalQty = PoBalQty;
                        line.CrBalQty = PoBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Available Po Bal Qty ({possibleQty}). " + $"[Stock Qty: {stkqty}");
                        return false;
                    }

                }


            }
            else if (line.InvSubId > 0)
            {
                bool exist = false;
                exist = await mfgInvService.HasAnyItemOrInvoiceCreditNoteAsync(line.InvSubId);
                if (exist)
                {
                    await _js.ToastrWarning("Cannot modify this invoice. Credit Note already exists for this invoice or its items.");
                    return false;
                }

                var original = await mfgInvService.GetInvSubItemDetailByInvSubIdAsync(line.InvSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty ?? 0m;
                    decimal origQty = original.Qty ?? 0m;
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        line.CrBalQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                        line.CrBalQty = line.BalQty;
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateInvoiceLineAsync failed.");
            await _js.ToastrError("Error validating Invoice line.");
            return false;
        }
    }

