    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.InvSubId > 0)
            {
                await mfgInvService.DeleteAndResequenceAsync(rowToDelete, MfgInvVMs,screenCode);

                MfgInvVMs.MfgSubInvVMs = await mfgInvService.GetInvoiceSubByInvIdAsync(MfgInvVMs.InvId);

                await CountPendingposDcs();
            }
            else
            {
                MfgInvVMs.MfgSubInvVMs.Remove(rowToDelete);

                if (!MfgInvVMs.MfgSubInvVMs.Any())
                {
                    MfgInvVMs.MfgSubInvVMs.Add(new MfgInvSubVM
                    {
                        InvId = MfgInvVMs.InvId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < MfgInvVMs.MfgSubInvVMs.Count; i++)
                        MfgInvVMs.MfgSubInvVMs[i].SlNo = i + 1;
                }
            }

            await _calculationService.UpdateTotalsAsync(MfgInvVMs);

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for InvId: {MfgInvVMs.InvId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

