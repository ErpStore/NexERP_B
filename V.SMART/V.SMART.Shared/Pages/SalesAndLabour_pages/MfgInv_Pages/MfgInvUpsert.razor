    private async Task CancelEdit(MfgInvSubVM? item, MfgInvVM? parentQuote)
    {
        try
        {
            if (item == null || parentQuote == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentQuote.MfgSubInvVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for QuoteSubId: {item?.InvId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
