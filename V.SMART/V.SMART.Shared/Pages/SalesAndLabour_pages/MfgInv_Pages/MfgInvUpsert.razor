    private async Task OnItemChanged(MfgInvSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItem = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.HsnCode = item.HSNCode;
                subitem.MeasureUnit = item.MeasureUnit;
                subitem.LabourCost = item.AssemblyPrice;

                if (MfgInvVMs?.CustId != null && subitem.ItemId>0)
                {
                    var rates = await mfgInvService.GetBulkLastUnitPricesAsync(new List<int> { subitem.ItemId },MfgInvVMs.CustId.Value);

                    if (rates.TryGetValue(subitem.ItemId, out decimal rate))
                    {
                        subitem.UnitPrice = rate;
                    }
                }

                if (subitem.ItemId > 0)
                {
                    var count = await mfgInvService.GetCorrespondenceAttachmentsCountAsync(subitem.ItemId, "Item");
                    attachmentCounts[subitem.ItemId] = count;
                     
                    if(IsLabourCost)
