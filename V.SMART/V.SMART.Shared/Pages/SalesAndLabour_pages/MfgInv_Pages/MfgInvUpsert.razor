    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                MfgInvVMs.IsSameAsShipping = true; 
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }
            MfgInvVMs.IsSameAsShipping = false; 

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltCustId == selectedId);
            if (selectedConsignee == null)
                return;

            MfgInvVMs.ShipAddrsId = selectedConsignee.AltCustId;
            MfgInvVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltCustAddr1, selectedConsignee.AltCustAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            MfgInvVMs.ShippingGstin = selectedConsignee.GSTNo ?? string.Empty;
            MfgInvVMs.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(MfgInvVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

