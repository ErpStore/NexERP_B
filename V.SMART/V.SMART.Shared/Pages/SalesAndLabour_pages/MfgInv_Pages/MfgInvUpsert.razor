    private async Task OnItemCancelChanged(MfgInvSubVM subitem)
    {
        try
        {
            if (MfgInvVMs.GrandTotal!=MfgInvVMs.Balance)
            {
                await _js.ToastrWarning("Item cannot be cancelled — Some transaction are already done.");
                return;
            }

            if (MfgInvVMs.IsCancel)
            {
                await _js.ToastrWarning("Item cannot be cancelled — Invoice  are already cancelled");
                return;
            }

            if ((subitem.Qty ?? 0) != (subitem.BalQty ?? 0))
            {
                await _js.ToastrError("Item cannot be cancelled — some transactions have been made on it.");
                return;
            }


            if (subitem.ItemId>0)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _js.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _js.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in Sales Invoice");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CancelItem(MfgInvSubVM rowToCancel)
    {
        if (rowToCancel == null) return;
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!rowToCancel.ItemCancel)
            {
                rowToCancel.ItemCancel = true;
                rowToCancel.ItemCancelReason = cancelReason;

                await mfgInvService.UpdateItemCancelAndAddorRevertAsync(rowToCancel,screenCode);

                await LoggingService.LogUserAction(
                username, machine, ip,
                screen: "Manufacturing Invoice",
                action: $"Cancelled Invoice No: {MfgInvVMs.InvNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }
            else
            {
                rowToCancel.ItemCancel = false;
                rowToCancel.ItemCancelReason = string.Empty;

                await mfgInvService.UpdateItemCancelAndAddorRevertAsync(rowToCancel,screenCode);

                await LoggingService.LogUserAction(
                username, machine, ip,
                screen: "Manufacturing Invoice",
                action: $"Reverted Invoice No: {MfgInvVMs.InvNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }

            MfgInvVMs.MfgSubInvVMs = await mfgInvService.GetInvoiceSubByInvIdAsync(MfgInvVMs.InvId);

            await ResetSlno();
            // Update totals
            await _calculationService.UpdateTotalsAsync(MfgInvVMs);

            var toastMessage = rowToCancel.ItemCancel
                ? "Item cancelled successfully."
                : "Item has been reverted successfully.";

            await _js.ToastrSuccess(toastMessage);
            rowToCancel = null;
            cancelReason = string.Empty;

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrWarning(ex.Message);
        }
        catch (Exception ex)
        {
            rowToCancel = null;
            await _js.ToastrError("An error occurred while cancelling/reverting the Item in Manufacturing Quotation Sales.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Reverse failed for InvId: {MfgInvVMs.InvId}");
        }
        finally
        {
            rowToCancel = null;
            isProcessing = false;
        }
    }

