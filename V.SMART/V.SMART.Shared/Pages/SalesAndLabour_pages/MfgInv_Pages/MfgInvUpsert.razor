    private async Task OnDcSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (MfgInvVMs.MfgSubInvVMs == null)
            MfgInvVMs.MfgSubInvVMs = new List<MfgInvSubVM>();

        int custId = MfgInvVMs.CustId.Value;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            var priceDict = await mfgInvService.GetBulkLastUnitPricesAsync(itemIds, custId);
            var LabourCost = await _CostingService.GetBulkLabourCostsAsync(itemIds);


            decimal balQty = 0;


            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefDcSubId = item.ContainsKey("DcSubId") && item["DcSubId"] != null
                    ? Convert.ToInt32(item["DcSubId"])
                    : (int?)null;

                if (item.TryGetValue("BalQty", out var balQtyValue))
                {
                    decimal.TryParse(balQtyValue?.ToString(), out balQty);
                }

                if (MfgInvVMs.MfgSubInvVMs.Any(x => x.ItemId == itemId && x.RefDcSubId == RefDcSubId))
                {

                    continue;
                }

                decimal poUnitPrice = TryDecimal(item, "PoUnitPrice");
                decimal poDiscPercent = TryDecimal(item, "PoLineDiscountPercent");
                decimal poDiscAmount = TryDecimal(item, "PoLineDiscountAmount");

                decimal poCgstRate = TryDecimal(item, "PoLineCGSTRate");
                decimal poSgstRate = TryDecimal(item, "PoLineSGSTRate");
                decimal poIgstRate = TryDecimal(item, "PoLineIGSTRate");

                 var gross = balQty * poUnitPrice;
                var recalculatedDiscount = (gross * poDiscPercent) / 100m;

                var subVm = new MfgInvSubVM
                {
                    RefDcSubId = RefDcSubId,
                    RefDcNo = item.ContainsKey("DcNo") ? item["DcNo"]?.ToString() : "",
                    RefDcDate = item.ContainsKey("DcDate") && item["DcDate"] != null
                        ? Convert.ToDateTime(item["DcDate"]): null,
                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    Qty = balQty,
                    BalQty = balQty,
                    CrBalQty=balQty,
                    UnitPrice =  priceDict.TryGetValue(itemId, out var price) ? price : poUnitPrice,
                    LabourCost=LabourCost.TryGetValue(itemId,out var Labourprice)? Labourprice : 0m,

                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,
                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",

                    Specification = item.ContainsKey("Specification") ? item["Specification"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("UOM") ? item["UOM"]?.ToString() : "",
                    HsnCode = item.ContainsKey("HSNCode") ? item["HSNCode"]?.ToString() : "",
                    DcBalQty=balQty,
                    Category = item.ContainsKey("Category") ? item["Category"]?.ToString() : "",

                    CreditNos = new List<string>(),    
                    CreditDates = new List<DateTime>(),

                    LineDiscountPercent = poDiscPercent,
                    LineDiscountAmount = recalculatedDiscount, 

                    LineCGSTRate = CommonConstants.GetGST(poCgstRate),
                    LineSGSTRate = CommonConstants.GetGST(poSgstRate),
                    LineIGSTRate = CommonConstants.GetIGST(poIgstRate),


                    IsEditable = true
                };

                MfgInvVMs.MfgSubInvVMs.Add(subVm);
                await _calculationService.UpdateTotalsAsync(MfgInvVMs);
            }

            int slNo = 1;
            foreach (var row in MfgInvVMs.MfgSubInvVMs)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnDcSelectedAsync failed.");
            await _js.ToastrError("Error processing selected Dc items.");
        }
    }

