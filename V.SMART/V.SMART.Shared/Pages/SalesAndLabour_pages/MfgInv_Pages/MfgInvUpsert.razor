            {
                await _js.ToastrWarning("Quotation not found.");
                return;
            }

            SelectedCustomer = await mfgInvService.GetCustomerByIdAsync(MfgInvVMs.CustId.Value);
            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

            if (MfgInvVMs.CurrId > 0)
                await ApplyCurrencyChange(MfgInvVMs.CurrId);

            foreach (var savedSub in MfgInvVMs.MfgSubInvVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[savedSub.ItemId] =
                    await mfgInvService.GetCorrespondenceAttachmentsCountAsync(savedSub.ItemId, "Item");

                if(MfgInvVMs.DcCumInv)
                {
                    savedSub.StockQty = await mfgInvService.GetStockQtyFromStockManager(savedSub.ItemId, MfgInvVMs.StoreIssId.Value);
                }

                 if(IsLabourCost)
                 {
                     if (savedSub.UnitPrice < savedSub.LabourCost)
                     {
                         _js.ToastrWarning( $"Unit Price ({savedSub.UnitPrice:0.00}) Is less than Labour Cost ({savedSub.LabourCost:0.00}).");
                     }
                     else if(savedSub.UnitPrice > savedSub.LabourCost)
                     {
                         _js.ToastrWarning( $"Unit Price ({savedSub.UnitPrice:0.00}) Is  Greater than than Labour Cost ({savedSub.LabourCost:0.00})." );

                     }

                 }

            }
            MfgInvVMs.SignedInvoiceQrCode =await mfgInvService.GenerateQrBase64(MfgInvVMs.SignedInvoiceQrCode);
            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
