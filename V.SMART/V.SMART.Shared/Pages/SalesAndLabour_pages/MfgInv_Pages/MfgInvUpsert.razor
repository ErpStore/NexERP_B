@page "/mfgInv/create"
@page "/mfgInv/create/{CustId:int}"
@page "/mfgInv/update/{InvId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IEInvoiceAPI
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ISalesService
@using V.SMART.Shared.Data.Master.MasterScreeenManagement_Module
@using V.SMART.Shared.Pages.Master_Module_pages.Currency_Pages
@using V.SMART.Shared.Pages.Master_Module_pages.Customer_Pages
@using V.SMART.Shared.Pages.Master_Module_pages.Items_Pages
@using V.SMART.Shared.Pages.Master_Module_pages.TermsAndConditions_Pages
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.MfgInvVM
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.QuotationVM
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IMfgInvService mfgInvService
@inject ILoggingService LoggingService

@inject NavigationManager _navigationManager
@inject IJSRuntime _js

@inject IEinvoiceDatabaseService _einvoiceService
@inject ICostingService _CostingService
@inject ReportService reportService
@inject UserSession session


<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="@(!MfgInvVMs.DcCumInv?"Dc Details":"PO Details")"
              Columns="@(!MfgInvVMs.DcCumInv?DcColumns:PoColumns)"
              ColumnFields="@(!MfgInvVMs.DcCumInv?DcFields:PoFields)"
              HiddenColumns="@(!MfgInvVMs.DcCumInv?DcHiddenColumns:PoHiddenColumns)"
              Data="@(!MfgInvVMs.DcCumInv?DcData:PoData)"
              IsVisible="@IsDcModalVisible"
              IsVisibleChanged="@((val) => IsDcModalVisible = val)"
              OnSelectedItems="@(!MfgInvVMs.DcCumInv?OnDcSelectedAsync:OnPoSelectedAsync)">
</DetailsModal>


<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isCustModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if(ActiveModal == "Terms")
    {
        <TermsUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }else if (ActiveModal == "Eway")
    {
         <EwayDcListModel isDcListDetailsModelVisible=true CustId=@MfgInvVMs.CustId.Value Customer=@MfgInvVMs.CustName DcType="MfgInv" OnClose="CloseModal" />
    }
</MasterModal>

<style>
    .freeze-last-col {
      position: sticky;
      right: 0;
      background-color: #f8f9fa;
      z-index: 10;
}
</style>


@if (isProcessing)
{
    <div class="position-fixed top-50 start-50 translate-middle d-flex align-items-center justify-content-center"
         style="width: 100vw; height: 100vh; background-color: rgba(255,255,255,0.5); z-index: 1050;">
        <img src="/_content/V.SMART.Shared/images/loading.gif" alt="Loading..." />
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{

    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if ((MfgInvVMs?.IsCancel ?? false))
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (MfgInvVMs?.PoShortClose == true)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }


            <PageHeader TitleText="@(MfgInvVMs.InvId > 0 ? "Update Mfg Invoice" : "Create Mfg Invoice")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@MfgInvFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="MfgInvVMs" OnValidSubmit="UpsertInvoic">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">

                        <div class="col-12 col-md-6 d-flex align-items-center justify-content-center">
                            
                                <div class="form-check form-switch small">

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="ManufacturingSwitch"
                                                checked="@MfgInvVMs.DcCumInv"
                                                @onchange="(e) => OnManufacturingToggle(e)" 
                                                disabled ="@IsSomeItemsTransMade"/>
                                        <label class="form-check-label fw-semibold @(MfgInvVMs.DcCumInv ? "text-success" : "")"
                                                for="ManufacturingSwitch">
                                            <i class="bi bi-gear-fill me-1"></i> Dc Cum Invoice
                                        </label>
                                    </div>

                                </div>
                                <ValidationMessage For="@(() => MfgInvVMs.DcCumInv)" />
                           
                        </div>
                       
                        <!-- Correspondence Status -->
                        <div class="col-12 col-md-6 d-flex align-items-center justify-content-end">
                            @if (MfgInvVMs.InvId > 0 && !string.IsNullOrWhiteSpace(MfgInvVMs.InvId.ToString()))
                            {
                                <CorrespondenceStatus 
                                    ReferenceType="Manufacturing-Invoice"
                                    ReferenceId="@MfgInvVMs.InvId"
                                    ReferenceTypeName="@MfgInvVMs.InvNo" />
                            }
                        </div>
                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Customer Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Customer")'>
                                        <i class="bi bi-person-add me-1"></i> Add Customer
                                    </button>
                                </div>

                                <div class="card-body">
                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="CustomerVM"
                                                                 Value="SelectedCustomer"
                                                                 ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                                 ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                                 SearchFunc="SearchCustomers"
                                                                 Dense="true"
                                                                 Variant="Variant.Outlined"
                                                                 Placeholder="Search Customer"
                                                                 Title="Search atleast 3 letters in Customer"
                                                                 Class="w-100 autocomplete-sm"
                                                                 MaxItems="50"
                                                                 Clearable="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 Required="true"
                                                                 AvoidSubmit="true" 
                                                                 Disabled="@IsSomeItemsTransMade"/>
                                        </div>
                                    </div>
                                    @if(!MfgInvVMs.DcCumInv)
                                    {
                                        <!-- Address -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Address</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                          rows="1" readonly>@MfgInvVMs?.CustAddress</textarea>
                                            </div>
                                        </div>

                                        <!-- Phone -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Phone No</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                       value="@MfgInvVMs?.ContactNo" readonly />
                                            </div>
                                        </div>

                                        <!-- GSTIN -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>GSTIN</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                       value="@MfgInvVMs?.GSTNo" readonly />
                                            </div>
                                        </div>
                                    }

                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                             <select class="form-select form-select-sm rounded-3 w-100"
                                                        @bind="@MfgInvVMs.KindOfAttention">
                                                    <option disabled value="">Select Contact Person</option>
                                                    @foreach (var cp in contactPersons)
                                                    {
                                                        <option value="@cp.ContactPersonName">@cp.ContactPersonName</option>
                                                    }
                                            </select>
                                            <ValidationMessage For="@(() => MfgInvVMs.KindOfAttention)" />
                                        </div>
                                    </div>

                                    <!-- Shipping Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Shipping Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="form-check form-switch d-flex align-items-center">
                                                <input class="form-check-input" type="checkbox" id="SameAsShipping"
                                                       checked="@MfgInvVMs.IsSameAsShipping"
                                                       @onchange="OnShippingChange" />
                                                <label class="form-check-label ms-2 fw-semibold"
                                                       for="SameAsShipping">Same as Shipping</label>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!MfgInvVMs.IsSameAsShipping)
                                    {
                                        <!-- Shipping To -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Shipping To</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select value="@MfgInvVMs.ShipAddrsId"
                                                        class="form-select form-select-sm rounded-3 w-100"
                                                        @onchange="OnConsigneeChangedAsync">
                                                    <option value="">Select Shipping Address</option>
                                                    @foreach (var consine in consineeAddress)
                                                    {
                                                        <option value="@consine.AltCustId">@consine.AltCustName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        @if (MfgInvVMs.ShipAddrsId > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Address</small>
                                                </label>
                                                <div class="col-12 col-lg-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@MfgInvVMs.ShippingAddress" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Contact No</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@MfgInvVMs.ShippingContactNo" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>GSTIN</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@MfgInvVMs.ShippingGstin" readonly />
                                                </div>
                                            </div>
                                        }
                                    }

                                    @if (MfgInvVMs.DcCumInv)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Mode Of Transport</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select class="form-select form-select-sm"
                                                        @bind="MfgInvVMs.TransportMode">
                                                    <option value="1">By Road</option>
                                                    <option value="2">By Railway</option>
                                                    <option value="3">By Airway</option>
                                                    <option value="4">By Seaway</option>
                                                </select>
                                                 <ValidationMessage For="@(() => MfgInvVMs.TransportMode)" />
                                            </div>
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Vehicle No</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputText class="form-control form-control-sm rounded-3 w-100" @bind-Value="MfgInvVMs.VehicleNo" />
                                            </div>
                                             <ValidationMessage For="@(() => MfgInvVMs.VehicleNo)" />
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Transport From</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputText class="form-control form-control-sm rounded-3 w-100" @bind-Value="MfgInvVMs.TransFrom" />
                                            </div>
                                             <ValidationMessage For="@(() => MfgInvVMs.TransFrom)" />
                                        </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Transport To</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputText class="form-control form-control-sm rounded-3 w-100" @bind-Value="MfgInvVMs.TransTo" />
                                            </div>
                                             <ValidationMessage For="@(() => MfgInvVMs.TransTo)" />
                                        </div>

                                         <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Driver No.</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputText class="form-control form-control-sm rounded-3 w-100" @bind-Value="MfgInvVMs.DriverNo" maxlength="13" />
                                            </div>
                                             <ValidationMessage For="@(() => MfgInvVMs.DriverNo)" />
                                        </div>

                                        <!-- Sub Supply Type -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Sub Supply Type</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select @bind="MfgInvVMs.SubSupplyType"
                                                        class="form-select form-select-sm rounded-3 w-100">
                                                                   
                                                    <option value="1">Supply</option
                                                    <option value="5">ForOwnUse</option>
                                                    <option value="8">Others</option>
                                                </select>
                                                <ValidationMessage For="@(() => MfgInvVMs.SubSupplyType)" />
                                            </div>
                                        </div>

                                        if (MfgInvVMs.SubSupplyType==8)
                                        {
                                                <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Sub Supply Desc.</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <textarea class="form-control form-control-sm rounded-3 w-100"
                                                                rows="1"
                                                                @bind="MfgInvVMs.SubSupplyDesc"></textarea>
                                                    <ValidationMessage For="@(() => MfgInvVMs.SubSupplyDesc)" />
                                                </div>
                                            </div>
                                        }


                                        <div class="accordion mb-3" id="transportAccordion">
                                            <div class="accordion-item border-0 shadow-sm rounded-3">
                                                <h2 class="accordion-header" id="headingTransport">
                                                    <button class="accordion-button collapsed fw-semibold text-primary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseTransport"
                                                            aria-expanded="false"
                                                            aria-controls="collapseTransport">
                                                        <i class="bi bi-truck me-2"></i> E-way and  Transport Details
                                                    </button>
                                                </h2>
                                                <div id="collapseTransport"
                                                     class="accordion-collapse collapse"
                                                     aria-labelledby="headingTransport"
                                                     data-bs-parent="#transportAccordion">
                                                    <div class="accordion-body">

                                                         <!-- E-Way Bill No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>E-Way Bill No</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <input type="text"
                                                                        class="form-control form-control-sm rounded-3 w-100"
                                                                        @bind="MfgInvVMs.EWayNo" />
                                                            </div>
                                                        </div>

                                                        <!-- E-Way Bill Date -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>E-Way Bill Date</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                                            @bind-Value="MfgInvVMs.EWayDate" />
                                                            </div>
                                                        </div>
                                                        
                                                         <!-- Transport ID -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>Transport ID</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="MfgInvVMs.TransId" />
                                                                <ValidationMessage For="@(() => MfgInvVMs.TransId)" />
                                                            </div>
                                                        </div>

                                                        <!-- Transport Doc No. -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>Transport Doc No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="MfgInvVMs.TransDocNo" />
                                                                <ValidationMessage For="@(() => MfgInvVMs.TransDocNo)" />
                                                            </div>
                                                        </div>

                                                        <!-- Transport Name -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>Transport Name</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="MfgInvVMs.TransName" />
                                                                <ValidationMessage For="@(() => MfgInvVMs.TransName)" />
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    }

                                    @if(!string.IsNullOrEmpty(MfgInvVMs.ACKNO) && !string.IsNullOrEmpty(MfgInvVMs.IRNNo))
                                    {
                                        <div class="accordion mb-3" id="transportEinvoice">
                                            <div class="accordion-item border-0 shadow-sm rounded-3">

                                                <h2 class="accordion-header" id="headingEInvoice">
                                                    <button class="accordion-button collapsed fw-semibold text-primary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseEInvoice"
                                                            aria-expanded="false"
                                                            aria-controls="collapseEInvoice">
                                                        <i class="bi bi-truck me-2"></i> E-Invoice Details
                                                    </button>
                                                </h2>

                                                <div id="collapseEInvoice"
                                                     class="accordion-collapse collapse"
                                                     aria-labelledby="headingEInvoice"
                                                     data-bs-parent="#transportEinvoice">

                                                    <div class="accordion-body">

                                                        <!-- ACK No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>ACK No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <input type="text"
                                                                       class="form-control form-control-sm rounded-3 w-100"
                                                                       @bind="MfgInvVMs.ACKNO"
                                                                       readonly />
                                                            </div>
                                                        </div>

                                                        <!-- ACK Date -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>ACK Date</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="MfgInvVMs.ACKNODate"
                                                                           disabled />
                                                            </div>
                                                        </div>

                                                        <!-- IRN No -->
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>IRN No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                           @bind-Value="MfgInvVMs.IRNNo" />
                                                                <ValidationMessage For="@(() => MfgInvVMs.IRNNo)" />
                                                            </div>
                                                        </div>

                                                        <!-- QR Code -->
                                                        <div class="mb-2 row align-items-center">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>QR Code</small>
                                                            </label>

                                                            <div class="col-12 col-sm-9">
                                                                @if (!string.IsNullOrEmpty(MfgInvVMs.SignedInvoiceQrCode))
                                                                {
                                                                     <img src="@($"data:image/png;base64,{MfgInvVMs.SignedInvoiceQrCode}")"
                                                                         class="bg-white p-2"
                                                                         style="width:150px;height:auto;" />
                                                                }
                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    }

                                </div>
                            </div>
                        </div>

                        <!-- =================== Invoice Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Invoice Details</span>
                                    @if (MfgInvVMs.InvId > 0 && (MfgInvVMs.MfgSubInvVMs == null || !MfgInvVMs.MfgSubInvVMs.Any(x => x.ItemCancel)) && (CanCreate || CanEdit) )
                                    {
                                        <button type="button"
                                                class="btn btn-sm rounded-3 @(MfgInvVMs.IsCancel ? "btn-success" : "btn-danger")"
                                                 @onclick="Cancel">

                                            @if (!MfgInvVMs.IsCancel)
                                            {
                                                <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                            }
                                        </button>

                                        <!-- Short Close / Reopen Button -->
                                        <button type="button"
                                                class="btn btn-sm rounded-3 @(MfgInvVMs.PoShortClose ? "btn-success" : "btn-warning")"
                                                @onclick="() => AskToShortCloseAsync(MfgInvVMs)"
                                                disabled="@MfgInvVMs.IsCancel">

                                            @if (!MfgInvVMs.PoShortClose)
                                            {
                                                <i class="bi bi-box-seam me-1"></i> <span>Short Close</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Re-Open</span>
                                            }
                                        </button>

                                    }
                                </div>

                                <div class="card-body">

                                     <div class="row mb-2">
                                        <div class="col-12 d-flex justify-content-end">
                                            <div class="form-check d-flex align-items-center gap-2">
                                                    <input type="checkbox"
                                                        class="form-check-input"
                                                        style="border:2px solid #000;"
                                                        @bind="MfgInvVMs.IsManualInvNo" @onclick="()=>ToggleAutoInvNo()" readonly="@MfgInvVMs.InvId>0" />
                                                <label class="form-check-label text-dark">
                                                    <small>Is Manual Invoice No.</small>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Invoice No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Invoice No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Prefix"
                                                            maxlength="10"
                                                            @bind-Value="@MfgInvVMs.Prefix"
                                                            style="flex:0 0 130px;" />

                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Invoice No."
                                                            maxlength="30"
                                                            @bind-Value="@MfgInvVMs.InvNo" 
                                                            readonly="@IsInvNoReadonly" />

                                                <span class="input-group-text rounded-3">@MfgInvVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => MfgInvVMs.Prefix)" />
                                            <ValidationMessage For="@(() => MfgInvVMs.InvNo)" />
                                        </div>
                                    </div>

                                    <!-- Invoice Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Invoice Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                        @bind-Value="@MfgInvVMs.InvDate" />
                                            <ValidationMessage For="@(() => MfgInvVMs.InvDate)" />
                                        </div>
                                    </div>

                                     

                                     <!-- Reference Dc -->
                                    @if(DcPendingCount >0)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Our DC</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowDcDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Dc Details
                                                </button>
                                            </div>
                                        </div>
                                    }else if(PoPendingCount >0)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. Po</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowPoDetails">
                                                    <i class="bi bi-list-ul me-1"></i> PO Details
                                                </button>
                                            </div>
                                        </div>

                                    }else
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <span class="text-danger align-items-center">
                                                    @((MfgInvVMs.DcCumInv) ? "No Pending Po's Found" : "No Pending Dc's Found")
                                                </span>
                                            </div>
                                        </div>

                                    }
                                    

                                    <!-- Currency -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Currency</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value="@MfgInvVMs.CurrId"
                                                    @onchange="OnCurrencyChanged"
                                                    disabled>
                                                @foreach (var currency in Currencies)
                                                {
                                                    <option value="@currency.CurrId">@currency.CurrName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    @if(MfgInvVMs.DcCumInv)
                                    {
                                        <div class="mb-2 row mt-1">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Issue From Store</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select value="@MfgInvVMs.StoreIssId"
                                                        @onchange="OnStoreChanged"
                                                        class="form-select form-select-sm rounded-3 w-100">
                                                    <option value="0" selected>--Select Store--</option>

                                                    @if (stores != null)
                                                    {
                                                        foreach (var store in stores)
                                                        {
                                                            <option value="@store.StoreId">@store.StoreName</option>
                                                        }
                                                    }
                                                </select>
                                                <ValidationMessage For="@(() => MfgInvVMs.StoreIssId)" />
                                            </div>
                                        </div>

                                    }
                                    <!-- Payment Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Payment Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="MfgInvVMs.PayTerms"></textarea>
                                            <ValidationMessage For="@(() => MfgInvVMs.PayTerms)" />
                                        </div>
                                    </div>

                                    <!-- Delivery Terms -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Delivery Terms</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="MfgInvVMs.DeliveryTems"></textarea>
                                            <ValidationMessage For="@(() => MfgInvVMs.DeliveryTems)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="MfgInvVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => MfgInvVMs.MainRemark)" />
                                        </div>
                                    </div>
                                    
                                    @if (MfgInvVMs.InvId>0)
                                    {
                                        <div class="accordion mb-3" id="TdsAccordion">
                                            <div class="accordion-item border-0 shadow-sm rounded-3">
                                                <h2 class="accordion-header" id="headingTDS">
                                                    <button class="accordion-button collapsed fw-semibold text-primary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseTDS"
                                                            aria-expanded="false"
                                                            aria-controls="collapseTDS">
                                                            TDS Details
                                                    </button>
                                                </h2>
                                                <div id="collapseTDS"
                                                     class="accordion-collapse collapse"
                                                     aria-labelledby="headingTransport"
                                                     data-bs-parent="#transportAccordion">
                                                    <div class="accordion-body">

                                                        
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>TDS Amount (In ₹) </small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                               <div class="d-flex align-items-center">
                                                                    <input type="number" step="any"
                                                                           class="form-control form-control-sm rounded-3"
                                                                           @bind="MfgInvVMs.TDSAmount" />
                                                                </div>
                                                                <ValidationMessage For="@(() => MfgInvVMs.TDSAmount)" />
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center mt-1 ">

                                                        <!-- Center Button Wrapper -->
                                                        <div class="flex-grow-1 d-flex justify-content-center">
                                                            <button type="button" class="btn btn-sm fw-semibold mb-2"
                                                                    style="background-color:#ffca2c; color:black; border-radius:8px;" @onclick="TDS">
                                                                <span class="me-2"> <i class="bi bi-currency-rupee"></i></span>
                                                                <span class="me-2"> <i class="bi bi-dash-circle"></i> </span>
                                                                Deduct TDS
                                                            </button>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @if (MfgInvVMs.InvId>0)
                                    {
                                        <div class="accordion mb-3" id="LcAccordion">
                                            <div class="accordion-item border-0 shadow-sm rounded-3">
                                                <h2 class="accordion-header" id="headingLc">
                                                    <button class="accordion-button collapsed fw-semibold text-primary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseLc"
                                                            aria-expanded="false"
                                                            aria-controls="collapseLc">
                                                            LC Details
                                                    </button>
                                                </h2>
                                                <div id="collapseLc"
                                                     class="accordion-collapse collapse"
                                                     aria-labelledby="headingLc"
                                                     data-bs-parent="#transportAccordion">
                                                    <div class="accordion-body">

                                                        
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>LC No.</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                               <div class="d-flex align-items-center">
                                                                    <input type="text"
                                                                           class="form-control form-control-sm rounded-3"
                                                                           @bind="MfgInvVMs.LcNo" />
                                                                </div>
                                                                <ValidationMessage For="@(() => MfgInvVMs.LcNo)" />
                                                            </div>
                                                        </div>
                                                         <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>Lc Date</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputDate class="form-control form-control-sm rounded-3"
                                                                            @bind-Value="@MfgInvVMs.LcDate" />
                                                                <ValidationMessage For="@(() => MfgInvVMs.LcDate)" />
                                                            </div>
                                                        </div>
                                                        <div class="mb-2 row">
                                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                                <small>Lc Expiry Date</small>
                                                            </label>
                                                            <div class="col-12 col-sm-9">
                                                                <InputDate class="form-control form-control-sm rounded-3"
                                                                            @bind-Value="@MfgInvVMs.LcExpiryDate" />
                                                                <ValidationMessage For="@(() => MfgInvVMs.LcExpiryDate)" />
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center mt-1 ">

                                                        <!-- Center Button Wrapper -->
                                                        <div class="flex-grow-1 d-flex justify-content-center">
                                                            <button type="button" class="btn btn-sm fw-semibold mb-2"
                                                                    style="background-color:#5ba4cf;color:white; border-radius:8px;" @onclick="LcDetails">
                                                                
                                                                <span class="me-2"> <i class="bi bi-dash-circle"></i> </span>
                                                                Update LC Details
                                                            </button>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Cancel Remarks -->
                                    @if(MfgInvVMs.IsCancel)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="MfgInvVMs.CancelReason"
                                                            disabled></textarea>
                                                <ValidationMessage For="@(() => MfgInvVMs.CancelReason)" />
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <!-- Discount Toggle -->
                                        <div class="d-flex align-items-center">
                                            <label class="me-2 mb-0"><small>Discount : </small></label>
                                            <div class="btn-group btn-group-sm rounded-pill border" role="group" aria-label="Toggle Discount Rs and %">
                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountToggleRs" 
                                                        @onchange='() => SetDiscountMode(true)' 
                                                        checked="@MfgInvVMs.IsItemWiseDiscAmtOrPerReq" />
                                                <label class="btn btn-outline-primary rounded-start-pill" for="discountToggleRs">@MfgInvVMs.Symbol</label>

                                                <input type="radio" class="btn-check" name="toggleDiscount" id="discountTogglePercent" 
                                                        @onchange='() => SetDiscountMode(false)' 
                                                        checked="@(!MfgInvVMs.IsItemWiseDiscAmtOrPerReq)" />
                                                <label class="btn btn-outline-primary rounded-end-pill" for="discountTogglePercent">%</label>
                                            </div>
                                        </div>

                                       @*  <!-- Add Item Button -->
                                        <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                            <i class="bi bi-plus-circle me-1"></i> Create New Item
                                        </button> *@
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:90px;">HSNCODE</th>
                                                    @if(IsLabourCost)
                                                    {
                                                    <th style="width:100px;">Labour Cost</th>
                                                    }
                                                    <th style="width:120px;">Qty</th>
                                                    <th style="width:120px;">Price</th>
                                                    <th style="width:130px;">Gross Amount</th>

                                                    @if (!MfgInvVMs.IsItemWiseDiscAmtOrPerReq)
                                                    {
                                                        <th style="width:110px;">Disc %</th>
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }

                                                    @if (SelectedCustomer?.TaxValidate == false)
                                                    {
                                                        @if (SelectedCustomer?.BusiType == "Local")
                                                        {
                                                            <th style="width:110px;">CGST %</th>
                                                            <th style="width:110px;">SGST %</th>
                                                        }
                                                        else if(SelectedCustomer?.BusiType == "InterState")
                                                        {
                                                            <th style="width:110px;">IGST %</th>
                                                        }
                                                    }

                                                    <th style="width:130px;">Basic Amount</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    @if(!MfgInvVMs.DcCumInv)
                                                    {
                                                         <th style="width:110px;"> Dc Bal Qty</th>
                                                         <th style="width:110px;">Ref Dc No.</th>
                                                        <th style="width:110px;">Ref Dc Date</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:110px;">Stock Qty</th>
                                                        <th style="width:110px;"> PO Bal Qty</th>
                                                        <th style="width:110px;">Ref PO No.</th>
                                                        <th style="width:110px;">Ref PO Date</th>
                                                        <th style="width:110px;">Type Of PO</th>
                                                    }

                                                    <th style="width:150px;">Cost-Center</th>

                                                    @if (MfgInvVMs?.MfgSubInvVMs?.Any(x=>x?.CreditNos!=null && x.CreditNos.Count>0)==true)
                                                    {
                                                        <th style="width:150px;">CreditNote No.</th> 
                                                        <th style="width:150px;">CreditNote Date</th>
                                                    }

                                                   
                                                    
                                                   @*  @if (!MfgInvVMs.IsCancel)
                                                    {
                                                        <th style="width:130px;">Item Cancel</th>
                                                    } *@
                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">

                                                @if (MfgInvVMs.MfgSubInvVMs != null && MfgInvVMs.MfgSubInvVMs.Any())
                                                {
                                                @foreach (var subitem in MfgInvVMs.MfgSubInvVMs)
                                                {
                                                    <tr @key="subitem" class="@(subitem.ItemCancel ? "table-danger text-danger fw-bold" : "")">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                        @subitem.ItemCode
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId!=0 && subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                        Size="Size.Small"
                                                                                        Color="Color.Primary"
                                                                                        OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId, count))"
                                                                                        Edge="Edge.End"
                                                                                        Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.MeasureUnit</td>
                                                        <td>@subitem.HsnCode</td>
                                                         @if(IsLabourCost)
                                                        {
                                                            <td>@subitem.LabourCost</td>
                                                        }

                                                        <!-- Qty -->
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                  <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           step="any"
                                                                           placeholder="Qty"
                                                                           title="Enter Quantity"
                                                                           @bind="subitem.Qty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))"  />
                                                                <ValidationMessage For="@(() => subitem.Qty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.Qty</span>
                                                            }
                                                        </td>

                                                        <!-- Unit Price -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm"  step="any" placeholder="Price" title="Enter Unit Price"
                                                                        @bind="subitem.UnitPrice" @bind:event="oninput"
                                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(MfgInvVMs)' />
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>

                                                        <!-- Line Gross -->
                                                        <td>@FormatDecimal(subitem.LineGross)</td>

                                                        <!-- Discount -->
                                                        @if (!MfgInvVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm"  step="any" placeholder="Disc %" title="Enter Discount %"
                                                                            @bind="subitem.LineDiscountPercent" @bind:event="oninput"
                                                                            @bind:after='() => OnLineDiscountPercentChanged(subitem)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountPercent)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountPercent)
                                                                }
                                                            </td>
                                                            <td>@FormatDecimal(subitem.LineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" placeholder="Disc Amt" step="any" title="Enter Discount Amount"
                                                                            @bind="subitem.LineDiscountAmount" @bind:event="oninput"
                                                                            @bind:after='() => _calculationService.UpdateTotalsAsync(MfgInvVMs)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountAmount)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountAmount)
                                                                }
                                                            </td>
                                                        }

                                                        <!-- Taxes -->
                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if (SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                            <option value="" disabled selected>CGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineCGSTRate)
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                            <option value="" disabled selected>SGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineSGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                            else if (SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @bind="subitem.LineIGSTRate" @bind:event="oninput"
                                                                                @bind:after='() => _calculationService.UpdateTotalsAsync(MfgInvVMs)'>
                                                                            <option value="" disabled selected>IGST %</option>
                                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineIGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                        }

                                                        <!-- Basic Amount -->
                                                        <td>@FormatDecimal(subitem.LineBasicAmount)</td>

                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.Remarks" class="form-control form-control-sm" placeholder="Enter Remarks" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.Remarks
                                                            }
                                                        </td>
                                                        @if(!MfgInvVMs.DcCumInv)
                                                        {
                                                             <!-- Ref Enquiry -->
                                                             <td>@subitem.DcBalQty</td>
                                                            <td>@subitem.RefDcNo</td>
                                                            <td>@subitem.RefDcDate?.ToString("dd/MM/yyyy")</td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-danger">@subitem.StockQty</td>
                                                            <td>@subitem.PoBalQty</td>
                                                            <td>@subitem.RefPoNo</td>
                                                            <td>@subitem.RefPoDate?.ToString("dd/MM/yyyy")</td>
                                                            <td>General Po</td> 
                                                        }


                                                        <!-- Cost Center -->
                                                        <td>
                                                            @if (subitem.IsEditable && (subitem.RefDcSubId == 0 || subitem.RefDcSubId == null) && subitem.Qty == subitem.BalQty)
                                                            {
                                                                <select class="form-select form-select-sm" 
                                                                    value="@subitem.CostId"
                                                                    @onchange="(e => OnCostCenterChanged(e, subitem))">
                                                                    <option value="">select CostCentre</option>
                                                                    @foreach (var cost in CostCenterVMs.Where(c =>
                                                                        !MfgInvVMs.MfgSubInvVMs.Any(r => r != subitem && r.CostId == c.Id)))
                                                                    {
                                                                        <option value="@cost.Id">@cost.ProjectNo</option>
                                                                    }
                                                                </select>
                                                                <ValidationMessage For="@(() => subitem.CostId)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.ProjectNo
                                                            }
                                                        </td>

                                                        @if(MfgInvVMs?.MfgSubInvVMs?.Any(x=>x?.CreditNos!=null && x.CreditNos.Count>0)==true)
                                                        {
                                                             <td>@string.Join(", ", subitem.CreditNos)</td>
                                                             <td>@string.Join(", ", subitem.CreditDates.Select(d => d.ToString("dd/MM/yyyy")))</td>
                                                        }

                                                       @*  @if (!MfgInvVMs.IsCancel)
                                                        {
                                                            <td class="text-center align-middle">
                                                                <div class="form-check form-switch d-flex justify-content-center">
                                                                    <InputCheckbox @bind-Value="subitem.ItemCancel"
                                                                    @bind-Value:event="onchange"
                                                                    ValueChanged="@(async (value) => await OnItemCancelChanged(subitem))"
                                                                    class="form-check-input border border-2 shadow-lg 
                                                                                        focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                                </div>
                                                                <ValidationMessage For="@(() => subitem.ItemCancel)"
                                                                class="text-danger fw-semibold small mt-2 d-block" />
                                                            </td>
                                                        }
 *@
                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            @if (!MfgInvVMs.IsCancel)
                                                            {
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                            @onclick="async () => await SaveRow(subitem)">
                                                                        <i class="bi bi-check-lg"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                            @onclick="async () => await CancelEdit(subitem, MfgInvVMs)">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit" 
                                                                            @onclick="async () => await EditRowAsync(subitem)">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete" 
                                                                            @onclick="async () => await RemoveRow(subitem)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                }
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="22" style="height:150px;" class="text-center align-middle text-muted fs-6 fw-semibold">
                                                            <div class="d-flex justify-content-center align-items-center" style="min-height:100px;">
                                                                <i class="bi bi-info-circle me-2 text-secondary"></i>
                                                                No items to display
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (MfgInvVMs.MfgSubInvVMs?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        <td colspan="6" class="text-end fw-bold">Totals:</td>
                                                        <td>@MfgInvVMs.TotalQty</td>
                                                        <td>Avg: @FormatDecimal(MfgInvVMs.AvgUnitPrice)</td>
                                                        <td>@FormatDecimal(MfgInvVMs.TotalLineGross)</td>

                                                        @if (!MfgInvVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td></td>
                                                            <td>@FormatDecimal(MfgInvVMs.TotalLineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@FormatDecimal(MfgInvVMs.TotalLineDiscountAmount)</td>
                                                        }

                                                        @if (SelectedCustomer?.TaxValidate == false)
                                                        {
                                                            @if(SelectedCustomer?.BusiType == "Local")
                                                            {
                                                                <td></td>
                                                                <td></td>

                                                            }
                                                            else if(SelectedCustomer?.BusiType == "InterState")
                                                            {
                                                                <td></td>

                                                            }

                                                        }

                                                        <td>@FormatDecimal(MfgInvVMs.TotalLineBasicAmount)</td>
                                                        @if(MfgInvVMs?.MfgSubInvVMs?.Any(x=>x?.CreditNos!=null && x.CreditNos.Count>0)==true)
                                                        {
                                                             <td colspan="9"></td>

                                                        }else{
                                                             <td colspan="7"></td>
                                                        }
                                                       
                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>
                                  @* 
                                    @if(!MfgInvVMs.IsCancel)
                                    {
                                        <div class="mt-2 text-start">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>
                                    } *@
                                </div>
                            </div>
                        </div>

                          <!-- ===================Other Details Terms and Conditions ===================-->
                        <div class="col-12 col-lg-6 mb-3">
                            
                        </div>

                        <!-- =================== Tax Details Section =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm rounded-4 border-0 p-3">

                                <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Tax & Charges
                                </h6>

                                <!-- Total Gross -->
                                <div class="row mb-2 gx-3">
                                    <label for="TotalGross" class="col-5 col-md-4 col-form-label text-dark">
                                        <small>Total Gross</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input id="TotalGross"
                                               class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               value="@FormatDecimal(MfgInvVMs.TotalGrossAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Discount -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Discount</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="discountToggle" id="discountRs"  step="any"
                                                   @onchange="() => SetDiscountType(true)"
                                                   checked="@MfgInvVMs.DiscAmtOrPer"
                                                   disabled="@(MfgInvVMs.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountRs">
                                                <small>@MfgInvVMs.Symbol</small>
                                            </label>

                                            <input type="radio" class="btn-check" name="discountToggle" id="discountPercent"  step="any"
                                                   @onchange="() => SetDiscountType(false)"
                                                   checked="@(!MfgInvVMs.DiscAmtOrPer)"
                                                   disabled="@(MfgInvVMs.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountPercent"><small>%</small></label>
                                        </div>
                                    </div>

                                    <div class="col-3 col-md-5">
                                        @if (MfgInvVMs.DiscAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number"
                                                   @bind="MfgInvVMs.DiscountAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgInvVMs)'
                                                   disabled="@(MfgInvVMs.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => MfgInvVMs.DiscountAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number"
                                                   @bind="MfgInvVMs.DiscountPercent"
                                                   @bind:after="OnDiscountPercentChanged"
                                                   disabled="@(MfgInvVMs.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => MfgInvVMs.DiscountPercent)" />
                                            <small class="text-muted d-block text-end">
                                                Amt: @FormatDecimal(MfgInvVMs.DiscountAmount)
                                            </small>
                                        }
                                    </div>
                                </div>

                                <!-- SubTotal -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>SubTotal</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number" 
                                               value="@FormatDecimal(MfgInvVMs.TotalBasicAmount)" 
                                               readonly />
                                    </div>
                                </div>

                                <!-- Freight Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Freight Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                               type="number" @bind="MfgInvVMs.FreightCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(MfgInvVMs)' />
                                        <ValidationMessage For="@(() => MfgInvVMs.FreightCharges)" />
                                    </div>
                                </div>

                                <!-- P & F Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>P & F Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="packingToggle" id="packingToggleRs"
                                                   @onchange="() => SetPAndFType(true)" checked="@MfgInvVMs.PackingAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="packingToggleRs"><small>@MfgInvVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="packingToggle" id="packingTogglePercent"
                                                   @onchange="() => SetPAndFType(false)" checked="@(!MfgInvVMs.PackingAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="packingTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (MfgInvVMs.PackingAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="MfgInvVMs.PackingCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgInvVMs)' />
                                            <ValidationMessage For="@(() => MfgInvVMs.PackingCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="MfgInvVMs.PackingPercent"
                                                   @bind:after="() => OnPandFPercentChanged()" />
                                            <ValidationMessage For="@(() => MfgInvVMs.PackingPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(MfgInvVMs.PackingCharges) </small>
                                        }
                                    </div>
                                </div>

                                <!-- Insurance Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Insurance Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceToggleRs"
                                                   @onchange="() => SetInsuranceType(true)" checked="@MfgInvVMs.InsuranceAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="insuranceToggleRs"><small>@MfgInvVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceTogglePercent"
                                                   @onchange="() => SetInsuranceType(false)" checked="@(!MfgInvVMs.InsuranceAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="insuranceTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (MfgInvVMs.InsuranceAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="MfgInvVMs.InsuranceCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgInvVMs)' />
                                            <ValidationMessage For="@(() => MfgInvVMs.InsuranceCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="MfgInvVMs.InsurancePercent"
                                                   @bind:after="() => OnInsurancePercentChanged()" />
                                            <ValidationMessage For="@(() => MfgInvVMs.InsurancePercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(MfgInvVMs.InsuranceCharges)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Total Taxable -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Total Taxable</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               value="@FormatDecimal(MfgInvVMs.TotalTaxable)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Taxes (CGST/SGST/IGST) -->
                                @if (SelectedCustomer?.TaxValidate == false)
                                {
                                    <div class="mb-2">
                                        @if (SelectedCustomer?.BusiType == "Local")
                                        {
                                            <!-- CGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>CGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!MfgInvVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="MfgInvVMs.CGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(MfgInvVMs.CGstRate)">
                                                            <option value="0">-- Select CGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => MfgInvVMs.CGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(MfgInvVMs.TotalCGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>

                                            <!-- SGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>SGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!MfgInvVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="MfgInvVMs.SGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(MfgInvVMs.SGstRate)">
                                                            <option value="0">-- Select SGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => MfgInvVMs.SGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(MfgInvVMs.TotalSGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                        else if (SelectedCustomer?.BusiType == "InterState")
                                        {
                                            <!-- IGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>IGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!MfgInvVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="MfgInvVMs.IGstRate"
                                                                @bind:after="() => _calculationService.UpdateTotalsAsync(MfgInvVMs)"
                                                                disabled="@(SelectedCustomer?.TaxValidate == true)">
                                                            <option value="0">-- Select IGST % --</option>
                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => MfgInvVMs.IGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(MfgInvVMs.TotalIGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- TCS Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>TCS Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsToggleRs"
                                                   @onchange="() => SetTCSType(true)" checked="@MfgInvVMs.TCSAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="tcsToggleRs"><small>@MfgInvVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsTogglePercent"
                                                   @onchange="() => SetTCSType(false)" checked="@(!MfgInvVMs.TCSAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="tcsTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (MfgInvVMs.TCSAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="MfgInvVMs.TCSAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(MfgInvVMs)' />
                                            <ValidationMessage For="@(() => MfgInvVMs.TCSAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="MfgInvVMs.TCSPercent"
                                                   @bind:after="() => OnTCSPercentChanged()" />
                                            <ValidationMessage For="@(() => MfgInvVMs.TCSPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @MfgInvVMs.TCSAmount</small>
                                        }
                                    </div>
                                </div>

                                <!-- Other Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Other Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="MfgInvVMs.OtherCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(MfgInvVMs)' />
                                        <ValidationMessage For="@(() => MfgInvVMs.OtherCharges)" />
                                    </div>
                                </div>

                                <!-- Round Off -->
                                <div class="row mb-2 gx-2 align-items-center">
                                    <div class="col-5 col-md-4 d-flex align-items-center">
                                        <small class="me-2 text-dark">Round Off</small>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="roundOffSwitch"
                                                   @bind="MfgInvVMs.IsRoundOffEnabled"
                                                   @bind:after="() => _calculationService.UpdateTotalsAsync(MfgInvVMs)" >
                                            <label class="form-check-label" for="roundOffSwitch"></label>
                                        </div>
                                    </div>
                                    <div class="col-7 col-md-8">
                                       <input class="form-control form-control-sm rounded-3 text-end"
                                               value="@FormatDecimal(MfgInvVMs.RoundOff)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Grand Total -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label fw-bold text-dark">
                                        <small>Grand Total</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                               value="@FormatDecimal(MfgInvVMs.GrandTotal)"
                                               readonly />
                                        @if (MfgInvVMs.CurrId > 1)
                                        {
                                            <div class="mt-1 text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @MfgInvVMs.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((MfgInvVMs.GrandTotal * MfgInvVMs.TodayVal).ToString("0.00"))
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Amount in Words -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Amount in Words</small></label>
                                    <div class="col-7 col-md-8 pt-1">
                                        @if (MfgInvVMs.CurrId > 1)
                                        {
                                            <small class="fw-bold text-success d-block">
                                                Converted Value in Rs: @FormatDecimal(MfgInvVMs.GrandTotal * MfgInvVMs.TodayVal)
                                            </small>
                                        }
                                        else
                                        {
                                            <strong>@NumberToWordsHelper.ConvertNumberToWords(MfgInvVMs.GrandTotal)</strong>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            @if(!MfgInvVMs.IsCancel)
                            {
                                 <div class="col-2 col-md-3 mt-3">
                                    <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                        <i class="bi bi-floppy2-fill me-1"></i> @(MfgInvVMs.InvId > 0 ? "Update" : "Create")
                                    </button>
                                </div>
                            }
                           
                        }

                        @if(MfgInvVMs.InvId>0 && string.IsNullOrEmpty(MfgInvVMs.EWayNo) && MfgInvVMs.DcCumInv)
                        {
                                <div class="col-2 col-md-3 mt-3">
                                <button type="button" class="btn  btn-success w-100 rounded-3 rounded-3" @onclick='() => OpenModal("Eway")'>
