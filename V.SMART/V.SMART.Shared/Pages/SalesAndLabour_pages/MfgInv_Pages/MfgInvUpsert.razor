    private async Task UpsertInvoic()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            MfgInvVMs.MfgSubInvVMs.RemoveAll(x => x.ItemId!=0 && (!x.Qty.HasValue || x.Qty == 0) && (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!MfgInvVMs.MfgSubInvVMs.Any())
            {
                await _js.ToastrError("Cannot save a Invoice without valid items.");
                return;
            }
            bool main=await ValidateMainTable();
            if (!main) return;

            // Validate each line
            foreach (var line in MfgInvVMs.MfgSubInvVMs)
            {
                bool isValid = await ValidateInvoiceLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewQuote = MfgInvVMs.InvId == 0;
            if(isNewQuote)
            {
                var isduplicate = await mfgInvService.IsDuplicateMfgInvoiceNoAsync(MfgInvVMs.InvNo, MfgInvVMs.Suffix, MfgInvVMs.InvId, MfgInvVMs.CustId);

                if (isduplicate)
                {
                    await _js.ToastrWarning("This Export Invoice number already exists for the selected customer. Please verify and try again.");
                    return;
                }
            }


            try
            {
                await mfgInvService.UpsertInvoiceAsync(MfgInvVMs,screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewQuote)
                await _js.ToastrSuccess("Invoice saved successfully.");
            else
                await _js.ToastrSuccess("Invoice updated successfully.");
                
            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/mfgInvList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertInvoic failed.");
            await _js.ToastrError("Error saving Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateMainTable()
    {
        try
        {
            var errors = new List<string>();

            if (string.IsNullOrWhiteSpace(MfgInvVMs.InvNo))
            {
                errors.Add($"Please enter the Invoice number");

            }

            if (MfgInvVMs.CustId==0)
            {
                errors.Add($"Please select  Customer");

            }

            if(MfgInvVMs.DcCumInv)
            {
                if (MfgInvVMs.StoreIssId==0)
                {
                    errors.Add($"Please select  Issue store. ");

                }
                if(string.IsNullOrEmpty(MfgInvVMs.TransportMode.ToString()))
                {
                    errors.Add($"Please select  Mode Of Transport");

                }
                if(string.IsNullOrEmpty(MfgInvVMs.VehicleNo))
                {
                    errors.Add($"Please enter valid Vehicle No");

                }
                if(string.IsNullOrEmpty(MfgInvVMs.TransFrom))
                {
                    errors.Add($"Please enter valid Transport From");

                }
                if(string.IsNullOrEmpty(MfgInvVMs.TransTo))
                {
                    errors.Add($"Please enter valid Transport To");

                }
                if(string.IsNullOrEmpty(MfgInvVMs.SubSupplyType.ToString()))
                {
                    errors.Add($"Please select valid Sub Supply Type");

