            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while AskToShortCloseAsync enquiry.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }

    }

    private async Task ShortClose()
    {
        if (MfgInvVMs == null)
        {
            await _js.ToastrError("No Manufacturing Invoice selected.");
            return;
        }
        try
        {
            isProcessing = true;
            MfgInvVMs.PoShortClose = !MfgInvVMs.PoShortClose;
            await mfgInvService.UpdateMfgInvShortCloseAsync(MfgInvVMs);
            StateHasChanged();

            string msg = MfgInvVMs.PoShortClose
                 ? "Manufacturing Invoice ShortClose Successfully!"
                 : "Manufacturing Invoice ReOpen Successfully!";
            await _js.ToastrSuccess(msg);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while updating ShortClose.Manufacturing Invoice");
            await LoggingService.LogDeveloperError(ex, "Error in ShortClose() Manufacturing Invoice");
        }
        finally
        {
            isProcessing = false;
        }
    }


    //-------------E-Invoice------------------------
    private async Task ConfirmEinvoice()
    {
        try
        {
            if(await mfgInvService.CheckPrefixValid(ScreenName)  && string.IsNullOrEmpty(MfgInvVMs.Prefix))
            {
                await _js.ToastrWarning($"Prefix is required for the {ScreenName}  number because 'Prefix Required' is enabled in Screen Management.");
                return;
            }

            if(await mfgInvService.CheckPrefixValid(ScreenName) && MfgInvVMs.DcCumInv)
            {
                if (string.IsNullOrEmpty(MfgInvVMs.TransId))
                {
                    await _js.ToastrWarning("Eway Transaction ID Should Not be Empty");
                    return;
                }else if (string.IsNullOrEmpty(MfgInvVMs.TransName))
                {
                    await _js.ToastrWarning("Eway Transaction Name Should Not be Empty");
                    return;
                }else if (MfgInvVMs.TransportMode<=0)
                {
                    await _js.ToastrWarning("Eway Mode of Transportation Should Not be");
                    return;
                }
                else if (string.IsNullOrEmpty(MfgInvVMs.VehicleNo))
                {
                    await _js.ToastrWarning("Vehicle No. Should Not be Empty");
                    return;
                }
            }

            ModalTitle = "Are you sure you want to generate the E-Invoice for this invoice?";
            btnColor = "btn-success";
            btnText = "Yes!";
            confirmation = "EInvoice";

            await _js.InvokeVoidAsync("ShowConfirmationModal");

        }
        catch (Exception ex)
        {

            throw;
        }   
    }

