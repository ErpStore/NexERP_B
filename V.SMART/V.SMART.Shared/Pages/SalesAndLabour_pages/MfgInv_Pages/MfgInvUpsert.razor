    private async Task Cancel()
    {
        try
        {
            if (MfgInvVMs.GrandTotal!=MfgInvVMs.Balance)
            {
                await _js.ToastrWarning("Invoice cannot be cancelled — Some transaction are already done.");
                return;
            }

            if (!InvId.HasValue || InvId == 0)
            {
                await _js.ToastrWarning("MfgInvoice  cancel is not allowed before saving the Invoice.");
                return;
            }

            if(IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Invoice");
                return;
            }

            if (MfgInvVMs.MfgSubInvVMs.Any(s => s.ItemCancel))
            {
                await _js.ToastrWarning("Invoice cannot be cancelled — one or more items are already cancelled.");
                return;
            }

            if (MfgInvVMs.PoShortClose)
            {
                await _js.ToastrError("Sales invoice is already short closed. You can't cancel it.");
                return;
            }


            
            bool exist = false;
            foreach (var refId in MfgInvVMs.MfgSubInvVMs)
            {
                exist = await mfgInvService.HasAnyItemOrInvoiceCreditNoteAsync(refId.InvSubId);
                if (exist)
                {
                    await _js.ToastrWarning("Cannot delete this invoice. Credit Note already exists for this invoice or its items.");
                    return;
                }
            }

            // if(!string.IsNullOrEmpty(MfgInvVMs.ACKNO) && !string.IsNullOrEmpty(MfgInvVMs.IRNNo))
            // {
            //      await _js.ToastrWarning("Cannot delete this invoice. E-Invoice already exists for this invoice or its items.");
            //      return;
            // }


            if(MfgInvVMs.IsCancel)
            {
                var subs = await mfgInvService.GetInvoiceSubDetailsByInvIdAsync(MfgInvVMs.InvId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    await mfgInvService.ValidateInvoiceBalanceBeforeRevertAsync(sub);
                }
            }
            if (!MfgInvVMs.IsCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Invoice?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Invoice?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            MfgInvVMs= await mfgInvService.GetInvoiceByInvIdAsync(MfgInvVMs.InvId);
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Invoice.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Invoice Sales Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
                    await CancelInvoice();
                    break;

                case "ItemCancel":
                    await CancelItem(rowToCancel);
                    break;
                case "TDS":
                    await UpdateTDS();
                    break;
                case "LC":
                    await UpdateLcDetails();
                    break;
                case "Short-Close":
                    await ShortClose();
                    break;
                case "EInvoice":
                    await GenerateEInvoice();
                    break;
                case "Preview":
                     await GenerateEInvoicePreview();
                    break;
                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

