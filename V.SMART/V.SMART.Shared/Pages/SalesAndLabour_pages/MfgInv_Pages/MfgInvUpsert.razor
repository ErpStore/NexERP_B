    private async Task ApplyCustomerSelectionAsync(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;
            MfgInvVMs.CustId = customer?.CustId ?? 0;
            MfgInvVMs.CustName = customer?.CustName;
            MfgInvVMs.CustAddress = customer?.CustAddr;
            MfgInvVMs.GSTNo = customer?.GSTNo;
            MfgInvVMs.ContactNo = customer?.ContactNo;
            MfgInvVMs.BusiType = customer?.BusiType;

            if (customer == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                CostCenterVMs.Clear();
                await ResetQuoteDefaults();
                return;
            }

            contactPersons = await mfgInvService.GetContactPersonsAsync(customer.CustId);
            consineeAddress = await mfgInvService.GetConsigneeAddressesAsync(customer.CustId);

            var usedCostCenters = MfgInvVMs.MfgSubInvVMs
                .Where(x => x.CostId.HasValue && (x.RefDcSubId == null || x.RefDcSubId == 0))
                .Select(x => x.CostId.Value)
                .ToHashSet();

            CostCenterVMs = await mfgInvService.GetCostCenterDetailsByCustId(customer.CustId, usedCostCenters);

            MfgInvVMs.KindOfAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPersonName : string.Empty;

            // Tax logic
            if (!customer.TaxValidate)
            {
                var lastInvoice = await mfgInvService.GetLastInvoiceAsync(customer.CustId);
                if (lastInvoice != null)
                {
                    MfgInvVMs.CGstRate = lastInvoice.CGstRate;
                    MfgInvVMs.SGstRate = lastInvoice.SGstRate;
                    MfgInvVMs.IGstRate = lastInvoice.IGstRate;
                }
                else
                {
                    if (string.Equals(customer.BusiType, "Local", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false )
                    {
                        MfgInvVMs.CGstRate = CommonConstants.GetGST(9.000m);
                        MfgInvVMs.SGstRate = CommonConstants.GetGST(9.000m);
                        MfgInvVMs.IGstRate = CommonConstants.GetIGST(0.000m);
                    }
                    else if (string.Equals(customer.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && customer.TaxValidate == false )
                    {
                        MfgInvVMs.CGstRate = CommonConstants.GetGST(0.000m);
                        MfgInvVMs.SGstRate = CommonConstants.GetGST(0.000m);
                        MfgInvVMs.IGstRate = CommonConstants.GetIGST(18.000m);
                    }
                }
            }

            MfgInvVMs.CurrId = (customer.CurrId.HasValue && customer.CurrId > 0) ? customer.CurrId.Value : 1;
            await ApplyCurrencyChange(MfgInvVMs.CurrId);


            await CountPendingposDcs();

            await _calculationService.UpdateTotalsAsync(MfgInvVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {customer?.CustId}");
            await _js.ToastrError("Failed to apply customer selection. Please try again.");
        }
    }

