    #region === Deletion Flow ===

    private async Task HandleDelete(MfgInvVM inv)
    {
        try
        {
            if (inv.InvTally || inv.GrandTotal!=inv.Balance)
            {
                await _JS.ToastrWarning("Deletion not allowed. Payments have already been processed for this Mfg Invoice.");
                return;

            }
            bool hasInvTransMade = await mfgInvService.HasAnyItemOrInvoiceCancelAsync(inv.InvId);
            if (hasInvTransMade)
            {
                await _JS.ToastrWarning("Cannot delete this invoice. Invoice or item already cancelled.");
                return;
            }

            bool exist = false;
            foreach (var refId in inv.MfgSubInvVMs)
            {
                exist = await mfgInvService.HasAnyItemOrInvoiceCreditNoteAsync(refId.InvSubId);
                if (exist)
                {
                    await _JS.ToastrWarning("Cannot delete this invoice. Credit Note already exists for this invoice or its items.");
                    return;
                }
            }

            if(!string.IsNullOrEmpty(inv.ACKNO) && !string.IsNullOrEmpty(inv.IRNNo))
            {
                await _JS.ToastrWarning("Cannot delete this invoice. E-Invoice already exists for this invoice or its items.");
                return;
            }



            ModalTitle = "Are you sure you want to delete this mfg invoice?";
            btnColor = "btn-danger";
            btnText = "Yes, Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            DeleteInvId = inv.InvId;
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for InvId: {inv.InvId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            var deleted = await mfgInvService.DeleteInvoiceByInvIdAsync(DeleteInvId, screenCode);
            if (deleted)
            {
                await _JS.ToastrSuccess("Manufacturing Invoice deleted successfully.");
                await LoadAllInvoices();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Manufacturing Invoice could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting invId: {DeleteInvId}");
            await _JS.ToastrError("Failed to delete Manufacturing Invoice ");
        }
        finally
        {
            isProcessing = false;
            DeleteInvId = 0;
        }
    }

    #endregion

    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else if (confirmation=="Export")
            {
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

