@page "/mfgInvList"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IProductionService
@using V.SMART.Shared.Pages.InstantSearch_Pages
@using V.SMART.Shared.ViewModels.InventoryViewModel.ToolCribViewModels
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.MfgInvVM
@using V.SMART.Shared.ViewModels.PlanningViewModel.JobOrderViewModel
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionIssueWOAssyVM
@using System.Text.Json

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@inject IMfgInvService mfgInvService

@inject ExcelExportService ExcelExportService


<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>


<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Manufacturing List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@mfgInvBreadcrumbs" />

            <div class="card-body p-4">
                <div class="row g-2 g-md-3 mb-3">

                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>


                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                 value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Short-Closed">Short-Closed</option>
                        </select>
                    </div>


                    @if (CanCreate)
                    {
                       <div class="col-12 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewInv">
                                <i class="bi bi-plus-square me-1"></i> Add New Invoice
                            </button>
                       </div>
                    }

                </div>

                @if (MfgInvVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="MfgInvVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            case "InvId":
                                                <PropertyColumn Title="Invoice ID" Property="@(c => c.InvId)" />
                                                break;

                                            case "Prefix":
                                                <PropertyColumn Title="Prefix" Property="@(c => c.Prefix)" />
                                                break;
                                            case "InvNo":
                                                <PropertyColumn Title="Invoice No" Property="@(c => $"{c.InvNo}{c.Suffix ?? string.Empty}")" />
                                                break;

                                            case "Suffix":
                                                <PropertyColumn Title="Suffix" Property="@(c => c.Suffix)" />
                                                break;

                                            case "InvDate":
                                                <PropertyColumn Title="Invoice Date" Property="@(c => c.InvDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "InvDateNow":
                                                <PropertyColumn Title="Invoice Date (Now)" Property="@(c => c.InvDateNow)" Format="dd/MM/yyyy" />
                                                break;

                                            case "CustId":
                                                <PropertyColumn Title="Customer ID" Property="@(c => c.CustId)" />
                                                break;

                                            case "CustName":
                                                <PropertyColumn Title="Customer Name" Property="@(c => c.CustName)" />
                                                break;

                                            case "CustAddress":
                                                <PropertyColumn Title="Customer Address" Property="@(c => c.CustAddress)" />
                                                break;

                                            case "ContactNo":
                                                <PropertyColumn Title="Contact Number" Property="@(c => c.ContactNo)" />
                                                break;

                                            case "GSTNo":
                                                <PropertyColumn Title="GST No" Property="@(c => c.GSTNo)" />
                                                break;

                                            case "PANNo":
                                                <PropertyColumn Title="PAN No" Property="@(c => c.PANNo)" />
                                                break;

                                            case "KindOfAttention":
                                                <PropertyColumn Title="Attention" Property="@(c => c.KindOfAttention)" />
                                                break;

                                            case "ShippingName":
                                                <PropertyColumn Title="Shipping Name" Property="@(c => c.ShippingName)" />
                                                break;

                                            case "ShippingAddress":
                                                <PropertyColumn Title="Shipping Address" Property="@(c => c.ShippingAddress)" />
                                                break;

                                            case "ShippingGstin":
                                                <PropertyColumn Title="Shipping GSTIN" Property="@(c => c.ShippingGstin)" />
                                                break;

                                            case "ShippingContactNo":
                                                <PropertyColumn Title="Shipping Contact" Property="@(c => c.ShippingContactNo)" />
                                                break;

                                            case "NoOfItems":
                                                <PropertyColumn Title="No. of Items" Property="@(c => c.NoOfItems)" />
                                                break;

                                            case "MainRemark":
                                                <PropertyColumn Title="Main Remark" Property="@(c => c.MainRemark)" />
                                                break;

                                            case "CurrName":
                                                <PropertyColumn Title="Currency" Property="@(c => c.CurrName)" />
                                                break;

                                            case "TodayVal":
                                                <PropertyColumn Title="Today's Value" Property="@(c => c.TodayVal)" />
                                                break;

                                            case "IsCancel":
                                                <TemplateColumn Title="Status" Context="c">
                                                    @if (c.IsCancel)
                                                    {
                                                         <span class="badge bg-danger rounded-pill px-3">
                                                            <i class="bi bi-x-circle me-1"></i> Cancelled
                                                        </span>
                                                    }
                                                    else if(c.PoShortClose)
                                                    {
                                                         <span class="badge bg-secondary rounded-pill px-3">
                                                            <i class="bi bi-slash-circle me-1"></i> Short Closed
                                                        </span>
                                                    }else{

                                                         <span class="badge bg-warning text-dark rounded-pill px-3">
                                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            case "CancelReason":
                                                <PropertyColumn Title="Cancel Reason" Property="@(c => c.CancelReason)" />
                                                break;

                                            case "TotalGrossAmount":
                                                <PropertyColumn Title="Gross Amount" Property="@(c => c.TotalGrossAmount)" />
                                                break;

                                            case "DiscountPercent":
                                                <PropertyColumn Title="Discount %" Property="@(c => c.DiscountPercent)" />
                                                break;

                                            case "DiscountAmount":
                                                <PropertyColumn Title="Discount Amount" Property="@(c => c.DiscountAmount)" />
                                                break;

                                            case "TotalBasicAmount":
                                                <PropertyColumn Title="Basic Amount" Property="@(c => c.TotalBasicAmount)" />
                                                break;

                                            case "FreightCharges":
                                                <PropertyColumn Title="Freight Charges" Property="@(c => c.FreightCharges)" />
                                                break;

                                            case "PackingPercent":
                                                <PropertyColumn Title="Packing %" Property="@(c => c.PackingPercent)" />
                                                break;

                                            case "PackingCharges":
                                                <PropertyColumn Title="Packing Charges" Property="@(c => c.PackingCharges)" />
                                                break;

                                            case "InsurancePercent":
                                                <PropertyColumn Title="Insurance %" Property="@(c => c.InsurancePercent)" />
                                                break;

                                            case "InsuranceCharges":
                                                <PropertyColumn Title="Insurance Charges" Property="@(c => c.InsuranceCharges)" />
                                                break;

                                            case "CGstRate":
                                                <PropertyColumn Title="CGST Rate" Property="@(c => c.CGstRate)" />
                                                break;

                                            case "SGstRate":
                                                <PropertyColumn Title="SGST Rate" Property="@(c => c.SGstRate)" />
                                                break;

                                            case "IGstRate":
                                                <PropertyColumn Title="IGST Rate" Property="@(c => c.IGstRate)" />
                                                break;

                                            case "TotalCGSTAmount":
                                                <PropertyColumn Title="CGST Amount" Property="@(c => c.TotalCGSTAmount)" />
                                                break;

                                            case "TotalSGSTAmount":
                                                <PropertyColumn Title="SGST Amount" Property="@(c => c.TotalSGSTAmount)" />
                                                break;

                                            case "TotalIGSTAmount":
                                                <PropertyColumn Title="IGST Amount" Property="@(c => c.TotalIGSTAmount)" />
                                                break;

                                            case "OtherCharges":
                                                <PropertyColumn Title="Other Charges" Property="@(c => c.OtherCharges)" />
                                                break;

                                            case "TCSPercent":
                                                <PropertyColumn Title="TCS %" Property="@(c => c.TCSPercent)" />
                                                break;

                                            case "TCSAmount":
                                                <PropertyColumn Title="TCS Amount" Property="@(c => c.TCSAmount)" />
                                                break;

                                            case "TotalTaxable":
                                                <PropertyColumn Title="Taxable Total" Property="@(c => c.TotalTaxable)" />
                                                break;

                                            case "RoundOff":
                                                <PropertyColumn Title="Round Off" Property="@(c => c.RoundOff)" />
                                                break;

                                            case "GrandTotal":
                                                <PropertyColumn Title="Grand Total" Property="@(c => c.GrandTotal)" />
                                                break;
                                            case "TransportMode":
                                                   <TemplateColumn Title="Transport Mode" Context="c">
                                                        @if (c.TransportMode==1)
                                                        {
                                                             <span class="badge bg-danger rounded-pill px-3">
                                                                <i class="bi bi-x-circle me-1"></i> By Road
                                                            </span>
                                                        }
                                                        else if(c.TransportMode==2)
                                                        {
                                                             <span class="badge bg-secondary rounded-pill px-3">
                                                                <i class="bi bi-slash-circle me-1"></i> By Railway
                                                            </span>
                                                        }else if(c.TransportMode==3){

                                                             <span class="badge bg-warning text-dark rounded-pill px-3">
                                                                <i class="bi bi-hourglass-split me-1"></i> By Airway
                                                            </span>
                                                        }
                                                        else if(c.TransportMode==4){

                                                             <span class="badge bg-warning text-dark rounded-pill px-3">
                                                                <i class="bi bi-hourglass-split me-1"></i> By Seaway
                                                            </span>
                                                        }
                                                    </TemplateColumn>
                                            break;
                                            case "VehicleNo":
                                            <PropertyColumn Title="Vehicle No" Property="@(c => c.VehicleNo)" />
                                            break;
                                            case "TransFrom":
                                            <PropertyColumn Title="Transport From" Property="@(c => c.TransFrom)" />
                                            break;
                                            case "TransTo":
                                            <PropertyColumn Title="Transport To" Property="@(c => c.TransTo)" />
                                            break;
                                            case "SubSupplyType":
                                                  <TemplateColumn Title="Sub Supply Type" Context="c">
                                                        @if (c.SubSupplyType==1)
                                                        {
                                                             <span class="badge bg-danger rounded-pill px-3">
                                                                <i class="bi bi-x-circle me-1"></i> Supply
                                                            </span>
                                                        }
                                                        else if(c.TransportMode==5)
                                                        {
                                                             <span class="badge bg-secondary rounded-pill px-3">
                                                                <i class="bi bi-slash-circle me-1"></i> For Own Use
                                                            </span>
                                                        }else if(c.TransportMode==8){

                                                             <span class="badge bg-warning text-dark rounded-pill px-3">
                                                                <i class="bi bi-hourglass-split me-1"></i> Others
                                                            </span>
                                                        }
                                                       
                                                    </TemplateColumn>
                                            break;
                                            case "EWayNo":
                                            <PropertyColumn Title="EWay No" Property="@(c => c.EWayNo)" />
                                            break;
                                             case "EWayDate":
                                            <PropertyColumn Title="EWay Date" Property="@(c => c.EWayDate)" Format="dd/MM/yyyy"/>
                                            break;

                                            case "TransId":
                                            <PropertyColumn Title="Transporter Id" Property="@(c => c.TransId)" />
                                            break;
                                            case "TransDocNo":
                                            <PropertyColumn Title="Transporter Doc No" Property="@(c => c.TransDocNo)" />
                                            break;
                                            case "TransName":
                                            <PropertyColumn Title="Transporter Name" Property="@(c => c.TransName)" />
                                            break;

                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date" Property="@(c => c.ModifiedDate)" Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }
                            }

                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"mfgInv/update/{c.InvId}?currentPage={currentPage}")"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"mfgInv/details/{c.InvId}?currentPage={currentPage}")"
                                            class="btn btn-sm btn-outline-info"
                                            title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete"
                                                @onclick="() => HandleDelete(c)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>
                    </div>


                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="container-fluid">

                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="fw-semibold small px-1">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                                <button class="btn btn-success btn-sm d-flex align-items-center ms-5" @onclick="HandleExport">

                                    <i class="bi bi-download me-1"></i> Export Invoice's

                                </button>

                            </div>

                        </div>

                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}

@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Manufacturing Invoice";
    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteInvId = 0;
    private string selectedStatus = "";

    private int screenCode{ get; set; }

    private List<MfgInvVM> MfgInvVMs = new();


    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    // === Paging & Search ===
    private int totalItems;
   //private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    #endregion


    #region === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    #endregion

    private List<PageHeader.BreadcrumbItem> mfgInvBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Sales" },
        new PageHeader.BreadcrumbItem { Text = "Tax Invoice(Outgoing)", IsLast = true }
    };

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            screenCode = await mfgInvService.GetScreenCodeByScreenNameAsync(ScreenName);
            UserName = await CurrentUserService.GetUsernameAsync();

            //InstantSearch
            //Important : Deserialize Filter parameter from query string if exists
            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }
            if (currentPage < 1)
            {
                currentPage = 1;
            }
            await LoadAllInvoices();
            await LoadColumnPreferences(UserName);

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    private void AddNewInv()
    {
       // _navigation.NavigateTo("/Customer/Select/?ReturnUrl=mfgInv/create/{id}");
        _navigation.NavigateTo("/Customer/Select/false/true?ReturnUrl=mfgInv/create/{id}");
    }


    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "Invoice ID", Field = "InvId", IsVisible = false },
                new() { Title = "Prefix", Field = "Prefix" , IsVisible = false },
                new() { Title = "Invoice No", Field = "InvNo" , IsVisible = true },
                new() { Title = "Invoice Date", Field = "InvDate", IsVisible = true  },
                new() { Title = "Invoice Date Now", Field = "InvDateNow", IsVisible = false },

                new() { Title = "Customer ID", Field = "CustId", IsVisible = false },
                new() { Title = "Customer Name", Field = "CustName" , IsVisible = true },
                new() { Title = "Customer Address", Field = "CustAddress", IsVisible = false  },
                new() { Title = "Contact No", Field = "ContactNo" , IsVisible = false },
                new() { Title = "GST No", Field = "GSTNo" , IsVisible = false },
                new() { Title = "PAN No", Field = "PANNo" , IsVisible = false },
                new() { Title = "Attention", Field = "KindOfAttention" , IsVisible = false },

                new() { Title = "Shipping Name", Field = "ShippingName", IsVisible = false  },
                new() { Title = "Shipping Address", Field = "ShippingAddress" , IsVisible = false },
                new() { Title = "Shipping GSTIN", Field = "ShippingGstin", IsVisible = false  },
                new() { Title = "Shipping Contact", Field = "ShippingContactNo", IsVisible = false  },

                new() { Title = "No Of Items", Field = "NoOfItems" , IsVisible = false },
                new() { Title = "Main Remark", Field = "MainRemark" , IsVisible = false },

                new() { Title = "Currency", Field = "CurrName" , IsVisible = true },
                new() { Title = "Today Value", Field = "TodayVal" , IsVisible = false },

                new() { Title = "Cancelled", Field = "IsCancel" , IsVisible = true },
                new() { Title = "Cancel Reason", Field = "CancelReason", IsVisible = false  },

                // Calculation Fields
                new() { Title = "Gross Amount", Field = "TotalGrossAmount" , IsVisible = true },
                new() { Title = "Discount %", Field = "DiscountPercent", IsVisible = false  },
                new() { Title = "Discount Amt", Field = "DiscountAmount" , IsVisible = false },
                new() { Title = "Basic Amount", Field = "TotalBasicAmount", IsVisible = true  },
                new() { Title = "Freight Charges", Field = "FreightCharges" , IsVisible = false },
                new() { Title = "Packing %", Field = "PackingPercent" , IsVisible = false },
                new() { Title = "Packing Charges", Field = "PackingCharges" , IsVisible = false },
                new() { Title = "Insurance %", Field = "InsurancePercent" , IsVisible = false },
                new() { Title = "Insurance Charges", Field = "InsuranceCharges" , IsVisible = false },

                new() { Title = "CGST Rate", Field = "CGstRate" , IsVisible = false },
                new() { Title = "SGST Rate", Field = "SGstRate" , IsVisible = false },
                new() { Title = "IGST Rate", Field = "IGstRate" , IsVisible = false },
                new() { Title = "Total CGST Amount", Field = "TotalCGSTAmount" , IsVisible = false },
                new() { Title = "Total SGST Amount", Field = "TotalSGSTAmount", IsVisible = false  },
                new() { Title = "Total IGST Amount", Field = "TotalIGSTAmount" , IsVisible = false },

                new() { Title = "Other Charges", Field = "OtherCharges" , IsVisible = false },
                new() { Title = "TCS %", Field = "TCSPercent" , IsVisible = false },
                new() { Title = "TCS Amount", Field = "TCSAmount" , IsVisible = false },
                new() { Title = "Taxable Total", Field = "TotalTaxable", IsVisible = false  },

                new() { Title = "Round Off", Field = "RoundOff", IsVisible = false },
                new() { Title = "Grand Total", Field = "GrandTotal" , IsVisible = true},

                new() { Title = "Transport Mode", Field = "TransportMode", IsVisible = false },
                new() { Title = "Vehicle No", Field = "VehicleNo", IsVisible = false },

                new() { Title = "Transport From", Field = "TransFrom", IsVisible = false },

                new() { Title = "Transport To", Field = "TransTo", IsVisible = false },
                new() { Title = "Sub Supply Type", Field = "SubSupplyType", IsVisible = false },
                new() { Title = "EWay No", Field = "EWayNo", IsVisible = false },

                new() { Title = "EWay No", Field = "EWayNo", IsVisible = false },
                new() { Title = "EWay Date", Field = "EWayDate", IsVisible = false },
                new() { Title = "Transporter Id", Field = "TransId", IsVisible = false },
                new() { Title = "Transporter Doc No", Field = "TransDocNo", IsVisible = false },
                new() { Title = "Transporter Name", Field = "TransName", IsVisible = false },

                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false },
            };

            if (!Hidden)
            {

            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for JobOrderList");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

