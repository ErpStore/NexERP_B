    private async Task UpsertPrintSettings()
    {
        isProcessing = true;

        try
        {
            await salaryHeadPrintSettingService.UpsertSalaryPrintHeadSettingAsync(SalaryHeadPrint);

            await _js.ToastrSuccess("Settings Saved Successfully");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "SaveSalaryHeadSettings");
            await _js.ToastrError("Error while saving");
        }
        finally
