    private async Task LoadSalaryHeadSettings()
    {
        var dbData = await salaryHeadPrintSettingService.GetAllAsync();

        var defaults = GetDefaultSalaryHeads();

        foreach (var item in defaults)
        {
            var dbItem = dbData.FirstOrDefault(x =>
                x.FieldName == item.FieldName &&
                x.Type == item.Type);

            if (dbItem != null)
            {
                item.Id = dbItem.Id;
                item.PrintName = dbItem.PrintName;
                item.IsPrint = dbItem.IsPrint;
            }
        }

        SalaryHeadPrint = defaults;
    }

