    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            await LoadSalaryHeadSettings();

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in OnInitializedAsync of PrintManagement");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetLabel(string fieldName)
    {
        return SalaryHeadPrint
            .FirstOrDefault(x => x.FieldName == fieldName)?.PrintName
            ?? fieldName;
    }

