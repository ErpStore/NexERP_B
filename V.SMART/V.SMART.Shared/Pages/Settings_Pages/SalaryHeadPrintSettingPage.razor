@page "/print-salaryHeadSettings"

@inherits BaseUserRightsComponent

@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject ISalaryHeadPrintSettingService salaryHeadPrintSettingService
@inject ILoggingService _logs

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container-fluid px-2 px-md-5 mt-4">
            <div class="card shadow-sm border-1">
                <PageHeader TitleText="Print Management"
                            TitleIcon="bi bi-printer text-primary"
                            Breadcrumbs="@salaryPrintHead" />

                <div class="card-body">
                    <EditForm Model="@SalaryHeadPrint" OnValidSubmit="UpsertPrintSettings">
                        <DataAnnotationsValidator />
                        <ValidationSummary />


                        <div class="row">

                            <!-- Earnings -->
                            <div class="col-md-4">
                                <div class="card shadow-sm">
                                    <div class="card-header text-white" style="background-color : #00B2CA;">
                                        Earnings
                                    </div>

                                    <div class="card-body p-2">
                                        <table class="table table-sm table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Field Name</th>
                                                    <th>Rename Field</th>
                                                    <th>Print</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in SalaryHeadPrint.Where(x => x.Type == 1))
                                                {
                                                    <tr>
                                                        <td>@item.FieldName</td>

                                                        <td>
                                                            <InputText class="form-control form-control-sm"
                                                                       @bind-Value="item.PrintName" />
                                                        </td>

                                                        <td class="text-center">
                                                            <InputCheckbox @bind-Value="item.IsPrint" />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Deductions -->
                            <div class="col-md-4">
                                <div class="card shadow-sm">
                                    <div class="card-header text-white" style="background-color:#778873">
                                        Deductions
                                    </div>

                                    <div class="card-body p-2">
                                        <table class="table table-sm table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Field Name</th>
                                                    <th>Rename Field</th>
                                                    <th>Print</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in SalaryHeadPrint.Where(x => x.Type == 2))
                                                {
                                                    <tr>
                                                        <td>@item.FieldName</td>

                                                        <td>
                                                            <InputText class="form-control form-control-sm"
                                                                       @bind-Value="item.PrintName" />
                                                        </td>

                                                        <td class="text-center">
                                                            <InputCheckbox @bind-Value="item.IsPrint" />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Employee Info -->
                            <div class="col-md-4">
                                <div class="card shadow-sm">
                                    <div class="card-header text-white" style="background-color:#1A312C">
                                        Employee Info
                                    </div>

                                    <div class="card-body p-2">
                                        <table class="table table-sm table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Field Name</th>
                                                    <th>Rename Field</th>
                                                    <th>Print</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in SalaryHeadPrint.Where(x => x.Type == 3))
                                                {
                                                    <tr>
                                                        <td>@item.FieldName</td>

                                                        <td>
                                                            <InputText class="form-control form-control-sm"
                                                                       @bind-Value="item.PrintName" />
                                                        </td>

                                                        <td class="text-center">
                                                            <InputCheckbox @bind-Value="item.IsPrint" />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="row mt-3">
                            <div class="col-auto">
                                <button type="submit" class="btn btn-success">
                                    Save
                                </button>
                            </div>


                            <div class="col-auto">
                                <a href="/generalSettings" class="btn btn-secondary w-100 rounded-3" disabled="@isProcessing">
                                    <i class="bi bi-arrow-bar-left me-1"></i> Back To List
                                </a>
                            </div>
                        </div>
                       

                    </EditForm>
                </div>
            </div>
        </div>
    }
}

