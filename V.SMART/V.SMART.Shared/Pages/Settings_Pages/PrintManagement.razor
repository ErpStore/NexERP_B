@page "/print-management"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ISettingsService
@using V.SMART.Shared.Data.GeneralSettingsMaster
@using V.SMART.Shared.Data.Master.MasterScreeenManagement
@using V.SMART.Shared.Data.Master.MasterScreeenManagement_Module

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject NavigationManager _navigation
@inject IPrintSettingService _service

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>
@* <BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="btn-primary"
         ButtonText="Yes"
         Title="Are you sure you want to Delete current row?">
</BsModal> *@

<BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title="@ModalTitle" />

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container-fluid px-2 px-md-5 mt-4">
            <div class="card shadow-sm border-1">
                <PageHeader TitleText="Print Management"
                            TitleIcon="bi bi-printer text-primary"
                            Breadcrumbs="@printManagement" />

                <div class="card-body">
                    <EditForm Model="PrintSetting" OnValidSubmit="UpsertPrintSettings">
                        <DataAnnotationsValidator />
                        <ValidationSummary />


                        <div class="row g-3 mb-2">
                            <div class="col-12 col-lg-12 mb-2">
                                <div class="card h-100 shadow-sm">

                                    <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                        <span class="fw-bold fs-6">Print Setting Details</span>
                                    </div>
                                    <div class="card-body p-3">

                                        <div class="accordion mb-2 compact-accordion" id="transportAccordion">
                                            <div class="accordion-item border-0 shadow-sm rounded-2">
                                                <h3 class="accordion-header">
                                                    <button class="accordion-button collapsed py-1 px-2 fw-semibold text-primary"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#collapseTransport">
                                                        <i class="bi bi-printer me-1"></i> Print Management
                                                    </button>
                                                </h3>

                                                <div id="collapseTransport"
                                                     class="accordion-collapse collapse"
                                                     data-bs-parent="#transportAccordion">

                                                    <div class="accordion-body">

                                                        <input type="text" class="form-control form-control-sm mb-2" placeholder="Search Screen..."
                                                               @bind="searchText"
                                                               @bind:event="oninput" />

                                                        <table class="table table-bordered align-middle text-center mb-0">
                                                            <thead class="custom-blue">
                                                                <tr>
                                                                    <th>SlNo</th>
                                                                    <th>Screen Name</th>
                                                                    <th>Enable Print</th>
                                                                </tr>
                                                            </thead>

                                                            <tbody>
                                                                @if (FilteredList != null)
                                                                {
                                                                    int i = 1;
                                                                    foreach (var item in FilteredList)
                                                                    {
                                                                        <tr>
                                                                            <td>@i</td>
                                                                            <td style="text-align:left;">@item.ScreenName</td>
                                                                            <td class="text-center">
                                                                                @* <input type="checkbox"
                                                                                       @bind="item.IsPrintRequired" /> *@
                                                                                <input type="checkbox"
                                                                                       checked="@(item.IsPrintRequired == true)"
                                                                                       disabled="@(item.IsLocked && item.IsPrintRequired == true)"
                                                                                       @onchange="e => OnCheckboxChanged(item, (bool)e.Value)" />
                                                                            </td>
                                                                        </tr>
                                                                        i++;
                                                                    }
                                                                }
                                                            </tbody>
                                                        </table>
                                                        <div class="d-flex justify-content-center mt-2">
                                                            <button type="button" class="btn btn-success btn-sm"
                                                                    style="width:150px;"
                                                                    @onclick="ConfirmScreenUpdate">
                                                                Update
                                                            </button>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mb-2 align-items-center">
                                            <label class="col-12 col-sm-3 col-form-label form-label-sm text-dark mb-0">
                                                <small>Screen Names</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select class="form-select form-select-sm rounded-3 w-100"
                                                        value="@selectedScreenName"
                                                        @onchange="OnScreensChanged">
                                                    <option value="">Select a Screen Name</option>
                                                    @foreach (var screen in typeList)
                                                    {
                                                        <option value="@screen.ScreenName">@screen.ScreenName</option>
                                                    }
                                                </select>

                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(selectedScreenName))
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-bordered align-middle text-center mb-0">
                                                    <thead class="custom-blue">
                                                        <tr>
                                                            <th style="font-size:13px;">Screen Name</th>
                                                            <th style="font-size:13px;">Copy Name</th>
                                                            <th style="font-size:13px;">No. Of Copies</th>
                                                            <th style="font-size:13px;">Copies Required</th>
                                                            <th style="font-size:13px;">Watermark Required</th>
                                                            <th style="font-size:13px;">Watermark Lable</th>
                                                            <th style="font-size:13px;">Logo Required</th>
                                                            <th style="font-size:13px;">ISO Logo Required</th>
                                                            <th style="font-size:13px;">Actions</th>


                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        @foreach (var setting in filteredSettings)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    <InputText class="form-control form-control-sm" @bind-Value="setting.ScreenName" readonly />
                                                                    <ValidationMessage For="@(() => setting.ScreenName)" />
                                                                </td>
                                                                <td>
                                                                    <InputText class="form-control form-control-sm" @bind-Value="setting.CopyName" maxlength="50" />
                                                                    <ValidationMessage For="@(() => setting.CopyName)" />
                                                                </td>
                                                                <td>
                                                                    <InputNumber class="form-control form-control-sm" @bind-Value="setting.NoOfCopies" />
                                                                    <ValidationMessage For="@(() => setting.NoOfCopies)" />
                                                                </td>
                                                                <td>
                                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                                        <InputCheckbox class="form-check-input" @bind-Value="setting.IsActive" disabled="@(PrintSetting.First() == setting)" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                                        <InputCheckbox class="form-check-input" @bind-Value="setting.WatermarkRequired" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <InputText class="form-control form-control-sm" @bind-Value="setting.WatermarkLable" maxlength="50" />
                                                                    <ValidationMessage For="@(() => setting.WatermarkLable)" />
                                                                </td>
                                                                <td>
                                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                                        <InputCheckbox class="form-check-input" @bind-Value="setting.LogoRequired" />
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                                        <InputCheckbox class="form-check-input" @bind-Value="setting.IsoLogoRequired" />
                                                                    </div>
                                                                </td>
                                                                <td class="freeze-last-col">

                                                                    @if (CanDelete)
                                                                    {

                                                                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteRow(setting)" title="Delete row" disabled="@(PrintSetting.First() == setting)">
                                                                            <i class="bi bi-trash3"></i>
                                                                        </button>

                                                                    }

                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="row mt-1">
                                                <div class="col-md-4">
                                                    <button type="button" class="btn btn-sm rounded-3 mt-3 text-white"
                                                            style="background-color: #6f42c1;"
                                                            @onclick="AddRow">
                                                        <i class="bi bi-plus-circle me-1"></i> Add row
                                                    </button>
                                                </div>

                                                @if (CanCreate || CanEdit)
                                                {
                                                    <div class="col-xxl-4 col-12">

                                                        <button type="submit" class="btn btn-primary rounded-3 mt-3 " disabled="@isProcessing">
                                                            <i class="bi bi-floppy2-fill me-1"></i>Update
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }


                                    </div>

                                </div>
                            </div>
                        </div>

                    </EditForm>
                </div>
            </div>
        </div>
    }
}

@code {
    protected override string ScreenName => "Print Management";
    private bool isProcessing = true;
    private PrintSetting _IdToDelete;
    private List<Screens> typeList { get; set; } = new();

    private List<PrintSetting> PrintSetting { get; set; } = new();
    private List<PrintSetting> rowDelete { get; set; } = new();
    private string? selectedScreenName;

    List<ScreensVM> screenList = new();
    private string searchText = "";

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    private List<PageHeader.BreadcrumbItem> printManagement = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "Settings" },
        new PageHeader.BreadcrumbItem { Text = "Print Management", IsLast = true }
    };

    // Filtered list for currently selected screen
    private IEnumerable<PrintSetting> filteredSettings =>
        string.IsNullOrEmpty(selectedScreenName)
            ? Enumerable.Empty<PrintSetting>()
            : PrintSetting;

    private IEnumerable<ScreensVM> FilteredList =>
       string.IsNullOrWhiteSpace(searchText)
       ? screenList
       : screenList.Where(x =>
           x.ScreenName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
           x.ScreenCode.ToString().Contains(searchText)
       );

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            screenList = await _service.GetScreenPrintSettings();

            await ToLoadAllScreens();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync of PrintManagement");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ToLoadAllScreens()
    {
        try
        {
            typeList = await _service.GetScreenDetailsAsync();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in ToLoadAllScreens()");
            await _JS.ToastrError("Failed to load screen list.");
        }
    }

    private async Task ToLoadPrintSettings(string screenName)
    {
        try
        {
            var assignments = await _service.GetPrintSettingByScreenName(screenName);
            PrintSetting = assignments?.ToList() ?? new List<PrintSetting>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in ToLoadPrintSettings()");
            await _JS.ToastrError("Failed to load print settings.");
        }
    }

    private async Task OnScreensChanged(ChangeEventArgs e)
    {
        try
        {
            selectedScreenName = e.Value?.ToString();

            if (string.IsNullOrWhiteSpace(selectedScreenName))
                return;

            var existingSettings = (await _service.GetPrintSettingByScreenName(selectedScreenName))
                                   ?.ToList() ?? new List<PrintSetting>();
            PrintSetting.Clear();

            if (existingSettings.Any())
            {
                PrintSetting.AddRange(existingSettings);
            }
            else
            {
                PrintSetting.Add(new PrintSetting
                {
                    ScreenName = selectedScreenName
                });
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnScreensChanged()");
            await _JS.ToastrError("Failed to change screen selection.");
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(selectedScreenName))
            {
                await _JS.ToastrWarning("Please select a screen name first.");
                return;
            }
            var lastRow = PrintSetting.LastOrDefault();
            if (lastRow != null)
            {
                if (lastRow.CopyName == null)
                {
                    await _JS.ToastrWarning("Copy Name should not be empty");
                    return;
                }
                bool isDuplicate;
                isDuplicate = PrintSetting.Where(x => x != lastRow).Any(x => x.CopyName == lastRow.CopyName);

                if (isDuplicate)
                {
                    await _JS.ToastrWarning("Already Copy Name Exits");
                    return;
                }

                // if(PrintSetting.Count>1 && PrintSetting .Any(x=>x != lastRow && x.CopyName !=null &&  x.CopyName.Equals(lastRow.CopyName,StringComparison.OrdinalIgnoreCase)  ))
                // {
                //      await _JS.ToastrWarning("Already Copy Name Exits");
                //      return;
                // }

            }
            PrintSetting.Add(new PrintSetting
            {
                ScreenName = selectedScreenName,
                CopyName = null
            });
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in AddRow()");
        }
    }

    private async Task DeleteRow(PrintSetting row)
    {
        try
        {
            if (PrintSetting.First() == row)
                return;


            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
            _IdToDelete = row;
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Print settings DeleteRow() method ");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task confirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (isConfirmed)
            {


                if (confirmation == "Delete")
                {
                    if (PrintSetting.First() == _IdToDelete)
                        return;

                    if (_IdToDelete.Id > 0)
                    {
                        await _service.ToDeleteByIdAsync(_IdToDelete.Id);
                        await _JS.ToastrSuccess("Deleted successfully.");
                        _IdToDelete = null;
                    }
                    PrintSetting.Remove(_IdToDelete);
                }
                else if (confirmation == "Update")
                {
                    await SaveData();
                    await _JS.ToastrSuccess("Updated successfully.");

                }


            }


        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in confirmDelete_Click()");
            await _JS.ToastrError("Delete failed.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    #region Upsert / Validation
    private async Task UpsertPrintSettings()
    {
        isProcessing = true;
        try
        {
            if (await toValidateSettings())
            {
                await _service.UpsertPrintSettingAsync(PrintSetting);
                await _JS.ToastrSuccess("Record updated successfully.");
                await ToLoadPrintSettings(selectedScreenName);

                screenList = await _service.GetScreenPrintSettings();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertEnquirySales");
            await _JS.ToastrError("Error saving enquiry.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> toValidateSettings()
    {
        bool valid = true;

        if (PrintSetting.Count > 0)
        {
            foreach (var row in PrintSetting)
            {
                if (string.IsNullOrEmpty(row.CopyName.Trim()))
                {
                    await _JS.ToastrWarning("CopyName should not be empty.");
                    valid = false;
                    break;
                }
            }
            var lastRow = PrintSetting.LastOrDefault();
            if (lastRow != null)
            {
                if (lastRow.CopyName == null)
                {
                    await _JS.ToastrWarning("Copy Name should not be empty");
                    valid = false;
                }
                bool isDuplicate;
                isDuplicate = PrintSetting.Where(x => x != lastRow).Any(x => x.CopyName == lastRow.CopyName);

                if (isDuplicate)
                {
                    await _JS.ToastrWarning("Already Copy Name Exits");
                    valid = false;

                }



            }
        }

        return valid;
    }
    #endregion

    private async Task ConfirmScreenUpdate()
    {
        try
        {
            ModalTitle = "Are you sure you want to update print settings for the selected screens?";
            btnColor = "btn-success";
            btnText = "Yes!";
            confirmation = "Update";

            await _JS.InvokeVoidAsync("ShowConfirmationModal");

        }
        catch (Exception ex)
        {

            throw;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task SaveData()
    {
        await _service.SaveScreenPrintSettings(screenList);
        await ToLoadAllScreens();
    }

    private async Task OnCheckboxChanged(ScreensVM item, bool value)
    {
        try
        {

            if (item.IsLocked && !value)
            {
                await _JS.ToastrWarning("This screen is already used in Print Settings. You cannot disable print for it.");
                return;
            }

            item.IsPrintRequired = value ? true : false;

        }
        catch (Exception)
        {

            throw;
        }

    }

}
