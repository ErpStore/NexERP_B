@page "/production-log-settings"
@using System.Text.Json
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ISettingsService
@using V.SMART.Shared.Data.GeneralSettingsMaster
@using V.SMART.Shared.Pages.InstantSearch_Pages

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject IJSRuntime _js
@inject IColumnPreferenceService PreferenceService
@inject CurrentUserService currentUserService
@inject NavigationManager _navigation

@inject IProdLogSettingsService prodLogSettingsService


<BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="btn-danger"
         ButtonText="Delete"
         Title="Are you sure you want to delete this Production Log Settings?">
</BsModal>

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">

    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">

        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Prouction log Stop Type List"
                        TitleIcon="bi bi-card-list"
                        Breadcrumbs="@prodTypeStopBreadcrumbs" />

            <div class="card-body p-4">

                <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-12 col-md"></div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                 value="@pageSize"
                                @onchange="OnPageSizeChanged">

                            <option value="10">10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>


                    @if (CanCreate)
                    {
                        <div class="col-6 col-md-2 text-end">
                            <a href="/productionLogStop/create"
                                class="btn btn-success btn-sm w-100 shadow-sm">
                                <i class="bi bi-plus-square"></i>  Add New
                            </a>
                        </div>
                    }

                </div>

                <!-- Grid -->
                @if (prodLogs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="prodLogs.AsQueryable()"
                               Class="quickgrid table table-bordered text-wrap">

                        @if (Columns.Any(c => c.IsVisible))
                        {
                            foreach (var col in Columns.Where(c => c.IsVisible))
                            {
                                <div>
                                    @switch (col.Field)
                                    {
                                        case "Id":
                                            <PropertyColumn Title="ID"
                                                            Property="@(c => c.Id)"
                                                            Visible="false" />
                                            break;

                                        case "ProdStopType":
                                            <PropertyColumn Title="Production Stop Type"
                                                            Property="@(c => c.ProdStopType)"
                                                            Sortable="true" />
                                            break;

                                        case "EfficiencyPerc":
                                            <PropertyColumn Title="Efficiency %"
                                                            Property="@(c => c.EfficiencyPerc)"
                                                            Format="0.00"
                                                            Sortable="true" />
                                            break;

                                        case "Definition":
                                            <PropertyColumn Title="Definition"
                                                            Property="@(c => c.Definition)" />
                                            break;

                                        case "IsActive":
                                            <PropertyColumn Title="Active"
                                                            Property="@(c => c.IsActive)" />
                                            break;
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <PropertyColumn Title="Production Stop Type" Property="@(c => c.ProdStopType)" />
                            <PropertyColumn Title="Efficiency %" Property="@(c => c.EfficiencyPerc)" />
                            <PropertyColumn Title="Definition" Property="@(c => c.Definition)" />
                            <PropertyColumn Title="Active" Property="@(c => c.IsActive)" />
                        }

                        <!-- Actions -->
                        <TemplateColumn Title="Actions" Context="c">
                            <div class="d-flex gap-2">

                                @if (CanEdit)
                                {
                                    <a href="@($"productionLogStop/update/{c.Id}")"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                }

                                @if (CanDelete)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => OpenDelete(c.Id)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                }

                            </div>
                        </TemplateColumn>

                    </QuickGrid>


                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>

                }
                else
                {
                    <p class="text-center">No Category available.</p>
                }

            </div>
        </div>

    </div>
}

@code {
    #region STATE VARIABLES

    protected override string ScreenName => "Production Log Setting";

    private bool isProcessing = true;
    private int DeleteProdTypeId = 0;
    private string UserName { get; set; } = "";

    private List<ProductionLogSetting> prodLogs = new();

    private int currentPage = 1;
    private int totalItems;
    private int pageSize { get; set; } = 50;
    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; } = new();

    // Instant Search filter parameter
    [SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    // Breadcrumb
    private List<PageHeader.BreadcrumbItem> prodTypeStopBreadcrumbs = new()
    {
        new() { Text = "Settings" },
        new() { Text = "Production Log Settings" },
        new() { Text = "Production Type", IsLast = true }
    };
    #endregion

    #region INITIALIZATION

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns();

            UserName = await currentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadProductionLogSettings();
            await LoadColumnPreferences();

            isProcessing = false;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in ProductionLogSettings OnInitializedAsync()");
            await _js.ToastrError("Failed to initialize Production los Settings page.");
        }
    }

    #endregion

    #region COLUMNS

    private async Task InitializeColumns()
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "ID", Field = "Id", IsVisible = false },
                new() { Title = "Production Stop Type", Field = "ProdStopType", IsVisible = true },
                new() { Title = "Efficiency %", Field = "EfficiencyPerc", IsVisible = true },
                new() { Title = "Definition", Field = "Definition", IsVisible = true },
                new() { Title = "Active", Field = "IsActive", IsVisible = true },
            };
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error initializing columns in ProductionLogSettingsList");
            await _js.ToastrError("Failed to initialize columns.");
        }
    }

    private async Task LoadColumnPreferences()
    {
        try
        {
            var user = await currentUserService.GetUsernameAsync();
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, user);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for ProductionLogSettingsList");
            await _js.ToastrError("Failed to load column preferences.");
        }
    }

    private Task HandleColumnChange(List<GridColumn> updated)
    {
        Columns = updated;
        return Task.CompletedTask;
    }

    #endregion

    #region DATA LOADING

    private async Task LoadProductionLogSettings()
    {
        try
        {
            var result = await prodLogSettingsService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            prodLogs = result.prodLogSettings;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading prodLogSettings in Production log Settings list");
            await _js.ToastrError("Failed to load Prouction log settings List.");
        }
    }

    private void GoToInstantSearch()
    {
        _navigation.NavigateTo($"/instantSearch?screen={ScreenName}");
    }

    #endregion

    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadProductionLogSettings();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in  Production log Settings list");
            await _js.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadProductionLogSettings();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in  Production log Settings list");
            await _js.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadProductionLogSettings();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in  Production log Settings list");
            await _js.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadProductionLogSettings();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in  Production log Settings list");
            await _js.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadProductionLogSettings();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in  Production log Settings list");
            await _js.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadProductionLogSettings();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing  Production log Settings list page");
            await _js.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion

    #region DELETE

    private async Task OpenDelete(int id)
    {
        try
        {
            DeleteProdTypeId = id;
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error opening delete modal for Id: {id}");
            await _js.ToastrError("Failed to open delete confirmation.");
        }
    }

    private async Task confirmDelete_Click(bool confirmed)
    {
        await _js.InvokeVoidAsync("HideConfirmationModal");

        if (!confirmed || DeleteProdTypeId == 0)
            return;

        isProcessing = true;

        try
        {
            var prodLogSettings = await prodLogSettingsService.GetProductionLogSettingsAsync(DeleteProdTypeId);
            await prodLogSettingsService.DeleteProductionLogSettingsAsync(DeleteProdTypeId);

            await LoggingService.LogUserAction(
                await currentUserService.GetUsernameAsync(),
                currentUserService.MachineName,
                currentUserService.IpAddress,
                "Production Log Stop Settings List",
                "Delete",
                $"Deleted Production log stop: {prodLogSettings?.ProdStopType}");

            await _js.ToastrSuccess("Production Type Stoppage deleted successfully.");
            await LoadProductionLogSettings();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error deleting  Production log Settings list");
            await _js.ToastrError("Failed to delete  Production log Settings list.");
        }
        finally 
        {
            DeleteProdTypeId = 0;
            isProcessing = false;    

        }


    }

    #endregion

    #region MODAL HANDLERS

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _js.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _js.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion

    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadProductionLogSettings();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in  Production log Settings list");
            await _js.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion



}
