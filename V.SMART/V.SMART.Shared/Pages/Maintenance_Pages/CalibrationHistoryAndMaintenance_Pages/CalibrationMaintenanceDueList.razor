@page "/CalibrationMaintenance/CalibrationMaintenanceDueList"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IMaintenanceService
@using V.SMART.Shared.ViewModels.MaintenanceViewModel.CalibrationHistoryAndMaintenanceVM

@inherits BaseUserRightsComponent

@inject IJSRuntime _js
@inject ICalibrationHistoryAndMaintenanceService calibrationservice
@inject NavigationManager _navigation
@inject ILoggingService LoggingService
@inject IExcelTemplateService excelTemplateService

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="d-flex justify-content-center mt-4">
            <div class="card shadow-sm p-4 border-1 rounded-3" style="max-width: 900px; width:100%;">

                <h5 class="text-primary fw-bold mb-3">Calibration Due Status</h5>
                <hr/>

                <!-- FILTERS -->
                <div class="row g-3 mb-3">

                    <!-- Not reached due date -->
                    <div class="col-12 col-lg-6">
                        <label class="form-label fw-semibold">Not Reached Due Date :</label>
                        <div class="input-group input-group-sm">

                            <span class="input-group-text fw-bold bg-success bg-opacity-25 border-success">
                                Due Before
                            </span>

                            <input type="number"
                                   class="form-control border-success fw-semibold" step="any"
                            @bind="DueBeforeDays" />

                            <span class="input-group-text fw-bold bg-success bg-opacity-25 border-success">
                                days
                            </span>
                        </div>
                    </div>

                    <!-- Crossed due date -->
                    <div class="col-12 col-lg-6">
                        <label class="form-label fw-semibold">Crossed Due Date :</label>
                        <div class="input-group input-group-sm">

                            <span class="input-group-text fw-bold bg-danger bg-opacity-25 border-danger">
                                Due After
                            </span>

                            <input type="number"
                                   class="form-control border-danger fw-semibold" step="any"
                            @bind="DueAfterDays" />

                            <span class="input-group-text fw-bold bg-danger bg-opacity-25 border-danger">
                                days
                            </span>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 flex-wrap">

                    <select class="form-select form-select-sm shadow-sm w-auto"
                            value="@pageSize" @onchange="OnPageSizeChanged"
                    title="Select number of records per page">
                        <option value="10" selected>10 per page</option>
                        <option value="20">20 per page</option>
                        <option value="50">50 per page</option>
                    </select>

                    <button class="btn btn-primary btn-sm px-3" @onclick="LoadDueData">
                        <i class="bi bi-eye"></i> View
                    </button>
                </div>

                <hr />

                <!-- TABLE -->
                <div class="table-responsive">
                    <QuickGrid TGridItem="CalibrationDueModelVM"
                    class="table table-striped table-bordered align-middle text-wrap"
                    Items="DueList.AsQueryable()" ItemKey="@(m => m.SerialNo)" >

                        <!-- Serial Number Column -->
                        <PropertyColumn Property="@(x => x.SerialNo)" Title="Sl.No" />

                        <!-- Item Name -->
                        <PropertyColumn Property="@(x => x.ItemName)" Title="Item Code (Name)" />

                        <!-- Unique ID -->
                        <PropertyColumn Property="@(x => x.UniqueId)" Title="Unique ID No" />

                        <!-- Due Date -->
                        <PropertyColumn Property="@(x => x.DueDate.ToString("dd/MM/yyyy"))" Title="Due On" />

                        <!-- Days Left -->
                        <PropertyColumn Property="@(x => x.DaysLeft)" Title="Days Left" />

                        <!-- Status -->
                        <PropertyColumn Property="@(x => x.DueStatus)" Title="Due By" />

                    </QuickGrid>

                </div>

                <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                    <div class="d-flex align-items-center gap-2 justify-content-center">

                        <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                            <i class="bi bi-skip-backward-fill"></i>
                        </button>

                        <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                            <i class="bi bi-arrow-left-circle"></i>
                        </button>

                        <span class="px-3 fw-semibold">
                            Page @currentPage of @totalPages
                        </span>

                        <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                            <i class="bi bi-arrow-right-circle"></i>
                        </button>

                        <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                            <i class="bi bi-skip-forward-fill"></i>
                        </button>

                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3 gap-2">
                    <button class="btn btn-secondary btn-sm px-3" @onclick="PrintCalibrationDueList">
                        <i class="bi bi-printer"></i> Print
                    </button>

                    <button class="btn btn-danger btn-sm px-3" @onclick="GoBackToList">
                        <i class="bi bi-x-circle"></i> Close
                    </button>
                </div>
            </div>
        </div>
    }
}


@code {

    #region Declarations And Properties
    protected override string ScreenName => "CalibrationHistoryAndMaintenance";
    private bool isProcessing = true;
    public int DueBeforeDays { get; set; } = 30;
    public int DueAfterDays { get; set; } = 90;
    private int sn = 1;

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;
    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<CalibrationDueModelVM> DueList { get; set; } = new();
    private PaginationState paginationState = new() { ItemsPerPage = 5 };

    public CalibrationDueModelVM CalibrationDueModel = new CalibrationDueModelVM();
    #endregion

    #region initialization
    protected override async Task OnInitializedAsync()
    {
        await LoadRightsAsync();

        if (!CanView)
        {
            _navigation.NavigateTo("/access-denied");
            return;
        }
        await LoadDueData();
    }
    #endregion

    #region LoadDueData
    private async Task LoadDueData()
    {
        try
        { 
            isProcessing = true;
            DueList = new();
            var filters = new Dictionary<string, object>();
            var result = await calibrationservice.SearchCalibrationHistoriesAsync(
               currentPage,
               pageSize,
               filters
           );

            var history = result.CalibrationVMs;
            totalItems = result.TotalCount;

            foreach (var h in history)
            {
                if (h.ExpectedCalibrate == null)
                    continue;

                var dueDate = h.ExpectedCalibrate.Value.Date;
                var daysLeft = (dueDate - DateTime.Now.Date).Days;

                if (daysLeft >= 0 && daysLeft <= DueBeforeDays)
                {
                    DueList.Add(new CalibrationDueModelVM
                    {
                        ItemName = h.InstrumentName,
                        UniqueId = h.UniqueId,
                        DueDate = dueDate,
                        DaysLeft = daysLeft,
                        DueStatus = "Due Before " + DueBeforeDays + " days"
                    });
                }
                else if (daysLeft < 0 && Math.Abs(daysLeft) <= DueAfterDays)
                {
                    DueList.Add(new CalibrationDueModelVM
                    {
                        ItemName = h.InstrumentName,
                        UniqueId = h.UniqueId,
                        DueDate = dueDate,
                        DaysLeft = daysLeft,
                        DueStatus = "Crossed Due Date"
                    });
                }
            }

            // ✅ Assign Serial Numbers AFTER list is ready
            int serial = 1;
            foreach (var item in DueList)
            {
                item.SerialNo = serial++;
            }

            isProcessing = false;
        }
        catch (Exception ex)
        {
            isProcessing = false;
            await LoggingService.LogDeveloperError(ex, "An error occurred while loading calibration due data in CalibrationMaintenanceDueList page.");
        }
    }
    #endregion

    #region GoBackToList
    public void GoBackToList()
    {
        try
        {
            _navigation.NavigateTo("/CalibrationMaintenance");
        }
        catch(Exception ex)
        {
            LoggingService.LogDeveloperError(ex, "An error occurred while loading GoBackToList in CalibrationMaintenanceDueList page.");
        }
    }
    #endregion

    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadDueData();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in BreakDown Maintenance");
            await _js.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadDueData();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in BreakDown Maintenance");
            await _js.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadDueData();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in BreakDown Maintenance");
            await _js.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadDueData();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in BreakDown Maintenance");
            await _js.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadDueData();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in BreakDown Maintenance");
            await _js.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion

    private async Task PrintCalibrationDueList()
    {
        try
        {
            if (DueList == null || !DueList.Any())
            {
                await _js.InvokeVoidAsync("alert", "No Calibration Due Records found.");
                return;
            }

            // Excel Headers
            string[] headers = { "Sl.No", "Item Name", "Unique ID", "Due Date", "Days Left", "Due Status" };

            // Excel Data Mapping
            var exportData = DueList
                .Select(x => new
                {
                    x.SerialNo,
                    ItemName = x.ItemName ?? "",
                    UniqueId = x.UniqueId ?? "",
                    DueDate = x.DueDate.ToString("dd/MM/yyyy"),
                    x.DaysLeft,
                    DueStatus = x.DueStatus ?? ""
                })
                .ToList();

            // Generate Excel
            var fileBytes = await excelTemplateService.CreateTemplateAsync(sheetName: "Calibration Due Status", headers: headers, sampleData: exportData);

            if (fileBytes == null || fileBytes.Length == 0)
            {
                await _js.InvokeVoidAsync("alert", "Failed to generate Excel file.");
                return;
            }

            var base64 = Convert.ToBase64String(fileBytes);

            // Download Excel
            await _js.InvokeVoidAsync("downloadExcelFile", base64, "Calibration Due Status.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error while exporting Calibration Due Status Excel");
            await _js.InvokeVoidAsync("alert", "Error occurred while exporting Excel.");
        }
    }
}
