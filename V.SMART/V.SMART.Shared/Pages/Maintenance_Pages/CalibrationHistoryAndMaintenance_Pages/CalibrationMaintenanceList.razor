@page "/CalibrationMaintenance"

@using V.SMART.Shared.BusinessLayer.BusinessService
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IMaintenanceService
@using V.SMART.Shared.BusinessLayer.BusinessService.MaintenanceService
@using V.SMART.Shared.Data.Maintenance.BreakdownMaintenance
@using V.SMART.Shared.Data.Maintenance.CalibrationHistoryAndMaintenance
@using V.SMART.Shared.Data.Master.Inventory
@using V.SMART.Shared.ViewModels
@using V.SMART.Shared.ViewModels.MaintenanceViewModel.BreakdownMaintenanceVM

@inherits BaseUserRightsComponent

@inject ICalibrationHistoryAndMaintenanceService calibrationservice
@inject IColumnPreferenceService PreferenceService
@inject CurrentUserService currentUserService
@inject ILoggingService LoggingService
@inject IJSRuntime _js
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch isModelVisible="true"
                       Screen="@ScreenName"
                       Filters="SearchFilters"
                       OnClose="CloseModal"
                       OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="btn-danger"
         ButtonText="Delete"
         Title="Are you sure you want to delete this Calibration?">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <!-- Card Header -->
            <PageHeader TitleText="@ScreenTitle"
                        TitleIcon="@MachineIcon"
                        Breadcrumbs="@ScreenBreadcrumbs" />
            <div class="card-body">

                <!-- Filter Controls -->
                <div class="row g-3 align-items-center mb-2">

                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns" 
                            ScreenName="CalibrationHistoryAndMaintenance" 
                            UserId="@UserName"
                            MaxVisible="int.MaxValue"
                            OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <!-- DROPDOWN -->
                    <div class="col-12 col-lg-2">
                        <select class="form-select form-select-sm shadow-sm" @onchange="FilterRows">
                            <option value="">--Select Status --</option>
                                <option value="Active">Active</option>
                                <option value="Cancel">Cancel</option>
                        </select>
                    </div>


                    <div class="col-12 col-lg-2">
                        <select class="form-select form-select-sm shadow-sm"
                                value="@pageSize" @onchange="OnPageSizeChanged"
                                title="Select number of records per page">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                        <div class="col-12 col-lg-2 ms-lg-auto text-end">
                            <a href="/CalibrationMaintenance/create"
                               class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                               title="Create New Breakdown">
                                <i class="bi bi-plus-square me-1"></i> Add New Calibration
                            </a>
                        </div>
                    }
                </div>


                @if (CalibrationHistoryList.Any())
                {
                    <div class="table-responsive">
                        <QuickGrid class="table table-striped table-bordered align-middle text-wrap"
                                   Items="CalibrationHistoryList.AsQueryable()"
                                   ItemKey="@(m => m.CalibrateId)">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
{
                            foreach (var col in Columns.Where(c => c.IsVisible))
                            {
                                <div>
                                    @switch (col.Field)
                                    {
                                        // Instrument
                                            case "Instrument":
                                                <PropertyColumn Title="Gauge/Instrument"
                                                            Property="@(c => c.InstrumentName)"
                                                            Sortable="false" />
                                            break;

                                        // UniqueId
                                            case "Uniqueid":
                                                <PropertyColumn Title="Unique ID"
                                                            Property="@(c => c.UniqueId)"
                                                            Sortable="true" />
                                            break;

                                        // Next Date
                                            case "NextCalibrationDate":
                                                <PropertyColumn Title="Next Calibration Date"
                                                             Property="@(c => c.ExpectedCalibrate.HasValue ? c.ExpectedCalibrate.Value.ToString("dd/MM/yyyy") : string.Empty)" />
                                    
                                            break;

                                        // Previous Date
                                            case "LastCalibrationDate":
                                                <PropertyColumn Title="Last Calibration Date"
                                                            Property="@(c => c.PrevDate.HasValue? c.PrevDate.Value.ToString("dd/MM/yyyy"): string.Empty)" />
                                            break;

                                        // Report No.
                                            case "ReportNo":
                                                <PropertyColumn Title="Report No."
                                                                Property="@(c => c.CalibrateNo)" />
                                            break;

                                            // Status
                                            case "Status":
                                                <PropertyColumn Title="Status"
                                                                Property="@(c => c.CalibrateStatus)" />
                                                break;

                                            // CancelStatus
                                            case "CancelStatus":
                                                <TemplateColumn Title="Cancel Status" Context="x">
                                                    @if (x.CalibrateCancl)
                                                    {
                                                        <span class="badge bg-danger rounded-pill px-3">
                                                            <i class="bi bi-x-circle me-1"></i> Cancelled
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                        // Authorised By        
                                            case "Authorised":
                                                <PropertyColumn Title="Authorised By"
                                                            Property="@(c => c.Authorised)" />
                                            break;

                                        // Details
                                            case "Details":
                                                <PropertyColumn Title="Details"
                                                            Property="@(c => c.CalibrateDetails)" />
                                            break;

                                            case "Frequency":
                                                <PropertyColumn Title="Frequency"
                                                                Property="@(c => c.Frequency)" />
                                                break;

                                            case "Range":
                                                <PropertyColumn Title="Range"
                                                                Property="@(c => c.Range)" />
                                                break;
                                            case "LeastCount":
                                                <PropertyColumn Title="Least Count"
                                                                Property="@(c => c.LeastCount)" />
                                                break;
                                    }
                                </div>
                            }
                        }

                        <TemplateColumn Title="Actions" Context="c">
                            <div class="d-flex gap-2">
                                @if (CanEdit)
                                {
                                        <a href="@($"CalibrationMaintenance/update/{c.CalibrateId}")"
                                        class="btn btn-sm btn-outline-primary"
                                        title="Edit Item">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                                @if (CanDelete)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            title="Delete Item"
                                            @onclick="() => HandleDelete(c.CalibrateId)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                }
                            </div>
                        </TemplateColumn>
                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 mt-3">
                        <div class="d-flex flex-column flex-lg-row justify-content-end gap-2">

                            <button class="btn btn-success d-flex align-items-center px-3" @onclick=MovetoDue>
                                <i class="bi bi-eye me-2"></i>
                                View Due
                            </button>

                            <button class="btn btn-primary d-flex align-items-center px-3" @onclick="PrintCalibrationHistory">
                                <i class="bi bi-printer me-2"></i>
                                Print
                            </button>

                        </div>
                    </div>
                }
                else
                {
                    <p class="text-center mt-4 text-muted">No categories available.</p>
                }
            </div>
        </div>
    </div>
}




@code {
    #region Declarations And Properties
    // User Rights
    protected override string ScreenName => "CalibrationHistoryAndMaintenance";
    private DateTime? todate = DateTime.Now;
    private DateTime? fromdate = DateTime.Now;
    private bool isProcessing = true;
    private string? UserName;
    private int DeleteID = 0;
    private IEnumerable<CalibrationHistoryVM> CalibrationHistoryList = new List<CalibrationHistoryVM>();
    private IEnumerable<CalibrationHistoryVM> TempCalibrationHistoryList = new List<CalibrationHistoryVM>();
    private string? machineNameFilter;
    private Timer? debounceTimer;

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;
    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    // Instant Search filter parameter
    [Parameter, SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> ScreenBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Maintenance" },
        new PageHeader.BreadcrumbItem { Text = "Calibration History & Maintenance", IsLast = true }
    };

    private string ScreenTitle => "Calibration History & Maintenance";
    private string MachineIcon => "bi bi-tools";
    public List<GridColumn> Columns { get; set; } = new();

    public async Task InitializeColumns(bool hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "Gauge/Instrument", Field = "Instrument", IsVisible = true },
                new() { Title = "Unique ID", Field = "Uniqueid", IsVisible = false },
                new() { Title = "Next Calibration Date", Field = "NextCalibrationDate", IsVisible = false },
                new() { Title = "Last Calibration Date", Field = "LastCalibrationDate", IsVisible = false },
                new() { Title = "Report No.", Field = "ReportNo", IsVisible = false },
                new() { Title = "Status", Field = "Status", IsVisible = false },
                new() { Title = "Authorised By", Field = "Authorised", IsVisible = false },
                new() { Title = "Details", Field = "Details", IsVisible = false },
                new() { Title = "Frequency", Field = "Frequency", IsVisible = false },
                new() { Title = "Cancel Status", Field = "CancelStatus", IsVisible = false },
                new() { Title = "Range", Field = "Range", IsVisible = false },
                new() { Title = "LeastCount", Field = "LeastCount", IsVisible = false },
            };
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ItemList InitializeColumns() Method");
        }
    }
    #endregion

    #region Initialization
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            UserName = await currentUserService.GetUsernameAsync();

            await InitializeColumns(IsHidden);
            var savedPreferences = await PreferenceService.LoadPreferencesAsync("CalibrationHistoryAndMaintenance", UserName);

            if (savedPreferences?.Any() == true)
            {
                foreach (var col in Columns)
                {
                    var match = savedPreferences.FirstOrDefault(s => s.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }
            await LoadCalibrationHistory();
            TempCalibrationHistoryList = CalibrationHistoryList.ToList();
            isProcessing = false;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the OnInitializedAsync()");
        }
    }
    #endregion

    #region Search
    public void Search()
    {
        isModalVisible = true;
        ActiveModal = "InstantSearch";

    }
    #endregion

    #region Load All Calibration History
    private async Task LoadCalibrationHistory()
    {
        try
        {
            var filters = new Dictionary<string, object>();

            var result = await calibrationservice.SearchCalibrationHistoriesAsync(
              pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            CalibrationHistoryList = result.CalibrationVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading Calibration History list");
            await _js.ToastrError("Failed to load Calibration History list.");
        }
    }
    #endregion

    #region Opening Due List
    private async Task MovetoDue()
    {
        try
        {
            _navigation.NavigateTo("/CalibrationMaintenance/CalibrationMaintenanceDueList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the MovetoDue() method");
        }
    }
    #endregion

    #region Deleting The Calibration
    private async Task HandleDelete(int ? id)
    {
        try
        {
            if (id.HasValue)
            {
                DeleteID = id.Value;
            }
            var machine = await calibrationservice.GetCalbrationById(DeleteID);
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the HandleDelete() method");

        }
    }

    private async Task confirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (isConfirmed && DeleteID != 0)
            {
                var mach = await calibrationservice.GetCalbrationById(DeleteID);
                if (mach.CalibrateCancl==true)
                {
                    await _js.ToastrError("Cannot Delete Cancelled Calibration");
                    return;
                }
                await LoggingService.LogUserAction(UserName: await currentUserService.GetUsernameAsync(), Machine: currentUserService.MachineName, IP_Address: currentUserService.IpAddress,
                screen: "MaintenanceBreakdown", action: $"User Deleted an existing Calibration of a Gauge. {mach.InstrumentName}",
                additionalInfo: $"ItemName: {mach.InstrumentName}");
                var deleted = await calibrationservice.DeleteCalibrationHistory(DeleteID);
                if (deleted)
                {
                    await _js.ToastrSuccess("Calibration deleted successfully.");
                }
                else
                {
                    await _js.ToastrError("Error encountered while deleting Calibration.");
                }

                await LoadCalibrationHistory();
                isProcessing = false;
            }

            DeleteID = 0;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the confirmDelete_Click() event ");
            await _js.ToastrError("An error occurred while handling the confirmDelete_Click() event ");
        }
        finally
        {
            isProcessing = false;
        }
    }
    #endregion

    #region HandleColumnChange
    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ItemList HandleColumnChange() Method");
            await _js.ToastrError("An error occurred while handling the ItemList HandleColumnChange() Method");
        }
    }
    #endregion

    #region Dispose
    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
    #endregion

    #region CloseModal
    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");

        }
    }
    #endregion

    #region Filtering Rows
    private async Task FilterRows(ChangeEventArgs e)
    {
        try
        {
            var value = e.Value?.ToString();

            if (string.IsNullOrEmpty(value))
            {
                // Load full data again
                CalibrationHistoryList = TempCalibrationHistoryList.ToList();
                return;
            }
            if(value=="Cancel")
            {
                // Filter by Cancel Status
                CalibrationHistoryList = TempCalibrationHistoryList
                .Where(x => x.CalibrateCancl == true).ToList();
            }
            else
            {
                CalibrationHistoryList = TempCalibrationHistoryList
                .Where(x => x.CalibrateCancl == false).ToList();
            }

        }
        catch(Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An Error Occured in FilterRows() Method");
            await _js.ToastrError("An Error Occured in FilterRows() Method");
        }
    }
    #endregion

    #region Opening the Instant Search Modal
    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _js.ToastrError("Failed to open modal. Please try again.");
        }
    }
    #endregion

    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadCalibrationHistory();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in BreakDown Maintenance");
            await _js.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadCalibrationHistory();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in BreakDown Maintenance");
            await _js.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadCalibrationHistory();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in BreakDown Maintenance");
            await _js.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadCalibrationHistory();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in BreakDown Maintenance");
            await _js.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadCalibrationHistory();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in BreakDown Maintenance");
            await _js.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadCalibrationHistory();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing BreakDown Maintenance page");
            await _js.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion

    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadCalibrationHistory();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Sales Order List");
            await _js.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion

    private async Task PrintCalibrationHistory()
    {
        try
        {
            if (CalibrationHistoryList == null || !CalibrationHistoryList.Any())
            {
                await _js.InvokeVoidAsync("alert", "No Calibration History found.");
                return;
            }

            // Excel Headers
            string[] headers =
            {"Instrument Name","Unique ID", "Calibration No","Previous Date","Expected Calibration","Status","Authorised By","Frequency","Range",
        "Least Count","Cancelled","Cancel Date","Cancel Reason"};

            // Excel Data Mapping
            var exportData = CalibrationHistoryList
                .Select(x => new
                {
                    InstrumentName = x.InstrumentName ?? "",
                    UniqueId = x.UniqueId ?? "",
                    CalibrationNo = x.CalibrateNo ?? "",

                    PreviousDate = x.PrevDate?.ToString("dd/MM/yyyy") ?? "",

                    ExpectedCalibration =
                        x.ExpectedCalibrate?.ToString("dd/MM/yyyy") ?? "",

                    Status = x.CalibrateStatus ?? "",

                    AuthorisedBy = x.Authorised ?? "",

                    Frequency = x.Frequency ?? "",

                    Range = x.Range ?? "",

                    LeastCount = x.LeastCount ?? "",

                    Cancelled = x.CalibrateCancl ? "Yes" : "No",

                    CancelDate =
                        x.CancelDate?.ToString("dd/MM/yyyy") ?? "",

                    CancelReason = x.CancelReason ?? ""
                })
                .ToList();

            // Generate Excel
            var fileBytes =
                await excelTemplateService.CreateTemplateAsync(
                    sheetName: "Calibration Due List",
                    headers: headers,
                    sampleData: exportData
                );

            if (fileBytes == null || fileBytes.Length == 0)
            {
                await _js.InvokeVoidAsync(
                    "alert",
                    "Failed to generate Excel file."
                );
                return;
            }

            var base64 = Convert.ToBase64String(fileBytes);

            // Download Excel
            await _js.InvokeVoidAsync("downloadExcelFile", base64, "Calibration History.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error while exporting Calibration History Excel");
            await _js.InvokeVoidAsync("alert", "Error occurred while exporting Excel.");
        }
    }
}