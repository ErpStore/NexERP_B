    private async Task ExportStockDataToExcel()
    {
        try
        {
             isProcessing = true;
             await _js.InvokeVoidAsync("HideConfirmationModal");

            List<Dictionary<string, object>> dataToExport = new();

            dataToExport = GetExportData(FilteredStockData.ToList());


            if (!dataToExport.Any()) return;

            
            StateHasChanged();

            // var headers = typeof(StockPositionSummaryVM).GetProperties().Select(p => p.Name).ToArray();

            // var fileBytes = await excelTemplateService.CreateTemplateAsync("Stock Data", headers, dataToExport);

            var fileBytes = await ExcelExportService.ExportPendingListToExcel(dataToExport, "Stock Position", "StockPosition List");

            var base64 = Convert.ToBase64String(fileBytes);
            await _js.InvokeVoidAsync("downloadExcelFile", base64, $"StockPosition_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx");
            await _js.ToastrSuccess("Export completed.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ExportStockDataToExcel");
            await _js.ToastrError("Export failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }


