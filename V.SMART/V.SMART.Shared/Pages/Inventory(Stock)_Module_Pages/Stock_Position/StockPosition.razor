    private async Task LoadStockDataAsync()
    {
        try
        {
            isProcessing = true;
            StateHasChanged();
            _allStockData = await _stockPosition.GetStockSummaryAsync(
                SelectedStoreId,
                SelectedCategoryCode,
                SelectedItemId,
                IsDetailsView);
            int i = 1;
            foreach (var item in _allStockData)
                item.SlNo = i++;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "LoadStockDataAsync");
            await _js.ToastrError("Failed to load stock data.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }


    private Task<IEnumerable<int>> SearchStores(string term, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(term))
            return Task.FromResult(Stores.Select(s => s.StoreId));

        var result = Stores
            .Where(s => s.StoreName.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Select(s => s.StoreId);
        return Task.FromResult(result);
    }
    

    private Task<IEnumerable<int>> SearchCategories(string term, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(term))
            return Task.FromResult(Categories.Select(c => c.CategoryCode));

        var result = Categories
            .Where(c => c.CategoryName.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Select(c => c.CategoryCode);
        return Task.FromResult(result);
    }


    private Task<IEnumerable<int>> SearchItems(string term, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(term))
            return Task.FromResult(Items.Select(i => i.ItemId));

        var result = Items
            .Where(i => i.ItemCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                        i.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Select(i => i.ItemId);
        return Task.FromResult(result);
    }
