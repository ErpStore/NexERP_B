@page "/stockPosition"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IStockAddIss_Position
@using V.SMART.Shared.ViewModels.InventoryViewModel.StockAddVM
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ExcelExportService ExcelExportService
@inject ILoggingService _logs
@inject CurrentUserService _userService
@inject IJSRuntime _js
@inject IStockAddIssPosition _stockPosition
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService
@inject IColumnPreferenceService PreferenceService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title="@ModalTitle">
</BsModal>

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Loading stock data..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-0">
            <PageHeader TitleText="Stock Position"
                        TitleIcon="bi bi-list-check"
                        Breadcrumbs="@_breadcrumbs" />
            <div class="card-body p-4 bg-light">

                <!-- ========== ACTIVE FILTERS BAR ========== -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 bg-white rounded-3 shadow-sm border">
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div class="d-flex align-items-center gap-1 text-secondary">
                                    <i class="bi bi-funnel-fill fs-6"></i>
                                    <span class="fw-semibold small text-uppercase">Active filters</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <!-- Store Chip -->
                                    <div class="filter-chip" data-color="#0a535d">
                                        <i class="bi bi-shop"></i>
                                        <span class="fw-semibold">Store:</span>
                                        <span>@(SelectedStoreId == 0 ? "All Stores" : Stores.FirstOrDefault(s => s.StoreId == SelectedStoreId)?.StoreName ?? "All Stores")</span>
                                        @if (SelectedStoreId != 0)
                                        {
                                            <button type="button" class="filter-chip-clear" @onclick="ClearStore">✕</button>
                                        }
                                    </div>
                                    <!-- Category Chip -->
                                    <div class="filter-chip" data-color="#b57281">
                                        <i class="bi bi-grid-fill"></i>
                                        <span class="fw-semibold">Category:</span>
                                        <span>@(SelectedCategoryCode == 0 ? "All Categories" : Categories.FirstOrDefault(c => c.CategoryCode == SelectedCategoryCode)?.CategoryName ?? "All Categories")</span>
                                        @if (SelectedCategoryCode != 0)
                                        {
                                            <button type="button" class="filter-chip-clear" @onclick="ClearCategory">✕</button>
                                        }
                                    </div>
                                    <!-- Item Chip -->
                                    <div class="filter-chip" data-color="#4d4d4d">
                                        <i class="bi bi-box-seam"></i>
                                        <span class="fw-semibold">Item:</span>
                                        <span>@(SelectedItemId == 0 ? "All Items" : Items.FirstOrDefault(i => i.ItemId == SelectedItemId)?.ItemCode ?? "All Items")</span>
                                        @if (SelectedItemId != 0)
                                        {
                                            <button type="button" class="filter-chip-clear" @onclick="ClearItem">✕</button>
                                        }
                                    </div>
                                    <!-- Health Chip -->
                                    @if (_rolVisible || _molVisible || _rolmolVisible)
                                    {
                                        <div class="filter-chip" data-color="#dc3545">
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                            <span class="fw-semibold">Stock Health:</span>
                                            <span>
                                                @if (_rolVisible)
                                                {
                                                    <text>Below ROL</text>
                                                }
                                                else if (_molVisible)
                                                {

                                                    <text>Below MOL</text>
                                                }
                                                else
                                                {

                                                    <text>Critical (ROL & MOL)</text>
                                                }
                                            </span>
                                            <button type="button" class="filter-chip-clear" @onclick="ClearStockHealthFilters">✕</button>
                                        </div>
                                    }
                                    <!-- Non‑Moving Chip -->
                                    @if (_nonMovingDays > 0)
                                    {
                                        <div class="filter-chip" data-color="#fd7e14">
                                            <i class="bi bi-calendar-minus"></i>
                                            <span class="fw-semibold">Non‑Moving:</span>
                                            <span>@_nonMovingDays days</span>
                                            <button type="button" class="filter-chip-clear" @onclick="ClearNonMovingFilter">✕</button>
                                        </div>
                                    }
                                </div>
                            </div>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="ResetAllFilters">
                                <i class="bi bi-eraser me-1"></i> Reset all
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ========== COMPACT FILTER BAR WITH SEARCHABLE MUDSELECT ========== -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-3">
                                <div class="row g-3 align-items-end">
                                    <!-- STORE (Searchable) -->
                                    <div class="col-12 col-md-4">
                                        <label class="form-label fw-semibold small mb-1">
                                            <i class="bi bi-shop me-1" style="color: #0a535d;"></i> Store
                                        </label>
                                        <div class="d-flex gap-2">
                                            <MudAutocomplete T="int"
                                                             Label="Select store"
                                                             DebounceInterval="300"
                                                             Variant="Variant.Outlined"
                                                             Dense="true"
                                                             Margin="Margin.Dense"
                                                             Value="@SelectedStoreId"
                                                             ValueChanged="@((int id) => OnStoreChanged(id))"
                                                             SearchFunc="@SearchStores"
                                                             ToStringFunc="@(s => Stores.FirstOrDefault(x => x.StoreId == s)?.StoreName ?? "All Stores")"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="true"
                                                             CoerceValue="false"
                                                             Placeholder="Type store name (any part)..."
                                                             Style="width: 100%;">
                                            </MudAutocomplete>
                                            
                                        </div>
                                    </div>

                                    <!-- CATEGORY (Searchable) -->
                                    <div class="col-12 col-md-4">
                                        <label class="form-label fw-semibold small mb-1">
                                            <i class="bi bi-grid-fill me-1" style="color: #b57281;"></i> Category
                                        </label>
                                        <div class="d-flex gap-2">
                                            <MudAutocomplete T="int"
                                                             Label="Select category"
                                                             Variant="Variant.Outlined"
                                                             DebounceInterval="300"
                                                             Dense="true"
                                                             Margin="Margin.Dense"
                                                             Value="@SelectedCategoryCode"
                                                             ValueChanged="@((int id) => OnCategoryChanged(id))"
                                                             SearchFunc="@SearchCategories"
                                                             ToStringFunc="@(c => Categories.FirstOrDefault(x => x.CategoryCode == c)?.CategoryName ?? "All Categories")"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="true"
                                                             CoerceValue="false"
                                                             Placeholder="Type category name (any part)..."
                                                             Style="width: 100%;">
                                            </MudAutocomplete>
                                        </div>
                                    </div>

                                    <!-- ITEM (Searchable) -->
                                    <div class="col-12 col-md-4">
                                        <label class="form-label fw-semibold small mb-1">
                                            <i class="bi bi-box-seam me-1" style="color: #4d4d4d;"></i> Item
                                        </label>
                                        <div class="d-flex gap-2">
                                            <MudAutocomplete T="int"
                                                             Label="Select item"
                                                             Variant="Variant.Outlined"
                                                             DebounceInterval="300"
                                                             Dense="true"
                                                             Margin="Margin.Dense"
                                                             Value="@SelectedItemId"
                                                             ValueChanged="@((int id) => OnItemChanged(id))"
                                                             SearchFunc="@SearchItems"
                                                             ToStringFunc="@(i => Items.FirstOrDefault(x => x.ItemId == i)?.ItemCode ?? "All Items")"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="true"
                                                             CoerceValue="false"
                                                             Placeholder="Type item code or name (any part)..."
                                                             Style="width: 100%;">
                                            </MudAutocomplete>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-12">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="input-group" style="max-width: 300px;">
                                                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                                                <input type="text" class="form-control" placeholder="Search in table..."
                                                       @bind-value="_searchText" @bind-value:event="oninput" />
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-success" @onclick="Print">
                                                    <i class="bi bi-file-earmark-excel-fill me-1"></i> Export
                                                </button>
                                                <div class="form-check form-switch ms-2">
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               id="detailsView"
                                                               checked="@IsDetailsView"
                                                               @onchange="DetailsViewChanged">

                                                        <label class="form-check-label fw-semibold" for="detailsView">
                                                            Details view
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========== CONTROL TOOLBAR ========== -->
                <div class="row mb-2">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-3">
                                <div class="d-flex flex-wrap align-items-center gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               checked="@_showCurrentStock"
                                               @onchange="CurrentStockChanged">
                                        <label class="form-check-label fw-semibold text-success">
                                            Current stock
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               checked="@_showAllItems"
                                               @onchange="ShowAllItemsChanged">
                                        <label class="form-check-label fw-semibold text-primary">
                                            Show all items
                                        </label>
                                    </div>
                                    <div class="vr"></div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="rolSwitch" @bind="_rolVisible">
                                        <label class="form-check-label fw-semibold" for="rolSwitch">ROL</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="molSwitch" @bind="_molVisible">
                                        <label class="form-check-label fw-semibold" for="molSwitch">MOL</label>
                                    </div>
                                    <button class="btn btn-sm btn-outline-warning fw-semibold" @onclick="ActivateStockHealth">
                                        <i class="bi bi-layers-half me-1"></i> Stock health
                                    </button>
                                    <div class="vr"></div>

                                    <div class="d-flex align-items-center gap-2">
                                        <label class="fw-semibold text-secondary mb-0">Non-moving:</label>
                                        <select class="form-select form-select-sm w-auto" @bind="_nonMovingDays">
                                            <option value="0">None</option>
                                            <option value="30">1 month</option>
                                            <option value="90">3 months</option>
                                            <option value="180">6 months</option>
                                            <option value="365">12 months</option>
                                        </select>
                                    </div>

                                    <div class="col-12 col-lg-2">
                                        <div class="dropdown position-relative" style="z-index:1055;">
                                            <ColumnMenu Columns="StockColumns"
                                                        ScreenName="@ScreenName"
                                                        UserId="@UserName"
                                                        MaxVisible="@int.MaxValue"
                                                        OnChanged="HandleColumnChange" />
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========== DATA TABLE ========== -->
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-header bg-white border-bottom-0 pt-3 pb-0 px-4">
                                <h6 class="fw-bold mb-0"><i class="bi bi-table me-2"></i>Stock item details</h6>
                            </div>
                            <div class="card-body p-0">

                                <div class="table-responsive border rounded " style="max-height:600px; overflow-x:auto; overflow-y:auto;">

                                    <table class="table table-bordered table-sm mb-0 align-middle table table-striped" style="min-width:1200px; white-space:nowrap;">

                                        <thead class="custom-blue text-center align-middle sticky-top">
                                          
                                            <tr class="small">
                                                @foreach (var column in StockColumns)
                                                {
                                                    if (column.IsVisible)
                                                    {
                                                        <th class="text-center">@column.Title</th>
                                                    }
                                                }
                                            </tr>


                                        </thead>
                                        <tbody>
                                            @if (FilteredStockData.Any())
                                            {
                                                var idx = 1;
                                                foreach (var item in FilteredStockData)
                                                {
                                                    <tr class="small table-hover">

                                                        @foreach (var col in StockColumns.Where(x => x.IsVisible))
                                                        {
                                                            <td class="@col.Align">
                                                                @switch (col.Field)
                                                                {
                                                                    case "SlNo":
                                                                        <text> @idx</text>
                                                                        break;
                                                                    case "ItemCode":
                                                                        <div class="d-flex align-items-center gap-1">
                                                                            <span>@item.ItemCode</span>
                                                                            @if (_attachmentCounts.TryGetValue(item.ItemId, out var count) && count > 0)
                                                                            {
                                                                                <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                               Size="Size.Small"
                                                                                               Color="Color.Primary"
                                                                                               OnClick="@(async () => await OpenAttachmentButton(item.ItemId, count))"
                                                                                               Title="@($"{count} attachment(s)")" />
                                                                            }
                                                                        </div>
                                                                        break;
                                                                    case "ItemName":
                                                                        <text>@item.ItemName</text>
                                                                        break;
                                                                    case "Specification":   
                                                                        <text>@item.Specification</text>
                                                                        break;
                                                                    case "MeasureUnit":
                                                                        <text>@item.MeasureUnit</text>
                                                                        break;
                                                                    case "HSNCode":
                                                                        <text>@item.HSNCode</text>
                                                                        break;
                                                                    case "BalQty":
                                                                        <span class="fw-bold @GetQtyColorClass(item.BalQty, item.ROL ?? 0, item.MOL ?? 0)">
                                                                            @item.BalQty.ToString("N2")
                                                                        </span>
                                                                        break;
                                                                    case "UnitPrice":
                                                                        <text>@item.UnitPrice.ToString("N2")</text>
                                                                        break;
                                                                    case "TotalAmount":
                                                                        <span class="fw-semibold">
                                                                            @((item.BalQty * item.UnitPrice).ToString("N2"))
                                                                        </span>
                                                                        break;
                                                                    case "ROL":
                                                                        <text>@item.ROL</text>
                                                                        break;
                                                                    case "MOL":
                                                                        <text>@item.MOL</text>
                                                                        break;
                                                                    case "AddStoreName":
                                                                        <text>@item.AddStoreName</text>
                                                                        break;
                                                                    case "ScreenName":
                                                                        <text>@item.ScreenName</text>
                                                                        break;
                                                                    case "Category":
                                                                        <text>@item.Category</text>
                                                                        break;
                                                                    case "RefNo":
                                                                        <text>@item.RefNo</text>
                                                                        break;
                                                                    case "RefDate":
                                                                        <text>@item.RefDate?.ToString("dd/MM/yyyy")</text>
                                                                        break;
                                                                    case "Remarks":
                                                                        <text>@item.Remarks</text>
                                                                        break;
                                                                    case "Make":
                                                                        <text>@item.Make</text>
                                                                        break;
                                                                    case "CustomerNames":
                                                                        <text>@item.CustomerNames</text>
                                                                        break;
                                                                    case "AddedBy":
                                                                        <text>@item.AddedBy</text>
                                                                        break;
                                                                    case "AddedDate":
                                                                        <text>@item.AddDate.ToString("dd/MM/yyyy")</text>
                                                                        break;
                                                                            
                                                                 }
                                                            </td>
                                                            
                                                        }


                                                    </tr>
                                                    idx++;
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="18" class="text-center py-5 text-muted">
                                                        <i class="bi bi-inbox-fill fs-2 d-block mb-2"></i>
                                                        No stock data matches your filters.
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        @if (FilteredStockData.Any())
                                        {
                                            <tfoot class="sticky-bottom bg-light ">
                                                <tr class="table-light fw-semibold">
                                                    <td colspan="6" class="text-end">Totals:</td>
                                                    <td class="text-end">@FilteredStockData.Sum(x => x.BalQty).ToString("N2")</td>
                                                    <td class="text-end">@FilteredStockData.Average(x => x.UnitPrice).ToString("N2")</td>
                                                    <td class="text-end">@FilteredStockData.Sum(x => x.BalQty * x.UnitPrice).ToString("N2")</td>
                                                    <td colspan="10"></td>
                                                </tr>
                                            </tfoot>
                                        }
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========== STOCK LEVEL LEGEND ========== -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="bg-white p-3 rounded-4 shadow-sm border">
                            <h6 class="fw-semibold mb-2"><i class="bi bi-bar-chart-steps me-2"></i>Stock level indicator</h6>
                            <div class="d-flex flex-wrap gap-4 small">
                                <span class="d-inline-flex align-items-center gap-2"><span class="badge bg-secondary rounded-pill">&nbsp;&nbsp;</span> Out of stock ≤ 0</span>
                                <span class="d-inline-flex align-items-center gap-2"><span class="badge bg-danger rounded-pill">&nbsp;&nbsp;</span> Critical (below MOL)</span>
                                <span class="d-inline-flex align-items-center gap-2"><span class="badge bg-warning rounded-pill">&nbsp;&nbsp;</span> Warning (below ROL)</span>
                                <span class="d-inline-flex align-items-center gap-2"><span class="badge bg-success rounded-pill">&nbsp;&nbsp;</span> Safe stock (normal)</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<style>
    .filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.3rem 0.75rem;
        background-color: rgba(var(--bs-light-rgb), 0.8);
        border-radius: 2rem;
        font-size: 0.8rem;
        border-left: 3px solid;
        border-left-color: currentColor;
    }

        .filter-chip[data-color="#0a535d"] {
            color: #0a535d;
            background-color: rgba(10,83,93,0.1);
        }

        .filter-chip[data-color="#b57281"] {
            color: #b57281;
            background-color: rgba(181,114,129,0.1);
        }

        .filter-chip[data-color="#4d4d4d"] {
            color: #4d4d4d;
            background-color: rgba(77,77,77,0.1);
        }

        .filter-chip[data-color="#dc3545"] {
            color: #dc3545;
            background-color: rgba(220,53,69,0.1);
        }

        .filter-chip[data-color="#fd7e14"] {
            color: #fd7e14;
            background-color: rgba(253,126,20,0.1);
        }

    .filter-chip-clear {
        background: none;
        border: none;
        font-size: 0.7rem;
        line-height: 1;
        padding: 0 0.25rem;
        margin-left: 0.25rem;
        color: inherit;
        opacity: 0.7;
        transition: opacity 0.2s;
    }

        .filter-chip-clear:hover {
            opacity: 1;
        }
</style>

@code {
    protected override string ScreenName => "Stock Position";
    private readonly List<PageHeader.BreadcrumbItem> _breadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Inventory" },
        new PageHeader.BreadcrumbItem { Text = "Stock Position", IsLast = true }
    };


    private bool isProcessing = true;
    private string _searchText = string.Empty;
    private bool _rolmolVisible = false;
    private bool _rolVisible = false;
    private bool _molVisible = false;
    private bool _showCurrentStock = false;
    private bool _showAllItems = false;
    private bool IsDetailsView = false;
    private int _nonMovingDays = 0;

    private List<StockPositionSummaryVM> _allStockData = new();
    private Dictionary<int, int> _attachmentCounts = new();
    private string? UserName;

    private int SelectedStoreId = 0;
    private int SelectedCategoryCode = 0;
    private int SelectedItemId = 0;

    public List<Store> Stores { get; set; } = new();
    public List<Category> Categories { get; set; } = new();
    public List<ItemVM> Items { get; set; } = new();

    private ItemVM? AttachItemSelected = null;
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";
    private string ModalTitle = "";
    private string btnText = "";
    private string confirmation = "";
    private string btnColor = "";

    public List<GridColumn> StockColumns { get; set; } = new();

    private IEnumerable<StockPositionSummaryVM> FilteredStockData
    {
        get
        {
            if (_allStockData == null || !_allStockData.Any())
                return Enumerable.Empty<StockPositionSummaryVM>();

            var query = _allStockData.AsEnumerable();

            if (SelectedStoreId != 0)
                query = query.Where(x => x.StoreId == SelectedStoreId);
            if (SelectedCategoryCode != 0)
                query = query.Where(x => x.CategoryCode == SelectedCategoryCode);
            if (SelectedItemId != 0)
                query = query.Where(x => x.ItemId == SelectedItemId);

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                query = query.Where(x =>
                    (x.ItemCode != null && x.ItemCode.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.ItemName != null && x.ItemName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.HSNCode != null && x.HSNCode.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.MeasureUnit != null && x.MeasureUnit.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.Category != null && x.Category.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.ScreenName != null && x.ScreenName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.AddStoreName != null && x.AddStoreName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.RefNo != null && x.RefNo.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.AddedBy != null && x.AddedBy.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.Make != null && x.Make.Contains(_searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (x.CustomerNames != null && x.CustomerNames.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                );
            }

            if (_showCurrentStock)
                query = query.Where(x => x.BalQty > 0);

            if (_rolVisible)
                query = query.Where(x => x.BalQty > 0 && x.ROL > 0 && x.BalQty < x.ROL);
            else if (_molVisible)
                query = query.Where(x => x.BalQty > 0 && x.MOL > 0 && x.BalQty > x.MOL);
            else if (_rolmolVisible)
                query = query.Where(x => x.BalQty > 0 && ((x.MOL > 0 && x.BalQty > x.MOL) || (x.ROL > 0 && x.BalQty < x.ROL)));

            if (_nonMovingDays > 0)
            {
                var cutoff = DateTime.Now.AddDays(-_nonMovingDays);
                query = query.Where(x => x.AddDate <= cutoff);
            }

            return query.ToList();
        }
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await InitializeColumns(IsHidden);

            UserName = await _userService.GetUsernameAsync();
            await LoadCustomerColumnPreferences(UserName);

            await LoadMasterDataAsync();
            await LoadStockDataAsync();
        }
