    private string GetQtyColorClass(decimal balQty, decimal rol, decimal mol)
    {
        if (balQty <= 0) return "text-secondary";
        if (balQty < mol) return "text-danger";
        if (balQty < rol) return "text-warning";
        return "text-success";
    }


