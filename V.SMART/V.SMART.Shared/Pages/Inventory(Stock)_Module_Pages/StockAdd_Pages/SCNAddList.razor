@page "/scnGenList"

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@inject ISCNGenService scnGenService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Stock Addition List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@SCNBreadcrumbs" />

            <div class="card-body p-4">

                 <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">

                    </div>

                    @if (CanCreate)
                    {
                       <div class="col-6 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewSCN">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </button>
                       </div>
                    }

                </div>

                @if (SCNGenVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="SCNGenVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Any(c => c.IsVisible))
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            // 🔹 Primary Info
                                            case "SCNGenId":
                                                <PropertyColumn Title="SCN ID" Property="@(c => c.SCNGenId)" Sortable="true" />
                                                break;

                                            case "SCNGenNo":
                                                <PropertyColumn Title="SCN No" Property="@(c => $"{c.SCNGenNo}{c.Suffix}")" Sortable="true" />
                                                break;

                                            case "SCNGenDate":
                                                <PropertyColumn Title="SCN Date" Property="@(c => c.SCNGenDate)" Format="dd/MM/yyyy" />
                                                break;

                                            // 🔹 Store Info
                                            case "StoreId":
                                                <PropertyColumn Title="Store ID" Property="@(c => c.StoreId)" Sortable="true" />
                                                break;

                                            case "StoreName":
                                                <PropertyColumn Title="Store Name" Property="@(c => c.StoreName)" Sortable="true" />
                                                break;

                                            // 🔹 Assembly Info
                                            case "IsWithBom":
                                                <TemplateColumn Title="With BOM" Context="c">
                                                    @if (c.IsWithBom)
                                                    {
                                                        <span class="badge bg-success">Yes</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">No</span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            case "AssyId":
                                                <PropertyColumn Title="Assembly ID" Property="@(c => c.AssyId)" />
                                                break;

                                            case "AssyItemCode":
                                                <PropertyColumn Title="Assembly Item" Property="@(c => c.AssyItemCode)" />
                                                break;

                                            case "SubAssyId":
                                                <PropertyColumn Title="Sub Assembly ID" Property="@(c => c.SubAssyId)" />
                                                break;

                                            case "SubAssyItemCode":
                                                <PropertyColumn Title="Sub Assembly Item" Property="@(c => c.SubAssyItemCode)" />
                                                break;

                                            // 🔹 Quantities
                                            case "ReqQty":
                                                <PropertyColumn Title="Required Qty" Property="@(c => Math.Round(c.ReqQty, 3))" />
                                                break;

                                            // 🔹 Remarks
                                            case "MainRemark":
                                                <PropertyColumn Title="Remarks" Property="@(c => c.MainRemark)" />
                                                break;

                                            // 🔹 Audit Info
                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date" Property="@(c => c.ModifiedDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "SCNGenSubs.Count":
                                                <PropertyColumn Title="No. of Items" Property="@(c => c.NoOfItems)" />
                                                break;
                                        }
                                    </div>
                                }
                            }
                            
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"scnGen/update/{c.SCNGenId}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Stock Addition">
                                           <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"scnGen/details/{c.SCNGenId}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Stock Addition">
                                           <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete Stock Addition"
                                                @onclick="() => HandleDelete(c.SCNGenId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>
                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}


@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Stock-Add";

    private int screenCode{ get; set; }

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteSCNId = 0;
    private string searchText = string.Empty;
    private string selectedStatus = "";

    private List<SCNGenVM> SCNGenVMs = new();

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> SCNBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Inventory" },
        new PageHeader.BreadcrumbItem { Text = "Stock Transfer Note (Addition)", IsLast = true }
    };

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            screenCode = await scnGenService.GetScreenCodeByScreenNameAsync(ScreenName);
            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllSCN();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in Stock Transfer Note OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    #region === Data Loading ===

    private async Task LoadAllSCN()
    {
        try
        {
            var result = await scnGenService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            SCNGenVMs = result.sCNGenVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading data in Stock Transfer Note List");
            await _JS.ToastrError("Failed to load Stock Transfer Note List.");
        }
    }

    private void AddNewSCN()
    {
        _navigation.NavigateTo("/scnGen/create");
    }

    #endregion



    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                // 🔹 Primary Info
                new() { Title = "SCN ID", Field = "SCNGenId", IsVisible = false },
                new() { Title = "SCN No", Field = "SCNGenNo", IsVisible = true },
                new() { Title = "SCN Date", Field = "SCNGenDate", IsVisible = true },

                // 🔹 Store
                new() { Title = "Store ID", Field = "StoreId", IsVisible = false },
                new() { Title = "Store Name", Field = "StoreName", IsVisible = true },

                // 🔹 Assembly / Item Info
                new() { Title = "With BOM", Field = "IsWithBom", IsVisible = true },
                new() { Title = "Assembly ID", Field = "AssyId", IsVisible = false },
                new() { Title = "Assembly Item", Field = "AssyItemCode", IsVisible = true },
                new() { Title = "Sub Assembly ID", Field = "SubAssyId", IsVisible = false },
                new() { Title = "Sub Assembly", Field = "SubAssyItemCode", IsVisible = true },

                new() { Title = "No. of Items", Field = "NoOfItems", IsVisible = true },
                // 🔹 Remarks
                new() { Title = "Remarks", Field = "MainRemark", IsVisible = true },

                // 🔹 Audit Info
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };


            if (!Hidden)
            {
                // Columns.AddRange(new[]
                // {
                //     new GridColumn { Title = "Extra Column 1", Field = "Extra1", IsVisible = false },
                //     new GridColumn { Title = "Extra Column 2", Field = "Extra2", IsVisible = false },
                // });
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Stock Transfer Note List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Stock Transfer Note HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllSCN();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Stock Transfer Note List");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllSCN();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Stock Transfer Note");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllSCN();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Stock Transfer Note");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllSCN();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Stock Transfer Note");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllSCN();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Stock Transfer Note");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllSCN();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Stock Transfer Note page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int scnId)
    {
        try
        {
            
            var (canDelete, message) = await scnGenService.CanDeleteSCNGenAsync(scnId, screenCode);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteSCNId = scnId;

            ModalTitle = "Are you sure you want to delete this SCN General";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for SCNGenId: {scnId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;
           
            var deleted = await scnGenService.DeleteSCNGenBySCNGenIdAsync(DeleteSCNId,screenCode);

            if (deleted)
            {
                await _JS.ToastrSuccess("Stock Transfer Note deleted successfully.");
                await LoadAllSCN();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("SCN could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting SCNGenId: {DeleteSCNId}");
            await _JS.ToastrError("Failed to delete Stock Transfer Note.");
        }
        finally
        {
            DeleteSCNId = 0;
            isProcessing = false;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllSCN();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Stock Transfer Note List");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion
}
