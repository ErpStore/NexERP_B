    #region Row Operations

    private async Task<bool> ValidateRowAsync(SCNGenSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if  (row.Qty == null || row.Qty <= 0)
                errors.Add("Quantity must be greater than 0.");

            if (row.UnitPrice == null || row.UnitPrice <= 0)
                errors.Add("Unit Price must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = SCNGenVMs.SCNGenSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (!await ValidateLastRowAsync()) return;

            SCNGenVMs.SCNGenSubVMs.Add(new SCNGenSubVM
            {
                SCNGenId = SCNGenVMs.SCNGenId,
                IsEditable = true
            });

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await LoggingService.LogDeveloperError(ex, "AddRow failed.");
        }
    }

    private async Task SaveRow(SCNGenSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            if (!SCNGenVMs.SCNGenSubVMs.Any(x => x.IsEditable) && (SCNGenVMs.AssyId == 0 || SCNGenVMs.AssyId == null))
            {
                SCNGenVMs.SCNGenSubVMs.Add(new SCNGenSubVM
                {
                    SCNGenId = SCNGenVMs.SCNGenId,
                    IsEditable = true
                });
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for SCNGenSubId: {item?.SCNGenSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(SCNGenSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItemVMs == null && item.ItemId > 0)
            {
                item.SelectedItemVMs = await _scnGenService.GetItemByItemIdAsync(item.ItemId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for SCNGenSubId: {item?.SCNGenSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(SCNGenSubVM? item, SCNGenVM? parentScn)
    {
        try
        {
            if (item == null || parentScn == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentScn.SCNGenSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for SCNGenSubIs: {item?.SCNGenSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(SCNGenSubVM item)
    {
        try
        {
            if (SCNGenVMs.SCNGenSubVMs.Count == 1 && item.SCNGenSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if(IsSomeTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            var (addQty, balQty) = await _scnGenService.GetQtyBalQtyByStockAddAsync(
                            screenCode,
                            SCNGenVMs.StoreId.Value,
                            item.ItemId.Value,
                            item.SCNGenSubId);

            if (addQty != balQty)
            {
                await _js.ToastrWarning($"cannot delete item '{item.ItemCode}'. Stock already used.");
                return;
            }



            if (item.ItemId == 0)
            {
                SCNGenVMs.SCNGenSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!SCNGenVMs.SCNGenSubVMs.Any())
                    SCNGenVMs.SCNGenSubVMs = new List<SCNGenSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for SCnGenSubId: {item?.SCNGenSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
             if (SCNGenVMs?.SCNGenSubVMs == null || !SCNGenVMs.SCNGenSubVMs.Any())
                return;

            int counter = 1;
            foreach (var sub in SCNGenVMs.SCNGenSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to reset row serial numbers.");
        }
    }

