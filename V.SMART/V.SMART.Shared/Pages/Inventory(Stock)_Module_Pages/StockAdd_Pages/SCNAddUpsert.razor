    #region SCN Gen Operations

    private async Task UpsertSCNGen()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            SCNGenVMs.SCNGenSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (! SCNGenVMs.SCNGenSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a SCNGen without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in  SCNGenVMs.SCNGenSubVMs)
            {
                bool isValid = await ValidateSCNGenLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewSCN = SCNGenVMs.SCNGenId == 0;

            try
            {
                await _scnGenService.UpsertSCNAsync(SCNGenVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewSCN)
                await _js.ToastrSuccess("Store Transfer Note saved successfully.");
            else
                await _js.ToastrSuccess("Store Transfer Note updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/scnGenList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertSCNGen failed.");
            await _js.ToastrError("Error saving Store Transfer Note.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateSCNGenLineAsync(SCNGenSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            
            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidatePOLineAsync failed.");
            await _js.ToastrError("Error Validate Manufacturing-PO line.");
            return false;
        }
    }

