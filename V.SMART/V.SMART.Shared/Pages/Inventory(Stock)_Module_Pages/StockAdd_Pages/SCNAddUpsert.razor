    private async Task UpdateSubItemQtyAsync(SCNGenSubVM subItem, decimal newQty)
    {
        // Common validation
        if (newQty <= 0)
        {
            subItem.Qty = 0;
            await _js.ToastrWarning("Qty must be a positive number.");
            return;
        }

        // NEW line
        if (subItem.SCNGenSubId == 0)
        {
            subItem.Qty = newQty;
            return;
        }

        // EXISTING line
        var (addQty, balQty) = await _scnGenService.GetQtyBalQtyByStockAddAsync(
                                    screenCode,
                                    SCNGenVMs.StoreId.Value,
                                    subItem.ItemId.Value,
                                    subItem.SCNGenSubId);

        decimal alreadyTransacted = addQty - balQty;

        // Validate new quantity
        if (newQty < alreadyTransacted)
        {
            subItem.Qty = alreadyTransacted;
            await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
        }
        else
        {
            subItem.Qty = newQty;
        }
    }

    private async Task OnQtyChange(ChangeEventArgs e, SCNGenSubVM subItem)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty)) return;
            await UpdateSubItemQtyAsync(subItem, newQty);
            RecalculateReqQty();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for SCNGenSubId: {subItem?.SCNGenSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    private async Task OnReqQtyChanged(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var newReqQty)) return;

        SCNGenVMs.ReqQty = newReqQty;

        if (SCNGenVMs.SCNGenSubVMs == null || !SCNGenVMs.SCNGenSubVMs.Any()) return;

        foreach (var subItem in SCNGenVMs.SCNGenSubVMs)
        {
            var intendedQty = subItem.UtlQty * newReqQty;
            await UpdateSubItemQtyAsync(subItem, intendedQty.GetValueOrDefault());
        }

        RecalculateReqQty(); // Optional: recalc average ReqQty
    }

    private void RecalculateReqQty()
    {
        if (SCNGenVMs.SCNGenSubVMs == null || !SCNGenVMs.SCNGenSubVMs.Any()) return;

        decimal totalReqQty = 0;
        int count = 0;

        foreach (var sub in SCNGenVMs.SCNGenSubVMs)
        {
            if (sub.UtlQty.GetValueOrDefault() > 0)
            {
                totalReqQty += sub.Qty.GetValueOrDefault() / sub.UtlQty.GetValueOrDefault();
                count++;
            }
        }

        if (count > 0)
            SCNGenVMs.ReqQty = totalReqQty / count;
    }

