    private async Task OnAssemblyOrSubAssemblyChange(ChangeEventArgs e, string changeType)
    {
        try
        {
            isProcessing = true;

            if (int.TryParse(e.Value?.ToString(), out int selectedId))
            {
                if (changeType == "Assembly")
                    SCNGenVMs.AssyId = selectedId;
                else if (changeType == "SubAssembly")
                    SCNGenVMs.SubAssyId = selectedId;
                else if (changeType == "SubAssembly2")
                    SCNGenVMs.SubAssyId2 = selectedId;
                else if (changeType == "SubAssembly3")
                    SCNGenVMs.SubAssyId3 = selectedId;

                var relatedItems = await _scnGenService.GetAssemblyRelatedItemsAsync(
                    selectedId,
                    SCNGenVMs.ReqQty,
                    SCNGenVMs.StoreId.GetValueOrDefault()
                );

                if (relatedItems != null && relatedItems.Any())
                {
                    var subVMTasks = relatedItems.Select(async item => new SCNGenSubVM
                    {
                        SelectedItemVMs = await _scnGenService.GetItemByItemIdAsync(item.ItemId),
                        ItemId = item.ItemId,
                        ItemCode = item.ItemCode,
                        ItemName = item.ItemName,
                        UOM = item.UOM,
                        UtlQty = item.UtlQty,
                        Qty = item.Qty,
                        StockQty = item.StockQty,
                        UnitPrice = item.UnitPrice,
                        BatchNo = item.BatchNo,
                        RackNo = item.RackNo,
                        Make = item.Make,
                        Remark = item.Remark,
                        CostId = item.CostId,
                        ProjectNo = item.ProjectNo,
                        IsEditable = true
                    });

                    SCNGenVMs.SCNGenSubVMs = (await Task.WhenAll(subVMTasks)).ToList();
                    await ResetSlno();
                }
                else
                {
                    if (changeType == "Assembly")
                        SCNGenVMs.AssyId = null;
                    else if (changeType == "SubAssembly")
                        SCNGenVMs.SubAssyId = null;
                    else if (changeType == "SubAssembly2")
                        SCNGenVMs.SubAssyId2 = null;
                    else if (changeType == "SubAssembly3")
                        SCNGenVMs.SubAssyId3 = null;

                    SCNGenVMs.SCNGenSubVMs.Clear();
                    await _js.ToastrInfo($"No related items found for the selected {changeType}.");
                }

                if (changeType == "Assembly")
                {
                    SCNGenVMs.SubAssyId = null;
                    SubAssyList.Clear();
                    SubAssyList = await _scnGenService.GetAllSubAssembliesByAssyIdAsync(selectedId);
                }
                else if (changeType == "SubAssembly")
                {
                    SCNGenVMs.SubAssyId2 = null;
                    SubAssyList2.Clear();
                    SubAssyList2 = await _scnGenService.GetAllSubAssembliesByAssyIdAsync(selectedId);
                }
                else if (changeType == "SubAssembly2")
                {
                    SCNGenVMs.SubAssyId3 = null;
                    SubAssyList3.Clear();
                    SubAssyList3 = await _scnGenService.GetAllSubAssembliesByAssyIdAsync(selectedId);
                }
            }
            else
            {
                if (changeType == "Assembly")
                    SCNGenVMs.AssyId = 0;
                else if (changeType == "SubAssembly")
                    SCNGenVMs.SubAssyId = 0;

                SCNGenVMs.SCNGenSubVMs.Clear();
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError($"Failed to load {changeType} details.");
            await LoggingService.LogDeveloperError(ex, $"On{changeType}Change failed");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }


