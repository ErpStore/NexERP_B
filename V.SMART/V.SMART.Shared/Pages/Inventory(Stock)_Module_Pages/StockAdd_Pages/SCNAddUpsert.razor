    private async Task UploadExcelFile(InputFileChangeEventArgs e)
    {
        isProcessing = true;
        uploadMessage = string.Empty;

        try
        {
            var file = e.File;
            if (file.Size > 5 * 1024 * 1024)
            {
                uploadMessage = "File size exceeds 5 MB.";
                return;
            }

            using var memoryStream = new MemoryStream();
            await file.OpenReadStream().CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var workbook = new ClosedXML.Excel.XLWorkbook(memoryStream);
            var ws = workbook.Worksheet("SCNGeneralTemplate");

            // Map headers dynamically
            int lastCol = ws.LastColumnUsed().ColumnNumber();
            var headerMap = new Dictionary<string, int>();
            for (int col = 1; col <= lastCol; col++)
            {
                var headerName = ws.Cell(1, col).GetValue<string>()?.Trim();
                if (!string.IsNullOrEmpty(headerName))
                    headerMap[headerName] = col;
            }

            var rowsData = new List<(int SlNo, string ItemCode, decimal Qty, decimal UnitPrice,
                string Remark, string BatchNo, string Make, string RackNo, string UOM, string ItemType, int CategoryCode, string HSNCode)>();

            var errors = new List<string>();
            int row = 2;

            // Step 0: Read & validate Excel rows
            while (!ws.Cell(row, headerMap["SlNo"]).IsEmpty())
            {
                int.TryParse(ws.Cell(row, headerMap["SlNo"]).GetValue<string>(), out var slNo);
                var itemCode = ws.Cell(row, headerMap["ItemCode"]).GetValue<string>()?.Trim();
                var uom = headerMap.ContainsKey("UOM") ? ws.Cell(row, headerMap["UOM"]).GetValue<string>()?.Trim() : string.Empty;
                var itemTypeRaw = headerMap.ContainsKey("ItemType") ? ws.Cell(row, headerMap["ItemType"]).GetValue<string>()?.Trim() : string.Empty;
                string hsnCode = headerMap.ContainsKey("HSNCode") ? ws.Cell(row, headerMap["HSNCode"]).GetValue<string>()?.Trim() : string.Empty;
                var categoryRaw = headerMap.ContainsKey("Category") ? ws.Cell(row, headerMap["Category"]).GetValue<string>()?.Trim() : string.Empty;

                int categoryCode = 0;
                if (!string.IsNullOrEmpty(categoryRaw))
                {
                    var parts = categoryRaw.Split('-');
                    if (!int.TryParse(parts[0].Trim(), out categoryCode))
                    {
                        errors.Add($"Row {row}: Invalid CategoryCode '{parts[0]}'. Must be an integer.");
                        row++;
                        continue;
                    }
                }

                decimal.TryParse(ws.Cell(row, headerMap["AddQty"]).GetValue<string>(), out var qty);
                decimal.TryParse(ws.Cell(row, headerMap["UnitPrice"]).GetValue<string>(), out var unitPrice);

                string remark = headerMap.ContainsKey("Remark") ? ws.Cell(row, headerMap["Remark"]).GetValue<string>()?.Trim() : string.Empty;
                string batchNo = headerMap.ContainsKey("BatchNo") ? ws.Cell(row, headerMap["BatchNo"]).GetValue<string>()?.Trim() : string.Empty;
                string make = headerMap.ContainsKey("Make") ? ws.Cell(row, headerMap["Make"]).GetValue<string>()?.Trim() : string.Empty;
                string rackNo = headerMap.ContainsKey("RackNo") ? ws.Cell(row, headerMap["RackNo"]).GetValue<string>()?.Trim() : string.Empty;

                // Row-wise validations
                if (string.IsNullOrEmpty(itemCode))
                {
                    errors.Add($"Row {row}: ItemCode is required.");
                    row++;
                    continue;
                }

                if (categoryCode == 0)
                {
                    errors.Add($"Row {row}: CategoryCode is required and must be a valid integer.");
                    row++;
                    continue;
                }

                rowsData.Add((slNo, itemCode, qty, unitPrice, remark, batchNo, make, rackNo, uom, itemTypeRaw, categoryCode, hsnCode));
                row++;
            }

            if (rowsData.Count == 0)
            {
                uploadMessage = "No valid rows found in the Excel file.";
                return;
            }

            // Step 1: Get existing ItemIds
            var itemCodesDistinct = rowsData.Select(r => r.ItemCode).Distinct().ToList();
            var itemIdDict = await _scnGenService.GetItemIdsByItemCodesAsync(itemCodesDistinct);

            // Step 2: Fetch valid UOMs & Categories
            var validUOMs = await _unitOfWork.UOMs.GetAllAsync();
            var uomSet = validUOMs.Select(u => u.UnitCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var validCategories = await _unitOfWork.Categories.GetAllAsync();
            var categorySet = validCategories.Select(c => c.CategoryCode).ToHashSet(); // int set

            var uploadedRows = new List<SCNGenSubVM>();

            // Step 3: Start Transaction
            using var transaction = await _unitOfWork.BeginTransactionAsync();
            try
            {
                foreach (var r in rowsData)
                {
                    int itemId;
                    string mappedItemType = r.ItemType?.Trim().Equals("Brought-Out", StringComparison.OrdinalIgnoreCase) == true ? "BtOt" : "Mfg";

                    if (!itemIdDict.TryGetValue(r.ItemCode?.Trim(), out itemId))
                    {
                        // Validate UOM & Category inside transaction
                        if (!uomSet.Contains(r.UOM?.Trim()))
                        {
                            errors.Add($"Row {r.SlNo}: UOM '{r.UOM}' is invalid.");
                            throw new Exception("Invalid UOM found. Transaction rolled back.");
                        }

                        if (!categorySet.Contains(r.CategoryCode))
                        {
                            errors.Add($"Row {r.SlNo}: Category '{r.CategoryCode}' does not exist.");
                            throw new Exception("Invalid Category found. Transaction rolled back.");
                        }

                        // Ensure HSN exists
                        await _scnGenService.GetOrCreateHSNAsync(r.HSNCode?.Trim());

                        // Create new item
                        itemId = await _scnGenService.CreateNewItemAsync(new Item
                        {
                            BtOtorMfg = mappedItemType,
                            ItemCode = r.ItemCode?.Trim(),
                            ItemName = r.ItemCode?.Trim(),
                            MeasureUnit = r.UOM?.Trim(),
                            CategoryCode = r.CategoryCode,
                            HSNCode = r.HSNCode?.Trim(),
                            SACCode = r.HSNCode?.Trim()
                        });

                        itemIdDict[r.ItemCode.Trim()] = itemId;
                    }

                    // Get ItemVM & Stock
                    var itemVM = await _scnGenService.GetItemByItemIdAsync(itemId);
                    int defaultStoreId = 1;
                    var stockQty = await _scnGenService.GetStockForItemAsync(itemId, defaultStoreId);

                    uploadedRows.Add(new SCNGenSubVM
                    {
                        SlNo = r.SlNo,
                        ItemCode = r.ItemCode,
                        ItemId = itemVM.ItemId,
                        ItemName = itemVM.ItemName,
                        UOM = itemVM.MeasureUnit,
                        Qty = r.Qty,
                        UnitPrice = r.UnitPrice,
                        SelectedItemVMs = itemVM,
                        StockQty = stockQty,
                        Remark = r.Remark,
                        BatchNo = r.BatchNo,
                        Make = r.Make,
                        RackNo = r.RackNo,
                        IsEditable = true
                    });
                }

                // Step 4: Commit Transaction
                await transaction.CommitAsync();

                SCNGenVMs.SCNGenSubVMs = uploadedRows;
                await ResetSlno();

                if (errors.Any())
                {
                    foreach (var err in errors)
                        await _js.ToastrError(err);
                }

                await _js.ToastrSuccess($"Successfully uploaded {uploadedRows.Count} rows. New items created if valid.");
                uploadMessage = $"Successfully uploaded {uploadedRows.Count} rows.";
            }
            catch
            {
                // Rollback transaction
                await transaction.RollbackAsync();
                if (!errors.Any()) errors.Add("Transaction rolled back due to an error in processing.");
                foreach (var err in errors)
                    await _js.ToastrError(err);
            }
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error: {ex.Message}";
            await _js.ToastrError(uploadMessage);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }



