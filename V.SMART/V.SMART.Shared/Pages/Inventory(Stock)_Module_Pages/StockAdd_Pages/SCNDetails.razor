@page "/scnGen/details/{SCNGenId:int}"

@inherits BaseUserRightsComponent
@inject NavigationManager _navigationManager
@inject ILoggingService LoggingService
@inject ISCNGenService _scnGenService
@inject IJSRuntime _js

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <!-- Company Details Section -->
            <MyCompanyDetails />

            <hr class="border-2 border-primary-subtle mb-4" />

            <!-- SCN Details & Document Details Section -->
            <div class="row g-3 mb-4">
                <!-- SCN Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            SCN Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>SCN No.</strong></td>
                                        <td>@(!string.IsNullOrEmpty(SCNGenVMs?.SCNGenNo) ? SCNGenVMs.SCNGenNo : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>SCN Date</strong></td>
                                        <td>@(SCNGenVMs?.SCNGenDate != null ? SCNGenVMs.SCNGenDate.ToString("dd/MM/yyyy") : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Added to Store</strong></td>
                                        <td>@(!string.IsNullOrEmpty(SCNGenVMs?.StoreName) ? SCNGenVMs.StoreName : "N/A")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>


                <!-- Assembly Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Assembly Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>With BOM</strong></td>
                                        <td>@(SCNGenVMs.IsWithBom ? "Yes" : "No")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Assembly Name</strong></td>
                                        <td>@(!string.IsNullOrEmpty(SCNGenVMs?.AssyItemCode) ? SCNGenVMs.AssyItemCode : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Sub-Assembly</strong></td>
                                        <td>@(!string.IsNullOrEmpty(SCNGenVMs?.SubAssyItemCode) ? SCNGenVMs.SubAssyItemCode : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Sub-Assembly 2</strong></td>
                                        <td>@(!string.IsNullOrEmpty(SCNGenVMs?.SubAssyItemCode2) ? SCNGenVMs.SubAssyItemCode2 : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Sub-Assembly 3</strong></td>
                                        <td>@(!string.IsNullOrEmpty(SCNGenVMs?.SubAssyItemCode3) ? SCNGenVMs.SubAssyItemCode3 : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Required Qty</strong></td>
                                        <td>@(SCNGenVMs?.ReqQty.ToString() ?? "0")</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>


            </div>

            <!-- SCN Items Section -->
            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    Store Transfer Note Items
                </div>
                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">

                        <thead class="custom-blue">
                            <tr>
                                <th class="text-center">Sl No.</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th class="text-center">UOM</th>
                                <th>Add Qty</th>
                                <th>Stock Qty</th>
                                <th>Unit Price</th>
                                <th>Basic Amount</th>
                                <th>Batch No.</th>
                                <th>Rack No.</th>
                                <th>Make</th>
                                <th>Remarks</th>
                                <th>Cost-Center</th>
                            </tr>
                        </thead>

                        <tbody class="custom-size">
                            @if (SCNGenVMs?.SCNGenSubVMs != null && SCNGenVMs.SCNGenSubVMs.Any())
                            {
                                @foreach (var item in SCNGenVMs.SCNGenSubVMs)
                                {
                                    <tr>
                                        <td class="text-center">@item.SlNo</td>
                                        <td>@(item.ItemCode ?? "—")</td>
                                        <td>@(item.ItemName ?? "—")</td>
                                        <td class="text-center">@item.UOM</td>
                                        <td class="text-center">@item.Qty</td>
                                        <td class="text-end">@item.StockQty</td>
                                        <td class="text-end">@FormatDecimal(item.UnitPrice)</td>
                                        <td class="text-end">@FormatDecimal(item.LineGross)</td>
                                        <td class="text-center">@item.BatchNo</td>
                                        <td class="text-center">@item.RackNo</td>
                                        <td class="text-center">@item.Make</td>
                                        <td class="text-center">@item.Remark</td>
                                        <td class="text-center">@item.ProjectNo</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Due Date & Tax Totals Section -->
            <div class="row g-3 mb-4">
                <!-- Due Date & Terms and Conditions -->
                <div class="col-12">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-warning-subtle text-warning-emphasis fw-semibold p-2 small">
                            Remarks
                        </div>
                        <div class="card-body p-2 small">
                            <p class="mb-1"> @(!string.IsNullOrEmpty(SCNGenVMs?.MainRemark) ? SCNGenVMs.MainRemark : "N/A")</p>
                        </div>
                    </div>
                </div>


            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 justify-content-end">
                <a href="/scnGenList" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Back To List
                </a>
                <a href="@($"/scnGen/update/{SCNGenId}")" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Modify
                </a>
                <button class="btn btn-outline-success" onclick="window.print()">
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
        </div>
    }
}


@code {

    protected override string ScreenName => "Stock-Add";

    [Parameter]
    public int SCNGenId { get; set; }

    private bool isProcessing { get; set; } = true;
    private SCNGenVM SCNGenVMs { get; set; } = new SCNGenVM();

    private int Decimalplaces { get; set; } = 2;

    private string FormatDecimal(decimal? value)
    {
        try
        {
            if (value == null) return "0";
            return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
        }
        catch (Exception ex)
        {
            _js.ToastrError("Error Ocuured in FormatDecimal()");
            LoggingService.LogDeveloperError(ex, "Error Ocuured in FormatDecimal()");
            return "";
        }
    }

    protected override async Task OnInitializedAsync()
    {

        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            await LoadSCNGenDetails();
            isProcessing = false;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error Occured in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadSCNGenDetails()
    {
        try
        {
            if (SCNGenId > 0)
            {
                var scn = await _scnGenService.GetSCNBySCNGenIdAsync(SCNGenId);
                if (scn != null)
                {
                    SCNGenVMs = scn;
                }

                Decimalplaces = await _scnGenService.GetDecimalPlacesAsync();
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error Ocuured in LoadSCNGenDetails()");
            await LoggingService.LogDeveloperError(ex, "Error Ocuured in LoadSCNGenDetails()");
        }
    }
}
