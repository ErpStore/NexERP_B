@page "/tcr/details/{DcId:int}"
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.InventoryViewModel
@using V.SMART.Shared.ViewModels.InventoryViewModel.ToolCribViewModels
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel

@inject IToolCribReturnService _tcReturnService
@inject IJSRuntime _js
@inject ILoggingService _logs

@inject ReportService _reportService
@inherits BaseUserRightsComponent

@inject NavigationManager _navigationManager

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <!-- Company Details Section -->
            <MyCompanyDetails />

            <hr class="border-2 border-primary-subtle mb-4" />

            <div class="text-center">
                <h4 class="text-semibold mt-3">TOOLCRIB - RETURN NOTE</h4>
            </div>

            <hr class="border-2 border-primary-subtle mb-4" />

            <!-- ToolCribReturn & Store Details Section -->
            <div class="row g-3 mb-4">
                <!-- ToolCribReturn Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            ToolCribReturn Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>ToolCribReturn No</strong></td>
                                        <td>@(TCRVMs != null ? $"{TCRVMs.TCReturnNo}{TCRVMs.Suffix}" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>ToolCribReturn Date</strong></td>
                                        <td>@(TCRVMs?.TCReturnDate.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Issue No.</strong></td>
                                        <td>@refTCNosDisplay</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Issue Dt.</strong></td>
                                        <td>@refTCDatesDisplay</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Store Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Document Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Add To Store</strong></td>
                                        <td>@(!string.IsNullOrEmpty(TCRVMs?.StoreId.ToString()) ? TCRVMs.StoreName : "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Return From</strong></td>
                                        <td>@(!string.IsNullOrEmpty(TCRVMs?.FromWhom) ? TCRVMs.FromWhom : "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width:40%;"><strong>Breakage Remark</strong></td>
                                        <td>@(!string.IsNullOrEmpty(TCRVMs.BreakageRemarks) ? TCRVMs.BreakageRemarks : "N/A")</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ToolCribReturn Items Section -->
            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    ToolCribReturn Items
                </div>
                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                        <thead class="custom-blue">
                            <tr>
                                <th class="text-center">Sl No.</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th class="text-center">UOM</th>
                                <th class="text-center">HSN</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Rejection Qty</th>
                                <th class="text-end">Rework Qty</th>
                                <th>Rejection Remark</th>
                                <th>Rework Remark</th>

                            </tr>
                        </thead>
                        <tbody class="custom-size">
                            @if (TCRVMs?.ToolCribReturnSubVMs != null && TCRVMs.ToolCribReturnSubVMs.Any())
                            {
                                @foreach (var item in TCRVMs.ToolCribReturnSubVMs)
                                {
                                    <tr>
                                        <td class="text-center">@item.SlNo</td>
                                        <td>@(item.ItemCode ?? "—")</td>
                                        <td>@(item.ItemName ?? "—")</td>
                                        <td class="text-center">@item.MeasureUnit</td>
                                        <td class="text-center">@item.HSNCode</td>
                                        <td class="text-end">@FormatDecimal(item.AccpQty)</td>
                                        <td class="text-end">@FormatDecimal(item.RejQty)</td>
                                        <td class="text-end">@FormatDecimal(item.RewQty)</td>
                                        <td>@item.RejRemark</td>
                                        <td>@item.RewRemark</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 justify-content-end">
                <a href="/tcReturnList" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Back To List
                </a>

                <a href="@($"/tcr/update/{DcId}")" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Modify
                </a>

                <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>
        </div>
    }
}

@code {
    protected override string ScreenName => "Tool-Crib Return";
    [Parameter]
    public int DcId { get; set; }

    private string? pdfBase64 { get; set; } = string.Empty;

    private bool isProcessing { get; set; } = true;
    private ToolCribReturnVM TCRVMs { get; set; } = new ToolCribReturnVM();
    private CustomerVM CustomerVMs { get; set; } = new CustomerVM();

    private Companydetails company { get; set; } = new Companydetails();
    private List<ToolCribReturnSubVM> refToolCribIssues = new();
    private string refTCNosDisplay = "N/A";
    private string refTCDatesDisplay = "N/A";
    private int Decimalplaces { get; set; } = 2;

    private string FormatDecimal(decimal? value)
    {
        try
        {
            if (value == null) return "0";
            return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
        }
        catch (Exception ex)
        {
            _js.ToastrError("Error Occured in LoadToolCribReturn()");
            _logs.LogDeveloperError(ex, "Error Occured in LoadToolCribReturn()");
            return "";
        }
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            //company = await _quoteService.GetCompanyDetailsAsync();
            await LoadToolCribReturn();
            isProcessing = false;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error Occured in LoadToolCribReturn()");
        }
    }

    private async Task LoadToolCribReturn()
    {
        try
        {
            if (DcId > 0)
            {
                var tcreturn = await _tcReturnService.GetToolCribReturnByDcIdAsync(DcId);
                if (tcreturn != null)
                {
                    TCRVMs = tcreturn;
                }

                refToolCribIssues = await _tcReturnService.GetDistinctRefToolCribIssuesByDcIdAsync(TCRVMs.TCReturnId);

                if (refToolCribIssues.Any())
                {
                    // Only join the existing items, no extra commas
                    refTCNosDisplay = string.Join(", ", refToolCribIssues.Select(e => e.RefTCIssueNo).Where(n => !string.IsNullOrEmpty(n)));
                    refTCDatesDisplay = string.Join(", ", refToolCribIssues
                        .Select(e => e.RefTCIssueDate.HasValue ? e.RefTCIssueDate.Value.ToString("dd/MM/yyyy") : null)
                        .Where(d => !string.IsNullOrEmpty(d)));
                }
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error Occured in LoadToolCribReturn()");
            await _logs.LogDeveloperError(ex, "Error Occured in LoadToolCribReturn()");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            var pdfBytes = await _reportService.Generate_Report(DcId, "ToolCribReturnNote.frx", "TCReturnId", false, ScreenName, "Sp_Print_ToolCribReturn");

            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf ToolCribReturn");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in ToolCribReturn.");
        }
    }


}
