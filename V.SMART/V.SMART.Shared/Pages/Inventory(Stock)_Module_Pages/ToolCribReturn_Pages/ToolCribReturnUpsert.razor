    private async Task UpsertTcr()
    {
        try
        {
            isProcessing = true;

            TCRVMs.ToolCribReturnSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (x.AccpQty == 0));

            if (!TCRVMs.ToolCribReturnSubVMs.Any())
            {
                await _JS.ToastrError("Cannot save a ToolCribReturn without valid items.");
                return;
            }

            if( TCRVMs.StoreId == null || TCRVMs.StoreId == 0)
            {
                await _JS.ToastrError("Please select a Store before saving.");
                return;
            }

            if(string.IsNullOrEmpty(TCRVMs.TCReturnNo))
            {
                await _JS.ToastrError("Return Number is Required!..");
                return;
            }

            if(string.IsNullOrEmpty(TCRVMs.FromWhom))
            {
                await _JS.ToastrError("Return by name is required!..");
                return;
            }

            foreach (var line in TCRVMs.ToolCribReturnSubVMs)
            {
                bool isValid = await ValidateToolCribReturnLineAsync(line);
                if (!isValid) return;
            }

            var isNewTcr = TCRVMs.TCReturnId == 0;
            try
            {
                await tcReturnService.UpsertToolCribReturnAsync(TCRVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewTcr)
                await _JS.ToastrSuccess("ToolCribReturn saved successfully.");
            else
                await _JS.ToastrSuccess("ToolCribReturn updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/tcReturnList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertTcr failed.");
            await _JS.ToastrError("Error saving ToolCribReturn.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateToolCribReturnLineAsync(ToolCribReturnSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _JS.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            var totalQty = (line.AccpQty ?? 0) + (line.RejQty ?? 0) + (line.RewQty ?? 0);

            if (totalQty <= 0)
            {
                await _JS.ToastrError(
                    $"Item {line.ItemCode}: Accepted + Rejected + Reworked Qty must be greater than 0."
                );
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateToolCribReturnLineAsync failed.");
            await _JS.ToastrError("Error validating Tool Crib Return line.");
            return false;
        }
    }


