    private async Task OnIssueSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {

        if (TCRVMs.ToolCribReturnSubVMs == null)
            TCRVMs.ToolCribReturnSubVMs = new List<ToolCribReturnSubVM>();

        try
        {

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefTcIssueSubId = item.ContainsKey("RefTCIssueSubId") && item["RefTCIssueSubId"] != null
                    ? Convert.ToInt32(item["RefTCIssueSubId"])
                    : (int?)null;

                if (TCRVMs.ToolCribReturnSubVMs.Any(x => x.ItemId == itemId && x.RefTCIssueSubId == RefTcIssueSubId))
                    continue;

                var subVm = new ToolCribReturnSubVM
                {
                    RefTCIssueSubId = RefTcIssueSubId,
                    RefTCIssueNo = item.ContainsKey("TCIssueNo") ? item["TCIssueNo"]?.ToString() : "",
                    RefTCIssueDate = item.ContainsKey("TCIssueDate") && item["TCIssueDate"] != null
                        ? Convert.ToDateTime(item["TCIssueDate"])
                        : null,
                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("MeasureUnit") ? item["MeasureUnit"]?.ToString() : "",
                    AccpQty = item.ContainsKey("BalQty") && item["BalQty"] != null ? Convert.ToInt32(item["BalQty"]) : 0,
                    IsEditable = true
                };

                TCRVMs.ToolCribReturnSubVMs.Add(subVm);
            }

            int slNo = 1;
            foreach (var row in TCRVMs.ToolCribReturnSubVMs)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnIssueSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected Tool crib Issue items.");
        }
    }

