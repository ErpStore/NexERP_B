    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

           
            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.TCReturnSubId > 0)
            {
                await tcReturnService.DeleteAndResequenceAsync(rowToDelete, TCRVMs,screenCode);
                TCRVMs.ToolCribReturnSubVMs = await tcReturnService.GetToolCribReturnSubByDcIdAsync(TCRVMs.TCReturnId);
            }
            else
            {
                TCRVMs.ToolCribReturnSubVMs.Remove(rowToDelete);

                if (!TCRVMs.ToolCribReturnSubVMs.Any())
                {
                    TCRVMs.ToolCribReturnSubVMs.Add(new ToolCribReturnSubVM
                    {
                        TCReturnId = TCRVMs.TCReturnId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    for (int i = 0; i < TCRVMs.ToolCribReturnSubVMs.Count; i++)
                        TCRVMs.ToolCribReturnSubVMs[i].SlNo = i + 1;
                }
            }

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for TCId: {TCRVMs.TCReturnId}");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

