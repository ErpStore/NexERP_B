@page "/tcr/create"
@page "/tcr/update/{TCReturnId:int}"


@using V.SMART.Shared.Data.Inventory_Stock_.ToolCrib
@using V.SMART.Shared.Data.Master.MasterScreeenManagement_Module
@using V.SMART.Shared.Pages.Master_Module_pages.Items_Pages
@using V.SMART.Shared.Pages.Master_Module_pages.TermsAndConditions_Pages
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.InventoryViewModel
@using V.SMART.Shared.ViewModels.InventoryViewModel.ToolCribViewModels
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IToolCribReturnService tcReturnService
@inject ILoggingService LoggingService

@inject ReportService _reportService
@inject NavigationManager _navigationManager
@inject IJSRuntime _JS


<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle>
</BsModal>

<DetailsModal Title="ToolCribIssue Details"
              Columns="@IssueColumns"
              ColumnFields="@IssueFields"
              HiddenColumns="@IssueHiddenColumns"
              Data="@IssueData"
              IsVisible="@IsIssueModalVisible"
              IsVisibleChanged="@((val) => IsIssueModalVisible = val)"
              OnSelectedItems="OnIssueSelectedAsync">
</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
            refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <PageHeader TitleText="@(TCRVMs.TCReturnId > 0 ? "Update ToolCribReturn" : "Create ToolCribReturn")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@TcrFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="TCRVMs" OnValidSubmit="UpsertTcr">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">

                        <!-- Correspondence Status -->
                        <div class="col-12  d-flex justify-content-end align-items-center">
                            @if (TCRVMs.TCReturnId > 0 && !string.IsNullOrWhiteSpace(TCRVMs.TCReturnNo))
                            {
                                <CorrespondenceStatus ReferenceType="ToolCribReturn"
                                                      ReferenceId="@TCRVMs.TCReturnId"
                                                      ReferenceTypeName="@TCRVMs.TCReturnNo" />
                            }
                        </div>
                    </div>

                    <div class="row g-3 mb-3">

                        <!-- =================== Document Details =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm border-0 h-100">
                                <!-- Header -->
                                <div class="card-header bg-primary-subtle text-dark py-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold fs-6">Document Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- ToolCribReturn No -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>ToolCrib Return No.</small>
                                        </label>
                                        <div class="col-sm-9">
                                            <div class="input-group input-group-sm">
                                                <InputText class="form-control form-control-sm rounded-start-3"
                                                           placeholder="ToolCrib Return No."
                                                           maxlength="30"
                                                           @bind-Value="@TCRVMs.TCReturnNo" />
                                                <span class="input-group-text rounded-end-3">@TCRVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => TCRVMs.TCReturnNo)" />
                                            <ValidationMessage For="@(() => TCRVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- ToolCribReturn Date -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>ToolCrib Return Date</small>
                                        </label>
                                        <div class="col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="TCRVMs.TCReturnDate" />
                                            <ValidationMessage For="@(() => TCRVMs.TCReturnDate)" />
                                        </div>
                                    </div>

                                    <!-- Reference Issue -->
                                    @if (issuePendingCount > 0)
                                    {
                                        <div class="row mb-2 align-items-center">
                                            <label class="col-sm-3 col-form-label text-dark fw-medium">
                                                <small>Ref. Issue</small>
                                            </label>
                                            <div class="col-sm-9">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowIssueDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Issue Details
                                                </button>
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        <!-- =================== Store Details =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-primary-subtle text-dark py-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold fs-6">Store Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- Add To Store -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>Add To Store</small>
                                        </label>

                                        <div class="col-sm-9">
                                            <select @bind="@TCRVMs.StoreId"
                                                    class="form-select form-select-sm rounded-3">
                                                <option value="0">-- Select Store --</option>

                                                @foreach (var store in stores)
                                                {
                                                    <option value="@store.StoreId">@store.StoreName</option>
                                                }
                                            </select>

                                            <ValidationMessage For="@(() => TCRVMs.StoreId)" />
                                        </div>
                                    </div>


                                    <!-- Return By -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>Return By</small>
                                        </label>
                                        <div class="col-sm-9">
                                           @*  <InputText class="form-control form-control-sm rounded-3"
                                                       @bind-Value="TCRVMs.FromWhom" /> *@

                                            <MudAutocomplete T="Staff"
                                                             Label="Return By"
                                                             Variant="Variant.Outlined"
                                                             Dense="true"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             SearchFunc="SearchStaff"
                                                             ToStringFunc="@(x => x?.StaffName ?? string.Empty)"
                                                             @bind-Value="SelectedStaff"
                                                             MaxItems="50" />
                                            <ValidationMessage For="@(() => TCRVMs.FromWhom)" />
                                        </div>
                                    </div>

                                    <!-- Breakage Remarks -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>Breakage Remarks</small>
                                        </label>
                                        <div class="col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3"
                                                      rows="1"
                                                      @bind="TCRVMs.BreakageRemarks"></textarea>
                                            <ValidationMessage For="@(() => TCRVMs.BreakageRemarks)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- =================== Item Details =================== -->
                    <div class="col-12">
                        <div class="card shadow-sm border-1"
                             style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                            <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                <span class="fw-bold fs-6">Item Details</span>
                            </div>

                            <div class="card-body p-2">
                                <div class="table-responsive" style="overflow-x:auto;">
                                    <table class="table table-bordered table-sm align-middle text-center mb-0"
                                           style="table-layout: fixed; min-width: 1200px;">
                                        <thead class="custom-blue">
                                            <tr>
                                                <th style="width:50px;">Sl.No</th>
                                                <th style="width:90px;">Ref Issue No</th>
                                                <th style="width:120px;">Ref Issue Date</th>
                                                <th style="width:160px;">Item Code</th>
                                                <th style="width:200px;">Item Name</th>
                                                <th style="width:80px;">UOM</th>
                                                <th style="width:100px;">Acc Qty</th>
                                                <th style="width:150px;">Reject Qty</th>
                                                <th style="width:150px;">Rejection Remarks</th>
                                                <th style="width:150px;">Rework Qty</th>
                                                <th style="width:150px;">Rework Remarks</th>
                                                <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody class="custom-size">
                                            @if (TCRVMs?.ToolCribReturnSubVMs != null && TCRVMs.ToolCribReturnSubVMs.Any())
                                            {
                                                @foreach (var subitem in TCRVMs.ToolCribReturnSubVMs)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>
                                                        <td>@subitem.RefTCIssueNo</td>
                                                        <td>@subitem.RefTCIssueDate?.ToString("dd/MM/yyyy")</td>
                                                        <td>@subitem.ItemCode</td>
                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.MeasureUnit</td>

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm text-end"
                                                                       placeholder="Acc Qty"
                                                                       min="0"
                                                                       step="any"
                                                                       @bind="subitem.AccpQty"
                                                                       @bind:event="oninput"
                                                                       @bind:after="async () => await OnAccpQtyChange(subitem.AccpQty, subitem)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.AccpQty
                                                            }
                                                        </td>

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm text-end"
                                                                       placeholder="Rej Qty"
                                                                       min="0"
                                                                       step="any"
                                                                       @bind="subitem.RejQty"
                                                                       @bind:event="oninput"
                                                                       @bind:after="async () => await OnRejQtyChange(subitem.RejQty, subitem)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.RejQty
                                                            }
                                                        </td>

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="text"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Rejection Remarks"
                                                                       @bind="subitem.RejRemark" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.RejRemark
                                                            }
                                                        </td>

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm text-end"
                                                                       placeholder="Rew Qty"
                                                                       min="0"
                                                                       step="any"
                                                                       @bind="subitem.RewQty"
                                                                       @bind:event="oninput"
                                                                       @bind:after="async () => await OnRewQtyChange(subitem.RewQty, subitem)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.RewQty
                                                            }
                                                        </td>

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="text"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Rework Remarks"
                                                                       @bind="subitem.RewRemark" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.RewRemark
                                                            }
                                                        </td>

                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            <div class="d-flex justify-content-end align-items-center gap-1">
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                            @onclick="async () => await SaveRow(subitem)">
                                                                        <i class="bi bi-check-lg"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                            @onclick="async () => await CancelEdit(subitem, TCRVMs)">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                            @onclick="async () => await EditRowAsync(subitem)">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                            @onclick="async () => await RemoveRow(subitem)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                }
                                                            </div>
                                                        </td>

                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>


                    <!-- =================== Action Buttons =================== -->
                    <div class="row g-3 mt-3">
                        @if (CanCreate || CanEdit)
                        {
                            <div class="col-6 col-md-3">
                                <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                    <i class="bi bi-floppy2-fill me-1"></i>
                                    @(TCRVMs.TCReturnId > 0 ? "Update" : "Create")
                                </button>
                            </div>
                        }
                        <div class="col-6 col-md-3">
                            <SmartBackButton Url="/tcReturnList" />
                        </div>

                        @if (CanCreate || CanEdit && TCReturnId > 0)
                        {
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                    <i class="bi bi-printer me-1"></i>Print
                                </button>
                            </div>
                        }
                    </div>

                </EditForm>
            </div>
        </div>
    </div>

}


@code {

    #region Parameters & Properties

    protected override string ScreenName => "Tool-Crib Return";

    [Parameter] public int? TCReturnId { get; set; }

    private int screenCode { get; set; }
    private string? pdfBase64 { get; set; } = string.Empty;

    private bool isProcessing = true;
    private ToolCribReturnVM TCRVMs { get; set; } = new();
    private ToolCribReturnSubVM TCRSubVMs { get; set; } = new();
    private ToolCribReturnSubVM? rowToDelete;

    private DateTime? DueDate { get; set; } = DateTime.Today;
    private bool IsSomeItemsTransMade { get; set; } = false;

    private bool IsEditMode = false;

    private List<Store> stores = new();
    private List<ToolCribIssue> tcinos = new();
    private List<ToolCribIssueSubVM> tcisubitems = new();
    private List<ToolCribReturnSubVM> tcrsubitems = new();
    private List<Category> categories = new();
    private List<string> UserList = new();
    public List<string> allToolCribNumbers = new();

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private int issuePendingCount = 0;

    private bool IsIssueModalVisible = false;
    private List<Dictionary<string, object>>? IssueData;
    private List<string> IssueColumns = new() { "RefTCIssueSubId", "TCIssueNo", "TCIssueDate", "ItemId", "ItemCode", "ItemName", "MeasureUnit", "Qty", "BalQty", "Rate", "Remarks" };
    private List<string> IssueFields = new() { "RefTCIssueSubId", "TCIssueNo", "TCIssueDate", "ItemId", "ItemCode", "ItemName", "MeasureUnit","Qty", "BalQty", "Rate","Remarks" };
    private List<string> IssueHiddenColumns = new() { "RefTCIssueSubId", "ItemId" };

    private List<PageHeader.BreadcrumbItem> TcrFormBreadcrumbs = new()
    {
        new() { Text = "Inventory" },
        new() { Text = "ToolCribReturn", IsLast = true }
    };

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private int DecimalPlaces { get; set; } = 2;

    private List<Staff> StaffList = new();
    private Staff? _selectedStaff;
    public Staff? SelectedStaff
    {
        get => _selectedStaff;
        set
        {
            _selectedStaff = value;

            if (value != null)
            {
                TCRVMs.FromWhom = value.StaffName;
                // TCIVMs.IssuedToStaffId = value.StaffId; // Recommended
            }
            else
            {
                TCRVMs.FromWhom = string.Empty;
                // TCIVMs.IssuedToStaffId = 0;
            }
        }
    }

    #endregion


    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            stores = (await tcReturnService.GetAllReturnStoresAsync()).ToList();
            screenCode = await tcReturnService.GetScreenCodeByScreenNameAsync(ScreenName);
            issuePendingCount = await tcReturnService.GetPendingIssueCountAsync();
            StaffList = await tcReturnService.GetAllStaffAsync();
            if (TCReturnId.HasValue)
            {

                await LoadExistingTcr(TCReturnId.Value);
            }
            else if (TCReturnId == null)
            {
                await InitializeNewTcr();
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
    private async Task LoadExistingTcr(int dcId)
    {
        try
        {
            TCRVMs = await tcReturnService.GetToolCribReturnByDcIdAsync(dcId);
            SelectedStaff = StaffList.FirstOrDefault(x => x.StaffName == TCRVMs.FromWhom);
            if (TCRVMs == null)
            {
                await _JS.ToastrWarning("ToolCribReturn not found.");
                return;
            }

            foreach (var tcrSub in TCRVMs.ToolCribReturnSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[tcrSub.ItemId.Value] =
                    await tcReturnService.GetCorrespondenceAttachmentsCountAsync(tcrSub.ItemId.Value, "Item");
            }

            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load existing Po.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingTCR failed for TCReturnId: {TCReturnId}");
        }
    }

    private bool CheckIsTransMade()
    {
        var list = TCRVMs?.ToolCribReturnSubVMs;
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0, totalAccpQty = 0, totalRejQty = 0, totalRewQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalAccpQty += list[i].AccpQty.GetValueOrDefault();
            totalRejQty += list[i].RejQty.GetValueOrDefault();
            totalRewQty += list[i].RewQty.GetValueOrDefault();
        }

        return totalQty != totalBalQty;
    }

    private async Task InitializeNewTcr()
    {
        try
        {
            TCRVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            TCRVMs.TCReturnNo = await tcReturnService.GetToolCribReturnNumberAsync(TCRVMs.Suffix);

            var MapStoreForTCReturn = await tcReturnService.GetMappedStoreForFormAsync("ToolCribReturnForm");

            if (MapStoreForTCReturn.StoreId > 0)
            {
                TCRVMs.StoreId = MapStoreForTCReturn.StoreId;
                TCRVMs.StoreName = MapStoreForTCReturn.StoreName;
            }
            else
            {
                TCRVMs.StoreId = null;
                TCRVMs.StoreName = null;
            }


        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to initialize new return.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewTcr failed.");
        }
    }

    #region Qty Handlers

    private async Task<decimal> GetIssueQtyAsync(ToolCribReturnSubVM subVM)
    {
        if (subVM.RefTCIssueSubId is null or 0)
            return 0;

        return await tcReturnService.GetTCIssueItemBalQtyFromTCIssueSubId(subVM.RefTCIssueSubId.Value);
    }

    private async Task<bool> ValidateAndAdjustAsync(
                            ToolCribReturnSubVM subVM,
                            decimal newAccp,
                            decimal newRej,
                            decimal newRew,
                            string fieldName)
    {
        var issueQty = await GetIssueQtyAsync(subVM);

        var original = await tcReturnService
            .GetTCReturnSubItemDetailByTCReturnSubIdAsync(subVM.TCReturnSubId);

        decimal originalAccp = original?.AccpQty ?? 0;
        decimal originalRej = original?.RejQty ?? 0;
        decimal originalRew = original?.RewQty ?? 0;

        var originalTotal = originalAccp + originalRej + originalRew;

        var maxAllowed = issueQty + originalTotal;
        var total = newAccp + newRej + newRew;

        if (total > maxAllowed)
        {
            await _JS.ToastrWarning(
                $"{fieldName} change exceeded limit. Max allowed total is {maxAllowed}. Auto-adjusted.");

            if (fieldName == "Accepted")
                subVM.AccpQty = maxAllowed - (newRej + newRew);

            else if (fieldName == "Rejected")
                subVM.RejQty = maxAllowed - (newAccp + newRew);

            else if (fieldName == "Rework")
                subVM.RewQty = maxAllowed - (newAccp + newRej);

            return false;
        }

        return true;
    }


    private async Task OnAccpQtyChange(decimal? newValue, ToolCribReturnSubVM subVM)
    {
        try
        {
            var accp = newValue.GetValueOrDefault();
            if (accp < 0)
            {
                subVM.AccpQty = 0;
                await _JS.ToastrWarning("Accepted Qty must be positive.");
                return;
            }

            var rej = subVM.RejQty.GetValueOrDefault();
            var rew = subVM.RewQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, "Accepted"))
                subVM.AccpQty = accp;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnAccpQtyChange failed");
            await _JS.ToastrError("Failed to update Accepted Qty.");
        }
    }

    private async Task OnRejQtyChange(decimal? newValue, ToolCribReturnSubVM subVM)
    {
        try
        {
            var rej = newValue.GetValueOrDefault();
            if (rej < 0)
            {
                subVM.RejQty = 0;
                await _JS.ToastrWarning("Rejected Qty must be positive.");
                return;
            }

            var accp = subVM.AccpQty.GetValueOrDefault();
            var rew = subVM.RewQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, "Rejected"))
                subVM.RejQty = rej;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnRejQtyChange failed");
            await _JS.ToastrError("Failed to update Rejection Qty.");
        }
    }

    private async Task OnRewQtyChange(decimal? newValue, ToolCribReturnSubVM subVM)
    {
        try
        {
            var rew = newValue.GetValueOrDefault();
            if (rew < 0)
            {
                subVM.RewQty = 0;
                await _JS.ToastrWarning("Rework Qty must be positive.");
                return;
            }

            var accp = subVM.AccpQty.GetValueOrDefault();
            var rej = subVM.RejQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, "Rework"))
                subVM.RewQty = rew;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnRewQtyChange failed");
            await _JS.ToastrError("Failed to update Rework Qty.");
        }
    }


