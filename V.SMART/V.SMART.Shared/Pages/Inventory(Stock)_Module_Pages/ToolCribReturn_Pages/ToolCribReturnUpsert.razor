    #region Row Operations

    private async Task<bool> ValidateRowAsync(ToolCribReturnSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (row.AccpQty == null || row.AccpQty <= 0)
                errors.Add("Quantity must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _JS.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = TCRVMs.ToolCribReturnSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task SaveRow(ToolCribReturnSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            if((item.AccpQty.GetValueOrDefault() + item.RejQty.GetValueOrDefault() + item.RewQty.GetValueOrDefault()) == 0 )
            {
                await _JS.ToastrError("Accecpt Qty, Reject Qty Or Re-work Qty Should not be 0");
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for TCSubId: {item?.TCReturnId}");
            await _JS.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(ToolCribReturnSubVM item)
    {
        try
        {
            item.IsEditable = true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for DcSubid: {item?.TCReturnId}");
            await _JS.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(ToolCribReturnSubVM? item, ToolCribReturnVM? parentTcr)
    {
        try
        {
            if (item == null || parentTcr == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (item.AccpQty <= 0);

            if (isEmptyOrInvalid)
            {
                parentTcr.ToolCribReturnSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for PoSubId: {item?.TCReturnId}");
            await _JS.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(ToolCribReturnSubVM item)
    {
        try
        {
            if (TCRVMs.ToolCribReturnSubVMs.Count == 1 && item.TCReturnId > 0)
            {
                await _JS.ToastrWarning("At least 1 row item is required.");
                return;
            }

            var (addQty, balQty) = await tcReturnService.GetQtyBalQtyByStockAddAsync(
                          screenCode,
                          TCRVMs.StoreId.Value,
                          item.ItemId.Value,
                          item.TCReturnSubId);

            if (addQty != balQty)
            {
                await _JS.ToastrWarning($"cannot delete item '{item.ItemCode}'. Stock already used.");
                return;
            }

            if (item.ItemId == 0)
            {
                TCRVMs.ToolCribReturnSubVMs.Remove(item);
                await _JS.ToastrSuccess("New item row removed successfully.");

                if (!TCRVMs.ToolCribReturnSubVMs.Any())
                    TCRVMs.ToolCribReturnSubVMs = new List<ToolCribReturnSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for TCReturnId: {item?.TCReturnId}");
            await _JS.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in TCRVMs.ToolCribReturnSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _JS.ToastrError("Failed to reset row serial numbers.");
        }
    }
