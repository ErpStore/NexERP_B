    #region Tool-Crib Issue Operations

    private async Task UpsertTci()
    {
        try
        {
            isProcessing = true;

            TCIVMs.ToolCribIssueSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (x.QtyOut.GetValueOrDefault() == 0) &&
                (x.UnitPrice.GetValueOrDefault() == 0));

            if (!TCIVMs.ToolCribIssueSubVMs.Any())
            {
                await _JS.ToastrError("Cannot save a ToolCrib without valid items.");
                return;
            }

            if(TCIVMs.StoreId == null)
            {
                await _JS.ToastrError("Store selection is Required");
                return;
            }

            if(TCIVMs.CategoryCode == null)
            {
                await _JS.ToastrError("Category selection is Required");
                return;
            }

            if (string.IsNullOrWhiteSpace(TCIVMs.IssuedToWhom))
            {
                await _JS.ToastrError("Issue To Whom is required.");
                return;
            }


            foreach (var line in TCIVMs.ToolCribIssueSubVMs)
            {
                bool isValid = await ValidateToolCribIssueLineAsync(line);
                if (!isValid) return;
            }

            var isNewTCIssue = TCIVMs.TCIssueId == 0;

            try
            {
                await tcIssueService.UpsertToolCribisueAsync(TCIVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewTCIssue)
                await _JS.ToastrSuccess("ToolCribIssue saved successfully.");
            else
                await _JS.ToastrSuccess("ToolCribIssue updated successfully.");
            
            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/tcIssueList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Upsert Tool crib issue failed.");
            await _JS.ToastrError("Error saving ToolCribIssue.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateToolCribIssueLineAsync(ToolCribIssueSubVM line)
    {
        try
        {
            var errors = new List<string>();

            if (!line.ItemId.HasValue)
                errors.Add("Item selection is required.");

            if (!line.QtyOut.HasValue || line.QtyOut <= 0)
                errors.Add($"Item {line.ItemCode}: Issue Quantity must be greater than 0.");

            // if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            //     errors.Add($"Item {line.ItemCode}: Unit Price must be greater than 0.");

            decimal maxAllowedQty = line.StockQty.GetValueOrDefault();
            decimal alreadyTransacted = 0m;
            decimal origQty = 0m;
            decimal origBalQty = 0m;

            if (line.TCIssueSubId > 0)
            {
                var original = await tcIssueService
                    .GetToolCribIssueSubItemDetailByTCSubIdAsync(line.TCIssueSubId);

                if (original != null)
                {
                    origQty = original.QtyOut.GetValueOrDefault();
                    origBalQty = original.BalQty.GetValueOrDefault();
                    alreadyTransacted = origQty - origBalQty;

                    maxAllowedQty = line.StockQty.GetValueOrDefault() + origBalQty;

                    if (line.QtyOut < alreadyTransacted)
                    {
                        errors.Add(
                            $"Item {line.ItemCode}: Qty cannot be less than already transacted ({alreadyTransacted})."
                        );
                    }
                    else
                    {
                        decimal difference = line.QtyOut.Value - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            if (line.QtyOut > maxAllowedQty)
                errors.Add(
                    $"Item {line.ItemCode}: Issue Qty cannot exceed available stock ({maxAllowedQty})."
                );

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _JS.ToastrError(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateToolCribIssueLineAsync failed.");
            await _JS.ToastrError("Error validating Tool Crib Issue line.");
            return false;
        }
    }

