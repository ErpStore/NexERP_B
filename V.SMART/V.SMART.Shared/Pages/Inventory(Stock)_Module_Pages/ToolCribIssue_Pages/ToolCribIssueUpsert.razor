@page "/tci/create"
@page "/tci/update/{TCIssueId:int}"

@using V.SMART.Shared.Data.Master.MasterScreeenManagement_Module
@using V.SMART.Shared.Pages.Master_Module_pages.Items_Pages
@using V.SMART.Shared.Pages.Master_Module_pages.TermsAndConditions_Pages
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.InventoryViewModel
@using V.SMART.Shared.ViewModels.InventoryViewModel.ToolCribViewModels
@using MudBlazor
@using V.SMART.Shared.ViewModels.MasterViewModel.HumanResourceViewModel

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IToolCribIssueService tcIssueService
@inject ILoggingService LoggingService
@inject ReportService _reportService
@inject NavigationManager _navigationManager
@inject IJSRuntime _JS

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle>
</BsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">

    @if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                   refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }

</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@(TCIVMs.TCIssueId > 0 ? "Update ToolCribIssue" : "Create ToolCribIssue")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@TciFormBreadcrumbs" />

            <div class="card-body bg-light">

                <EditForm Model="TCIVMs" OnValidSubmit="@UpsertTci">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />


                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Correspondence Status -->
                        <div class="col-12  d-flex justify-content-end align-items-center">
                            @if (TCIVMs.TCIssueId > 0 && !string.IsNullOrWhiteSpace(TCIVMs.TCIssueNo))
                            {
                                <CorrespondenceStatus ReferenceType="ToolCribIssue"
                                                      ReferenceId="@TCIVMs.TCIssueId"
                                                      ReferenceTypeName="@TCIVMs.TCIssueNo" />
                            }
                        </div>
                    </div>

                    <div class="row g-3 mb-2">

                        <!-- =================== Document Details =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm border-0 h-100">

                                <!-- Header -->
                                <div class="card-header bg-primary-subtle text-dark py-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold fs-6">Document Details</span>
                                </div>

                                <div class="card-body p-3">

                                    <!-- TC No -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>ToolCrib Issue No.</small>
                                        </label>
                                        <div class="col-sm-9">
                                            <div class="input-group input-group-sm">
                                                <input type="text"
                                                       class="form-control form-control-sm rounded-start-3"
                                                       placeholder="ToolCrib Issue No."
                                                       @bind="TCIVMs.TCIssueNo"
                                                       readonly />
                                                <span class="input-group-text rounded-end-3">@TCIVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => TCIVMs.TCIssueNo)" />
                                            <ValidationMessage For="@(() => TCIVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- ToolCrib Issue Date -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>ToolCrib Issue Date</small>
                                        </label>
                                        <div class="col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@TCIVMs.TCIssueDate" />
                                            <ValidationMessage For="@(() => TCIVMs.TCIssueDate)" />
                                        </div>
                                    </div>

                                    <!-- Issued To Whom -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>Issued To Whom</small>
                                        </label>
                                        <div class="col-sm-9">
                                           @*  <input list="userList"
                                                   id="IssuedToWhom"
                                                   class="form-control form-control-sm rounded-3"
                                                   @bind="TCIVMs.IssuedToWhom" />
                                            <datalist id="userList">
                                                @foreach (var item in UserList)
                                                {
                                                    <option value="@item" />
                                                }
                                            </datalist> *@

                                            <MudAutocomplete T="Staff"
                                                             Label="Issued To Whom"
                                                             Variant="Variant.Outlined"
                                                             Dense="true"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             SearchFunc="SearchStaff"
                                                             ToStringFunc="@(x => x?.StaffName ?? string.Empty)"
                                                             @bind-Value="SelectedStaff"
                                                             MaxItems="50" />

                                            <ValidationMessage For="@(() => TCIVMs.IssuedToWhom)" class="text-danger small mt-1" />
                                        </div>
                                    </div>

                                    <!-- Category -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>Category</small>
                                        </label>
                                        <div class="col-sm-9">
                                            <select @bind="TCIVMs.CategoryCode"
                                                    class="form-select form-select-sm rounded-3 w-100"
                                                    id="ToolCribIssue"  @bind:after="OnCategoryChanged" >
                                                <option value="0">-- Select Category --</option>
                                                @if (categories != null && categories.Any())
                                                {
                                                    @foreach (var category in categories)
                                                    {
                                                        <option value="@category.CategoryCode">@category.CategoryName</option>
                                                    }
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => TCIVMs.CategoryCode)" class="text-danger small mt-1" />
                                        </div>
                                    </div>

                                    <!-- Description -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>Description</small>
                                        </label>
                                        <div class="col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3"
                                                      rows="1"
                                                      @bind="TCIVMs.Description"></textarea>
                                            <ValidationMessage For="@(() => TCIVMs.Description)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- =================== Store Details =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm border-0 h-100">

                                <!-- Header -->
                                <div class="card-header bg-primary-subtle text-dark py-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold fs-6">Store Details</span>
                                </div>

                                <div class="card-body p-3">

                                    <!-- Issue From Store -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>Issue From Store</small>
                                        </label>
                                        <div class="col-sm-9">
                                            <select class="form-select form-select-sm rounded-3"
                                                    id="storeId"
                                                    value="@TCIVMs.StoreId"
                                                    @onchange="OnStoreChanged">

                                                <option value="0">-- Select Store --</option>
                                                @foreach (var storeid in stores)
                                                {
                                                    <option value="@storeid.StoreId">@storeid.StoreName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => TCIVMs.StoreId)" class="text-danger small mt-1" />
                                        </div>
                                    </div>

                                    <!-- TC Remarks -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label text-dark fw-medium">
                                            <small>Main Remarks</small>
                                        </label>
                                        <div class="col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3"
                                                      rows="1"
                                                      @bind="TCIVMs.MainRemarks"></textarea>
                                            <ValidationMessage For="@(() => TCIVMs.MainRemarks)" />
                                        </div>
                                    </div>

                                    <!-- Returnable Switch -->
                                    <div class="row mb-3 align-items-center">
                                        <div class="col-sm-8 offset-sm-4">
                                            <div class="card shadow-sm border-0 bg-light-subtle p-3 rounded-3 d-flex align-items-center justify-content-between"
                                                 style="max-width: 280px;">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-arrow-repeat fs-5 text-primary"></i>
                                                    <label class="form-check-label fw-semibold text-dark mb-0" for="ReturnCheck">
                                                        Returnable
                                                    </label>
                                                </div>

                                                <div class="form-check form-switch m-0">
                                                    <InputCheckbox id="ReturnCheck"
                                                                   class="form-check-input shadow-sm"
                                                                   style="width: 2.5rem; height: 1.3rem; cursor: pointer;"
                                                                   @bind-Value="TCIVMs.IsReturn" />
                                                </div>
                                            </div>

                                            @if (TCIVMs.IsReturn)
                                            {
                                                <div class="mt-2">
                                                    <span class="badge bg-success-subtle text-success fw-semibold px-3 py-2">
                                                        <i class="bi bi-check-circle me-1"></i> Returnable Enabled
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mt-2">
                                                    <span class="badge bg-secondary-subtle text-secondary fw-semibold px-3 py-2">
                                                        <i class="bi bi-x-circle me-1"></i> Not Returnable
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                                <div class="card-header bg-primary-subtle text-dark">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                                        <span class="fw-bold fs-6">Item Details</span>

                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:70px;">HSN</th>
                                                    <th style="width:120px;">Qty</th>
                                                    <th style="width:200px;">StockQty</th>
                                                    <th style="width:200px;">BalQty</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:200px;">Remarks</th>

                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in TCIVMs.ToolCribIssueSubVMs)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @if (subitem.IsEditable && subitem.QtyOut == subitem.BalQty)
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                         Value="subitem.SelectedItem"
                                                                                         ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                         ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                         SearchFunc="SearchItems"
                                                                                         Dense="true"
                                                                                         Variant="Variant.Outlined"
                                                                                         Placeholder="Search Item Code"
                                                                                         Title="Search Atleast 3 Letters in Item-Code"
                                                                                         Class="w-100 autocomplete-sm"
                                                                                         MaxItems="50" />
                                                                        <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.ItemCode
                                                                    }
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                    && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                       Size="Size.Small"
                                                                                       Color="Color.Primary"
                                                                                       OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                       Edge="Edge.End"
                                                                                       Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.MeasureUnit</td>
                                                        <td>@subitem.HSNCode</td>

                                                        <!-- QtyOut -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Qty"
                                                                       title="Enter Quantity"
                                                                       step="any"
                                                                       @bind="subitem.QtyOut"
                                                                       @bind:event="oninput"
                                                                       @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.QtyOut)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.QtyOut</span>
                                                            }
                                                        </td>

                                                        <td>
                                                            <span class="text-danger fw-bold">@subitem.StockQty</span>
                                                        </td>

                                                        <!-- BalanceQty-->
                                                        <td>
                                                            <span>@subitem.BalQty</span>
                                                        </td>

                                                        <!-- UnitPrice -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="UnitPrice"
                                                                       title="Enter UnitPrice"
                                                                       step="any"
                                                                       @bind="subitem.UnitPrice"
                                                                       @bind:event="oninput" />
                                                               @*  <ValidationMessage For="@(() => subitem.UnitPrice)" /> *@
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.UnitPrice</span>
                                                            }
                                                        </td>

                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputTextArea @bind-Value="subitem.Remark"
                                                                                rows="1"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="Enter Remarks" />
                                                                <ValidationMessage For="@(() => subitem.Remark)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.Remark
                                                            }
                                                        </td>

                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            <div class="d-flex justify-content-end align-items-center gap-1">
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                            @onclick="async () => await SaveRow(subitem)">
                                                                        <i class="bi bi-check-lg"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                            @onclick="async () => await CancelEdit(subitem, TCIVMs)">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                            @onclick="async () => await EditRowAsync(subitem)">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                            @onclick="async () => await RemoveRow(subitem)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                }
                                                            </div>
                                                        </td>

                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="mt-2 text-start">
                                        <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                            <i class="bi bi-plus-circle me-1"></i> Add Item
                                        </button>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Action Buttons -->
                            @if (CanCreate || CanEdit)
                            {
                                <div class="col-6 col-md-3 mt-3">
                                    <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                        <i class="bi bi-floppy2-fill me-1"></i> @(TCIVMs.TCIssueId > 0 ? "Update" : "Create")
                                    </button>
                                </div>
                            }

                            <div class="col-6 col-md-3 mt-3">
                                <SmartBackButton Url="/tcIssueList" />
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@code {

    #region Parameters & Properties

    protected override string ScreenName => "Tool-Crib Issue";

    private int screenCode { get; set; }

    [Parameter] public int? TCIssueId { get; set; }

    private bool isProcessing = true;
    private ToolCribIssueVM TCIVMs { get; set; } = new();
    private ToolCribIssueSubVM? rowToDelete;

    private bool IsSomeItemsTransMade { get; set; } = false;

    private List<string> UserList = new();
    private string? pdfBase64 { get; set; } = string.Empty;

    private List<Store> stores = new();
    private List<Category> categories = new();

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private List<PageHeader.BreadcrumbItem> TciFormBreadcrumbs = new()
    {
        new() { Text = "Inventory" },
        new() { Text = "ToolCribIssue", IsLast = true }
    };

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private int DecimalPlaces { get; set; } = 2;

    private List<Staff> StaffList = new();
    private Staff? _selectedStaff;
    public Staff? SelectedStaff
    {
        get => _selectedStaff;
        set
        {
            _selectedStaff = value;

            if (value != null)
            {
                TCIVMs.IssuedToWhom = value.StaffName;
                // TCIVMs.IssuedToStaffId = value.StaffId; // Recommended
            }
            else
            {
                TCIVMs.IssuedToWhom = string.Empty;
                // TCIVMs.IssuedToStaffId = 0;
            }
        }
    }
    #endregion


    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            screenCode = await tcIssueService.GetScreenCodeByScreenNameAsync(ScreenName);
            stores = (await tcIssueService.GetAllIssueStoresAsync()).ToList();
            categories = await tcIssueService.GetAllCategoriesAsync();
            //UserList = await tcIssueService.GetAllExistingUserNamesinTCIssueAsync();
            StaffList = await tcIssueService.GetAllStaffAsync();
            if (TCIssueId.HasValue)
            {
                await LoadExistingTci(TCIssueId.Value);
            }
            else
            {
                await InitializeNewTci();
            }


        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
            await _JS.ToastrError("Failed to load Toolcribissue screen.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingTci(int tcId)
    {
        try
        {
            TCIVMs = await tcIssueService.GetToolCribIssueByTCIdAsync(tcId);
            SelectedStaff = StaffList.FirstOrDefault(x => x.StaffName == TCIVMs.IssuedToWhom);
            if (TCIVMs == null)
            {
                await _JS.ToastrWarning("Toolcribissue not found.");
                return;
            }

            foreach (var issue in TCIVMs.ToolCribIssueSubVMs)
            {
                if (issue.ItemId.HasValue && issue.ItemId > 0)
                    attachmentCounts[issue.ItemId.Value] = await tcIssueService.GetCorrespondenceAttachmentsCountAsync(issue.ItemId.Value, "Item");
            }

            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load existing Po.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingPo failed for TCIssueId: {TCIssueId}");
        }
    }

    private bool CheckIsTransMade()
    {
        var list = TCIVMs?.ToolCribIssueSubVMs;
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalQty += list[i].QtyOut.GetValueOrDefault();
            totalBalQty += list[i].BalQty.GetValueOrDefault();
        }

        return totalQty != totalBalQty;
    }


    private async Task InitializeNewTci()
    {
        try
        {
            TCIVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            TCIVMs.TCIssueNo = await tcIssueService.GetTCNumberAsync(TCIVMs.Suffix);

            var MapStoreForToolCrib = await tcIssueService.GetMappedStoreForFormAsync("ToolCribIssueForm");

            if (MapStoreForToolCrib.StoreId > 0)
            {
                TCIVMs.StoreId = MapStoreForToolCrib.StoreId;
                TCIVMs.StoreName = MapStoreForToolCrib.StoreName;
            }
            else
            {
                TCIVMs.StoreId = null;
                TCIVMs.StoreName = null;
            }
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to initialize new Tool Crib issue.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewTci failed");
        }
    }

    #endregion


    #region Item Handlers

    private async Task<IEnumerable<ItemVM>> SearchItems(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        if (TCIVMs?.CategoryCode == 0)
        {
            await _JS.ToastrWarning("Please select a category first.");
            return Enumerable.Empty<ItemVM>();
        }

        try
        {
            var results = await tcIssueService.SearchItemsByCategoryAsync(TCIVMs.CategoryCode.Value, value);

            return results?.Take(50) ?? Enumerable.Empty<ItemVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<ItemVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchItems failed for value: {value}");
            await _JS.ToastrError("Failed to search items. Please try again.");
            return Enumerable.Empty<ItemVM>();
        }
    }

    private async Task OnItemChanged(ToolCribIssueSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItem = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.MeasureUnit = item.MeasureUnit;
                subitem.HSNCode = item.HSNCode;


                if (subitem.ItemId.HasValue)
                {
                    var rates = await tcIssueService.GetBulkLastUnitPricesAsync(
                        new List<int> { subitem.ItemId.Value }
                    );

                    if (rates.TryGetValue(subitem.ItemId.Value, out decimal rate))
                    {
                        subitem.UnitPrice = rate;
                    }
                }

                // 🔹 Fetch stock quantity for the selected store
                if (subitem.ItemId > 0 && TCIVMs.StoreId.HasValue && TCIVMs.StoreId.Value > 0)
                {
                    var stockDict = await tcIssueService.GetStockForItemsAsync(
                        new List<int> { subitem.ItemId.Value },
                        TCIVMs.StoreId.Value
                    );

                    subitem.StockQty = stockDict.TryGetValue(subitem.ItemId.Value, out var qty) ? qty : 0m;
                }

                if (subitem.ItemId > 0)
                {
                    var count = await tcIssueService.GetCorrespondenceAttachmentsCountAsync(subitem.ItemId.Value, "Item");
                    attachmentCounts[subitem.ItemId.Value] = count;
                }
            }
            else
            {
                // Reset when deselected
                subitem.SelectedItem = null;
                subitem.ItemId = null;
                subitem.ItemCode = null;
                subitem.ItemName = null;
                subitem.MeasureUnit = null;
                subitem.UnitPrice = null;
                subitem.HSNCode = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnItemChanged failed for ItemId: {item?.ItemId}");
            await _JS.ToastrError("Failed to apply item selection. Please try again.");
        }
    }

    private bool IsItemAlreadySelected(int itemId, int? currentItemId)
    {
        return TCIVMs.ToolCribIssueSubVMs?.Any(q => q.ItemId == itemId && q.ItemId != currentItemId) == true;
    }

