    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.TCIssueSubId > 0)
            {
                await tcIssueService.DeleteAndResequenceAsync(rowToDelete, TCIVMs, screenCode);

                TCIVMs.ToolCribIssueSubVMs = await tcIssueService.GetToolCribIssueSubByTCIdAsync(TCIVMs.TCIssueId);
            }
            else
            {
                TCIVMs.ToolCribIssueSubVMs.Remove(rowToDelete);

                if (!TCIVMs.ToolCribIssueSubVMs.Any())
                {
                    TCIVMs.ToolCribIssueSubVMs.Add(new ToolCribIssueSubVM
                    {
                        TCIssueId = TCIVMs.TCIssueId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    for (int i = 0; i < TCIVMs.ToolCribIssueSubVMs.Count; i++)
                        TCIVMs.ToolCribIssueSubVMs[i].SlNo = i + 1;
                }
            }

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for TCIssueId: {TCIVMs.TCIssueId}");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

