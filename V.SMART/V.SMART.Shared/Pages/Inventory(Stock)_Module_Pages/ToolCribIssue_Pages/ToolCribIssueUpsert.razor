    private async Task UpdateSubItemQtyAsync(ToolCribIssueSubVM subItem, decimal newQty)
    {
        if (newQty <= 0)
        {
            subItem.QtyOut = 0;
            subItem.BalQty = 0;
            await _JS.ToastrWarning("Issue Qty must be a positive number.");
            return;
        }

        if (subItem.TCIssueSubId == 0)
        {
            if (newQty <= subItem.StockQty)
            {
                subItem.QtyOut = newQty;
                subItem.BalQty = newQty;
            }
            else
            {
                subItem.QtyOut = subItem.StockQty;
                subItem.BalQty = subItem.StockQty;
                await _JS.ToastrWarning("Issue Qty cannot be greater than available Stock Qty.");
            }
            return;
        }

        var original = await tcIssueService.GetTCSubItemDetailByTCIssueSubIdAsync(subItem.TCIssueSubId);
        if (original == null) return;

        decimal alreadyTransacted = original.QtyOut.GetValueOrDefault() - original.BalQty.GetValueOrDefault();
        decimal availableStock = subItem.StockQty.GetValueOrDefault();
        decimal maxAllowedQty = original.BalQty.GetValueOrDefault() + availableStock;

        if (newQty < alreadyTransacted)
        {
            subItem.QtyOut = alreadyTransacted;
            subItem.BalQty = 0;
            await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} as it is already returned.");
            return;
        }

        if (newQty > maxAllowedQty)
        {
            subItem.QtyOut = maxAllowedQty;
            subItem.BalQty = maxAllowedQty - alreadyTransacted;
            await _JS.ToastrWarning($"Qty cannot exceed available stock limit ({maxAllowedQty}).");
            return;
        }

        subItem.QtyOut = newQty;
        subItem.BalQty = newQty - alreadyTransacted;

        if (subItem.BalQty < 0)
            subItem.BalQty = 0;
    }

