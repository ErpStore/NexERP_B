@page "/stockIssReq/create"
@page "/stockIssReq/update/{RequestId:int}"


@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IInventoryService
@using V.SMART.Shared.ViewModels.InventoryViewModel.MaterialIssueNoteVM
@using V.SMART.Shared.ViewModels.InventoryViewModel.SCNGenViewModel
@using V.SMART.Shared.ViewModels.InventoryViewModel.StockIssueRequestVM
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject IExcelTemplateService _excelTemplateService
@inject ICalculationService _calculationService
@inject IStockIssueRequestService _minService
@inject ILoggingService _logs

@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle>
</BsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">

    if (ActiveModal == "Item")
    {
    <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
    <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                   refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{

    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@(StockIssueRequestVMs.RequestId > 0 ? "Update StockIssueRequest" : "Create StockIssueRequest")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@MINFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="StockIssueRequestVMs" OnValidSubmit="UpsertMIN">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">

                        @if (StockIssueRequestVMs.RequestId > 0 && !string.IsNullOrWhiteSpace(StockIssueRequestVMs.RequestNo))
                        {
                            <CorrespondenceStatus ReferenceType="Stock-Issue"
                                                  ReferenceId="@StockIssueRequestVMs.RequestId"
                                                  ReferenceTypeName="@StockIssueRequestVMs.RequestNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">

                        <!-- =================== SCN Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Material Issue Information</span>
                                </div>

                                <div class="card-body">

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Request No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                           placeholder="Request No."
                                                           maxlength="30"
                                                           @bind-Value="@StockIssueRequestVMs.RequestNo"
                                                           readonly />

                                                <span class="input-group-text rounded-3">@StockIssueRequestVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => StockIssueRequestVMs.RequestNo)" />
                                            <ValidationMessage For="@(() => StockIssueRequestVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- SCNGen Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Request Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@StockIssueRequestVMs.RequestDate" />
                                            <ValidationMessage For="@(() => StockIssueRequestVMs.RequestDate)" />
                                        </div>
                                    </div>


                                    <!-- Store -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issue To Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    id="storeIssId"
                                                    value="@StockIssueRequestVMs.StoreIssId"
                                                    @onchange="OnStoreChanged">
                                                <option value="0">--Select Store--</option>
                                                @foreach (var storeid in stores)
                                                {
                                                    <option value="@storeid.StoreId">@storeid.StoreName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => StockIssueRequestVMs.StoreIssId)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- =================== Assembly Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">
                                        <i class="bi bi-gear-wide-connected me-1"></i> Assembly Details
                                    </span>
                                </div>

                                <!-- Body -->
                                <div class="card-body">

                                    <!-- With BOM Toggle (Card Style) -->
                                    <div class="row mb-3">
                                        <div class="col-12">
                                            <div class="border rounded-3 p-2 ps-3 bg-light-subtle shadow-sm d-flex align-items-center justify-content-between">
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-diagram-3 fs-5 text-primary me-2"></i>
                                                    <label class="form-check-label fw-semibold mb-0 @(StockIssueRequestVMs.IsWithBom ? "text-primary" : "text-dark")"
                                                           for="WithBomSwitch">
                                                        With BOM
                                                    </label>
                                                </div>

                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           id="WithBomSwitch"
                                                           checked="@StockIssueRequestVMs.IsWithBom"
                                                           disabled="@(StockIssueRequestVMs.RequestId > 0 || StockIssueRequestVMs.AssyId > 0)"
                                                           @onchange="OnWithBomToggle" />
                                                </div>
                                            </div>
                                            <ValidationMessage For="@(() => StockIssueRequestVMs.IsWithBom)" />
                                        </div>
                                    </div>

                                    @* <div class="row mb-3">
                                        <div class="col-12 text-center">
                                            <button type="button"
                                                    class="btn btn-sm @(SCNGenVMs.IsWithBom ? "btn-outline-primary" : "btn-outline-secondary") rounded-pill px-4"
                                                    disabled="@SCNGenVMs.SCNGenSubVMs.Any(x => !string.IsNullOrEmpty(x.ItemCode))"
                                                    @onclick="() => SCNGenVMs.IsWithBom = !SCNGenVMs.IsWithBom">
                                                <i class="bi @(SCNGenVMs.IsWithBom ? "bi-check-circle" : "bi-x-circle") me-2"></i>
                                                @(SCNGenVMs.IsWithBom ? "With BOM Enabled" : "With BOM Disabled")
                                            </button>
                                            <ValidationMessage For="@(() => SCNGenVMs.IsWithBom)" />
                                        </div>
                                    </div> *@

                                    <!-- Conditional BOM Section -->
                                    @if (StockIssueRequestVMs.IsWithBom)
                                    {
                                        <!-- Assembly -->
                                        <div class="row mb-2">
                                            <label class="col-12 col-sm-3 col-form-label text-dark">
                                                <small>Assembly Name</small>
                                            </label>

                                            <div class="col-12 col-sm-9">
                                                @if (StockIssueRequestVMs.RequestId > 0)
                                                {
                                                    <!-- View Mode (Non-editable) -->
                                                    <input type="text" class="form-control form-control-sm"
                                                           value="@StockIssueRequestVMs.AssyItemCode"
                                                           readonly />
                                                }
                                                else
                                                {
                                                    <!-- Edit Mode -->
                                                    <select class="form-select form-select-sm"
                                                            value="@StockIssueRequestVMs.AssyId"
                                                            @onchange="OnAssemblyChange">
                                                        <option value="">-- Select --</option>
                                                        @foreach (var asm in AssemblyList)
                                                        {
                                                            <option value="@asm.ItemId">@asm.ItemCode</option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => StockIssueRequestVMs.AssyId)" />
                                                }
                                            </div>
                                        </div>

                                        @if (StockIssueRequestVMs != null && StockIssueRequestVMs.AssyId > 0)
                                        {
                                            <!-- Sub-Assembly -->
                                            <div class="row mb-2">
                                                <label class="col-12 col-sm-3 col-form-label text-dark">
                                                    <small>Sub-Assembly Name</small>
                                                </label>

                                                <div class="col-12 col-sm-9">
                                                    @if (StockIssueRequestVMs.RequestId > 0)
                                                    {
                                                        <!-- View Mode (Non-editable) -->
                                                        <input type="text" class="form-control form-control-sm"
                                                               value="@StockIssueRequestVMs.SubAssyItemCode"
                                                               readonly />
                                                    }
                                                    else
                                                    {
                                                        <!-- Edit Mode -->
                                                        <select class="form-select form-select-sm"
                                                                value="@StockIssueRequestVMs.SubAssyId"
                                                                @onchange="OnSubAssemblyChange">
                                                            <option value="">-- Select --</option>
                                                            @foreach (var subAsm in SubAssyList)
                                                            {
                                                                <option value="@subAsm.ItemId">@subAsm.ItemCode</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => StockIssueRequestVMs.SubAssyId)" />
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (StockIssueRequestVMs != null && StockIssueRequestVMs.SubAssyId > 0)
                                        {
                                            <!-- Sub-Assembly 2 -->
                                            <div class="row mb-2">
                                                <label class="col-12 col-sm-3 col-form-label text-dark">
                                                    <small>Sub-Assembly 2</small>
                                                </label>

                                                <div class="col-12 col-sm-9">
                                                    @if (StockIssueRequestVMs.RequestId > 0)
                                                    {
                                                        <!-- View Mode (Non-editable) -->
                                                        <input type="text" class="form-control form-control-sm"
                                                               value="@StockIssueRequestVMs.SubAssyItemCode2"
                                                               readonly />
                                                    }
                                                    else
                                                    {
                                                        <!-- Edit Mode -->
                                                        <select class="form-select form-select-sm"
                                                                value="@StockIssueRequestVMs.SubAssyId2"
                                                                @onchange="OnSubAssemblyChange2">
                                                            <option value="">-- Select --</option>
                                                            @foreach (var subAsm in SubAssyList2)
                                                            {
                                                                <option value="@subAsm.ItemId">@subAsm.ItemCode</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => StockIssueRequestVMs.SubAssyId2)" />
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @if (StockIssueRequestVMs != null && StockIssueRequestVMs.SubAssyId2 > 0)
                                        {
                                            <!-- Sub-Assembly 3 -->
                                            <div class="row mb-2">
                                                <label class="col-12 col-sm-3 col-form-label text-dark">
                                                    <small>Sub-Assembly 3</small>
                                                </label>

                                                <div class="col-12 col-sm-9">
                                                    @if (StockIssueRequestVMs.RequestId > 0)
                                                    {
                                                        <!-- View Mode (Non-editable) -->
                                                        <input type="text" class="form-control form-control-sm"
                                                               value="@StockIssueRequestVMs.SubAssyItemCode3"
                                                               readonly />
                                                    }
                                                    else
                                                    {
                                                        <!-- Edit Mode -->
                                                        <select class="form-select form-select-sm"
                                                                value="@StockIssueRequestVMs.SubAssyId3"
                                                                @onchange="OnSubAssemblyChange3">
                                                            <option value="">-- Select --</option>
                                                            @foreach (var subAsm in SubAssyList3)
                                                            {
                                                                <option value="@subAsm.ItemId">@subAsm.ItemCode</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => StockIssueRequestVMs.SubAssyId3)" />
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- Required Quantity -->
                                        <div class="row mb-2">
                                            <label class="col-12 col-sm-3 col-form-label text-dark">
                                                <small>Required Qty</small>
                                            </label>
                                            <div class="col-12 col-sm-9">

                                                <input type="number"
                                                       class="form-control form-control-sm"
                                                       placeholder="Qty"
                                                       title="Enter Quantity"
                                                       step="any"
                                                       @bind="StockIssueRequestVMs.ReqQty"
                                                       @bind:event="oninput"
                                                       @onchange="@(async e => await OnReqQtyChanged(e))" />
                                                <ValidationMessage For="@(() => StockIssueRequestVMs.ReqQty)" />
                                            </div>
                                        </div>

                                    }

                                    <div class="mb-3 row align-items-center">
                                        <label class="col-12 col-sm-3 col-form-label text-dark mb-1 mb-sm-0">
                                            <small>Issue to Whom</small>
                                        </label>

                                        <div class="col-12 col-sm-9">
                                            <input type="text"
                                                   list="personList"
                                                   class="form-control form-control-sm rounded-3"
                                                   placeholder="Select or enter Person"
                                                   @bind="StockIssueRequestVMs.ToWhom" />

                                            <datalist id="personList">
                                                @foreach (var user in UserList)
                                                {
                                                    <option value="@user"></option>
                                                }
                                            </datalist>

                                            <ValidationMessage For="@(() => StockIssueRequestVMs.ToWhom)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="row mb-2">
                                        <label class="col-12 col-sm-3 col-form-label text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      placeholder="Enter remarks here..."
                                                      @bind="StockIssueRequestVMs.MainRemark">
                                                    </textarea>
                                            <ValidationMessage For="@(() => StockIssueRequestVMs.MainRemark)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header bg-primary-subtle text-dark">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                                        <span class="fw-bold fs-6">Item Details</span>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1600px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th class="d-none">Utility Qty</th>
                                                    <th style="width:120px;">Qty</th>
                                                    <th style="width:120px;">Stock Qty</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:130px;">Gross Amount</th>
                                                    <th style="width:110px;">Batch No.</th>
                                                    <th style="width:110px;">Rack No.</th>
                                                    <th style="width:110px;">Make</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:150px;">Cost-Center</th>
                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>

                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in StockIssueRequestVMs.StockIssueRequestSubVMs)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @if (subitem.IsEditable
                                                                                                                                && (StockIssueRequestVMs.AssyId == null || StockIssueRequestVMs.AssyId == 0))
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                         Value="subitem.SelectedItemVMs"
                                                                                         ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                         ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                         SearchFunc="SearchItems"
                                                                                         Dense="true"
                                                                                         Variant="Variant.Outlined"
                                                                                         Placeholder="Search Item Code"
                                                                                         Title="Search Atleast 3 Letters in Item-Code"
                                                                                         Class="w-100 autocomplete-sm"
                                                                                         MaxItems="50" />
                                                                        <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.ItemCode
                                                                    }
                                                                </div>

                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                                                                                && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                       Size="Size.Small"
                                                                                       Color="Color.Primary"
                                                                                       OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                       Edge="Edge.End"
                                                                                       Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.UOM</td>
                                                        <td class="d-none">@subitem.UtlQty</td>

                                                        <!-- Qty -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Issue Qty"
                                                                       title="Enter Issue Qty"
                                                                       @bind="subitem.ReqQty"
                                                                       @bind:event="oninput"
                                                                       @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.ReqQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.ReqQty</span>
                                                            }
                                                        </td>
                                                        <td class="text-danger fw-bold">
                                                            @subitem.StockQty
                                                            <ValidationMessage For="@(() => subitem.StockQty)" />
                                                        </td>



                                                        <!-- Unit Price -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm" placeholder="Price" title="Enter Unit Price"
                                                                       @bind="subitem.UnitPrice" @bind:event="oninput" step="any"/>
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>

                                                        <!-- Line Gross -->
                                                        <td>@FormatDecimal(subitem.LineGross)</td>

                                                        <!-- Batch No -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.BatchNo"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="BatchNo." />
                                                                <ValidationMessage For="@(() => subitem.BatchNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.BatchNo
                                                            }
                                                        </td>

                                                        <!-- Rack No -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.RackNo"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="RackNo." />
                                                                <ValidationMessage For="@(() => subitem.RackNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.RackNo
                                                            }
                                                        </td>

                                                        <!-- Make -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.Make"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Make." />
                                                                <ValidationMessage For="@(() => subitem.Make)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.Make
                                                            }
                                                        </td>

                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputTextArea @bind-Value="subitem.Remark"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="Enter Remarks"
                                                                               rows="1" />
                                                                <ValidationMessage For="@(() => subitem.Remark)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.Remark
                                                            }
                                                        </td>

                                                        <!-- Cost Center -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <select class="form-select form-select-sm"
                                                                        value="@subitem.CostId"
                                                                        @onchange="(e => OnCostCenterChanged(e, subitem))">
                                                                    <option value="">Select CostCentre</option>
                                                                    @foreach (var cost in CostCenterVMs)
                                                                    {
                                                                        <option value="@cost.Id">@cost.ProjectNo</option>
                                                                    }
                                                                </select>
                                                                <ValidationMessage For="@(() => subitem.CostId)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.ProjectNo
                                                            }
                                                        </td>

                                                        <!-- Action Buttons -->

                                                        <td class="freeze-last-col text-end">
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                        @onclick="async () => await SaveRow(subitem)">
                                                                    <i class="bi bi-check-lg"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                        @onclick="async () => await CancelEdit(subitem, StockIssueRequestVMs)">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                        @onclick="async () => await EditRowAsync(subitem)">
                                                                    <i class="bi bi-pencil"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                        @onclick="async () => await RemoveRow(subitem)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            }
                                                        </td>

                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (StockIssueRequestVMs.StockIssueRequestSubVMs?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        <td colspan="4" class="text-end fw-bold">Totals:</td>
                                                        <td>@StockIssueRequestVMs.TotalQty</td>
                                                        <td></td>
                                                        <td>Avg: @FormatDecimal(StockIssueRequestVMs.AverageUnitPrice)</td>
                                                        <td>@FormatDecimal(StockIssueRequestVMs.TotalLineGross)</td>
                                                        <td colspan="@(StockIssueRequestVMs.AssyId == null || StockIssueRequestVMs.AssyId == 0 ? 6 : 5)">
                                                        </td>
                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>

                                    @if (StockIssueRequestVMs.AssyId == null || StockIssueRequestVMs.AssyId == 0)
                                    {
                                        <div class="mt-2 text-start">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Action Buttons -->
