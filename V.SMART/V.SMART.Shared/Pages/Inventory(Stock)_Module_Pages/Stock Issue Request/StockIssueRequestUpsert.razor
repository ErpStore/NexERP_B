    private async Task OnStoreChanged(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var newStoreId))
                return;

            StockIssueRequestVMs.StoreIssId = newStoreId;

            if (newStoreId == 0)
            {
                await _js.ToastrWarning("Please select a valid Store. Store is required.");

                if (StockIssueRequestVMs.StockIssueRequestSubVMs != null)
                {
                    foreach (var sub in StockIssueRequestVMs.StockIssueRequestSubVMs)
                        sub.StockQty = 0;
                }

                StateHasChanged();
                return;
            }

            if (StockIssueRequestVMs.StockIssueRequestSubVMs != null && StockIssueRequestVMs.StockIssueRequestSubVMs.Any())
            {
                var itemIds = StockIssueRequestVMs.StockIssueRequestSubVMs
                    .Where(s => s.ItemId.HasValue)
                    .Select(s => s.ItemId!.Value)
                    .Distinct()
                    .ToList();

                if (itemIds.Count == 0)
                {
                    await _js.ToastrInfo("No items found to update stock for this store.");
                    return;
                }

                var stockDict = await _minService.GetStockForItemsAsync(itemIds, newStoreId);

                foreach (var sub in StockIssueRequestVMs.StockIssueRequestSubVMs)
                {
                    if (sub.ItemId.HasValue && stockDict.TryGetValue(sub.ItemId.Value, out var qty))
                        sub.StockQty = qty;
