    #region SCN Gen Operations

    private async Task UpsertMIN()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            StockIssueRequestVMs.StockIssueRequestSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.ReqQty.HasValue || x.ReqQty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!StockIssueRequestVMs.StockIssueRequestSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a MIN without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in StockIssueRequestVMs.StockIssueRequestSubVMs)
            {
                bool isValid = await ValidateMINLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewMIN = StockIssueRequestVMs.RequestId == 0;

            try
            {
                await _minService.UpsertMINAsync(StockIssueRequestVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewMIN)
                await _js.ToastrSuccess("Stock Issue Request saved successfully.");
            else
                await _js.ToastrSuccess("Stock Issue Request updated successfully.");

            _navigationManager.NavigateTo("/stockIssReqList");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Upsert Stock Issue Request failed.");
            await _js.ToastrError("Error saving Stock Issue Request Note.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateMINLineAsync(StockIssueRequestSubVM line)
    {
        try
        {
            var errors = new List<string>();

            if (!line.ItemId.HasValue)
                errors.Add("Item selection is required.");

            if (!line.ReqQty.HasValue || line.ReqQty <= 0)
                errors.Add($"Item {line.ItemCode}: Issue Quantity must be greater than 0.");

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
                errors.Add($"Item {line.ItemCode}: Unit Price must be greater than 0.");

            decimal maxAllowedQty = line.StockQty;

            if (line.RequestSubId > 0)
            {
                var original = await _minService.GetMINSubItemDetailByMINSubIdAsync(line.RequestSubId);
                if (original != null)
                    maxAllowedQty = original.ReqQty.GetValueOrDefault() + line.StockQty;
            }

            // if (line.ReqQty > maxAllowedQty)
            //     errors.Add($"Item {line.ItemCode}: Issue Qty cannot exceed available stock ({maxAllowedQty}).");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrError(message);
                return false;
            }

            return true;        
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ValidateMINLineAsync failed.");
            await _js.ToastrError("Error validating Material Issue Note line.");
            return false;
        }
    }


