    private Task OnCostCenterChanged(ChangeEventArgs e, StockIssueRequestSubVM row)
    {
        if (e?.Value != null && int.TryParse(e.Value.ToString(), out int selectedId))
        {
            row.CostId = selectedId;

            var selectedCostCenter = CostCenterVMs.FirstOrDefault(c => c.Id == selectedId);
