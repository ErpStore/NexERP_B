    private async Task OnAssemblyOrSubAssemblyChange(ChangeEventArgs e, string changeType)
    {
        try
        {
            isProcessing = true;

            if (int.TryParse(e.Value?.ToString(), out int selectedId))
            {
                if (changeType == "Assembly")
                    StockIssueRequestVMs.AssyId = selectedId;
                else if (changeType == "SubAssembly")
                    StockIssueRequestVMs.SubAssyId = selectedId;
                else if (changeType == "SubAssembly2")
                    StockIssueRequestVMs.SubAssyId2 = selectedId;
                else if (changeType == "SubAssembly3")
                    StockIssueRequestVMs.SubAssyId3 = selectedId;

                var relatedItems = await _minService.GetAssemblyRelatedItemsAsync(
                    selectedId,
                    StockIssueRequestVMs.ReqQty,
                    StockIssueRequestVMs.StoreIssId.GetValueOrDefault()
                );

                if (relatedItems != null && relatedItems.Any())
                {
                    var subVMTasks = relatedItems.Select(async item => new StockIssueRequestSubVM
                    {
                        SelectedItemVMs = await _minService.GetItemByItemIdAsync(item.ItemId),
                        ItemId = item.ItemId,
                        ItemCode = item.ItemCode,
                        ItemName = item.ItemName,
                        UOM = item.UOM,
                        UtlQty = item.UtlQty,
                        ReqQty = item.ReqQty,
                        StockQty = item.StockQty,
                        UnitPrice = item.UnitPrice,
                        BatchNo = item.BatchNo,
                        RackNo = item.RackNo,
                        Make = item.Make,
                        Remark = item.Remark,
                        CostId = item.CostId,
                        ProjectNo = item.ProjectNo,
                        IsEditable = true
                    });

                    StockIssueRequestVMs.StockIssueRequestSubVMs = (await Task.WhenAll(subVMTasks)).ToList();
                    await ResetSlno();
                }
                else
                {
                    if (changeType == "Assembly")
                        StockIssueRequestVMs.AssyId = null;
                    else if (changeType == "SubAssembly")
                        StockIssueRequestVMs.SubAssyId = null;
                    else if (changeType == "SubAssembly2")
                        StockIssueRequestVMs.SubAssyId2 = null;
                    else if (changeType == "SubAssembly3")
                        StockIssueRequestVMs.SubAssyId3 = null;

                    StockIssueRequestVMs.StockIssueRequestSubVMs.Clear();
                    await _js.ToastrInfo($"No related items found for the selected {changeType}.");
                }

                if (changeType == "Assembly")
                {
                    StockIssueRequestVMs.SubAssyId = null;
                    SubAssyList.Clear();
                    SubAssyList = await _minService.GetAllSubAssembliesByAssyIdAsync(selectedId);
                }
                else if (changeType == "SubAssembly")
                {
                    StockIssueRequestVMs.SubAssyId2 = null;
                    SubAssyList2.Clear();
                    SubAssyList2 = await _minService.GetAllSubAssembliesByAssyIdAsync(selectedId);
                }
                else if (changeType == "SubAssembly2")
                {
                    StockIssueRequestVMs.SubAssyId3 = null;
                    SubAssyList3.Clear();
                    SubAssyList3 = await _minService.GetAllSubAssembliesByAssyIdAsync(selectedId);
                }
            }
            else
            {
                if (changeType == "Assembly")
                    StockIssueRequestVMs.AssyId = 0;
                else if (changeType == "SubAssembly")
                    StockIssueRequestVMs.SubAssyId = 0;

                StockIssueRequestVMs.StockIssueRequestSubVMs.Clear();
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError($"Failed to load {changeType} details.");
            await _logs.LogDeveloperError(ex, $"On{changeType}Change failed");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }


    #endregion


    #region Quantity Handlers

    private async Task UpdateSubItemQtyAsync(StockIssueRequestSubVM subItem, decimal newQty)
    {
        if (newQty <= 0)
        {
            subItem.ReqQty = 0;
            await _js.ToastrWarning("Request Qty must be a positive number.");
            return;
        }

        if (subItem.RequestSubId == 0)  
        {
            subItem.ReqQty = newQty;
            subItem.ReqBalQty = newQty;
            return;
        }

        if (subItem.RequestSubId > 0)
        {
            var original = await _minService.GetMINSubItemDetailByMINSubIdAsync(subItem.RequestSubId);
            if (original == null) return;

            var maxAllowedQty = original.ReqQty - original.ReqBalQty;

            if (newQty < maxAllowedQty)
            {
                subItem.ReqQty = maxAllowedQty;
                subItem.ReqBalQty = 0;
                await _js.ToastrWarning($"Qty cannot be less than {maxAllowedQty} (already transacted).");
                return;
            }
            else 
            {
                subItem.ReqQty = newQty;
                subItem.ReqBalQty = newQty - maxAllowedQty;

            }
        }
    }

    private async Task OnQtyChange(ChangeEventArgs e, StockIssueRequestSubVM subItem)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty)) return;
            await UpdateSubItemQtyAsync(subItem, newQty);
            RecalculateReqQty();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"OnQtyChange failed for MINSubId: {subItem?.RequestSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    private async Task OnReqQtyChanged(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var newReqQty)) return;

        StockIssueRequestVMs.ReqQty = newReqQty;

        if (StockIssueRequestVMs.StockIssueRequestSubVMs == null || !StockIssueRequestVMs.StockIssueRequestSubVMs.Any()) return;

        foreach (var subItem in StockIssueRequestVMs.StockIssueRequestSubVMs)
        {
            var intendedQty = subItem.UtlQty * newReqQty;
            await UpdateSubItemQtyAsync(subItem, intendedQty.GetValueOrDefault());
        }

        RecalculateReqQty(); // Optional: recalc average ReqQty
    }

    private void RecalculateReqQty()
    {
        if (StockIssueRequestVMs.StockIssueRequestSubVMs == null || !StockIssueRequestVMs.StockIssueRequestSubVMs.Any()) return;

        decimal totalReqQty = 0;
        int count = 0;

        foreach (var sub in StockIssueRequestVMs.StockIssueRequestSubVMs)
        {
            if (sub.UtlQty.GetValueOrDefault() > 0)
            {
                totalReqQty += sub.ReqQty.GetValueOrDefault() / sub.UtlQty.GetValueOrDefault();
                count++;
            }
        }

        if (count > 0)
            StockIssueRequestVMs.ReqQty = totalReqQty / count;
    }

    #endregion


    #region Row Operations

    private async Task<bool> ValidateRowAsync(StockIssueRequestSubVM row)
    {
        try
        {
            var errors = new List<string>();

            // Basic validations
            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (row.ReqQty <= 0)
                errors.Add("Issue Quantity must be greater than 0.");

            if (row.UnitPrice <= 0)
                errors.Add("Unit Price must be greater than 0.");

            // Stock validation
            decimal maxAllowedQty = row.StockQty;

            if (row.RequestSubId > 0)
            {
                // Existing line: allow increasing up to current stock + previously issued quantity
                var original = await _minService.GetMINSubItemDetailByMINSubIdAsync(row.RequestSubId);
                if (original != null)
                    maxAllowedQty = original.ReqQty.GetValueOrDefault() + row.StockQty;
            }

            if (row.ReqQty > maxAllowedQty)
            {
                errors.Add($"Issue Qty cannot be greater than available stock ({maxAllowedQty}).");
            }

            // Show errors if any
            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await _logs.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }


    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = StockIssueRequestVMs.StockIssueRequestSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await _logs.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (!await ValidateLastRowAsync()) return;

            StockIssueRequestVMs.StockIssueRequestSubVMs.Add(new StockIssueRequestSubVM
            {
                RequestId = StockIssueRequestVMs.RequestId,
                IsEditable = true
            });

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await _logs.LogDeveloperError(ex, "AddRow failed.");
        }
    }

    private async Task SaveRow(StockIssueRequestSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            if (!StockIssueRequestVMs.StockIssueRequestSubVMs.Any(x => x.IsEditable) && (StockIssueRequestVMs.AssyId == 0 || StockIssueRequestVMs.AssyId == null))
            {
                StockIssueRequestVMs.StockIssueRequestSubVMs.Add(new StockIssueRequestSubVM
                {
                    RequestId = StockIssueRequestVMs.RequestId,
                    IsEditable = true
                });
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"SaveRow failed for MinSubId: {item?.RequestSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(StockIssueRequestSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItemVMs == null && item.ItemId > 0)
            {
                item.SelectedItemVMs = await _minService.GetItemByItemIdAsync(item.ItemId);
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"EditRowAsync failed for RequestSubId: {item?.RequestSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(StockIssueRequestSubVM? item, StockIssueRequestVM? parentMin)
    {
        try
        {
            if (item == null || parentMin == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.ReqQty.HasValue || item.ReqQty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentMin.StockIssueRequestSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CancelEdit failed for MinSubId: {item?.RequestSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(StockIssueRequestSubVM item)
    {
        try
        {
            if (StockIssueRequestVMs.StockIssueRequestSubVMs.Count == 1 && item.RequestSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if (item.ItemId == 0)
            {
                StockIssueRequestVMs.StockIssueRequestSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!StockIssueRequestVMs.StockIssueRequestSubVMs.Any())
                    StockIssueRequestVMs.StockIssueRequestSubVMs = new List<StockIssueRequestSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"RemoveRow failed for RequestSubId: {item?.RequestSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            if (StockIssueRequestVMs?.StockIssueRequestSubVMs == null || !StockIssueRequestVMs.StockIssueRequestSubVMs.Any())
                return;

            int counter = 1;
            foreach (var sub in StockIssueRequestVMs.StockIssueRequestSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to reset row serial numbers.");
        }
    }

    #endregion


