    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _js.ToastrError("Failed to close modal. Please try again.");
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.RequestSubId > 0)
            {
                await _minService.DeleteAndResequenceAsync(rowToDelete, StockIssueRequestVMs, screenCode);

                StockIssueRequestVMs.StockIssueRequestSubVMs = await _minService.GetMINSubByMINIdAsync(StockIssueRequestVMs.RequestId, StockIssueRequestVMs.StoreIssId.Value);
            }
            else
            {
                StockIssueRequestVMs.StockIssueRequestSubVMs.Remove(rowToDelete);

                if (!StockIssueRequestVMs.StockIssueRequestSubVMs.Any())
                {
                    StockIssueRequestVMs.StockIssueRequestSubVMs.Add(new StockIssueRequestSubVM
                    {
                        RequestId = StockIssueRequestVMs.RequestId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < StockIssueRequestVMs.StockIssueRequestSubVMs.Count; i++)
                        StockIssueRequestVMs.StockIssueRequestSubVMs[i].SlNo = i + 1;
                }
            }

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error confirming deletion for RequestId: {StockIssueRequestVMs.RequestId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

    private async Task OpenAttachmentButton(int ItemId, int count)
    {
        try
        {
            if (ItemId == 0)
