    private async Task UploadExcelFile(InputFileChangeEventArgs e)
    {
        isProcessing = true;
        uploadMessage = string.Empty;

        try
        {
            var file = e.File;

            if (file.Size > 5 * 1024 * 1024)
            {
                uploadMessage = "File size exceeds 5 MB.";
                return;
            }

            using var memoryStream = new MemoryStream();
            await file.OpenReadStream().CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            using var workbook = new ClosedXML.Excel.XLWorkbook(memoryStream);
            var ws = workbook.Worksheet("MaterialIssueTemplate");

            // 1️⃣ Map headers to column indexes
            int lastCol = ws.LastColumnUsed().ColumnNumber();
            var headerMap = new Dictionary<string, int>();
            for (int col = 1; col <= lastCol; col++)
            {
                var headerName = ws.Cell(1, col).GetValue<string>()?.Trim();
                if (!string.IsNullOrEmpty(headerName))
                    headerMap[headerName] = col;
            }

            var rowsData = new List<(int SlNo, string ItemCode, decimal issueQty, decimal UnitPrice,
                string Remark, string BatchNo, string Make, string RackNo)>();

            int row = 2;
            while (!ws.Cell(row, headerMap["SlNo"]).IsEmpty())
            {
                int.TryParse(ws.Cell(row, headerMap["SlNo"]).GetValue<string>(), out var slNo);
                var itemCode = ws.Cell(row, headerMap["ItemCode"]).GetValue<string>()?.Trim();

                decimal.TryParse(ws.Cell(row, headerMap["IssueQty"]).GetValue<string>(), out var issueQty);
                decimal.TryParse(ws.Cell(row, headerMap["UnitPrice"]).GetValue<string>(), out var unitPrice);

                string remark = headerMap.ContainsKey("Remark") ? ws.Cell(row, headerMap["Remark"]).GetValue<string>()?.Trim() : string.Empty;
                string batchNo = headerMap.ContainsKey("BatchNo") ? ws.Cell(row, headerMap["BatchNo"]).GetValue<string>()?.Trim() : string.Empty;
                string make = headerMap.ContainsKey("Make") ? ws.Cell(row, headerMap["Make"]).GetValue<string>()?.Trim() : string.Empty;
                string rackNo = headerMap.ContainsKey("RackNo") ? ws.Cell(row, headerMap["RackNo"]).GetValue<string>()?.Trim() : string.Empty;

                rowsData.Add((slNo, itemCode, issueQty, unitPrice, remark, batchNo, make, rackNo));
                row++;
            }

            // 2️⃣ Validate ItemCodes & fetch ItemIds in bulk
            var itemCodes = rowsData.Select(r => r.ItemCode).Distinct().ToList();
            var itemIdDict = await _minService.GetItemIdsByItemCodesAsync(itemCodes);

            var validItemIds = itemIdDict.Values.ToList();
            var itemVMs = await _minService.GetItemVMsByItemIdsAsync(validItemIds);
            var itemVMDict = itemVMs.ToDictionary(i => i.ItemId, i => i);

            // 3️⃣ Get Stock quantities
            int defaultStoreId = 1;
            var stockDict = await _minService.GetStockForItemsAsync(validItemIds, defaultStoreId);

            // 4️⃣ Build final uploaded rows
            var uploadedRows = new List<StockIssueRequestSubVM>();
            foreach (var r in rowsData)
            {
                if (!itemIdDict.TryGetValue(r.ItemCode, out var itemId)) continue;
                if (!itemVMDict.TryGetValue(itemId, out var itemVM)) continue;

                uploadedRows.Add(new StockIssueRequestSubVM
                {
                    SlNo = r.SlNo,
                    ItemCode = r.ItemCode,
                    ItemId = itemVM.ItemId,
                    ItemName = itemVM.ItemName,
                    UOM = itemVM.MeasureUnit,
                    ReqQty = r.issueQty,
                    ReqBalQty=r.issueQty,
                    UnitPrice = r.UnitPrice,
                    SelectedItemVMs = itemVM,
                    StockQty = stockDict.ContainsKey(itemId) ? stockDict[itemId] : 0,
                    Remark = r.Remark,
                    BatchNo = r.BatchNo,
                    Make = r.Make,
                    RackNo = r.RackNo,
                    IsEditable = true
                });
            }

            StockIssueRequestVMs.StockIssueRequestSubVMs = uploadedRows;

            if (rowsData.Count != uploadedRows.Count)
                await _js.ToastrWarning($"{rowsData.Count - uploadedRows.Count} rows were skipped because the ItemCode does not exist in Item Master.");
            else
                await _js.ToastrSuccess($"Successfully uploaded {uploadedRows.Count} rows.");

            uploadMessage = $"Successfully uploaded {uploadedRows.Count} rows.";
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

