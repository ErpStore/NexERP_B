                                        }
                                        else
                                        {
                                            <i class="bi bi-download me-2"></i>
                                            <span>Download Template</span>
                                        }
                                    </button>
                                </div>

                                <!-- Upload Excel -->
                                <div class="col-12 col-md-3">
                                    <div class="input-group">
                                        <label class="input-group-text bg-success text-white rounded-start-3">
                                            <i class="bi bi-upload"></i>
                                        </label>
                                        <InputFile OnChange="UploadExcelFile" accept=".xlsx" class="form-control rounded-end-3" />
                                    </div>

                                    @if (!string.IsNullOrEmpty(uploadMessage))
                                    {
                                        <div class="mt-2 small text-success fw-semibold">
                                            <i class="bi bi-check-circle me-1"></i>@uploadMessage
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                    </div>

                </EditForm>
            </div>
        </div>
    </div>

}


