@page "/stockIssReq/details/{ReqID:int}"
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.InventoryViewModel.MaterialIssueNoteVM
@using V.SMART.Shared.ViewModels.InventoryViewModel.StockIssueRequestVM

@inherits BaseUserRightsComponent
@inject ReportService reportService

@inject NavigationManager _navigationManager
@inject ILoggingService loggingService
@inject IStockIssueRequestService _minService
@inject IJSRuntime _js

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <!-- Company Details Section -->
            <MyCompanyDetails />

            <hr class="border-2 border-primary-subtle mb-4" />
            <div class="text-center">
                <h4 class="fw-semibold mt-3">Stock Issue Request Details</h4>

            </div>
            <hr class="border-2 border-primary-subtle mb-4" />

            <!-- SCN Details & Document Details Section -->
            <div class="row g-3 mb-4">
                <!-- SCN Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Material Issue Note Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Request No.</strong></td>
                                        <td>@(!string.IsNullOrEmpty(StockIssueRequestVMs?.RequestNo) ? StockIssueRequestVMs.RequestNo : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Request Date</strong></td>
                                        <td>@(StockIssueRequestVMs?.RequestDate != null ? StockIssueRequestVMs.RequestDate.ToString("dd/MM/yyyy") : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Added to Store</strong></td>
                                        <td>@(!string.IsNullOrEmpty(StockIssueRequestVMs?.StoreIssName) ? StockIssueRequestVMs.StoreIssName : "N/A")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Assembly Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Assembly Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>With BOM</strong></td>
                                        <td>@(StockIssueRequestVMs.IsWithBom ? "Yes" : "No")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Assembly Name</strong></td>
                                        <td>@(!string.IsNullOrEmpty(StockIssueRequestVMs?.AssyItemCode) ? StockIssueRequestVMs.AssyItemCode : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Sub-Assembly</strong></td>
                                        <td>@(!string.IsNullOrEmpty(StockIssueRequestVMs?.SubAssyItemCode) ? StockIssueRequestVMs.SubAssyItemCode : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Sub-Assembly 2</strong></td>
                                        <td>@(!string.IsNullOrEmpty(StockIssueRequestVMs?.SubAssyItemCode2) ? StockIssueRequestVMs.SubAssyItemCode2 : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Sub-Assembly 3</strong></td>
                                        <td>@(!string.IsNullOrEmpty(StockIssueRequestVMs?.SubAssyItemCode3) ? StockIssueRequestVMs.SubAssyItemCode3 : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Required Qty</strong></td>
                                        <td>@(StockIssueRequestVMs?.ReqQty.ToString() ?? "0")</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SCN Items Section -->
            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    Store Transfer Note Items
                </div>
                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">

                        <thead class="custom-blue">
                            <tr>
                                <th class="text-center">Sl No.</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th class="text-center">UOM</th>
                                <th>Issue Qty</th>
                                <th>Stock Qty</th>
                                <th>Unit Price</th>
                                <th>Basic Amount</th>
                                <th>Batch No.</th>
                                <th>Rack No.</th>
                                <th>Make</th>
                                <th>Remarks</th>
                                <th>Cost-Center</th>
                            </tr>
                        </thead>

                        <tbody class="custom-size">
                            @if (StockIssueRequestVMs?.StockIssueRequestSubVMs != null && StockIssueRequestVMs.StockIssueRequestSubVMs.Any())
                            {
                                @foreach (var item in StockIssueRequestVMs.StockIssueRequestSubVMs)
                                {
                                    <tr>
                                        <td class="text-center">@item.SlNo</td>
                                        <td>@(item.ItemCode ?? "—")</td>
                                        <td>@(item.ItemName ?? "—")</td>
                                        <td class="text-center">@item.UOM</td>
                                        <td class="text-center">@item.ReqQty</td>
                                        <td class="text-end">@item.StockQty</td>
                                        <td class="text-end">@FormatDecimal(item.UnitPrice)</td>
                                        <td class="text-end">@FormatDecimal(item.LineGross)</td>
                                        <td class="text-center">@item.BatchNo</td>
                                        <td class="text-center">@item.RackNo</td>
                                        <td class="text-center">@item.Make</td>
                                        <td class="text-center">@item.Remark</td>
                                        <td class="text-center">@item.ProjectNo</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Due Date & Tax Totals Section -->
            <div class="row g-3 mb-4">
                <!-- Due Date & Terms and Conditions -->
                <div class="col-12">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-warning-subtle text-warning-emphasis fw-semibold p-2 small">
                            Remarks
                        </div>
                        <div class="card-body p-2 small">
                            <p class="mb-1"> @(!string.IsNullOrEmpty(StockIssueRequestVMs?.MainRemark) ? StockIssueRequestVMs.MainRemark : "N/A")</p>
                        </div>
                    </div>
                </div>


            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 justify-content-end">
                <a href="/stockIssReqList" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Back To List
                </a>
                <a href="@($"/stockIssReq/update/{ReqID}")" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Modify
                </a>

                <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>

        </div>
    }
}


@code {
    protected override string ScreenName => "Stock Issue-Request";

    [Parameter]
    public int ReqID { get; set; }

    [Parameter]
    public bool isOtherScreen { get; set; }

    private string? pdfBase64;

    private bool isProcessing { get; set; } = true;
    private StockIssueRequestVM StockIssueRequestVMs { get; set; } = new StockIssueRequestVM();

    private int Decimalplaces { get; set; } = 2;

    private string FormatDecimal(decimal? value)
    {
        try
        {
            if (value == null) return "0";
            return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
        }
        catch (Exception ex)
        {
            _js.ToastrWarning("Error Occured in FormatDecimal()");
            loggingService.LogDeveloperError(ex, "Error Occured in FormatDecimal()");
            return "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            isProcessing = true;
            await LoadStockIssuerequestDetails();
            isProcessing = false;
        }
        catch (Exception ex)
        {
            await loggingService.LogDeveloperError(ex, "Error Occure in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadStockIssuerequestDetails()
    {
        try
        {
            if (ReqID > 0)
            {
                var materialIssNote = await _minService.GetStockIssueRequestById(ReqID);
                if (materialIssNote != null)
                {
                    StockIssueRequestVMs = materialIssNote;
                }

                Decimalplaces = await _minService.GetDecimalPlacesAsync();
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrWarning("Error Occured in LoadMINDetails()");
            await loggingService.LogDeveloperError(ex, "Error Occured in LoadMINDetails()");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            pdfBase64 = null;
            var pdfBytes = await reportService.Generate_Report(ReqID, "MaterialIssueNoteReduction.frx", "ReqID", false, ScreenName, "Sp_Print_MaterialIssueNoteReduction");
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await loggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf JobOrder");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in JobOrder.");
        }
    }

}
