    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.ISTSubId > 0)
            {
                await _storeInterTransService.DeleteAndResequenceAsync(rowToDelete, StoreInterTransVMs, screenCode);

                StoreInterTransVMs.StoreInterTransSubVMs = await _storeInterTransService.GetISTSubByISTIdAsync(StoreInterTransVMs.ISTId, StoreInterTransVMs.StoreIdFrom.Value);
            }

            else
            {
                StoreInterTransVMs.StoreInterTransSubVMs.Remove(rowToDelete);

                if (!StoreInterTransVMs.StoreInterTransSubVMs.Any())
                {
                    StoreInterTransVMs.StoreInterTransSubVMs.Add(new StoreInterTransSubVM
                    {
                        ISTId = StoreInterTransVMs.ISTId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < StoreInterTransVMs.StoreInterTransSubVMs.Count; i++)
                        StoreInterTransVMs.StoreInterTransSubVMs[i].SlNo = i + 1;
                }
            }

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error confirming deletion for ISTId: {StoreInterTransVMs.ISTId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

