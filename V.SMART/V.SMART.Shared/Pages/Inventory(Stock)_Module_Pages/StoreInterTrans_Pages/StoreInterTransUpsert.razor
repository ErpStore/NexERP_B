    #region Inter Store Transfer Operations

    private async Task UpsertIST()
    {
        try
        {
            isProcessing = true;

            // Remove blank rows
            StoreInterTransVMs.StoreInterTransSubVMs.RemoveAll(x => !x.ItemId.HasValue);

            if (!StoreInterTransVMs.StoreInterTransSubVMs.Any())
            {
                await _js.ToastrError("Cannot save an IST without valid items.");
                return;
            }

            // -----------------------------
            //   CALCULATE BALANCE QTY
            // -----------------------------

            bool exist = false;

            foreach (var line in StoreInterTransVMs.StoreInterTransSubVMs)
            {
                // Qty is nullable -> must convert safely
                decimal qty = line.Qty ?? 0m;

                // If BalQty is 0 (new record), start with qty
                decimal startingBal = line.BalQty == 0 ? qty : line.BalQty;

                // AddQty is double -> safe convert
                decimal addQty = Convert.ToDecimal(line.AddQty);

                // Calculate new balance
                line.BalQty = startingBal - addQty;

                // Prevent negative
                if (line.BalQty < 0)
                    line.BalQty = 0;



                // Validation
                bool isValid = await ValidateISTLineAsync(line);
                if (!isValid) return;


                exist = await _storeInterTransService.IsRouteCardStockExistsAsync(line.ItemId.GetValueOrDefault());
                if (exist)
                {
                    await _js.ToastrError($"This item {line.ItemCode} is already linked to a Route Card. Manual issue is not allowed.");
                    return;
                }

            }


            // -----------------------------
            //   SAVE TO DATABASE
            // -----------------------------
            bool isNew = StoreInterTransVMs.ISTId == 0;

            try
            {
                await _storeInterTransService.UpsertISTAsync(StoreInterTransVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNew)
                await _js.ToastrSuccess("Internal Store Transfer saved successfully.");
            else
                await _js.ToastrSuccess("Internal Store Transfer updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/storeIntertransList");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "UpsertIST failed.");
            await _js.ToastrError("Error saving Inter Store Transfer.");
        }
        finally
        {
            isProcessing = false;
        }
    }


    

    private async Task<bool> ValidateISTLineAsync(StoreInterTransSubVM line)
    {
        try
        {
            var errors = new List<string>();

            if (!line.ItemId.HasValue)
                errors.Add("Item selection is required.");

            if (!line.Qty.HasValue || line.Qty <= 0)
                errors.Add($"Item {line.ItemCode}: Quantity must be greater than 0.");

            decimal maxAllowedQty = line.StockQty;

            if (line.ISTSubId > 0)
            {
                var original = await _storeInterTransService.GetISTSubItemDetailByISTSubIdAsync(line.ISTSubId);
                if (original != null)
                    maxAllowedQty = original.Qty.GetValueOrDefault() + line.StockQty;
            }

            if (line.Qty > maxAllowedQty)
                errors.Add($"Item {line.ItemCode}:Qty cannot exceed available stock ({maxAllowedQty}).");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrError(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ValidateISTLineAsync failed.");
            await _js.ToastrError("Error validating Inter Store Transfer line.");
            return false;
        }
    }
