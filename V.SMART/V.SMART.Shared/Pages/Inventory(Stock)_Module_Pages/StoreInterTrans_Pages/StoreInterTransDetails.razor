@page "/storeInterTrans/details/{ISTId:int}"
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.InventoryViewModel.StoreInterTransferViewModel

@inject ReportService _reportService
@inject ILoggingService _logs

@inject IStoreInterTransService _storeInterTransService
@inject IJSRuntime _js

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

        <!-- Company Details Section -->
        <div class="row align-items-center mb-4 g-4">
            <div class="col-12 col-lg-3 text-center">
                @if (!string.IsNullOrEmpty(company?.LogoUrl))
                {
                    <img src="@company.LogoUrl" alt="Company Logo" class="img-fluid rounded-3" style="max-height:120px;" />
                }
            </div>
            <div class="col-12 col-lg-9 text-lg-start text-center">
                <h2 class="text-primary fw-bold mb-1">@company?.CompanyName</h2>
                <p class="text-muted mb-1">@company?.RegisteredAddress</p>
                <p class="text-muted mb-0"><strong>GST No:</strong> @(company?.GSTIN ?? "N/A")</p>
            </div>
        </div>

        <hr class="border-2 border-primary-subtle mb-4" />

        <!-- IST Details & Document Details Section -->
        <div class="row g-3 mb-4">
            <!-- IST Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Inter Store Transfer Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>InterStore Transfer No.:</strong></td>
                                    <td>@(!string.IsNullOrEmpty(SITVMs?.ISTNo) ? SITVMs.ISTNo : "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>InterStore Transfer Date:</strong></td>
                                    <td>@(SITVMs?.ISTDate != null ? SITVMs.ISTDate.ToString("dd/MM/yyyy") : "N/A")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


            <!-- Document Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Document Details
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary" style="width: 40%"><strong>Issue From Store:</strong></td>
                                    <td>@(SITVMs?.StoreIssName ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width:40%"><strong>Add to Store:</strong></td>
                                    <td>@(SITVMs?.StoreAddName ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Remarks:</strong></td>
                                    <td>@(!string.IsNullOrEmpty(SITVMs?.MainRemark) ? SITVMs.MainRemark : "N/A")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- IST Items Section -->
        <div class="card border-1 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                Inter Store Transfer Items
            </div>
            <div class="table-responsive" style="overflow-x:auto;">
                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">

                    <thead class="custom-blue">
                        <tr>
                            <th class="text-center">Sl No.</th>
                            <th>Item Code</th>
                            <th>Description</th>
                            <th class="text-center">UOM</th>
                            <th>Issue Qty</th>
                            <th>Stock Qty</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>

                    <tbody class="custom-size">
                        @if (SITVMs?.StoreInterTransSubVMs != null && SITVMs.StoreInterTransSubVMs.Any())
                        {
                            @foreach (var item in SITVMs.StoreInterTransSubVMs)
                            {
                                <tr>
                                    <td class="text-center">@item.SlNo</td>
                                    <td>@(item.ItemCode ?? "—")</td>
                                    <td>@(item.ItemName ?? "—")</td>
                                    <td class="text-center">@item.UOM</td>
                                    <td class="text-center">@item.Qty</td>
                                    <td class="text-end">@item.StockQty</td>
                                    <td class="text-center">@item.Remark</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" class="text-center text-muted">No items found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2 justify-content-end">

            <a href="/storeIntertransList" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back To List
            </a>

            <a href="@($"/storeInterTrans/update/{ISTId}")" class="btn btn-outline-primary">
                <i class="bi bi-pencil-square"></i> Modify
            </a>

            <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                <i class="bi bi-printer"></i> Print
            </button>

        </div>

    </div>
}


@code {
    [Parameter]
    public int ISTId { get; set; }

    private bool isProcessing { get; set; } = true;
    private StoreInterTransVM SITVMs { get; set; } = new StoreInterTransVM();

    private string? pdfBase64 { get; set; } = string.Empty;

    private Companydetails company { get; set; } = new Companydetails();

    private int Decimalplaces { get; set; } = 2;

    private string FormatDecimal(decimal? value)
    {
        if (value == null) return "0";
        return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
    }


    protected override async Task OnInitializedAsync()
    {
        company = await _storeInterTransService.GetCompanyDetailsAsync();
        await LoadISTDetails();
        isProcessing = false;
    }

    private async Task LoadISTDetails()
    {
        if (ISTId > 0)
        {
            var materialIssNote = await _storeInterTransService.GetISTByISTIdAsync(ISTId);
            if (materialIssNote != null)
            {
                SITVMs = materialIssNote;
            }

            Decimalplaces = await _storeInterTransService.GetDecimalPlacesAsync();
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            var pdfBytes = await _reportService.Generate_Report(ISTId, "StoreInterTransfer.frx", "ISTId", false, "StoreInterTrans", "Sp_Print_InterStoreTransfer");
            
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf SalesEnquiry");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in SalesEnquiry.");
        }
    }

}
