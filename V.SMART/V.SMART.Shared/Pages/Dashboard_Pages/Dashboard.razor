                    <div class="col-lg-4">
                        <div class="glass-card h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="gc-title mb-0">Operations Split</h5>
                                <div class="chart-type-bar d-flex gap-1">
                                    <button class="chart-type-btn @(routeCardSplitType == "donut" ? "active" : "")" title="Donut" @onclick='() => routeCardSplitType = "donut"'><i class="bi bi-circle-half"></i></button>
                                    <button class="chart-type-btn @(routeCardSplitType == "pie" ? "active" : "")" title="Pie" @onclick='() => routeCardSplitType = "pie"'><i class="bi bi-pie-chart-fill"></i></button>
                                    <button class="chart-type-btn @(routeCardSplitType == "bar" ? "active" : "")" title="Bar" @onclick='() => routeCardSplitType = "bar"'><i class="bi bi-bar-chart-fill"></i></button>
                                </div>
                            </div>
                            @if (routeCardData.OperationSplit.Any())
                            {
                                @if (routeCardSplitType == "pie")
                                {
                                    <ApexChart TItem="BusinessDataDto" Height="260" Title="" Options="GetPieOptions()"><ApexPointSeries TItem="BusinessDataDto" Items="routeCardData.OperationSplit" Name="Count" SeriesType="SeriesType.Pie" XValue="@(e => e.Category)" YValue="@(e => e.Value)" /></ApexChart>
                                }
                                else if (routeCardSplitType == "bar")
                                {

                                    <ApexChart TItem="BusinessDataDto" Height="260" Title="" Options="GetSplitBarOptions()"><ApexPointSeries TItem="BusinessDataDto" Items="routeCardData.OperationSplit" Name="Count" SeriesType="SeriesType.Bar" XValue="@(e => e.Category)" YValue="@(e => e.Value)" /></ApexChart>
                                }
                                else
                                {

                                    <ApexChart TItem="BusinessDataDto" Height="260" Title="" Options="GetDonutOptions()"><ApexPointSeries TItem="BusinessDataDto" Items="routeCardData.OperationSplit" Name="Count" SeriesType="SeriesType.Donut" XValue="@(e => e.Category)" YValue="@(e => e.Value)" /></ApexChart>
                                }
                            }
                        </div>
                    </div>

                    <!-- Workstation Performance -->
                    @if (routeCardData.WorkstationStats.Any())
                    {
                        <div class="col-12">
                            <div class="glass-card">
                                <h5 class="gc-title mb-3"><i class="bi bi-cpu-fill me-2" style="color:#8b5cf6"></i>Workstation Performance</h5>
                                <div class="rc-workstation-grid">
                                    @foreach (var ws in routeCardData.WorkstationStats)
                                    {
                                        var wsPct = ws.AssignedCount > 0 ? (ws.CompletedCount * 100 / ws.AssignedCount) : 0;
                                        <div class="rc-ws-card">
                                            <div class="rc-ws-header">
                                                <div class="rc-ws-icon"><i class="bi bi-tools"></i></div>
                                                <div>
                                                    <div class="rc-ws-name">@ws.WorkstationName</div>
                                                    <div class="rc-ws-sub">@ws.OperationType</div>
                                                </div>
                                            </div>
                                            <div class="rc-ws-stat-row"><span>Assigned</span><strong>@ws.AssignedCount</strong></div>
                                            <div class="rc-ws-stat-row"><span>Completed</span><strong class="text-success">@ws.CompletedCount</strong></div>
                                            <div class="rc-ws-stat-row"><span>Pending</span><strong class="text-warning">@ws.PendingCount</strong></div>
                                            <div class="rc-ws-progress-wrap mt-2">
                                                <div class="rc-ws-progress-track">
                                                    <div class="rc-ws-progress-fill" style="width:@wsPct%"></div>
                                                </div>
                                                <span class="rc-ws-pct">@wsPct%</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Route Cards Table -->
                    <div class="col-12">
                        <div class="glass-card">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <h5 class="gc-title mb-0"><i class="bi bi-signpost-2-fill me-2" style="color:#0891b2"></i>Route Cards</h5>
                                <div class="d-flex gap-2 flex-wrap">
                                    <div class="input-group input-group-sm glass-search" style="max-width:220px">
                                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control" placeholder="Search route no / item…"
                                               @bind="routeCardSearchQuery" @bind:event="oninput" />
                                    </div>
                                    <button class="btn btn-sm btn-glass-outline"><i class="bi bi-download me-1"></i>CSV</button>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table align-middle glass-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Route Card No</th>
                                            <th>Job Card</th>
                                            <th>Item / Product</th>
                                            <th>Operation</th>
                                            <th>Workstation</th>
                                            <th>Operator</th>
                                            <th>Planned Qty</th>
                                            <th>Completed Qty</th>
                                            <th>Completion %</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var rc in FilteredRouteCards)
                                        {
                                            var pct = rc.PlannedQty > 0 ? (int)Math.Round((double)rc.CompletedQty / rc.PlannedQty * 100) : 0;
                                            <tr>
                                                <td><span class="doc-chip">@rc.RouteCardNo</span></td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(rc.JobCardNo))
                                                    {
                                                        <span class="doc-chip purch-chip">@rc.JobCardNo</span>
                                                    }
                                                    else
                                                    {

                                                        <span class="text-muted small">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="fw-semibold small">@rc.ItemName</div>
                                                    <div style="font-size:11px;color:var(--text-sub)">@rc.ItemCode</div>
                                                </td>
                                                <td><span class="type-badge">@rc.OperationName</span></td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="rc-ws-dot"></div>
                                                        <span class="small">@rc.WorkstationName</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="party-av sm-av">@(rc.OperatorName?.Length > 0 ? rc.OperatorName[0] : '?')</div>
                                                        <span class="small">@rc.OperatorName</span>
                                                    </div>
                                                </td>
                                                <td class="fw-semibold">@rc.PlannedQty</td>
                                                <td class="fw-semibold">@rc.CompletedQty</td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2" style="min-width:80px">
                                                        <div class="rc-inline-bar">
                                                            <div class="rc-inline-fill @(pct >= 100 ? "fill-done" : pct >= 50 ? "fill-mid" : "fill-low")"
                                                                 style="width:@(Math.Min(pct, 100))%"></div>
                                                        </div>
                                                        <small class="fw-semibold">@pct%</small>
                                                    </div>
                                                </td>
                                                <td><span class="@($"status-badge {rc.StatusClass}")">@rc.Status</span></td>
                                                <td><button class="glass-icon-btn-sm"><i class="bi bi-three-dots"></i></button></td>
                                            </tr>
                                        }
                                        @if (!FilteredRouteCards.Any())
                                        {
                                            <tr><td colspan="11" class="text-center text-muted py-4"><i class="bi bi-inbox me-2"></i>No route cards found.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <small class="text-muted">Showing @FilteredRouteCards.Count() of @routeCardData.RouteCards.Count</small>
                            </div>
                        </div>
                    </div>
                }
            }


            <!-- ════════════════════════════════════════════════════════
                 INVENTORY TAB
            ════════════════════════════════════════════════════════ -->
            @if (activeTopTab == "Inventory")
            {
                @if (isLoadingTab)
                {
                    <div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (inventoryData is not null)
                {
                    <div class="col-lg-8">
                        <div class="glass-card h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <h5 class="gc-title mb-0"><i class="bi bi-boxes me-2" style="color:#2563eb"></i>Inventory Levels</h5>
                                <div class="chart-type-bar d-flex gap-1">
                                    @foreach (var ct in chartTypes)
                                    {
                                        <button class="chart-type-btn @(inventoryChartType == ct.Key ? "active" : "")"
                                                title="@ct.Label" @onclick="() => inventoryChartType = ct.Key">
                                            <i class="bi @ct.Icon"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (inventoryChartType == "bar")
                            {
                                <ApexChart TItem="ChartPointDto" Height="290" Title="" Options="GetBarOptions()"><ApexPointSeries TItem="ChartPointDto" Items="inventoryData.LevelChart" Name="Stock" SeriesType="SeriesType.Bar" XValue="@(e => e.Label)" YValue="@(e => e.Value)" /></ApexChart>
                            }
                            else if (inventoryChartType == "area")
                            {

                                <ApexChart TItem="ChartPointDto" Height="290" Title="" Options="GetAreaOptions()"><ApexPointSeries TItem="ChartPointDto" Items="inventoryData.LevelChart" Name="Stock" SeriesType="SeriesType.Area" XValue="@(e => e.Label)" YValue="@(e => e.Value)" /></ApexChart>
                            }
                            else
                            {

                                <ApexChart TItem="ChartPointDto" Height="290" Title="" Options="GetLineOptions()"><ApexPointSeries TItem="ChartPointDto" Items="inventoryData.LevelChart" Name="Stock" XValue="@(e => e.Label)" YValue="@(e => e.Value)" /></ApexChart>
                            }
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="glass-card h-100">
                            <h5 class="gc-title mb-3"><i class="bi bi-exclamation-circle-fill text-warning me-2"></i>Low Stock Alerts</h5>
                            <ul class="list-group list-group-flush erp-list">
                                @foreach (var item in inventoryData.LowStock)
                                {
                                    <li class="list-group-item erp-list-item d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-box me-2 text-muted"></i>@item.Name</span>
                                        <span class="badge @(item.Qty <= 2 ? "bg-danger" : item.Qty <= 5 ? "bg-warning text-dark" : "bg-secondary") rounded-pill">@item.Qty Qty</span>
                                    </li>
                                }
                            </ul>
                            <div class="mt-3"><a href="#" class="btn btn-sm btn-glass-outline w-100">View All Inventory</a></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="glass-card">
                            <h5 class="gc-title mb-3">Inventory Transactions</h5>
                            <div class="table-responsive">
                                <table class="table align-middle glass-table mb-0">
                                    <thead><tr><th>Code</th><th>Item Name</th><th>Category</th><th>In</th><th>Out</th><th>Balance</th><th>Location</th></tr></thead>
                                    <tbody>
                                        @foreach (var inv in inventoryData.Items)
                                        {
                                            <tr>
                                                <td><span class="doc-chip">@inv.Code</span></td>
                                                <td>@inv.Name</td>
                                                <td><span class="type-badge">@inv.Category</span></td>
                                                <td class="text-success fw-semibold">+@inv.In</td>
                                                <td class="text-danger fw-semibold">-@inv.Out</td>
                                                <td class="fw-bold">@inv.Balance</td>
                                                <td class="text-muted small">@inv.Location</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }


            <!-- ════════════════════════════════════════════════════════
                 FINANCE TAB
            ════════════════════════════════════════════════════════ -->
            @if (activeTopTab == "Finance")
            {
                @if (isLoadingTab)
                {
                    <div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (financeData is not null)
                {
                    <div class="col-12">
                        <div class="glass-card">
                            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                <h5 class="gc-title mb-0"><i class="bi bi-cash-stack me-2 text-success"></i>Finance Overview</h5>
                                <span class="badge bg-success-subtle text-success px-3 py-2">Financial Summary</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-6 col-md-4">
                                    <div class="kpi-card" style="--kc:#16a34a">
                                        <div class="kpi-card-scan"></div>
                                        <div class="kpi-card-icon"><i class="bi bi-graph-up"></i></div>
                                        <div class="kpi-card-body"><span class="kpi-card-val">@financeData.NetProfit</span><span class="kpi-card-lbl">Net Profit</span></div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="kpi-card" style="--kc:#ef4444">
                                        <div class="kpi-card-scan"></div>
                                        <div class="kpi-card-icon"><i class="bi bi-graph-down"></i></div>
                                        <div class="kpi-card-body"><span class="kpi-card-val">@financeData.TotalExpense</span><span class="kpi-card-lbl">Total Expense</span></div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="kpi-card" style="--kc:#f59e0b">
                                        <div class="kpi-card-scan"></div>
                                        <div class="kpi-card-icon"><i class="bi bi-clock-history"></i></div>
                                        <div class="kpi-card-body"><span class="kpi-card-val">@financeData.ArPending</span><span class="kpi-card-lbl">AR Pending</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="glass-card h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <h5 class="gc-title mb-0"><i class="bi bi-cash-coin me-2" style="color:#10b981"></i>Cash Flow</h5>
                                <div class="chart-type-bar d-flex gap-1">
                                    @foreach (var ct in chartTypes)
                                    {
                                        <button class="chart-type-btn @(financeChartType == ct.Key ? "active" : "")"
                                                title="@ct.Label" @onclick="() => financeChartType = ct.Key">
                                            <i class="bi @ct.Icon"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (financeChartType == "bar")
                            {
                                <ApexChart TItem="ChartPointDto" Height="270" Title="" Options="GetBarOptions()">
                                    <ApexPointSeries TItem="ChartPointDto" Items="financeData.CashflowIn" Name="Inflow" SeriesType="SeriesType.Bar" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                    <ApexPointSeries TItem="ChartPointDto" Items="financeData.CashflowOut" Name="Outflow" SeriesType="SeriesType.Bar" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                </ApexChart>
                            }
                            else if (financeChartType == "area")
                            {
                                <ApexChart TItem="ChartPointDto" Height="270" Title="" Options="GetAreaOptions()">
                                    <ApexPointSeries TItem="ChartPointDto" Items="financeData.CashflowIn" Name="Inflow" SeriesType="SeriesType.Area" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                    <ApexPointSeries TItem="ChartPointDto" Items="financeData.CashflowOut" Name="Outflow" SeriesType="SeriesType.Area" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                </ApexChart>
                            }
                            else
                            {
                                <ApexChart TItem="ChartPointDto" Height="270" Title="" Options="GetLineOptions()">
                                    <ApexPointSeries TItem="ChartPointDto" Items="financeData.CashflowIn" Name="Inflow" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                    <ApexPointSeries TItem="ChartPointDto" Items="financeData.CashflowOut" Name="Outflow" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                </ApexChart>
                            }
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="glass-card h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <h5 class="gc-title mb-0"><i class="bi bi-pie-chart me-2" style="color:#7c3aed"></i>Expense Breakdown</h5>
                                <div class="chart-type-bar d-flex gap-1">
                                    <button class="chart-type-btn @(expenseChartType == "donut" ? "active" : "")" title="Donut" @onclick='() => expenseChartType = "donut"'><i class="bi bi-circle-half"></i></button>
                                    <button class="chart-type-btn @(expenseChartType == "pie" ? "active" : "")" title="Pie" @onclick='() => expenseChartType = "pie"'><i class="bi bi-pie-chart-fill"></i></button>
                                    <button class="chart-type-btn @(expenseChartType == "bar" ? "active" : "")" title="Bar" @onclick='() => expenseChartType = "bar"'><i class="bi bi-bar-chart-fill"></i></button>
                                </div>
                            </div>
                            @if (expenseChartType == "pie")
                            {
                                <ApexChart TItem="BusinessDataDto" Height="270" Title="" Options="GetPieOptions()"><ApexPointSeries TItem="BusinessDataDto" Items="financeData.ExpenseBreak" Name="Amount" SeriesType="SeriesType.Pie" XValue="@(e => e.Category)" YValue="@(e => e.Value)" /></ApexChart>
                            }
                            else if (expenseChartType == "bar")
                            {

                                <ApexChart TItem="BusinessDataDto" Height="270" Title="" Options="GetSplitBarOptions()"><ApexPointSeries TItem="BusinessDataDto" Items="financeData.ExpenseBreak" Name="Amount" SeriesType="SeriesType.Bar" XValue="@(e => e.Category)" YValue="@(e => e.Value)" /></ApexChart>
                            }
                            else
                            {

                                <ApexChart TItem="BusinessDataDto" Height="270" Title="" Options="GetDonutOptions()"><ApexPointSeries TItem="BusinessDataDto" Items="financeData.ExpenseBreak" Name="Amount" SeriesType="SeriesType.Donut" XValue="@(e => e.Category)" YValue="@(e => e.Value)" /></ApexChart>
                            }
                        </div>
                    </div>
                }
            }



            @if (activeTopTab == "Analytics")
            {
                @if (isLoadingTab)
                {
                    <div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (analyticsData is not null)
                {
                    <!-- ── Radial Gauges ─────────────────────────────── -->
                    <div class="col-12">
                        <div class="glass-card">
                            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                <div>
                                    <h5 class="gc-title mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>KPI Target Gauges</h5>
                                    <small class="gc-sub">Achievement vs target for the period</small>
                                </div>
                            </div>
                            <div class="row g-3">
                                @foreach (var g in analyticsData.Gauges)
                                {
                                    var r = 38; var cx = 48; var cy = 48; var sw = 7;
                                    var circ = 2 * Math.PI * r;
                                    var dash = (g.Value / 100.0) * circ;
                                    var offset = circ * 0.25;
                                    <div class="col-6 col-md-3">
                                        <div class="d-flex flex-column align-items-center gap-1 p-2">
                                            <svg width="96" height="96" viewBox="0 0 96 96">
                                                <circle cx="@cx" cy="@cy" r="@r" fill="none" stroke="@(g.Color + "22")" stroke-width="@sw" />
                                                <circle cx="@cx" cy="@cy" r="@r" fill="none" stroke="@g.Color" stroke-width="@sw"
                                                        stroke-linecap="round"
                                                        stroke-dasharray="@dash.ToString("F2") @circ.ToString("F2")"
                                                        stroke-dashoffset="@offset.ToString("F2")"
                                                        transform="rotate(-90 @cx @cy)" />
                                            </svg>
                                            <div style="margin-top:-28px;font-size:22px;font-weight:500">@g.Value%</div>
                                            <div style="font-size:11px;color:var(--text-sub)">@g.Label</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ── Sparklines ───────────────────────────────── -->
                    <div class="col-12">
                        <div class="glass-card">
                            <h5 class="gc-title mb-3"><i class="bi bi-activity me-2" style="color:#0891b2"></i>Module Sparklines</h5>
                            @foreach (var s in analyticsData.Sparklines)
                            {
                                var changeClass = s.ChangePercent >= 0 ? "text-success" : "text-danger";
                                var arrow = s.ChangePercent >= 0 ? "↑" : "↓";
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div style="min-width:120px">
                                        <div class="small fw-semibold">@s.Name</div>
                                        <div class="@($"{changeClass} small")">@arrow @Math.Abs(s.ChangePercent).ToString("F0")%</div>
                                    </div>
                                    <div class="flex-grow-1" style="height:32px">
                                        <ApexChart TItem="ChartPointDto" Height="32" Options="GetSparklineOptions(s.Color)">
                                            <ApexPointSeries TItem="ChartPointDto"
                                                             Items="@s.Values.Select((v,i) => new ChartPointDto { Label = i.ToString(), Value = v }).ToList()"
                                                             Name="@s.Name" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                        </ApexChart>
                                    </div>
                                    <div class="fw-semibold small" style="min-width:56px;text-align:right">@s.DisplayValue</div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ── Funnel + Customer Scatter ────────────────── -->
                    <div class="col-lg-5">
                        <div class="glass-card h-100">
                            <h5 class="gc-title mb-3"><i class="bi bi-filter me-2" style="color:#7c3aed"></i>Sales Funnel</h5>
                            @{
                                var maxCount = analyticsData.Funnel.FirstOrDefault()?.Count ?? 1;
                            }
                            @foreach (var stage in analyticsData.Funnel)
                            {
                                var widthPct = maxCount > 0 ? (stage.Count * 100 / maxCount) : 0;
                                var convPct = analyticsData.Funnel[0].Count > 0
                                ? (stage.Count * 100 / analyticsData.Funnel[0].Count) : 0;
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div style="min-width:96px;font-size:12px;color:var(--text-sub);text-align:right">@stage.Label</div>
                                    <div style="flex:1;height:32px;display:flex;align-items:center">
                                        <div style="width:@widthPct%;height:28px;background:@(stage.Color + "22");
                                                                                                                    border:0.5px solid @(stage.Color + "66");border-radius:4px;
                                                                                                                    display:flex;align-items:center;justify-content:center;
                                                                                                                    font-size:12px;font-weight:500;color:@stage.Color;min-width:36px">
                                            @stage.Count
                                        </div>
                                    </div>
                                    <div style="min-width:36px;font-size:11px;color:var(--text-sub)">
                                        @(stage == analyticsData.Funnel[0] ? "" : convPct + "%")
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="glass-card h-100">
                            <h5 class="gc-title mb-3">
                                <i class="bi bi-people me-2" style="color:#3b82f6"></i>Top Customers by Revenue
                            </h5>
                            @if (analyticsData.CustomerBubbles.Any())
                            {
                                <ApexChart TItem="CustomerBubbleDto" Height="260" Options="GetCustomerBarOptions()">
                                    <ApexPointSeries TItem="CustomerBubbleDto"
                                                     Items="@analyticsData.CustomerBubbles.Take(10).ToList()"
                                                     Name="Revenue (₹L)"
                                                     SeriesType="SeriesType.Bar"
                                                     XValue="@(e => e.Name)"
                                                     YValue="@(e => (decimal?)e.Revenue)" />
                                </ApexChart>
                            }
                        </div>
                    </div>

                    <!-- ── Waterfall + Heatmap ───────────────────────── -->
                    <div class="col-lg-6">
                        <div class="glass-card h-100">
                            <h5 class="gc-title mb-3"><i class="bi bi-bar-chart-steps me-2 text-success"></i>Cash Flow Waterfall</h5>
                            <ApexChart TItem="WaterfallPointDto" Height="260" Options="GetWaterfallOptions()">
                                <ApexPointSeries TItem="WaterfallPointDto" Items="analyticsData.Waterfall"
                                                 Name="Inflow" SeriesType="SeriesType.Bar" XValue="@(e => e.Label)" YValue="@(e => e.Inflow)" />
                                <ApexPointSeries TItem="WaterfallPointDto" Items="analyticsData.Waterfall"
                                                 Name="Outflow" SeriesType="SeriesType.Bar" XValue="@(e => e.Label)" YValue="@(e => e.Outflow)" />
                                <ApexPointSeries TItem="WaterfallPointDto" Items="analyticsData.Waterfall"
                                                 Name="Net" SeriesType="SeriesType.Bar" XValue="@(e => e.Label)" YValue="@(e => e.Net)" />
                            </ApexChart>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="glass-card h-100">
                            <h5 class="gc-title mb-3"><i class="bi bi-grid-3x3 me-2" style="color:#0891b2"></i>Activity Heatmap</h5>
                            <!-- Heatmap is best rendered via JS — use a canvas or third-party component -->
                            <!-- See CSS/JS implementation above for the standalone version -->
                            <div id="activity-heatmap-@(Guid.NewGuid().ToString("N").Substring(0, 8))">
                                @{
                                    var days2 = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
                                    var hourLabels = new[] { "8am", "10am", "12pm", "2pm", "4pm", "6pm" };
                                    var cells = analyticsData.HeatmapCells;
                                    var maxCell = cells.Any() ? cells.Max(c => c.Count) : 1;
                                }
                                <div style="display:grid;grid-template-columns:36px repeat(7,1fr);gap:3px">
                                    <div></div>
                                    @foreach (var d in days2)
                                    {
                                        <div style="font-size:10px;color:var(--text-sub);text-align:center">@d</div>
                                    }
                                    @for (int h = 0; h < hourLabels.Length; h++)
                                    {
                                        <div style="font-size:10px;color:var(--text-sub);display:flex;align-items:center;justify-content:flex-end;padding-right:4px">@hourLabels[h]</div>
                                        @for (int d = 0; d < 7; d++)
                                        {
                                            var cell = cells.FirstOrDefault(c => c.Hour == h && c.DayOfWeek == d);
                                            var intensity = cell is not null && maxCell > 0 ? (cell.Count * 100 / maxCell) : 0;
                                            var bg = intensity > 80 ? "#0369a1" : intensity > 60 ? "#0284c7"
                                            : intensity > 40 ? "#0ea5e9" : intensity > 20 ? "#38bdf8"
                                            : intensity > 5 ? "#bae6fd" : "var(--glass-bg)";
                                            <div style="height:26px;border-radius:3px;background:@bg" title="@hourLabels[h] @days2[d]: @(cell?.Count ?? 0)"></div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Radar + Budget Progress ───────────────────── -->
                    <div class="col-lg-6">
                        <div class="glass-card h-100">
                            <h5 class="gc-title mb-3"><i class="bi bi-broadcast me-2" style="color:#7c3aed"></i>Dept Performance Radar</h5>
                            <ApexChart TItem="ChartPointDto" Height="280" Options="GetRadarOptions()">
                                @foreach (var ds in analyticsData.RadarDatasets)
                                {
                                    <ApexPointSeries TItem="ChartPointDto"
                                                     Items="@ds.Values.Select((v,i) => new ChartPointDto { Label = analyticsData.RadarAxes[i], Value = v }).ToList()"
                                                     Name="@ds.Label" SeriesType="SeriesType.Radar"
                                                     XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                }
                            </ApexChart>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="glass-card h-100">
                            <h5 class="gc-title mb-3"><i class="bi bi-wallet2 me-2 text-warning"></i>Module Budget Utilisation</h5>
                            @foreach (var m in analyticsData.BudgetModules)
                            {
                                var pct = m.Allocated > 0 ? (int)Math.Round(m.Spent / m.Allocated * 100) : 0;
                                var overBudget = pct > 85;
                                var barColor = overBudget ? "#ef4444" : m.Color;
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="fw-semibold">@m.Name</span>
                                        <span class="@(overBudget ? "text-danger fw-semibold" : "text-muted")">
                                            ₹@m.Spent.ToString("F0")L / ₹@m.Allocated.ToString("F0")L &nbsp; @pct%
                                        </span>
                                    </div>
                                    <div style="height:6px;background:var(--glass-bg);border-radius:3px;overflow:hidden">
                                        <div style="width:@(Math.Min(pct, 100))%;height:100%;background:@barColor;border-radius:3px"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }


        </div>
    </div>
</div>

