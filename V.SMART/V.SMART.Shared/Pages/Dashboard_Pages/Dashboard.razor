    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isDark = ThemeStateService.IsDarkMode;
            ThemeStateService.OnChange += ThemeChanged;
            await LoadRightsAsync();
            if (!CanView) { Nav.NavigateTo("/access-denied"); return; }
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Dashboard OnInitializedAsync failed.");
        }
    }

    public void Dispose() => ThemeStateService.OnChange -= ThemeChanged;

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    // ── Loaders ──────────────────────────────────────────────────────────────
    private async Task LoadAllAsync() => await LoadTabAsync(BuildFilter());

    private async Task LoadSummaryAsync(DashboardFilterDto filter)
    {
        try
        {
            isLoadingSummary = true; StateHasChanged();
            summaryResult = await DashboardService.GetSummaryAsync(filter);
        }
        catch (Exception ex) { await LoggingService.LogDeveloperError(ex, "LoadSummaryAsync failed."); }
        finally { isLoadingSummary = false; StateHasChanged(); }
    }

    private async Task LoadTabAsync(DashboardFilterDto filter)
    {
        try
        {
            isLoadingTab = true; StateHasChanged();
            switch (activeTopTab)
            {
                case "Overview":
                    await LoadSummaryAsync(filter);
                    overviewData = await DashboardService.GetOverviewAsync(filter); break;

                case "Sales":
                    salesData = await DashboardService.GetSalesAsync(filter);
                    if (salesData != null)
                    {
                        BuildSalesKpis();
                    }
                    break;

                case "Labour/Job Work":
                    labourData = await DashboardService.GetLabourAsync(filter);
                    if (labourData != null)
                    {
                        BuildLabourKpis();
                    }
                    break;

                case "Purchase":
                    purchaseData = await DashboardService.GetPurchaseAsync(filter);
                    if (purchaseData != null)
                    {
                        BuildPurchaseKpis();
                    }
                    break;

                case "Subcontract":
                    subcontractData = await DashboardService.GetSubcontractAsync(filter);
                    if (subcontractData != null)
                    {
                        BuildSubcontractKpis();
                    }
                    break;

                case "Job Card":
                    jobCardData = await DashboardService.GetJobCardAsync(filter);
                    if (jobCardData != null)
                    {
                        BuildJobCardKpis();
                    }
                    break;

                case "Route Card":
                    Nav.NavigateTo("/under-construction");
                    return;
                    // routeCardData = await DashboardService.GetRouteCardAsync(filter); break;

                case "Inventory":
                    Nav.NavigateTo("/under-construction");
                    return;
                    //inventoryData = await DashboardService.GetInventoryAsync(filter); break;

                case "Finance":
                    Nav.NavigateTo("/under-construction");
                    return;
                    //financeData = await DashboardService.GetFinanceAsync(filter); break;


                case "Analytics":
                    analyticsData = await DashboardService.GetAnalyticsAsync(filter); break;

                default:
                    await LoadSummaryAsync(filter);
                    overviewData = await DashboardService.GetOverviewAsync(filter); break;
            }
        }
        catch (Exception ex) { await LoggingService.LogDeveloperError(ex, $"LoadTabAsync ({activeTopTab}) failed."); }
        finally { isLoadingTab = false; StateHasChanged(); }
    }

    // ── Tab / Period / GroupBy switches ──────────────────────────────────────
    private async Task SetActiveTab(string tab) { activeTopTab = tab; await LoadTabAsync(BuildFilter()); }
    private async Task SetGroupBy(string groupBy) { activeGroupBy = groupBy; await LoadTabAsync(BuildFilter()); }
    private void SetTrendChartType(string type) => trendChartType = type;

    private async Task SetPeriod(string p)
    {
        activePeriod = p;
        activeGroupBy = p switch { "Today" => "Hour", "This Week" => "Day", "This Month" => "Week", "Quarter" => "Month", "Year" => "Month", _ => "Day" };
        (fromDate, toDate) = p switch
        {
            "Today" => (DateTime.Today, DateTime.Today),
            "This Week" => (DateTime.Today.AddDays(-7), DateTime.Today),
            "This Month" => (new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1), DateTime.Today),
            "Quarter" => (DateTime.Today.AddMonths(-3), DateTime.Today),
            "Year" => (new DateTime(DateTime.Today.Year, 1, 1), DateTime.Today),
            _ => (fromDate, toDate)
        };
        if (p != "Custom") await LoadAllAsync();
    }

    private async Task ApplyCustomRange() { activePeriod = "Custom"; activeGroupBy = "Day"; await LoadAllAsync(); }



    // ── Filter builder ───────────────────────────────────────────────────────
    private DashboardFilterDto BuildFilter() => new()
    {
        Period = activePeriod,
        FromDate = fromDate ?? DateTime.Today.AddDays(-7),
        ToDate = toDate ?? DateTime.Today,
        GroupBy = activeGroupBy,
    };

    private string GetGroupByLabel() => activeGroupBy switch
    {
        "Hour" => "Hourly",
        "Day" => "Daily",
        "Week" => "Weekly",
        "Month" => "Monthly",
        _ => activeGroupBy
    };

    // ── Filtered collections ─────────────────────────────────────────────────
    private IEnumerable<TransactionDto> FilteredTransactions =>
        overviewData?.Transactions is null ? Enumerable.Empty<TransactionDto>()
        : string.IsNullOrWhiteSpace(searchQuery) ? overviewData.Transactions
        : overviewData.Transactions.Where(t =>
            (t.DocNo ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (t.Party ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (t.Type ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase));



    private IEnumerable<RouteCardRowDto> FilteredRouteCards =>
        routeCardData?.RouteCards is null ? Enumerable.Empty<RouteCardRowDto>()
        : string.IsNullOrWhiteSpace(routeCardSearchQuery) ? routeCardData.RouteCards
        : routeCardData.RouteCards.Where(r =>
            (r.RouteCardNo ?? "").Contains(routeCardSearchQuery, StringComparison.OrdinalIgnoreCase) ||
            (r.ItemName ?? "").Contains(routeCardSearchQuery, StringComparison.OrdinalIgnoreCase) ||
            (r.OperationName ?? "").Contains(routeCardSearchQuery, StringComparison.OrdinalIgnoreCase) ||
            (r.WorkstationName ?? "").Contains(routeCardSearchQuery, StringComparison.OrdinalIgnoreCase));



