@page "/dashboard"
@using ApexCharts
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IDashboardService
@using V.SMART.Shared.ViewModels.DashboadrViewModel
@inherits BaseUserRightsComponent
@inject ThemeStateService ThemeStateService
@inject IDashboardService DashboardService
@inject NavigationManager Nav
@inject ILoggingService LoggingService

<PageTitle>Dashboard — NexGenERP</PageTitle>

<div class="db-page @(isDark ? "db-dark" : "")">

    <!-- ── PAGE HEADER ───────────────────────────────────────────────── -->
    <div class="db-page-header">
        <h1 class="db-page-title">Business Overview</h1>
        <div class="db-header-actions">
            <div class="db-period-wrap">
                <label class="db-period-lbl">Filter By:</label>
                <select class="db-period-sel"
                        value="@activePeriod"
                        @onchange="e => SetPeriod(e.Value?.ToString() ?? activePeriod)">
                    @foreach (var p in periods)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            @if (activePeriod == "Custom")
            {
                <input type="date" class="db-date-input" @bind="fromDate" />
                <span class="db-date-sep">—</span>
                <input type="date" class="db-date-input" @bind="toDate" />
                <button class="db-apply-btn" @onclick="ApplyCustomRange">Apply</button>
            }
            <button class="db-icon-btn" title="Toggle theme" @onclick="ToggleTheme">
                <i class="bi @(isDark ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
            </button>
            <button class="db-icon-btn" title="Home" @onclick='() => Nav.NavigateTo("/")'>
                <i class="bi bi-house-door"></i>
            </button>
        </div>
    </div>

    <!-- ── TAB NAVIGATION ────────────────────────────────────────────── -->
    <nav class="db-tabs-nav">
        @foreach (var tab in topTabs)
        {
            <button class="db-tab @(activeTopTab == tab ? "db-tab--active" : "")"
                    @onclick="() => SetActiveTab(tab)">
                @tab
            </button>
        }
    </nav>

    <!-- ═══════════════════════════════════════════════════════════════
         OVERVIEW
    ═══════════════════════════════════════════════════════════════ -->
    @if (activeTopTab == "Overview")
    {
        <!-- KPI metric tiles -->
        @if (isLoadingSummary)
        {
            <div class="db-kpi-strip">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="db-kpi-tile">
                        <div class="db-skel db-skel--icon"></div>
                        <div>
                            <div class="db-skel db-skel--line"></div>
                            <div class="db-skel db-skel--val"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="db-kpi-strip">
                @foreach (var card in summaryCards)
                {
                    <div class="db-kpi-tile">
                        <div class="db-kpi-icon" style="background:@(card.Accent + "18");color:@card.Accent;">
                            <i class="bi @card.Icon"></i>
                        </div>
                        <div class="db-kpi-body">
                            <div class="db-kpi-label">@card.Title</div>
                            @foreach (var row in card.Rows.Take(1))
                            {
                                <div class="db-kpi-value">@GetSummaryValue(card.Title, row.Key, row.FallbackValue)</div>
                            }
                            @foreach (var row in card.Rows.Skip(1).Take(1))
                            {
                                <div class="db-kpi-sub">@row.Label: @GetSummaryValue(card.Title, row.Key, row.FallbackValue)</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (isLoadingTab)
        {
            <div class="db-loading"><div class="db-spinner"></div></div>
        }
        else if (overviewData is not null)
        {
            <!-- Business Trend + Split -->
            <div class="db-row">
                <div class="db-col db-col--8">
                    <div class="db-card">
                        <div class="db-card-header">
                            <div>
                                <span class="db-card-title">Business Trend</span>
                                <span class="db-card-sub">@activePeriod &bull; @GetGroupByLabel()</span>
                            </div>
                            <div class="db-card-actions">
                                @foreach (var gb in availableGroupBys)
                                {
                                    <button class="db-pill @(activeGroupBy == gb.Key ? "db-pill--on" : "")"
                                            @onclick="() => SetGroupBy(gb.Key)">@gb.Label</button>
                                }
                                @foreach (var ct in chartTypes)
                                {
                                    <button class="db-icon-sm @(trendChartType == ct.Key ? "db-icon-sm--on" : "")"
                                            title="@ct.Label" @onclick="() => SetTrendChartType(ct.Key)">
                                        <i class="bi @ct.Icon"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="db-card-body">
                            @if (overviewData.SalesTrend.Any())
                            {
                                @if (trendChartType == "bar")
                                {
                                    <ApexChart TItem="ChartPointDto" Height="280" Title="" Options="GetBarOptions()">
                                        @foreach (var series in overviewData.SalesTrend)
                                        {
                                            <ApexPointSeries TItem="ChartPointDto" Items="series.Data" Name="@series.Name"
                                                             SeriesType="SeriesType.Bar" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                        }
                                    </ApexChart>
                                }
                                else if (trendChartType == "area")
                                {
                                    <ApexChart TItem="ChartPointDto" Height="280" Title="" Options="GetAreaOptions()">
                                        @foreach (var series in overviewData.SalesTrend)
                                        {
                                            <ApexPointSeries TItem="ChartPointDto" Items="series.Data" Name="@series.Name"
                                                             SeriesType="SeriesType.Area" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                        }
                                    </ApexChart>
                                }
                                else
                                {
                                    <ApexChart TItem="ChartPointDto" Height="280" Title="" Options="GetLineOptions()">
                                        @foreach (var series in overviewData.SalesTrend)
                                        {
                                            <ApexPointSeries TItem="ChartPointDto" Items="series.Data" Name="@series.Name"
                                                             XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                        }
                                    </ApexChart>
                                }
                            }
                            else
                            {
                                <div class="db-empty"><i class="bi bi-graph-up"></i><span>No trend data for this period.</span></div>
                            }
                        </div>
                    </div>
                </div>

                <div class="db-col db-col--4">
                    <div class="db-card db-card--h100">
                        <div class="db-card-header">
                            <span class="db-card-title">Business Split</span>
                            <div class="db-card-actions">
                                @foreach (var (key, icon) in new[] { ("donut", "bi-circle-half"), ("pie", "bi-pie-chart-fill"), ("bar", "bi-bar-chart-fill") })
                                {
                                    <button class="db-icon-sm @(splitChartType == key ? "db-icon-sm--on" : "")"
                                            title="@key" @onclick='() => splitChartType = key'>
                                        <i class="bi @icon"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="db-card-body">
                            @if (overviewData.BusinessSplit.Any())
                            {
                                @if (splitChartType == "pie")
                                {
                                    <ApexChart TItem="BusinessDataDto" Height="260" Title="" Options="GetPieOptions()">
                                        <ApexPointSeries TItem="BusinessDataDto" Items="overviewData.BusinessSplit" Name="Amount"
                                                         SeriesType="SeriesType.Pie" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                                    </ApexChart>
                                }
                                else if (splitChartType == "bar")
                                {
                                    <ApexChart TItem="BusinessDataDto" Height="260" Title="" Options="GetSplitBarOptions()">
                                        <ApexPointSeries TItem="BusinessDataDto" Items="overviewData.BusinessSplit" Name="Amount"
                                                         SeriesType="SeriesType.Bar" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                                    </ApexChart>
                                }
                                else
                                {
                                    <ApexChart TItem="BusinessDataDto" Height="260" Title="" Options="GetDonutOptions()">
                                        <ApexPointSeries TItem="BusinessDataDto" Items="overviewData.BusinessSplit" Name="Amount"
                                                         SeriesType="SeriesType.Donut" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                                    </ApexChart>
                                }
                            }
                            else
                            {
                                <div class="db-empty"><i class="bi bi-pie-chart"></i><span>No data</span></div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Transactions -->
            <div class="db-card">
                <div class="db-card-header">
                    <span class="db-card-title">Recent Transactions</span>
                    <div class="db-search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Search doc / party…"
                               @bind="searchQuery" @bind:event="oninput" />
                    </div>
                </div>
                <div class="db-table-wrap">
                    <table class="db-table">
                        <thead>
                            <tr>
                                <th>Doc No</th>
                                <th>Party</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in FilteredTransactions)
                            {
                                <tr>
                                    <td><span class="db-doc-link">@tx.DocNo</span></td>
                                    <td>
                                        <div class="db-party-cell">
                                            <span class="db-avatar">@(tx.Party?.Length > 0 ? tx.Party[0] : '?')</span>
                                            <span>@tx.Party</span>
                                        </div>
                                    </td>
                                    <td><span class="db-badge db-badge--blue">@tx.Type</span></td>
                                    <td class="db-muted">@tx.Date</td>
                                    <td class="text-end db-fw">@tx.Amount</td>
                                    <td>
                                        <span class="db-badge @(tx.StatusClass == "badge-success" ? "db-badge--green" : tx.StatusClass == "badge-warning" ? "db-badge--amber" : tx.StatusClass == "badge-danger" ? "db-badge--red" : "db-badge--gray")">
                                            @tx.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                            @if (!FilteredTransactions.Any())
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="db-empty">
                                            <i class="bi bi-inbox"></i>
                                            <span>No transactions found</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="db-table-footer">
                    Showing @FilteredTransactions.Count() of @(overviewData.Transactions?.Count ?? 0)
                </div>
            </div>
        }
    }

    <!-- ═══════════════════════════════════════════════════════════════
         SALES
    ═══════════════════════════════════════════════════════════════ -->
    @if (activeTopTab == "Sales")
    {
        @if (isLoadingTab)
        {
            <div class="db-loading"><div class="db-spinner"></div></div>
        }
        else if (salesData is not null)
        {
            @foreach (var section in salesSections) { <KpiSection Section="section" /> }

            <div class="db-row">
                <div class="db-col db-col--8">
                    <div class="db-card">
                        <div class="db-card-header">
                            <span class="db-card-title">
                                <i class="bi bi-bar-chart-line me-2" style="color:#0891b2;"></i>Sales Trend
                            </span>
                        </div>
                        <div class="db-card-body">
                            <TrendChartComponent Title="" Icon="" IconColor="#0891b2"
                                                 Series1="@salesData.ActualSales" Series2="@salesData.TargetSales"
                                                 Series1Name="Invoice Value" Series2Name="PO Value"
                                                 SelectedType="@globalTrendChartType" SelectedTypeChanged="@(v => globalTrendChartType = v)"
                                                 LineOptions="@GetLineOptions()" AreaOptions="@GetAreaOptions()" BarOptions="@GetBarOptions()" />
                        </div>
                    </div>
                </div>
                <div class="db-col db-col--4">
                    <div class="db-card db-card--h100">
                        <div class="db-card-header"><span class="db-card-title">Payment Split</span></div>
                        <div class="db-card-body">
                            <SplitChartComponent Title="" Data="@salesData.PaymentSplit"
                                                 SelectedType="@globalSplitChartType" SelectedTypeChanged="@(v => globalSplitChartType = v)"
                                                 PieOptions="@GetPieOptions()" DonutOptions="@GetDonutOptions()" BarOptions="@GetSplitBarOptions()" />
                        </div>
                    </div>
                </div>
                <div class="db-col db-col--4">
                    <div class="db-card db-card--h100">
                        <div class="db-card-header"><span class="db-card-title">Top Customers</span></div>
                        <div class="db-table-wrap">
                            <table class="db-table">
                                <thead><tr><th>Customer</th><th>Orders</th><th class="text-end">Revenue</th></tr></thead>
                                <tbody>
                                    @foreach (var c in salesData.TopCustomers)
                                    {
                                        <tr>
                                            <td>
                                                <div class="db-party-cell">
                                                    <span class="db-avatar">@c.Name[0]</span>
                                                    <span>@c.Name</span>
                                                </div>
                                            </td>
                                            <td class="db-muted">@c.Orders</td>
                                            <td class="text-end db-fw">@c.Revenue</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ═══════════════════════════════════════════════════════════════
         PURCHASE
    ═══════════════════════════════════════════════════════════════ -->
    @if (activeTopTab == "Purchase")
    {
        @if (isLoadingTab)
        {
            <div class="db-loading"><div class="db-spinner"></div></div>
        }
        else if (purchaseData is not null)
        {
            @foreach (var section in purchaseSections) { <KpiSection Section="section" /> }

            <div class="db-row">
                <div class="db-col db-col--8">
                    <div class="db-card">
                        <div class="db-card-header">
                            <span class="db-card-title">
                                <i class="bi bi-bar-chart-steps me-2" style="color:#0ea5e9;"></i>Purchase &amp; Expense Trend
                            </span>
                        </div>
                        <div class="db-card-body">
                            <TrendChartComponent Title="" Icon="" IconColor="#0ea5e9"
                                                 Series1="@purchaseData.PurchaseTrend" Series2="@purchaseData.ExpenseTrend"
                                                 Series1Name="Purchase Orders" Series2Name="Expenses"
                                                 SelectedType="@globalTrendChartType" SelectedTypeChanged="@(v => globalTrendChartType = v)"
                                                 LineOptions="@GetLineOptions()" AreaOptions="@GetAreaOptions()" BarOptions="@GetBarOptions()" />
                        </div>
                    </div>
                </div>
                <div class="db-col db-col--4">
                    <div class="db-card db-card--h100">
                        <div class="db-card-header"><span class="db-card-title">Vendor Distribution</span></div>
                        <div class="db-card-body">
                            <SplitChartComponent Title="" Data="@purchaseData.VendorSplit"
                                                 SelectedType="@globalSplitChartType" SelectedTypeChanged="@(v => globalSplitChartType = v)"
                                                 PieOptions="@GetPieOptions()" DonutOptions="@GetDonutOptions()" BarOptions="@GetSplitBarOptions()" />
                        </div>
                    </div>
                </div>
                <div class="db-col db-col--6">
                    <div class="db-card db-card--h100">
                        <div class="db-card-header"><span class="db-card-title">Expense Category Split</span></div>
                        <div class="db-card-body">
                            <SplitChartComponent Title="" Data="@purchaseData.ExpenseCategorySplit"
                                                 SelectedType="@globalSplitChartType" SelectedTypeChanged="@(v => globalSplitChartType = v)"
                                                 PieOptions="@GetPieOptions()" DonutOptions="@GetDonutOptions()" BarOptions="@GetSplitBarOptions()" />
                        </div>
                    </div>
                </div>
                <div class="db-col db-col--6">
                    <div class="db-card db-card--h100">
                        <div class="db-card-header"><span class="db-card-title">Top Vendors</span></div>
                        <div class="db-table-wrap">
                            <table class="db-table">
                                <thead><tr><th>Vendor</th><th>POs</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    @foreach (var vendor in purchaseData.TopVendors)
                                    {
                                        <tr>
                                            <td>
                                                <div class="db-party-cell">
                                                    <span class="db-avatar db-avatar--amber">
                                                        @(string.IsNullOrWhiteSpace(vendor.Name) ? "?" : vendor.Name[0])
                                                    </span>
                                                    <span>@vendor.Name</span>
                                                </div>
                                            </td>
                                            <td class="db-muted">@vendor.Orders</td>
                                            <td class="text-end db-fw">@vendor.Revenue</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- ═══════════════════════════════════════════════════════════════
         OTHER TABS (Labour, Subcontract, Job Card, Analytics, HR, Inventory)
    ═══════════════════════════════════════════════════════════════ -->
    @if (activeTopTab != "Overview" && activeTopTab != "Sales" && activeTopTab != "Purchase")
    {
        @if (isLoadingTab)
        {
            <div class="db-loading"><div class="db-spinner"></div></div>
        }
        else
        {
            @if (activeTopTab == "Labour/Job Work" && labourData is not null)
            {
                @foreach (var section in labourSections) { <KpiSection Section="section" /> }
            }

            @if (activeTopTab == "Subcontract" && subcontractData is not null)
            {
                @foreach (var section in subcontractSections) { <KpiSection Section="section" /> }
            }

            @if (activeTopTab == "Job Card" && jobCardData is not null)
            {
                @foreach (var section in jobCardSections) { <KpiSection Section="section" /> }
            }

            @if (activeTopTab == "HR" && hrData is not null)
            {
                <div class="db-row">
                    <div class="db-col db-col--8">
                        <div class="db-card">
                            <div class="db-card-header">
                                <span class="db-card-title">
                                    <i class="bi bi-people-fill me-2" style="color:#EC4899;"></i>Attendance Trend
                                </span>
                            </div>
                            <div class="db-card-body">
                                <TrendChartComponent Title="" Icon="" IconColor="#EC4899"
                                                     Series1="@hrData.AttendanceWeek" Series2="@hrData.AttendanceWeek"
                                                     Series1Name="Attendance" Series2Name=""
                                                     SelectedType="@globalTrendChartType" SelectedTypeChanged="@(v => globalTrendChartType = v)"
                                                     LineOptions="@GetLineOptions()" AreaOptions="@GetAreaOptions()" BarOptions="@GetBarOptions()" />
                            </div>
                        </div>
                    </div>
                    <div class="db-col db-col--4">
                        <div class="db-card db-card--h100">
                            <div class="db-card-header"><span class="db-card-title">Department Split</span></div>
                            <div class="db-card-body">
                                <SplitChartComponent Title="" Data="@hrData.DeptSplit"
                                                     SelectedType="@globalSplitChartType" SelectedTypeChanged="@(v => globalSplitChartType = v)"
                                                     PieOptions="@GetPieOptions()" DonutOptions="@GetDonutOptions()" BarOptions="@GetSplitBarOptions()" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (activeTopTab == "Inventory" && inventoryData is not null)
            {
                <div class="db-row">
                    <div class="db-col db-col--8">
                        <div class="db-card">
                            <div class="db-card-header">
                                <span class="db-card-title">
                                    <i class="bi bi-box-seam-fill me-2" style="color:#14B8A6;"></i>Inventory Level
                                </span>
                            </div>
                            <div class="db-card-body">
                                <TrendChartComponent Title="" Icon="" IconColor="#14B8A6"
                                                     Series1="@inventoryData.LevelChart" Series2="@inventoryData.LevelChart"
                                                     Series1Name="Stock Level" Series2Name=""
                                                     SelectedType="@globalTrendChartType" SelectedTypeChanged="@(v => globalTrendChartType = v)"
                                                     LineOptions="@GetLineOptions()" AreaOptions="@GetAreaOptions()" BarOptions="@GetBarOptions()" />
                            </div>
                        </div>
                    </div>
                    <div class="db-col db-col--4">
                        <div class="db-card db-card--h100">
                            <div class="db-card-header"><span class="db-card-title">Low Stock Items</span></div>
                            <div class="db-table-wrap">
                                <table class="db-table">
                                    <thead><tr><th>Item</th><th class="text-end">Qty</th></tr></thead>
                                    <tbody>
                                        @foreach (var item in inventoryData.LowStock)
                                        {
                                            <tr>
                                                <td>@item.Name</td>
                                                <td class="text-end" style="color:#dc2626;font-weight:600;">@item.Qty</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }

</div>
@code {

    protected override string ScreenName => "Dashboard";

    // ── Theme ────────────────────────────────────────────────────────────────
    private bool isDark = false;
    private void ToggleTheme() => isDark = !isDark;

    // ── Period / Date ────────────────────────────────────────────────────────
    private DateTime? fromDate = DateTime.Today.AddDays(-7);
    private DateTime? toDate = DateTime.Today;
    private string activePeriod = "This Week";
    private string searchQuery = "";

    // ── GroupBy ──────────────────────────────────────────────────────────────
    private string activeGroupBy = "Day";

    private List<(string Key, string Label)> availableGroupBys =>
        activePeriod switch
        {
            "Today" => new() { ("Hour", "Hourly") },
            "This Week" => new() { ("Day", "Daily"), ("Week", "Weekly") },
            "This Month" => new() { ("Day", "Daily"), ("Week", "Weekly") },
            "Quarter" => new() { ("Week", "Weekly"), ("Month", "Monthly") },
            "Year" => new() { ("Month", "Monthly") },
            _ => new() { ("Hour", "Hourly"), ("Day", "Daily"), ("Week", "Weekly"), ("Month", "Monthly") }
        };




    // ── Chart type state ─────────────────────────────────────────────────────

    private string globalTrendChartType = "line";
    private string globalSplitChartType = "donut";

    private string trendChartType = "line";
    private string splitChartType = "donut";


    private string subconChartType = "bar";
    private string subconSplitType = "donut";
    private string inventoryChartType = "bar";
    private string financeChartType = "area";
    private string expenseChartType = "donut";
    private string hrChartType = "bar";
    private string jobCardChartType = "bar";
    private string jobCardSplitType = "donut";
    private string routeCardChartType = "bar";
    private string routeCardSplitType = "donut";

    private string jobCardSearchQuery = "";
    private string routeCardSearchQuery = "";

    // ── Chart type definitions ───────────────────────────────────────────────
    private List<(string Key, string Label, string Icon)> chartTypes = new()
    {
        ("line", "Line Chart", "bi-graph-up"),
        ("bar",  "Bar Chart",  "bi-bar-chart-fill"),
        ("area", "Area Chart", "bi-reception-4"),
    };

    // ── Loading flags ────────────────────────────────────────────────────────
    private bool isLoadingSummary = false;
    private bool isLoadingTab = false;

    // ── Service results ──────────────────────────────────────────────────────
    private DashboardSummaryDto? summaryResult;
    private OverviewDto? overviewData;
    private InventoryDto? inventoryData;
    private FinanceDto? financeData;
    private HrDto? hrData;
    private SalesDto? salesData;
    private LabourDto? labourData;
    private PurchaseDto? purchaseData;
    private SubcontractDto? subcontractData;
    private JobCardDto? jobCardData;
    private RouteCardDto? routeCardData;
    private AnalyticsDto? analyticsData;

    private string analyticsChartType = "bar";

    // -- KpiSection  ---------------------------
    private List<DashboardKpiSection> salesSections = new();
    private List<DashboardKpiSection> labourSections = new();
    private List<DashboardKpiSection> purchaseSections = new();
    private List<DashboardKpiSection> subcontractSections = new();
    private List<DashboardKpiSection> jobCardSections = new();

    // ── Tab list ─────────────────────────────────────────────────────────────
    private string activeTopTab = "Overview";
    private string[] topTabs = { "Overview", "Sales", "Labour/Job Work", "Purchase",
    "Subcontract", "Job Card", "Route Card", "Inventory", "Finance", "Analytics" };


    private List<string> periods = new() { "Today", "This Week", "This Month", "Quarter", "Year", "Custom" };

