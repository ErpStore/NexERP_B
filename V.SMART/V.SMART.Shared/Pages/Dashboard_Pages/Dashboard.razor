@page "/dashboard"
@using ApexCharts
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IDashboardService
@using V.SMART.Shared.ViewModels.DashboadrViewModel


@inherits BaseUserRightsComponent
@inject ThemeStateService ThemeStateService
@inject IDashboardService DashboardService
@inject NavigationManager Nav
@inject ILoggingService LoggingService

<PageTitle>ERP Dashboard</PageTitle>

<div class="@($"erp-root {(isDark ? "dark" : "light")}")">

    <!-- Background Orbs -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <div class="container-fluid py-3 px-3 px-xl-4 position-relative">
        <div class="row g-3">

            <!-- ── TOP NAV ─────────────────────────────────────────── -->
            <div class="col-12">
                <nav class="glass-nav d-flex align-items-center gap-1 px-2 px-md-3 flex-wrap">
                    @foreach (var tab in topTabs)
                    {
                        <a href="#"
                           class="@($"erp-tab{(activeTopTab == tab ? " active" : "")}")"
                           @onclick="() => SetActiveTab(tab)"
                           @onclick:preventDefault>
                            <i class="@($"bi {GetTabIcon(tab)} me-1")"></i>@tab
                        </a>
                    }
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <button class="glass-icon-btn pos-rel" title="Notifications">
                            <i class="bi bi-bell"></i>
                            <span class="notif-dot"></span>
                        </button>
                        <button class="theme-toggle glass-icon-btn" @onclick="ToggleTheme" title="Toggle Theme">
                            <i class="@($"bi {(isDark ? "bi-sun-fill" : "bi-moon-stars-fill")}")"></i>
                        </button>
                    </div>
                </nav>
            </div>

            <!-- ── HERO (Overview only) ────────────────────────────── -->
            @if (activeTopTab == "Overview")
            {
                <div class="col-12">
                    <div class="glass-hero d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
                        <div>
                            <div class="hero-eyebrow"><i class="bi bi-building me-1"></i>Enterprise Resource Planning</div>
                            <h1 class="hero-title mb-1">Welcome Back, Admin</h1>
                            <p class="hero-sub mb-0">
                                <i class="bi bi-clock me-1 opacity-50"></i>
                                Real-time overview &mdash;
                                <span class="hero-date">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
                            </p>
                        </div>
                    </div>
                </div>
            }


            <!-- ── PERIOD FILTER ───────────────────────────────────── -->
            <div class="col-12">
                <div class="glass-pill-bar d-flex align-items-center flex-wrap gap-2">
                    <span class="period-label"><i class="bi bi-calendar3 me-1"></i>Period:</span>
                    @foreach (var p in periods)
                    {
                        <button class="@($"period-pill {(activePeriod == p ? "active" : "")}")"
                                @onclick="() => SetPeriod(p)">
                            @if (activePeriod == p)
                            {
                                <i class="bi bi-check2-circle me-1"></i>
                            }
                            @p
                        </button>
                    }
                    <div class="custom-range-wrap d-flex align-items-center gap-2 flex-wrap">
                        <div class="date-box">
                            <i class="bi bi-calendar-event"></i>
                            <input type="date" class="glass-date" @bind="fromDate" />
                        </div>
                        <span class="range-separator">to</span>
                        <div class="date-box">
                            <i class="bi bi-calendar-event"></i>
                            <input type="date" class="glass-date" @bind="toDate" />
                        </div>
                        <button class="btn btn-sm btn-glass-primary" @onclick="ApplyCustomRange">
                            <i class="bi bi-check2 me-1"></i>Apply
                        </button>
                    </div>
                </div>
            </div>

            <!-- ════════════════════════════════════════════════════════
                 OVERVIEW TAB
            ════════════════════════════════════════════════════════ -->
            @if (activeTopTab == "Overview")
            {
                <!-- Summary Cards -->
                <div class="col-12">
                    @if (isLoadingSummary)
                    {
                        <div class="summary-track">
                            @for (int i = 0; i < 8; i++)
                            {
                                <div class="glass-summary-card skeleton-card">
                                    <div class="skeleton-line w-50 mb-2"></div>
                                    <div class="skeleton-line w-75"></div>
                                    <div class="skeleton-line w-60"></div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="summary-track">
                            @foreach (var card in summaryCards)
                            {
                                <div class="glass-summary-card" style="--acc:@card.Accent">
                                    <div class="gsc-head">
                                        <div class="gsc-icon"><i class="@($"bi {card.Icon}")"></i></div>
                                        <h6 class="gsc-title">@card.Title</h6>
                                    </div>
                                    @foreach (var row in card.Rows)
                                    {
                                        <div class="@($"gsc-row{(row.IsTotal ? " total" : "")}")">
                                            <span>@row.Label</span>
                                            <strong>@GetSummaryValue(card.Title, row.Key, row.FallbackValue)</strong>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (isLoadingTab)
                {
                    <div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (overviewData is not null)
                {
                    <!-- Business Trend Chart -->
                    <div class="col-lg-8">
                        <div class="glass-card h-100">
                            <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
                                <div>
                                    <h5 class="gc-title mb-0">Business Trend</h5>
                                    <small class="gc-sub">@activePeriod — @GetGroupByLabel() &nbsp;·&nbsp; Sales · Purchase · Export · Labour · Sub-Con</small>
                                </div>
                                <div class="d-flex flex-column gap-2 align-items-end">
                                    <div class="d-flex gap-1 flex-wrap justify-content-end">
                                        @foreach (var gb in availableGroupBys)
                                        {
                                            <button class="btn btn-sm @(activeGroupBy == gb.Key ? "btn-glass-primary" : "btn-glass-outline")"
                                                    @onclick="() => SetGroupBy(gb.Key)">
                                                @gb.Label
                                            </button>
                                        }
                                    </div>
                                    <div class="chart-type-bar d-flex gap-1">
                                        @foreach (var ct in chartTypes)
                                        {
                                            <button class="chart-type-btn @(trendChartType == ct.Key ? "active" : "")"
                                                    title="@ct.Label" @onclick="() => SetTrendChartType(ct.Key)">
                                                <i class="bi @ct.Icon"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (overviewData.SalesTrend.Any())
                            {
                                @if (trendChartType == "bar")
                                {
                                    <ApexChart TItem="ChartPointDto" Height="290" Title="" Options="GetBarOptions()">
                                        @foreach (var series in overviewData.SalesTrend)
                                        {
                                            <ApexPointSeries TItem="ChartPointDto" Items="series.Data" Name="@series.Name"
                                                             SeriesType="SeriesType.Bar" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                        }
                                    </ApexChart>
                                }
                                else if (trendChartType == "area")
                                {
                                    <ApexChart TItem="ChartPointDto" Height="290" Title="" Options="GetAreaOptions()">
                                        @foreach (var series in overviewData.SalesTrend)
                                        {
                                            <ApexPointSeries TItem="ChartPointDto" Items="series.Data" Name="@series.Name"
                                                             SeriesType="SeriesType.Area" XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                        }
                                    </ApexChart>
                                }
                                else
                                {
                                    <ApexChart TItem="ChartPointDto" Height="290" Title="" Options="GetLineOptions()">
                                        @foreach (var series in overviewData.SalesTrend)
                                        {
                                            <ApexPointSeries TItem="ChartPointDto" Items="series.Data" Name="@series.Name"
                                                             XValue="@(e => e.Label)" YValue="@(e => e.Value)" />
                                        }
                                    </ApexChart>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="bi bi-graph-up fs-2 opacity-30"></i>
                                    <p class="mt-2 small">No transactions in the selected period.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Business Split Chart -->
                    <div class="col-lg-4">
                        <div class="glass-card h-100">
                            <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
                                <div>
                                    <h5 class="gc-title mb-0">Business Split</h5>
                                    <small class="gc-sub">By category</small>
                                </div>
                                <div class="chart-type-bar d-flex gap-1">
                                    <button class="chart-type-btn @(splitChartType == "donut" ? "active" : "")" title="Donut" @onclick='() => splitChartType = "donut"'><i class="bi bi-circle-half"></i></button>
                                    <button class="chart-type-btn @(splitChartType == "pie" ? "active" : "")" title="Pie" @onclick='() => splitChartType = "pie"'><i class="bi bi-pie-chart-fill"></i></button>
                                    <button class="chart-type-btn @(splitChartType == "bar" ? "active" : "")" title="Bar" @onclick='() => splitChartType = "bar"'><i class="bi bi-bar-chart-fill"></i></button>
                                </div>
                            </div>
                            @if (overviewData.BusinessSplit.Any())
                            {
                                @if (splitChartType == "pie")
                                {
                                    <ApexChart TItem="BusinessDataDto" Height="290" Title="" Options="GetPieOptions()">
                                        <ApexPointSeries TItem="BusinessDataDto" Items="overviewData.BusinessSplit" Name="Amount"
                                                         SeriesType="SeriesType.Pie" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                                    </ApexChart>
                                }
                                else if (splitChartType == "bar")
                                {
                                    <ApexChart TItem="BusinessDataDto" Height="290" Title="" Options="GetSplitBarOptions()">
                                        <ApexPointSeries TItem="BusinessDataDto" Items="overviewData.BusinessSplit" Name="Amount"
                                                         SeriesType="SeriesType.Bar" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                                    </ApexChart>
                                }
                                else
                                {
                                    <ApexChart TItem="BusinessDataDto" Height="290" Title="" Options="GetDonutOptions()">
                                        <ApexPointSeries TItem="BusinessDataDto" Items="overviewData.BusinessSplit" Name="Amount"
                                                         SeriesType="SeriesType.Donut" XValue="@(e => e.Category)" YValue="@(e => e.Value)" />
                                    </ApexChart>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="bi bi-pie-chart fs-2 opacity-30"></i>
                                    <p class="mt-2 small">No data for this period.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Recent Transactions -->
                    <div class="col-12">
                        <div class="glass-card">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <h5 class="gc-title mb-0">Recent Transactions</h5>
                                <div class="d-flex gap-2 flex-wrap">
                                    <div class="input-group input-group-sm glass-search" style="max-width:220px">
                                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control" placeholder="Search doc / party / type…"
                                               @bind="searchQuery" @bind:event="oninput" />
                                    </div>
                                    <button class="btn btn-sm btn-glass-outline"><i class="bi bi-funnel me-1"></i>Filter</button>
                                    <button class="btn btn-sm btn-glass-outline"><i class="bi bi-download me-1"></i>CSV</button>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table align-middle glass-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Doc No</th>
                                            <th>Party</th>
                                            <th>Type</th>
                                            <th>Date</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody class="custom-size">
                                        @foreach (var tx in FilteredTransactions)
                                        {
                                            <tr>
                                                <td><span class="doc-chip">@tx.DocNo</span></td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="party-av">@(tx.Party?.Length > 0 ? tx.Party[0] : '?')</div>
                                                        <span>@tx.Party</span>
                                                    </div>
                                                </td>
                                                <td><span class="type-badge">@tx.Type</span></td>
                                                <td class="text-muted small">@tx.Date</td>
                                                <td class="fw-semibold">@tx.Amount</td>
                                                <td><span class="@($"status-badge {tx.StatusClass}")">@tx.Status</span></td>
                                                <td><button class="glass-icon-btn-sm"><i class="bi bi-three-dots"></i></button></td>
                                            </tr>
                                        }
                                        @if (!FilteredTransactions.Any())
                                        {
                                            <tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox me-2"></i>No transactions found.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                                <small class="text-muted">Showing @FilteredTransactions.Count() of @overviewData.Transactions.Count</small>
                                <nav>
                                    <ul class="pagination pagination-sm mb-0 glass-pagination">
                                        <li class="page-item disabled"><a class="page-link" href="#">&laquo;</a></li>
                                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                                        <li class="page-item"><a class="page-link" href="#">&raquo;</a></li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                }
            }



            <!-- ════════════════════════════════════════════════════════
                 SALES TAB
            ════════════════════════════════════════════════════════ -->
            @if (activeTopTab == "Sales")
            {
                @if (isLoadingTab)
                {
                    <div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (salesData is not null)
                {

                    @foreach (var section in salesSections)
                    {
                        <KpiSection Section="section" />
                    }

                    <!-- Sales Trend -->
                    <div class="col-lg-8">
                        <TrendChartComponent Title="Sales Trend"
                                             Icon="bi bi-bar-chart-line"
                                             IconColor="#0891b2"
                                             Series1="@salesData.ActualSales"
                                             Series2="@salesData.TargetSales"
                                             Series1Name="Invoice Value"
                                             Series2Name="PO Value"
                                             SelectedType="@globalTrendChartType"
                                             SelectedTypeChanged="@(v => globalTrendChartType = v)"
                                             LineOptions="@GetLineOptions()"
                                             AreaOptions="@GetAreaOptions()"
                                             BarOptions="@GetBarOptions()" />

                    </div>

                    <div class="col-lg-4">

                        <SplitChartComponent Title="Payment Split"
                                             Data="@salesData.PaymentSplit"
                                             SelectedType="@globalSplitChartType"
                                             SelectedTypeChanged="@(v => globalSplitChartType = v)"
                                             PieOptions="@GetPieOptions()"
                                             DonutOptions="@GetDonutOptions()"
                                             BarOptions="@GetSplitBarOptions()" />

                    </div>



                    <div class="col-lg-4">
                        <div class="glass-card h-100">
                            <h5 class="gc-title mb-3">Top Customers</h5>
                            <ul class="list-group list-group-flush erp-list">
                                @foreach (var c in salesData.TopCustomers)
                                {
                                    <li class="list-group-item erp-list-item d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="party-av sm-av">@c.Name[0]</div>
                                            <div>
                                                <div class="small fw-semibold">@c.Name</div>
                                                <div style="font-size:11px;color:var(--text-sub)">@c.Orders orders</div>
                                            </div>
                                        </div>
                                        <span class="fw-bold small">@c.Revenue</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Sales Orders Table -->
                    <div class="col-lg-8">
                        <div class="glass-card">
                            <h5 class="gc-title mb-3">Sales Orders</h5>
                            <div class="table-responsive">
                                <table class="table align-middle glass-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Inv No.</th>
                                            <th>Inv Date</th>
                                            <th>Customer</th>
                                            <th>No. of Items</th>
                                            <th>Value</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var so in salesData.Orders)
                                        {
                                            <tr>
                                                <td><span class="doc-chip">@so.InvNo</span></td>
                                                <td class="text-muted small">@so.InvDate</td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="party-av">@so.CustName[0]</div>
                                                        <span>@so.CustName</span>
                                                    </div>
                                                </td>
                                                <td class="text-muted small">@so.NoOfItems</td>
                                                <td class="fw-semibold">@so.GrandTotal</td>
                                                <td>
                                                    @if (so.IsCancel)
                                                    {
                                                        <span class="status-badge failed">Cancelled</span>
                                                    }
                                                    else if (so.PoShortClose)
                                                    {

                                                        <span class="status-badge" style="background:rgba(100,116,139,0.15);color:#64748b">Short Closed</span>
                                                    }
                                                    else if (so.InvTally)
                                                    {

                                                        <span class="status-badge done">Completed</span>
                                                    }
                                                    else
                                                    {

                                                        <span class="status-badge pending">Pending</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }



            <!-- ════════════════════════════════════════════════════════
                 LABOUR / JOB WORK TAB
            ════════════════════════════════════════════════════════ -->
            @if (activeTopTab == "Labour/Job Work")
            {
                @if (isLoadingTab)
                {
                    <div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (labourData is not null)
                {

                    @foreach (var section in labourSections)
                    {
                        <KpiSection Section="section" />
                    }

                    <div class="col-lg-8">
                        <TrendChartComponent Title="Labour Trend"
                                             Icon="bi bi-bar-chart-steps"
                                             IconColor="#0ea5e9"
                                             Series1="@labourData.TargetLabour"
                                             Series2="@labourData.ActualLabour"
                                             Series1Name="PO Value"
                                             Series2Name="Invoice Value"
                                             SelectedType="@globalTrendChartType"
                                             SelectedTypeChanged="@(v => globalTrendChartType = v)"
                                             LineOptions="@GetLineOptions()"
                                             AreaOptions="@GetAreaOptions()"
                                             BarOptions="@GetBarOptions()" />
                    </div>

                    <div class="col-lg-4">
                        <SplitChartComponent Title="Payment Split"
                                             Data="@labourData.PaymentSplit"
                                             SelectedType="@globalSplitChartType"
                                             SelectedTypeChanged="@(v => globalSplitChartType = v)"
                                             PieOptions="@GetPieOptions()"
                                             DonutOptions="@GetDonutOptions()"
                                             BarOptions="@GetSplitBarOptions()" />

                    </div>

                    <div class="col-lg-4">
                        <div class="glass-card h-100">
                            <h5 class="gc-title mb-3">Top Customers</h5>
                            <ul class="list-group list-group-flush erp-list">
                                @foreach (var c in labourData.TopCustomers)
                                {
                                    <li class="list-group-item erp-list-item d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="party-av sm-av">@c.Name[0]</div>
                                            <div>
                                                <div class="small fw-semibold">@c.Name</div>
                                                <div style="font-size:11px;color:var(--text-sub)">@c.Orders orders</div>
                                            </div>
                                        </div>
                                        <span class="fw-bold small">@c.Revenue</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>


                    <div class="col-lg-8">
                        <div class="glass-card">
                            <h5 class="gc-title mb-3">Labour Invoices</h5>

                            <div class="table-responsive">
                                <table class="table align-middle glass-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Inv No.</th>
                                            <th>Inv Date</th>
                                            <th>Customer</th>
                                            <th>Value</th>
                                            <th>Balance</th>
                                            <th>Status</th>
                                            <th>Created By</th>
                                            <th>Created Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (labourData?.Orders?.Any() == true)
                                        {
                                            @foreach (var inv in labourData.Orders)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="doc-chip">@inv.LabInvNo</span>
                                                    </td>

                                                    <td class="text-muted small">
                                                        @inv.LabInvDate
                                                    </td>

                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="party-av">
                                                                @(string.IsNullOrWhiteSpace(inv.CustName)
                                                                                                                ? "?"
                                                                                                                : inv.CustName.Substring(0, 1).ToUpper())
                                            </div>
                                            <span>@inv.CustName</span>
                                        </div>
                                    </td>

                                                    <td class="fw-semibold">
                                                        @inv.GrandTotal
                                                    </td>

                                                    <td class="fw-semibold @(inv.Balance == 0 ? "text-success" : "text-warning")">
                                                        @inv.Balance
                                                    </td>

                                                    <td>
                                                        <span class="status-badge @(inv.InvCancel ? "cancelled" : "completed")">
                                                            @(inv.InvCancel ? "Cancelled" : "Completed")
                                                        </span>
                                                    </td>

                                                    <td class="text-muted small">
                                                        @inv.CreatedBy
                                                    </td>

                                                    <td class="text-muted small">
                                                        @inv.CreatedDate
                                                    </td>
                                                </tr>
                                                                }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="text-center text-muted py-4">
                                                    <i class="bi bi-inbox me-2"></i>
                                                    No records found.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }


            <!-- ════════════════════════════════════════════════════════
                 PURCHASE TAB
            ════════════════════════════════════════════════════════ -->
            @if (activeTopTab == "Purchase")
            {
                @if (isLoadingTab)
                {
                    <div class="col-12 text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (purchaseData is not null)
                {
                    @foreach (var section in purchaseSections)
                    {
                        <KpiSection Section="section" />
                    }

                    <div class="row g-4">

                        <!-- Purchase vs Expense Trend -->
                        <div class="col-lg-8">
                            <TrendChartComponent Title="Purchase & Expense Trend"
                                                 Icon="bi bi-bar-chart-steps"
                                                 IconColor="#0ea5e9"
                                                 Series1="@purchaseData.PurchaseTrend"
                                                 Series2="@purchaseData.ExpenseTrend"
                                                 Series1Name="Purchase Orders"
                                                 Series2Name="Expenses"
                                                 SelectedType="@globalTrendChartType"
                                                 SelectedTypeChanged="@(v => globalTrendChartType = v)"
                                                 LineOptions="@GetLineOptions()"
                                                 AreaOptions="@GetAreaOptions()"
                                                 BarOptions="@GetBarOptions()" />
                        </div>

                        <!-- Vendor Split -->
