    // ── Summary value resolver ───────────────────────────────────────────────
    private string GetSummaryValue(string cardTitle, string key, string fallback)
    {
        if (summaryResult is null) return fallback;
        var card = cardTitle switch
        {
            "Payment" => summaryResult.Payment,
            "Receipt" => summaryResult.Receipt,
            "Sales Enquiry & Quote" => summaryResult.SalesEnquiryQuote,
            "Sales" => summaryResult.Sales,
            "Labour" => summaryResult.Labour,
            "Purchase" => summaryResult.Purchase,
            "Sub Contract" => summaryResult.SubContract,
            "Export" => summaryResult.Export,
            _ => null
        };
        if (card is null) return fallback;
        return key switch { "v1" => card.V1, "v2" => card.V2, "v3" => card.V3, "v4" => card.V4, _ => fallback };
    }

