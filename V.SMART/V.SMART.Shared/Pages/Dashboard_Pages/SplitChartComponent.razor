@using ApexCharts
@using ApexCharts
@using V.SMART.Shared.ViewModels.DashboadrViewModel
<div class="ng-card h-100">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="gc-title mb-0">@Title</h5>

        <div class="chart-type-bar d-flex gap-1">

            <button class="chart-type-btn @(SelectedType=="donut" ? "active" : "")"
                    @onclick='() => ChangeChart("donut")'>
                <i class="bi bi-circle-half"></i>
            </button>

            <button class="chart-type-btn @(SelectedType=="pie" ? "active" : "")"
                    @onclick='() => ChangeChart("pie")'>
                <i class="bi bi-pie-chart-fill"></i>
            </button>

            <button class="chart-type-btn @(SelectedType=="bar" ? "active" : "")"
                    @onclick='() => ChangeChart("bar")'>
                <i class="bi bi-bar-chart-fill"></i>
            </button>

        </div>

    </div>

    @if (Data.Any())
    {
        @if (SelectedType == "pie")
        {
            <ApexChart TItem="BusinessDataDto"
                       Height="260"
                       Options="PieOptions">

                <ApexPointSeries TItem="BusinessDataDto"
                                 Items="Data"
                                 Name="Amount"
                                 SeriesType="SeriesType.Pie"
                                 XValue="@(e => e.Category)"
                                 YValue="@(e => e.Value)" />
            </ApexChart>
        }
        else if (SelectedType == "bar")
        {
            <ApexChart TItem="BusinessDataDto"
                       Height="260"
                       Options="BarOptions">

                <ApexPointSeries TItem="BusinessDataDto"
                                 Items="Data"
                                 Name="Amount"
                                 SeriesType="SeriesType.Bar"
                                 XValue="@(e => e.Category)"
                                 YValue="@(e => e.Value)" />
            </ApexChart>
        }
        else
        {
            <ApexChart TItem="BusinessDataDto"
                       Height="260"
                       Options="DonutOptions">

                <ApexPointSeries TItem="BusinessDataDto"
                                 Items="Data"
                                 Name="Amount"
                                 SeriesType="SeriesType.Donut"
                                 XValue="@(e => e.Category)"
                                 YValue="@(e => e.Value)" />
            </ApexChart>
        }
    }

</div>

@code
{
    [Parameter] public string Title { get; set; } = "Payment Split";

    [Parameter] public List<BusinessDataDto> Data { get; set; } = [];

    [Parameter] public string SelectedType { get; set; } = "donut";
    [Parameter] public EventCallback<string> SelectedTypeChanged { get; set; }

    [Parameter] public ApexChartOptions<BusinessDataDto> PieOptions { get; set; } = default!;
    [Parameter] public ApexChartOptions<BusinessDataDto> DonutOptions { get; set; } = default!;
    [Parameter] public ApexChartOptions<BusinessDataDto> BarOptions { get; set; } = default!;

    private async Task ChangeChart(string type)
    {
        SelectedType = type;
        await SelectedTypeChanged.InvokeAsync(type);
    }
}