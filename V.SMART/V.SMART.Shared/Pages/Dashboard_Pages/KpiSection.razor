@using V.SMART.Shared.ViewModels.DashboadrViewModel

@if (Section is not null)
{
    <div class="col-12 mb-3">
        <div class="glass-card">

            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">

                <h5 class="gc-title mb-0">
                    <i class="@Section.HeaderIcon me-2"></i>
                    @Section.Title
                </h5>

                <span class="badge @Section.BadgeClass px-3 py-2">
                    @Section.BadgeText
                </span>

            </div>

            <div class="row g-3">

                @if (Section.Cards?.Any() == true)
                {
                    @foreach (var card in Section.Cards)
                    {
                        <div class="col-6 col-md-3">

                            <div class="kpi-card" style="--kc:@card.Color">

                                <div class="kpi-card-scan"></div>

                                <div class="kpi-card-icon">
                                    <i class="@card.Icon"></i>
                                </div>

                                <div class="kpi-card-body">
                                    <span class="kpi-card-val">@card.Value</span>
                                    <span class="kpi-card-lbl">@card.Title</span>
                                </div>

                            </div>

                        </div>
                    }
                }

            </div>

        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public DashboardKpiSection Section { get; set; } = default!;
}