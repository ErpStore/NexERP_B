@using V.SMART.Shared.ViewModels.DashboadrViewModel

@if (Section is not null)
{
    <div class="col-12 mb-4">
        <div class="ng-card">
            <div class="ng-card-header">
                <div class="ng-card-title">
                    <i class="@Section.HeaderIcon me-2" style="color:var(--ng-brand);"></i>@Section.Title
                </div>
                <span class="zh-chip @GetBadgeChipClass(Section.BadgeClass)">@Section.BadgeText</span>
            </div>
            <div class="ng-card-body">
                <div class="ng-kpi-grid">
                    @if (Section.Cards?.Any() == true)
                    {
                        @foreach (var card in Section.Cards)
                        {
                            <div class="ng-kpi" style="--ng-kpi-accent:@card.Color;--ng-kpi-icon-bg:@(card.Color + "22");--ng-kpi-icon-color:@card.Color;">
                                <div class="ng-kpi-icon"><i class="@card.Icon"></i></div>
                                <div class="ng-kpi-label">@card.Title</div>
                                <div class="ng-kpi-value">@card.Value</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public DashboardKpiSection Section { get; set; } = default!;

    private static string GetBadgeChipClass(string badgeClass) => badgeClass switch {
        var s when s.Contains("success") || s.Contains("green")  => "zh-chip-success",
        var s when s.Contains("warning") || s.Contains("yellow") => "zh-chip-warning",
        var s when s.Contains("danger")  || s.Contains("red")    => "zh-chip-danger",
        var s when s.Contains("info")    || s.Contains("blue")   => "zh-chip-info",
        _                                                          => "zh-chip-neutral"
    };
}