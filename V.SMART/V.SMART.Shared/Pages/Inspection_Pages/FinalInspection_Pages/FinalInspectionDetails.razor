@page "/FinalInspection/details/{InspectionId:int}"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IInspectionService
@using V.SMART.Shared.ViewModels.InspectionViewModel.FinalInspectionVM
@using V.SMART.Shared.ViewModels.InspectionViewModel.MasterInspectionVM

@inherits BaseUserRightsComponent

@inject IFinalInspectionService finalInspectionService
@inject IJSRuntime js
@inject ILoggingService logs
@inject NavigationManager _nav

@if (isProcessing)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-white bg-opacity-75" style="z-index:1050">
        <img src="/_content/V.SMART.Shared/images/loading.gif" style="max-height:100px" />
    </div>
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

    <!-- Company Header -->
    <MyCompanyDetails />

        <hr class="border-2 border-primary-subtle mb-4" />
    <div class="text-center">
        <h4 class="fw-semibold mt-3">Final Inspection Details</h4>
    </div>

    <hr class="border-2 border-primary-subtle mb-4" />

    <!-- Inspection Header Details -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card border-1 shadow-sm rounded-3 h-100">
                <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                    Inspection Details
                </div>
                <div class="card-body p-2 small">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td class="text-secondary" style="width: 40%;"><strong>Inspection No</strong></td>
                                <td>@(!string.IsNullOrWhiteSpace($"{InspectionVM?.InspectNo}{InspectionVM?.Suffix}") ? $"{InspectionVM?.InspectNo}{InspectionVM?.Suffix}" : "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-secondary"><strong>Inspection Date</strong></td>
                                <td>@(InspectionVM?.InspectDate != null ? InspectionVM.InspectDate.ToString("dd/MM/yyyy") : "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-secondary"><strong>Inspected By</strong></td>
                                <td>@(InspectionVM?.InspectBy ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-secondary"><strong>Remarks</strong></td>
                                <td>@(InspectionVM?.Remarks ?? "N/A")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


        <div class="col-md-6">
            <div class="card border-1 shadow-sm rounded-3 h-100">
                <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                    Customer & Item
                </div>
                <div class="card-body p-2 small">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td class="text-secondary" style="width:40%"><strong>Customer</strong></td>
                                <td>@(InspectionVM?.CustomerName ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-secondary"><strong>Item Code</strong></td>
                                <td>@(InspectionVM?.ItemCode ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-secondary"><strong>Item Name</strong></td>
                                <td>@(InspectionVM?.ItemName ?? "N/A")</td>
                            </tr>
                            <tr>
                                <td class="text-secondary"><strong>Qty</strong></td>
                                <td>@(InspectionVM?.Qty.ToString() ?? "N/A")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


    </div>

    <!-- Inspection Dimension Table -->
    <div class="card border-1 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">Inspection Measurements</div>

        <div class="table-responsive" style="overflow-x:auto;">
            <table class="ttable table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                <thead class="custom-blue">
                    <tr>
                        <th class="text-center">Sl No</th>
                        <th class="text-center">Description</th>
                        <th class="text-center">Dimens</th>
                        <th class="text-center">Lo Tol</th>
                        <th class="text-center">Hi Tol</th>

                        @if (InspectionVM.InspectionType=="Individual")
                        {
                            @for (int i = 1; i <= noofsamples; i++)
                            {
                                <th style="width:70px; white-space:nowrap;">
                                    Sample @(((InspectionVM.SheetSlNo - 1) * noofsamples) + i)
                                </th>
                            }
                        }
                        else
                        {
                            @for (int i = 1; i <= noofsamples; i++)
                            {
                                <th style="width:70px; white-space:nowrap;">
                                    Sample @i
                                </th>
                            }
                        }

                        <th>Instrument</th>
                        <th>Defect</th>
                        <th>Remark</th>
                    </tr>
                </thead>

                <tbody class="custom-size">
                    @foreach (var row in InspectionRows)
                    {
                        <tr>
                            <td>@row.SlNo</td>
                            <td>@row.Desc</td>
                            <td>@row.Dimens</td>
                            <td>@row.LoTol</td>
                            <td>@row.HiTol</td>
                            <td class="@(row.Comp1 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp1) ? "text-danger" : "text-success") : "")">@row.Comp1</td>

                            <td class="@(row.Comp2 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp2) ? "text-danger" : "text-success") : "")">@row.Comp2</td>

                            <td class="@(row.Comp3 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp3) ? "text-danger" : "text-success") : "")">@row.Comp3</td>

                            <td class="@(row.Comp4 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp4) ? "text-danger" : "text-success") : "")">@row.Comp4</td>

                            <td class="@(row.Comp5 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp5) ? "text-danger" : "text-success") : "")">@row.Comp5</td>

                            <td class="@(row.Comp6 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp6) ? "text-danger" : "text-success") : "")">@row.Comp6</td>

                            <td class="@(row.Comp7 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp7) ? "text-danger" : "text-success") : "")">@row.Comp7</td>

                            <td class="@(row.Comp8 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp8) ? "text-danger" : "text-success") : "")">@row.Comp8</td>

                            <td class="@(row.Comp9 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp9) ? "text-danger" : "text-success") : "")">@row.Comp9</td>

                            <td class="@(row.Comp10 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp10) ? "text-danger" : "text-success") : "")">@row.Comp10</td>


                            @if(noofsamples == 15)
                            {
                                <td class="@(row.Comp11 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp11) ? "text-danger" : "text-success") : "")">@row.Comp11</td>

                                <td class="@(row.Comp12 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp12) ? "text-danger" : "text-success") : "")">@row.Comp12</td>

                                <td class="@(row.Comp13 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp13) ? "text-danger" : "text-success") : "")">@row.Comp13</td>

                                <td class="@(row.Comp14 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp14) ? "text-danger" : "text-success") : "")">@row.Comp14</td>

                                <td class="@(row.Comp15 != null ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp15) ? "text-danger" : "text-success") : "")">@row.Comp15</td>
                            }
                            <td>@row.Instrument</td>
                            <td>@row.DefectName</td>
                            <td>@row.Remark</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex gap-2 justify-content-end">
        <a href="/FinalInspection" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle"></i> Back To List
        </a>
        <a href="@($"/FinalInspection/update/{InspectionId}")" class="btn btn-outline-primary">
            <i class="bi bi-pencil-square"></i> Modify
        </a>
        <button class="btn btn-outline-success" onclick="window.print()">
            <i class="bi bi-printer"></i> Print
        </button>
    </div>
</div>
    }
}
@code {

    protected override string ScreenName => "FinalInspection";

    [Parameter] public int InspectionId { get; set; }

    private bool isProcessing = true;
    private FinalInspectionVM InspectionVM = new();
    private List<InspectionRowVM> InspectionRows = new();
    private int noofsamples = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();

            if (!CanView)
            {
                _nav.NavigateTo("/access-denied");
                return;
            }
            noofsamples = await finalInspectionService.GetNoOfSamples();

            await LoadInspection();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error loading Final Inspection details");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadInspection()
    {
        try
        {
            var result = await finalInspectionService.GetInspectionByIdAsync(InspectionId);

            if (result == null)
            {
                await js.ToastrWarning("Inspection not found.");
                return;
            }

            InspectionVM = result;

            // Converting Json data to Dimensions
            InspectionRows = string.IsNullOrWhiteSpace(InspectionVM.InspectData) ? new List<InspectionRowVM>()
                    : JsonSerializer.Deserialize<List<InspectionRowVM>>(InspectionVM.InspectData)
                        ?? new List<InspectionRowVM>();
        }
        catch(Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error loading LoadInspection() details");
            await js.ToastrWarning("Error in LoadInspection()");
        }
    }

    private bool IsOutOfRange(decimal? dim, decimal? lo, decimal? hi, string val)
    {
        try
        {
            if (!decimal.TryParse(val, out var num)) return false;
            if (!dim.HasValue || !lo.HasValue || !hi.HasValue) return false;

            var min = dim.Value - Math.Abs(lo.Value);
            var max = dim.Value + hi.Value;

            return num < min || num > max;
        }
        catch(Exception ex)
        {
            logs.LogDeveloperError(ex, "Error loading IsOutOfRange() details");
            js.ToastrWarning("Error in IsOutOfRange()");
            return false;
        }
    }
}
