    #endregion

    #region Initialization
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            FinalInspectionVM.InspectDate = DateTime.Now;
            noofsamples = await FinalInspectionService.GetNoOfSamples();
            InstrumentList = await FinalInspectionService.GetAllInstrumentsAsync();
            AllDefectInfoList = await FinalInspectionService.GetAllActiveDefectsAsync();
            AllCustomers = await FinalInspectionService.GetAllActiveCustomersAsync();
            AllcostCenterVMs = await FinalInspectionService.GetAllCostCenterDetails();
            AllItems = await FinalInspectionService.GetAllComponentsAsync();
            AllStaff = await FinalInspectionService.GetAllStaffAsync();
            FinalInspectionVM.InspectNo = await FinalInspectionService.GenerateNewInspectionNoAsync(Mode == InspectionMode.Random ? "Random" : "Individual");
            FinalInspectionVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            FinalInspectionVM.SheetSlNo = 0;
            if (InspectId > 0)
            {
                await LoadExistingInspect(InspectId);
                if (noofsamples == 15)
                {
                    int? SheetSlNo = FinalInspectionVM.SheetSlNo;
                    int? start = (SheetSlNo - 1) * 15 + 1;
                    int? end = SheetSlNo * 15;
                    FinalInspectionVM.SheetName = $"Sheet-{SheetSlNo} ({start}-{end})";
                }
                else
                {
                    int? SheetSlNo = FinalInspectionVM.SheetSlNo;
                    int? start = (SheetSlNo - 1) * 10 + 1;
                    int? end = SheetSlNo * 10;
                    FinalInspectionVM.SheetName = $"Sheet-{SheetSlNo} ({start}-{end})";
                }
                IsEditingMode = true;
                IsSheetEditable = true;
                IsnotDc = false;

            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
            await _js.InvokeVoidAsync("alert", "An error occurred while loading the page. Please try again later.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
    #endregion

    #region to Load Existing Inspection
    private async Task LoadExistingInspect(int? InspectId)
    {
        try
        {
            if (InspectId == null || InspectId <= 0)
            {
                await _js.ToastrWarning("Invalid Inspection Id.");
                return;
            }
            FinalInspectionVM = await FinalInspectionService.GetInspectionByIdAsync(InspectId.Value);

            if (FinalInspectionVM.IsRandom == false)
            {
                Mode = InspectionMode.Individual;
            }

            // Converting Json data to Dimensions
            InspectionData = string.IsNullOrWhiteSpace(FinalInspectionVM.InspectData) ? new List<InspectionRowVM>()
                    : JsonSerializer.Deserialize<List<InspectionRowVM>>(FinalInspectionVM.InspectData)
                        ?? new List<InspectionRowVM>();
            if (FinalInspectionVM == null)
            {
                await _js.ToastrWarning("Inspection not found.");
                return;
            }

        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing Inspection.");
            await LoggingService.LogDeveloperError(ex, $"LoadExisting Data failed for Inspection Id: {InspectId}");
        }
    }
