            FinalInspectionVM.DCNo = selecteddc.DcNo;
            if (selecteddc != null)
            {
                // Update only the required fields → Do NOT replace object
                FinalInspectionVM.CustId = selecteddc.CustId;
                FinalInspectionVM.DcDate = selecteddc.DcDate;
                FinalInspectionVM.CustomerName = selecteddc.CustName;
                dcSubVMList = selecteddc.MfgDcSubVMs;
