@page "/FinalInspection/create"
@page "/FinalInspection/update/{InspectId:int}"

@using System.Text.Json
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IInspectionService
@using V.SMART.Shared.Data.SalesAndLabour.SalesDC
@using V.SMART.Shared.ViewModels.InspectionViewModel.FinalInspectionVM
@using V.SMART.Shared.ViewModels.InspectionViewModel.MasterInspectionVM
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.SalesDCVM
@using Microsoft.AspNetCore.Components.Forms

@inherits BaseUserRightsComponent
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject IFinalInspectionService FinalInspectionService
@inject ILoggingService LoggingService


@if (isProcessing)
{
    <div class="position-fixed top-50 start-50 translate-middle d-flex align-items-center justify-content-center"
         style="width: 100vw; height: 100vh; background-color: rgba(255,255,255,0.5); z-index: 1050;">
        <img src="/_content/V.SMART.Shared/images/loading.gif" alt="Loading..." />
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-3 px-md-5 mt-4">

        <div class="card shadow-sm border-0">

            <PageHeader TitleText="@(FinalInspectionVM.Id > 0 ? "Update Inspection" : "Create Inspection")"
                        TitleIcon="bi bi-clipboard-check"
                        Breadcrumbs="@ScreenBreadcrumbs" />

            <EditForm Model="FinalInspectionVM" OnValidSubmit="SaveInspection">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <!-- 🔀 Inspection Type Toggle -->
                <div class="d-flex justify-content-center my-3">
                    <div class="btn-group shadow-sm rounded-pill">
                        <button type="button"
                                class="btn px-4 py-2 rounded-start-pill
                                            @(Mode == InspectionMode.Random ? "btn-primary" : "btn-outline-primary")"
                                @onclick="RandomInspectionClick">
                            <i class="bi bi-shuffle me-1"></i>
                            Random Inspection
                        </button>

                        <button type="button"
                                class="btn px-4 py-2 rounded-end-pill
                                            @(Mode == InspectionMode.Individual ? "btn-primary" : "btn-outline-primary")"
                                @onclick="IndividualInspectionClick">
                            <i class="bi bi-person-check me-1"></i>
                            Individual Inspection
                        </button>
                    </div>
                </div>
                <div class="row g-3 px-3">

                    <div class="col-12 col-lg-6 mb-2">
                        <div class="card h-100 shadow-sm">

                            <div class="card-header bg-primary-subtle fw-bold">
                                Customer And Item Details
                            </div>

                            <div class="card-body">

                                <!-- DC Type -->
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">
                                        DC Type <span class="text-danger">*</span>
                                    </label>
                                    <div class="col-sm-9">
                                        <select class="form-select form-select-sm border-primary"
                                                value="@FinalInspectionVM.DcType"
                                                @onchange="GetDcNos">
                                            <option value="">-- Select --</option>
                                            <option value="Manufacturing">Manufacturing</option>
                                            <option value="Labour">Labour</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- DC No -->
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">
                                        DC No <span class="text-danger">*</span>
                                    </label>

                                    <div class="col-sm-9">
                                        <div class="input-group input-group-sm">

                                            @if (!IsAddNewDC)
                                            {
                                                @if (!IsEditingMode)
                                                {
                                                    <!-- SELECT EXISTING DC -->
                                                    <select class="form-select"
                                                            value="@FinalInspectionVM.DcId" @onchange="OnTextOrSelectChange">
                                                        <option value="">-- Select DC No --</option>
                                                        @foreach (var detail in DcNoList)
                                                        {
                                                            <option value="@detail.DcId">@detail.DcNo</option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control" @bind-value=FinalInspectionVM.DCNo readonly />
                                                }
                                            }
                                            else
                                            {
                                                @if (!IsEditingMode)
                                                {
                                                    <!-- ADD NEW DC -->
                                                    <input type="text" class="form-control border-primary" placeholder="Enter new DC No" @bind-Value="FinalInspectionVM.DCNo"
                                                           @bind-Value:event="oninput" @onchange="OnTextBoxTyping" />
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control" @bind-value=FinalInspectionVM.DCNo />
                                                }
                                            }
                                            @if (!IsEditingMode)
                                            {
                                                <!-- TOGGLE BUTTON -->
                                                <button class="btn btn-outline-primary"
                                                        type="button"
                                                        title="Add new DC"
                                                        @onclick="ToggleAddNewDC">
                                                    <i class="bi @(IsAddNewDC ? "bi-x-lg" : "bi-plus-lg")"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- PO No -->
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">PO No</label>
                                    <div class="col-sm-9">
                                        <InputText class="form-control form-control-sm"
                                                   @bind-value="FinalInspectionVM.PONo" />
                                    </div>
                                </div>

                                <!-- Customer -->
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">Customer</label>
                                    <div class="col-sm-9">
                                        @if (!string.IsNullOrEmpty(FinalInspectionVM.CustomerName))
                                        {
                                            <InputText class="form-control form-control-sm bg-light"
                                                       @bind-Value="FinalInspectionVM.CustomerName"
                                                       readonly />
                                        }
                                        else
                                        {
                                            <select class="form-select form-select-sm"
                                                    @bind="FinalInspectionVM.CustId">
                                                <option value="">-- Select Customer --</option>
                                                @foreach (var customer in AllCustomers)
                                                {
                                                    <option value="@customer.CustId">@customer.CustName</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                </div>

                                <!-- Item Code -->
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">
                                        Item Code <span class="text-danger">*</span>
                                    </label>
                                    <div class="col-sm-9">
                                        @if (IsEditingMode)
                                        {
                                            <input type="text"
                                                   class="form-control form-control-sm rounded-3"
                                                   @bind-value="FinalInspectionVM.ItemCode"
                                                   readonly />
                                        }

                                        @if (IsnotDc)
                                        {
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value=@FinalInspectionVM.ItemId @onchange="OnItemCodeChanged">

                                                <option value="">--Select Item Code--</option>

                                                @foreach (var item in AllItems)
                                                {
                                                    <option value="@item.ItemId">@item.ItemCode</option>
                                                }
                                            </select>
                                        }
                                        @if (!IsnotDc && !IsEditingMode)
                                        {
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value=@FinalInspectionVM.RefMfgDcSubID @onchange="OnItemCodeChanged">
                                                <option value="">--Select Item Code--</option>

                                                @foreach (var item in dcSubVMList)
                                                {
                                                    <option value="@item.DcSubId">@item.ItemCode</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                </div>

                                <!-- Item Name & Cost Centre -->
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">Item Name</label>
                                    <div class="col-sm-9">
                                        <InputText class="form-control form-control-sm bg-light"
                                                   @bind-Value="FinalInspectionVM.ItemName" />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">Cost Centre</label>
                                    <div class="col-sm-9">
                                        <InputSelect class="form-select form-select-sm"
                                                     @bind-Value="FinalInspectionVM.CostCenter">
                                            <option value="">-- Select Cost Center --</option>

                                            @foreach (var center in AllcostCenterVMs)
                                            {
                                                <option value="@center.CostCenterName">
                                                    @center.CostCenterName
                                                </option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>

                                <!-- Inspected By -->
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">Inspected By</label>
                                    <div class="col-sm-9">
                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                @bind="@FinalInspectionVM.InspectBy">
                                            <option value="">-- Select Staff --</option>
                                            @foreach (var staff in AllStaff)
                                            {
                                                <option value="@staff.StaffName">@staff.StaffName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 mb-2">
                        <div class="card h-100 shadow-sm">

                            <!-- Header -->
                            <div class="card-header bg-primary-subtle fw-bold">
                                Inspection Details
                            </div>

                            <div class="card-body">

                                <!-- Inspection No -->
                                <div class="mb-2 row">
                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                        <small>Inspection No</small>
                                    </label>
                                    <div class="col-12 col-sm-9">
                                        <div class="input-group input-group-sm w-100 rounded-3">
                                            <InputText class="form-control form-control-sm rounded-3"
                                                       placeholder="Inspection No"
                                                       maxlength="30"
                                                       @bind-Value="@FinalInspectionVM.InspectNo" />
                                            <span class="input-group-text rounded-3">@FinalInspectionVM.Suffix</span>
                                        </div>
                                        <ValidationMessage For="@(() => FinalInspectionVM.InspectNo)" />
                                    </div>
                                </div>

                                <!-- Inspection Date -->
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">
                                        Inspection Date
                                    </label>

                                    <div class="col-sm-9">
                                        <InputDate class="form-control form-control-sm"
                                                   @bind-Value="FinalInspectionVM.InspectDate" />
                                        <ValidationMessage For="@(() => FinalInspectionVM.InspectDate)" />
                                    </div>
                                </div>

                                <!-- DC Qty -->
                                <div class="row mb-2 align-items-center">
                                    <div class="col-12 col-md-6">
                                        <div class="row align-items-center">
                                            <label class="col-6 col-form-label">
                                                DC Qty <span class="text-danger">*</span>
                                            </label>
                                            <div class="col-6">
                                                @if (IsnotDc)
                                                {
                                                    <input type="number" class="form-control form-control-sm text-end" step="any"
                                                           @bind-value="FinalInspectionVM.Qty" @bind-value:event="oninput" @onchange="GenerateAllSheets" />
                                                }
                                                else
                                                {
                                                    <input type="number" class="form-control form-control-sm text-end" step="any"
                                                           @bind-value="FinalInspectionVM.Qty" readonly="@IsEditingMode" />
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Item UOM -->
                                    <div class="col-12 col-md-6">
                                        <div class="row align-items-center">
                                            <label class="col-6 col-form-label text-nowrap">
                                                Item Units
                                            </label>
                                            <div class="col-6">
                                                <InputText class="form-control form-control-sm"
                                                           @bind-Value="FinalInspectionVM.ItemUOM"
                                                           readonly />
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">

                                    <!-- Accept Qty -->
                                    <div class="col-12 col-md-6">
                                        <div class="row align-items-center">
                                            <label class="col-6 col-form-label text-success fw-semibold text-nowrap">
                                                Accept Qty
                                            </label>
                                            <div class="col-6">
                                                <InputNumber class="form-control form-control-sm text-end border-success"
                                                             @bind-Value="FinalInspectionVM.AcceptQty" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Rework Qty -->
                                    <div class="col-12 col-md-6">
                                        <div class="row align-items-center">
                                            <label class="col-6 col-form-label fw-semibold text-nowrap" style="color:slateblue;">
                                                Rework Qty
                                            </label>
                                            <div class="col-6">
                                                <InputNumber class="form-control form-control-sm  fw-semibold" style="border-color:slateblue;"
                                                             @bind-Value="FinalInspectionVM.ReWork" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Reject Qty -->
                                <div class="row mb-2 align-items-center">
                                    <div class="col-12 col-md-6">
                                        <div class="row align-items-center">
                                            <label class="col-6 col-form-label fw-semibold text-nowrap" style="color:#FF1D8D;">
                                                Reject Qty
                                            </label>
                                            <div class="col-6">
                                                <InputNumber class="form-control form-control-sm text-end"
                                                             style="border-color:#FF1D8D;"
                                                             @bind-Value="FinalInspectionVM.RejQty" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @if (Mode == InspectionMode.Individual)
                                {
                                    <!-- Select Sheet -->
                                    <div class="row mb-2 align-items-center">
                                        <label class="col-sm-3 col-form-label">
                                            Sheet <span class="text-danger">*</span>
                                        </label>
                                        <div class="col-sm-9">
                                            @if (IsSheetEditable)
                                            {
                                                <InputText class="form-control form-control-sm bg-light"
                                                           @bind-Value="FinalInspectionVM.SheetName"
                                                           readonly />
                                            }
                                            else
                                            {
                                                <select class="form-select form-select-sm rounded-3 w-100"
                                                        @bind="FinalInspectionVM.SheetSlNo"
                                                        @bind:event="onselect"
                                                        @onchange="LoadTableheadings">

                                                    <option value="">-- Select Sheet --</option>

                                                    @foreach (var sheet in SheetList)
                                                    {
                                                        <option value="@sheet.SheetSlNo">@sheet.SheetName</option>
                                                    }
                                                </select>

                                            }
                                        </div>
                                    </div>
                                }

                                <!-- Remarks -->
                                <div class="row mb-2 align-items-center">
                                    <label class="col-sm-3 col-form-label">
                                        Remarks
                                    </label>

                                    <div class="col-sm-9">
                                        <textarea class="form-control form-control-sm rounded-3"
                                                  rows="1"
                                                  @bind="FinalInspectionVM.Remarks"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= DIMENSION TABLE ================= -->
                <div class="row g-3 px-3">
                    <div class="col-12">
                        <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                            <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                <span class="fw-bold fs-6">Inspection Dimensions</span>
                            </div>
                            <div class="card-body px-1 py-1 bg-light">

                                <div class="table-responsive" style="overflow-x:auto">
                                    <table class="table table-bordered table-sm text-center align-middle mb-0" style="min-width:2000px;">
                                        <thead class="table-info align-middle">
                                            <tr class="text-center fw-semibold" style="font-size:13px;">
                                                <th style="width:60px;">Sl No.</th>
                                                <th style="width:120px;">Description</th>
                                                <th style="width:70px;">Dimens</th>
                                                <th style="width:90px;white-space:nowrap;">Lo Tol</th>
                                                <th style="width:90px; white-space:nowrap;">Hi Tol</th>

                                                @if (Mode == InspectionMode.Individual)
                                                {
                                                    @for (int i = 1; i <= noofsamples; i++)
                                                    {
                                                        <th style="width:70px; white-space:nowrap;">
                                                            Sample @(((SelectedSheetNo - 1) * noofsamples) + i)
                                                        </th>
                                                    }
                                                }
                                                else
                                                {
                                                    @for (int i = 1; i <= noofsamples; i++)
                                                    {
                                                        <th style="width:70px; white-space:nowrap;">
                                                            Sample @i
                                                        </th>
                                                    }
                                                }

                                                <th style="width:90px;">Instrument</th>
                                                <th style="width:90px;">Defect Name</th>
                                                <th style="width:90px;">Remarks</th>
                                                <th style="width:80px;" class="text-end">Action</th>
                                            </tr>
                                        </thead>



                                        <tbody>
                                            @foreach (var row in InspectionData)
                                            {
                                                <tr @key="row.RowId">

                                                    @if (row.IsEditable)
                                                    {

                                                        <td class="bg-warning-subtle text-center">
                                                            <input type="number" class="form-control form-control-sm"
                                                                   @bind-value="row.SlNo" readonly />
                                                        </td>

                                                        <td class="bg-warning-subtle">
                                                            <input class="form-control form-control-sm"
                                                                   @bind="row.Desc" />
                                                        </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="number" class="form-control form-control-sm" step="any"
                                                                   @bind="row.Dimens" />
                                                        </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="number" class="form-control form-control-sm" step="any"
                                                                   @bind="row.LoTol" />
                                                        </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="number" class="form-control form-control-sm" step="any"
                                                                   @bind="row.HiTol" />
                                                        </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                    @(row.Comp1 != null
                                                                                                                                                           ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp1)
                                                                                                                                                               ? "text-danger"
                                                                                                                                                               : "text-success")
                                                                                                                                                           : "")"
                                                                                                                                                                @bind="row.Comp1" />
                                                                                                                                                     </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                    @(row.Comp2 != null
                                                                                                                                                           ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp2)
                                                                                                                                                               ? "text-danger"
                                                                                                                                                               : "text-success")
                                                                                                                                                           : "")"
                                                                                                                                                                @bind="row.Comp2" />
                                                                                                                                                     </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                   @(row.Comp3 != null
                                                                                                                                                       ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp3)
                                                                                                                                                           ? "text-danger"
                                                                                                                                                           : "text-success")
                                                                                                                                                       : "")"
                                                                                                                                                            @bind="row.Comp3" />
                                                                                                                                                 </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                    @(row.Comp4 != null
                                                                                                                                                           ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp4)
                                                                                                                                                               ? "text-danger"
                                                                                                                                                               : "text-success")
                                                                                                                                                           : "")"
                                                                                                                                                                @bind="row.Comp4" />
                                                                                                                                                     </td>


                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                    @(row.Comp5 != null
                                                                                                                                                           ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp5)
                                                                                                                                                               ? "text-danger"
                                                                                                                                                               : "text-success")
                                                                                                                                                           : "")"
                                                                                                                                                                @bind="row.Comp5" />
                                                                                                                                                     </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                                    @(row.Comp6 != null
                                                                                                                                                                           ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp6)
                                                                                                                                                                               ? "text-danger"
                                                                                                                                                                               : "text-success")
                                                                                                                                                                           : "")"
                                                                                                                                                                                @bind="row.Comp6" />
                                                                                                                                                                     </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                                @(row.Comp7 != null
                                                                                                                                                                       ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp7)
                                                                                                                                                                           ? "text-danger"
                                                                                                                                                                           : "text-success")
                                                                                                                                                                       : "")"
                                                                                                                                                                            @bind="row.Comp7" />
                                                                                                                                                                 </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                    @(row.Comp8 != null
                                                                                                                                                           ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp8)
                                                                                                                                                               ? "text-danger"
                                                                                                                                                               : "text-success")
                                                                                                                                                           : "")"
                                                                                                                                                                @bind="row.Comp8" />
                                                                                                                                                     </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                    @(row.Comp9 != null
                                                                                                                                                           ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp9)
                                                                                                                                                               ? "text-danger"
                                                                                                                                                               : "text-success")
                                                                                                                                                           : "")"
                                                                                                                                                                @bind="row.Comp9" />
                                                                                                                                                     </td>

                                                        <td class="bg-warning-subtle">
                                                            <input type="text"
                                                                   inputmode="decimal"
                                                                   class="form-control form-control-sm text-center
                                                                                                    @(row.Comp10 != null
                                                                                                                                                           ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp10)
                                                                                                                                                               ? "text-danger"
                                                                                                                                                               : "text-success")
                                                                                                                                                           : "")"
                                                       @bind="row.Comp10" />
                                            </td>
                                            @if (noofsamples == 15)
                                                        {

                                                            <td class="bg-warning-subtle">
                                                                <input type="text"
                                                                       inputmode="decimal"
                                                                       class="form-control form-control-sm text-center
                                                                                                                                        @(row.Comp11 != null
                                                                                                                                                                                               ? (IsOutOfRange(row.Dimens, row.LoTol, row.HiTol, row.Comp11)
                                                                                                                                                                                                   ? "text-danger"
                                                                                                                                                                                                   : "text-success")
                                                                                                                                                                                               : "")"
