                {
                    FinalInspectionVM.RefMfgDcSubID = selecteddc.MfgDcSubVMs[0].DcSubId;
                    FinalInspectionVM.ItemCode = selecteddc.MfgDcSubVMs[0].ItemCode;
                    FinalInspectionVM.ItemName = selecteddc.MfgDcSubVMs[0].ItemName;
                    FinalInspectionVM.ItemId = selecteddc.MfgDcSubVMs[0].ItemId;
                    FinalInspectionVM.PONo = selecteddc.MfgDcSubVMs[0].RefPoNo;
                    FinalInspectionVM.Qty = selecteddc.MfgDcSubVMs[0].Qty;
                    FinalInspectionVM.ItemUOM = selecteddc.MfgDcSubVMs[0].MeasureUnit;
                    if (Mode == InspectionMode.Individual)
                    {
                        await GenerateSheets(FinalInspectionVM.Qty);
                    }
                    InspectionData = await FinalInspectionService.GetInspectionRowVMsAsync(FinalInspectionVM.ItemId ?? 0);

                }
                else if (selecteddc.MfgDcSubVMs.Count > 1)
                {
                    IsnotDc = false;
