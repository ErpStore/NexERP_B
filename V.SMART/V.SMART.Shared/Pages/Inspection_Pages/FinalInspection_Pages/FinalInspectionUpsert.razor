    #endregion

    #region On Item Code Change
    private async Task OnItemCodeChanged(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out int DcSubId))
            {
                if (IsnotDc)
                {
                    var selectedItem = AllItems.FirstOrDefault(x => x.ItemId == DcSubId);
                    if (selectedItem != null)
                    {
                        FinalInspectionVM.ItemCode = selectedItem.ItemCode;
                        FinalInspectionVM.ItemName = selectedItem.ItemName;
                        FinalInspectionVM.ItemUOM = selectedItem.MeasureUnit;
                    }
                }
                else
                {
                    var selectedItem = dcSubVMList.FirstOrDefault(x => x.DcSubId == DcSubId);
                    if (selectedItem != null)
                    {
                        FinalInspectionVM.RefMfgDcSubID = selectedItem.DcSubId;
                        FinalInspectionVM.ItemId = selectedItem.ItemId;
                        FinalInspectionVM.ItemCode = selectedItem.ItemCode;
                        FinalInspectionVM.ItemName = selectedItem.ItemName;
                        FinalInspectionVM.ItemUOM = selectedItem.MeasureUnit;
                        FinalInspectionVM.PONo = selectedItem.RefPoNo;
                        FinalInspectionVM.Qty = selectedItem.Qty;
                        dcQty = selectedItem.Qty;
                        @if (Mode == InspectionMode.Individual)
                        {
                            await GenerateSheets(selectedItem.Qty);
                        }
                    }
                }


                InspectionData = await FinalInspectionService.GetInspectionRowVMsAsync(DcSubId);

            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnItemCodeChanged failed to Load");
            await _js.InvokeVoidAsync("alert", "An error occurred in OnItemCodeChanged method");
        }
    }
    #endregion

    #region GET DC Nos
    private async Task GetDcNos(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            var selectedValue = e.Value?.ToString();
            if (string.IsNullOrEmpty(selectedValue))
                return;
            InspectionData = new List<InspectionRowVM>();
            SheetList = new List<SheetVM>();
            FinalInspectionVM = await FinalInspectionService.ClearInspection(FinalInspectionVM);
            FinalInspectionVM.DcType = selectedValue;
            if (selectedValue == "Manufacturing")
            {
                //Taking All Dcs from Manufaturing
                DcNoList = (await FinalInspectionService.GetAllDcDetailsAsync()).ToList();
            }
            else
            {
                //Mode = InspectionMode.Individual;
            }
            isProcessing = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            isProcessing = false;
            await LoggingService.LogDeveloperError(ex, "GetDcNos failed.");
            await _js.ToastrError("An error occurred while loading DC Nos. Please try again.");
        }
    }
    #endregion

    #region Edit Row
    private async Task EditRowAsync(InspectionRowVM item)
    {
        try
        {
            item.IsEditable = true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for Inspection");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    #endregion

    #region On Entering Dc or Selecting the Dc No
    private async Task OnTextOrSelectChange(ChangeEventArgs e)
    {
        try
        {
            InspectionData = new List<InspectionRowVM>();
            SheetList = new List<SheetVM>();
            FinalInspectionVM = await FinalInspectionService.ClearInspection(FinalInspectionVM);
            var DcId = Convert.ToInt32(e.Value);
            FinalInspectionVM.DcId = DcId;
