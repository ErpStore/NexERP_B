    #region  Load Table headings
    public async Task LoadTableheadings(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out int sheetno))
            {
                FinalInspectionVM.SheetSlNo = sheetno;
                SelectedSheetNo = sheetno;
                if (noofsamples == 15)
                {
                    int? SheetSlNo = sheetno;
                    int? start = (SheetSlNo - 1) * 15 + 1;
                    int? end = SheetSlNo * 15;
                    FinalInspectionVM.SheetName = $"Sheet-{SheetSlNo} ({start}-{end})";
                }
                else
                {
                    int? SheetSlNo = sheetno;
                    int? start = (SheetSlNo - 1) * 10 + 1;
                    int? end = SheetSlNo * 10;
                    FinalInspectionVM.SheetName = $"Sheet-{SheetSlNo} ({start}-{end})";
                }

            }

            await InvokeAsync(StateHasChanged);

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error Occured in LoadTableheadings()");
            await _js.ToastrError("Error Occured in LoadTableheadings()");
        }
    }
