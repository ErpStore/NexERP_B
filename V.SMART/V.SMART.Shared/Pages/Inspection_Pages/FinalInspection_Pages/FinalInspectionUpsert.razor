    #region Checking Dimensions Out of Range
    private bool IsOutOfRange(decimal? dim, decimal? lo, decimal? hi, String? comp)
    {
        if (!decimal.TryParse(comp, out var number))
            return false; // ignore text values
        if (!dim.HasValue || !lo.HasValue || !hi.HasValue)
            return false;
        var min = dim.Value - Math.Abs(lo.Value);
        var max = dim.Value + hi.Value;

        return number < min || number > max;
    }
    #endregion

    #region Saving the current row
    private async Task SaveRow(InspectionRowVM row)
    {
        try
        {
            if (!await ValidateLastRowAsync())
            {
                return;
            }
            row.IsEditable = false;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "SaveRow failed for Dimensions");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }
    #endregion

    #region Save Inspection
    private async Task SaveInspection()
    {
        try
        {
            isProcessing = true;
            if (!await Validation())
            {
                return;
            }

            bool isValid = await ValidateLastRowAsync();
            if (!isValid) return;

            var qty = FinalInspectionVM.Qty ?? 0;
            var acc = FinalInspectionVM.AcceptQty ?? 0;
            var rej = FinalInspectionVM.RejQty ?? 0;
            var rework = FinalInspectionVM.ReWork ?? 0;
            var errors = new List<string>();
            if (!FinalInspectionVM.AcceptQty.HasValue || acc < 0)
                errors.Add("Please enter the Accepted Quantity");

            if (rej < 0)
                errors.Add("Rejected Quantity cannot be negative");

            if (rework < 0)
                errors.Add("Rework Quantity cannot be negative");

            if (acc + rej + rework == 0)
                errors.Add("Enter at least one accepted quantity");

            if (acc + rej + rework > qty)
                errors.Add("Accepted + Rejected + Rework quantity cannot exceed DC Quantity");

            if (acc + rej + rework < qty)
                errors.Add("Accepted Quantity cannot be Lesser than DC Quantity");

            if (FinalInspectionVM.Qty > dcQty)
                errors.Add("Qty should not be more than Dc Quantity");

            if (FinalInspectionVM.Qty > dcQty)
                errors.Add("Qty should not be more than Dc Quantity");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrWarning(message);
                return;
            }

            if (FinalInspectionVM.InspectBy == null || FinalInspectionVM.InspectBy == "")
            {
                await _js.ToastrError("Please select the Inspected By field.");
                return;
            }

            if (!InspectionData.Any())
            {
                await _js.ToastrError("Cannot save a Inspection without valid Dimensions.");
                return;
            }

            // Save
            FinalInspectionVM.IsRandom = Mode == InspectionMode.Random ? true : false;
            FinalInspectionVM.TotRows = InspectionData.Count;
            FinalInspectionVM.BalQty = (FinalInspectionVM.Qty ?? 0)
                                        - ((FinalInspectionVM.RejQty ?? 0)
                                        + (FinalInspectionVM.ReWork ?? 0)
                                        + (FinalInspectionVM.AcceptQty ?? 0));
            var isNewInspect = FinalInspectionVM.Id == 0;
            if (isNewInspect)
            {
                var isDuplicate = await FinalInspectionService.CheckDuplicateRandom(FinalInspectionVM.InspectNo, Mode == InspectionMode.Random ? "Random" : "Individual", FinalInspectionVM.Suffix);

                if (isDuplicate)
                {
                    var msg = Mode == InspectionMode.Random
                        ? "A Random Inspection already exists. Cannot create duplicate."
                        : "An Individual Inspection already exists. Cannot create duplicate.";

                    await _js.ToastrError(msg);
                    return;
                }
            }

            string jsonData = JsonSerializer.Serialize(InspectionData);
            FinalInspectionVM.InspectData = jsonData;
            try
            {
                await FinalInspectionService.UpsertInspectAsync(FinalInspectionVM);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewInspect)
            {
                await _js.ToastrSuccess("Inspection saved successfully.");
            }
            else
            {
                await _js.ToastrSuccess("Inspection updated successfully.");
            }

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/FinalInspection");

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Upsert Final-Inspection failed.");
            await _js.ToastrError("Error in saving Final-Inspection.");
        }

        finally
        {
            isProcessing = false;
        }
    }
    #endregion

    #region Add New Row
    private async Task AddRow()
    {
        try
        {
            if (!await Validation())
            {
                return;
            }

            if (!await ValidateLastRowAsync())
            {
                return;
            }
            var row = new InspectionRowVM
            {
                SlNo = InspectionData.Count + 1,
                IsEditable = true
            };

            InspectionData = InspectionData.Append(row).ToList();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await LoggingService.LogDeveloperError(ex, "AddRow failed.");
        }
    }
    #endregion

    #region Validate Last Row
    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = InspectionData.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateRowAsync(InspectionRowVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.SlNo <= 0)
                errors.Add("Invalid serial number");

            if (string.IsNullOrWhiteSpace(row.Desc) || row.Desc.Length < 2)
                errors.Add("Description is required");

            if (row.Dimens.HasValue && row.LoTol.HasValue && row.HiTol.HasValue)
            {
                var min = row.Dimens.Value - Math.Abs(row.LoTol.Value);
                var max = row.Dimens.Value + row.HiTol.Value;

                if (min > max)
                    errors.Add("Invalid tolerance range");
            }
            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrWarning(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }
    #endregion

    #region validations
    private async Task<bool> Validation()
    {
        try
        {
            var errors = new List<string>();
            if (String.IsNullOrEmpty(FinalInspectionVM.DcType))
            {
                await _js.ToastrWarning("Please Select the DC Type");
                return false;
            }

            if (String.IsNullOrEmpty(FinalInspectionVM.DCNo))
            {
                errors.Add("Please Select the DC No");
            }

            if (String.IsNullOrEmpty(FinalInspectionVM.ItemCode))
            {
                errors.Add("Please Select the Item");
            }
            if (!FinalInspectionVM.Qty.HasValue || FinalInspectionVM.Qty <= 0)
                errors.Add("Please enter the DC Quantity");

            if (Mode == InspectionMode.Individual)
            {
                if (FinalInspectionVM.SheetSlNo <= 0)
                {
                    errors.Add("Please Select Sheet");
                }
            }
            else
            {
                FinalInspectionVM.SheetSlNo = 0;
            }

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrWarning(message);
                return false;
            }
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating rows.");
            await LoggingService.LogDeveloperError(ex, "Validation failed.");
            return false;
        }
    }
    #endregion

    #region Cancel OR Edit Row
    private async Task CancelEdit(InspectionRowVM? row)
    {
        try
        {

            InspectionData = InspectionData
           .Where(r => r.RowId != row.RowId)
           .ToList();

            ResetSlNo();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for Inspection");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }
    #endregion

    #region Removing a Row
    private async Task RemoveRow(InspectionRowVM item)
    {
        try
        {
            if (InspectionData.Count == 1)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }
            InspectionData.Remove(item);
            await _js.ToastrSuccess("item row removed successfully.");

            if (!InspectionData.Any())
                InspectionData = new List<InspectionRowVM>();

            await ResetSlNo();
            StateHasChanged();
            return;

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for Inspection");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }
    #endregion

    #region Resetting SlNo
    private async Task ResetSlNo()
    {
        try
        {

            int i = 1;
            foreach (var r in InspectionData)
                r.SlNo = i++;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to reset row serial numbers.");
        }
    }
    #endregion

    #region Generate Sheets
    private async Task GenerateSheets(decimal? Qty)
    {
        try
        {
            isProcessing = true;
            if (Qty == null || Qty <= 0)
            {
                SheetList.Clear();
                await _js.ToastrInfo("Please enter a valid Quantity to generate Sheets.");
                SelectedSheetNo = 0;
                isProcessing = false;
                return;
            }

            if (Qty <= 15)
            {
                if (noofsamples == 15)
                {
                    SheetList.Clear();
                    SheetList.Add(new SheetVM
                    {
                        SheetSlNo = 1,
                        SheetName = "Sheet-1 (1-" + 15 + ")"
                    });
                }
                else
                {
                    SheetList.Clear();
                    SheetList.Add(new SheetVM
                    {
                        SheetSlNo = 1,
                        SheetName = "Sheet-1 (1-" + 10 + ")"
                    });

                }
            }
            else
            {
                SheetList.Clear();

                int qty = (int)(Qty ?? 0);

                if (qty <= 0)
                {
                    SelectedSheetNo = 0;
                    return;
                }
                int totalSheets = 0;
                if (noofsamples == 15)
                {
                    totalSheets = (int)Math.Ceiling(qty / 15.0);
                }
                else
                {
                    totalSheets = (int)Math.Ceiling(qty / 10.0);
                }

                for (int sheetNo = 1; sheetNo <= totalSheets; sheetNo++)
                {
                    int start = ((sheetNo - 1) * 15) + 1;
                    int end = Math.Min(sheetNo * 15, qty); // IMPORTANT

                    SheetList.Add(new SheetVM
                    {
                        SheetSlNo = sheetNo,
                        SheetName = $"Sheet-{sheetNo} ({start}-{end})"
                    });
                }
            }
            isProcessing = false;
        }
        catch (Exception ex)
        {
            isProcessing = false;
            await LoggingService.LogDeveloperError(ex, "GenerateSheets failed.");
            await _js.ToastrError("Failed to Generate Sheets.");
        }
    }

    #endregion

