    #region Validate Last Row
    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            if (!IncomingInspectionVM.NoDimensionEntry)
            {
                var lastRow = InspectionData.LastOrDefault();
                if (lastRow == null) return true;

                if (!await ValidateRowAsync(lastRow)) return false;

                lastRow.IsEditable = false;
                return true;
            }
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateRowAsync(InspectionRowVM row)
    {
        try
        {
            var errors = new List<string>();
            if (row.SlNo <= 0)
                errors.Add("Invalid serial number");

            if (string.IsNullOrWhiteSpace(row.Desc) || row.Desc.Length < 2)
                errors.Add("Description is required");

            if (row.Dimens.HasValue && row.LoTol.HasValue && row.HiTol.HasValue)
            {
                var min = row.Dimens.Value - row.LoTol.Value;
                var max = row.Dimens.Value + row.HiTol.Value;

                if (min >= max)
                    errors.Add("Invalid tolerance range");
            }

            var components = new[]
            {
                row.Comp1, row.Comp2, row.Comp3, row.Comp4, row.Comp5,
                row.Comp6, row.Comp7, row.Comp8, row.Comp9, row.Comp10,
                 row.Comp11, row.Comp12, row.Comp13, row.Comp14, row.Comp15
            };

            if (!components.Any(c => c==null))
                errors.Add("Enter at least one component value");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }
    #endregion

    #region validations
    private async Task<bool> Validation()
    {
        try
        {
            var errors = new List<string>();
            if (String.IsNullOrEmpty(IncomingInspectionVM.DcType))
            {
                await _js.ToastrInfo("Please Select the DC Type");
                return false;
            }

            if (String.IsNullOrEmpty(IncomingInspectionVM.DCNo))
            {
                errors.Add("Please Select the DC No");
            }

            if (String.IsNullOrEmpty(IncomingInspectionVM.ItemCode))
            {
                errors.Add("Please Select the Item");
            }

            if (!IncomingInspectionVM.Qty.HasValue || IncomingInspectionVM.Qty <= 0)
                errors.Add("Please enter the DC Quantity");

            if (IncomingInspectionVM.Qty > dcQty)
                errors.Add("Qty should not be more than Dc Quantity");

            if (IncomingInspectionVM.Id==0)
            {
                if (await IncomingInspectionService.CheckDuplicateRandom(IncomingInspectionVM.InspectNo ?? "", Mode == InspectionMode.Random, IncomingInspectionVM.Suffix))
                    errors.Add("Duplicate Inspection Number");
            }

            if (Mode == InspectionMode.Individual)
            {
                if (IncomingInspectionVM.SheetSlNo <= 0)
                {
                    errors.Add("Please Select Sheet");
                }
            }

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating rows.");
            await LoggingService.LogDeveloperError(ex, "Validation failed.");
            return false;
        }
    }
