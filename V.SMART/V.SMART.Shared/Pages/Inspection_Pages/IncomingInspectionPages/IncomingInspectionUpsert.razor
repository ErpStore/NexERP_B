    #region On Entering Dc or Selecting the Dc No
    private async Task OnTextOrSelectChange(ChangeEventArgs e)
    {
        try
        {

            string? GRNNo = e.Value?.ToString();
            IncomingInspectionVM.Grnno = GRNNo;
            var selecteddc = GrnLists
                .FirstOrDefault(x => x.GRNNo == GRNNo);

            if (selecteddc != null)
            {
                // Update only the required fields → Do NOT replace object
                IncomingInspectionVM.ProductionLogId = selecteddc.productionLogId;
                IncomingInspectionVM.Commongrnid = Convert.ToInt32(selecteddc.productionLogId);
                IncomingInspectionVM.DCNo = selecteddc.DcNo;
                IncomingInspectionVM.SuppId = selecteddc.SupplierId;
                IncomingInspectionVM.DcDate = selecteddc.DcDate;
                IncomingInspectionVM.CustomerName = selecteddc.SupplierName;
                if (IncomingInspectionVM.DcType == "Production_Log")
                {
                    IncomingInspectionVM.ItemCode = selecteddc.ItemCode;
                    IncomingInspectionVM.ItemName = selecteddc.ItemName;
                    IncomingInspectionVM.ItemId = selecteddc.ItemId ?? 0;

                    // 🔥 ENSURE ITEM EXISTS IN DROPDOWN LIST

                    if (!GrnSubList.Any(x => x.ItemId == IncomingInspectionVM.ItemId))
                    {
                        GrnSubList.Add(new IncomingInspectionHelpSubVM
                        {
                            CommonGrnSubId =IncomingInspectionVM.Commongrnid,
                            ItemId = IncomingInspectionVM.ItemId??0,
                            ItemCode = IncomingInspectionVM.ItemCode,
                            ItemName = IncomingInspectionVM.ItemName,
                        });
                    }

                    IncomingInspectionVM.processName = selecteddc.processname;
                    IncomingInspectionVM.ProcessId = selecteddc.processId;
                    IncomingInspectionVM.Qty = selecteddc.Qty;
                    @if (Mode == InspectionMode.Individual)
                    {
                        await GenerateSheets(IncomingInspectionVM.Qty);
                    }
                    IncomingInspectionVM.ItemUOM = await IncomingInspectionService.GetCategorynameByItemIdAsync(selecteddc.ItemId);
                    InspectionData = await IncomingInspectionService.GetInspectionRowVMsAsync(selecteddc.ItemId ?? 0, IncomingInspectionVM.ProcessId??0);

                }
                else
                {
                    GrnSubList = selecteddc.Items;
                    if (selecteddc.Items.Count == 1)
                    {
                        switch (IncomingInspectionVM.DcType)
                        {
                            case "Purchase":
                                IncomingInspectionVM.RefPurchaseGRNSubId = selecteddc.Items[0].CommonGrnSubId;
                                break;

                            case "Production_Assy":
                                IncomingInspectionVM.RefProductionAssyGRNId = selecteddc.Items[0].CommonGrnSubId;
                                break;

                            case "Production_Comp":
                                IncomingInspectionVM.RefProductionCompGRNSubId = selecteddc.Items[0].CommonGrnSubId;
                                break;
                        }
                        IncomingInspectionVM.Commongrnid = selecteddc.Items[0].CommonGrnSubId;
                        IncomingInspectionVM.ItemCode = selecteddc.Items[0].ItemCode;
                        IncomingInspectionVM.ItemName = selecteddc.Items[0].ItemName;
                        IncomingInspectionVM.ItemId = selecteddc.Items[0].ItemId;
                        IncomingInspectionVM.Qty = selecteddc.Items[0].Qty;
                        @if (Mode == InspectionMode.Individual)
                        {
                            await GenerateSheets(IncomingInspectionVM.Qty);
                        }

                        InspectionData = await IncomingInspectionService.GetInspectionRowVMsAsync(selecteddc.Items[0].ItemId ?? 0,0);
                    }
                    else if (selecteddc.Items.Count > 1)
                    {
                        IsnotDc = false;
                    }
                    else
                    {
                        IsEditingMode = false;
                    }
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the OnTextOrSelectChange() event for CalibrationMaintenanceUpsert");
            await _js.ToastrError("An error occurred while selecting the Unique ID.");
        }
    }
