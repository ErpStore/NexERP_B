@code {

    #region Variables and Properties
    // User Rights
    protected override string ScreenName => "IncomingInspection";
    [Parameter]
    public int InspectId { get; set; }
    private IncomingInspectionVM IncomingInspectionVM = new();
    private bool isProcessing = true;
    private bool IsEditingMode = false;
    private bool IsnotDc = false;
    private bool IsSheetEditable = false;
    private bool IsAddNewDC;
    private int noofsamples = 0;
    private Decimal? dcQty;
    private int SelectedSheetNo = 1;
    private InspectionMode Mode = InspectionMode.Random;
