    #region Save Inspection
    private async Task SaveInspection()
    {
        try
        {
            isProcessing = true;
            if (!await Validation())
            {
                return;
            }

            bool isValid = await ValidateLastRowAsync();
            if (!isValid) return;

            var qty = IncomingInspectionVM.Qty ?? 0;
            var acc = IncomingInspectionVM.AcceptQty ?? 0;
            var rej = IncomingInspectionVM.RejQty ?? 0;
            var rework = IncomingInspectionVM.ReWorkQty ?? 0;
            var errors = new List<string>();
            if (!IncomingInspectionVM.AcceptQty.HasValue || acc < 0)
                errors.Add("Please enter the Accepted Quantity");

            if (rej < 0)
                errors.Add("Rejected Quantity cannot be negative");

            if (rework < 0)
                errors.Add("Rework Quantity cannot be negative");

            if (acc + rej + rework == 0)
                errors.Add("Enter at least one accepted quantity");

            if (acc + rej + rework > qty)
                errors.Add("Accepted + Rejected + Rework quantity cannot exceed DC Quantity");

            if (acc > qty)
                errors.Add("Accepted Quantity cannot be greater than DC Quantity");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return;
            }

            if (IncomingInspectionVM.InspectBy == null || IncomingInspectionVM.InspectBy == "")
            {
                await _js.ToastrError("Please select the Inspected By field.");
                return;
            }
            if (!IncomingInspectionVM.NoDimensionEntry)
            {
                if (!InspectionData.Any())
                {
                    await _js.ToastrError("Cannot save a Inspection without valid Dimensions.");
                    return;
                }
            }

            // Save
            IncomingInspectionVM.IsRandom = Mode == InspectionMode.Random ? true : false;
            IncomingInspectionVM.TotRows = InspectionData.Count;
            IncomingInspectionVM.BalQty = (IncomingInspectionVM.Qty ?? 0)
                                        - ((IncomingInspectionVM.RejQty ?? 0)
                                        + (IncomingInspectionVM.ReWorkQty ?? 0)
                                        + (IncomingInspectionVM.AcceptQty ?? 0));
            var isNewInspect = IncomingInspectionVM.Id == 0;
            string jsonData = JsonSerializer.Serialize(InspectionData);
            IncomingInspectionVM.InspectionData = jsonData;
            try
            {
                await IncomingInspectionService.UpsertInspectAsync(IncomingInspectionVM);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewInspect)
            {
                await _js.ToastrSuccess("Inspection saved successfully.");
            }
            else
            {
                await _js.ToastrSuccess("Inspection updated successfully.");
            }

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/IncomingInspection");

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Upsert Incoming-Inspection failed.");
            await _js.ToastrError("Error in saving Incoming-Inspection.");
        }

        finally
        {
            isProcessing = false;
        }
    }
    #endregion

