    private List<Staff> AllStaff = new();

    //Main Tables
    private IEnumerable<PurchaseGRNVM> PurchaseGRNList = Enumerable.Empty<PurchaseGRNVM>();
    private IEnumerable<ProductionLogVM> ProductionLogList = Enumerable.Empty<ProductionLogVM>();
    private IEnumerable<ProductionReturnCompVM> ProductionCompGRN = Enumerable.Empty<ProductionReturnCompVM>();
    private IEnumerable<ProductionReturnAssyVM> ProductionAssyGRN = Enumerable.Empty<ProductionReturnAssyVM>();

    private IEnumerable<IncomingInspectionHelpVM> GrnLists = Enumerable.Empty<IncomingInspectionHelpVM>();
    private List<IncomingInspectionHelpSubVM> GrnSubList = new();

    public class SheetVM
    {
        public int SheetSlNo { get; set; }
        public string SheetName { get; set; } = string.Empty;
    }

    private List<PageHeader.BreadcrumbItem> ScreenBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Inspection" },
        new PageHeader.BreadcrumbItem { Text = "Incoming Inspection", IsLast = true }
    };

    private string ScreenTitle => "Incoming Inspection";
    private string MachineIcon => "bi bi-tools";
    private enum InspectionMode
    {
        Random,
        Individual
    }

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }
    #endregion

    #region Initialization
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            IncomingInspectionVM.InspectDate = DateTime.Now;
            noofsamples = await IncomingInspectionService.GetNoOfSamples();
            InstrumentList = await IncomingInspectionService.GetAllInstrumentsAsync();
            AllCustomers = await IncomingInspectionService.GetAllActiveCustomersAsync();
            AllcostCenterVMs = await IncomingInspectionService.GetAllCostCenterDetails();
            AllItems = await IncomingInspectionService.GetAllComponentsAsync();
            AllDefectInfoList = await IncomingInspectionService.GetAllActiveDefectsAsync();
            AllStaff = await IncomingInspectionService.GetAllStaffAsync();
            IncomingInspectionVM.InspectNo = await IncomingInspectionService.GenerateNewInspectionNoAsync(Mode == InspectionMode.Random ? "Random" : "Individual");
            IncomingInspectionVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            IncomingInspectionVM.SheetSlNo = 0;
            if (InspectId > 0)
            {
                await LoadExistingInspect(InspectId);
                if (noofsamples == 15)
                {
                    int? SheetSlNo = IncomingInspectionVM.SheetSlNo;
                    int? start = (SheetSlNo - 1) * 15 + 1;
                    int? end = SheetSlNo * 15;
                    IncomingInspectionVM.SheetName = $"Sheet-{SheetSlNo} ({start}-{end})";
                }
                else
                {
                    int? SheetSlNo = IncomingInspectionVM.SheetSlNo;
                    int? start = (SheetSlNo - 1) * 10 + 1;
                    int? end = SheetSlNo * 10;
                    IncomingInspectionVM.SheetName = $"Sheet-{SheetSlNo} ({start}-{end})";
                }

                IsEditingMode = true;
                IsnotDc = false;
                IsSheetEditable = true;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
            await _js.InvokeVoidAsync("alert", "An error occurred while loading the page. Please try again later.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
    #endregion

    #region to Load Existing Inspection
    private async Task LoadExistingInspect(int? InspectId)
    {
        try
        {
            if (InspectId == null || InspectId <= 0)
            {
                await _js.ToastrWarning("Invalid Inspection Id.");
                return;
            }
            IncomingInspectionVM = await IncomingInspectionService.GetInspectionByIdAsync(InspectId.Value);

            if (IncomingInspectionVM.IsRandom == false)
            {
                Mode = InspectionMode.Individual;
            }

            //Loading the dimension from json to model

            InspectionData = string.IsNullOrWhiteSpace(IncomingInspectionVM.InspectionData) ? new List<InspectionRowVM>()
                    : JsonSerializer.Deserialize<List<InspectionRowVM>>(IncomingInspectionVM.InspectionData)
                        ?? new List<InspectionRowVM>();

            if (IncomingInspectionVM == null)
            {
                await _js.ToastrWarning("Inspection not found.");
                return;
            }

        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing Inspection.");
            await LoggingService.LogDeveloperError(ex, $"LoadExisting Data failed for Inspection Id: {InspectId}");
        }
    }
    #endregion

    #region On DcNo Typing
    private async Task OnTextBoxTyping(ChangeEventArgs e)
    {
        try
        {
            IncomingInspectionVM.Grnno = e.Value?.ToString();

            // Clear dependent fields

            IncomingInspectionVM.CustomerName = string.Empty;
            IncomingInspectionVM.ItemCode = string.Empty;
            IncomingInspectionVM.ItemName = string.Empty;
            IncomingInspectionVM.CostCenter = string.Empty;
            IncomingInspectionVM.Qty = 0;
            IncomingInspectionVM.AcceptQty = 0;
            await GenerateSheets(0);
            IsnotDc = true;
            IsEditingMode = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnTextBoxTyping failed to Load");
            await _js.InvokeVoidAsync("alert", "An error occurred in OnTextBoxTyping method");
        }
    }
    #endregion

    #region On Item Code Change
    private async Task OnItemCodeChanged(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out int GrnSubId))
            {
                if (IsnotDc)
                {
                    var selectedItem = AllItems.FirstOrDefault(x => x.ItemId == GrnSubId);
                    if (selectedItem != null)
                    {
                        IncomingInspectionVM.ItemCode = selectedItem.ItemCode;
                        IncomingInspectionVM.ItemName = selectedItem.ItemName;
                        IncomingInspectionVM.ItemUOM = selectedItem.MeasureUnit;
                    }
                }
                else
                {
                    var selectedItem = GrnSubList.FirstOrDefault(x => x.CommonGrnSubId == GrnSubId);
                    if (selectedItem != null)
                    {
                        IncomingInspectionVM.Commongrnid = selectedItem.CommonGrnSubId;
                        switch (IncomingInspectionVM.DcType)
                        {
                            case "Purchase":
                                IncomingInspectionVM.RefPurchaseGRNSubId = selectedItem.CommonGrnSubId;
                                break;

                            case "Production_Assy":
                                IncomingInspectionVM.RefProductionAssyGRNId = selectedItem.CommonGrnSubId;
                                break;

                            case "Production_Comp":
                                IncomingInspectionVM.RefProductionCompGRNSubId = selectedItem.CommonGrnSubId;
                                break;
                        }
                        IncomingInspectionVM.ItemId = selectedItem.ItemId;
                        IncomingInspectionVM.ItemCode = selectedItem.ItemCode;
                        IncomingInspectionVM.ItemName = selectedItem.ItemName;
                        IncomingInspectionVM.ItemUOM = selectedItem.Uom;
                        IncomingInspectionVM.Qty = selectedItem.Qty;
                        IncomingInspectionVM.ProcessId = selectedItem.processId;
                        dcQty = selectedItem.Qty;
                        @if (Mode == InspectionMode.Individual)
                        {
                            await GenerateSheets(selectedItem.Qty);
                        }
                    }
                }

                InspectionData = await IncomingInspectionService.GetInspectionRowVMsAsync(GrnSubId, IncomingInspectionVM.ProcessId??0);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnItemCodeChanged failed to Load");
            await _js.InvokeVoidAsync("alert", "An error occurred in OnItemCodeChanged method");
        }
    }
    #endregion

    #region GET DC Nos
    private async Task GetDcNos(ChangeEventArgs e)
    {
        try
        {
            if (Mode == InspectionMode.Random)
            {
                await RandomInspectionClick();
            }
            else
            {
                await IndividualInspectionClick();
            }
            var selectedValue = e.Value?.ToString();
            if (string.IsNullOrEmpty(selectedValue))
                return;
            IncomingInspectionVM.DcType = selectedValue;
            if (selectedValue == "SubContract")
            {
                Customer = "Supplier";

            }
            else if (selectedValue == "Purchase")
            {
                Customer = "Vendor";
                PurchaseGRNList = await IncomingInspectionService.GetAllPurchaseGRNsAsync();

                GrnLists = PurchaseGRNList.Select(x => new IncomingInspectionHelpVM
                {
                    GRNNo = x.GRNNo,
                    DcNo = x.RefDcNo,
                    DcDate = x.RefDcDate,
                    SupplierId = x.VendorCode,
                    SupplierName = x.VendorName,
                    Items = x.PurchaseGRNSubVMs.Select(y => new IncomingInspectionHelpSubVM
                            {
                               CommonGrnSubId=y.GRNSubId,
                               ItemId=y.ItemId,
                               ItemCode=y.ItemCode,
                               ItemName=y.ItemName,
                               Uom=y.MeasureUnit,
                               Qty=y.Qty
                            }).ToList()
                }).ToList();
            }
            else if (selectedValue == "Production_Comp")
            {
                Customer = "Customer";
                ProductionCompGRN = await IncomingInspectionService.GetAllProductionCompGRNAsync();
                GrnLists = ProductionCompGRN.Select(x => new IncomingInspectionHelpVM
                {
                    GRNNo = x.ReturnNo,
                    DcNo = x.ReturnNo + x.Suffix,
                    DcDate = x.ReturnDate,
                    SupplierId = x.CustId,
                    SupplierName = x.CustName,
                    Items = x.ProductionReturnCompSubVMs.Select(y => new IncomingInspectionHelpSubVM
                    {
                        CommonGrnSubId=y.ReturnSubId,
                        ItemId = y.ItemId,
                        ItemCode = y.ItemCode,
                        ItemName = y.ItemName,
                        Uom = y.MeasureUnit,
                        Qty = y.Qty,
                        processId=y.ProcessId,
                        processname=y.ProcessName
                    }).ToList()
                }).ToList();
            }

            else if (selectedValue == "Production_Assy")
            {
                Customer = "Customer";
                ProductionAssyGRN = await IncomingInspectionService.GetAllProductionAssymblyGRNAsync();
                GrnLists = ProductionAssyGRN.Select(x => new IncomingInspectionHelpVM
                {
                    GRNNo = x.ReturnNo,
                    DcNo = x.ReturnNo + x.Suffix,
                    DcDate = x.ReturnDate,
                    SupplierId=0,
                    SupplierName="None",
                    Items = x.ProductionReturnAssySubVMs.Select(y => new IncomingInspectionHelpSubVM
                    {
                        CommonGrnSubId=y.ReturnSubId,
                        ItemId = y.ItemId,
                        ItemCode = y.ItemCode,
                        ItemName = y.ItemName,
                        Uom = y.MeasureUnit,
                        Qty = y.QtyReturned
                    }).ToList()
                }).ToList();
            }

            else if (selectedValue == "Production_Log")
            {
                Customer = "Customer";
                ProductionLogList = await IncomingInspectionService.GetAllProductionLogsAsync();

                GrnLists = ProductionLogList.Select(x => new IncomingInspectionHelpVM
                {
                    productionLogId=x.LogId,
                    GRNNo=x.LogNo,
                    DcNo = x.LogNo + x.Suffix,
                    DcDate = x.LogDate,
                    SupplierId=x.CustId,
                    SupplierName = x.CustomerName,
                    ItemId=x.ItemIdIn,
                    ItemCode=x.ItemInCode,
                    ItemName=x.ItemInName,
                    Qty=x.InputQty,
                    processId=x.ProcessId,
                    processname=x.ProcessName
                }).ToList();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "GetDcNos failed.");
            await _js.ToastrError("An error occurred while loading DC Nos. Please try again.");
        }
