@page "/MasterInspection"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IInspectionService
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IMaintenanceService
@using V.SMART.Shared.BusinessLayer.BusinessService.MaintenanceService
@using V.SMART.Shared.Data.Maintenance.BreakdownMaintenance
@using V.SMART.Shared.Data.Maintenance.CalibrationHistoryAndMaintenance
@using V.SMART.Shared.Data.Master.Inventory
@using V.SMART.Shared.ViewModels
@using V.SMART.Shared.ViewModels.InspectionViewModel.MasterInspectionVM
@using V.SMART.Shared.ViewModels.MaintenanceViewModel.BreakdownMaintenanceVM
     
@inherits BaseUserRightsComponent

@inject IMasterInspectionService inspectionservice
@inject IColumnPreferenceService PreferenceService
@inject CurrentUserService currentUserService
@inject ILoggingService LoggingService
@inject IJSRuntime _js
@inject NavigationManager _navigation

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
            @if (ActiveModal == "InstantSearch")
            {
                <InstantSearch isModelVisible="true"
                               Screen="@ScreenName"
                               Filters="SearchFilters"
                               OnClose="CloseModal"
                               OnSearch="ApplySearchFilters" />
            }
        </MasterModal>
    }
</MasterModal>

<BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="btn-danger"
         ButtonText="Delete"
         Title="Are you sure you want to delete this Inspection?">
</BsModal>

@if (isProcessing)
{
    <div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
        <img src="/_content/V.SMART.Shared/images/loading.gif" alt="loading.." />
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <!-- Card Header -->
            <PageHeader TitleText="@ScreenTitle"
                        TitleIcon="@MachineIcon"
                        Breadcrumbs="@ScreenBreadcrumbs" />
            <div class="card-body">

                <!-- Filter Controls -->
                <div class="row g-3 align-items-center mb-2">

                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="MasterInspection"
                                    UserId="@UserName"
                                    MaxVisible="int.MaxValue"
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <!-- DROPDOWN -->
                    <div class="col-12 col-lg-2">
                        <select class="form-select form-select-sm shadow-sm" @onchange="FilterRows">
                            <option value="">-- All Items --</option>
                            @foreach (var item in InstrumentList)
                            {
                                <option value="@item.ItemId">@item.ItemCode</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-lg-2">
                        <select class="form-select form-select-sm shadow-sm"
                                value="@pageSize" @onchange="OnPageSizeChanged"
                                title="Select number of records per page">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                        <div class="col-12 col-lg-2 ms-lg-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewInspect">
                                <i class="bi bi-plus-square me-1"></i> Add New Inspection
                            </button>
                        </div>
                    }
                </div>


                @if (InspectionList.Any())
                {
                    <div class="table-responsive">
                        <QuickGrid class="table table-striped table-bordered align-middle text-wrap"
                                   Items="InspectionList.AsQueryable()"
                                   ItemKey="@(m => m.Id)">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
                            {
                                foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            // Instrument
                                            case "Inspection":
                                                <PropertyColumn Title="Inspection Number"
                                                                Property="@(x => $"{x.InspectNo}{x.Suffix}")" 
                                                                Sortable="false" />
                                                break;

                                            // UniqueId
                                            case "Date":
                                                <PropertyColumn Title="Date"
                                                                Property="@(c => c.InspectDate.Value.ToString("dd/MM/yyyy"))"
                                                                Sortable="true" />
                                                break;

                                            // Next Date
                                            case "Process":
                                                <PropertyColumn Title="Process Name"
                                                                Property="@(c => c.ProcessName)" />

                                                break;

                                            // Previous Date
                                            case "ItemCode":
                                                <PropertyColumn Title="Itemcode/Part No."
                                                                Property="@(c => c.ItemCode)" />
                                                break;

                                            // Report No.
                                            case "ItemName":
                                                <PropertyColumn Title="ItemName"
                                                                Property="@(c => c.ItemName)" />
                                                break;

                                            // Status
                                            case "Qty":
                                                <PropertyColumn Title="Qty"
                                                                Property="@(c => c.Qty)" />
                                                break;

                                            // Authorised By
                                            case "Authorised":
                                                <PropertyColumn Title="Authorised By"
                                                                Property="@(c => c.StaffName)" />
                                                break;

                                            // Details
                                            case "Remarks":
                                                <PropertyColumn Title="Remarks"
                                                                Property="@(c => c.Remarks)" />
                                                break;
                                        }
                                    </div>
                                }
                            }

                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"MasterInspection/update/{c.Id}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Item">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"MasterInspection/details/{c.Id}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Quotation">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete Item"
                                                @onclick="() => HandleDelete(c.Id)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>
                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>

                    <div class="card-footer bg-white border-0 mt-3">
                        <div class="d-flex flex-column flex-lg-row justify-content-end gap-2">

                            <button class="btn btn-primary d-flex align-items-center px-3">
                                <i class="bi bi-printer me-2"></i>
                                Print
                            </button>

                        </div>
                    </div>

                }
                else
                {
                    <p class="text-center mt-4 text-muted">No categories available.</p>
                }
            </div>
        </div>
    </div>
}

@code {
    #region Declarations And Properties
    // User Rights
    protected override string ScreenName => "MasterInspection";
    private DateTime? todate = DateTime.Now;
    private DateTime? fromdate = DateTime.Now;
    private bool isProcessing = true;
    private string? UserName;
    private int DeleteID = 0;
    private IEnumerable<MasterInspectionVM> InspectionList = new List<MasterInspectionVM >();
    private IEnumerable<MasterInspectionVM> TempInspectionList = new List<MasterInspectionVM>();

    private List<ItemVM> InstrumentList = new();
    private Timer? debounceTimer;


    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private List<PageHeader.BreadcrumbItem> ScreenBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Inspection" },
        new PageHeader.BreadcrumbItem { Text = "Master Inspection", IsLast = true }
    };

       // Instant Search filter parameter
    [Parameter, SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private string ScreenTitle => "Master Inspection";
    private string MachineIcon => "bi bi-tools";
    public List<GridColumn> Columns { get; set; } = new();
    #endregion

    #region Columns Initialization
    public async Task InitializeColumns(bool hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "Inspection Number", Field = "Inspection", IsVisible = true },
                new() { Title = "Date", Field = "Date", IsVisible = false },
                new() { Title = "Process Name", Field = "Process", IsVisible = false },
                new() { Title = "Itemcode/Part No.", Field = "ItemCode", IsVisible = false },
                new() { Title = "ItemName", Field = "ItemName", IsVisible = false },
                new() { Title = "Qty", Field = "Qty", IsVisible = false },
                new() { Title = "Inspected By", Field = "Authorised", IsVisible = false },
                new() { Title = "Remarks", Field = "Remarks", IsVisible = false },
            };
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ItemList InitializeColumns() Method");
            await _js.ToastrError("Failed to initialize columns. Please try again.");
        }
    }
    #endregion

    #region Initialization
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            UserName = await currentUserService.GetUsernameAsync();

            await InitializeColumns(IsHidden);
            var savedPreferences = await PreferenceService.LoadPreferencesAsync("MasterInspection", UserName);

            if (savedPreferences?.Any() == true)
            {
                foreach (var col in Columns)
                {
                    var match = savedPreferences.FirstOrDefault(s => s.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }

            //InstantSearch
            //Important : Deserialize Filter parameter from query string if exists
            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            InstrumentList = await inspectionservice.GetAllInstrumentsAsync();
            await loadMasterInspection();
            TempInspectionList = InspectionList;
            isProcessing = false;
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the OnInitializedAsync() method for MachineList");
        }
    }
    #endregion

    #region Instant Search
    public void Search()
    {
        try
        {
            isModalVisible = true;
            ActiveModal = "InstantSearch";
        }
        catch (Exception ex)
        {
            LoggingService.LogDeveloperError(ex, "An error occurred while handling the Search() method for MachineList").Wait();
        }
    }
#endregion

    #region Loading Inspections
    private async Task loadMasterInspection()
    {
        try
        {
            var result = await inspectionservice.SearchFinalInspectionAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            InspectionList = result.FinalInspectionVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the loadMasterInspection() method for MasterInspectiom");
            await _js.ToastrError("Failed to load Master Inspections. Please try again.");
        }
    }
    #endregion

    #region Pagination Code

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await loadMasterInspection();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Final Inspection List");
            await _js.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await loadMasterInspection();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Final Inspection List");
            await _js.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await loadMasterInspection();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Final Inspection List");
            await _js.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await loadMasterInspection();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Sales Order List");
            await _js.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await loadMasterInspection();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Sales Order List");
            await _js.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    #endregion

    #region Delete Handling
    private async Task HandleDelete(int? id)
    {
        try
        {
            if (id.HasValue)
            {
                DeleteID = id.Value;
            }
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the HandleDelete() method for MachineList");
        }
    }

    private async Task confirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (isConfirmed && DeleteID != 0)
            {
                var inspect = await inspectionservice.GetInspectionByIdAsync(DeleteID);
                await LoggingService.LogUserAction(UserName: await currentUserService.GetUsernameAsync(), Machine: currentUserService.MachineName, IP_Address: currentUserService.IpAddress,
                screen: "MaintenanceBreakdown", action: $"User Deleted an existing Inspection of a Item. {inspect?.ItemName}",
                additionalInfo: $"CusomerName: {inspect?.ProcessName}");
                var deleted = await inspectionservice.DeleteInspectionByIdAsync(DeleteID);
                if (deleted)
                {
                    await _js.ToastrSuccess("Inspection deleted successfully.");
                }
                else
                {
                    await _js.ToastrError("Error encountered while deleting Inspection.");
                }

                await loadMasterInspection();
                isProcessing = false;
            }

            DeleteID = 0;
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the confirmDelete_Click() event for InspectionList");
        }
    }
    #endregion

    #region Column Visibility Change Handling
    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ItemList HandleColumnChange() Method");
        }
    }
    #endregion

    #region CloseModal
    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _js.ToastrError("Failed to close modal. Please try again.");
        }
    }
    #endregion

    #region Dispose Timer
    public void Dispose()
    {
        try
        {
            debounceTimer?.Dispose();
        }
        catch (Exception ex)
        {
            LoggingService.LogDeveloperError(ex, "An error occurred while disposing the InspectionList component").Wait();
        }
    }
    #endregion

    #region Filter Rows
    private async Task FilterRows(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (string.IsNullOrEmpty(value))
        {
            // Load full data again
            InspectionList = TempInspectionList.ToList();
            return;
        }

        // Convert MachineId
        int selectedItemId = int.Parse(value);

        // Filter by selected MachineId
        InspectionList = TempInspectionList
        .Where(x => x.ItemId == selectedItemId)
            .ToList();
    }
    #endregion

    #region Add New Inspection
    private void AddNewInspect()
    {
        _navigation.NavigateTo("MasterInspection/create");
    }
    #endregion

    #region Modal Management
    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _js.ToastrError("Failed to open modal. Please try again.");
        }
    }
    #endregion


    #region Refreshing the Page
    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await loadMasterInspection();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Master Inspection List page");
            await _js.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }
    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await loadMasterInspection();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in  Final Inspection");
            await _js.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion
}