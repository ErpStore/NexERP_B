        else
        {
            BuildEmployeeGridFromFiltered();
        }

        StateHasChanged();
    }

    private bool IsFutureMonth()
    {
        var today = DateTime.Today;

        //Prevent invalid DateTime
        if (AttendanceVM.Year <= 0 || AttendanceVM.MonthId <= 0)
            return false;

        var selected = new DateTime(AttendanceVM.Year, AttendanceVM.MonthId, 1);
        var current = new DateTime(today.Year, today.Month, 1);

        return selected > current;
    }

    private bool IsCurrentMonth()
    {
        var today = DateTime.Today;

        if (AttendanceVM.Year <= 0 || AttendanceVM.MonthId <= 0)
            return false;

        return AttendanceVM.Year == today.Year &&
               AttendanceVM.MonthId == today.Month;
    }

    private bool IsFutureDay(int day)
    {
        var today = DateTime.Today;

        //Block entire future month
        if (IsFutureMonth())
            return true;

        //Block future days in current month
        if (IsCurrentMonth() && day > today.Day)
            return true;

        //Past months fully allowed
        return false;
    }

    private IEnumerable<int> GetVisibleDays()
    {
        var today = DateTime.Today;

        // Future month → show but disabled
        if (IsFutureMonth())
            return Days.Where(d => d <= AttendanceVM.TotalDays);

        // Current month → show till today only
        if (IsCurrentMonth())
            return Days.Where(d => d <= today.Day);

        // Past months → full
        return Days.Where(d => d <= AttendanceVM.TotalDays);
    }

