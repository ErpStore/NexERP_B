    private DateTime? ParseTime(string time)
    {
        if (string.IsNullOrWhiteSpace(time))
            return null;

        if (DateTime.TryParseExact(
            time,
            "HH:mm",
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out var result))
        {
            return DateTime.Today.Add(result.TimeOfDay);
        }

        return null;
    }

    private void RebuildDays()
    {
