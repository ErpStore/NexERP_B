@page "/attendance/create"
@page "/attendance/update/{Id:int}"

@using MudBlazor
@using System.Globalization;
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IHumanResourceService.IAttendanceService
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IMasterServices.IHRMasterservice
@using V.SMART.Shared.ViewModels.HumanResourceViewModel.AttendanceeVM
@using static V.SMART.Shared.ViewModels.HumanResourceViewModel.AttendanceeVM.DayCheck


@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject NavigationManager _navigationManager
@inject IAttendanceService _attendanceService
@inject IJSRuntime _js
@inject ILeaveApplicationService leaveApplicationService
@inject IBiometricExcelSettingService biometricExcelSettingService
@inject ILeaveTypeService leaveTypeService
@inject IEmployeeLeavebalanceService leaveBalanceService

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>
<style>
    /* ================= WRAPPER ================= */
    .attendance-wrapper {
        overflow-x: auto;
        width: 100%;
        max-height: 600px;
        overflow-y: auto;
    }

    .attendance-title {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        display: block;
        margin-bottom: 10px;
        padding-left: 6px;
        border-left: 4px solid #2563eb;
    }

    .attendance-toggle {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    /* option style */
    .toggle-option {
        padding: 8px 18px;
        border: 1px solid #d1d5db;
        border-radius: 25px;
        cursor: pointer;
        font-weight: 600;
        background: #fff;
        transition: 0.2s;
        user-select: none;
    }

        /* hover */
        .toggle-option:hover {
            border-color: #60a5fa;
            background: #eff6ff;
        }

        /* selected style */
        .toggle-option:has(input:checked) {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
        }


    /* ================= TABLE ================= */
    .attendance-table {
        border-collapse: collapse;
        min-width: max-content;
        font-size: 13px;
    }

    /* ================= STICKY COLUMNS ================= */
    .sticky-col {
        position: sticky;
        background: #fff;
        z-index: 2;
    }

    /* SL NO */
    .sl-col {
        width: 40px;
        min-width: 40px;
        left: 0;
        text-align: center;
        z-index: 4;
        box-shadow: inset -1px 0 0 #dee2e6;
    }

    /* NAME */
    .name-col {
        width: 170px;
        min-width: 170px;
        left: 40px;
        font-weight: 600;
        z-index: 4;
        box-shadow: inset -1px 0 0 #dee2e6;
    }


    /* ================= DAY COLUMN SIZE ================= */
    .day-col {
        width: 60px;
        min-width: 60px;
        max-width: 60px;
        padding: 0 !important;
    }

        .day-col input {
            width: 100%;
            height: 30px;
            padding: 0;
            font-size: 15px;
            text-align: center;
        }

    /* ================= HEADER ================= */
    thead th.sticky-col {
        background-color: #1d7f36;
        color: white;
        z-index: 5;
    }


    /* ================= INPUT ================= */
    .attendance-table input.form-control {
        height: 30px;
        padding: 0;
        background: transparent;
    }

    /* PRESENT */
    .status-present {
        background-color: #dcfce7 !important;
    }

        .status-present input {
            color: #166534 !important;
        }


    /* ABSENT */
    .status-absent {
        background-color: #fee2e2 !important;
    }

        .status-absent input {
            color: #991b1b !important;
        }


    /* LEAVE */
    .status-leave {
        background-color: #ede9fe !important;
    }

        .status-leave input {
            color: #5b21b6 !important;
        }

    /* ONLY HOLIDAY STYLE */
    .status-holiday {
        background-color: #fef3c7 !important;
    }

        .status-holiday input {
            background-color: transparent !important;
            color: #92400e !important;
            font-weight: 600;
            border: none !important;
        }

    /* WEEK OFF */
    .status-weekoff {
        background-color: #e0f2fe !important;
    }

        .status-weekoff input {
            color: #0369a1 !important;
            font-weight: 600;
        }

    .status-halfdayabsent {
        background-color: #ffe4e6 !important;
    }

        .status-halfdayabsent input {
            color: cadetblue !important;
        }

    .status-halfdayleave {
        background-color: #dbeafe !important;
    }

        .status-halfdayleave input {
            color: darksalmon !important;
        }

    .status-onduty {
        background-color: #ccfbf1 !important;
    }

        .status-onduty input {
            color: lightcoral !important;
        }

</style>

<!-- MODAL -->
@if (IsLeaveModalVisible)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color:rgba(0,0,0,0.5);">

        <!-- INCREASE MODAL SIZE -->
        <div class="modal-dialog modal-dialog-centered modal-xl">

            <div class="modal-content shadow-lg border-0">

                <!-- HEADER -->
                <div class="modal-header text-white" style="background-color:#53C2CA">

                    <h5 class="modal-title fw-bold">
                        Leave History
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseLeaveModal">
                    </button>

                </div>

                <!-- BODY -->
                <div class="modal-body p-3">

                    @if (LeaveHistoryList.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-bordered table-striped table-hover align-middle">

                                <thead class="table-dark text-center">

                                    <tr>
                                        <th style="min-width:120px;">Employee ID</th>
                                        <th style="min-width:220px;">Staff Name</th>
                                        <th style="min-width:220px;">Designation</th>
                                        <th style="min-width:100px;">Year</th>
                                        <th style="min-width:150px;">Total Leave</th>
                                        <th style="min-width:150px;">Leaves Taken</th>
                                        <th style="min-width:150px;">Balance</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in LeaveHistoryList)
                                    {
                                        <tr>
                                            <td class="text-center fw-semibold">
                                                @item.EmployeeID
                                            </td>

                                            <td>
                                                @item.Staff?.StaffName
                                            </td>

                                            <td>
                                                @item.Staff?.Designation
                                            </td>

                                            <td class="text-center">
                                                @item.Year
                                            </td>

                                            <td class="text-center">
                                                @item.TotalAllocatedLeave
                                            </td>

                                            <td class="text-center">
                                                @item.LeavesTaken
                                            </td>

                                            <td class="text-center fw-bold text-success">
                                                @item.Balance
                                            </td>
                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-danger fw-bold p-3">
                            No leave history found.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>
}

@if (isProcessing)
{
    <div class="position-fixed top-50 start-50 translate-middle d-flex align-items-center justify-content-center"
         style="width: 100vw; height: 100vh; background-color: rgba(255,255,255,0.5); z-index: 1050;">
        <img src="/_content/IQSMART.Shared/images/loading.gif" alt="Loading..." />
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@(AttendanceVM.Id > 0 ? "Update Attendance" : "Create Attendance")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@AttendanceFormBreadcrumbs" />

            <div class="card-body bg-light">

                <EditForm Model="AttendanceVM" OnValidSubmit="UpsertAttendance">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3 p-2 border rounded bg-white">
                        <label class="fw-bold text-primary">Attendance Mode</label>

                        <InputRadioGroup @bind-Value="AttendanceVM.AttendanceSource">
                            <label class="me-4 fw-bold">
                                <InputRadio Value="@("Manual")" /> Manual Attendance
                            </label>

                        </InputRadioGroup>

                        <!-- Manual Attendance Screen -->
                        @if (AttendanceVM.AttendanceSource == "Manual")
                        {
                            <div class="row">

                                <!-- CARD 1 -->
                                <div class="col-lg-4 col-md-12 mb-3">
                                    <div class="card shadow-sm h-100">
                                        <div class="card-header" style="background-color:#AA336A; color:white;">
                                            <span class="fw-bold small">Select Year</span>
                                        </div>

                                        <div class="card-body p-2">

                                            <div class="row mb-1">
                                                <label class="col-4 col-form-label pt-1 text-dark"><small>For The Year</small></label>
                                                <div class="col-5">
                                                    <input type="number"
                                                           class="form-control form-control-sm rounded-3"
                                                           value="@AttendanceVM.Year"
                                                           @onchange="OnYearChanged" />
                                                </div>
                                            </div>

                                            <div class="row mb-1">
                                                <label class="col-4 col-form-label pt-1 text-dark">
                                                    <small>Month Name</small>
                                                </label>
                                                <div class="col-5">
                                                    <input type="text"
                                                           class="form-control form-control-sm rounded-3"
                                                           value="@AttendanceVM.MonthName"
                                                           readonly />
                                                </div>
                                            </div>

                                            <div class="row mb-1">
                                                <label class="col-4 col-form-label pt-1 text-dark">
                                                    <small>Select Month</small>
                                                </label>
                                                <div class="col-5">
                                                    <select class="form-select form-select-sm rounded-3"
                                                            @onchange="OnMonthChanged">
                                                        <option value="0">-- Select Month --</option>

                                                        @foreach (var m in Months)
                                                        {
                                                            <option value="@m.Id" selected="@(AttendanceVM.MonthId == m.Id)">
                                                                @m.Name
                                                            </option>
                                                        }
                                                    </select>
                                                    <ValidationMessage For="@(() => AttendanceVM.MonthId)" />
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-12 mb-1">
                                                    <label class="col-form-label pt-0 text-black"><small><strong>Note:-</strong></small></label>
                                                </div>
                                                <div class="col-12 mb-1">
                                                    <label class="col-form-label pt-0 text-primary"><small><strong>1. Enter In & Out Time in HH:mm format only to calculate OT automatically.</strong></small></label>
                                                </div>
                                                <div class="col-12">
                                                    <label class="col-form-label pt-0 text-primary"><small><strong>2. Enter InTime & OutTime make setting and Click InTime & OutTime cell to auto-fill.</strong></small></label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- CARD 2 -->
                                <div class="col-lg-4 col-md-6 mb-3">
                                    <div class="card shadow-sm h-100">
                                        <div class="card-header" style="background-color:#008080; color:white;">
                                            <span class="fw-bold small">Shortcut Alphabets</span>
                                        </div>

                                        <div class="card-body p-2">
                                            <table class="table table-sm table-bordered mb-0 small">
                                                <tbody>
                                                    <tr><td class="text-center fw-bold">A</td><td>Absent</td><td class="text-center fw-bold">P</td><td>Present</td></tr>
                                                    <tr><td class="text-center fw-bold">L</td><td>Leave</td><td class="text-center fw-bold">N</td><td>Half-Day Absent</td></tr>
                                                    <tr><td class="text-center fw-bold">H</td><td>Holiday</td><td class="text-center fw-bold">M</td><td>Half-Day Leave</td></tr>
                                                    <tr><td class="text-center fw-bold">W</td><td>Week Off</td><td class="text-center fw-bold">O</td><td>On Duty</td></tr>
                                                </tbody>
                                            </table>

                                            <div class="mt-2">
                                                <label class="form-label text-primary small fw-bolder">Select Employee For Leave Status</label>
                                                <select class="form-select form-select-sm mb-2" @onchange="OnStaffChangedHandler">
                                                    <option value="0">-- Select Employee --</option>
                                                    @foreach (var s in Employees)
                                                    {
                                                        <option value="@s.StaffID">@s.StaffName</option>
                                                    }
                                                </select>

                                                <label class="form-label text-success small fw-bold">Select Status & DB click header</label>
                                                <select class="form-select form-select-sm mt-1" @bind="SelectedStatus">
                                                    <option value="">-- Select Option --</option>
                                                    <option value="P">P</option>
                                                    <option value="L">L</option>
                                                    <option value="A">A</option>
                                                    <option value="H">H</option>
                                                    <option value="W">W</option>
                                                    <option value="O">O</option>

                                                    @* <option value="N">N</option>
                                                    <option value="M">M</option> *@
                                                </select>

                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <!-- CARD 3 -->
                                <div class="col-lg-4 col-md-6 mb-3">
                                    <div class="card shadow-sm h-100">

                                        <div class="card-header" style="background-color:#808080; color:white;">
                                            <span class="fw-bold small">Mark Holidays</span>
                                        </div>

                                        <div class="card-body p-2">
                                            @if (AttendanceVM.CalendarHolidayList?.Any() == true)
                                            {
                                                @foreach (var row in AttendanceVM.CalendarHolidayList)
                                                {
                                                    <div class="d-flex align-items-center mb-1">
                                                        <div style="width:60px; font-weight:bold;">
                                                            @row.WeekDay.ToString().Substring(0, 3)
                                                        </div>

                                                        @foreach (var d in row.Days)
                                                        {
                                                            <div style="width:60px;">
                                                                <label class="form-check-label">
                                                                    <input type="checkbox" class="form-check-input"
                                                                           checked="@d.IsChecked"
                                                                           @onchange="(e) => OnHolidayCheckboxChanged(d.Day, (bool)e.Value)" />

                                                                    @d.Day
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="text-muted small">
                                                    Select Year & Month to load calendar.
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">

                                <!-- Employee Type -->
                                <div class="d-flex flex-wrap align-items-center gap-2">

                                    <label class="fw-bold mb-0 text-dark">
                                        👨‍💼 Employee Type
                                    </label>

                                    <InputRadioGroup @bind-Value="SelectedEmployeeType">

                                        <div class="row g-2">

                                            <!-- ON ROLE -->
                                            <div class="col-6 col-md-auto">

                                                <label class="d-flex align-items-center justify-content-center gap-1
                                                                          px-2 py-2 rounded border
                                                                          bg-primary-subtle text-primary
                                                                          fw-semibold small w-100">

                                                    <InputRadio Value='("On Role")'
                                                                class="d-none" />

                                                    <span>💼</span>
                                                    <span>On Role</span>

                                                </label>

                                            </div>

                                            <!-- TRAINEE -->
                                            <div class="col-6 col-md-auto">

                                                <label class="d-flex align-items-center justify-content-center gap-1
                                                                          px-2 py-2 rounded border
                                                                          bg-success-subtle text-success
                                                                          fw-semibold small w-100">

                                                    <InputRadio Value='("Trainee")'
                                                                class="d-none" />

                                                    <span>🎓</span>
                                                    <span>Trainee</span>

                                                </label>

                                            </div>

                                            <!-- OUT SOURCED -->
                                            <div class="col-12 col-md-auto">

                                                <label class="d-flex align-items-center justify-content-center gap-1
                                                                          px-2 py-2 rounded border
                                                                          bg-danger-subtle text-danger
                                                                          fw-semibold small w-100">

                                                    <InputRadio Value='("Out Sourced")'
                                                                class="d-none" />

                                                    <span>🌐</span>
                                                    <span>Out Sourced</span>

                                                </label>

                                            </div>

                                        </div>

                                    </InputRadioGroup>
                                </div>

                                <div class="row g-2 align-items-center">

                                    <!-- In Time -->
                                    <div class="col-12 col-sm-auto">

                                        <div class="d-flex align-items-center gap-2">

                                            <label class="fw-semibold text-primary small mb-0">
                                                InTime
                                            </label>

                                            <input type="text"
                                                   class="form-control form-control-sm"
                                                   style="width:85px"
                                                   @bind="InTime"
                                                   placeholder="HH:mm" />

                                        </div>

                                    </div>

                                    <!-- Out Time -->
                                    <div class="col-12 col-sm-auto">

                                        <div class="d-flex align-items-center gap-2">

                                            <label class="fw-semibold text-danger small mb-0">
                                                OutTime
                                            </label>

                                            <input type="text"
                                                   class="form-control form-control-sm"
                                                   style="width:85px"
                                                   @bind="OutTime"
                                                   placeholder="HH:mm" />

                                        </div>

                                    </div>


                                    <div class="col-12 col-sm-auto ms-sm-auto">
                                        <button type="button"
                                                class="btn btn-success btn-sm w-100 w-sm-auto mb-0"
                                                @onclick="UpdateAllTimes">
                                            Update
                                        </button>
                                    </div>

                                    <!-- Excel Upload -->
                                    <div class="col-12 col-sm-auto ms-sm-auto">

                                        <label class="btn btn-primary btn-sm w-100 w-sm-auto mb-0">

                                            <i class="bi bi-upload me-1"></i>
                                            Excel Import

                                            <InputFile OnChange="HandleFileSelected"
                                                       accept=".xlsx,.xls,.xlsm"
                                                       class="d-none" />

                                        </label>
                                    </div>
                                </div>
                            </div>


                            <!-- ATTENDANCE GRID -->
                            <div class="card mt-3 shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Attendance Sheet</span>
                                </div>
                                <div class="attendance-wrapper">
                                    <table class="attendance-table table table-bordered table-sm mb-0">
                                        <thead class="custom-blue">
                                            <tr>
                                                <th class="sticky-col sl-col">Sl</th>
                                                <th class="sticky-col name-col">Name</th>

                                                @foreach (var d in Days.Where(d => d <= AttendanceVM.TotalDays))
                                                {
                                                    <th class="day-col text-center bg-success text-white"
                                                        @ondblclick="() => OnHeaderDoubleClick(d)">
                                                        @d
                                                    </th>
                                                }

                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (AttendanceVM.EmployeeList != null)
                                            {
                                                int sl = 1;

                                                foreach (var emp in AttendanceVM.EmployeeList)
                                                {
                                                    var isSelected = emp.StaffId == HighlightedStaffId;
                                                    <!-- STATUS ROW -->
                                                    <tr>

                                                        <td class="sticky-col sl-col @(isSelected ? "bg-primary fw-bold text-white" : "")">
                                                            @sl
                                                        </td>
                                                        <td class="sticky-col name-col fw-bold @(isSelected ? "bg-primary fw-bold text-white" : "")">
                                                            @*  @emp.Name *@
                                                             @emp.Name (@emp.StaffId)
                                                           
                                                        </td>
                                                        
                                                        @foreach (var d in GetVisibleDays())
                                                        {
                                                            var status = emp.DailyStatus.ContainsKey(d)
                                                            ? emp.DailyStatus[d]
                                                            : "";

                                                            var mappedStatus = MapStatus(status, biometricExcelSetting);
                                                            var isFuture = IsFutureDay(d);

                                                            <td class="day-col
                                                                        @(mappedStatus == "P" ? "status-present" : "")
                                                                        @(mappedStatus == "A" ? "status-absent" : "")
                                                                        @(mappedStatus == "L" ? "status-leave" : "")
                                                                        @(mappedStatus == "H" ? "status-holiday" : "")
                                                                        @(mappedStatus == "W" ? "status-weekoff" : "")
                                                                        @(mappedStatus == "O" ? "status-onduty" : "")">

                                                               @*  
                                                                @(mappedStatus == "M" ? "status-halfdayleave" : "") 
                                                                @(mappedStatus == "N" ? "status-halfdayabsent" : "")*@
                                                               
                                                                <input type="text"
                                                                       maxlength="5"
                                                                       class="form-control text-center p-0"
                                                                       @bind-value="emp.DailyStatus[d]"
                                                                       @bind-value:event="onchange"
                                                                       @bind-value:after="async () => await ValidateStatus(emp, d)"
                                                                       disabled="@isFuture" />
                                                                
                                                            </td>
                                                        }
                                                    </tr>

                                                    <tr class="bg-light">

                                                        <td class="sticky-col sl-col"></td>
                                                        <td class="sticky-col name-col text-primary">InTime</td>

                                                        @foreach (var d in GetVisibleDays())
                                                        {
                                                            var isFuture = IsFutureDay(d);

                                                            <td class="day-col @(isFuture ? "bg-light" : "")">
                                                                <input class="form-control text-center"
                                                                       disabled="@isFuture"
                                                                       @bind-value="emp.InTime[d]"
                                                                       @bind-value:event="oninput"
                                                                       @onblur="async () => await OnTimeChanged(emp, d, true)"
                                                                       @onfocus="async () =>
                                                                       {
                                                                           if (!isFuture && string.IsNullOrWhiteSpace(emp.InTime[d]))
                                                                           {
                                                                               emp.InTime[d] = InTime;
                                                                           }
                                                                       }" />
                                                            </td>
                                                        }

                                                    </tr>


                                                    <tr>

                                                        <td class="sticky-col sl-col"></td>

                                                        <td class="sticky-col name-col text-primary">
                                                            OutTime
                                                        </td>

                                                        @foreach (var d in GetVisibleDays())
                                                        {
                                                            var isFuture = IsFutureDay(d);

                                                            <td class="day-col @(isFuture ? "bg-light" : "")">
                                                                <input class="form-control text-center"
                                                                       disabled="@isFuture"
                                                                       @bind-value="emp.OutTime[d]"
                                                                       @bind-value:event="oninput"
                                                                       @onblur="async () => await OnTimeChanged(emp, d, false)"
                                                                       @onfocus="async () =>
                                                                       {
                                                                           if (!isFuture && string.IsNullOrWhiteSpace(emp.OutTime[d]))
                                                                           {
                                                                               emp.OutTime[d] = OutTime;
                                                                           }
                                                                       }" />
                                                            </td>
                                                        }

                                                    </tr>

                                                    <!-- OT ROW -->
                                                    <tr class="@(emp.OtCount ? "" : "table-secondary")">
                                                        <td class="sticky-col sl-col"></td>

                                                        <td class="sticky-col name-col text-primary">
                                                            OT

                                                            @if (!emp.OtCount)
                                                            {
                                                                <span class="badge bg-secondary ms-2">Disabled</span>
                                                            }
                                                        </td>

                                                        @foreach (var d in GetVisibleDays())
                                                        {
                                                            <td class="day-col">
                                                                @*  <input class="form-control text-center"
                                                                       value="@(emp.OtCount? GetOT(emp, d) : "0")"
                                                                       readonly /> *@
                                                                <input class="form-control text-center"
                                                                       value="@GetOT(emp, d)"
                                                                       readonly />
                                                            </td>
                                                        }
                                                    </tr>

                                                    sl++;
                                                }
                                            }
                                        </tbody>
                                    </table>
