    private async Task LoadEmployeesAndBuildGrid()
    {
        AttendanceVM.EmployeeList = new List<EmployeeAttendanceRow>();

        Employees = await LoadAllStaff();
        FilteredEmployees = Employees;

        if (AttendanceVM.MonthId <= 0 || AttendanceVM.Year <= 0)
        {
            BuildEmployeeGridFromFiltered();
            StateHasChanged();
            return;
        }

        var detailRows = await _attendanceService
            .GetAttendanceByMonthYearAsync(
                AttendanceVM.MonthId,
                AttendanceVM.Year,
                SelectedEmployeeType);

        // 🔥 Keep only active staff attendance
        var activeIds = Employees.Select(x => x.StaffID).ToHashSet();

        detailRows = detailRows
            .Where(x => activeIds.Contains(x.StaffId))
            .ToList();

        if (detailRows.Any())
        {
            BuildGridFromSavedData(detailRows);
            RestoreHolidayChecks();
        }
        else
        {
            BuildEmployeeGridFromFiltered();
        }

        StateHasChanged();
    }

    private async Task OnHeaderDoubleClick(int day)
    {
        if (IsFutureMonth())
        {
            await _js.ToastrWarning("You cannot enter attendance for future month");
            return;
        }

        if (IsFutureDay(day))
        {
            await _js.ToastrWarning("Future date not allowed");
            return;
        }
        string status = string.IsNullOrWhiteSpace(SelectedStatus) ? "P" : SelectedStatus;
       
        // Check Approved Leave
        List<string> skippedEmployees = new();

        foreach (var emp in AttendanceVM.EmployeeList)
        {
            bool hasApprovedLeave = await HasApprovedLeaveAsync(emp.StaffId, day);

            if (hasApprovedLeave)
            {
                var mapped = MapStatus(status, biometricExcelSetting);

                if (mapped != "L" && mapped != "A")
                {
                    skippedEmployees.Add(emp.Name);
                    continue;
                }
            }

            emp.DailyStatus[day] = IsHoliday(day) ? "H" : status;

            if (MapStatus(emp.DailyStatus[day], biometricExcelSetting) == "L")
            {
                emp.InTime[day] = "";
                emp.OutTime[day] = "";
                emp.OT[day] = 0;
            }
        }

        if (skippedEmployees.Any())
        {
            await _js.ToastrWarning(
                $"Approved leave exists for: {string.Join(", ", skippedEmployees)}.");
        }

        SyncHolidayFromGrid(day);
    }

    private string GetInTime(EmployeeAttendanceRow emp, int day)
    {
        return emp.InTime.TryGetValue(day, out var v) ? v : "";
    }

    private string GetOutTime(EmployeeAttendanceRow emp, int day)
    {
        return emp.OutTime.TryGetValue(day, out var v) ? v : "";
    }


    private async Task OnTimeChanged(EmployeeAttendanceRow emp, int day, bool isInTime)
    {
        // MONTH VALIDATION
        if (AttendanceVM.MonthId <= 0)
        {
            await _js.ToastrWarning("Please select month first");

            emp.InTime[day] = string.Empty;
            emp.OutTime[day] = string.Empty;

            StateHasChanged();
            return;
        }

        // FUTURE MONTH
        if (IsFutureMonth())
        {
            await _js.ToastrWarning("You cannot enter attendance for future month");
            return;
        }

        // FUTURE DAY
        if (IsFutureDay(day))
        {
            await _js.ToastrWarning("Future date attendance is not allowed");
            return;
        }

        // STATUS CHECK
        var status = emp.DailyStatus.TryGetValue(day, out var st) ? st : "";
        var mappedStatus = MapStatus(status, biometricExcelSetting);

        // Status is mandatory
        if (string.IsNullOrWhiteSpace(status))
        {
            emp.InTime[day] = "";
            emp.OutTime[day] = "";
            emp.OT[day] = 0;

            if (!_statusWarningShown)
            {
                _statusWarningShown = true;
                await _js.ToastrWarning("Please fill Attendance Status first.");
            }

            StateHasChanged();
            return;
        }

        // A or L status
        if (mappedStatus == "A" || mappedStatus == "L")
        {
            emp.InTime[day] = "";
            emp.OutTime[day] = "";
            emp.OT[day] = 0;

            if (!_aOrLWarningShown)
            {
                _aOrLWarningShown = true;
                await _js.ToastrWarning("In Time and Out Time are not allowed for A or L.");
            }

            StateHasChanged();
            return;
        }


        // PICK FIELD
        var input = isInTime ? emp.InTime[day] : emp.OutTime[day];

        if (!string.IsNullOrWhiteSpace(input))
        {
            // Keep only digits
            var digits = new string(input.Where(char.IsDigit).ToArray());

            // Maximum 4 digits
            if (digits.Length > 4)
                digits = digits.Substring(0, 4);

            string formatted = "";

            switch (digits.Length)
            {
                case 0:
                    formatted = "";
                    break;

                case 1:
                    formatted = digits;
                    break;

                case 2:
                    formatted = digits;
                    break;

                case 3:
                    formatted = $"{digits.Substring(0, 2)}:{digits.Substring(2, 1)}";
                    break;

                case 4:
                    formatted = $"{digits.Substring(0, 2)}:{digits.Substring(2, 2)}";
                    break;
            }

            // Assign formatted value
            if (isInTime)
                emp.InTime[day] = formatted;
            else
                emp.OutTime[day] = formatted;

            // Don't calculate until full HH:mm entered
            if (digits.Length < 4)
            {
                StateHasChanged();
                return;
            }

            // Validate HH:mm
            if (!TimeSpan.TryParse(formatted, out var ts))
            {
                return;
            }

            if (ts.Hours > 23 || ts.Minutes > 59)
            {
                await _js.ToastrWarning("Invalid Time");

                if (isInTime)
                    emp.InTime[day] = "";
                else
                    emp.OutTime[day] = "";

                StateHasChanged();
                return;
            }
