    private void BuildGridFromSavedData(List<AttendanceVM> dbRows)
    {
        var activeIds = Employees.Select(x => x.StaffID).ToHashSet();

        AttendanceVM.EmployeeList = new List<EmployeeAttendanceRow>();

        foreach (var s in dbRows)
        {
            // 🔥 BLOCK INACTIVE STAFF
            if (!activeIds.Contains(s.StaffId))
                continue;

            var staffMaster = Employees.FirstOrDefault(x => x.StaffID == s.StaffId);

            var row = new EmployeeAttendanceRow
            {
                StaffId = s.StaffId,
                Name = s.StaffName,
                WorkingHrs = s.WorkingHrs,
                AttendanceSource = s.AttendanceSource,

                // ✅ FIXED: TAKE FROM MASTER STAFF (MOST RELIABLE)
                OtCount = staffMaster?.OtCount ?? false,
                DailyStatus = new(),
                InTime = new(),
                OutTime = new(),
                OT = new()
            };

            for (int d = 1; d <= AttendanceVM.TotalDays; d++)
            {
                row.DailyStatus[d] = "";
                row.InTime[d] = "";
                row.OutTime[d] = "";
                row.OT[d] = 0m;
            }

            var statusArr = (s.Ldetail ?? "").Split(',');
            var inArr = (s.InTime ?? "").Split(',');
            var outArr = (s.OutTime ?? "").Split(',');
            var otArr = (s.OtDetail ?? "").Split(',');

            for (int d = 1; d <= AttendanceVM.TotalDays; d++)
            {
                if (d <= statusArr.Length)
                    row.DailyStatus[d] = statusArr[d - 1];

                if (d <= inArr.Length)
                    row.InTime[d] = inArr[d - 1];

                if (d <= outArr.Length)
                    row.OutTime[d] = outArr[d - 1];

                if (d <= otArr.Length &&
                    decimal.TryParse(otArr[d - 1], out var ot))
                {
                    row.OT[d] = ot;
                }
            }

            AttendanceVM.EmployeeList.Add(row);
        }
    }


    private void RestoreSelectedStatusFromGrid()
    {
        if (AttendanceVM.EmployeeList == null || !AttendanceVM.EmployeeList.Any())
            return;

        // Take first non-empty, non-holiday status
        SelectedStatus = AttendanceVM.EmployeeList
            .SelectMany(e => e.DailyStatus.Values)
            .FirstOrDefault(s => !string.IsNullOrWhiteSpace(s) && s != "H")
            ?? "";
    }

    private void RestoreHolidayChecks()
    {
        if (AttendanceVM?.EmployeeList == null || !AttendanceVM.EmployeeList.Any())
            return;

        foreach (var group in AttendanceVM.CalendarHolidayList)
        {
            foreach (var day in group.Days)
            {
                day.IsChecked = AttendanceVM.EmployeeList.Any(emp =>
                    emp.DailyStatus.TryGetValue(day.Day, out var status) &&
                    MapStatus(status, biometricExcelSetting) == "H");
            }
        }

        StateHasChanged();
    }

    private decimal CalculateOT(string inTimeStr, string outTimeStr, decimal minimumWorkingHrs)
    {
        var inTime = ParseTime(inTimeStr);
        var outTime = ParseTime(outTimeStr);

        if (!inTime.HasValue || !outTime.HasValue)
            return 0;

        var actualIn = inTime.Value;
        var actualOut = outTime.Value;

        // Night shift support
        if (actualOut < actualIn)
            actualOut = actualOut.AddDays(1);

        var workedHours = (decimal)(actualOut - actualIn).TotalHours;

        var ot = workedHours - minimumWorkingHrs;
        return ot > 0 ? Math.Round(ot, 2) : 0;
    }

    private static decimal ParseWorkingHours(string? workingHrs)
    {
        if (string.IsNullOrWhiteSpace(workingHrs))
            return 0;

        // HH:mm format (e.g., "08:00")
        if (TimeSpan.TryParse(workingHrs, out var ts))
            return (decimal)ts.TotalHours;

        // Plain number format (e.g., "7.5")
        if (decimal.TryParse(workingHrs, NumberStyles.Number, CultureInfo.InvariantCulture, out var hrs))
            return hrs;

        return 0;
    }

    private async Task OnEmployeeTypeChanged(string value)
    {
        SelectedEmployeeType = value;
        await LoadEmployeesAndBuildGrid();
