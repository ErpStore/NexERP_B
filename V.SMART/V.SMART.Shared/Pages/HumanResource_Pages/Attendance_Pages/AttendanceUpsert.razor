    private async Task UpdateAllTimes()
    {
        _statusWarningShown = false;
        _aOrLWarningShown = false;
        if (AttendanceVM.EmployeeList == null)
            return;

        foreach (var emp in AttendanceVM.EmployeeList)
        {
            foreach (var d in GetVisibleDays())
            {
                if (IsFutureDay(d))
                    continue;

                var status = emp.DailyStatus.TryGetValue(d, out var st) ? st : "";

                // Skip auto-fill for Holiday
                if (status == "H" || status == "L")
                {
                    emp.InTime[d] = "";
                    emp.OutTime[d] = "";
                    emp.OT[d] = 0;
                    continue;
                }

                // InTime
                emp.InTime[d] = InTime ?? "";

                // OutTime
                emp.OutTime[d] = OutTime ?? "";

                // Recalculate if needed
                await OnTimeChanged(emp, d, true);
                await OnTimeChanged(emp, d, false);
            }
        }

        StateHasChanged();
    }

    private async Task ValidateStatus(EmployeeAttendanceRow emp, int day)
    {
        var value = emp.DailyStatus[day]?.Trim().ToUpper() ?? "";

        if (!IsValidStatus(value))
        {
            emp.DailyStatus[day] = "";

            await _js.ToastrWarning("Invalid attendance code.");

            StateHasChanged();
            return;
        }

        // ==========================================
        // CHECK APPROVED LEAVE FOR THIS DATE
        // ==========================================
        bool hasApprovedLeave = await HasApprovedLeaveAsync(emp.StaffId, day);

        if (hasApprovedLeave)
        {
            var mapped = MapStatus(value, biometricExcelSetting);

            // Only Leave or Absent is allowed
            if (mapped != "L" && mapped != "A")
            {
                emp.DailyStatus[day] = "";

                await _js.ToastrWarning("Leave is already approved for this date. Only Leave or Absent is allowed.");

                StateHasChanged();
                return;
            }
        }


        //leave Balance Validation
        if (await IsLeaveBalanceExceeded(emp.StaffId, value))
        {
            emp.DailyStatus[day] = "";

            await _js.ToastrWarning($"{value} leave balance exceeded.");

            StateHasChanged();
            return;
        }

        emp.DailyStatus[day] = value;

        // NEW: If it is any Leave code (SL, CL, EL, LOP...)
        if (MapStatus(value, biometricExcelSetting) == "L")
        {
            emp.InTime[day] = "";
            emp.OutTime[day] = "";
            emp.OT[day] = 0;
        }

        StateHasChanged();
    }

    private bool IsValidStatus(string status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return true;

        status = status.Trim().ToUpper();

        return IsMatch(status, biometricExcelSetting.P)
            || IsMatch(status, biometricExcelSetting.A)
            || IsMatch(status, biometricExcelSetting.L)
            || IsMatch(status, biometricExcelSetting.H)
            || IsMatch(status, biometricExcelSetting.W)
            || IsMatch(status, biometricExcelSetting.O);
            
            // || IsMatch(status, biometricExcelSetting.M)
            // || IsMatch(status, biometricExcelSetting.N);
    }

    private bool IsMatch(string value, string dbValue)
    {
        if (string.IsNullOrWhiteSpace(dbValue))
            return false;

        return dbValue
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim().ToUpper())
            .Contains(value.Trim().ToUpper());
    }

    private string MapStatus(string status, BiometricExcelSetting setting)
    {
        if (IsMatch(status, setting.P))
            return "P";

        if (IsMatch(status, setting.A))
            return "A";

        if (IsMatch(status, setting.L))
            return "L";

        if (IsMatch(status, setting.H))
            return "H";

        if (IsMatch(status, setting.W))
            return "W";

        // if (IsMatch(status, setting.M))
        //     return "M";

        // if (IsMatch(status, setting.N))
        //     return "N";

        if (IsMatch(status, setting.O))
            return "O";

        return status;
    }

    private async Task<bool> HasApprovedLeaveAsync(int staffId, int day)
    {
        var attendanceDate = new DateTime(
            AttendanceVM.Year,
            AttendanceVM.MonthId,
            day);

        return await _unitOfWork.LeaveApplications
            .GetQueryable()
            .AnyAsync(x =>
                x.EmployeeID == staffId &&
                x.LeaveStatus == "Approved" &&
                x.FromDate.Date <= attendanceDate.Date &&
                x.ToDate.Date >= attendanceDate.Date);
    }

    private async Task<bool> IsLeaveBalanceExceeded(int employeeId, string status)
    {
        status = status?.Trim().ToUpper() ?? "";

        if (string.IsNullOrWhiteSpace(status))
            return false;

        // Determine whether it's half-day
        bool isHalfDay = status.StartsWith("1/2");

        // Get actual attendance code
        string attendanceCode = isHalfDay
            ? status.Replace("1/2", "")
            : status;

        // Find Leave Type
        var leaveType = await leaveTypeService.GetByAttendanceCode(attendanceCode);

        if (leaveType == null)
            return false;

        // Unpaid leave - no balance validation
        if (!leaveType.PaidLeave && leaveType.DeductSalary)
            return false;

        var balance = await leaveBalanceService.GetBalanceAsync(
            employeeId,
            leaveType.LeaveTypeId,
            AttendanceVM.Year);

        if (balance == null)
            return true;

        decimal used = 0m;

        var employee = AttendanceVM.EmployeeList
            .FirstOrDefault(x => x.StaffId == employeeId);

        if (employee == null)
            return true;

        foreach (var value in employee.DailyStatus.Values)
        {
            string s = (value ?? "").Trim().ToUpper();

            // Full-day leave
            if (s == attendanceCode)
            {
                used += 1m;
            }
            // Half-day leaveUpdateLeaveBalanceFromAttendanceAsync
            else if (s.StartsWith("1/2") &&
                     s.Substring(3).Equals(attendanceCode, StringComparison.OrdinalIgnoreCase))
            {
                used += 0.5m;
            }
        }
        

        return used > balance.Balance;
    }

