    }


    private void OnInTimeClick(EmployeeAttendanceRow emp, int day)
    {
        if (day > AttendanceVM.TotalDays) return;

        if (!emp.InTime.ContainsKey(day) || string.IsNullOrWhiteSpace(emp.InTime[day]))
            emp.InTime[day] = "09:00";

        CalculateOTForDay(emp, day);
        StateHasChanged();
    }


    private async Task CalculateOTForDay(EmployeeAttendanceRow emp, int day)
    {
        // Ensure keys exist
        if (!emp.InTime.ContainsKey(day))
            emp.InTime[day] = "";

        if (!emp.OutTime.ContainsKey(day))
            emp.OutTime[day] = "";

        if (!emp.DailyStatus.ContainsKey(day))
            emp.DailyStatus[day] = "";

        var inTime = emp.InTime[day];
        var outTime = emp.OutTime[day];
        var status = emp.DailyStatus[day];

        // For Absent and Leave
        if (status == "A" || status == "L")
        {
            emp.InTime[day] = "";
            emp.OutTime[day] = "";
            emp.OT[day] = 0;

            StateHasChanged();
            return;
        }

        // If InTime or OutTime is empty, clear OT
        if (string.IsNullOrWhiteSpace(inTime) || string.IsNullOrWhiteSpace(outTime))
        {
            emp.OT[day] = 0;
            StateHasChanged();
            return;
        }

        // Status mandatory
        if (string.IsNullOrWhiteSpace(status))
        {
            emp.InTime[day] = "";
            emp.OutTime[day] = "";
            emp.OT[day] = 0;

            await _js.ToastrWarning("Please fill Attendance Status first.");
            StateHasChanged();
            return;
        }

        // Validate times
        if (!TimeSpan.TryParse(inTime, out var inT) ||
            !TimeSpan.TryParse(outTime, out var outT))
        {
            emp.OT[day] = 0;
            StateHasChanged();
            return;
        }

        bool isHoliday = status == "H";

        // Overnight shift
        if (outT < inT)
            outT = outT.Add(TimeSpan.FromDays(1));

        decimal totalHours = (decimal)(outT - inT).TotalHours;

        if (isHoliday)
        {
            // Holiday = all hours are OT
            emp.OT[day] = totalHours;
        }
        else
        {
            decimal minWorkingHours = ParseWorkingHours(emp.WorkingHrs);

            if (minWorkingHours <= 0)
            {
                emp.OT[day] = 0;
                StateHasChanged();
                return;
            }

            emp.OT[day] = Math.Max(0, totalHours - minWorkingHours);
        }

        StateHasChanged();
    }

    private string GetOT(EmployeeAttendanceRow emp, int day)
    {
        if (!emp.OtCount)
            return "0";

        return emp.OT.TryGetValue(day, out var ot) && ot > 0
            ? ot.ToString("0.##")
            : "";
    }

