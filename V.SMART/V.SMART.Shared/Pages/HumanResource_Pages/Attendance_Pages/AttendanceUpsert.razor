    private bool IsFutureDate(int day)
    {
        if (AttendanceVM.Year <= 0 || AttendanceVM.MonthId <= 0)
            return false;

        int maxDay = DateTime.DaysInMonth(AttendanceVM.Year, AttendanceVM.MonthId);

        if (day < 1 || day > maxDay)
            return false;

        var date = new DateTime(AttendanceVM.Year, AttendanceVM.MonthId, day);

        return date.Date > DateTime.Today;
    }

    private async Task UpsertAttendance()
    {
        try
        {
            isProcessing = true;

            var master = new AttendanceVM
            {
                Id = AttendanceVM.Id,
                Year = AttendanceVM.Year,
                MonthId = AttendanceVM.MonthId,
                Reporting = SelectedEmployeeType,
                CreatedDate = DateTime.Now,
                BioMetricId = AttendanceVM.BioMetricId,
                AttendanceSource = AttendanceVM.AttendanceSource,
                TotalDays = AttendanceVM.TotalDays
            };

            var detailRows = new List<AttendanceVM>();

            foreach (var emp in AttendanceVM.EmployeeList)
            {
                for (int d = 1; d <= master.TotalDays; d++)
                {
                    // Ignore future dates
                    if (IsFutureDate(d))
                        continue;

                    string inTime = emp.InTime.TryGetValue(d, out var it)
                        ? (it ?? "").Trim()
                        : "";

                    string outTime = emp.OutTime.TryGetValue(d, out var ot)
                        ? (ot ?? "").Trim()
                        : "";

                    string status = emp.DailyStatus.TryGetValue(d, out var st)
                        ? st
                        : "";

                    // Upload mode:
                    // If status is empty, derive it from In/Out.
                    if (AttendanceVM.AttendanceSource != "Manual")
                    {
                        if (string.IsNullOrWhiteSpace(status))
                        {
                            status = (!string.IsNullOrWhiteSpace(inTime) &&
                                      !string.IsNullOrWhiteSpace(outTime))
                                        ? "P"
                                        : "";
                        }
                    }

                    status = status?.Trim().ToUpper() ?? "";


                    if (string.IsNullOrWhiteSpace(status))
                        status = "";

                    // Check leave balance
                    //Pooja commented for multiple emp upload
                    if (await IsLeaveBalanceExceeded(emp.StaffId, status))
                    {
                        await _js.ToastrWarning(
                            $"{emp.Name} does not have enough {status} balance (Day {d}).");

                        isProcessing = false;
                        return;
                    }
                   
                    if (MapStatus(status, biometricExcelSetting) == "P")
                    {
                        if (string.IsNullOrWhiteSpace(inTime) ||
                            string.IsNullOrWhiteSpace(outTime))
                        {
                            await _js.ToastrWarning(
                                $"Missing In/Out Time for Day {d} - {emp.Name}");

                            return;
                        }
                    }

                    // Calculate OT if not already calculated
                    if (!emp.OT.ContainsKey(d))
                        emp.OT[d] = 0;

                    if (!string.IsNullOrWhiteSpace(inTime) &&
                        !string.IsNullOrWhiteSpace(outTime))
                    {
                        CalculateOTForDay(emp, d);
                    }

                    detailRows.Add(new AttendanceVM
                    {
                        StaffId = emp.StaffId,
                        StaffRefId = emp.StaffRefId,
                        Day = d,
                        Ldetail = status,
                        InTime = inTime,
                        OutTime = outTime,
                        OtDetail = emp.OT[d].ToString(),
                        AttendanceSource = AttendanceVM.AttendanceSource
                    });
                }
            }
            foreach (var emp in AttendanceVM.EmployeeList)
            {
                Console.WriteLine($"StaffId={emp.StaffId}");
                Console.WriteLine($"StaffRefId={emp.StaffRefId}");
                Console.WriteLine($"Name={emp.Name}");
            }

            await _attendanceService.UpsertAttendanceAsync(master, detailRows);

            await leaveBalanceService.UpdateLeaveBalanceFromAttendanceAsync(AttendanceVM.Year);

            await _js.ToastrSuccess("Attendance saved successfully.");

            _navigationManager.NavigateTo("/attendanceList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertAttendance failed.");

            await _js.ToastrError("Error saving attendance.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string NormalizeStatus(string status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return "A";

        status = status.Trim().ToUpper();

        if (status.Contains("P"))
            return "P";

        if (status.Contains("L"))
            return "L";

        if (status.Contains("H"))
            return "H";

        if (status.Contains("W"))
            return "W";

        if (status.Contains("O"))
           return "O";

        if (status.Contains("A"))
            return "A";

        return "A";
    }

    private async Task OnLeaveSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        try
        {
            LeaveHistoryList.Clear();

            foreach (var item in selectedItems)
            {
                LeaveHistoryList.Add(new EmployeeLeaveBalance
                {
                    EmployeeID =
                        item.ContainsKey("EmployeeID") &&
                        int.TryParse(
                            item["EmployeeID"]?.ToString(),
                            out var empId)
                        ? empId
                        : 0,

                    TotalAllocatedLeave =
                        item.ContainsKey("TotalAllocatedLeave") &&
                        decimal.TryParse(
                            item["TotalAllocatedLeave"]?.ToString(),
                            out var totalLeave)
                        ? totalLeave
                        : 0,

                    LeavesTaken =
                        item.ContainsKey("LeavesTaken") &&
                        decimal.TryParse(
                            item["LeavesTaken"]?.ToString(),
                            out var taken)
                        ? taken
                        : 0,

                    Balance =
                        item.ContainsKey("Balance") &&
                        decimal.TryParse(
                            item["Balance"]?.ToString(),
                            out var balance)
                        ? balance
                        : 0
                });
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "OnLeaveSelectedAsync failed.");

            await _js.ToastrError(
                "Error loading leave history.");
        }
    }


    private async Task HandleArrowKey(
    KeyboardEventArgs e,
    int staffId,
    int day,
    string rowType)
    {
        int row = AttendanceVM.EmployeeList.FindIndex(x => x.StaffId == staffId);

        if (row < 0)
            return;

        switch (e.Key)
        {
            case "ArrowRight":
                day++;
                break;

            case "ArrowLeft":
                day--;
                break;

            case "ArrowDown":
                row++;
                break;

            case "ArrowUp":
                row--;
                break;

            default:
                return;
        }

        if (row < 0 || row >= AttendanceVM.EmployeeList.Count)
            return;

        if (day < 1 || day > AttendanceVM.TotalDays)
            return;

        int newStaffId = AttendanceVM.EmployeeList[row].StaffId;

        await _js.InvokeVoidAsync(
            "focusAttendanceCell",
            $"{rowType}-{newStaffId}-{day}");
    }
}
