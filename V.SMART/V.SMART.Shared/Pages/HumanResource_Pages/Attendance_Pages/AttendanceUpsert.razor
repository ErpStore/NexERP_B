    private List<int> FindAllRows(DataTable table, string text)
    {
        var rows = new List<int>();

        for (int r = 0; r < table.Rows.Count; r++)
        {
            for (int c = 0; c < table.Columns.Count; c++)
            {
                var value = GetCell(table.Rows[r], c);

                if (!string.IsNullOrWhiteSpace(value) &&
                    value.Trim().Equals(text, StringComparison.OrdinalIgnoreCase))
                {
                    rows.Add(r);
                    break;
                }
            }
        }

        return rows;
    }

    private int FindFirstDayColumn(DataTable table, int headerRow)
    {
        for (int c = 0; c < table.Columns.Count; c++)
        {
            var val = table.Rows[headerRow][c]?.ToString();

            if (TimeSpan.TryParse(val, out _) || val.Contains(":"))
            {
                return c; // first time value column
            }
        }

        return -1;
    }

    private string GetCell(DataRow row, int col)
    {
        if (row == null || col < 0 || col >= row.ItemArray.Length)
            return "";

        return row[col]?.ToString()?.Trim() ?? "";
    }

    private decimal ConvertOtToDecimal(string otValue)
    {
        if (string.IsNullOrWhiteSpace(otValue))
            return 0;

        if (TimeSpan.TryParse(otValue, out var ts))
            return (decimal)ts.TotalHours;

        if (decimal.TryParse(otValue, out var dec))
            return dec;

        return 0;
    }


    private async Task ProcessAttendanceExcelUploadAsync(IBrowserFile file)
    {
        try
        {
            if (AttendanceVM.Year == 0 || AttendanceVM.MonthId == 0)
            {
                await _js.ToastrError("Select Year & Month");
                return;
            }
            var setting = await biometricExcelSettingService.GetBiometricExcelSetAsync();
            if (setting == null)
            {
                await _js.ToastrError("Biometric Excel Settings not configured.");
                return;
            }
            using var stream = file.OpenReadStream(10_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
            using var reader = ExcelReaderFactory.CreateReader(ms);
            var ds = reader.AsDataSet();
            if (ds.Tables.Count == 0)
            {
                await _js.ToastrError("Excel file is empty.");
                return;
            }
            var table = ds.Tables[0];

            // ============================
            // Validate Excel Month & Year
            // ============================

            string excelDateValue = GetCell(
                table.Rows[setting.MonthDateRow],
                setting.MonthDateColumn);

            if (string.IsNullOrWhiteSpace(excelDateValue))
            {
                await _js.ToastrError("Month/Date cell is empty in the Excel file.");
                return;
            }

            // Example Cell:
            // Attendance Report From Date: 01/01/2026 To Date: 31/01/2026

            var matches = Regex.Matches(
                excelDateValue,
                @"\b\d{1,2}/\d{1,2}/\d{4}\b");

            if (matches.Count == 0)
            {
                await _js.ToastrError("Unable to find the attendance month in the Excel file.");
                return;
            }

            // Take the first date (From Date)
            if (!DateTime.TryParse(matches[0].Value, out DateTime excelDate))
            {
                await _js.ToastrError("Invalid attendance date found in the Excel file.");
                return;
            }

            // Compare with selected Month & Year
            if (excelDate.Month != AttendanceVM.MonthId ||
                excelDate.Year != AttendanceVM.Year)
            {
                await _js.ToastrError(
                    $"Selected Month/Year ({AttendanceVM.MonthId}/{AttendanceVM.Year}) does not match Excel ({excelDate:MMMM yyyy}).");

                return;
            }

            List<int> inTimeRows = new();

            if (setting.InTimeNameStartRow > 0)
            {
                int labelCol = 0;   // Column where "InTime" is present

                for (int r = setting.InTimeNameStartRow; r < table.Rows.Count; r++)
                {
                    string value = GetCell(table.Rows[r], labelCol);

                    if (value.Trim().Equals(setting.InTimeName, StringComparison.OrdinalIgnoreCase))
                    {
                        inTimeRows.Add(r);
                    }
                }
            }
            else
            {
                inTimeRows = FindAllRows(table, setting.InTimeName);
            }

            if (inTimeRows == null || inTimeRows.Count == 0)
            {
                await _js.ToastrError("InTime row not found.");
                return;
            }

            int startCol = setting.InTimeDataStartCol;
            AttendanceVM.EmployeeList = new List<EmployeeAttendanceRow>();
            // GET EMPLOYEE CODE FROM EXCEL
            // // LOAD ATTENDANCE

            // // WORKING HOURS

            int totalDays = DateTime.DaysInMonth(AttendanceVM.Year, AttendanceVM.MonthId);

            AttendanceVM.TotalDays = totalDays;

            foreach (int inTimeRow in inTimeRows)
            {
                int employeeRow = inTimeRow + setting.EmpCodeIndexFromInTime; // -2
                int outTimeRow = inTimeRow + setting.OutTimeIndexFromInTime;
                int statusRow = inTimeRow + setting.StatusNameIndexFromInTime;
                int otRow = inTimeRow + setting.OTNameIndexFromInTime;
                int workHourRow = inTimeRow + setting.TotalWorkHrsIndexFromInTime;

                int employeeCol = setting.EmpIdColIndex;

                if (employeeRow < 0 || employeeRow >= table.Rows.Count)
                    continue;

                string employeeCode = GetCell(table.Rows[employeeRow], employeeCol)?.Trim() ?? "";

                Match match = Regex.Match(employeeCode, @"\d+");
                employeeCode = match.Success ? match.Value : "";

                // ============================
                // Employee Code
                // ============================
                if (string.IsNullOrWhiteSpace(employeeCode))
                    continue;

                // ============================
                // Find Staff
                // ============================

                var staff = await _unitOfWork.Staffs.GetQueryable()
                    .FirstOrDefaultAsync(x =>
                        x.StaffRefId == employeeCode ||
                        x.StaffID.ToString() == employeeCode);

                if (staff == null)
                {
                    await _js.ToastrWarning($"Staff not found : {employeeCode}");
                    continue;
                }

                // ============================
                // Create Employee
                // ============================

                var emp = new EmployeeAttendanceRow
                {
                    StaffId = staff.StaffID,
                    StaffRefId = staff.StaffRefId,
                    Name = staff.StaffName,
                    Reporting = staff.Reporting,
                    AttendanceSource = "Excel",
                    WorkingHrs = staff.WorkingHrs,
                    OtCount = staff.OtCount
                };

                // ============================
                // Initialize Days
                // ============================

                for (int d = 1; d <= totalDays; d++)
                {
                    emp.InTime[d] = "";
                    emp.OutTime[d] = "";
                    emp.OT[d] = 0;
                    emp.DailyStatus[d] = "";
                }

                // ============================
                // Load Attendance
                // ============================

                for (int day = 1; day <= totalDays; day++)
                {
                    int col = startCol + (day - 1);

                    if (col >= table.Columns.Count)
                        break;

                    // In Time
                    if (inTimeRow < table.Rows.Count)
                    {
                        emp.InTime[day] = GetCell(table.Rows[inTimeRow], col);
                    }

                    // Out Time
                    if (outTimeRow < table.Rows.Count)
                    {
                        emp.OutTime[day] = GetCell(table.Rows[outTimeRow], col);
                    }

                    // OT
                    if (otRow < table.Rows.Count)
                    {
                        emp.OT[day] = ConvertOtToDecimal(GetCell(table.Rows[otRow], col));
                    }

                    // Status
                    if (statusRow < table.Rows.Count)
                    {
                        string excelStatus = GetCell(table.Rows[statusRow], col).Trim();

                        if (!IsValidStatus(excelStatus))
                        {
                            await _js.ToastrError(
                                $"Attendance status '{excelStatus}' is not configured in Biometric Excel Settings.");

                            return;
                        }

                        // Use mapped status only for leave balance check
                        string mappedStatus = MapStatus(excelStatus, setting);

                        if (!await IsLeaveBalanceExceeded(emp.StaffId, mappedStatus))
                        {
                            // Store the ORIGINAL Excel value
                            emp.DailyStatus[day] = excelStatus;
                        }
                        else
                        {
                            emp.DailyStatus[day] = "";

                            await _js.ToastrWarning(
                                $"Employee {emp.Name}: {excelStatus} leave balance exceeded on {day}.");
                        }
                    }
                }

                // ============================
                // Working Hours
                // ============================

                if (workHourRow < table.Rows.Count)
                {
                    emp.WorkingHrs = string.Join(",",
                        Enumerable.Range(1, totalDays)
                            .Select(d =>
                            {
                                int col = startCol + (d - 1);

                                return col < table.Columns.Count
                                    ? GetCell(table.Rows[workHourRow], col)
                                    : "";
                            }));
                }

                // ============================
                // Add Employee
                // ============================

                AttendanceVM.EmployeeList.Add(emp);
            }
            // BIND GRID

            //AttendanceVM.EmployeeList = new List<EmployeeAttendanceRow> { emp };
            await InvokeAsync(StateHasChanged);
            await _js.ToastrSuccess("Excel uploaded successfully.");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            await _js.ToastrError($"Upload failed : {ex.Message}");
        }
    }

