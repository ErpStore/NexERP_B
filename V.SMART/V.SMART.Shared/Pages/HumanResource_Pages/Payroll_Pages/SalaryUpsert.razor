    #region Salary Operations
    private async Task UpsertSalary()
    {
        try
        {
            isProcessing = true;

            // VM → Entity
            var salaryEntity = Mapper.Map<Salary>(CurrentSalary);

            if (string.IsNullOrEmpty(salaryEntity.Dept))
            {
                await _js.ToastrError("Department is required.");
                return;
            }

            await salaryService.SaveSalaryAsync(salaryEntity);

            await _js.ToastrSuccess("Salary saved successfully.");

            await _js.ToastrSuccess("Salary saved successfully.");
            _navigationManager.NavigateTo("/salaryList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertSalary failed.");
            await _js.ToastrError("Error saving Salary.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void RecalculateEarnings()
    {
        // // 1. Calculate earnings
        salaryService.CalculateEarnings(CurrentSalary, HrMasterSetting);

        // // 2. Calculate deductions
        salaryService.CalculateDeductions(CurrentSalary,HrMasterSetting);
    }

