@page "/salary/create"
@page "/salary/update/{RowId:int}"

@using AutoMapper
@using MudBlazor
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IHumanResourceService.IEmployeeLoanService
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IHumanResourceService.IPayrollService
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IMasterServices.IHRMasterservice
@using V.SMART.Shared.Data.HumanResource.Salary
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.HumanResourceViewModel.SalaryViewModel
@using V.SMART.Shared.ViewModels.Settings

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject ISalaryService salaryService
@inject ILoggingService LoggingService
@inject IStaffLoanService staffLoanService
@inject IMapper Mapper
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject ILoggingService _logs
@inject ReportService _reportService
@inject ISalaryHeadPrintSettingService salaryHeadPrintSettingService
@inject IHRMasterService hrMasterService
@inject IBiometricExcelSettingService biometricExcelSettingService
@inject ILeaveTypeService leaveTypeService

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }

    .note-table {
        max-height: 260px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 6px;
    }

</style>

@if (isProcessing)
{
    <div class="position-fixed top-50 start-50 translate-middle d-flex align-items-center justify-content-center"
         style="width: 100vw; height: 100vh; background-color: rgba(255,255,255,0.5); z-index: 1050;">
        <img src="/_content/IQSMART.Shared/images/loading.gif" alt="Loading..." />
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-3 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@(CurrentSalary.RowId > 0 ? "Update Salary" : "Create Salary")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@SalFormBreadcrumbs" />

            <div class="card-body bg-light">

                <EditForm Model="CurrentSalary" OnValidSubmit="UpsertSalary">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-2 align-items-stretch">

                        <!-- CARD 1 -->
                        <div class="col-lg-4 col-md-12 mb-2">
                            <div class="card shadow-sm h-100">
                                <div class="card-header" style="background-color:#AA336A; color:white;">
                                    <span class="fw-bold small">Basic Information</span>
                                </div>

                                <div class="card-body p-2">
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Year</label>
                                            <select class="form-select" @bind="CurrentSalary.SalYear"
                                                    @bind:after="UpdateWorkingDays">
                                                <option value="0">-- Select Year --</option>
                                                @for (int year = 2023; year <= 2026; year++)
                                                {
                                                    <option value="@year">@year</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Month</label>
                                            <select class="form-select" @bind="CurrentSalary.SalMonth"
                                                    @bind:after="UpdateWorkingDays"
                                                    disabled="@(CurrentSalary.SalYear == 0)">
                                                <option value="0">-- Select Month --</option>
                                                @for (int month = 1; month <= 12; month++)
                                                {
                                                    <option value="@month">
                                                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                       
                                    </div> 
                                    <div class="mt-2">
                                        <label class="form-label text-primary small fw-bold">Select Employee Type</label>
                                        <div class="row">
                                            <div class="col-6">
                                                <div class="form-check">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="EmployeeType"
                                                           value="On Role"
                                                           checked="@(SelectedEmployeeType == "On Role")"
                                                           @onchange="OnEmployeeTypeChanged" />
                                                    <label class="form-check-label">OnRole</label>
                                                </div>
                                            </div>

                                            <div class="col-6">
                                                <div class="form-check">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="EmployeeType"
                                                           value="Trainee"
                                                           checked="@(SelectedEmployeeType == "Trainee")"
                                                           @onchange="OnEmployeeTypeChanged" />
                                                    <label class="form-check-label">Trainee</label>
                                                </div>
                                            </div>

                                            <div class="col-6">
                                                <div class="form-check">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="EmployeeType"
                                                           value="Out Sourced"
                                                           checked="@(SelectedEmployeeType == "Out Sourced")"
                                                           @onchange="OnEmployeeTypeChanged" />
                                                    <label class="form-check-label">Out Sourced</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-semibold">@GetLabel("Department")</label>
                                            <input type="text"
                                                   class="form-control"
                                                   @bind="CurrentSalary.Dept"
                                                   readonly />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-semibold text-primary">
                                                @GetLabel("Salary Issued On")
                                            </label>
                                            <input type="date"
                                                   class="form-control"
                                                   @bind="CurrentSalary.SalDate" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CARD 2 -->
                        <div class="col-lg-4 col-md-6 mb-2">
                            <div class="card shadow-sm h-100">
                                <div class="card-header" style="background-color:#808080; color:white;">
                                    <span class="fw-bold small">Mark Holidays</span>
                                </div>
                                <div class="card-body p-2">
                                    <div class="mb-2">
                                        <label class="form-label fw-semibold">@GetLabel("Employees")</label>

                                        <select class="form-select"
                                                size="10"
                                                @onchange="OnStaffChanged">

                                            @foreach (var emp in FilteredStaff)
                                            {
                                                <option value="@emp.StaffID">
                                                    @emp.StaffName
                                                    @if (!emp.OtCount)
                                                    {
                                                        <text> (OT Disabled)</text>
                                                    }
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>


                            </div>
                        </div>

                        <!-- CARD 3 -->
                        <div class="col-lg-4 col-md-6 mb-2">
                            <div class="card shadow-sm h-100">
                                <div class="card-header" style="background-color:#008080; color:white;">
                                    <span class="fw-bold small">Shortcut Details</span>
                                
                                   @*  <div class="form-check mb-0">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="editAttendance"
                                               @bind="EnableAttendanceEdit" />

                                        <label class="form-check-label text-white small ms-1"
                                               for="editAttendance">
                                            Edit Attendance
                                        </label>
                                    </div> *@

                                    <div class="form-check mb-0">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="editAttendance"
                                               @bind="CurrentSalary.EnableAttendanceEdit" />

                                        <label class="form-check-label text-white small ms-1"
                                               for="editAttendance">
                                            Edit Attendance
                                        </label>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <table class="table table-sm table-bordered mb-0 small">
                                        <tbody>
                                            <tr><td class="text-center fw-bold">DA</td><td>Dearness Allowance</td><td class="text-center fw-bold">MR</td><td>Medical Reimbursement</td></tr>
                                            <tr><td class="text-center fw-bold">HRA</td><td>House Rent Allowance</td><td class="text-center fw-bold">EL</td><td>Earned Leave</td></tr>
                                            <tr><td class="text-center fw-bold">TA</td><td>Travel Allowance</td><td class="text-center fw-bold">OT</td><td>Overtime</td></tr>
                                            <tr><td class="text-center fw-bold">LTA</td><td>Leave Travel Allowance</td><td class="text-center fw-bold">PF</td><td>Provident Fund</td></tr>
                                            <tr><td class="text-center fw-bold">ESI</td><td>Employees' State Insurance</td><td class="text-center fw-bold">PT</td><td>Professional Tax</td></tr>
                                            <tr><td class="text-center fw-bold">TDS</td><td>Tax Deducted at Source</td><td class="text-center fw-bold">EA</td><td>Education Allowance</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- CARD 4 -->
                        <div class="card-body p-2">
                            <div class="table-responsive">
                                <div class="d-flex gap-2 flex-nowrap">

                                    <div style="min-width:140px;">
                                        <label class="small fw-semibold">@GetLabel("Working Days")</label>
                                        
                                        @* <input class="form-control form-control-sm"
                                               @bind="CurrentSalary.WorkingDays"
                                               readonly /> *@
                                        <input class="form-control form-control-sm"
                                               value="@CurrentSalary.WorkingDays"
                                               readonly />
                                    </div>


                                    <div style="min-width:140px;">
                                        <label class="small fw-semibold">@GetLabel("Payable Days")</label>
                                        @* <input class="form-control form-control-sm"
                                               @bind="CurrentSalary.PayableDays"
                                               readonly="@(!EnableAttendanceEdit)" /> *@
                                        <input class="form-control form-control-sm"
                                               @bind="CurrentSalary.PayableDays"
                                               @bind:event="oninput"
                                               @bind:after="RecalculateEarnings"
                                               readonly="@(!CurrentSalary.EnableAttendanceEdit)" />

                                    </div>

                                    <div style="min-width:140px;">
                                        <label class="small fw-semibold">@GetLabel("Present Days")</label>
                                        <input class="form-control form-control-sm"
                                               @bind="CurrentSalary.PresentDays"
                                               @bind:event="oninput"
                                               @bind:after="RecalculateEarnings"
                                               readonly="@(!CurrentSalary.EnableAttendanceEdit)" />
                                    </div>



                                    <div style="min-width:140px;">
                                        <label class="small fw-semibold">@GetLabel("Absent Days")</label>
                                        <input class="form-control form-control-sm"
                                               @bind="CurrentSalary.AbsentDays"
                                               @bind:event="oninput"
                                               @bind:after="RecalculateEarnings"
                                               readonly="@(!CurrentSalary.EnableAttendanceEdit)" />
                                    </div>

                                    <div style="min-width:140px;">
                                        <label class="small fw-semibold">@GetLabel("Leave Days")</label>
                                        <input class="form-control form-control-sm"
                                               @bind="CurrentSalary.LeaveDays"
                                               @bind:event="oninput"
                                               @bind:after="RecalculateEarnings"
                                               readonly="@(!CurrentSalary.EnableAttendanceEdit)" />
                                    </div>

                                    <div style="min-width:140px;">
                                        <label class="small fw-semibold">@GetLabel("Holidays")</label>
                                        <input class="form-control form-control-sm"
                                               @bind="CurrentSalary.Holidays"
                                               @bind:event="oninput"
                                               @bind:after="RecalculateEarnings"
                                               readonly="@(!CurrentSalary.EnableAttendanceEdit)" />
                                    </div>

                                    <div style="min-width:120px;">
                                        <label class="small fw-semibold">
                                            @GetLabel("OT")

                                            @if (!CurrentSalary.OtCount && FilteredStaff.Any())
                                            {
                                                <span class="badge bg-secondary ms-1">Disabled</span>
                                            }
                                        </label>

                                       @*  <input class="form-control form-control-sm"
                                               value="@(CurrentSalary.OtCount? CurrentSalary.OT: 0)"
                                               readonly="@(!EnableAttendanceEdit)" /> *@

                                        <input class="form-control form-control-sm"
                                               @bind="CurrentSalary.OT"
                                               @bind:event="oninput"
                                               @bind:after="RecalculateEarnings"
                                               readonly="@(!CurrentSalary.EnableAttendanceEdit || !CurrentSalary.OtCount)" />
                                    </div>

                                </div>
                            </div>
                        </div>
                        

                        <div class="col-lg-4 col-md-6 mb-2">
                            <div class="card shadow-sm h-100">

                                <div class="card-header" style="background-color:#9A629D; color:white;">
                                    <span class="fw-bold small">Basic Summary</span>
                                </div>

                                <div class="card-body p-2" @oninput="RecalculateEarnings">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            @* <label>Basic</label> *@
                                            <label>@GetLabel("Basic")</label>
                                            
                                            <input type="number"
                                                   class="form-control"
                                                   @bind="CurrentSalary.Basic"
                                                   @bind:event="oninput" />
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label>@GetLabel("DA")</label>
                                            <input type="number"
                                                   class="form-control"
                                                   @bind="CurrentSalary.DA"
                                                   @bind:event="oninput" />
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label>@GetLabel("Miscellaneous")</label>
                                            <input type="number"
                                                   class="form-control"
                                                   @bind="CurrentSalary.Miscellaneous"
                                                   @bind:event="oninput" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label>@GetLabel("Others")</label>
                                            <input type="number"
                                                   class="form-control"
                                                   @bind="CurrentSalary.Others"
                                                   @bind:event="oninput" />
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-6 mb-3">
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       @bind="CurrentSalary.IsAttBonus" />
                                                <label class="form-check-label">
                                                   @GetLabel("Attendance Bonus")
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label>@GetLabel("Att Bonus Amt")</label>
                                            <input type="number"
                                                   class="form-control"
                                                   @bind="CurrentSalary.AttBonus"
                                                   @bind:event="oninput" />
                                        </div>
                                    </div>

                                    
                                </div>

                            </div>
                        </div>

                        <!-- CARD 5 -->
                        <div class="col-12 col-md-6 col-lg-4 mb-2">
                            <div class="card shadow-sm h-100">

                                <div class="card-header" style="background-color:#C50D56; color:white;">
                                    <span class="fw-bold small">Earnings</span>
                                </div>
                                <div class="card-body p-2 p-md-3" @oninput="RecalculateEarnings">
                                    <!----HRA---->
                                        <div class="mb-3">

                                        <div class="d-flex flex-wrap align align-items-center gap-2">
                                            <!-- Radio Buttons -->
                                                <div class="form-check me-2">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="HRAType"
                                                           checked="@(CurrentSalary.IsHRAPerDay)"
                                                           @onchange="(e) => OnHRAPerDayToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Day</label>
                                                </div>

                                                <div class="form-check me-3">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="HRAType"
                                                           checked="@(CurrentSalary.IsHRAPerMonth)"
                                                           @onchange="(e) => OnHRAPerMonthToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Month</label>
                                                </div>
                                              

                                                <!-- Amount Box -->
                                                <input type="number"
                                                       class="form-control form-control-sm me-2"
                                                       style="width:90px;"
                                                       @bind="CurrentSalary.HRA"
                                                       @bind:event="oninput" 
                                                       />

                                                <!-- Label at End -->
                                                <label>@GetLabel("HRA")</label>
                                            </div>
                                        </div>
                                 

                                    <!----TA---->
                                 
                                        <div class="mb-3">

                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <!-- Radio Buttons -->
                                                <div class="form-check me-2">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="TAType"
                                                           checked="@(CurrentSalary.IsTAPerDay)"
                                                           @onchange="(e) => OnTAPerDayToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Day</label>
                                                </div>

                                                <div class="form-check me-3">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="TAType"
                                                           checked="@(CurrentSalary.IsTAPerMonth)"
                                                           @onchange="(e) => OnTAPerMonthToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Month</label>
                                                </div>
                                               

                                                <!-- Amount Box -->
                                                <input type="number"
                                                       class="form-control form-control-sm me-2"
                                                       style="width:90px;"
                                                       @bind="CurrentSalary.TA"
                                                       @bind:event="oninput"/>

                                                <!-- Label at End -->
                                                <label>@GetLabel("TA")</label>
                                            </div>
                                        </div>
                                    @* </div> *@

                                    <!----Special Allowance---->
                                        <div class="mb-3">

                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <!-- Radio Buttons -->
                                                <div class="form-check me-2">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="SpecialAllowType"
                                                           checked="@(CurrentSalary.IsSplAllowPerDay)"
                                                           @onchange="(e) => OnSplAllowPerDayToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Day</label>
                                                </div>

                                                <div class="form-check me-3">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="SpecialAllowType"
                                                           checked="@(CurrentSalary.IsSplAllowPerMonth)"
                                                           @onchange="(e) => OnSplAllowPerMonthToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Month</label>
                                                </div>
                                               

                                                <!-- Amount Box -->
                                                <input type="number"
                                                       class="form-control form-control-sm me-2"
                                                       style="width:90px;"
                                                       @bind="CurrentSalary.SplAllow"
                                                       @bind:event="oninput" 
                                                      />

                                                <!-- Label at End -->
                                                <label>@GetLabel("Spl Allowance")</label>
                                            </div>
                                        </div>

                                    <!----LTA---->
                                        <div class="mb-3">

                                            <div class="d-flex flex-wrap align-items-center gap-2">

                                                <!-- Radio Buttons -->
                                                <div class="form-check me-2">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="LTAType"
                                                           checked="@(CurrentSalary.IsLTAPerDay)"
                                                           @onchange="(e) => OnLTAPerDayToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Day</label>
                                                </div>

                                                <div class="form-check me-3">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="LTAType"
                                                           checked="@(CurrentSalary.IsLTAPerMonth)"
                                                           @onchange="(e) => OnLTAPerMonthToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Month</label>
                                                </div>
                                               

                                                <!-- Amount Box -->
                                                <input type="number"
                                                       class="form-control form-control-sm me-2"
                                                       style="width:90px;"
                                                       @bind="CurrentSalary.LTA"
                                                       @bind:event="oninput" 
                                                      />

                                                <!-- Label at End -->
                                                <label>@GetLabel("LTA")</label>
                                            </div>
                                        </div>
                         
                                    <!----MR---->
                                        <div class="mb-3">

                                            <div class="d-flex flex-wrap align-items-center gap-2">

                                                <!-- Radio Buttons -->
                                                <div class="form-check me-2">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="MRType"
                                                           checked="@(CurrentSalary.IsMRPerDay)"
                                                           @onchange="(e) => OnMRPerDayToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Day</label>
                                                </div>

                                                <div class="form-check me-3">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="MRType"
                                                           checked="@(CurrentSalary.IsMRPerMonth)"
                                                           @onchange="(e) => OnMRPerMonthToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Month</label>
                                                </div>
                                               

                                                <!-- Amount Box -->
                                                <input type="number"
                                                       class="form-control form-control-sm me-2"
                                                       style="width:90px;"
                                                       @bind="CurrentSalary.MR"
                                                       @bind:event="oninput" 
                                                       />

                                                <!-- Label at End -->
                                                <label>@GetLabel("MR")</label>
                                            </div>
                                        </div>
                                    

                                    <!----EA---->
                                        <div class="mb-3">

                                            <div class="d-flex flex-wrap align-items-center gap-2">

                                                <!-- Radio Buttons -->
                                                <div class="form-check me-2">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="EAType"
                                                           checked="@(CurrentSalary.IsEAPerDay)"
                                                           @onchange="(e) => OnEAPerDayToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Day</label>
                                                </div>

                                                <div class="form-check me-3">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="EAType"
                                                           checked="@(CurrentSalary.IsEAPerMonth)"
                                                           @onchange="(e) => OnEAPerMonthToggle(e)" />
                                                    <label class="form-check-label small">Fixed/Month</label>
                                                </div>
                                               

                                                <!-- Amount Box -->
                                                <input type="number"
                                                       class="form-control form-control-sm me-2"
                                                       style="width:90px;"
                                                       @bind="CurrentSalary.EA"
                                                       @bind:event="oninput" 
                                                       />

                                                <!-- Label at End -->
                                                <label>@GetLabel("EA")</label>
                                            </div>
                                        </div>
                                   
                                    
                                    <!----OT---->
                                    @if (CurrentSalary.OtCount && FilteredStaff.Any())
                                    {
                                        <div class="mb-3">

                                            <div class="d-flex flex-wrap align-items-center gap-2">

                                                <!-- Radio Buttons -->
                                                <div class="form-check me-2">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="OTType"
                                                           checked="@CurrentSalary.IsOTunderBasic"
                                                           @onchange="OnOTUnderBasicToggle" />
                                                    <label class="form-check-label small">OT Times</label>
                                                </div>

                                                <div class="form-check me-3">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="OTType"
                                                           checked="@CurrentSalary.IsOTPerHour"
                                                           @onchange="OnOTPerHourToggle" />
                                                    <label class="form-check-label small">Fixed/Hour</label>
                                                </div>

                                                <!-- Amount Box -->
                                                <input type="number"
                                                       class="form-control form-control-sm me-2"
                                                       style="width:90px;"
                                                       @bind="CurrentSalary.OT_times_now"
                                                       @bind:event="oninput" />

                                                <label>@GetLabel("OT")</label>

                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        @if (FilteredStaff.Any() && !CurrentSalary.OtCount)
                                        {
                                            <!-- OT Disabled Badge -->
                                            <span class="badge bg-secondary">
                                                OT Disabled
                                            </span>

                                        }
                                     
                                    }

                                    <div class="mb-3">
                                        <label>@GetLabel("Total Gross")</label>
                                        <input class="form-control bg-warning-subtle fw-bold"
                                               value="@TotalGross" readonly />
