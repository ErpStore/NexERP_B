     private async Task OnStaffChanged(ChangeEventArgs e)
    {
        try
        {
            // =========================================================
            // VALIDATION
            // =========================================================

            if (CurrentSalary.SalYear == 0 || CurrentSalary.SalMonth == 0)
            {
                await _js.ToastrWarning("Please select Year and Month first.");
                return;
            }

            if (!int.TryParse(e.Value?.ToString(), out int selectedId))
            {
                await _js.ToastrWarning("Invalid staff selected.");
                return;
            }

            // SAVE MONTH & YEAR BEFORE RESETTING OBJECT
            var oldMonth = CurrentSalary.SalMonth;
            var oldYear = CurrentSalary.SalYear;

            // =========================================================
            // CHECK EXISTING SALARY
            // =========================================================

            var existingSalary = await salaryService
                .GetSalaryByStaffMonthYearAsync(
                    selectedId,
                    oldMonth,
                    oldYear);

            // =========================================================
            // IF SALARY ALREADY EXISTS
            // =========================================================

            if (existingSalary != null)
            {
                CurrentSalary = existingSalary;

                // LOAD LOAN DETAILS
                var staffLoan = await staffLoanService
                    .GetStaffLoanByStaffIdAsync(CurrentSalary.StaffId.Value);

                if (staffLoan != null && staffLoan.LoanRows.Any())
                {
                    TotalLoanBalance = staffLoan.LoanRows
                        .Where(x => !x.IsFinished)
                        .Sum(x => x.BalanceAmount);

                    CurrentSalary.LoanBalB4 = TotalLoanBalance;

                    CurrentSalary.LoanAmtDed = staffLoan.LoanRows
                        .Where(x => !x.IsFinished &&
                                    x.NumberOfMonthsRecoveries > 0)
                        .Sum(x => Math.Round(
                            x.Amount / x.NumberOfMonthsRecoveries,
                            2,
                            MidpointRounding.AwayFromZero));

                    var firstLoan = staffLoan.LoanRows
                        .FirstOrDefault(x => !x.IsFinished);

                    if (firstLoan != null)
                    {
                        CurrentSalary.LoanId = firstLoan.LoanId;
                    }
                }
                else
                {
                    TotalLoanBalance = 0;
                    CurrentSalary.LoanBalB4 = 0;
                    CurrentSalary.LoanAmtDed = 0;
                    CurrentSalary.LoanId = null;
                }

                RecalculateEarnings();

                await _js.ToastrInfo("Existing salary record loaded.");

                await InvokeAsync(StateHasChanged);

                return;
            }

            // =========================================================
            // CREATE FRESH OBJECT FOR NEW STAFF
            // =========================================================

            CurrentSalary = new SalaryVM
            {
                StaffId = selectedId,
                SalMonth = oldMonth,
                SalYear = oldYear
            };

            // =====================================
            // 🔥 GET PREVIOUS SALARY STRUCTURE
            // =====================================
            var previousSalary = await _unitOfWork.Salaries
                .GetQueryable()
                .Where(x => x.StaffId == selectedId)
                .OrderByDescending(x => x.SalYear)
                .ThenByDescending(x => x.SalMonth)
                .FirstOrDefaultAsync();

            // =====================================
            // 🔥 COPY ALLOWANCE FIELDS
            // =====================================
            if (previousSalary != null)
            {
                CurrentSalary.DA = previousSalary.DA;
                CurrentSalary.HRA = previousSalary.HRA;
                CurrentSalary.TA = previousSalary.TA;
                CurrentSalary.MR = previousSalary.MR;
                CurrentSalary.EA = previousSalary.EA;
                CurrentSalary.LTA = previousSalary.LTA;
                CurrentSalary.SplAllow = previousSalary.SplAllow;
                CurrentSalary.Basic = previousSalary.Basic;

                CurrentSalary.IsHRAPerDay = previousSalary.IsHRAPerDay;
                CurrentSalary.IsHRAPerMonth = previousSalary.IsHRAPerMonth;
                CurrentSalary.IsTAPerDay = previousSalary.IsTAPerDay;
                CurrentSalary.IsTAPerMonth = previousSalary.IsTAPerMonth;
                CurrentSalary.IsLTAPerDay = previousSalary.IsLTAPerDay;
                CurrentSalary.IsLTAPerMonth = previousSalary.IsLTAPerMonth;
                CurrentSalary.IsSplAllowPerDay = previousSalary.IsSplAllowPerDay;
                CurrentSalary.IsSplAllowPerMonth = previousSalary.IsSplAllowPerMonth;
                CurrentSalary.IsMRPerDay = previousSalary.IsMRPerDay;
                CurrentSalary.IsMRPerMonth = previousSalary.IsMRPerMonth;
                CurrentSalary.IsEAPerDay = previousSalary.IsEAPerDay;
                CurrentSalary.IsEAPerMonth = previousSalary.IsEAPerMonth;
            }

            // =========================================================
            // GET SELECTED STAFF
            // =========================================================

            var selectedStaff = FilteredStaff
                .FirstOrDefault(x => x.StaffID == selectedId);

           //24/04/26
            CurrentSalary.OtCount = selectedStaff.OtCount;
            //24/04/26

            if (selectedStaff == null)
            {
                await _js.ToastrWarning("Staff not found.");
                return;
            }

            // =========================================================
            // STAFF DETAILS
            // =========================================================
        
            CurrentSalary.Dept = selectedStaff.Department;

            // WORKING HOURS
            if (TimeSpan.TryParse(selectedStaff.WorkingHrs, out var ts))
                CurrentSalary.WorkingHrs = (decimal)ts.TotalHours;
            else
                CurrentSalary.WorkingHrs = 0;

            // =========================================================
            // ATTENDANCE
            // =========================================================

            var attendanceData = await _unitOfWork.Attendances
                .Query()
                .Where(a =>
                    a.StaffId == selectedId &&
                    a.Year == oldYear &&
                    a.MonthId == oldMonth)
                .ToListAsync();

            int totalDays = DateTime.DaysInMonth(
oldYear.GetValueOrDefault(),
oldMonth.GetValueOrDefault());
            // Always set Working Days
            CurrentSalary.WorkingDays = totalDays;


            if (!attendanceData.Any())
            {
                await _js.ToastrWarning("No attendance found for selected month. You can continue with manual salary entry.");
             
                // ======================================
                // MANUAL ENTRY MODE
                // ======================================
                // If Edit Attendance is checked, initialize attendance values
                
                CurrentSalary.PresentDays = totalDays;
                CurrentSalary.AbsentDays = 0;
                CurrentSalary.LeaveDays = 0;
                CurrentSalary.Holidays = 0;
                CurrentSalary.PayableDays = totalDays;

                CurrentSalary.OT = 0;
                CurrentSalary.EarnedOT = 0;
               
            }

            // if (attendanceData.Any())
            else
            {
                var firstAttendance = attendanceData.First();

                var ldetailString = firstAttendance.Ldetail ?? "";
                var otDetailString = firstAttendance.OtDetail ?? "";

                var days = ldetailString
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(x => x.Trim().ToUpper())
                    .ToList();

                var otdays = otDetailString
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(x =>
                        decimal.TryParse(x.Trim(), out var val)
                            ? val
                            : 0)
                    .ToList();

                CurrentSalary.PresentDays =
                    days.Count(x => MapStatus(x, biometricExcelSetting) == "P");

                CurrentSalary.AbsentDays =
                    days.Count(x => MapStatus(x, biometricExcelSetting) == "A");

                CurrentSalary.Holidays =
                    days.Count(x => MapStatus(x, biometricExcelSetting) == "H");

                decimal paidLeave = 0;
                decimal unpaidLeave = 0;
                decimal paidLCount = 0;

                foreach (var status in days)
                {
                    if (MapStatus(status, biometricExcelSetting) != "L")
                        continue;

                    var leave = await leaveTypeService.GetByAttendanceCode(status);

                    if (leave == null)
                        continue;

                    if (leave.AttendanceCode.Trim().ToUpper() == "L")
                    {
                        if (paidLCount < 1)
                        {
                            paidLeave++;
                            paidLCount++;
                        }
                        else
                        {
                            unpaidLeave++;
                        }
                    }
                    else
                    {
                        if (leave.DeductSalary)
                            unpaidLeave++;
                        else
                            paidLeave++;
                    }
                }

                CurrentSalary.LeaveDays =
                    days.Count(x => MapStatus(x, biometricExcelSetting) == "L");

                CurrentSalary.PayableDays =
                    CurrentSalary.PresentDays +
                    paidLeave +
                    CurrentSalary.Holidays;

                CurrentSalary.OT =
                    CurrentSalary.OtCount ? otdays.Sum() : 0;
            }
            // Recalculate salary
            RecalculateEarnings();
            // =========================================================
            // LOAN DETAILS
            // =========================================================
            var loanData = await staffLoanService
    .GetStaffLoanByStaffIdAsync(selectedId);

            if (loanData != null && loanData.LoanRows.Any())
            {
                var eligibleLoans = loanData.LoanRows
                    .Where(x =>
                    {
                        if (x.IsFinished) return false;

                        var loanMonth = new DateTime(
                            x.DateOfIssue.Year,
                            x.DateOfIssue.Month,
                            1);

                        // compare directly using CurrentSalary month/year
                        return new DateTime(x.DateOfIssue.Year, x.DateOfIssue.Month, 1)
        < new DateTime(oldYear.GetValueOrDefault(), oldMonth.GetValueOrDefault(), 1);
                    })
                    .ToList();

                TotalLoanBalance = eligibleLoans.Sum(x => x.BalanceAmount);

                CurrentSalary.LoanBalB4 = TotalLoanBalance;

                CurrentSalary.LoanAmtDed = eligibleLoans
                    .Where(x => x.NumberOfMonthsRecoveries > 0)
                    .Sum(x => Math.Round(
                        x.Amount / x.NumberOfMonthsRecoveries,
                        2,
                        MidpointRounding.AwayFromZero));

                CurrentSalary.LoanId = eligibleLoans.FirstOrDefault()?.LoanId;
            }
            else
            {
                TotalLoanBalance = 0;
                CurrentSalary.LoanBalB4 = 0;
                CurrentSalary.LoanAmtDed = 0;
                CurrentSalary.LoanId = null;
            }
           
            // =========================================================
            // RECALCULATE
            // =========================================================
            //24/04/26
            if (!CurrentSalary.OtCount)
            {
                CurrentSalary.OT = 0;
                CurrentSalary.EarnedOT = 0;
            }
            //24/04/26

            RecalculateEarnings();


            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex,"Error occurred while changing staff.");

            await _js.ToastrError("Failed to load employee details.");
        }
    }

    private bool IsMatch(string value, string dbValue)
    {
        if (string.IsNullOrWhiteSpace(dbValue))
            return false;

        return dbValue
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim().ToUpper())
            .Contains(value.Trim().ToUpper());
    }

    private string MapStatus(string status, BiometricExcelSetting setting)
    {
        if (IsMatch(status, setting.P))
            return "P";

        if (IsMatch(status, setting.A))
            return "A";

        if (IsMatch(status, setting.L))
            return "L";

        if (IsMatch(status, setting.H))
            return "H";

        if (IsMatch(status, setting.W))
            return "W";

        if (IsMatch(status, setting.O))
            return "O";

        // if (IsMatch(status, setting.M))
        //     return "M";

        // if (IsMatch(status, setting.N))
        //     return "N";
        return status;
    }



    private async Task InitializeNewSalary(int rowId)
    {
        try
        {
            SalaryEmp.RowId = 0;
            SalaryEmp.SalDate = DateTime.Today;
            SalaryEmp.SalMonth = DateTime.Today.Month;
            SalaryEmp.SalYear = DateTime.Today.Year;
            await InvokeAsync(StateHasChanged);

        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new salary.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewSalary failed for RowId: {rowId}");
        }
    }

