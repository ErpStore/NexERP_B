    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            biometricExcelSetting = await biometricExcelSettingService.GetBiometricExcelSetAsync();

            SalaryHeadSettings = await salaryHeadPrintSettingService.GetAllSalaryPrintHeadSettingsAsync();
            var hr = await hrMasterService.GetHRMSettingAsync();
            HrMasterSetting = new HRMasterSettingVM
                {
                    Id = hr.Id,
                    EmpPF = hr.EmpPF,
                    PFSealing = hr.PFSealing,
                    EmpESI = hr.EmpESI,
                    ESISealing = hr.ESISealing,

                    PFBasic = hr.PFBasic,
                    PFDA = hr.PFDA,
                    PFHRA = hr.PFHRA,
                    PFConveyance = hr.PFConveyance,
                    PFOTAmount = hr.PFOTAmount,
                    PFSplAllow = hr.PFSplAllow,
                    PFMedicalAllow = hr.PFMedicalAllow,
                    PFLTA = hr.PFLTA,
                    PFEA = hr.PFEA,
                    PFMiscEarning = hr.PFMiscEarning,
                    PFOtherAllow = hr.PFOtherAllow,
                    PFAttendBonus = hr.PFAttendBonus,

                    ESIBasic = hr.ESIBasic,
                    ESIDA = hr.ESIDA,
                    ESIHRA = hr.ESIHRA,
                    ESIConveyance = hr.ESIConveyance,
                    ESIOTAmt = hr.ESIOTAmt,
                    ESISplAllow = hr.ESISplAllow,
                    ESIMedicalAllow = hr.ESIMedicalAllow,
                    ESILTA = hr.ESILTA,
                    ESIEA = hr.ESIEA,
                    ESIMiscEarning = hr.ESIMiscEarning,
                    ESIOtherAllow = hr.ESIOtherAllow,
                    ESIAttBonus = hr.ESIAttBonus,

                    OTBasic = hr.OTBasic,
                    OTDA = hr.OTDA
                };

            AllStaff = (await _unitOfWork.Staffs.GetAllAsync())
                        .Where(x => x.Status == "Active")
                        .ToList();
            if (RowId.HasValue && RowId>0)
            {
                await LoadExistingSalary(RowId.Value);
            }
            else 
            {
                await InitializeNewSalary(0);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void UpdateWorkingDays()
    {
        int year = CurrentSalary.SalYear ?? 0;
        int month = CurrentSalary.SalMonth ?? 0;

        if (year > 0 && month > 0)
        {
            CurrentSalary.WorkingDays = DateTime.DaysInMonth(year, month);
        }
        else
        {
            CurrentSalary.WorkingDays = 0;
        }
    }

    private string GetLabel(string fieldName)
    {
        return SalaryHeadSettings
            .FirstOrDefault(x => x.FieldName == fieldName)?
            .PrintName ?? fieldName;
    }

    private async Task LoadExistingSalary(int rowId)
    {
        try
        {
            var salaryVM = await salaryService.GetSalaryByRowIdAsync(rowId);

            if (salaryVM == null)
            {
                await _js.ToastrWarning("Salary record not found.");
                return;
            }

            salaryVM.RowId = rowId;

            // Find staff by StaffID from the salary record
            var staff = await _unitOfWork.Staffs
                        .GetQueryable()
                        .FirstOrDefaultAsync(s => s.StaffID == salaryVM.StaffId);

            if (staff != null)
            {
                // Set the selected employee type for your UI (radio buttons)
                SelectedEmployeeType = staff.Reporting;

                // **Only include this specific staff in the filtered list**
                FilteredStaff = new List<Staff> { staff };
            }
            else
            {
                // If staff not found, clear FilteredStaff so UI shows nothing
                FilteredStaff = new List<Staff>();
            }

            CurrentSalary = salaryVM;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing salary.");
            await _logs.LogDeveloperError(ex, $"LoadExistingSalary failed for RowId: {rowId}");
        }
    }

