@page "/appointment_Letter/create"
@page "/appointment_Letter/update/{AppointmentId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IHumanResourceService
@using V.SMART.Shared.Services.ReportViewer

@using V.SMART.Shared.ViewModels.HumanResourceViewModel.AppointmentLetterVM
@using V.SMART.Shared.ViewModels.MasterViewModel.HumanResourceViewModel
@using MudBlazor
@inject ReportService reportService

@inject IAppointmentLetterService appointmentLetterService

@inherits BaseUserRightsComponent

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>
@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container-fluid px-2 px-md-5 mt-4">
            <div class="card shadow-sm border-1">
                <!-- header-->
                <PageHeader TitleText="@(AppointmentId == 0 || AppointmentId == null ? "Create Appointment Letter" : "Update Appointment Letter")"
                            TitleIcon="bi bi-person"
                            Breadcrumbs="@OfferLetterbreadcrumbs" />
                <div class="card-body">
                    <EditForm Model="AppointmentLetterVM" OnValidSubmit="UpsertAppointmentLetter">


                        <div class="row g-3 mb-2">
                            <!-- Customer Details -->
                            <div class="col-12 col-lg-6 mb-2">
                                <div class="card h-100 shadow-sm">
                                    <!-- Header -->
                                    <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                        <span class="fw-bold fs-6">Candidate Information</span>
                                    </div>
                                    <div class="card-body p-3">
                                        <!-- Candidate Selection -->
                                        <div class="row mb-2 align-items-center">
                                            <label class="col-12 col-sm-3 col-form-label text-dark">
                                                <small>M/S.*</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <MudAutocomplete T="CandidateVM"
                                                                 Value="SelectedCandidate"
                                                                 ValueChanged="@(async c => await OnCandidateChanged(c))"
                                                                 ToStringFunc="@(c => c?.CandidateName ?? string.Empty)"
                                                                 SearchFunc="SearchCandidate"
                                                                 Dense="true"
                                                                 Variant="Variant.Outlined"
                                                                 Placeholder="Search Candidate"
                                                                 MaxItems="50"
                                                                 Clearable="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 Required="true" />

                                                <ValidationMessage For="@(() => AppointmentLetterVM.CandidateID)" />
                                            </div>
                                        </div>
                                        <!-- Address -->
                                        <div class="row mb-2 align-items-center">
                                            <label class="col-12 col-sm-3 col-form-label text-dark">
                                                <small>Address</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                  rows="1"
                                                  readonly>@AppointmentLetterVM.Address</textarea>
                                            </div>
                                        </div>
                                        <!-- Address -->
                                        <div class="row mb-2 align-items-center">
                                            <label class="col-12 col-sm-3 col-form-label text-dark">
                                                <small>Applied Position</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                       value="@AppointmentLetterVM.Position" readonly />
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>


                            <!-- Offer Letter Details -->
                            <div class="col-12 col-lg-6 mb-2">
                                <div class="card h-100 shadow-sm">
                                    <!-- Header -->
                                    <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                        <span class="fw-bold fs-6">Offer Letter Information</span>
                                    </div>
                                    <div class="card-body p-3">
                                        <!-- Appointment Letter No -->
                                        <div class="row mb-2 align-items-center">
                                            <label class="col-12 col-sm-3 col-form-label text-dark">
                                                <small> Appointment Letter No.</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <div class="input-group input-group-sm w-100 rounded-3">
                                                    <InputText class="form-control form-control-sm rounded-3"
                                                               placeholder="Offerlellter No."
                                                               maxlength="30"
                                                               @bind-Value="@AppointmentLetterVM.AppointmentNo"
                                                               readonly />
                                                    <span class="input-group-text rounded-3">@AppointmentLetterVM.Suffix</span>
                                                </div>
                                                <ValidationMessage For="@(() => AppointmentLetterVM.AppointmentNo)" />
                                            </div>

                                        </div>

                                        <!-- Appointment Letter Date -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Appointment Letter Date</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputDate class="form-control form-control-sm rounded-3"
                                                           @bind-Value="@AppointmentLetterVM.AppointmentDate" />
                                                <ValidationMessage For="@(() => AppointmentLetterVM.AppointmentDate)" />
                                            </div>
                                        </div>
                                        <!-- Template -->
                                        @if (!AppointmentId.HasValue)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Templates</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <select class="form-select form-select-sm rounded-3" @onchange="OnPositionChanged">
                                                        <option>-Select Template-</option>
                                                        @foreach (var Pos in PositionList)
                                                        {
                                                            <option value="@Pos">@Pos</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="g-3">
                            <div class="card">
                                <div class="card-header text-white fw-bold" style="background-color:#869B7E;">
                                    Introduction
                                </div>

                                <div class="card-body">
                                    <div class="col-12">

                                        <textarea class="form-control form-control-sm rounded-3 w-100"
                                                  rows="4"
                                                  @bind="AppointmentLetterVM.Introduction"
                                                  placeholder="Enter introduction...">
                                                  </textarea>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="col-xxl-12 col-12  mt-3">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Body</span>
                                </div>
                                <div class="card-body p-2">
                                    <div class="table-responsive" style="max-height: 700px; overflow-y: auto; overflow-x: auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:3px; font-size:12px; ">Sl.No</th>
                                                    <th style="width:10px; font-size:12px;">Title</th>
                                                    <th style="width:70px; font-size:12px;">Description</th>
                                                    <th style="width:5px;" class="freeze-last-col text-end">Action</th>

                                                </tr>
                                            </thead>
                                            <tbody class="custom-size">
                                                @if (AppointmentLetterVM.AppointmentLetterSubVM != null && AppointmentLetterVM.AppointmentLetterSubVM.Any())
                                                {
                                                    @foreach (var Appointment in AppointmentLetterVM.AppointmentLetterSubVM)
                                                    {
                                                        <tr>
                                                            <td>@Appointment.SlNo</td>
                                                            <td>
                                                                @if (Appointment.IsEditable)
                                                                {
                                                                    <InputTextArea class="form-control form-control-sm"
                                                                                   @bind-Value="Appointment.Title"
                                                                                   rows="1"
                                                                                   placeholder="Title" />
                                                                    <ValidationMessage For="@(() => Appointment.Title)" />
                                                                }
                                                                else
                                                                {
                                                                    @Appointment.Title
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (Appointment.IsEditable)
                                                                {
                                                                    <InputTextArea class="form-control form-control-sm"
                                                                                   @bind-Value="Appointment.Description"
                                                                                   rows="1"
                                                                                   placeholder="Description" />
                                                                    <ValidationMessage For="@(() => Appointment.Description)" />
                                                                }
                                                                else
                                                                {
                                                                    @Appointment.Description
                                                                }
                                                            </td>
                                                            <!-- Actions -->
                                                            <td class="freeze-last-col">
                                                                <div class="text-end">
                                                                    @if (Appointment.IsEditable)
                                                                    {
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                                @onclick="async () => await EditRowAsync(Appointment)">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>
                                                                        <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                                @onclick="() => RemoveRow(Appointment)">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </td>

                                                        </tr>
                                                    }

                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                       
                        <button type="button" class="btn btn-sm rounded-3 mt-3 text-white"
                                style="background-color: #6f42c1;"
                                @onclick="AddRow">
                            <i class="bi bi-plus-circle me-1"></i> Add row
                        </button>
                      

                        <hr style="border: 0; height: 1px; background-color: #007bff; margin: 10px 0;" />

                        <div class="g-3">
                            <div class="card" >
                                <div class="card-header text-white fw-bold" style="background-color:#869B7E;">
                                    Closing Notes
                                </div>

                                <div class="card-body">
                                    <div class="col-12">
                                        <textarea class="form-control form-control-sm rounded-3 w-100"
                                                  rows="4"
                                                  @bind="AppointmentLetterVM.ClosingNotes"
                                                  placeholder="Enter ClosingNotes...">
                                                                    </textarea>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <hr style="border: 0; height: 1px; background-color: #007bff; margin: 10px 0;" />
                        @if (AppointmentLetterVM.AppointmentId > 0)
                        {
                            <div class="row g-3">
                                <!-- Created By -->
                                <div class="col-12 col-md-3">
                                    <div class="form-floating">
                                        <InputText @bind-Value="AppointmentLetterVM.CreatedBy"
                                                   id="CreatedBy"
                                                   class="form-control"
                                                   placeholder="Created By"
                                                   readonly />
                                        <label for="CreatedBy">Created By</label>
                                    </div>
                                </div>

                                <!-- Created Date -->
                                <div class="col-12 col-md-3">
                                    <div class="form-floating">
                                        <input class="form-control"
                                               id="CreatedDate"
                                               placeholder="Created Date"
                                               value="@AppointmentLetterVM.CreatedDate.ToString("dd/MM/yyyy hh:mm:ss")"
                                               readonly />
                                        <label for="CreatedDate">Created Date</label>
                                    </div>
                                </div>

                                <!-- Modified By -->
                                <div class="col-12 col-md-3">
                                    <div class="form-floating">
                                        <InputText @bind-Value="AppointmentLetterVM.ModifiedBy"
                                                   id="ModifiedBy"
                                                   class="form-control"
                                                   placeholder="Modified By"
                                                   readonly />
                                        <label for="ModifiedBy">Modified By</label>
                                    </div>
                                </div>

                                <!-- Modified Date -->
                                <div class="col-12 col-md-3">
                                    <div class="form-floating">
                                        <input class="form-control"
                                               id="ModifiedDate"
                                               placeholder="Modified Date"
                                               value="@AppointmentLetterVM.ModifiedDate?.ToString("dd/MM/yyyy hh:mm:ss")"
                                               readonly />
                                        <label for="ModifiedDate">Modified Date</label>
                                    </div>
                                </div>
                            </div>
                        }
                        <hr style="border: 0; height: 1px; background-color: #007bff; margin: 10px 0;" />

                        <div class="row mt-3 mb-2 g-2 justify-content-start">

                            @if (CanCreate || CanEdit)
                            {

                                <div class="col-12 col-sm-6 col-lg-3">
                                    <button type="submit"
                                            class="btn btn-primary w-100 h-100"
                                            disabled="@isProcessing">
                                        <i class="bi bi-floppy2-fill me-1"></i>
                                        @(AppointmentId == null || AppointmentId == 0 ? "Create" : "Update")
                                    </button>
                                </div>

                            }

                            <!-- Back to List -->
                            <div class="col-12 col-sm-6 col-lg-3">
                                <SmartBackButton OnNavigate="NavigateBack" />
                            </div>
                        </div>

                    </EditForm>
                </div>

            </div>
        </div>
    }
}

@inject IOfferLetterService _OfferLetterservice
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject CurrentUserService CurrentUserService
@inject ILoggingService LoggingService

@code {

    private bool isProcessing = true;

    protected override string ScreenName => "Offer Letter";

    //public WYSIWYGTextEditor editor;


    [Parameter] public int? AppointmentId { get; set; }
    [Parameter] public int? CandidateId { get; set; }

    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private AppointmentLetterVM AppointmentLetterVM { get; set; } = new();
    private AppointmentLetterSubVM? rowToDelete;
    private AppointmentLetterSubVM? rowToCancel;

    private List<CandidateVM> Candidates = new();
    private CandidateVM? SelectedCandidate;

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private List<string> PositionList = new();
    private string? SelectedPosition;



    private List<PageHeader.BreadcrumbItem> OfferLetterbreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Human Resource" },
        new PageHeader.BreadcrumbItem { Text = "Appointment Letter", IsLast = true }

    };
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }



            if (AppointmentId.HasValue)
            {
                await LoadExistingAppointmentLetter(AppointmentId.Value);
            }
            else
            {
                await LoadNewAppointmentLetter();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync");
            await _js.ToastrError("Failed to load EnquirySales screen.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadExistingAppointmentLetter(int AppointmentId)
    {
        try
        {
            AppointmentLetterVM = await appointmentLetterService.GetAppointmentIdidByAppointmentIdAsync(AppointmentId);

            if (AppointmentLetterVM != null)
            {
                SelectedCandidate = await appointmentLetterService.GetCandidateByIdAsync(AppointmentLetterVM.CandidateID);
                if (SelectedCandidate != null)
                    await ApplyCandidateSelectionAsync(SelectedCandidate);

                // foreach (var enq in OfferLetterVM.OfferLetterSubVMs)
                // {
                //     if (enq.ItemId.HasValue && enq.ItemId > 0)
                //         attachmentCounts[enq.ItemId.Value] = await enquiryService.GetCorrespondenceAttachmentsCountAsync(enq.ItemId.Value, "Item");
                // }

                // IsSomeItemsTransMade = await CheckIsTransMade();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadExistingEnquiry");
            await _js.ToastrError("Failed to load existing Enquiry details.");
        }
    }

    #region  Candidate

    private async Task ApplyCandidateSelectionAsync(CandidateVM? candidate)
    {
        try
        {
            SelectedCandidate = candidate;
            AppointmentLetterVM.CandidateID = candidate?.CandidateID ?? 0;
            AppointmentLetterVM.Candidatename = candidate?.CandidateName;
            AppointmentLetterVM.Address = candidate?.Address;
            AppointmentLetterVM.Position = candidate?.Position;


        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ApplyCustomerSelectionAsync");
            await _js.ToastrError("Failed to apply customer selection.");
        }
    }



    private async Task OnCandidateChanged(CandidateVM? candidate)
    {
        try
        {
            await ApplyCandidateSelectionAsync(candidate);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnCustomerChanged");
            await _js.ToastrError("Error while selecting customer.");
        }
    }
    #endregion

    private async Task LoadNewAppointmentLetter()
    {
        try
        {
            // var candidate = await _OfferLetterservice.GetCandidateByIdAsync(candidateId);
            // if (candidate != null)
            //     await ApplyCandidateSelectionAsync(candidate);
            PositionList = await appointmentLetterService.GetAppointmentLetterPositionsAsync();
            AppointmentLetterVM.AppointmentNo = await appointmentLetterService.GetAppointmentLetterNoAsync();
            AppointmentLetterVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);


        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadNewEnquiry");
            await _js.ToastrError("Failed to initialize new Enquiry.");
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        await _js.InvokeVoidAsync("HideConfirmationModal");
        if (isConfirmed)
        {

            if (confirmation == "Remove")
            {
                await confirmDeleteRow_Click(isConfirmed);
            }


        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            if (rowToDelete.AppointmentSubId > 0)
            {
                await appointmentLetterService.DeleteOfferSubItemAndResequenceAsync(rowToDelete, AppointmentLetterVM);

                AppointmentLetterVM.AppointmentLetterSubVM = await appointmentLetterService
                    .GetAppointmentletterSubByAppointmentletterAsync(AppointmentLetterVM.AppointmentId);
            }
            else
            {
                AppointmentLetterVM.AppointmentLetterSubVM.Remove(rowToDelete);

                if (!AppointmentLetterVM.AppointmentLetterSubVM.Any())
                {
                    AppointmentLetterVM.AppointmentLetterSubVM.Add(new AppointmentLetterSubVM
                    {
                        AppointmentId = AppointmentLetterVM.AppointmentId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    for (int i = 0; i < AppointmentLetterVM.AppointmentLetterSubVM.Count; i++)
                        AppointmentLetterVM.AppointmentLetterSubVM[i].SlNo = i + 1;
                }
            }

            await _js.ToastrSuccess("Row deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error confirming quote item deletion");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }
    #region Upsert / Validation

    private async Task UpsertAppointmentLetter()
    {
        isProcessing = true;
        try
        {
            AppointmentLetterVM.AppointmentLetterSubVM.RemoveAll(x =>
            string.IsNullOrWhiteSpace(x.Title) &&
            string.IsNullOrWhiteSpace(x.Description));

            if (await toValidateEnuiry())
            {
                var isNewEnquiry = AppointmentLetterVM.AppointmentId == 0;

                @if (isNewEnquiry)
                {
                    // bool isDuplicate = await enquiryService.IsDuplicateEnquiryAsync(EnquirySalesVM.EnquiryNo, EnquirySalesVM.Suffix, EnquirySalesVM.EnquiryId, EnquirySalesVM.CustId);
                    // if (isDuplicate)
                    // {
                    //     await _js.ToastrError($"Enquiry No '{EnquirySalesVM.EnquiryNo}' with Customer '{EnquirySalesVM.CustomerName}' already exists.");
                    //     return;
                    // }
                }

                await appointmentLetterService.UpsertAppointmentLetterAsync(AppointmentLetterVM);

                if (isNewEnquiry)
                    await _js.ToastrSuccess("OfferLetter saved successfully.");
                else
                    await _js.ToastrSuccess("OfferLetter updated successfully.");

                // Discard popup Clear
                await _js.InvokeVoidAsync("NavigationGuard.clear");

                _navigationManager.NavigateTo("/appointment_Letter");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertEnquirySales");
            await _js.ToastrError("Error saving enquiry.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> toValidateEnuiry()
    {
        bool valid = true;


        if (AppointmentLetterVM.CandidateID == 0)
        {
            await _js.ToastrWarning("Please select Customer.");
            valid = false;
        }
        else if (!AppointmentLetterVM.AppointmentLetterSubVM.Any())
        {
            await _js.ToastrWarning("At least one row item is required.");
            valid = false;
        }
        else
        {
            foreach (var line in AppointmentLetterVM.AppointmentLetterSubVM)
            {
                if (string.IsNullOrWhiteSpace(line.Title))
                {
                    await _js.ToastrWarning("Please enter the Title for all rows.");
                    valid = false;
                    break;
                }

                if (string.IsNullOrWhiteSpace(line.Description))
                {
                    await _js.ToastrWarning("Please enter the Description for all rows.");
                    valid = false;
                    break;
                }
            }
        }

        return valid;
    }
    #endregion

    private async Task<IEnumerable<CandidateVM>> SearchCandidate(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<CandidateVM>();

        try
        {
            var results = await appointmentLetterService.SearchCandidatesAsync(value);

            //return results.Take(50);
            return results
           .Where(c => c.Status == "Offer Sent") // Filter only selected candidates
           .Take(50);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error searching customers");
            return Enumerable.Empty<CandidateVM>();
        }
    }


    private async Task EditRowAsync(AppointmentLetterSubVM enq)
    {
        enq.IsEditable = true;
        // if (enq.Title !="")
        //     enq.SelectedItem = await enquiryService.GetItemByItemIdAsync(enq.ItemId);
    }
    private async Task RemoveRow(AppointmentLetterSubVM item)
    {
        try
        {
            if (AppointmentLetterVM.AppointmentLetterSubVM.Count == 1)
            {
    
                await _js.ToastrWarning("At least one item must be present in the enquiry.");
                return;
            }

           
            if (item.Title == "")
            {
                AppointmentLetterVM.AppointmentLetterSubVM.Remove(item);
                await ResetSlno();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this item?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Remove";

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in RemoveRow method");
            await _js.ToastrError("An error occurred while removing the item.");
        }
    }
    private async Task ResetSlno()
    {
        int counter = 1;
        foreach (var sub in AppointmentLetterVM.AppointmentLetterSubVM)
            sub.SlNo = counter++;
    }

    private async Task AddRow()
    {
        if (!await ValidateLastRowAsync()) return;

        AppointmentLetterVM.AppointmentLetterSubVM.Add(new AppointmentLetterSubVM
        {
            AppointmentId = AppointmentLetterVM.AppointmentId,
            IsEditable = true
        });

        await ResetSlno();
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        var lastRow = AppointmentLetterVM.AppointmentLetterSubVM.LastOrDefault();
        if (lastRow == null) return true;
        if (!await ValidateRowAsync(lastRow)) return false;
        lastRow.IsEditable = false;
        return true;
    }
    private async Task<bool> ValidateRowAsync(AppointmentLetterSubVM row)
    {
        var errors = new List<string>();

        if ( row.Title== " ")
            errors.Add("Please Enter Title");

        if (row.Description == " ")
            errors.Add("Please Enter Description");

        if (errors.Any())
        {
            await _js.ToastrInfo(string.Join("<br>", errors));
            return false;
        }

        return true;
    }

    private void NavigateBack()
    {
        if (!isProcessing)
            _navigationManager.NavigateTo("/appointment_Letter");
    }

    private async Task OnPositionChanged(ChangeEventArgs e)
    {
        var position = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(position))
            return;

        var lastOffer = await appointmentLetterService.GetLastAppointmentLetterByPositionAsync(position);

        if (lastOffer != null)
        {
            AppointmentLetterVM.AppointmentLetterSubVM = lastOffer.AppointmentLetterSubVM
                .Select(x => new AppointmentLetterSubVM
                {
                    Title = x.Title,
                    Description = x.Description,
                    SlNo=x.SlNo
                })
                .ToList();

            StateHasChanged();
        }
    }
    


