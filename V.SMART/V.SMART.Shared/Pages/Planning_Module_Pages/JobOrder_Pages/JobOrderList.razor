@page "/jobOrderList"
@using V.SMART.Shared.Pages.InstantSearch_Pages
@using V.SMART.Shared.ViewModels.PlanningViewModel.JobOrderViewModel
@using System.Text.Json

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ExcelExportService ExcelExportService
@inject IJobOrderService jobOrderService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Job Order List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@jobOrderBreadcrumbs" />

            <div class="card-body p-4">

                 <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>


                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                 value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>


                    @if (CanCreate)
                    {
                       <div class="col-12 col-md-2 ms-md-auto text-end">
                            <a href="jobOrder/create"
                               class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                               title="Create New">
                                <i class="bi-box-seam"></i> Add New
                            </a>
                       </div>
                    }

                </div>

                @if (JobOrderVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="JobOrderVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            case "JobId":
                                                <PropertyColumn Title="Job ID" Property="@(c => c.JobId)" />
                                                break;

                                            case "JobNo":
                                                @* <PropertyColumn Title="Job No" Property="@(c => $"{c.JobNo}{c.Suffix}")" Sortable="true" /> *@
                                                <PropertyColumn Title="Job No" Property="@(c => c.StaffID > 0
                                                                                         ? $"{c.DepartmentCode}/{c.JobNo}{c.Suffix}"
                                                                                         : $"{c.JobNo}{c.Suffix}")" Sortable="true" />
                                                break;

                                            case "JobDate":
                                                <PropertyColumn Title="Job Date" Property="@(c => c.JobDate)" Format="dd/MM/yyyy" Sortable="true" />
                                                break;

                                            case "MfgORLab":
                                                <TemplateColumn Title="Type" Context="c">
                                                    @if (c.MfgORLab == true)
                                                    {
                                                        <span class="badge text-bg-primary bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-gear-fill me-1"></i> Manufacturing
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-info bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-people-fill me-1"></i> Labour
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            case "IsManual":
                                                <TemplateColumn Title="Manual Job" Context="c">
                                                    @if (c.IsManual == true)
                                                    {
                                                        <span class="badge text-bg-warning bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-tools me-1"></i> Manual
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-success bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-cpu me-1"></i> Auto
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;


                                            case "CustId":
                                                <PropertyColumn Title="Customer ID" Property="@(c => c.CustId)" />
                                                break;

                                            case "CustomerName":
                                                <PropertyColumn Title="Customer Name" Property="@(c => c.CustomerName)" Sortable="true" />
                                                break;

                                            case "LineNo":
                                                <PropertyColumn Title="Ref Line No." Property="@(c => c.LineNo)" />
                                                break;

                                            case "RefPoNo":
                                                <PropertyColumn Title="Ref PO No" Property="@(c => c.RefPoNo)" />
                                                break;

                                            case "RefPODate":
                                                <PropertyColumn Title="Ref PO Date" Property="@(c => c.RefPODate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "POQty":
                                                <PropertyColumn Title="PO Qty" Property="@(c => c.POQty)" />
                                                break;

                                            case "JobOrderQty":
                                                <PropertyColumn Title="Job Order Qty" Property="@(c => c.JobOrderQty)" />
                                                break;

                                            case "AssyId":
                                                <PropertyColumn Title="Assembly Item ID" Property="@(c => c.AssyId)" />
                                                break;

                                            case "AssemblyItemCode":
                                                <PropertyColumn Title="Assembly Item Code" Property="@(c => c.AssemblyItemCode)" Sortable="true" />
                                                break;

                                            case "UtilQty":
                                                <PropertyColumn Title="Util Qty" Property="@(c => c.UtilQty)" />
                                                break;

                                            case "Status":
                                                <TemplateColumn Title="Status" Context="c">
                                                    @if (c.Cancel == true)
                                                    {
                                                        <span class="badge text-bg-danger bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-check-circle me-1"></i> Cancelled
                                                        </span>
                                                    }
                                                    else if(!c.JobTally && !c.Cancel)
                                                    {
                                                        <span class="badge text-bg-warning bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-success bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-check-circle me-1"></i> Complete
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            case "Remark":
                                                <PropertyColumn Title="Remark" Property="@(c => c.Remark)" />
                                                break;

                                            case "Cancel":
                                                <PropertyColumn Title="Cancel" Property="@(c => c.Cancel)" />
                                                break;

                                            case "CancelReason":
                                                <PropertyColumn Title="Cancel Reason" Property="@(c => c.CancelReason)" />
                                                break;

                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date" Property="@(c => c.ModifiedDate)" Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }

                            }
                            else
                            {

                                    @* <PropertyColumn Title="Job No" Property="@(c => $"{c.JobNo}{c.Suffix}")" Sortable="true" /> *@
                                <PropertyColumn Title="Job No" Property="@(c => c.StaffID > 0 ? $"{c.DepartmentCode}/{c.JobNo}{c.Suffix}"
                                                                                  : $"{c.JobNo}{c.Suffix}")" Sortable="true" />
                                    <PropertyColumn Title="Job Date" Property="@(c => c.JobDate)" Format="dd/MM/yyyy" Sortable="true" />

                                    <TemplateColumn Title="Manual Job" Context="c">
                                        @if (c.IsManual == true)
                                        {
                                            <span class="badge text-bg-warning bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                <i class="bi bi-tools me-1"></i> Manual
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                <i class="bi bi-cpu me-1"></i> Auto
                                            </span>
                                        }
                                    </TemplateColumn>
                                    
                                    <PropertyColumn Title="Job Order Qty" Property="@(c => c.JobOrderQty)" />
                                    <PropertyColumn Title="Assembly Item Code" Property="@(c => c.AssemblyItemCode)" Sortable="true" />
                                    <TemplateColumn Title="Status" Context="c">
                                        @if (c.Cancel == true)
                                        {
                                            <span class="badge text-bg-danger bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i> Cancelled
                                            </span>
                                        }
                                        else if(!c.JobTally && !c.Cancel)
                                        {
                                            <span class="badge text-bg-warning bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i> Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i> Complete
                                            </span>
                                        }
                                    </TemplateColumn>
                                    <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                    <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                    
                            }
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"jobOrder/update/{c.JobId}?currentPage={currentPage}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Job Order">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"jobOrder/details/{c.JobId}?currentPage={currentPage}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View JobOrder">
                                           <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete Item"
                                                @onclick="() => HandleDelete(c.JobId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>
                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="container-fluid">

                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="fw-semibold small px-1">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                                <button class="btn btn-success btn-sm d-flex align-items-center ms-5"
                                        @onclick="HandleExport">

                                    <i class="bi bi-download me-1"></i>
                                    Export JobOrder's

                                </button>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}


@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Job Order";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteJobId = 0;
    private string searchText = string.Empty;
    private string selectedStatus = "";

    private List<JobOrderVM> JobOrderVMs = new();
    private List<BOMItem> bomItems = new();

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;
    // === Paging & Search ===
    private int totalItems;
    //private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> jobOrderBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Planning" },
        new PageHeader.BreadcrumbItem { Text = "JobOrder", IsLast = true }
    };

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();

            //InstantSearch
            //Important : Deserialize Filter parameter from query string if exists
            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }
            //Sathish
            if (currentPage < 1)
            {
                currentPage = 1;
            }
            await LoadAllJobOrders();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    #region === Data Loading ===

    private async Task LoadAllJobOrders()
    {
        try
        {
            var result = await jobOrderService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            JobOrderVMs = result.jobOrderVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading categories in JobOrderList");
            await _JS.ToastrError("Failed to load categories.");
        }
    }

    #endregion



    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "Job ID", Field = "JobId", IsVisible = false },
                new() { Title = "Job No", Field = "JobNo", IsVisible = true },
                new() { Title = "Job Date", Field = "JobDate", IsVisible = true },
                new() { Title = "Manufacturing / Labour", Field = "MfgORLab", IsVisible = true },
                new() { Title = "Manual Job", Field = "IsManual", IsVisible = false },

                new() { Title = "Customer ID", Field = "CustId", IsVisible = false },
                new() { Title = "Customer Name", Field = "CustomerName", IsVisible = true },

                 new() { Title = "Ref Line No.", Field = "LineNo", IsVisible = false },
                new() { Title = "Ref PO No", Field = "RefPoNo", IsVisible = true },
                new() { Title = "Ref PO Date", Field = "RefPODate", IsVisible = false },

                new() { Title = "PO Qty", Field = "POQty", IsVisible = true },
                new() { Title = "Job Order Qty", Field = "JobOrderQty", IsVisible = true },

                new() { Title = "Assembly Item ID", Field = "AssyId", IsVisible = false },
                new() { Title = "Assembly Item Code", Field = "AssemblyItemCode", IsVisible = true },
                new() { Title = "Util Qty", Field = "UtilQty", IsVisible = false },

                new() { Title = "Status", Field = "Status", IsVisible = false },

                new() { Title = "Cancel Reason", Field = "CancelReason", IsVisible = false },
                new() { Title = "Remark", Field = "Remark", IsVisible = true },
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = false },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = false },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false },

            };

            if (!Hidden)
            {
                // Columns.AddRange(new[]
                // {
                //     new GridColumn { Title = "Extra Column 1", Field = "Extra1", IsVisible = false },
                //     new GridColumn { Title = "Extra Column 2", Field = "Extra2", IsVisible = false },
                // });
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for JobOrderList");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ItemList HandleColumnChange() Method");
        }
    }

    #endregion



    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllJobOrders();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in JobOrderList");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllJobOrders();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in JobOrderList");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllJobOrders();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in JobOrderList");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllJobOrders();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in JobOrderList");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllJobOrders();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in JobOrderList");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllJobOrders();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing JobOrderList page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int jobOrderId)
    {
        try
        {
            var jobOrder = await jobOrderService.GetJobOrderByJobIdAsync(jobOrderId);
            var isPoExists = await jobOrderService.IsPoExists(jobOrder.RefPoId.GetValueOrDefault(), jobOrder.AssyId);

            if (isPoExists)
            {
                var SubJobReferences = await jobOrderService
                    .GetReferenceJobListByParentJobId(jobOrder.JobId, jobOrder.RefPoSubId.Value);

                if (SubJobReferences != null && SubJobReferences.Any())
                {
                    foreach (var subJob in SubJobReferences)
                    {
                        foreach (var sub in subJob.JobOrderSubs)
                        {
                            bool hasProductionIssueExists = await jobOrderService.HasProductionIssueForJobAsync(sub.ItemId.Value, subJob.JobId);

                            if (hasProductionIssueExists)
                            {
                                await _JS.ToastrWarning(
                                    "You cannot delete this Assembly Item.\n" +
                                    "Some of the Sub-Assembly Job Orders have already been issued to Production."
                                );
                                return;
                            }
                        }
                    }
                }

                ModalTitle = "Are you sure you want to delete this Assembly Job Order?\nDeleting it will also remove all related or generated Job Orders linked to this assembly.";
                btnColor = "btn-danger";
                btnText = "Yes! Delete";
                confirmation = "Delete";
                showCancelReasonBox = false;
            }
            else
            {
                ModalTitle = "Are you sure you want to delete this Job Order?";
                btnColor = "btn-danger";
                btnText = "Yes, Delete";
                confirmation = "Delete";
                showCancelReasonBox = false;
                bomItems = new();
            }

            var (canDelete, message) = await jobOrderService.CanDeleteJobOrderAsync(jobOrderId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteJobId = jobOrderId;
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for JobId: {jobOrderId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            var parentJob = await jobOrderService.GetJobOrderByJobIdAsync(DeleteJobId);

            var isPoExists = await jobOrderService.IsPoExists(parentJob.RefPoId.GetValueOrDefault(), parentJob.AssyId);

            if (isPoExists)
            {
                List<int> jobIdsToDelete = new() { parentJob.JobId };

                var SubJobReferences = await jobOrderService
                    .GetReferenceJobListByParentJobId(parentJob.JobId, parentJob.RefPoSubId.Value);

                if (SubJobReferences != null && SubJobReferences.Any())
                {
                    foreach (var subJob in SubJobReferences)
                    {
                        if (subJob.JobId > 0)
                            jobIdsToDelete.Add(subJob.JobId);

                        foreach (var sub in subJob.JobOrderSubs)
                        {
                            bool hasProductionIssueExists = await jobOrderService.HasProductionIssueForJobAsync(sub.ItemId.Value, subJob.JobId);

                            if (hasProductionIssueExists)
                            {
                                await _JS.ToastrWarning(
                                    "You cannot delete this Assembly Item.\n" +
                                    "Some of the Sub-Assembly Job Orders have already been issued to Production."
                                );
                                return;
                            }
                        }
                    }
                }

                bool deleted = await jobOrderService.DeleteJobOrdersRecursiveAsync(jobIdsToDelete, parentJob);

                if (deleted)
                {
                    await _JS.ToastrSuccess("Assembly & Sub-Assembly Job Orders deleted successfully.");
                }
                else
                    await _JS.ToastrError("Failed to delete Assembly Job Orders.");

                await LoadAllJobOrders();
                return;
            }

            bool singleDeleted = await jobOrderService.DeleteJobOrderByJobIdAsync(DeleteJobId);

            if (singleDeleted)
                await _JS.ToastrSuccess("Job Order deleted successfully.");
            else
                await _JS.ToastrWarning("Job Order could not be deleted.");

            await LoadAllJobOrders();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting JobId: {DeleteJobId}");
            await _JS.ToastrError("Failed to delete Job Order.");
        }
        finally
        {
            DeleteJobId = 0;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else if (confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

