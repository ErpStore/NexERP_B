    private async Task CancelItem(JobOrderSubVM rowToCancel)
    {
        if (rowToCancel == null) return;
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!rowToCancel.ItemCancel)
            {
                rowToCancel.ItemCancel = true;
                rowToCancel.ItemCancelReason = cancelReason;

                await jobOrderService.UpdateItemCancelAsync(rowToCancel);

                await LoggingService.LogUserAction(
                username, machine, ip,
                screen: "Job Order",
                action: $"Cancelled JobOrder No: {JobOrderVMs.JobNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }
            else
            {
                rowToCancel.ItemCancel = false;
                rowToCancel.ItemCancelReason = string.Empty;

                await jobOrderService.UpdateItemCancelAsync(rowToCancel);

                await LoggingService.LogUserAction(
                username, machine, ip,
                screen: "Job Order",
                action: $"Reverted Job Order No: {JobOrderVMs.JobNo} And ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: $"Reason: {cancelReason}");

            }

            cancelReason = null;
            JobOrderVMs.JobOrderSubVMs = await jobOrderService
                   .GetJobOrderSubByJobIdAsync(JobOrderVMs.JobId);

            await ResetSlno();

            var action = rowToCancel.ItemCancel
                ? $"Item Cancelled ItemCode: {rowToCancel.ItemCode}"
                : $"Item Reverted ItemCode: {rowToCancel.ItemCode}";

            var toastMessage = rowToCancel.ItemCancel
                ? "Item cancelled successfully."
                : "Item has been reverted successfully.";

            await _js.ToastrSuccess(toastMessage);
            rowToCancel = null;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            rowToCancel = null;
            cancelReason = null;
            await _js.ToastrError("An error occurred while cancelling/reverting the Item.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Reverse failed for JobId: {JobOrderVMs.JobId}");
        }
        finally
        {
            rowToCancel = null;
            cancelReason = null;
            isProcessing = false;
        }
    }

    private async Task ConfirmCancel_Click()
    {
        try
        {
            var parentJob = await jobOrderService.GetJobOrderByJobIdAsync(JobOrderVMs.JobId);
            if (parentJob == null)
            {
                await _js.ToastrError("Job Order not found.");
                return;
            }

            bool isPoExists = await jobOrderService
                .IsPoExists(parentJob.RefPoId.GetValueOrDefault(), parentJob.AssyId);

            if (isPoExists)
            {

                List<int> jobIdsToCancel = new() { parentJob.JobId };

                var SubJobReferences = await jobOrderService
                    .GetReferenceJobListByParentJobId(parentJob.JobId, parentJob.RefPoSubId.Value);

                if (SubJobReferences != null && SubJobReferences.Any())
                {
                    foreach (var subJob in SubJobReferences)
                    {
                        if (subJob.JobId > 0)
                        {
                            jobIdsToCancel.Add(subJob.JobId);
                        }

                        bool hasProductionIssueExists = await jobOrderService.HasProductionIssueForJobAsync(subJob.AssyId.Value, subJob.JobId);

                        if (hasProductionIssueExists)
                        {
                            await _js.ToastrWarning("Cannot Cancel.\nSome Sub-Assembly Job Orders are already issued to Production.");
                            return;
                        }
                    }
                }

                bool cancelled = await jobOrderService.CancelJobOrdersRecursiveAsync(jobIdsToCancel, JobOrderVMs, cancelReason);

                if (cancelled)
                {
                    if(!JobOrderVMs.Cancel)
                    {
                        await _js.ToastrSuccess("Assembly & Sub-Assembly Job Orders cancelled successfully.");
                    }
                    else
                    {
                        await _js.ToastrSuccess("Assembly & Sub-Assembly Job Orders Reverted successfully.");
                    }
                }
                else
                {
                    await _js.ToastrError("Failed to cancel Assembly Job Orders.");
                }

                _navigationManager.NavigateTo("/jobOrderList");
                return;
            }


            if (!isPoExists)
            {
                var isUpdated = await jobOrderService.UpdatedCancelStatusAsync(JobOrderVMs,cancelReason);

                if (isUpdated)
                {
                    if (!JobOrderVMs.Cancel)
                    {
                        await LoggingService.LogUserAction(
                           UserName: await _userService.GetUsernameAsync(),
                           Machine: _userService.MachineName,
                           IP_Address: _userService.IpAddress,
                           screen: "Job Order",
                           action: $"Cancelled Job Order No: {JobOrderVMs.JobNo}",
                           additionalInfo: $"Job Id: {JobOrderVMs.JobId}");

                        await _js.ToastrSuccess("Job Order cancelled successfully.");
                    }
                    else
                    {
                        await LoggingService.LogUserAction(
                          UserName: await _userService.GetUsernameAsync(),
                          Machine: _userService.MachineName,
                          IP_Address: _userService.IpAddress,
                          screen: "Job Order",
                          action: $"Cancelled Job Order No: {JobOrderVMs.JobNo}",
                          additionalInfo: $"Job Id: {JobOrderVMs.JobId}");

                        await _js.ToastrSuccess("Job Order reverted successfully.");
                    }
                }
                else
                {
                    await _js.ToastrError("Failed to cancel/revert the Job Order.");
                }
            }

            _navigationManager.NavigateTo("/jobOrderList");

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error cancelling JobId: {JobOrderVMs.JobId}");
            await _js.ToastrError("Failed to cancel Job Order.");
        }
        finally
        {

        }
    }

