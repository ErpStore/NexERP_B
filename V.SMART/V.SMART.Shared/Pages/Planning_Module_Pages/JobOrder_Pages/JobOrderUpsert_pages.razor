    private async Task UpsertJobOrder()
    {
        try
        {
            isProcessing = true;

            JobOrderVMs.JobOrderSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.ReqQty.HasValue || x.ReqQty == 0));

            if (! JobOrderVMs.JobOrderSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a Job Order without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in  JobOrderVMs.JobOrderSubVMs)
            {
                bool isValid = await ValidateJobOrderLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewJobOrder = JobOrderVMs.JobId == 0;

            try
            {
                await jobOrderService.UpsertJobOrderAsync(JobOrderVMs);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewJobOrder)
                await _js.ToastrSuccess("Job Order saved successfully.");
            else
                await _js.ToastrSuccess("Job Order updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/jobOrderList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertJobOrder failed.");
            await _js.ToastrError("Error saving Job Order.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateJobOrderLineAsync(JobOrderSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.ReqQty.HasValue || line.ReqQty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Req. Qty must be greater than 0.");
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateJobOrderLineAsync failed.");
            await _js.ToastrError("Error Validate job Order Item line.");
            return false;
        }
    }

