    private async Task Cancel()
    {
        try
        {
            if (IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some items have transactions made. You cannot cancel the complete Job Order.");
                return;
            }

            var jobOrder = await jobOrderService.GetJobOrderByJobIdAsync(JobOrderVMs.JobId);
            if (jobOrder == null)
            {
                await _js.ToastrError("Job Order not found.");
                return;
            }

            bool isPoExists = await jobOrderService
                .IsPoExists(jobOrder.RefPoId.GetValueOrDefault(), jobOrder.AssyId);


            if (isPoExists)
            {

                var poItemWOBalQty = await jobOrderService.GetMfgPoWOBalQtyByRefPoSubId(jobOrder.RefPoSubId.Value);

                if (poItemWOBalQty < jobOrder.JobOrderQty && jobOrder.Cancel)
                {
                    await _js.ToastrError("Cannot Revert this Job Order. Another Job Order has already consumed the PO Work Order Balance Qty.");
                    return;
                }

                var subJobs = await jobOrderService
                    .GetReferenceJobListByParentJobId(jobOrder.JobId, jobOrder.RefPoSubId.Value);

                if (subJobs != null && subJobs.Any())
                {
                    foreach (var subJob in subJobs)
                    {
                        bool exists = await jobOrderService
                            .HasProductionIssueForJobAsync(subJob.AssyId.Value, subJob.JobId);

                        if (exists)
                        {
                            await _js.ToastrWarning(
                                "You cannot cancel this Assembly Item.\n" +
                                "Some Sub-Assembly Job Orders have already been issued to Production.");
                            return;
                        }

                        if (subJob.JobOrderQty != subJob.JobBalQty)
                        {
                            await _js.ToastrError("Cannot Cancel/revert. Some Sub-Assembly transactions are already made!");
                            return;
                        }

                    }
                }

                if (!JobOrderVMs.Cancel)
                {
                    ModalTitle = "Are you sure you want to cancel this Assembly Job Order? " +
                                 "Cancelling will also cancel all linked Sub-Assembly Job Orders.";

                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "Cancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to revert this Assembly Job Order? " +
                                 "Reverting will also revert all linked Sub-Assembly Job Orders.";

                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "Revert";
                    showCancelReasonBox = false;
                }
            }
            else
            {
                if (JobOrderVMs.Cancel == true)
                {
                    if (jobOrder.JobOrderQty != jobOrder.JobBalQty)
                    {
                        await _js.ToastrError("Cannot revert. Some transactions have been made!");
                        return;
                    }

                    if (jobOrder.ParentJobId > 0)
                    {
                        var parentOrder = await jobOrderService.GetJobOrderByJobIdAsync(jobOrder.ParentJobId.Value);

                        if (parentOrder != null && parentOrder.Cancel == true)
                        {
                            await _js.ToastrError("Cannot revert this ony Sub-Assembly. when Assembly Job Order is cancelled state.");
                            return;
                        }
                    }

                    ModalTitle = "Are you sure you want to revert this Job Order?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "Revert";
                    showCancelReasonBox = false;
                }
                else
                {
                    ModalTitle = "Are you sure you want to cancel this Job Order?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "Cancel";
                    showCancelReasonBox = true;
                }
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing cancellation.");
            await LoggingService.LogDeveloperError(ex, "Error in Cancel()");
        }
    }




