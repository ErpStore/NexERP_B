@code
{

    #region Parameters & Properties

    protected override string ScreenName => "Job Order";

    [Parameter] public int? jobId { get; set; }

    private bool isProcessing = true;

    private JobOrderVM JobOrderVMs { get; set; } = new();
    private JobOrderSubVM? rowToCancel;
    private List<MfgPoVM> CustomerPendingPOs = new();
    private List<JobOrderAssyPoItemVM> JobOrderAssyPoItemVMs = new();
    private List<JobOrderPreviewVM> PreviewVMs = new();
    private List<BOMItem> bomItems = new();
    private List<StaffVM> staffVMs = new();

    private bool IsSomeItemsTransMade { get; set; } = false;

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;
    private string? pdfBase64;

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private List<PageHeader.BreadcrumbItem> JobOrderFormBreadcrumbs = new()
    {
        new() { Text = "Planning" },
        new() { Text = "Job-Order", IsLast = true }
    };

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";


    private bool IsBOMModalVisible = false;
    private List<Dictionary<string, object>>? ExistingBOMData;
    private List<Dictionary<string, object>>? LatestChangedBOMData;

    private bool IsAssmblyAndSubAssmbly { get; set; } = false;
    private bool IsAssignJobOrderDepartment { get; set; } = false;

    private List<string> LatestBOMColumns = new() { "Item Id", "Item-Code", "Item Name", "UOM", "Utility Qty"};
    private List<string> ExistingBOMColumns = new() {"Item-Code", "Item Name", "UOM", "Utility Qty"};
    private List<string> LatestBOMFields = new() { "ItemId", "ItemCode", "ItemName", "UOM", "UtilQty"};
    private List<string> LatestBOMHiddenColumns = new() { "Item Id" };
    private bool IsAllSelected { get; set; }
      public bool ManuallyJobButton {get;set;} = false;


    #endregion


    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        isProcessing = true;

        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied", true);
                return;
            }

            IsAssignJobOrderDepartment = await jobOrderService.IsAssignJobOrderDepartmenWise();
            ManuallyJobButton = await jobOrderService.IsManualyJobOrderHiden();

            if(IsAssignJobOrderDepartment)
            {
                staffVMs = await jobOrderService.GetStaffOnlyProductionDepartment();

            }
            if (jobId.HasValue)
            {
                await LoadExistingJobId(jobId.Value);
            }
            else
            {
                JobOrderVMs = new();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingJobId(int jobId)
    {
        try
        {
            JobOrderVMs = await jobOrderService.GetJobOrderByJobIdAsync(jobId);
            if (JobOrderVMs == null)
            {
                await _js.ToastrWarning("Job Order not found.");
                return;
            }

            JobOrderVMs.SelectedCustomer = await jobOrderService.GetCustomerByIdAsync(JobOrderVMs.CustId.GetValueOrDefault());
            if (JobOrderVMs.SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(JobOrderVMs.SelectedCustomer);

            foreach (var joSub in JobOrderVMs.JobOrderSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[joSub.ItemId.Value] =
                    await jobOrderService.GetCorrespondenceAttachmentsCountAsync(joSub.ItemId.Value, "Item");

                var stock = await jobOrderService.GetAvailableStockByItemIdAsync(joSub.ItemId.Value,null);
                joSub.stockQty = stock;
            }

            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing Job Order.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingJobId failed for JobId: {jobId}");
        }
    }

    private bool CheckIsTransMade()
    {
        var list = JobOrderVMs?.JobOrderSubVMs;
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalQty += list[i].ReqQty.GetValueOrDefault();
            totalBalQty += list[i].BalQty.GetValueOrDefault();
        }

        return totalQty != totalBalQty;
    }

    #endregion


    #region isManual JobOrder Toggle 

    private async Task OnManualJObToggle(ChangeEventArgs e)
    {
        bool newValue = e.Value is bool b && b;
        JobOrderVMs.IsManual = newValue;

        if(JobOrderVMs.IsManual)
        {
            JobOrderVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            var JobNo= await jobOrderService.GetPreviewJobNoAsync(JobOrderVMs.Suffix);
            JobOrderVMs.JobNo = JobNo.ToString("D3");
        }
        else
        {
            JobOrderVMs.SelectedAssemblyItem = null;
            JobOrderVMs.AssyId = null;
            JobOrderVMs.UtilQty = 0;
            JobOrderVMs.Suffix = "";
            JobOrderVMs.JobNo = "";
        }
        StateHasChanged();
    }

    #endregion 


    #region Customer data

    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3) 
            return Enumerable.Empty<CustomerVM>();

        try
        {
            var results = await jobOrderService.SearchCustomersAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<CustomerVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<CustomerVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchCustomers failed for value: {value}");
            await _js.ToastrError("Failed to search customers. Please try again.");
            return Enumerable.Empty<CustomerVM>();
        }
    }

    private async Task OnCustomerChanged(CustomerVM? customer)
    {
        try
        {
