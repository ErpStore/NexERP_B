    #region Show BOM Details

    private async Task ShowBOMDetails()
    {
        try
        {
            isProcessing = true;

            ExistingBOMData = await jobOrderService.GetExistingBOMDetailsAsync(JobOrderVMs.JobId);
            LatestChangedBOMData = await jobOrderService.GetLatestBOMFromAssemblyDefAsync(JobOrderVMs.AssyId.Value);

            var existingBom = ExistingBOMData?
                .Select(x => new
                {
                    ItemId = Convert.ToInt32(x["ItemId"]),
                    UtilQty = Convert.ToDecimal(x["UtilQty"])
                })
                .ToList() ?? new();

            // ---------------------------------------------------
            // STEP 1: ADD FLAGS (IsNewItem, IsQtyChanged)
            // ---------------------------------------------------
            foreach (var latest in LatestChangedBOMData)
            {
                int itemId = Convert.ToInt32(latest["ItemId"]);
                decimal latestQty = Convert.ToDecimal(latest["UtilQty"]);

                var existing = existingBom.FirstOrDefault(e => e.ItemId == itemId);

                if (existing == null)
                {
                    latest["IsNewItem"] = true;
                    latest["IsQtyChanged"] = false;
                }
                else
                {
                    bool qtyChanged = existing.UtilQty != latestQty;
                    latest["IsNewItem"] = false;
                    latest["IsQtyChanged"] = qtyChanged;
                }
            }

            // ---------------------------------------------------
            // STEP 2: APPLY FILTER (ONLY NEW OR CHANGED ITEMS)
            // ---------------------------------------------------
            LatestChangedBOMData = LatestChangedBOMData
                .Where(latest =>
                    (bool)latest["IsNewItem"] == true ||
                    (bool)latest["IsQtyChanged"] == true
                )
                .ToList();

            // ---------------------------------------------------
            // STEP 3: SHOW MODAL IF ANY DIFFERENCE FOUND
            // ---------------------------------------------------
            if ((ExistingBOMData?.Count ?? 0) > 0 || (LatestChangedBOMData?.Count ?? 0) > 0)
            {
                IsBOMModalVisible = true;
            }
            else
            {
                await _js.ToastrWarning("No BOM changes found.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ShowBOMDetails failed.");
            await _js.ToastrError("Error fetching BOM Details list.");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task OnLatestBOMSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (JobOrderVMs.JobOrderSubVMs == null)
            JobOrderVMs.JobOrderSubVMs = new List<JobOrderSubVM>();

        try
        {
            foreach (var item in selectedItems)
            {
                int itemId = item.TryGetValue("ItemId", out var idObj) && idObj != null
                    ? Convert.ToInt32(idObj)
                    : 0;

                decimal newUtilQty = item.TryGetValue("UtilQty", out var qtyObj) && qtyObj != null
                    ? Convert.ToDecimal(qtyObj)
                    : 0m;

                decimal newReqQty = newUtilQty * JobOrderVMs.JobOrderQty;

                var existing = JobOrderVMs.JobOrderSubVMs
                    .FirstOrDefault(x => x.ItemId == itemId);

                if (existing != null)
                {
                    decimal oldReq = existing.ReqQty.GetValueOrDefault();
                    decimal oldBal = existing.BalQty.GetValueOrDefault();

                    decimal diff = newReqQty - oldReq; 

                    if (oldBal == 0 && diff < 0)
                    {
                        await _js.ToastrWarning($"Utility Qty for Item Code {existing.ItemCode} cannot be reduced as the material is already fully issued.");
                        continue;
                    }

                    decimal newBal = oldBal + diff;

                    if (newBal < 0)
                        newBal = 0;

                    existing.UtilQty = newUtilQty;
                    existing.ReqQty = newReqQty;
                    existing.BalQty = newBal;

                    continue;
                }

                var newSubVm = new JobOrderSubVM
                {
                    JobId = JobOrderVMs.JobId,
                    ItemId = itemId,
                    ItemCode = item.TryGetValue("ItemCode", out var codeObj) ? codeObj?.ToString() : "",
                    ItemName = item.TryGetValue("ItemName", out var nameObj) ? nameObj?.ToString() : "",
                    Measureunit = item.TryGetValue("MeasureUnit", out var muObj) ? muObj?.ToString() :
                                  item.TryGetValue("UOM", out var uomObj) ? uomObj?.ToString() : "",

                    UtilQty = newUtilQty,
                    ReqQty = newReqQty,
                    BalQty = newReqQty // New row → full balance
                };

                JobOrderVMs.JobOrderSubVMs.Add(newSubVm);
            }

            int slNo = 1;
            foreach (var row in JobOrderVMs.JobOrderSubVMs)
                row.SlNo = slNo++;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnLatestBOMSelectedAsync failed.");
            await _js.ToastrError("Error processing selected Latest BOM changed items.");
        }
    }
