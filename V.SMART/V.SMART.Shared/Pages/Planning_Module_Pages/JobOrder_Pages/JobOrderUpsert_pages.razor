    private async Task GenerateJobOrder()
    {
        isProcessing = true;

        try
        {
            var SelectedAssyRows = JobOrderAssyPoItemVMs.Where(x => x.IsSelected).ToList();
            int staffid = await jobOrderService.GetStaffIdByCurrentuserAsync() ?? 0;
            int? correctStaffId =null;
            if (!SelectedAssyRows.Any())
            {
                await _js.ToastrWarning("Please select at least 1 Assembly to generate Job Order");
                return;
            }

            var parentMap = new Dictionary<int, (int parentJobId, int assyItemId)>();

            foreach (var AssyItem in SelectedAssyRows)
            {
                var suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
                var PreviewJobNo = await jobOrderService.GetPreviewJobNoAsync(suffix);
                correctStaffId = 0;
                correctStaffId  = (AssyItem?.StaffID == null || AssyItem.StaffID == 0)
                              ? staffid
                              : AssyItem.StaffID.Value;
                var AssyjobOrder = new JobOrderVM
                {
                    MfgORLab = JobOrderVMs.MfgORLab,
                    IsManual = JobOrderVMs.IsManual,
                    Suffix = suffix,
                    JobNo = PreviewJobNo.ToString("D3"),
                    JobDate = DateTime.Now,
                    CustId = JobOrderVMs.SelectedCustomer?.CustId,
                    RefPoId = JobOrderVMs.RefPoId,
                    RefPoSubId = AssyItem.RefPoSubId,
                    AssyId = AssyItem.AssyItemId,
                    POQty = AssyItem.PoQty,
                    JobOrderQty = AssyItem.ReqQty,
                    JobBalQty = AssyItem.ReqQty,
                    StaffID= correctStaffId == 0 ? null : correctStaffId,
                    CreatedBy = await _userService.GetUsernameAsync(),
                    CreatedDate = DateTime.Now,

                    JobOrderSubVMs = new List<JobOrderSubVM>()
                };

                var BomItems = await jobOrderService.GetBOMItemsByAssyIdAsync(AssyItem.AssyItemId.Value);
                int slno = 1;
                foreach (var bomItem in BomItems)
                {
                    AssyjobOrder.JobOrderSubVMs.Add(new JobOrderSubVM
                    {
                        JobId = AssyjobOrder.JobId,
                        SlNo = slno++,
                        ItemId = bomItem.ItemID,
                        UtilQty = bomItem.UtilQty,
                        ReqQty = bomItem.UtilQty * AssyItem.ReqQty,
                        BalQty = bomItem.UtilQty * AssyItem.ReqQty,
                        CostId = AssyItem.CostId
                    });
                }

                var savedParentJO = await jobOrderService.UpsertJobOrderAsync(AssyjobOrder);
                int parentJobId = savedParentJO.JobId;

                if (AssyItem.AssyItemId.HasValue)
                    parentMap[parentJobId] = (parentJobId, AssyItem.AssyItemId.Value);

                await jobOrderService.AdjustPoWorkOrderBalanceAsync(
                    AssyjobOrder.RefPoSubId.GetValueOrDefault(),
                    0,
                    AssyjobOrder.JobOrderQty,
                    "Job Order Created"
                );

                //Important
                var childSubRowsForThisParent = PreviewVMs.Where(x => x.IsSelected&& x.RefPoSubId == AssyItem.RefPoSubId && x.SubAssyId != AssyItem.AssyItemId).ToList();

                if (childSubRowsForThisParent.Any())
                {
                    foreach (var subItem in childSubRowsForThisParent)
                    {
                        var childSuffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
                        var childPreviewJobNo = await jobOrderService.GetPreviewJobNoAsync(childSuffix);
                        correctStaffId = 0;
                        correctStaffId  = (subItem?.StaffID == null || subItem.StaffID == 0)
                                ? staffid
                                : subItem.StaffID.Value;
                        var SubAssyjobOrder = new JobOrderVM
                        {
                            ParentJobId = parentJobId,  // link to this specific parent
                            MfgORLab = JobOrderVMs.MfgORLab,
                            IsManual = JobOrderVMs.IsManual,
                            Suffix = childSuffix,
                            JobNo = childPreviewJobNo.ToString("D3"),
                            JobDate = DateTime.Now,
                            CustId = JobOrderVMs.SelectedCustomer?.CustId,
                            RefPoId = JobOrderVMs.RefPoId,
                            RefPoSubId = subItem.RefPoSubId,
                            AssyId = subItem.SubAssyId,
                            UtilQty = subItem.UtilQty,
                            POQty = subItem.PoQty,
                            JobOrderQty = subItem.JobOrderQty,
                            JobBalQty = subItem.JobOrderQty,
                            StaffID= correctStaffId == 0 ? null : correctStaffId,

                            CreatedBy = await _userService.GetUsernameAsync(),
                            CreatedDate = DateTime.Now,
                            JobOrderSubVMs = new List<JobOrderSubVM>()
                        };

                        // add BOM items for sub-assy
                        var subBomItems = await jobOrderService.GetBOMItemsByAssyIdAsync(subItem.SubAssyId);
                        int slno2 = 1;
                        foreach (var bomItem in subBomItems)
                        {
                            SubAssyjobOrder.JobOrderSubVMs.Add(new JobOrderSubVM
                            {
                                JobId = SubAssyjobOrder.JobId,
                                SlNo = slno2++,
                                ItemId = bomItem.ItemID,
                                UtilQty = bomItem.UtilQty,
                                ReqQty = bomItem.UtilQty * subItem.ReqQty,
                                BalQty = bomItem.UtilQty * subItem.ReqQty,
                                CostId = subItem.CostId
                            });
                        }

                        await jobOrderService.UpsertJobOrderAsync(SubAssyjobOrder);
                    }
                }
            } 

            await _js.ToastrSuccess("Job Order Created Successfully!");
            _navigationManager.NavigateTo("/jobOrderList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "GenerateJobOrder failed.");
            await _js.ToastrError("Error generating Job Orders from preview. Please try again.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }


