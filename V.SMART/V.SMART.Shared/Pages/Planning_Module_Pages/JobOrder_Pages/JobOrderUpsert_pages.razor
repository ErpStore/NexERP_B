    #region Manual JobOrder QtyChanges

    private async Task OnJobOrderQtyChanged(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var newQty))
            return;

        if(JobOrderVMs.JobId == 0)
        {
            JobOrderVMs.JobOrderQty = newQty;
            JobOrderVMs.JobBalQty = newQty;
        }
        else
        {
            var original = await jobOrderService.GetJobQtyAndJobBalQtyByJobId(JobOrderVMs.JobId);
            var alreadyTransacted = original.JobOrderQty - original.JobBalQty;

            if (newQty < alreadyTransacted)
            {
                JobOrderVMs.JobOrderQty = alreadyTransacted;
                JobOrderVMs.JobBalQty = 0;
                await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} as it is already transacted.");
            }
            else
            {
                var difference = newQty - original.JobOrderQty;
                JobOrderVMs.JobOrderQty = newQty;
                JobOrderVMs.JobBalQty = original.JobBalQty + difference;
            }
        }

        if (JobOrderVMs.JobOrderSubVMs != null && JobOrderVMs.JobOrderSubVMs.Any())
        {
            foreach (var row in JobOrderVMs.JobOrderSubVMs)
            {
                row.ReqQty = row.UtilQty * JobOrderVMs.JobOrderQty;
                row.BalQty = row.ReqQty;
            }
        }

        StateHasChanged();

    }

