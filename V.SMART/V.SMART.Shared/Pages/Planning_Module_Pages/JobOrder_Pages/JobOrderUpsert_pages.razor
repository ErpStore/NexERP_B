@page "/jobOrder/create"
@page "/jobOrder/update/{jobId:int}"


@using V.SMART.Shared.Data.Planning.AssyJobOrder
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel

@using V.SMART.Shared.ViewModels.MasterViewModel.HumanResourceViewModel
@using V.SMART.Shared.ViewModels.PlanningViewModel.JobOrderViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IJobOrderService jobOrderService
@inject ILoggingService LoggingService
@inject ReportService reportService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="BOM Comparison"
              Data="@LatestChangedBOMData" 
              Columns="@LatestBOMColumns"
              ColumnFields="@LatestBOMFields"
              HiddenColumns="@LatestBOMHiddenColumns"
              IsVisible="@IsBOMModalVisible"
              IsVisibleChanged="@((v) => IsBOMModalVisible = v)"
              OnSelectedItems="OnLatestBOMSelectedAsync">

    <HeaderContent>

        <div class="alert alert-warning p-2 small mb-3">
            <strong class="text-danger fw-bold">Note:</strong>
            <span class="fw-bold badge bg-warning text-dark">Yellow highlighted items</span>
            indicate <span class="text-dark">newly added BOM Items</span>.
            <span class="fw-bold badge bg-danger text-white">Red highlighted quantities</span>
            indicate <span class="text-dark">changed Utility Quantities</span>.
        </div>

        @if (ExistingBOMData != null && ExistingBOMData.Any())
        {
            <h5 class="fw-bold text-primary mb-2">Existing BOM (Job Order)</h5>

            <div class="table-responsive" style="max-height:60vh;">
                <table class="table table-bordered table-hover mb-0" style="min-width:800px;">
                    <thead class="custom-blue">
                        <tr>
                            @foreach (var col in ExistingBOMColumns)
                            {
                                <th>@col</th>
                            }
                        </tr>
                    </thead>

                    <tbody class="custom-size">
                        @foreach (var row in ExistingBOMData)
                        {
                            <tr>
                                <td>@row["ItemCode"]</td>
                                <td>@row["ItemName"]</td>
                                <td>@row["UOM"]</td>
                                <td>@row["UtilQty"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            

            <h5 class="fw-bold text-success mb-2 mt-3">
                Latest BOM (Assembly Definition)
            </h5>

        }


    </HeaderContent>

</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if (JobOrderVMs.Cancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }

            <PageHeader TitleText="@(JobOrderVMs.JobId > 0 ? "Update Job Order" : "Create Job Order")"
                TitleIcon="bi bi-tag"
                Breadcrumbs="@JobOrderFormBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="JobOrderVMs" OnValidSubmit="UpsertJobOrder">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Manufacturing / Labour Toggle -->
                        <div class="col-12 col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex justify-content-around align-items-center">

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="ManufacturingSwitch"
                                               checked="@JobOrderVMs.MfgORLab"
                                               @onchange="(e) => OnManufacturingToggle(e)" />
                                        <label class="form-check-label fw-semibold @(JobOrderVMs.MfgORLab ? "text-success" : "")"
                                               for="ManufacturingSwitch">
                                            <i class="bi bi-gear-fill me-1"></i> Manufacturing
                                        </label>
                                    </div>

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="LabourSwitch"
                                               checked="@(!JobOrderVMs.MfgORLab)"
                                               @onchange="(e) => OnLabourToggle(e)" />
                                        <label class="form-check-label fw-semibold @(!JobOrderVMs.MfgORLab ? "text-danger" : "")"
                                               for="LabourSwitch">
                                            <i class="bi bi-people-fill me-1"></i> Labour
                                        </label>
                                    </div>

                                </div>
                                <ValidationMessage For="@(() => JobOrderVMs.MfgORLab)" />
                            </div>
                        </div>
                         @if (!ManuallyJobButton)
                        {
                            <!-- Manual JobOrder Toggle -->
                            <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">

                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ManualJobSwitch"
                                    checked="@JobOrderVMs.IsManual"
                                    disabled="@JobOrderVMs.JobOrderSubVMs.Any(x => !string.IsNullOrEmpty(x.ItemCode))"
                                    @onchange="(e) => OnManualJObToggle(e)" />
                                    <label class="form-check-label fw-semibold @(JobOrderVMs.IsManual ? "text-primary" : "")"
                                    for="ManualJobSwitch">
                                        <i class="bi bi-folder2-open me-1"></i> Manual
                                    </label>
                                </div>
                                <ValidationMessage For="@(() => JobOrderVMs.IsManual)" />

                            </div>
                        }
                        <!-- Correspondence Status -->
                        <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">
                            @if (JobOrderVMs.JobId > 0 && !string.IsNullOrWhiteSpace(JobOrderVMs.JobNo))
                            {
                                <CorrespondenceStatus ReferenceType=@ScreenName
                                                      ReferenceId="@JobOrderVMs.JobId"
                                                      ReferenceTypeName="@JobOrderVMs.JobNo" />
                            }
                        </div>

                    </div>


                    <div class="row g-3 mb-2">

                        @if((jobId == null || jobId == 0) && !JobOrderVMs.IsManual)
                        {
                            <!-- =================== Customer Section =================== -->
                            <div class="col-12 col-lg-6 mb-3">
                                <div class="card shadow-sm border-0 rounded-3">
                                    <div class="card-header fw-semibold text-primary py-2" style="background-color:#EAF3FF;">
                                        <i class="bi bi-person-badge"></i> Customer Information
                                    </div>

                                    <div class="card-body">
                                        <!-- Customer Autocomplete -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label text-dark">
                                                <small>M/S.*</small>
                                            </label>

                                            <div class="col-12 col-sm-9">
                                                <MudAutocomplete T="CustomerVM"
                                                    Value="JobOrderVMs.SelectedCustomer"
                                                    ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                    ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                    SearchFunc="SearchCustomers"
                                                    Dense="true"
                                                    Variant="Variant.Outlined"
                                                    Placeholder="Search Customer"
                                                    Class="w-100"
                                                    MaxItems="50"
                                                    Clearable="true"
                                                    Required="true"
                                                    Disabled="@IsSomeItemsTransMade"/>
                                            </div>
                                        </div>

                                        <!-- Customer PO -->
                                        @if(CustomerPendingPOs.Any())
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label text-dark">
                                                    <small>PO No*</small>
                                                </label>

                                                <div class="col-12 col-sm-9">
                                                    <select class="form-select form-select-sm rounded-3"
                                                            value="@JobOrderVMs.RefPoId"
                                                            @onchange="OnPoChanged">
                                                        <option value="">--- Select PO ---</option>
                                                        @foreach (var po in CustomerPendingPOs)
                                                        {
                                                            <option value="@po.PoId">@po.PONo</option>
                                                        }
                                                    </select>

                                                    <ValidationMessage For="@(() => JobOrderVMs.RefPoId)" />
                                                </div>
                                            </div>
                                        }
                                    </div>

                                </div>
                            </div>

                            <!-- =================== Assembly Items =================== -->
                            @if(JobOrderAssyPoItemVMs.Any())
                            {
                                <div class="col-12 mb-3">
                                    <div class="card shadow-sm border-0 rounded-3">

                                        <div class="card-header bg-info bg-opacity-10 text-dark fw-semibold py-2">
                                            <i class="bi bi-diagram-2"></i> Assembly Details
                                        </div>

                                        <div class="card-body p-2">
                                            <div class="table-responsive" style="overflow-x:auto;">
                                                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1200px;">
                                                    <thead class="custom-blue">
                                                        <tr>
                                                            @* <th style="width:60px;">Select</th> *@
                                                             <th class="text-center" style="width:50px;">
                                                                <input type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" />
                                                            </th>
                                                                   @if(IsAssignJobOrderDepartment)
                                                                {
                                                                    <th style="width:150px;">Staff Name</th>
                                                                    <th style="width:100px;">DepartmentCode</th>
                                                                }
                                                            <th style="width:70px;">PO No</th>
                                                            <th style="width:80px;">PO Date</th>
                                                            <th style="width:100px;">Assembly Code</th>
                                                            <th style="width:80px;">PO Qty</th>
                                                            <th style="width:80px;">Bal Qty</th>
                                                            <th style="width:80px;">Req Qty</th>
                                                            <th style="width:80px;">Stock Qty</th>
                                                            <th style="width:100px;">CostCenter</th>
                                                             <th style="width:100px;">LineNo</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody class="custom-size">
                                                        @foreach (var itm in JobOrderAssyPoItemVMs)
                                                        {
                                                            <tr class="@(itm.IsSelected ? "table-warning" : "")">
                                                                <td>
                                                                    <div class="text-center align-content-between">
                                                                        <input type="checkbox"
                                                                               checked="@itm.IsSelected"
                                                                               @onchange="(e) => OnAssemblySelectChanged(itm, (bool)e.Value)"
                                                                               class="form-check-input darker-border-checkbox"
                                                                               style="transform: scale(1.5); cursor: pointer;" />
                                                                    </div>
                                                                </td>
                                                                   @if(IsAssignJobOrderDepartment)
                                                                   {
                                                                        <td> 
                                                                             <select class="form-select"
                                                                                 @onchange="(e => OnStaffsChanged(e, itm))">

                                                                               <option value="">Select Staff</option>

                                                                               @foreach (var staff in staffVMs)
                                                                               {
                                                                                   <option value="@staff.StaffID">@staff.StaffName</option>
                                                                               }
                                                                           </select>

                                                                       </td>
                   
                                                                       <td>@itm.DepartmentCode</td>
                                                                   }

                                                                <td>@itm.RefPoNo</td>
                                                                <td>@itm.RefPoDate?.ToString("dd-MM-yyyy")</td>
                                                                <td>@itm.AssyItemCode</td>
                                                                <td>@itm.PoQty</td>
                                                                <td>@itm.WoBalQty</td>
                                                                <td>
                                                                    <input type="number"
                                                                           class="form-control text-center"
                                                                           min="0"
                                                                           step="any"
                                                                           max="@itm.WoBalQty"
                                                                           @bind="itm.ReqQty"
                                                                           @bind:event="oninput"
                                                                           @bind:after='() => OnReqQtyChanged(itm)' />
                                                                    <ValidationMessage For="@(() => itm.ReqQty)" />
                                                                </td>
                                                                <td class="text-danger fw-bold">@itm.StockQty</td>
                                                                <td>@itm.ProjectNo</td>
                                                                 <td>@itm.LineNo</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="text-end mt-2">
                                                <button type="button" class="btn btn-sm btn-primary rounded-3 shadow-sm"
                                                        @onclick="PreviewTempJobOrder"
                                                        disabled="@(!JobOrderAssyPoItemVMs.Any(x => x.IsSelected))">
                                                    <i class="bi bi-eye"></i> Preview Job Order
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- =================== Preview Details =================== -->
                            @if(PreviewVMs.Any())
                            {
                                <div class="col-12 mb-2">
                                    <div class="card shadow-sm border-0 rounded-3">

                                        <div class="card-header bg-warning bg-opacity-25 fw-semibold py-2">
                                            <i class="bi bi-list-check"></i> Job Order Preview
                                        </div>

                                        <div class="card-body p-2">
                                            <div class="table-responsive" style="overflow-x:auto;">
                                                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1200px;">
                                                    <thead class="custom-blue">
                                                        <tr>
                                                            <th class="text-center" style="width:50px;">
                                                                <input type="checkbox" checked="@IsAllSelected" @onchange="PreviewVMsToggleSelectAll" />
                                                            </th>
                                                             @if(IsAssignJobOrderDepartment)
                                                             {
                                                                 <th>Staff Name</th>
                                                                 <th>DepartmentCode</th>
                                                             }
                                                            <th>Temp Job No</th>
                                                            <th class="d-none">SubAssyId</th>
                                                            <th>Sub Assemblies</th>
                                                            <th>UOM</th>
                                                            <th class="d-none">RefPoSubId</th>
                                                            <th>RefPoNo</th>
                                                            <th>PoQty</th>
                                                            <th>Job Qty</th>
                                                            <th>Utility</th>
                                                            <th>Req Qty</th>
                                                            <th>Stock Qty</th>
                                                            <th class="d-none">CostId</th>
                                                            <th>CostCenter</th>
                                                             <th>LineNo</th>

                                                        </tr>
                                                    </thead>

                                                    <tbody class="custom-size">
                                                        @foreach (var itm in PreviewVMs)
                                                        {
                                                            <tr>
                                                                <td class="text-center">
                                                                    <div class="text-center align-content-between">
                                                                        <input type="checkbox"
                                                                               checked="@itm.IsSelected"
                                                                               @onchange="(e) => OnPrevAssySelectChanged(itm, (bool)e.Value)"
                                                                               class="form-check-input darker-border-checkbox"
                                                                               style="transform: scale(1.5); cursor: pointer;" />
                                                                    </div>
                                                                </td>
                                                                  @if(IsAssignJobOrderDepartment)
                                                                    {
                                                                        <td> 
                                                                            <select class="form-select"
                                                                                @onchange="(e => OnStaffChanged(e, itm))">

                                                                                <option value="">Select Staff</option>

                                                                                @foreach (var staff in staffVMs)
                                                                                {
                                                                                    <option value="@staff.StaffID">@staff.StaffName</option>
                                                                                }
                                                                            </select>

                                                                        </td>
                 
                                                                        <td>@itm.DepartmentCode</td>
                                                                    }
                                                                <td>@itm.TempJobNo</td>
                                                                <td class="d-none">@itm.SubAssyId</td>
                                                                <td>@itm.SubAssyCode</td>
                                                                <td>@itm.MeasureUnit</td>
                                                                <td class="d-none">@itm.RefPoSubId</td>
                                                                <td>@itm.RefPoNo</td>
                                                                <td>@itm.PoQty</td>
                                                                <td>@itm.JobOrderQty</td>
                                                                <td>@itm.UtilQty</td>
                                                                <td>@itm.ReqQty</td>
                                                                <td class="text-danger fw-bold">@itm.StockQty</td>
                                                                <td class="d-none">@itm.CostId</td>
                                                                <td>@itm.ProjectNo</td>
                                                                 <td>@itm.LineNo</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="mt-2 d-flex justify-content-end">
                                                <button type="button" class="btn btn-sm btn-success rounded-3 shadow-sm"
                                                        @onclick="GenerateJobOrder"
                                                        disabled="@(!JobOrderAssyPoItemVMs.Any(x => x.IsSelected))">
                                                    <i class="bi bi-check-circle"></i> Generate Job Order
                                                </button>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else if(JobOrderVMs.IsManual)
                        {
                            <!-- =================== Customer details =================== -->
                            <div class="col-12 col-lg-6 mb-2">
                                <div class="card h-100 shadow-sm border-0">
        
                                    <!-- Header -->
                                    <div class="card-header fw-semibold text-primary py-2" style="background-color:#EAF3FF;">
                                        <i class="bi bi-diagram-3 me-1"></i> Assembly Details
                                    </div>

                                    <div class="card-body pt-3 pb-2">

                                        <!-- Assembly / Sub Assembly -->
                                        @if(JobOrderVMs.JobId == 0 || JobOrderVMs.JobId == null)
                                        {
                                            <div class="row mb-3">
                                                <label class="col-12 col-sm-3 col-form-label text-dark">
                                                    <small>Assembly / Sub-Assembly</small>
                                                </label>

                                                <div class="col-12 col-sm-9">
                                                    <MudAutocomplete T="ItemVM"
                                                        Value="JobOrderVMs.SelectedAssemblyItem"
                                                        ValueChanged="@(async a => await OnAssyChanged(a))"
                                                        ToStringFunc="@(a => a?.ItemCode ?? string.Empty)"
                                                        SearchFunc="SearchAssyOrSubAssembly"
                                                        Dense="true"
                                                        Variant="Variant.Outlined"
                                                        Placeholder="Search Assembly/Sub-Assembly"
                                                        Class="w-100"
                                                        MaxItems="50"
                                                        Clearable="true"
                                                        Required="true"
                                                        Disabled="@IsSomeItemsTransMade" />
                                                </div>
                                            </div>
                                            
                                        }
                                        else
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Assy/SubAssy.</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text"
                                                           class="form-control form-control-sm rounded-3"
                                                           @bind="JobOrderVMs.AssemblyItemCode"
                                                           readonly />
                                                </div>
                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>

                            <!-- =================== Job order details =================== -->
                            <div class="col-12 col-lg-6 mb-2">
                                <div class="card h-100 shadow-sm">

                                    <!-- Header -->
                                    <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                        <span class="fw-bold fs-6">Job Order Details</span>
                                        @if (JobOrderVMs.JobId > 0 &&
                                                    (JobOrderVMs.JobOrderSubVMs == null ||
                                                    !JobOrderVMs.JobOrderSubVMs.Any(x => x.ItemCancel)))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm rounded-3 @(JobOrderVMs.Cancel ? "btn-success" : "btn-danger")"
                                                        @onclick="Cancel">

                                                @if (!JobOrderVMs.Cancel)
                                                {
                                                    <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                                }
                                            </button>
                                        }
                                    </div>

                                    <div class="card-body">

                                        <!--Job order No -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Job Order No</small>
                                            </label>
                                              @if (IsAssignJobOrderDepartment)
                                              {
                                                  <div class="col-12 col-sm-9">
                                                      <div class="input-group input-group-sm w-100">

                                                          <!-- Department -->
                                                          <span class="input-group-text">
                                                              @JobOrderVMs.DepartmentCode
                                                          </span>

                                                          <!-- Job No -->
                                                          <InputText class="form-control text-center"
                                                                     placeholder="Job No."
                                                                     @bind-Value="JobOrderVMs.JobNo"
                                                                     readonly />

                                                          <!-- Suffix -->
                                                          <span class="input-group-text">
                                                              @JobOrderVMs.Suffix
                                                          </span>

                                                      </div>

                                                      <ValidationMessage For="@(() => JobOrderVMs.JobNo)" />
                                                  </div>
                                              }
                                              else
                                              {
                                            <div class="col-12 col-sm-9">
                                                <div class="input-group input-group-sm w-100 rounded-3">
                                                    <InputText class="form-control form-control-sm rounded-3"
                                                                placeholder="Job No."
                                                                maxlength="30"
                                                                @bind-Value="@JobOrderVMs.JobNo"
                                                                readonly />
                                                    <span class="input-group-text rounded-3">@JobOrderVMs.Suffix</span>
                                                </div>
                                                <ValidationMessage For="@(() => JobOrderVMs.JobNo)" />
                                            </div>
                                            }
                                        </div>

                                        <!-- Job Date -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Job Order Date</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputDate class="form-control form-control-sm rounded-3"
                                                            @bind-Value="@JobOrderVMs.JobDate"/>
                                                <ValidationMessage For="@(() => JobOrderVMs.JobDate)" />
                                            </div>
                                        </div>

                                        <!-- Job Order Qty -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Job Order Qty</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <input type="number" class="form-control form-control-sm rounded-3 w-100" step="any"
                                                       @bind-value="JobOrderVMs.JobOrderQty"
                                                       @bind-value:event="oninput"
                                                       @onchange="OnJobOrderQtyChanged" />
                                                <ValidationMessage For="@(() => JobOrderVMs.JobOrderQty)" />
                                            </div>
                                        </div>
                                         <div class="mb-2 row">
                                             <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                 <small>Remarks</small>
                                             </label>
                                             <div class="col-12 col-sm-9">
                                                 <textarea class="form-control form-control-sm rounded-3 w-100"
                                                           @bind-value="JobOrderVMs.Remark"
                                                           @bind-value:event="oninput">
                                                 </textarea>

                                                 <ValidationMessage For="@(() => JobOrderVMs.Remark)" />
                                             </div>
                                         </div>

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm w-100 d-flex align-items-center justify-content-center fw-bold text-white"
                                                        style="background-color:#6f42c1; border-color:#6f42c1;"
                                                        @onclick="ShowBOMDetails">
                                                    <i class="bi bi-list-ul me-1 text-white"></i> 
                                                    Load Latest BOM Details
                                                </button>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <!-- =================== Item Details =================== -->
                            <div class="col-12">
                                <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                               
                                    <div class="card-header bg-primary-subtle text-dark">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap">
                                            <!-- Title -->
                                            <span class="fw-bold fs-6">Item Details</span>
                                        </div>
                                    </div>

                                    <div class="card-body p-2">
