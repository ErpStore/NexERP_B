@page "/jobOrder/details/{JobId:int}"
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@inherits BaseUserRightsComponent

@inject IJobOrderService jobOrderService
@inject IJSRuntime js
@inject ILoggingService logs
@inject NavigationManager _nav
@inject ReportService reportService

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
      <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

        <!-- Company Details Section -->
        <MyCompanyDetails />

         <!-- Cancelled Watermark -->
         @if (JobOrderVMs.Cancel)
         {
             <div class="cancelWatermark ms-20 mt-10">CANCELLED</div>
         }
    
        <hr class="border-2 border-primary-subtle mb-4" />
        <div class="text-center">
            <h4 class="fw-semibold mt-3">Job Order Details</h4>
        </div>

        <hr class="border-2 border-primary-subtle mb-4" />

        <!-- Customer / Assembly Details -->
        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">

                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        @(JobOrderVMs.CustId > 0 ? "Customer Details" : "Assembly Details")
                    </div>

                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>

                                @if (JobOrderVMs.CustId > 0)
                                {
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Name</strong></td>
                                        <td>@(JobOrderVMs?.CustomerName ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Ref PO No.</strong></td>
                                        <td>@(JobOrderVMs?.RefPoNo ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Ref PO Dt.</strong></td>
                                        <td>@(JobOrderVMs?.RefPODate)</td>
                                    </tr>
                                }

                                <tr>
                                    <td class="text-secondary"><strong>Assembly/Sub-Assembly</strong></td>
                                    <td>@(JobOrderVMs?.AssemblyItemCode ?? "N/A")</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary"><strong>Utility</strong></td>
                                    <td>@($"{JobOrderVMs?.UtilQty:0.###}")</td>
                                </tr>

                            <tr>
                                <td class="text-secondary"><strong>Line No.</strong></td>
                                <td>@($"{JobOrderVMs?.LineNo}")</td>
                            </tr>

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

            <!-- Document Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">

                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Document Details
                    </div>

                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>

                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>JobOrder No</strong></td>
                                    @* <td>@(JobOrderVMs != null ? $"{JobOrderVMs.JobNo}{JobOrderVMs.Suffix}" : "N/A")</td> *@
                                <td>
                                    @(JobOrderVMs != null
                                    ? (!string.IsNullOrEmpty(JobOrderVMs.DepartmentCode)
                                    ? JobOrderVMs.DepartmentCode + "/" + JobOrderVMs.JobNo + (JobOrderVMs.Suffix ?? "")
                                    : JobOrderVMs.JobNo + (JobOrderVMs.Suffix ?? ""))
                                    : "N/A")
                                </td>
                                </tr>

                                <tr>
                                     <td class="text-secondary"><strong>JobOrder Date</strong></td>
                                    <td>@(JobOrderVMs?.JobDate.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary"><strong>PO Qty.</strong></td>
                                    <td>@($"{JobOrderVMs?.POQty:0.###}")</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary"><strong>Job Order Qty.</strong></td>
                                    <td>@($"{JobOrderVMs?.JobOrderQty:0.###}")</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

        <!-- Job Order Items -->
        <div class="card border-1 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                Job Order Items
            </div>

            <div class="table-responsive" style="overflow-x:auto;">
                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                    <thead class="custom-blue">
                        <tr>
                            <th>Sl No.</th>
                            <th>Item Code</th>
                            <th>Description</th>
                            <th>UOM</th>
                            <th>Utility</th>
                            <th>ReqQty</th>
                            <th>Stock Qty</th>
                            <th>Balance Qty</th>
                            <th>Cost Center</th>
                        </tr>
                    </thead>

                    <tbody class="custom-size">

                        @if (JobOrderVMs?.JobOrderSubVMs != null && JobOrderVMs.JobOrderSubVMs.Any())
                        {
                            @foreach (var item in JobOrderVMs.JobOrderSubVMs)
                            {
                                <tr>
                                    <td>@item.SlNo</td>
                                    <td>@(item.ItemCode ?? "—")</td>
                                    <td>@(item.ItemName ?? "—")</td>
                                    <td>@item.Measureunit</td>
                                    <td>@($"{item.UtilQty:0.###}")</td>
                                    <td>@($"{item.ReqQty:0.###}")</td>
                                    <td>@($"{item.stockQty:0.###}")</td>
                                    <td>@($"{item.BalQty:0.###}")</td>
                                    <td>@item.ProjectNo</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" class="text-center text-muted">No items found</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2 justify-content-end">
                <a href="@($"/jobOrderList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                    <i class="bi bi-arrow-bar-left me-1"></i> Back To List
                </a>

            <a href="@($"/jobOrder/update/{JobId}")" class="btn btn-outline-primary">
                <i class="bi bi-pencil-square"></i> Modify
            </a>

            <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                <i class="bi bi-printer"></i> Print
            </button>


        </div>

    </div>
    }
}

@code {

    protected override string ScreenName => "Job Order";

    [Parameter] public int JobId { get; set; }
    private string? pdfBase64;
    private bool isProcessing { get; set; } = true;
    private JobOrderVM JobOrderVMs { get; set; } = new();
    private CustomerVM CustomerVMs { get; set; } = new();

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();

            if (!CanView)
            {
                _nav.NavigateTo("/access-denied");
                return;
            }
            await LoadJobOrders();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in JobOrderList OnInitializedAsync");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadJobOrders()
    {
        try
        {
            if (JobId <= 0)
                return;

            var jobOrder = await jobOrderService.GetJobOrderByJobIdAsync(JobId);

            if (jobOrder == null)
            {
                await js.ToastrWarning("Job Order not found.");
                return;
            }

            JobOrderVMs = jobOrder;

            if (jobOrder.CustId.HasValue)
            {
                CustomerVMs = await jobOrderService.GetCustomerByIdAsync(jobOrder.CustId.Value);
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error loading Job Order by JobId");
            await js.ToastrError("Failed to load Job Order details.");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            pdfBase64 = null;
            var pdfBytes = await reportService.Generate_Report(JobId, "JobOrder.frx", "JobId", false, ScreenName, "Sp_Print_JobOrder");
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf JobOrder");
            await js.ToastrError("An unexpected error occurred while generating the PDF in JobOrder.");
        }
    }

}
