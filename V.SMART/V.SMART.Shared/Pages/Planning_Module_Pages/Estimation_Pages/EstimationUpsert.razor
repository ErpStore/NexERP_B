	private async Task OnHoursInput(EstimateSubVM row, ChangeEventArgs e)
	{
		if (decimal.TryParse(e.Value?.ToString(), out decimal hrs))
		{
			ProcessCalucalate(row, hrs);
		}
		StateHasChanged();
		
	}

	private async Task ProcessCalucalate(EstimateSubVM row, decimal hrs)
	{
		try
		{
			row.Hrs = hrs;
			row.Amount = Math.Round((hrs / 60) * (row.HrlyRate ?? 0),3);
			//row.Amount = hrs * (row.HrlyRate ?? 0);

			// Calculate total conversion cost
			ConversionCost = EstimateVM.EstimateSubVM.Sum(i => i.Amount ?? 0);
			EstimateVM.Conv = ConversionCost;

			await Calculation(EstimateVM);

			StateHasChanged();
		}
		catch (Exception ex)
		{

			await LoggingService.LogDeveloperError(ex, "UpsertEstimation failed.");
			await _js.ToastrError("Error saving Estimation.");
		}
	}
	private void OnAmountInput(EstimateSubVM row, ChangeEventArgs e)
	{
		if (decimal.TryParse(e.Value?.ToString(), out var amount))
			row.Amount = amount;

		EstimateVM.Conv = EstimateVM.EstimateSubVM.Sum(x => x.Amount ?? 0m);
		RawMaterialCalculation(EstimateVM);

	}
	private async Task OnConvChanged(ChangeEventArgs e)
	{
		if (decimal.TryParse(e.Value?.ToString(), out decimal Conv))
		{
			EstimateVM.Conv = Conv;
			RawMaterialCalculation(EstimateVM);
			StateHasChanged();
		}


	}


	private void OnHoursChanged(ChangeEventArgs e)
	{
		if (decimal.TryParse(e.Value?.ToString(), out decimal hrs))
		{

			// Calculate total conversion cost
			ConversionCost = EstimateVM.EstimateSubVM.Sum(i => i.Amount ?? 0);
			EstimateVM.Conv = ConversionCost;

			StateHasChanged();
		}
	}


	private async Task Calculation(EstimateVM VM)
	{

		RawMaterialCalculation(VM);
	}
	private async Task RawMaterialCalculation(EstimateVM VM)
	{
		try
		{
			//EstimateVM = await _EstimateServiecs.Calculate(EstimateVM);
			//var result = await _EstimateServiecs.Calculate(EstimateVM);
			var result = await _EstimateServiecs.Calculate(VM);

			if (result != null)
			{
				//Indirect Heads
				VM.Overp = result.Overp;
				VM.Over = result.Over;

				VM.Marp = result.Marp;
				VM.Mar = result.Mar;

				VM.Riskp = result.Riskp;
				VM.Risk = result.Risk;

				VM.Packingper = result.Packingper;
				VM.Packing = result.Packing;

				VM.Logesticper = result.Logesticper;
				VM.Logestic = result.Logestic;

				//Suare Ram
				// VM.MtlSQR = result.MtlSQR;
				// VM.FnsizeSQR = result.FnsizeSQR;
				// VM.finsqrlen = result.finsqrlen;
				VM.RmthSQR = result.RmthSQR;
				VM.RmwdSQR = result.RmwdSQR;
				VM.RmlenSQR = result.RmlenSQR;
				VM.DenSQR = result.DenSQR;
				VM.RmkgSQR = result.RmkgSQR;
				VM.RmrateSQR = result.RmrateSQR;
				VM.RmcostSQR = result.RmcostSQR;

				//ROUND
				// VM.MtlRND = result.MtlRND;
				// VM.FnsizeRND = result.FnsizeRND;
				VM.RmdiaRND = result.RmdiaRND;
				VM.RmlenRND = result.RmlenRND;
				VM.DensityRND = result.DensityRND;
				VM.RmkgRND = result.RmkgRND;
				VM.RmrateRND = result.RmrateRND;
				VM.RmcostRND = result.RmcostRND;

				//
				// VM.Castwt = result.Castwt;
				VM.CastAmt = result.CastAmt;
				//VM.CutSize = result.CutSize;
				//
				VM.Conv = result.Conv;
				VM.totalRmcost = result.totalRmcost;
				VM.Totalcost = result.Totalcost;
				VM.Grand = result.Grand;


			}
			await InvokeAsync(StateHasChanged);
		}
		catch (Exception ex)
		{

			await LoggingService.LogDeveloperError(ex, "Calculation Error.");
			await _js.ToastrError("Calculation Failed.");
		}
	}

	private async Task UpsertEstimate()
	{
		try
		{
			isProcessing = true;



			// Validate each line
			foreach (var line in EstimateVM.EstimateSubVM)
			{
				// bool isValid = await ValidateQuoteLineAsync(line);
				// if (!isValid) return;
			}

			// Save
			var isNewEstimate = EstimateVM.EstiamateId == 0;

			try
			{
				await _EstimateServiecs.UpsertEstimateAsync(EstimateVM);
			}
			catch (Exception ex)
			{
				await _js.ToastrError(ex.Message);
				return;
			}

			if (isNewEstimate)
				await _js.ToastrSuccess("Estimation saved successfully.");
			else
				await _js.ToastrSuccess("Estimation updated successfully.");

			_navigationManager.NavigateTo("/estimationList");
		}
		catch (Exception ex)
		{
			await LoggingService.LogDeveloperError(ex, "UpsertEstimation failed.");
			await _js.ToastrError("Error saving Estimation.");
		}
		finally
		{
			isProcessing = false;
		}
	}

	private async Task OnItemCodeChanged(ChangeEventArgs e)
