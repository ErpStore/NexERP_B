@page "/estimation/create/{CustId:int?}"
@page "/estimation/update/{EstiamateId:int?}"

@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using MudBlazor
@using V.SMART.Shared.ViewModels.PlanningViewModel.EstimationViewModel

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IPlanningService

@inherits BaseUserRightsComponent

@inject IEstimateService _EstimateServiecs
@inject ILoggingService LoggingService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject CurrentUserService CurrentUserService
@inject IItemService itemService


@if (isProcessing)
{
	<ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
	<RedirectToLogin />
}
else
{
	<div class="container-fluid px-2 px-md-5 mt-4">
		<div class="card shadow-sm border-1">

			<PageHeader TitleText="@(EstimateVM.EstiamateId > 0 ? "Update Estimation" : "Create Estimation")"
			TitleIcon="bi bi-tag"
			Breadcrumbs="@EstimationBreadcrumbs" />

			<div class="card-body bg-light">
				<EditForm Model="EstimateVM" OnValidSubmit="UpsertEstimate" onkeydown="if (event.key === 'Enter' && event.target.tagName !== 'TEXTAREA') { event.preventDefault(); }">
					<ObjectGraphDataAnnotationsValidator />
					<ValidationSummary />

					<div class="container-fluid mt-3">

						<!-- Row 1 -->
						<div class="row g-3">

							<div class="col-lg-6">
								<!-- Manual Card -->
								<div class="card shadow-sm border-warning h-100">

									<div class="card-header bg-warning text-center fw-bold py-2">
										<div class="form-check d-flex justify-content-center align-items-center mb-0">


											<InputCheckbox class="form-check-input me-2"
											@bind-Value="EstimateVM.IsManualEstimate"
											@bind-Value:after="OnManualChanged" />
											<label class="form-check-label fw-bold">
												Manual
											</label>
										</div>
									</div>

									<div class="card-body p-2">

										<table class="table table-bordered table-sm align-middle mb-0">

											<tbody>

												<tr style="height:45px;">
													<td class="bg-light fw-semibold w-25">
														Customer Name
													</td>

													<td>
														<MudAutocomplete T="CustomerVM"
														Value="SelectedCustomer"
														ValueChanged="OnCustomerChanged"
														ToStringFunc="@(c => c?.CustName ?? string.Empty)"
														SearchFunc="SearchCustomers"
														Dense="true"
														Variant="Variant.Outlined"
														Placeholder="Search Customer"
														MaxItems="50"
														Clearable="true"
														ResetValueOnEmptyText="true"
														Required="true"
														Class="w-100"
														Disabled="@IsSomeItemsTransMade" />
													</td>
												</tr>

												<tr style="height:45px;">
													<td class="bg-light fw-semibold">
														Enquiry No
													</td>

													<td>
														@if (EstiamateId > 0)
														{
															<InputText class="form-control" maxlength="30"
															@bind-Value="EstimateVM.EnquiryNo" readonly />
														}
														else
														{
															<select class="form-select form-select-sm" @onchange="EnquiryChanged" disabled="@EstimateVM.IsManualEstimate">
																<option value="">-- Select Enquiry No --</option>

																@if (!EstimateVM.IsManualEstimate)
																{
																	@foreach (var enquiry in EnquiryList)
																	{
																		<option value="@enquiry.EnquiryId">@enquiry.EnquiryNo</option>
																		@* EnquiryId *@
																	}
																}

															</select>

														}
													</td>
												</tr>

												<tr style="height:45px;">
													<td class="bg-light fw-semibold">
														Item Code / Part No
													</td>
													@if(EstiamateId>0)
													{
														<InputText class="form-control" maxlength="30"
														@bind-Value="EstimateVM.ItemCode" readonly />
													}
													else
													{
														@if (!EstimateVM.IsManualEstimate)
														{
															<select class="form-select form-select-sm" @onchange="OnItemCodeChanged">
																<option value="">-- Select Item --</option>

																@if (ItemList != null)
																{
																	@foreach (var enquiry in ItemList)
																	{
																		<option value="@enquiry.ItemId">@enquiry.ItemCode</option>
																	}
																}
																else
																{

																}

															</select>
														}
														else
														{
															<td>
																<MudAutocomplete T="ItemVM"
																Value="SelectedItem"
																ValueChanged="OnItemChanged"
																SearchFunc="SearchItems"
																ToStringFunc="@(x => x?.ItemCode ?? string.Empty)"
																MinCharacters="2"
																MaxItems="50"
																Dense="true"
																Variant="Variant.Outlined" />
															</td>
														}
													}
												</tr>

												<tr style="height:45px;">
													<td class="bg-light fw-semibold">
														Part Name
													</td>

													<td>
														<MudTextField @bind-Value="EstimateVM.ItemName"
														Variant="Variant.Outlined"
														ReadOnly="true"
														Dense="true" />

													</td>
												</tr>

											</tbody>

										</table>

									</div>

								</div>
							</div>

							<div class="col-lg-6">
								<!-- Estimation Details Card -->
								<div class="card shadow-sm border-success h-100">

									<div class="card-header bg-success text-white text-center fw-bold py-2">
										Estimation Details
									</div>

									<div class="card-body p-2">

										<table class="table table-bordered table-sm align-middle mb-0">

											<tbody>

												<tr style="height:45px;">
													<td class="bg-light fw-semibold w-25">
														Estimate No
													</td>

													<td class="fw-bold text-primary">
														<div class="input-group input-group-sm">
															<InputText class="form-control"
															placeholder="Estimation No"
															maxlength="30"
															@bind-Value="EstimateVM.EstiamateNo"
															readonly />

															<span class="input-group-text">
																@EstimateVM.Suffix
															</span>
														</div>

														<ValidationMessage For="@(() => EstimateVM.EstiamateNo)" />

													</td>
												</tr>

												<tr style="height:45px;">
													<td class="bg-light fw-semibold">
														Date
													</td>

													<td>
														<InputDate class="form-control form-control-sm"
														@bind-Value="EstimateVM.EstimateDate" />
													</td>
												</tr>

												<tr style="height:45px;">
													<td class="bg-light fw-semibold">
														Type
													</td>

													<td>

														<InputSelect class="form-select form-select-sm"
														@bind-Value="EstimateVM.TypeofWork">
															<option>Manufacturing</option>
															<option>Labour</option>

														</InputSelect>

													</td>

												</tr>

												<tr style="height:45px;">

													<td class="bg-light fw-semibold">
														Quantity
													</td>

													<td>

														<div class="row g-2 align-items-center">
															<div class="col-4">
																<InputNumber @bind-Value="EstimateVM.Qty" class="form-control form-control-sm" ReadOnly/>

															</div>

															<div class="col-2">
																Nos
															</div>

															@* <div class="col-3 text-end">
																Enquiry Qty
															</div>

															<div class="col-3">
																<InputNumber @bind-Value="EstimateVM.Qty" class="form-control form-control-sm" />
															</div> *@
														</div>

													</td>

												</tr>

												<tr style="height:45px;">

													<td class="bg-light fw-semibold">
														Kind Attention
													</td>

													<td>
														<InputSelect class="form-select form-select-sm"
														@bind-Value="EstimateVM.ContactPerson">
															@foreach (var cp in contactPersons)
															{
																<option value="@cp.ContactPersonName">
																	@cp.ContactPersonName
																</option>
															}
														</InputSelect>
													</td>

												</tr>

											</tbody>

										</table>

									</div>

								</div>
							</div>

						</div>

						<!-- Row 2 -->
						<div class="row g-3 mt-1">

							<!-- Left Side -->
							<div class="col-lg-6">

								<div class="d-flex flex-column gap-3">

									<!-- Other Heads Card -->
									<div class="card shadow-sm border-success">

										<!-- Header -->
										<div class="card-header bg-success text-white text-center fw-bold py-2">
											Indirect Heads (Cost O)
										</div>

										<!-- Body -->
										<div class="card-body p-2">

											<table class="table table-bordered table-hover table-sm align-middle mb-0">

												<thead class="table-light text-center">

													<tr style="height:42px;">
														<th style="width:40%;">Other Heads Cost (O)</th>
														<th style="width:15%;">Percentage</th>
														<th style="width:25%;">Amount</th>
														<th style="width:20%;">Unit</th>
													</tr>

												</thead>

												<tbody>

													<tr style="height:45px;">

														<td class="fw-semibold">
															Over Head Cost
														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															@bind-Value="EstimateVM.Overp"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />


														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															@bind-Value="EstimateVM.Over"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />


														</td>

														<td class="text-center fw-semibold">
															Rs.
														</td>

													</tr>

													<tr style="height:45px;">

														<td class="fw-semibold">
															Margin / Profit
														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															min="0"			
															@bind-Value="EstimateVM.Marp"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />


														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															@bind-Value="EstimateVM.Mar"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />


														</td>

														<td class="text-center fw-semibold">
															Rs.
														</td>

													</tr>

													<tr style="height:45px;">

														<td class="fw-semibold">
															Risk Factor
														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															@bind-Value="EstimateVM.Riskp"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />


														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															@bind-Value="EstimateVM.Risk"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />

														</td>

														<td class="text-center fw-semibold">
															Rs.
														</td>

													</tr>

													<tr style="height:45px;">

														<td class="fw-semibold">
															Packaging Cost
														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															@bind-Value="EstimateVM.Packingper"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />

														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															@bind-Value="EstimateVM.Packing"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />
														</td>

														<td class="text-center fw-semibold">
															Rs.
														</td>

													</tr>

													<tr style="height:45px;">

														<td class="fw-semibold">
															Logistic Cost
														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															@bind-Value="EstimateVM.Logesticper"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />

														</td>

														<td>
															<InputNumber class="form-control form-control-sm text-end"
															style="width:110px;"
															@bind-Value="EstimateVM.Logestic"
															@bind-Value:after="async () => await Calculation(EstimateVM)" />


														</td>

														<td class="text-center fw-semibold">
															Rs.
														</td>

													</tr>

												</tbody>

												<tfoot>

													<tr class="table-success fw-bold" style="height:45px;">

														<td colspan="2" class="text-end">
															@* Total Cost (O + P) *@
														</td>

														<td class="text-end">


															@* @EstimateVM.Totalcost *@
														</td>

														<td class="text-center">
															@* Rs. *@
														</td>

													</tr>

												</tfoot>

											</table>

										</div>
									</div>




									<!-- Physical Properties -->
									<div class="card shadow-sm border-warning">

										<!-- Header -->
										<div class="card-header bg-warning text-center fw-bold py-2">
											Physical Properties (R)
										</div>

										<div class="card-body p-0">

											<!-- Shape -->
											<div class="row g-0 border-bottom">
												<div class="col-6 bg-light border-end p-2 fw-bold">
													Shape
												</div>
												<div class="col-6 p-1">
													<select class="form-select form-select-sm"
													@bind="EstimateVM.Shape" @bind:after="OnShapeChanged">
														<option value="">-- Select Shape --</option>
														<option value="Rectangle Plate">Rectangle Plate</option>
														<option value="Square Plate">Square Plate</option>
														<option value="Round Tube">Round Tube</option>
														<option value="Square Tube">Square Tube</option>
														<option value="Rectangle Tube">Rectangle Tube</option>
														<option value="U or C Channel">U or C Channel</option>
														<option value="I or H Channel">I or H Channel</option>
														<option value="L Angle">L Angle</option>
														<option value="Hexagonal Plate">Hexagonal Plate</option>
														<option value="Round">Round</option>
														<option value="Sheet">Sheet</option>
														<option value="Octagonal">Octagonal</option>
														<option value="Ring">Ring</option>
														<option value="Casting">Casting</option>
													</select>
												</div>
											</div>


											@if (!string.IsNullOrWhiteSpace(EstimateVM.Shape))
											{
												<!-- DENSITY -->
												@if (CommonShapes.Contains(EstimateVM.Shape))
												{
													<!-- Density -->
													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Density (g/cm³)
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.Density"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												@if (CommonShapes.Contains(EstimateVM.Shape))
												{
													<!-- Length -->
													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Length
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.Length"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												<!-- Width -->
												@if (new[] { "Rectangle Plate", "Square Plate", "Square Tube", "Rectangle Tube", "U or C Channel", "I or H Channel", "L Angle", "Sheet" }.Contains(EstimateVM.Shape))
												{

													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Width
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.Width"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												<!-- Thickness -->
												@if (new[] { "Rectangle Plate", "U or C Channel", "I or H Channel", "L Angle", "Sheet" }.Contains(EstimateVM.Shape))
												{

													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Thickness
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.Thickness"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												<!-- Wall Thickness -->
												@if (new[] { "Round Tube", "Square Tube", "U or C Channel", "I or H Channel", "L Angle", "Rectangle Tube" }.Contains(EstimateVM.Shape))
												{

													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Wall Thickness
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.WallThickness"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												<!-- Outer Dia -->
												@if (new[] { "Round Tube", "Hexagonal Plate", "Round", "Octagonal", "Ring" }.Contains(EstimateVM.Shape))
												{

													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Outer Dia
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.OuterDia"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												<!-- Inner Dia -->
												@if (EstimateVM.Shape == "Ring")
												{

													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Inner Dia
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.InnerDia"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												<!-- Height -->
												@if (EstimateVM.Shape == "Rectangle Tube")
												{

													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Height
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.Height"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												<!-- Weight -->
												@if (CommonShapes.Contains(EstimateVM.Shape) && EstimateVM.Shape != "Casting")
												{

													<div class="row g-0">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Weight
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.Weight"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												<!-- Rm Price -->
												@if (CommonShapes.Contains(EstimateVM.Shape) && EstimateVM.Shape != "Casting")
												{
													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Rm Price
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.RmPrice"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}


												<!-- RmTotalPrice -->
												@if (CommonShapes.Contains(EstimateVM.Shape) && EstimateVM.Shape != "Casting")
												{
													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															RmTotalPrice
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
																		 @bind-Value="EstimateVM.RmTotAmount"
																		 @bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}

												<!-- Castingweight -->
												@if (EstimateVM.Shape == "Casting")
												{
													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															Castingweight
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
																		 @bind-Value="EstimateVM.Castwt"
																		 @bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}

												@if (EstimateVM.Shape == "Casting")
												{
													<!-- CastingAmount -->
													<div class="row g-0 border-bottom">
														<div class="col-6 bg-light border-end p-2 fw-bold">
															CastingAmount
														</div>
														<div class="col-6 p-1">
															<InputNumber class="form-control form-control-sm"
															@bind-Value="EstimateVM.CastAmt"
															@bind-Value:after="async()=>await Calculation(EstimateVM)" />
														</div>
													</div>
												}
												
												
											}
										</div>

