		else
		{
			
			EstimateVM = new EstimateVM
			{
				    IsManualEstimate = IsmanualEsti,
					EstiamateNo = estimateNo,
					Suffix = suffix,
					EstimateDate = DateTime.Now,
					Qty = 1,
					TypeofWork = "Manufacturing",
					
					EstimateSubVM = new List<EstimateSubVM>()
						
			};
			if (customer == null)
			{
				EstimateVM.CustId = 0;
				EstimateVM.Custname = string.Empty;

				await  ApplyCustomerSelectionAsync(new CustomerVM());
				return;
			}

			EstimateVM.CustId = customer.CustId;
			EstimateVM.Custname = customer.CustName;

			await  ApplyCustomerSelectionAsync(customer);
			StateHasChanged();
		}
	}
