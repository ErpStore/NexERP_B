	private async Task<IEnumerable<CustomerVM>> SearchCustomers(
		string value,
		CancellationToken token)
	{
		if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
			return Enumerable.Empty<CustomerVM>();

		try
		{
			var result = await _EstimateServiecs.SearchCustomersAsync(value);

			return result.Take(50);
		}
		catch (Exception ex)
		{
			await LoggingService.LogDeveloperError(
				ex,
				"SearchCustomers");

			return Enumerable.Empty<CustomerVM>();
		}
	}
