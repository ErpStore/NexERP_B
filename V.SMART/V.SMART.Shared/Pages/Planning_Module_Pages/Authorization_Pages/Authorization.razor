@page "/approval"
@using V.SMART.Shared.Pages.Inventory_Stock__Module_Pages.Stock_Issue_Request
@using V.SMART.Shared.Pages.OutSourcing_Module_pages.MaterialRequisition_pages
@using V.SMART.Shared.Pages.OutSourcing_Module_pages.PurchOrSubConPO_Pages
@using V.SMART.Shared.Pages.OutSourcing_Module_pages.PurchaseSCN_Pages
@using V.SMART.Shared.Pages.SalesAndLabour_pages.MfgQuote_Pages
@using V.SMART.Shared.Services.ReportViewer
@inject IApprovalService _approvalService
@inject ICommonService _commonService
@inject CurrentUserService _userService
@inject ILoggingService _loggingService
@inject IJSRuntime _js

@inherits BaseUserRightsComponent

@inject ReportService reportService

@if (ShowDialog && SelectedRecord != null)
{
    <div class="modal d-block"
         style="
                     background-color: rgba(0,0,0,0.3);
                     backdrop-filter: blur(5px);
                     -webkit-backdrop-filter: blur(5px);
                     z-index:1050;
                   ">
        <div class="modal-dialog modal-dialog-scrollable"
             style="max-width:700px; width:95%; margin:0 auto; top:70px; position:relative;">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title fw-bold">Approval Details</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body" style="max-height: calc(90vh - 100px); overflow-y:auto;">

                    @if (SelectedType == "Leave")
                    {
                        <LeaveDetails leaveAppId="@SelectedRecord.ID" isOtherScreen="true" />
                    }
                    else if (SelectedType == "Purchase Requisition")
                    {
                        <MaterialReqDetails MReqId="@SelectedRecord.ID" isOtherScreen="true" />
                    }
                    else if (SelectedType == "PO")
                    {
                        <PurchasePoDetails poid="@SelectedRecord.ID" isOtherScreen="true" />
                    }
                    else if (SelectedType == "PurchaseSCN")
                    {
                        <PurchaseSCNDetails SCNId="@SelectedRecord.ID" isOtherScreen="true" />
                    }
                    else if (SelectedType == "Sales Po")
                    {
                        <MfgPODetails PoId="@SelectedRecord.ID" isOtherScreen="true" />
                    }
                    else if (SelectedType == "Sales Quotation")
                    {
                        <MfgQuoteDetails QuoteId="@SelectedRecord.ID" isOtherScreen="true" />
                    }
                     else if (SelectedType == "Stock Issue Request")
                     {
                         <StockIssueRequestDetails ReqID="@SelectedRecord.ID" isOtherScreen="true" />
                     }

                    @if (IsRejecting)
                    {
                        <div class="mt-3">
                            <label class="form-label">Reason for Rejection:</label>
                            <textarea class="form-control" @bind="RejectReason" rows="3"></textarea>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light flex-wrap">
                    @if (!IsRejecting)
                    {
                        <button class="btn btn-success px-4 me-2 mb-2" @onclick="ApproveRecordAsync">
                            <i class="bi bi-check-circle"></i> Approve
                        </button>

                        <button class="btn btn-danger px-4 mb-2" @onclick="() => IsRejecting = true">
                            <i class="bi bi-x-circle"></i> Reject
                        </button>

                        @if (SelectedType == "PO")
                        {
                            <button class="btn btn-success px-4 me-2 mb-2" @onclick="GenerateAndOpenPdf">
                                <i class="bi bi-check-circle"></i> Print Preview
                            </button>
                        }
                    }
                    else
                    {
                        <button class="btn btn-secondary px-4 me-2 mb-2" @onclick="() => IsRejecting = false">Cancel</button>
                        <button class="btn btn-danger px-4 mb-2" @onclick="RejectRecordAsync">Confirm Reject</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (ShowBulkRejectModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.3); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); z-index:1050;">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content rounded-3 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Reject Selected Records</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowBulkRejectModal = false"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Reason for Rejection:</label>
                    <textarea class="form-control" @bind="RejectReason"></textarea>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary px-4" @onclick="() => ShowBulkRejectModal = false">Cancel</button>
                    <button class="btn btn-danger px-4" @onclick="RejectSelectedAsync">Confirm Reject</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="app-wrapper @(ShowDialog || ShowBulkRejectModal ? "blur-background" : "")">
        <div class="container-fluid px-2 px-md-5 mt-4">

            <div class="card shadow-sm border-0">

                <PageHeader TitleText="Common Approval Screen"
                            TitleIcon="bi bi-tag"
                            Breadcrumbs="@ApprovalScreen" />

                <div class="card-body">

                    <!-- Filter -->
                    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                        <label class="form-label mb-0">Select Approval Type:</label>
                        <select @bind="SelectedType" class="form-select w-auto">
                            @foreach (var type in AvailableApprovalTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                        <button class="btn btn-primary ms-2" @onclick="OnViewClick">
                            <i class="bi bi-eye"></i> View Pending
                        </button>
                    </div>

                    @if (PendingData != null && PendingData.Any())
                    {
                        <!-- Desktop Table -->
                        <div class="table-responsive d-none d-md-block mt-3" style="max-height: 500px; overflow:auto;">
                            <table class="table table-bordered table-hover align-middle text-center">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th><input type="checkbox" @onchange="ToggleSelectAll" /></th>
                                        <th>Sl</th>
                                        <th>View</th>

                                        @if (SelectedType == "Purchase Requisition")
                                        {
                                            <th>PR No</th>
                                            <th>PR Date</th>
                                            <th>No of Items</th>
                                            <th>Department</th>
                                            <th>Created By</th>
                                        }
                                        else if (SelectedType == "PO")
                                        {
                                            <th>PO No</th>
                                            <th>PO Date</th>
                                            <th>Supplier</th>
                                            <th>Total Amount</th>
                                            <th>Requested By</th>
                                        }
                                        else if (SelectedType == "RouteCard")
                                        {
                                            <th>RC No</th>
                                            <th>Date</th>
                                            <th>Item</th>
                                            <th>Qty</th>
                                            <th>Requested By</th>
                                        }
                                        else if (SelectedType == "Leave")
                                        {
                                            <th>Name</th>
                                            <th>Department</th>
                                            <th>Reason</th>
                                            <th>From</th>
                                            <th>To</th>
                                        }
                                        else if (SelectedType == "PurchaseSCN")
                                        {
                                            <th>SCN No</th>
                                            <th>SCN Date</th>
                                            <th>Supplier</th>
                                            <th>Total Amount</th>
                                            <th>Requested By</th>
                                        }

                                        else if (SelectedType == "Sales Po")
                                        {
                                            <th>PO No</th>
                                            <th>PO Date</th>
                                            <th>Customer</th>
                                            <th>No Of items</th>
                                            <th>Requested By</th>
                                        }
                                        else if (SelectedType == "Sales Quotation")
                                        {
                                            <th>Quotation No</th>
                                            <th>Quotation Date</th>
                                            <th>Customer</th>
                                            <th>No Of items</th>
                                            <th>Requested By</th>
                                        }
                                        else if (SelectedType == "Stock Issue Request")
                                        {
                                            <th>Stock Issue Req No</th>
                                            <th>Request Date</th>
                                            <th>whom</th>
                                            <th>No Of items</th>
                                            <th>Requested By</th>
                                        }

                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @for (int i = 0; i < PendingData.Count; i++)
                                    {
                                        var item = PendingData[i];
                                        <tr>
                                            <td><input type="checkbox" @bind="item.IsSelected" /></td>
                                            <td>@(i + 1)</td>
                                            <td>
                                                <button class="btn btn-info btn-sm" @onclick="() => OnViewDetailsClick(item)">
                                                    <i class="bi bi-eye-fill"></i>
                                                </button>
                                            </td>

                                            @if (SelectedType == "Purchase Requisition")
                                            {
                                                <td>@item.DocNo</td>
                                                <td>@item.DocDate?.ToString("dd/MM/yyyy")</td>
                                                <td>@item.NoOfItems</td>
                                                <td>@item.Department</td>
                                                <td>@item.RequestedBy</td>
                                            }
                                            else if (SelectedType == "PO")
                                            {
                                                <td>@item.DocNo</td>
                                                <td>@item.DocDate?.ToString("dd/MM/yyyy")</td>
                                                <td>@item.Supplier</td>
                                                <td>@item.Amount</td>
                                                <td>@item.RequestedBy</td>
                                            }
                                            else if (SelectedType == "RouteCard")
                                            {
                                                <td>@item.DocNo</td>
                                                <td>@item.DocDate?.ToString("dd/MM/yyyy")</td>
                                                <td>@item.ItemName</td>
                                                <td>@item.Qty</td>
                                                <td>@item.RequestedBy</td>
                                            }
                                            else if (SelectedType == "Leave")
                                            {
                                                <td>@item.Name</td>
                                                <td>@item.Department</td>
                                                <td>@item.Reason</td>
                                                <td>@item.FromDate?.ToString("dd/MM/yyyy")</td>
                                                <td>@item.ToDate?.ToString("dd/MM/yyyy")</td>
                                            }
                                            else if (SelectedType == "PurchaseSCN")
                                            {
                                                <td>@item.DocNo</td>
                                                <td>@item.DocDate?.ToString("dd/MM/yyyy")</td>
                                                <td>@item.Supplier</td>
                                                <td>@item.Amount</td>
                                                <td>@item.RequestedBy</td>
                                            }
                                            else if (SelectedType == "Sales Po")
                                            {
                                                <td>@item.DocNo</td>
                                                <td>@item.DocDate?.ToString("dd/MM/yyyy")</td>
                                                <td>@item.Supplier</td>
                                                <td>@item.NoOfItems</td>
                                                <td>@item.RequestedBy</td>
                                            }

                                            else if (SelectedType == "Sales Quotation")
                                            {
                                                <td>@item.DocNo</td>
                                                <td>@item.DocDate?.ToString("dd/MM/yyyy")</td>
                                                <td>@item.Supplier</td>
                                                <td>@item.NoOfItems</td>
                                                <td>@item.RequestedBy</td>
                                            }
                                            else if (SelectedType == "Stock Issue Request")
                                            {
                                                <td>@item.DocNo</td>
                                                <td>@item.DocDate?.ToString("dd/MM/yyyy")</td>
                                                <td>@item.Supplier</td>
                                                <td>@item.NoOfItems</td>
                                                <td>@item.RequestedBy</td>
                                            }

                                            <td><span class="badge bg-warning text-dark">Pending</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Bulk Buttons -->
                        @if (PendingData.Any(p => p.IsSelected))
                        {
                            <div class="mt-3 d-flex flex-wrap gap-2">
                                <button class="btn btn-success" @onclick="ApproveSelected">
                                    <i class="bi bi-check2-circle"></i> Approve Selected
                                </button>

                                <button class="btn btn-danger" @onclick="() => ShowBulkRejectModal = true">
                                    <i class="bi bi-x-circle"></i> Reject Selected
                                </button>
                            </div>
                        }

                        <div class="d-md-none mt-3">
                            @foreach (var item in PendingData)
                            {
                                <div class="card mb-3 shadow-sm">
                                    <div class="card-body">

                                        <div class="d-flex mb-2 align-items-center">
                                            <input type="checkbox" @bind="item.IsSelected" class="form-check-input me-2" />
                                            <h6 class="fw-bold mb-0">@item.DocNo</h6>
                                        </div>

                                        @if (SelectedType == "Purchase Requisition")
                                        {
                                            <p><b>PR Date:</b> @item.DocDate?.ToString("dd/MM/yyyy")</p>
                                            <p><b>No of Items:</b> @item.NoOfItems</p>
                                            <p><b>Department:</b> @item.Department</p>
                                            <p><b>Created By:</b> @item.RequestedBy</p>
                                        }
                                        else if (SelectedType == "PO")
                                        {
                                            <p><b>PO Date:</b> @item.DocDate?.ToString("dd/MM/yyyy")</p>
                                            <p><b>Supplier:</b> @item.Supplier</p>
                                            <p><b>Amount:</b> @item.Amount</p>
                                            <p><b>Requested By:</b> @item.RequestedBy</p>
                                        }
                                        else if (SelectedType == "RouteCard")
                                        {
                                            <p><b>Date:</b> @item.DocDate?.ToString("dd/MM/yyyy")</p>
                                            <p><b>Item:</b> @item.ItemName</p>
                                            <p><b>Qty:</b> @item.Qty</p>
                                            <p><b>Requested By:</b> @item.RequestedBy</p>
                                        }
                                        else if (SelectedType == "Leave")
                                        {
                                            <p><b>Name:</b> @item.Name</p>
                                            <p><b>Department:</b> @item.Department</p>
                                            <p><b>Reason:</b> @item.Reason</p>
                                            <p><b>From:</b> @item.FromDate?.ToString("dd/MM/yyyy") → <b>To:</b> @item.ToDate?.ToString("dd/MM/yyyy")</p>
                                        }
                                        else if (SelectedType == "PurchaseSCN")
                                        {
                                            <p><b>SCN Date:</b> @item.DocDate?.ToString("dd/MM/yyyy")</p>
                                            <p><b>Vendor:</b> @item.Supplier</p>
                                            <p><b>Amount:</b> @item.Amount</p>
                                            <p><b>Requested By:</b> @item.RequestedBy</p>
                                        }
                                        else if (SelectedType == "Sales Po")
                                        {
                                            <p><b>PO Date:</b> @item.DocDate?.ToString("dd/MM/yyyy")</p>
                                            <p><b>Supplier:</b> @item.Supplier</p>
                                            <p><b>No of items:</b> @item.NoOfItems</p>
                                            <p><b>Requested By:</b> @item.RequestedBy</p>
                                        }
                                        else if (SelectedType == "Sales Quotation")
                                        {
                                            <p><b>PO Date:</b> @item.DocDate?.ToString("dd/MM/yyyy")</p>
                                            <p><b>Supplier:</b> @item.Supplier</p>
                                            <p><b>No of items::</b> @item.NoOfItems</p>
                                            <p><b>Requested By:</b> @item.RequestedBy</p>
                                        }
                                        else if (SelectedType == "Stock Issue Request")
                                        {
                                            <p><b>PO Date:</b> @item.DocDate?.ToString("dd/MM/yyyy")</p>
                                            <p><b>Supplier:</b> @item.Supplier</p>
                                            <p><b>No of items::</b> @item.NoOfItems</p>
                                            <p><b>Requested By:</b> @item.RequestedBy</p>
                                        }
                                        <span class="badge bg-warning text-dark mb-2">Pending</span>
                                        <button class="btn btn-info btn-sm w-100" @onclick="() => OnViewDetailsClick(item)">
                                            View Details
                                        </button>

                                    </div>
                                </div>
                            }
                        </div>

                    }
                    else
                    {
                        <div class="alert alert-info mt-4">No pending records found.</div>
                    }

                </div>
            </div>
        </div>
    </div>

}



@code {
    protected override string ScreenName => "Authorization";

    private bool isProcessing = true;
    private bool ShowDialog { get; set; }
    private bool ShowBulkRejectModal { get; set; }
    private bool IsRejecting { get; set; }
    private string RejectReason { get; set; }
    private bool SelectAll { get; set; }

    private ApprovalVM SelectedRecord { get; set; }
    private List<string> AvailableApprovalTypes = new();
    private string SelectedType { get; set; } = string.Empty;
    private List<ApprovalVM> PendingData;
    private UserAuthority UserAuthority;
    private string currentuser;

    
    private string? pdfBase64;

    private List<PageHeader.BreadcrumbItem> ApprovalScreen = new()
    {
        new() { Text = "Planning" },
        new() { Text = "Authorization", IsLast = true }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                isProcessing = false;
                return;
            }

            currentuser = await _userService.GetUsernameAsync();
            UserAuthority = await _commonService.GetUserAuthorityAsync(currentuser);

            if (UserAuthority != null)
            {
                if (UserAuthority.IsLeave) AvailableApprovalTypes.Add("Leave");
                if (UserAuthority.IsPO) AvailableApprovalTypes.Add("PO");
                if (UserAuthority.IsPR) AvailableApprovalTypes.Add("Purchase Requisition");
                if (UserAuthority.IsRc) AvailableApprovalTypes.Add("RouteCard");
                if (UserAuthority.IsPurchSCN) AvailableApprovalTypes.Add("PurchaseSCN");
                if (UserAuthority.IsSalesPo) AvailableApprovalTypes.Add("Sales Po");
                if (UserAuthority.IsMfgQuote) AvailableApprovalTypes.Add("Sales Quotation");
                if (UserAuthority.IsStockReq) AvailableApprovalTypes.Add("Stock Issue Request");
            }
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(ex, "Error in OnInitializedAsync");
            await _js.ToastrError("Error loading approval screen.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnViewClick()
    {

        if (SelectedType == null)
        {
            await _js.ToastrWarning("Approval Type Selection is Required!..");
            return;
        }

        isProcessing = true;
        PendingData = null;
        try
        {
            var level = GetUserApprovalLevel(SelectedType);
            if (string.IsNullOrWhiteSpace(level))
            {
                await _js.ToastrWarning("No approval level assigned for this type!");
                return;
            }

            PendingData = await _approvalService.GetPendingApprovalsAsync(SelectedType, level, currentuser);

            if (PendingData == null || !PendingData.Any())
            {
                PendingData = new List<ApprovalVM>();
                await _js.ToastrWarning("No pending records found for approval.");
            }

        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(ex, $"Error fetching pending approvals for type: {SelectedType}");
            await _js.ToastrError("Failed to fetch pending approvals.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetUserApprovalLevel(string type) => type switch
    {
        "Leave" => UserAuthority?.IsLeaveLevel,
        "PO" => UserAuthority?.IsPOLevel,
        "Purchase Requisition" => UserAuthority?.IsPRLevel,
        "RouteCard" => UserAuthority?.IsRcLevel,
        "PurchaseSCN" => UserAuthority?.IsPurchSCNLevel,
        "Sales Po" => UserAuthority?.IsSalesPoLevel,
        "Sales Quotation" => UserAuthority?.IsMfgQuoteLevel,
        "Stock Issue Request" => UserAuthority?.IsStockReqLevel,

        _ => null
    };

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        SelectAll = (bool)e.Value;
        if (PendingData != null)
        {
            foreach (var item in PendingData)
                item.IsSelected = SelectAll;
        }
    }

    private void OnViewDetailsClick(ApprovalVM record)
    {
        SelectedRecord = record;
        ShowDialog = true;
        IsRejecting = false;
        RejectReason = string.Empty;
    }

    private void CloseModal()
    {
        ShowDialog = false;
        SelectedRecord = null;
    }

    private async Task ApproveRecordAsync()
    {
        isProcessing = true;
        try
        {
            var level = GetUserApprovalLevel(SelectedType);
            var ok = await _approvalService.ApproveAsync(SelectedRecord, SelectedType, level, currentuser, UserAuthority);
            if (ok)
            {
                await _js.ToastrSuccess("Record approved successfully.");
            }
            else
            {
                await _js.ToastrError("Failed to approve the record.");
            }
            CloseModal();
            await OnViewClick();
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(ex, "Error approving record");
            await _js.ToastrError("Failed to approve the record.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RejectRecordAsync()
    {
        if (string.IsNullOrWhiteSpace(RejectReason))
        {
            await _js.ToastrWarning("Please enter a rejection reason.");
            return;
        }
        isProcessing = true;
        try
        {
            var level = GetUserApprovalLevel(SelectedType);
            var ok = await _approvalService.RejectAsync(SelectedRecord, SelectedType, level, RejectReason, currentuser);
            if (ok)
            {
                await _js.ToastrSuccess("Record rejected successfully.");
            }
            else
            {
                await _js.ToastrError("Failed to reject the record.");
            }
            CloseModal();
            await OnViewClick();
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(ex, "Error rejecting record");
            await _js.ToastrError("Failed to reject the record.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ApproveSelected()
    {
        var selected = PendingData?.Where(p => p.IsSelected).ToList() ?? new List<ApprovalVM>();
        if (!selected.Any())
        {
            await _js.ToastrWarning("No records selected.");
            return;
        }
        isProcessing = true;
        try
        {
            var level = GetUserApprovalLevel(SelectedType);
            var success = await _approvalService.BulkApproveAsync(selected, SelectedType, level, currentuser);
            if (success)
            {
                await _js.ToastrSuccess("Selected records approved successfully!");
            }
            else
            {
                await _js.ToastrError("Error approving selected records.");
            }
            await OnViewClick();
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(ex, "Error in bulk approve");
            await _js.ToastrError("Unexpected error occurred while approving.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RejectSelectedAsync()
    {
        var selected = PendingData?.Where(p => p.IsSelected).ToList() ?? new List<ApprovalVM>();
        if (!selected.Any())
        {
            await _js.ToastrWarning("No records selected.");
            return;
        }

        if (string.IsNullOrWhiteSpace(RejectReason))
        {
            await _js.ToastrWarning("Please enter a rejection reason.");
            return;
        }
        isProcessing = true;
        try
        {
            var level = GetUserApprovalLevel(SelectedType);
            var success = await _approvalService.BulkRejectAsync(selected, SelectedType, level, RejectReason, currentuser);
            if (success)
            {
                await _js.ToastrSuccess("Selected records rejected successfully!");
            }
            else
            {
                await _js.ToastrError("Error rejecting selected records.");
            }
            ShowBulkRejectModal = false;
            RejectReason = string.Empty;
            await OnViewClick(); // Refresh the list
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(ex, "Error in bulk reject");
            await _js.ToastrError("Unexpected error occurred while rejecting.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(SelectedRecord.ID, "PurchaseOrder.frx", "PoId", false, "Purchase Order", "Sp_Print_PurchasePo");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await _loggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Purchase Order");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Purchase Order.");
        }
        finally
        {
            isProcessing = false;
        }
    }
}