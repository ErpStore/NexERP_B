@page "/routeCardList"
@using V.SMART.Shared.ViewModels.PlanningViewModel.RouteCardViewModel


@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@inject IRouteCardService rcService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Route Card List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@rcBreadcrumbs" />

            <div class="card-body p-4">

                 <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                 value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Work-In-Progress">Work-In-Progress</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>


                    @if (CanCreate)
                    {
                       <div class="col-12 col-md-2 ms-md-auto text-end">
                            <a href="routeCard/create"
                               class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                               title="Create New">
                                <i class="bi-box-seam"></i> Add New
                            </a>
                       </div>
                    }

                </div>

                @if (RouteCardVMs.Any())
                {
                    <div class="table-responsive">

                    <QuickGrid Items="RouteCardVMs.AsQueryable()"
                               Class="quickgrid table table-bordered text-wrap">

                        @foreach (var col in Columns.Where(c => c.IsVisible))
                        {
                            <div>
                                @switch (col.Field)
                                {
                                    case "RCId":
                                        <PropertyColumn Title="RC ID" Property="@(c => c.RCId)" />
                                        break;

                                    case "RCNo":
                                        <PropertyColumn Title="RC No" Property="@(c => $"{c.RCNo}{c.Suffix}")" Sortable="true" />
                                        break;

                                    case "RCDate":
                                        <PropertyColumn Title="RC Date" Property="@(c => c.RCDate)" Format="dd/MM/yyyy" Sortable="true" />
                                        break;

                                    case "MfgOrLab":
                                        <TemplateColumn Title="Type" Context="c">
                                            @if (c.MfgOrLab)
                                            {
                                                <span class="badge text-bg-primary px-3 py-1 rounded-pill">Manufacturing</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-info px-3 py-1 rounded-pill">Labour</span>
                                            }
                                        </TemplateColumn>
                                        break;

                                    case "IsManual":
                                        <TemplateColumn Title="Entry Mode" Context="c">
                                            @if (c.IsManual)
                                            {
                                                <span class="badge text-bg-warning px-3 py-1 rounded-pill">Manual</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-success px-3 py-1 rounded-pill">Auto</span>
                                            }
                                        </TemplateColumn>
                                        break;

                                    case "CustName":
                                        <PropertyColumn Title="Customer" Property="@(c => c.CustName)" />
                                        break;

                                    case "RefPoNo":
                                        <PropertyColumn Title="Ref PO No" Property="@(c => c.RefPoNo)" />
                                        break;

                                    case "RefPoDate":
                                        <PropertyColumn Title="Ref PO Date" Property="@(c => c.RefPoDate)" Format="dd/MM/yyyy" />
                                        break;

                                    case "SelectedItemType":
                                        <PropertyColumn Title="Item Type" Property="@(c => c.SelectedItemType)" />
                                        break;

                                    case "CompItemId":
                                        <PropertyColumn Title="Component ID" Property="@(c => c.CompItemId)" />
                                        break;

                                    case "CompItemCode":
                                        <PropertyColumn Title="Component" Property="@(c => c.CompItemCode)" />
                                        break;

                                    case "AssyId":
                                        <PropertyColumn Title="Assembly ID" Property="@(c => c.AssyId)" />
                                        break;

                                    case "AssyCode":
                                        <PropertyColumn Title="Assembly" Property="@(c => c.AssyCode)" />
                                        break;

                                    case "SubAssyCode":
                                        <PropertyColumn Title="Sub Assembly 1" Property="@(c => c.SubAssyCode)" />
                                        break;

                                    case "SubAssyCode2":
                                        <PropertyColumn Title="Sub Assembly 2" Property="@(c => c.SubAssyCode2)" />
                                        break;

                                    case "SubAssyCode3":
                                        <PropertyColumn Title="Sub Assembly 3" Property="@(c => c.SubAssyCode3)" />
                                        break;

                                    case "RMId":
                                        <PropertyColumn Title="RM ID" Property="@(c => c.RMId)" />
                                        break;

                                    case "RMCode":
                                        <PropertyColumn Title="RM Item" Property="@(c => c.RMCode)" />
                                        break;

                                    case "RMReqQty":
                                        <PropertyColumn Title="RM Req Qty" Property="@(c => c.RMReqQty)" />
                                        break;

                                    case "RMStockQty":
                                        <PropertyColumn Title="RM Stock Qty" Property="@(c => c.RMStockQty)" />
                                        break;

                                    case "RMWeight":
                                        <PropertyColumn Title="RM Weight" Property="@(c => c.RMWeight)" />
                                        break;

                                    case "RMBatchNo":
                                        <PropertyColumn Title="Batch No" Property="@(c => c.RMBatchNo)" />
                                        break;

                                    case "MainRemarks":
                                        <PropertyColumn Title="Remarks" Property="@(c => c.MainRemarks)" />
                                        break;

                                    case "RcType":
                                        <TemplateColumn Title="RC Type" Context="c">
                                            @if (c.RcType == 1)
                                            {
                                                <span class="badge text-bg-primary px-3 py-1">Auto</span>
                                            }
                                            else if (c.RcType == 2)
                                            {
                                                <span class="badge text-bg-warning px-3 py-1">Manual</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary px-3 py-1">Unknown</span>
                                            }
                                        </TemplateColumn>
                                        break;

                                    case "RcStatus":
                                        <TemplateColumn Title="Status" Context="c">
                                            @switch (c.RcStatus)
                                            {
                                                case 0:
                                                    <span class="badge text-bg-info px-3 py-1">Pending</span>
                                                    break;
                                                case 1:
                                                    <span class="badge text-bg-primary px-3 py-1">In Progress</span>
                                                    break;
                                                case 2:
                                                    <span class="badge text-bg-success px-3 py-1">Completed</span>
                                                    break;
                                                case 3:
                                                    <span class="badge text-bg-danger px-3 py-1">Cancelled</span>
                                                    break;
                                            }
                                        </TemplateColumn>
                                        break;

                                    case "CostId":
                                        <PropertyColumn Title="Cost Id" Property="@(c => c.CostId)" />
                                        break;

                                    case "ProjectNo":
                                        <PropertyColumn Title="Project No" Property="@(c => c.ProjectNo)" />
                                        break;

                                    case "CreatedBy":
                                        <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                        break;

                                    case "CreatedDate":
                                        <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                        break;

                                    case "ModifiedBy":
                                        <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                        break;

                                    case "ModifiedDate":
                                        <PropertyColumn Title="Modified Date" Property="@(c => c.ModifiedDate)" Format="dd/MM/yyyy" />
                                        break;
                                }
                            </div>
                        }


                        <TemplateColumn Title="Actions" Context="c">
                            <div class="d-flex gap-2">
                                @if (CanEdit)
                                {
                                    <a href="@($"routeCard/update/{c.RCId}")" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                }
                                @if (CanView)
                                {
                                    <a href="@($"routeCard/details/{c.RCId}")" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                }
                                @if (CanDelete)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleDelete(c.RCId)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                }
                            </div>
                        </TemplateColumn>

                    </QuickGrid>

                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}

@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Route Card";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteRCId = 0;
    private string selectedStatus = "";

    private List<RouteCardVM> RouteCardVMs = new();

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> rcBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Planning" },
        new PageHeader.BreadcrumbItem { Text = "Route Card", IsLast = true }
    };

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();

            //InstantSearch
            //Important : Deserialize Filter parameter from query string if exists
            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllRouteCards();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion


    #region === Data Loading ===

    private async Task LoadAllRouteCards()
    {
        try
        {
            var result = await rcService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            RouteCardVMs = result.routeCardVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading RouteCardList");
            await _JS.ToastrError("Failed to load routeCard List.");
        }
    }

    #endregion


    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "RC ID", Field = "RCId", IsVisible = false },

                new() { Title = "RC No", Field = "RCNo", IsVisible = true },
                new() { Title = "Suffix", Field = "Suffix", IsVisible = false },

                new() { Title = "RC Date", Field = "RCDate", IsVisible = true },
                new() { Title = "Current Date", Field = "RCDateNow", IsVisible = false },

                // Qty
                new() { Title = "RC Qty", Field = "RcQty", IsVisible = true },

                // Customer
                new() { Title = "Customer ID", Field = "CustId", IsVisible = false },
                new() { Title = "Customer Name", Field = "CustName", IsVisible = true },

                // PO Reference
                new() { Title = "Ref PO ID", Field = "RefPoId", IsVisible = false },
                new() { Title = "Ref PO No", Field = "RefPoNo", IsVisible = true },
                new() { Title = "Ref PO Date", Field = "RefPoDate", IsVisible = true },

                // Item Types
                new() { Title = "Item Type", Field = "SelectedItemType", IsVisible = true },

                // Component
                new() { Title = "Component ID", Field = "CompItemId", IsVisible = false },
                new() { Title = "Component Code", Field = "CompItemCode", IsVisible = true },

                // Assembly
                new() { Title = "Assembly ID", Field = "AssyId", IsVisible = false },
                new() { Title = "Assembly Code", Field = "AssyCode", IsVisible = true },

                // Sub-Assemblies
                new() { Title = "Sub Assembly 1", Field = "SubAssyCode", IsVisible = false },
                new() { Title = "Sub Assembly 2", Field = "SubAssyCode2", IsVisible = false },
                new() { Title = "Sub Assembly 3", Field = "SubAssyCode3", IsVisible = false },

                // Raw Material
                new() { Title = "Raw Material ID", Field = "RMId", IsVisible = false },
                new() { Title = "Raw Material Code", Field = "RMCode", IsVisible = true },

                new() { Title = "RM Req Qty", Field = "RMReqQty", IsVisible = true },
                new() { Title = "RM Stock Qty", Field = "RMStockQty", IsVisible = false },
                new() { Title = "RM Weight", Field = "RMWeight", IsVisible = false },
                new() { Title = "RM Batch No", Field = "RMBatchNo", IsVisible = false },

                // Remarks
                new() { Title = "Remarks", Field = "MainRemarks", IsVisible = true },

                // Status
                new() { Title = "RC Type", Field = "RcType", IsVisible = true },
                new() { Title = "RC Status", Field = "RcStatus", IsVisible = true },

                // Cost / Project
                new() { Title = "Cost ID", Field = "CostId", IsVisible = false },
                new() { Title = "Project No", Field = "ProjectNo", IsVisible = false },

                // Media
                new() { Title = "Barcode", Field = "BarCodeBase64", IsVisible = false },
                new() { Title = "QR Code", Field = "QrCodeBase64", IsVisible = false },

                // Audit
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = false },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = false },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };

            if (!Hidden)
            {
                // Add any additional dynamic columns here later
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }


    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for RouteCardList");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ItemList HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllRouteCards();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in RouteCardList");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllRouteCards();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in RouteCardList");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllRouteCards();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in RouteCardList");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllRouteCards();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in RouteCardList");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllRouteCards();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in RouteCardList");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllRouteCards();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing RouteCardList page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int rcId)
    {
        try
        {
            var (canDelete, message) = await rcService.CanDeleteRoutecardAsync(rcId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteRCId = rcId;

            ModalTitle = "Are you sure you want to delete this Route Card.";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for RcId: {rcId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            bool deleted = await rcService.DeleteRouteCardByRCIdAsync(DeleteRCId);
            if (deleted)
            {
                await _JS.ToastrSuccess("Route Card deleted successfully.");
                await LoadAllRouteCards();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Route Card could not be deleted. It may not exist or have dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting RCId: {DeleteRCId}");
            await _JS.ToastrError("Failed to delete Route Card.");
        }
        finally
        {
            DeleteRCId = 0;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllRouteCards();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in RouteCardList");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion


    #region Job order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

           if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;


            currentPage = 1;
            await LoadAllRouteCards();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in RouteCardList");
            await _JS.ToastrError("Failed to Load Route Card List filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion 

}
