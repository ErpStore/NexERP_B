    #region RouteCar Release Cancel

    private async Task Cancel()
    {
        try
        {
            if (!RcReleaseId.HasValue || RcReleaseId == 0)
            {
                await _JS.ToastrError("RouteCard Release cancel is not allowed before saving the RouteCard Release.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Route Card Release");
                return;
            }

            if (RcReleaseVMs.ShortClose)
            {
                await _JS.ToastrError("Route Card Release is already short closed. You can't cancel it.");
                return;
            }

            if (RcReleaseVMs.IsCancel && RcReleaseVMs.PoSubId.HasValue)
            {
                var poSubId = RcReleaseVMs.PoSubId.Value;

                var poRcBalQty = await rcReleaseService.GetPendingRcBalQtyByPoSubIdAsync(poSubId);

                if (RcReleaseVMs.ReleaseQty > poRcBalQty)
                {
                    await _JS.ToastrError(
                        $"Released Qty ({RcReleaseVMs.ReleaseQty}) cannot be greater than PO RouteCard Balance Qty ({poRcBalQty}). Revert not allowed."
                    );
                    return;
                }
            }

            if (!RcReleaseVMs.IsCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Route Card Release?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Route Card Release?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            RcReleaseVMs = await rcReleaseService.GetRcReleaseByRcIdAsync(RcReleaseVMs.RouteCardReleaseId);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Route card Release.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Route card Release Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task AskToShortCloseAsync(RouteCardReleaseVM RcreleaseVM)
    {
        try
        {
            if (RcreleaseVM == null)
            {
                await _JS.ToastrError("Invalid Route Card Release selected.");
                return;
            }

            if (!RcReleaseId.HasValue || RcReleaseId == 0)
            {
                await _JS.ToastrError("Route Card Release Short Closed is not allowed before saving the Route Card Release.");
                return;
            }

            if (RcreleaseVM.RcReleaseTally)
            {
                await _JS.ToastrWarning("This Route Card Relase is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (RcreleaseVM.IsCancel)
            {
                await _JS.ToastrWarning("This Route Card Release is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!RcreleaseVM.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Route Card Release?";
                btnText = "Short Closed";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Route Card Release?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while AskToShortCloseAsync Route Card Release.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }



    #region Model Handlers

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "Cancel":
                case "Revert":
                    await CancelRcRelease();
                    break;

                case "ShortClose":
                    await ShortCloseRcRelease();
                    break;

                default:
                    await _JS.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }


    #endregion


    private async Task CancelRcRelease()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!RcReleaseVMs.IsCancel)
            {
                RcReleaseVMs.IsCancel = true;
                RcReleaseVMs.CancelDate = DateTime.Now;
                RcReleaseVMs.CancelReason = cancelReason;
                RcReleaseVMs.CancelBy = username;

                await rcReleaseService.UpdatedCancelStatusAndAddOrRevertQty(RcReleaseVMs);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Route Card Release",
                    action: $"Cancelled RouteCard Release: {RcReleaseVMs.RcReleaseNo}",
                    additionalInfo: $"RouteCardreleaseId: {RcReleaseVMs.RouteCardReleaseId}"
                );

                await _JS.ToastrSuccess("RouteCard Release cancelled successfully.");
            }
            else
            {
                RcReleaseVMs.IsCancel = false;
                RcReleaseVMs.CancelDate = null;
                RcReleaseVMs.CancelReason = string.Empty;
                RcReleaseVMs.CancelBy = string.Empty;

                await rcReleaseService.UpdatedCancelStatusAndAddOrRevertQty(RcReleaseVMs);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Route Card Release",
                    action: $"Reverted Route card Release: {RcReleaseVMs.RcReleaseNo}",
                    additionalInfo: $"RouteCardRelease Id: {RcReleaseVMs.RouteCardReleaseId}"
                );

                await _JS.ToastrSuccess("RouteCard Release has been reverted successfully.");
            }
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            RcReleaseVMs = await rcReleaseService.GetRcReleaseByRcIdAsync(RcReleaseVMs.RouteCardReleaseId);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"CancelRcRelease failed for RouteCardReleaseId: {RcReleaseVMs.RouteCardReleaseId}");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the Route Card Relase.");
            await LoggingService.LogDeveloperError(ex, $"CancelRcRelease failed for RouteCard relase Id: {RcReleaseVMs.RouteCardReleaseId}");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task ShortCloseRcRelease()
    {
        if (RcReleaseVMs == null)
        {
            await _JS.ToastrError("No Route Card Release selected.");
            return;
        }
        try
        {
            isProcessing = true;
            RcReleaseVMs.ShortClose = !RcReleaseVMs.ShortClose;
            await rcReleaseService.UpsertRcReleaseShortCloseAsync(RcReleaseVMs);
            StateHasChanged();

            string msg = RcReleaseVMs.ShortClose
                 ? "Route Card Release ShortClose Successfully!"
                 : "Route card release ReOpen Successfully!";
            await _JS.ToastrSuccess(msg);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while updating ShortClose.Route Card Release");
            await LoggingService.LogDeveloperError(ex, "Error in ShortClose() Route Card Release");
        }
        finally
        {
            isProcessing = false;
        }
    }



