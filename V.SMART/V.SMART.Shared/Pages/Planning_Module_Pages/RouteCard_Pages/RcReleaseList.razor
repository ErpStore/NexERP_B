@page "/rcReleaseList"
@using V.SMART.Shared.ViewModels.PlanningViewModel.RouteCardViewModel

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@inject IRcReleaseService rcReleaseService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch isModelVisible="true"
                       Screen="@ScreenName"
                       Filters="SearchFilters"
                       OnClose="CloseModal"
                       OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Route Card Release List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@rcBreadcrumbs" />

            <div class="card-body p-4">

                <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Work-In-Progress">Work-In-Progress</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>


                    @if (CanCreate)
                    {
                        <div class="col-12 col-md-2 ms-md-auto text-end">
                            <a href="rcRelease/create"
                               class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                               title="Create New">
                                <i class="bi-box-seam"></i> Add New
                            </a>
                        </div>
                    }

                </div>

                @if (RcReleaseVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="RcReleaseVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @foreach (var col in Columns.Where(c => c.IsVisible))
                            {
                                <div>
                                    @switch (col.Field)
                                    {
                                        case "RouteCardReleaseId":
                                            <PropertyColumn Title="Release ID" Property="@(c => c.RouteCardReleaseId)" />
                                            break;

                                        case "RcReleaseNo":
                                            <PropertyColumn Title="Release No"
                                                            Property="@(c => $"{c.RcReleaseNo}-{c.Suffix}")"
                                                            Sortable="true" />
                                            break;

                                        case "Suffix":
                                            <PropertyColumn Title="Suffix"
                                                            Property="@(c => c.Suffix)" />
                                            break;

                                        case "RcReleaseDate":
                                            <PropertyColumn Title="Release Date"
                                                            Property="@(c => c.RcReleaseDate)"
                                                            Format="dd/MM/yyyy"
                                                            Sortable="true" />
                                            break;

                                        case "PoNumber":
                                            <PropertyColumn Title="PO Number"
                                                            Property="@(c => c.PoNumber)" />
                                            break;

                                        case "AssemblyItemName":
                                            <PropertyColumn Title="Assembly Item"
                                                            Property="@(c => c.AssemblyItemCode)" />
                                            break;

                                        case "PoQty":
                                            <PropertyColumn Title="PO Qty"
                                                            Property="@(c => c.PoQty)" />
                                            break;

                                        case "ReleaseQty":
                                            <PropertyColumn Title="Release Qty"
                                                            Property="@(c => c.ReleaseQty)" />
                                            break;

                                        case "ReleasedBy":
                                            <PropertyColumn Title="Released By"
                                                            Property="@(c => c.ReleasedBy)" />
                                            break;

                                        case "ReleasedDate":
                                            <PropertyColumn Title="Released Date"
                                                            Property="@(c => c.ReleasedDate)"
                                                            Format="dd/MM/yyyy" />
                                            break;
                                    }
                                </div>
                            }


                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"rcRelease/update/{c.RouteCardReleaseId}")" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"rcRelease/details/{c.RouteCardReleaseId}")" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => HandleDelete(c.RouteCardReleaseId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>

                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }



            </div>
        </div>
    </div>
}

@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Route Card Release";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteRCReleaseId = 0;
    private string selectedStatus = "";

    private List<RouteCardReleaseVM> RcReleaseVMs = new();

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter, SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> rcBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Planning" },
        new PageHeader.BreadcrumbItem { Text = "Route Card Release", IsLast = true }
    };

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();

            //InstantSearch
            //Important : Deserialize Filter parameter from query string if exists
            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllRcRelease();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion


    #region === Data Loading ===

    private async Task LoadAllRcRelease()
    {
        try
        {
            var result = await rcReleaseService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            RcReleaseVMs = result.rcReleaseVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading Route Card Release List");
            await _JS.ToastrError("Failed to load RC Release List.");
        }
    }

    #endregion


    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                // Primary Key
                new() { Title = "Route Card Release ID", Field = "RouteCardReleaseId", IsVisible = false },

                // Release Details
                new() { Title = "Release No", Field = "RcReleaseNo", IsVisible = true },
                new() { Title = "Suffix", Field = "Suffix", IsVisible = true },
                new() { Title = "Release Date", Field = "RcReleaseDate", IsVisible = true },

                // PO Reference
                new() { Title = "PO ID", Field = "PoId", IsVisible = false },
                new() { Title = "PO Sub ID", Field = "PoSubId", IsVisible = false },
                new() { Title = "PO Number", Field = "PoNumber", IsVisible = true },

                // Assembly
                new() { Title = "Assembly Item ID", Field = "AssemblyItemId", IsVisible = false },
                new() { Title = "Assembly Item", Field = "AssemblyItemName", IsVisible = true },

                // Quantity Details
                new() { Title = "PO Qty", Field = "PoQty", IsVisible = true },
                new() { Title = "Release Qty", Field = "ReleaseQty", IsVisible = true },

                // Release Info
                new() { Title = "Released By", Field = "ReleasedBy", IsVisible = true },
                new() { Title = "Released Date", Field = "ReleasedDate", IsVisible = true }
            };

            if (!Hidden)
            {
                // Future dynamic columns can be added here
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Route Card Release List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Route Card Release HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllRcRelease();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Route Card Release List");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllRcRelease();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Route Card Release List");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllRcRelease();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Route Card Release List");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllRcRelease();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Route Card Release List");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllRcRelease();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Route Card Release List");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllRcRelease();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Route Card Release List page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int rcReleaseId)
    {
        try
        {
            var (canDelete, message) = await rcReleaseService.CanDeleteRcReleaseAsync(rcReleaseId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteRCReleaseId = rcReleaseId;

            ModalTitle = "Are you sure you want to delete this Route Card Release.";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for RcReleaseId: {rcReleaseId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            bool deleted = await rcReleaseService.DeleteRouteCardReleaseByRcReleaseIdAsync(DeleteRCReleaseId);
            if (deleted)
            {
                await _JS.ToastrSuccess("Route Card Release deleted successfully.");
                await LoadAllRcRelease();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Route Card Release could not be deleted. It may not exist or have dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting RcReleaseId: {DeleteRCReleaseId}");
            await _JS.ToastrError("Failed to delete Route Card Release.");
        }
        finally
        {
            DeleteRCReleaseId = 0;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllRcRelease();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Route Card Release List");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion


    #region Job order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

            if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;


            currentPage = 1;
            await LoadAllRcRelease();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in Route Card Release list");
            await _JS.ToastrError("Failed to Load Route Card Release List filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion

}
