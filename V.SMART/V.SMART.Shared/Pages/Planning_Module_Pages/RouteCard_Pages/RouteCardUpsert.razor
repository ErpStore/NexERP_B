    private async Task OnProcessChanged(ChangeEventArgs e, RouteCardSubVM subVM)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out var selectedProcId))
            {
                subVM.ProcessId = selectedProcId;
                subVM.ProcessName = ProcessList.FirstOrDefault(p => p.ProcessId == selectedProcId)?.ProcessName;

                subVM.TotalQty = RouteCardVMs.RcQty;
                subVM.BalQty = RouteCardVMs.RcQty;

                var previousRec = RouteCardVMs.RouteCardSubVMs
                    .Where(x => x.SlNo < subVM.SlNo)
                    .OrderByDescending(x => x.SlNo)
                    .FirstOrDefault();

                if (previousRec != null)
                {
                    subVM.MachineId = previousRec.MachineId;
                    subVM.MachineName = previousRec.MachineName;

                    subVM.VendorId = previousRec.VendorId;
                    subVM.VendorName = previousRec.VendorName;

                    subVM.CycleTime = previousRec.CycleTime;
                    subVM.SettingTime = previousRec.SettingTime;

                    subVM.ProcessCost = previousRec.ProcessCost;
                }
            }
            else
            {
                subVM.ProcessId = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnProcessChanged");
            await _js.ToastrError("An error occurred while changing the process.");
        }
    }

