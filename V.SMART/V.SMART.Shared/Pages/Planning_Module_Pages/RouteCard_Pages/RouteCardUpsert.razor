    #region SameSeqNo Validation

    private async Task OnUseSameSubProcessChanged(RouteCardSubVM row, bool value)
    {
        try
        {
            if (row.SeqNo == 1)
            {
                row.UseSameSeq = false;
                return;
            }

            row.UseSameSeq = value;

            if (!value)
            {
                row.GroupKey = Guid.NewGuid().ToString();
            }
            else
            {
                var ordered = RouteCardVMs.RouteCardSubVMs
                    .OrderBy(x => x.SlNo)
                    .ToList();

                int idx = ordered.IndexOf(row);

                if (idx > 0)
                {
                    var prev = ordered[idx - 1];

                    if (prev.SeqNo == 1)
                    {
                        row.UseSameSeq = false;
                        row.GroupKey = Guid.NewGuid().ToString();
                        return;
                    }

                    row.GroupKey = prev.GroupKey;
                }
            }

            await RecalculateSubProcess();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Toggle SubProcess Error");
            await _js.ToastrError("Error updating SubProcess grouping.");
        }
    }

    private async Task RecalculateSubProcess()
    {
        try
        {
            var list = RouteCardVMs.RouteCardSubVMs;
            if (list == null || list.Count == 0)
                return;

            var ordered = list.OrderBy(x => x.SlNo).ToList();

            string lastGroupKey = null;
            int subProcessCounter = 0;

            foreach (var row in ordered)
            {
                if (subProcessCounter == 0)
                {
                    subProcessCounter = 1;
                    row.SeqNo = 1;
                    row.UseSameSeq = false;
                    row.GroupKey ??= Guid.NewGuid().ToString();
                }
                else if (row.GroupKey != lastGroupKey)
                {
                    subProcessCounter++;
                    row.SeqNo = subProcessCounter;
                    row.UseSameSeq = false;
                }
                else
                {
                    row.SeqNo = subProcessCounter;
                    row.UseSameSeq = true;
                }

                lastGroupKey = row.GroupKey;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Recalc Seq No. Error");
            await _js.ToastrError("Error recalculating Seq No.");
        }
    }

