    #region RCQty Changed

    private async Task OnRcQtyChanged(ChangeEventArgs e, RouteCardVM RouteCardVMs)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty))
            {
                await _js.ToastrWarning("Invalid quantity entered.");
                return;
            }

            if (newQty < 0)
            {
                RouteCardVMs.RcQty = 0;
                await _js.ToastrWarning("RC Qty cannot be negative.");
                return;
            }

            RouteCardVMs.RcQty = newQty;
            RouteCardVMs.RMReqQty = newQty * RouteCardVMs.RMWeight;

            decimal alreadyTransactedQty = 0;
            var seq1 = RouteCardVMs.RouteCardSubVMs.FirstOrDefault(x => x.SeqNo == 1);

            if (seq1 != null)
                alreadyTransactedQty = seq1.IssuedQty;

            decimal? balanceQty;

            if (RouteCardVMs.SelectedItemType == "COMP")
            {
                balanceQty = await rcService.GetMfgPoRCBalQtyByRefPoIdAndItemId(
                    RouteCardVMs.RefPoId.Value,
                    RouteCardVMs.CompItemId.Value);
            }
            else
            {
                balanceQty = await rcService.GetRemainingQtyByAssyPoCompTrack(
                    RouteCardVMs.RefRcReleseId.Value,
                    RouteCardVMs.AssyId.Value,
                    RouteCardVMs.CompItemId.Value);
            }
            balanceQty ??= 0;

            if (RouteCardVMs.RCId == 0)
            {
                if (newQty > balanceQty)
                {
                    RouteCardVMs.RcQty = balanceQty.Value;
                    RouteCardVMs.RMReqQty = RouteCardVMs.RcQty * RouteCardVMs.RMWeight;

                    await _js.ToastrWarning($"RC Qty cannot exceed {balanceQty} (PO Balance)");
                }

                UpdateSubRows();
                return;
            }

            var originalRcQty = await rcService.GetExistingRCQtyByRoutecard(RouteCardVMs.RCId);

            decimal maxAllowedQty = originalRcQty.GetValueOrDefault() + balanceQty.Value;

            if (newQty < alreadyTransactedQty)
            {
                RouteCardVMs.RcQty = alreadyTransactedQty;
                RouteCardVMs.RMReqQty = alreadyTransactedQty * RouteCardVMs.RMWeight;

                await _js.ToastrWarning($"RC Qty cannot be less than already processed Qty: {alreadyTransactedQty}");
            }

            if (newQty > maxAllowedQty)
            {
                RouteCardVMs.RcQty = maxAllowedQty;
                RouteCardVMs.RMReqQty = RouteCardVMs.RcQty * RouteCardVMs.RMWeight;

                await _js.ToastrWarning($"RC Qty cannot exceed allowed max: {maxAllowedQty} (Existing RC + PO Balance)");
            }

            UpdateSubRows();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error in OnRCQtyChanged for Item: {RouteCardVMs?.CompItemCode}");
            await _js.ToastrError("Something went wrong while updating RC Quantity.");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void UpdateSubRows()
    {
        foreach (var row in RouteCardVMs.RouteCardSubVMs)
        {
            row.TotalQty = RouteCardVMs.RcQty;
            row.BalQty = row.TotalQty - (row.IssuedQty + row.AccQty + row.RejQty + row.RewQty);

            if (row.BalQty < 0)
                row.BalQty = 0;
        }
    }

    private async Task OnManualRcQtyChanged(ChangeEventArgs e, RouteCardVM RouteCardVMs)
    {
        try
        {
            if (!decimal.TryParse(Convert.ToString(e.Value), out decimal newQty))
            {
                await _js.ToastrWarning("Invalid quantity entered.");
                return;
            }

            if (newQty < 0)
            {
                newQty = 0;
                await _js.ToastrWarning("RC Quantity cannot be negative.");
            }

            // Assign once
            RouteCardVMs.RcQty = newQty;
            RouteCardVMs.RMReqQty = RouteCardVMs.RcQty * RouteCardVMs.RMWeight;

            // New RC
            if (RouteCardVMs.RCId == 0)
            {
                foreach (var row in RouteCardVMs.RouteCardSubVMs ?? Enumerable.Empty<RouteCardSubVM>())
                {
                    row.TotalQty = RouteCardVMs.RcQty;
                    row.BalQty = Math.Max(0, row.TotalQty.GetValueOrDefault() - row.IssuedQty);
                }
                return;
            }

            // Already processed validation
            var seq1 = RouteCardVMs.RouteCardSubVMs?
                            .FirstOrDefault(x => x.SeqNo == 1);

            var alreadyProcessedQty = seq1?.IssuedQty ?? 0;

            if (newQty < alreadyProcessedQty)
            {
                RouteCardVMs.RcQty = alreadyProcessedQty;
                RouteCardVMs.RMReqQty = alreadyProcessedQty * RouteCardVMs.RMWeight;

                foreach (var row in RouteCardVMs.RouteCardSubVMs ?? Enumerable.Empty<RouteCardSubVM>())
                {
                    row.TotalQty = RouteCardVMs.RcQty;
                    row.BalQty = Math.Max(0, row.TotalQty.GetValueOrDefault() - row.IssuedQty);
                }

                await _js.ToastrWarning($"RC Qty cannot be lower than already processed qty: {alreadyProcessedQty}");
                return;
            }

            // Existing RC normal update
            foreach (var row in RouteCardVMs.RouteCardSubVMs ?? Enumerable.Empty<RouteCardSubVM>())
            {
                row.TotalQty = RouteCardVMs.RcQty;
                row.BalQty = Math.Max(0, row.TotalQty.GetValueOrDefault() - row.IssuedQty);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,$"Error in OnManualRcQtyChanged for Item: {RouteCardVMs?.CompItemCode}");
            await _js.ToastrError("Something went wrong while updating RC Quantity.");
        }
    }


