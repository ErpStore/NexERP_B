    private async Task ConfirmRowSkip_Click()
    {
        if (rowToSkip == null) return;

        try
        {
            isProcessing = true;

            bool previousStatus = rowToSkip.IsProcessSkip;

            rowToSkip.IsProcessSkip = !rowToSkip.IsProcessSkip;

            rowToSkip.ProcessSkipReason = rowToSkip.IsProcessSkip ? ReasonForSkipCancelBom : null;

            await rcService.UpsertRouteCardSubAsync(rowToSkip);

            string actionText = rowToSkip.IsProcessSkip ? $"Process Skipped for Process Name: {rowToSkip.ProcessName}"
                : $"Process Reverted for Process Name: {rowToSkip.ProcessName}";

            string reasonText = rowToSkip.IsProcessSkip ? $"Reason: {ReasonForSkipCancelBom}" : $"Revert - Reason cleared";

            await LoggingService.LogUserAction(
                await _userService.GetUsernameAsync(),
                _userService.MachineName,
                _userService.IpAddress,
                screen: "Route Card",
                action: actionText,
                additionalInfo: reasonText
            );

            ReasonForSkipCancelBom = null;

            RouteCardVMs.RouteCardSubVMs =
                await rcService.GetRouteCardSubsByRCIdAsync(RouteCardVMs.RCId);

            await ResetSlno();

            string toastMessage = rowToSkip.IsProcessSkip ? "Process skipped successfully." : "Process reverted successfully.";

            await _js.ToastrSuccess(toastMessage);

            rowToSkip = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            int? failedId = rowToSkip?.RCSubId;

            ReasonForSkipCancelBom = null;

            await _js.ToastrError("An error occurred while updating the process skip status.");
            await LoggingService.LogDeveloperError(ex,$"Process Skip/Revert failed for RCSubId: {failedId}");
            rowToSkip = null;
        }
        finally
        {
            rowToSkip = null;
            ReasonForSkipCancelBom = null;
            isProcessing = false;
        }
    }

