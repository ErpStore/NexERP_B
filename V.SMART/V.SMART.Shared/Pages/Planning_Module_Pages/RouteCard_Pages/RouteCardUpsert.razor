    private async Task OnComponentChanged(ChangeEventArgs e)
    {
        if (e.Value == null || string.IsNullOrWhiteSpace(e.Value.ToString()))
        {
            RouteCardVMs.CompItemId = 0;

            RouteCardVMs.RcQty = 0;

            RouteCardVMs.RMId = null;
            RouteCardVMs.RMItemVMs = new List<ItemVM>();
            RouteCardVMs.RMReqQty = 0;
            RouteCardVMs.RMStockQty = 0;
            RouteCardVMs.RMWeight = 0;
            RouteCardVMs.RMBatchNo = string.Empty;

            StateHasChanged();
            return;
        }

        RouteCardVMs.CompItemId = Convert.ToInt32(e.Value);

        if (RouteCardVMs.SelectedItemType == "COMP")
        {
            var mfgPoSub = await rcService.GetPOQtyAndRCBalQtyByPoIdAndItemId(
                                RouteCardVMs.RefPoId.Value,
                                RouteCardVMs.CompItemId.Value);

            if (mfgPoSub != null)
            {
                RouteCardVMs.RcQty = mfgPoSub.RouteCardBalQty;
            }
            else
            {
                RouteCardVMs.RcQty = 0;
            }
        }
        else if (RouteCardVMs.SelectedItemType == "ASSY")
        {
            var remainingQty = await rcService.GetRemainingQtyByAssyPoCompTrack(
                        RouteCardVMs.RefRcReleseId.Value,
                        RouteCardVMs.AssyId.Value,
                        RouteCardVMs.CompItemId.Value);

            RouteCardVMs.RcQty = remainingQty;
        }

        RouteCardVMs.RMItemVMs = await rcService.GetRawMaterialByCompItemId(RouteCardVMs.CompItemId.Value);

        if (RouteCardVMs.RMItemVMs != null && RouteCardVMs.RMItemVMs.Count == 1)
        {
            var rm = RouteCardVMs.RMItemVMs.First();
            RouteCardVMs.RMId = rm.ItemId;

            await LoadRawMaterialDetails(rm.ItemId);
        }
        else
        {
            RouteCardVMs.RMId = null;
            RouteCardVMs.RMReqQty = 0;
            RouteCardVMs.RMStockQty = 0;
            RouteCardVMs.RMWeight = 0;
            RouteCardVMs.RMBatchNo = string.Empty;
        }
        StateHasChanged();
    }

