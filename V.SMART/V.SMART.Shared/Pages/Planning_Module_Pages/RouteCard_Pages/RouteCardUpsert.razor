    private async Task UpsertRouteCard()
    {
        try
        {
            isProcessing = true;

            if (RouteCardVMs.RcType == 2 && !RouteCardVMs.RouteCardSubVMs.Any(x => x.IsFinalProcess))
            {
                await _js.ToastrWarning("Final Process selection is required when creating a Manual Route Card. Please select a Final Process to continue.");
                return;
            }

            if (! RouteCardVMs.RouteCardSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a RouteCard without valid items.");
                return;
            }

            if(RouteCardVMs.IsManual)
            {

                if(RouteCardVMs.RcQty<=0)
                {
                    await _js.ToastrError("Please enter Valid RouteCard Quantity");
                    return;
                }
      
            }

            foreach (var line in  RouteCardVMs.RouteCardSubVMs)
            {
                bool isValid = await ValidateRouteCardLineAsync(line);
                if (!isValid) return;
            }

            var isNewRC = RouteCardVMs.RCId == 0;

            try
            {
                await rcService.UpsertRouteCardAsync(RouteCardVMs);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewRC)
                await _js.ToastrSuccess("Route Card saved successfully.");
            else
                await _js.ToastrSuccess("Route Card updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/routeCardList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertRouteCard failed.");
            await _js.ToastrError("Error saving Route Card.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateRouteCardLineAsync(RouteCardSubVM line)
    {
        try
        {
            if (line.ProcessId == 0)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateRouteCardLineAsync failed.");
            await _js.ToastrError("Error Validate Route Card Order Item line.");
            return false;
        }
    }

