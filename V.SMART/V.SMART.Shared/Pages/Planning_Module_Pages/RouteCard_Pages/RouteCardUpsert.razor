@page "/routeCard/create"
@page "/routeCard/update/{RCId:int}"

@using V.SMART.Shared.Data.Planning.AssyJobOrder
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.PlanningViewModel.JobOrderViewModel
@using V.SMART.Shared.ViewModels.PlanningViewModel.RouteCardViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IRouteCardService rcService
@inject ILoggingService LoggingService
@inject BarcodeService barcodeService
@inject ReportService reportService

@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@ReasonForSkipCancelBom"
         OnReasonChanged="(value) => ReasonForSkipCancelBom = value">
</BsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
        refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
    @if (ActiveModal == "ProcessLog")
    {
        <ProcessLogDetails RcSubId=@rowToViewLogs.RCSubId isModelVisible="true" />
    }
</MasterModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            
            <!-- Cancelled Watermark -->
            @if (RouteCardVMs.RcStatus == 3)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }

            <PageHeader TitleText="@(RouteCardVMs.RCId > 0 ? "Update Route Card" : "Create Route Card")"
                TitleIcon="bi bi-tag"
                Breadcrumbs="@RCFormBreadcrumbs" />
            
            <div class="card-body bg-light">
                <EditForm Model="RouteCardVMs" OnValidSubmit="UpsertRouteCard">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">

                        <div class="col-12 col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex justify-content-around align-items-center">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="ManufacturingSwitch"
                                               checked="@RouteCardVMs.MfgOrLab"
                                               @onchange="(e) => OnManufacturingToggle(e)" />
                                        <label class="form-check-label fw-semibold @(RouteCardVMs.MfgOrLab ? "text-success" : "")"
                                               for="ManufacturingSwitch">
                                            <i class="bi bi-gear-fill me-1"></i> Manufacturing
                                        </label>
                                    </div>

                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="LabourSwitch"
                                               checked="@(!RouteCardVMs.MfgOrLab)"
                                               @onchange="(e) => OnLabourToggle(e)" />
                                        <label class="form-check-label fw-semibold @(!RouteCardVMs.MfgOrLab ? "text-danger" : "")"
                                               for="LabourSwitch">
                                            <i class="bi bi-people-fill me-1"></i> Labour
                                        </label>
                                    </div>
                                </div>
                                <ValidationMessage For="@(() => RouteCardVMs.MfgOrLab)" />
                            </div>
                        </div>

                        <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="ManualJobSwitch"
                                       checked="@RouteCardVMs.IsManual"
                                       disabled="@(RouteCardVMs.RouteCardSubVMs != null &&
                                                    RouteCardVMs.RouteCardSubVMs.Any(x => x.ProcessId > 0))"
                                       @onchange="(e) => OnManualJObToggle(e)" />

                                <label class="form-check-label fw-semibold @(RouteCardVMs.IsManual ? "text-primary" : "")"
                                       for="ManualJobSwitch">
                                    <i class="bi bi-folder2-open me-1"></i> Manual
                                </label>
                            </div>

                            <ValidationMessage For="@(() => RouteCardVMs.IsManual)" />
                        </div>

                        <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">
                            @if (RouteCardVMs.RCId > 0 && !string.IsNullOrWhiteSpace(RouteCardVMs.RCNo))
                            {
                                <CorrespondenceStatus ReferenceType=@ScreenName
                                                      ReferenceId="@RouteCardVMs.RCId"
                                                      ReferenceTypeName="@RouteCardVMs.RCNo" />
                            }
                        </div>

                    </div>

                    <div class="row g-3 mb-2">

                        <div class="col-12 col-lg-6 mb-3 d-flex">
                            <div class="card shadow-sm border-0 rounded-3 w-100 h-100">

                                <div class="card-header d-flex justify-content-between align-items-center
                                            fw-semibold text-primary py-2"
                                        style="background-color:#EAF3FF;">
                                    <div>
                                        <i class="bi bi-upc-scan me-2"></i> Barcode & QR Code
                                    </div>

                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button"
                                                class="btn @(RouteCardVMs.RcType == 1 ? "btn-warning" : "btn-outline-primary")"
                                                title="Pre-allocated process from Item routing"
                                                disabled="@IsRcTypeLocked"
                                                @onclick="OnAutoRcClick">
                                            Auto RC
                                        </button>

                                        <button type="button"
                                                class="btn @(RouteCardVMs.RcType == 2 ? "btn-danger" : "btn-outline-primary")"
                                                title="Manually define sequence, process, machine and supplier"
                                                disabled="@IsRcTypeLocked"
                                                @onclick="OnManualRcClick">
                                            Manual RC
                                        </button>
                                    </div>
                                </div>

                                <div class="card-body bg-light rounded-bottom-3 h-100">
                                    <div class="d-flex flex-column flex-md-row
                                                justify-content-center justify-content-md-around
                                                align-items-center gap-4 h-100">
                                            
                                        @if (!string.IsNullOrWhiteSpace(RouteCardVMs.BarCodeBase64))
                                        {
                                            <div class="text-center">
                                                <p class="mb-1 small text-muted">Barcode</p>
                                                <img src="@RouteCardVMs.BarCodeBase64"
                                                        class="bg-white p-2 border rounded"
                                                        style="width:250px; height:auto;" />
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(RouteCardVMs.QrCodeBase64))
                                        {
                                            <div class="text-center">
                                                <p class="mb-1 small text-muted">QR Code</p>
                                                <img src="@RouteCardVMs.QrCodeBase64"
                                                        class="bg-white p-2 border rounded"
                                                        style="width:100px; height:100px; object-fit:contain;" />
                                            </div>
                                        }

                                        @if (string.IsNullOrWhiteSpace(RouteCardVMs.BarCodeBase64) && string.IsNullOrWhiteSpace(RouteCardVMs.QrCodeBase64))
                                        {
                                            <p class="text-muted small mb-0">
                                                Barcode and QR will be generated after saving Route Card
                                            </p>
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 mb-3 d-flex">
                            <div class="card shadow-sm border-0 rounded-3 w-100 h-100">

                                <div class="card-header fw-semibold text-primary py-2 d-flex justify-content-between align-items-center"
                                     style="background-color:#EAF3FF;">

                                    <div>
                                        <i class="bi bi-card-checklist me-2"></i> Route Card Details
                                    </div>

                                    @if (RouteCardVMs.RCId > 0)
                                    {
                                        <button type="button" class="btn btn-sm rounded-3 
                                                @(RouteCardVMs.RcStatus != 3 ? "btn-danger" : "btn-success")"
                                                @onclick="Cancel">

                                            @if (RouteCardVMs.RcStatus != 3)
                                            {
                                                <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                            }
                                        </button>
                                    }
                                </div>


                                <div class="card-body">

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Route Card No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Job No."
                                                            maxlength="30"
                                                            @bind-Value="@RouteCardVMs.RCNo"
                                                            readonly />
                                                <span class="input-group-text rounded-3">@RouteCardVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => RouteCardVMs.RCNo)" />
                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Route Card Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                        @bind-Value="@RouteCardVMs.RCDate" />
                                            <ValidationMessage For="@(() => RouteCardVMs.RCDate)" />
                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Cost Center</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3"
                                                        @bind="RouteCardVMs.ProjectNo" 
                                                        readonly />
                                            <ValidationMessage For="@(() => RouteCardVMs.ProjectNo)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-2">

                        @if (!RouteCardVMs.IsManual)
                        {
                            <!-- =================== Customer Information =================== -->
                            <div class="col-12 col-lg-6 mb-3 d-flex">
                                <div class="card shadow-sm border-0 rounded-3 h-100 w-100 d-flex flex-column">
                                    <div class="card-header fw-semibold text-primary py-2" style="background-color:#EAF3FF;">
                                        <i class="bi bi-person-badge me-2"></i> Customer Information
                                    </div>

                                    <div class="card-body">

                                        <!-- Customer Autocomplete -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label text-dark">
                                                <small>M/S.*</small>
                                            </label>
                                            
                                            <div class="col-12 col-sm-9">
                                                @if(RouteCardVMs.RCId == 0)
                                                {
                                                    <MudAutocomplete T="CustomerVM"
                                                        Value="RouteCardVMs.SelectedCustomer"
                                                        ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                        ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                        SearchFunc="SearchCustomers"
                                                        Dense="true"
                                                        Variant="Variant.Outlined"
                                                        Placeholder="Search Customer"
                                                        Class="w-100"
                                                        MaxItems="50"
                                                        Clearable="true"
                                                        Required="true"/>
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-select form-select-sm rounded-3"
                                                        @bind="RouteCardVMs.CustName"  readonly/>
                                                }
                                            </div>
                                        </div>

                                         @if (RouteCardVMs.CustId.HasValue || RouteCardVMs.CustId > 0)
                                         {
                                            <div class="mb-2 row">
                                                <label class="col-sm-3 col-form-label text-dark"><small>Item Type</small></label>
                                                <div class="col-sm-9 d-flex align-items-center">
                                                    <!-- Assembly -->
                                                    <div class="form-check me-4">
                                                        <input type="radio" class="form-check-input"
                                                                value="ASSY"
                                                                checked="@("ASSY" == RouteCardVMs.SelectedItemType)"
                                                                disabled="@(RouteCardVMs.RCId > 0)"
                                                                @onchange='() => OnItemTypeChanged("ASSY")'
                                                                />
                                                        <label class="form-check-label">Assembly</label>
                                                    </div>

                                                    <!-- Component -->
                                                    <div class="form-check">
                                                        <input type="radio" class="form-check-input"
                                                                value="COMP"
                                                                checked="@("COMP" == RouteCardVMs.SelectedItemType)"
                                                                disabled="@(RouteCardVMs.RCId > 0)"
                                                                @onchange='() => OnItemTypeChanged("COMP")' />
                                                        <label class="form-check-label">Component</label>
                                                    </div>
                                                </div>
                                            </div>
                                         }


                                        @if(RouteCardVMs.SelectedItemType=="ASSY")
                                        {
                                            @if (PendingRcRelease?.Any() == true 
                                                && RouteCardVMs?.RCId == 0 
                                                && RouteCardVMs?.SelectedItemType?.Any() == true)
                                            {
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label text-dark">
                                                        <small>Rc Release No*</small>
                                                    </label>

                                                    <div class="col-12 col-sm-9">
                                                        <select class="form-select form-select-sm rounded-3"
                                                                value="@RouteCardVMs.RefRcReleseId"
                                                                @onchange="OnRcReleaseChanged">
                                                            <option value="">--- Select Rc Release ---</option>
                                                            @foreach (var rcRelease in PendingRcRelease)
                                                            {
                                                                <option value="@rcRelease.RouteCardReleaseId">@rcRelease.RcReleaseNo</option>
                                                            }
                                                        </select>

                                                        <ValidationMessage For="@(() => RouteCardVMs.RefRcReleseId)" />
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label text-dark">
                                                        <small>Rc Release No*</small>
                                                    </label>

                                                    <div class="col-12 col-sm-9">
                                                        <input type="text" class="form-select form-select-sm rounded-3"
                                                            @bind="RouteCardVMs.RefRcReleaseNo"  readonly/>
                                                    </div>
                                                </div>
                                            }

                                        }
                                        else if(RouteCardVMs.SelectedItemType=="COMP")
                                        {
                                            
                                             <!-- Customer PO -->
                                            @if (CustomerPendingPOs?.Any() == true 
                                                && RouteCardVMs?.RCId == 0 
                                                && RouteCardVMs?.SelectedItemType?.Any() == true)
                                            {
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label text-dark">
                                                        <small>PO No*</small>
                                                    </label>

                                                    <div class="col-12 col-sm-9">
                                                        <select class="form-select form-select-sm rounded-3"
                                                                value="@RouteCardVMs.RefPoId"
                                                                @onchange="OnPoChanged">
                                                            <option value="">--- Select PO ---</option>
                                                            @foreach (var po in CustomerPendingPOs)
                                                            {
                                                                <option value="@po.PoId">@po.PONo</option>
                                                            }
                                                        </select>

                                                        <ValidationMessage For="@(() => RouteCardVMs.RefPoId)" />
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label text-dark">
                                                        <small>PO No*</small>
                                                    </label>

                                                    <div class="col-12 col-sm-9">
                                                        <input type="text" class="form-select form-select-sm rounded-3"
                                                            @bind="RouteCardVMs.RefPoNo"  readonly/>
                                                    </div>
                                                </div>
                                            }
                                        }




                                       

                                        @if (RouteCardVMs.RefPoId != null || RouteCardVMs.RefRcReleseId != null)
                                        {
                                            <!-- Load Assembly/SubAssy/Component Items -->
                                            @if(!string.IsNullOrEmpty(RouteCardVMs.SelectedItemType))
                                            {
                                                @if (RouteCardVMs.SelectedItemType == "ASSY")
                                                {
                                                    <div class="mb-2 row">
                                                        <label class="col-sm-3 col-form-label"><small>Assembly</small></label>
                                                        <div class="col-sm-9">
                                                            @if(RouteCardVMs.RCId == 0 && RouteCardVMs.AssyItemVMs.Count > 0)
                                                            {
                                                                <select class="form-select form-select-sm"
                                                                        value="@RouteCardVMs.AssyId"
                                                                        @onchange="OnAssemblyChanged">
                                                                    <option value="">-- Select Assembly --</option>

                                                                    @foreach (var item in RouteCardVMs.AssyItemVMs)
                                                                    {
                                                                        <option value="@item.ItemId">@item.ItemCode</option>
                                                                    }
                                                                </select>
                                                            }
                                                            else
                                                            {
                                                                <input type="text" class="form-select form-select-sm rounded-3"
                                                                        @bind="RouteCardVMs.AssyCode" readonly />
                                                            }
                                                        </div>
                                                    </div>

                                                   
                                                }

                                                <div class="mb-2 row">
                                                    <label class="col-sm-3 col-form-label"><small>Component</small></label>
                                                    <div class="col-sm-9">
                                                        @if(RouteCardVMs.RCId == 0)
                                                        {
                                                            <select class="form-select form-select-sm"
                                                                    value="@RouteCardVMs.CompItemId"
                                                                    @onchange="OnComponentChanged">
                                                                <option value="">-- Select Component --</option>
                                                                @foreach (var item in RouteCardVMs.CompItemVMs)
                                                                {
                                                                    <option value="@item.ItemId">@item.ItemCode</option>
                                                                }
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <input type="text" class="form-select form-select-sm rounded-3"
                                                                    @bind="RouteCardVMs.CompItemCode" readonly />
                                                        }
                                                    </div>
                                                </div>

                                                @if (RouteCardVMs.CompItemId > 0)
                                                {
                                                    <div class="mb-2 row">
                                                        <label class="col-sm-3 col-form-label"><small>Route Card Qty.</small></label>

                                                        <div class="col-sm-9">
                                                            <input type="number"
                                                                class="form-control form-control-sm"
                                                                placeholder="Qty"
                                                                step="any"
                                                                title="Enter Quantity"
                                                                @bind="RouteCardVMs.RcQty"
                                                                @bind:event="oninput"
                                                                @onchange="@(e => OnRcQtyChanged(e, RouteCardVMs))" />
                                                            <ValidationMessage For="@(() => RouteCardVMs.RcQty)" />
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- =================== Component details =================== -->
                            <div class="col-12 col-lg-6 mb-3 d-flex">
                                <div class="card shadow-sm border-0 rounded-3 h-100 w-100 d-flex flex-column">
                                    <div class="card-header fw-semibold text-primary py-2" style="background-color:#EAF3FF;">
                                        <i class="bi bi-person-badge me-2"></i> Component Details
                                    </div>

                                    <div class="card-body">

                                        <div class="mb-2 row">
                                            <label class="col-sm-3 col-form-label"><small>Component</small></label>
                                            <div class="col-sm-9">
                                                @if(RouteCardVMs.RCId == 0)
                                                {
                                                    <MudAutocomplete T="ItemVM"
                                                            Value="RouteCardVMs.SelectedComponent"
                                                            ValueChanged="@(async item => await OnItemChanged(RouteCardVMs, item))"
                                                            ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                            SearchFunc="SearchItems"
                                                            Dense="true"
                                                            Variant="Variant.Outlined"
                                                            Placeholder="Search Item Code"
                                                            Title="Search Atleast 3 Letters in Item-Code"
                                                            Class="w-100 autocomplete-sm"
                                                            MaxItems="50" />
                                                    <ValidationMessage For="@(() => RouteCardVMs.CompItemId)" />
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-select form-select-sm rounded-3"
                                                            @bind="RouteCardVMs.CompItemCode" readonly />
                                                }
                                            </div>
                                        </div>

                                        @if (RouteCardVMs.CompItemId > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-sm-3 col-form-label"><small>Route Card Qty.</small></label>

                                                <div class="col-sm-9">
                                                    <input type="number"
                                                            class="form-control form-control-sm"
                                                            placeholder="Qty"
                                                            step="any"
                                                            title="Enter Quantity"
                                                            @bind="RouteCardVMs.RcQty"
                                                            @bind:event="oninput"
                                                            @onchange="@(e => OnManualRcQtyChanged(e, RouteCardVMs))" />
                                                    <ValidationMessage For="@(() => RouteCardVMs.RcQty)" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }


                        <!-- =================== Raw Material =================== -->
                        @if(RouteCardVMs.CompItemId > 0)
                        {
                            <div class="col-12 col-lg-6 mb-3 d-flex">
                                <div class="card shadow-sm border-0 rounded-3 h-100 w-100 d-flex flex-column">
                                    <div class="card-header fw-semibold text-primary py-2" style="background-color:#EAF3FF;">
                                        <i class="bi bi-box-seam me-2"></i> Raw Material Details
                                    </div>

                                    <div class="card-body">
                                        <table class="table table-bordered table-sm align-middle">
                                            <tbody>

                                                <tr>
                                                    <td class="col-sm-3"><small>Raw Material</small></td>
                                                    <td class="col-sm-9">

                                                        @if(RouteCardVMs.RCId == 0)
                                                        {
                                                            <select class="form-select form-select-sm"
                                                                    value="@RouteCardVMs.RMId"
                                                                    @onchange="OnRMChanged">
                                                                <option value="">-- Select Raw Material --</option>
                                                                @foreach (var item in RouteCardVMs.RMItemVMs)
                                                                {
                                                                    <option value="@item.ItemId">@item.ItemCode</option>
                                                                }
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <input type="text" class="form-select form-select-sm rounded-3"
                                                                @bind="RouteCardVMs.RMCode" readonly />
                                                        }

                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td><small>RM Req Qty.</small></td>
                                                    <td><input type="number" class="form-control form-control-sm" @bind="RouteCardVMs.RMReqQty" readonly /></td>
                                                </tr>

                                                <tr>
                                                    <td><small>RM Stock Qty.</small></td>
                                                    <td><input type="number"
                                                           class="form-control form-control-sm text-danger fw-bold"
                                                           @bind="RouteCardVMs.RMStockQty"
                                                           readonly />
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <td><small>Weight/Piece</small></td>
                                                    <td><input type="number" class="form-control form-control-sm" @bind="RouteCardVMs.RMWeight" readonly /></td>
                                                </tr>

                                                <tr>
                                                    <td><small>Batch No</small></td>
                                                    <td><input type="text" class="form-control form-control-sm" @bind="RouteCardVMs.RMBatchNo" readonly /></td>
                                                </tr>

                                                <tr>
                                                    <td><small>Main Remarks</small></td>
                                                    <td>
                                                        <InputTextArea
                                                            class="form-control form-control-sm rounded-3"
                                                            rows="1"
                                                            @bind-Value="RouteCardVMs.MainRemarks">
                                                        </InputTextArea>
                                                        <ValidationMessage For="@(() => RouteCardVMs.MainRemarks)" />
                                                    </td>
                                                </tr>

                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>

                    <!-- =================== Item Details =================== -->

                    <div class="col-12">
                        <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                               
                            <div class="card-header bg-primary-subtle text-dark">
                                <div class="d-flex justify-content-between align-items-center flex-wrap">
                                    <!-- Title -->
                                    <span class="fw-bold fs-6">Process Details</span>
                                </div>
                            </div>

