    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "showLogs":
                    if(rowToViewLogs != null)
                        await OpenModal("ProcessLog");
                    break;

                case "confirmDeleteProcessRow_Click":
                    if(rowToDelete != null)
                        await confirmDeleteRow_Click();
                    break;

                case "ProcessSkip":
                    if(rowToSkip != null)
                        await ConfirmRowSkip_Click();
                    break;

                case "BOMAllocate":
                    if(rowToBOM != null)
                        await ConfirmBOMAllocate_Click();
                    break;

                case "QualityCheck":
                    if(rowToQuality != null)
                        await ConfirmQualityCheck_Click();
                    break;

                default:
                        await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action in DcSubConOutgoingUpsert: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action in DcSubConOutgoingUpsert. Please try again.");
        }
    }

