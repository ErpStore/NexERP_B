    private async Task LoadRawMaterialDetails(int rmId)
    {
        try
        {
            if (!RouteCardVMs.CompItemId.HasValue || RouteCardVMs.CompItemId.Value == 0)
            {
                await _js.ToastrWarning("Please select the Component Item first.");
                return;
            }

            var details = await rcService.GetRMDetails(rmId, RouteCardVMs.CompItemId.Value, RouteCardVMs.RcQty);

            if (details != null)
            {
                RouteCardVMs.RMReqQty   = details.RequiredQty;
                RouteCardVMs.RMStockQty = details.StockQty;
                RouteCardVMs.RMWeight   = details.Weight;
                RouteCardVMs.RMBatchNo  = details.BatchNo;
                RouteCardVMs.MainRemarks = details.Remarks;
            }
            else
            {
                RouteCardVMs.RMReqQty = 0;
                RouteCardVMs.RMStockQty = 0;
                RouteCardVMs.RMWeight = 0;
                RouteCardVMs.RMBatchNo = string.Empty;
                RouteCardVMs.MainRemarks = string.Empty;
            }

            if(RouteCardVMs.RcType == 1)
            {
                await LoadProcessFlowList(RouteCardVMs.CompItemId.Value, rmId);
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                $"Error in LoadRawMaterialDetails for RM Id: {rmId}");

            await _js.ToastrError("Failed to load raw material details. Please try again.");
        }
    }

    private async Task LoadProcessFlowList(int compItemId, int rmId)
    {
        try
        {
            var flowList = await rcService.GetProcessFlowAsync(compItemId, rmId);

            if (flowList == null || !flowList.Any())
            {
                RouteCardVMs.RouteCardSubVMs = new List<RouteCardSubVM>();
                return;
            }

            int finalSlNo = flowList.Max(x => x.SlNo);

            RouteCardVMs.RouteCardSubVMs = flowList
                .OrderBy(x => x.SlNo)
                .Select(p =>
                {
                    bool isFirstProcess = p.SubProcess == 1;

                    return new RouteCardSubVM
                    {
                        RCSubId = 0,
                        RCId = RouteCardVMs.RCId,

                        SlNo = p.SlNo,
                        SeqNo = p.SubProcess,

                        ProcessId = p.ProcId,
                        ProcessName = p.Process?.ProcessName,

                        ItemIdOut = isFirstProcess ? p.RMId : p.CompItemId,
                        ItemCodeOut = isFirstProcess ? p.RawMaterialItem?.ItemCode : p.ComponentItem?.ItemCode,

                        ItemIdIn = p.CompItemId,
                        ItemCodeIn = p.ComponentItem?.ItemCode,

                        TotalQty = RouteCardVMs.RcQty,
                        BalQty = RouteCardVMs.RcQty,
                        AccQty = 0,
                        RejQty = 0,
                        RewQty = 0,
                        NextProcessQty = 0,

                        MachineId = p.MachId,
                        MachineName = p.Machine?.MachineName,

                        VendorId = p.VendorCode,
                        VendorName = p.Vendor?.VendorName,

                        CycleTime = p.CycleTime,
                        SettingTime = p.SettingTime,
                        ProcessCost = p.UnitPrice,

                        IsBOM = p.BOM,
                        IsInspection = p.Inspection,
                        IsProcessSkip = p.ProcessSkip,

                        IsFinalProcess = (p.SlNo == finalSlNo),
                        ProcessStatus = 0
                    };
                })
                .ToList();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,$"Error in LoadProcessFlowList for CompItemId: {compItemId}, RMId: {rmId}");
            await _js.ToastrError("Failed to load process flow. Please try again.");
        }
    }

