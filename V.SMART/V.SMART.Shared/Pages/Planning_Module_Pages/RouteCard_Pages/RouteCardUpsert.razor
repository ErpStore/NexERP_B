                                                                style="transform: scale(1);"
                                                                disabled="@(!isManualEditable || isRowLocked)" />
                                                        </div>
                                                    </td>

                                                    <td>
                                                        @if (isManualEditable && !isRowLocked)
                                                        {
                                                            <input type="number" class="form-control form-control-sm text-end"
                                                                   min="0" step="any" @bind="sub.ProcessCost" />
                                                        }
                                                        else
                                                        {
                                                            <span class="float-end">@sub.ProcessCost</span>
                                                        }
                                                    </td>

                                                    <td class="text-center">
                                                        @switch (sub.ProcessStatus)
                                                        {
                                                            case 0:
                                                                <span class="badge bg-secondary">Pending</span>
                                                                break;
                                                            case 1:
                                                                <span class="badge bg-info text-dark">In Progress</span>
                                                                break;
                                                            case 2:
                                                                <span class="badge bg-warning text-dark">Partial</span>
                                                                break;
                                                            default:
                                                                <span class="badge bg-success">Completed</span>
                                                                break;
                                                        }
                                                    </td>

                                                    <td class="text-end">
                                                        @if (isManualEditable && !isRowLocked)
                                                        {
                                                            <button type="button" class="btn btn-success btn-sm" @onclick="async () => await SaveRow(sub)">
                                                                <i class="bi bi-check-lg"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="async () => await CancelEdit(sub, RouteCardVMs)">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-primary btn-sm" @onclick="async () => await EditRowAsync(sub)" disabled="@isRowLocked">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-danger btn-sm" @onclick="async () => await RemoveRow(sub)" disabled="@isRowLocked">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }
                                                    </td>

                                                </tr>
                                            }
                                            </tbody>

                                    </table>
                                </div>

                                @if(RouteCardVMs.RcType == 2)
                                {
                                    <div class="mt-2 text-start">
                                        <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                            <i class="bi bi-plus-circle me-1"></i> Add Item
                                        </button>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="row g-3 mt-3 mb-2">

                            @if (CanCreate || CanEdit)
                            {
                                @if(RouteCardVMs.RcStatus != 3)
                                {
                                    <div class="col-6 col-md-3 mt-3">
                                        <button type="submit"
                                                class="btn btn-primary w-100 rounded-3"
                                                disabled="@isProcessing">
                                            <i class="bi bi-floppy2-fill me-1"></i>
                                            @(RouteCardVMs.RCId > 0 ? "Update" : "Create")
                                        </button>
                                    </div>
                                }
                            }

                            <div class="col-12 col-md-3">
                                <SmartBackButton Url="/routeCardList" />
                            </div>

                            @if (CanCreate || CanEdit && RCId > 0)
                            {
                                <div class="col-12 col-md-3">
                                    <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                        <i class="bi bi-printer me-1"></i>Print
                                    </button>
                                </div>
                            }

                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
} 

@code
{
    #region Parameters & Properties

    protected override string ScreenName => "Route Card";

    [Parameter] 
    public int? RCId { get; set; }

    private bool isProcessing = true;
     private string? pdfBase64;

    private RouteCardVM RouteCardVMs { get; set; } = new();
    private RouteCardSubVM? rowToDelete;
    private RouteCardSubVM? rowToSkip;
    private RouteCardSubVM? rowToBOM;
    private RouteCardSubVM? rowToQuality;

    private RouteCardSubVM? rowToViewLogs;

    private bool IsRcTypeLocked => RouteCardVMs?.RouteCardSubVMs?.Any(x => x.ProcessId.HasValue && x.ProcessId > 0) == true;

    private List<Machine> MachineList = new();
    private List<Process> ProcessList = new();
    private List<VendorVM> VendorList = new();


    private List<MfgPoVM> CustomerPendingPOs = new();
    private List<RouteCardReleaseVM> PendingRcRelease = new();

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;

    public string? ReasonForSkipCancelBom { get; set; }

    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private List<PageHeader.BreadcrumbItem> RCFormBreadcrumbs = new()
    {
        new() { Text = "Planning" },
        new() { Text = "Route Card", IsLast = true }
    };

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    #endregion


    #region  Row Lock Logic

    public bool IsManualEditable(RouteCardVM main, RouteCardSubVM sub)
    {
        return sub.IsEditable && main.RcType == 2;
    }

    public bool IsProcessLocked(RouteCardSubVM sub)
    {
        return (sub.IssuedQty + sub.AccQty + sub.RejQty + sub.RewQty) > 0
               || sub.ProcessStatus >= 1;
    }

    public bool IsNextProcessStarted(List<RouteCardSubVM> list, int index)
    {
        if (index >= list.Count - 1)
            return false;

        var next = list[index + 1];

        return (next.IssuedQty > 0)
            || (next.AccQty > 0)
            || (next.RejQty > 0)
            || (next.RewQty > 0)
            || (next.WipQty > 0);
    }

    public bool IsRowLocked(RouteCardVM main, List<RouteCardSubVM> list, int index)
    {
        var sub = list[index];

        return IsProcessLocked(sub) || IsNextProcessStarted(list, index);
    }

    #endregion

    #region Toggles

    private void OnManufacturingToggle(ChangeEventArgs e)
    {
        bool isChecked = (bool)e.Value;
        RouteCardVMs.MfgOrLab = isChecked;

        // Selected Items
        RouteCardVMs.CompItemId = null;
        RouteCardVMs.AssyId = null;
        RouteCardVMs.SubAssyId = null;
        RouteCardVMs.SubAssyId2 = null;
        RouteCardVMs.SubAssyId3 = null;

        // Collections
        RouteCardVMs.CompItemVMs = new();
        RouteCardVMs.AssyItemVMs = new();
        RouteCardVMs.SubAssyItemVMs = new();
        RouteCardVMs.SubAssyItemVM2s = new();
        RouteCardVMs.SubAssyItemVM3s = new();
        RouteCardVMs.RouteCardSubVMs = new();

        CustomerPendingPOs = new();
        PendingRcRelease = new();
        RouteCardVMs.SelectedCustomer = null;
    }

    private void OnLabourToggle(ChangeEventArgs e)
    {
        bool isChecked = (bool)e.Value;
        RouteCardVMs.MfgOrLab = !isChecked;

        // Selected Items
        RouteCardVMs.CompItemId = null;
        RouteCardVMs.AssyId = null;
        RouteCardVMs.SubAssyId = null;
        RouteCardVMs.SubAssyId2 = null;
        RouteCardVMs.SubAssyId3 = null;

        // Collections
        RouteCardVMs.CompItemVMs = new();
        RouteCardVMs.AssyItemVMs = new();
        RouteCardVMs.SubAssyItemVMs = new();
        RouteCardVMs.SubAssyItemVM2s = new();
        RouteCardVMs.SubAssyItemVM3s = new();
        RouteCardVMs.RouteCardSubVMs = new();

        CustomerPendingPOs = new();
        PendingRcRelease = new();

        RouteCardVMs.SelectedCustomer = null;
    }

    private async Task OnManualJObToggle(ChangeEventArgs e)
    {
        bool newValue = e.Value is bool b && b;
        RouteCardVMs.IsManual = newValue;
        StateHasChanged();
    }

    #endregion

    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        isProcessing = true;

        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied", true);
                return;
            }

            if (RCId.HasValue)
            {
                await LoadExistingRouteCard(RCId.Value);
            }
            else
            {
                bool IsManual = await rcService.GetScreenPermissionsAsync();

                if(!IsManual)
                {
                    RouteCardVMs.RcType = 1;
                }
                else
                {
                    RouteCardVMs.RcType = 2;
                    await LoadProcessVendorAndMachineAsync();
                }

                RouteCardVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
                var RcNo = await rcService.GetPreviewRcNoAsync(RouteCardVMs.Suffix);
                RouteCardVMs.RCNo = RcNo.ToString("D3");

                string fullRC = $"{RouteCardVMs.RCNo}{RouteCardVMs.Suffix}";

                RouteCardVMs.BarCodeImage = barcodeService.GenerateBarcodeBytes(fullRC);
                RouteCardVMs.QrCodeImage = barcodeService.GenerateQrBytes(fullRC);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadProcessVendorAndMachineAsync()
    {
        try
        {
            ProcessList = (await rcService.GetAllProcessesAsync()).ToList();
            MachineList = await rcService.GetAllMachinesAsync();
            VendorList = await rcService.GetAllVendorsAsync();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadProcessVendorAndMachineAsync failed.");
        }

    }


    private async Task LoadExistingRouteCard(int rcId)
    {
        try
        {
            RouteCardVMs = await rcService.GetRouteCardByRCIdAsync(rcId);

            if (RouteCardVMs == null)
            {
                await _js.ToastrWarning("Route Card not found.");
                return;
            }

            string fullRC = $"{RouteCardVMs.RCNo}{RouteCardVMs.Suffix}";
            RouteCardVMs.BarCodeImage = barcodeService.GenerateBarcodeBytes(fullRC);
            RouteCardVMs.QrCodeImage = barcodeService.GenerateQrBytes(fullRC);

            RouteCardVMs.SelectedCustomer = 
                await rcService.GetCustomerByIdAsync(RouteCardVMs.CustId.GetValueOrDefault());

            if (RouteCardVMs.SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(RouteCardVMs.SelectedCustomer);

        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing Route Card");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingRouteCard failed for RCId: {rcId}");
        }
    }


    #endregion

    #region Toggle Manual And Auto RC

    private async Task OnAutoRcClick()
    {
        RouteCardVMs.RcType = 1;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnManualRcClick()
    {
        try
        {
            isProcessing = true;

            RouteCardVMs.RcType = 2;
            await LoadProcessVendorAndMachineAsync();
        }
        catch(Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnManualRcClick failed.");
        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    #endregion


    #region Row Operations

    private async Task<bool> ValidateRowAsync(RouteCardSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ProcessId == null || row.ProcessId == 0)
                errors.Add("Please select a Process.");

            if (row.ProcessCost == null || row.ProcessCost <= 0)
                errors.Add("Process Cost must be greater than 0.");

            if (!row.CycleTime.HasValue || row.CycleTime.Value.TotalSeconds <= 0)
                errors.Add("Cycle Time must be greater than 0.");

            if ((row.MachineId == null || row.MachineId <= 0) &&
                (row.VendorId == null || row.VendorId <= 0))
                errors.Add("Please select either Machine or Vendor for this Process.");

            if (errors.Any())
            {
                await _js.ToastrInfo(string.Join("<br>", errors));
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = RouteCardVMs.RouteCardSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (!RouteCardVMs.RMId.HasValue || RouteCardVMs.RMId <= 0)
            {
                await _js.ToastrWarning("Please select Raw Material first.");
                return;
            }

            if (!await ValidateLastRowAsync())
                return;

            int? nextSeqNo = RouteCardVMs.RouteCardSubVMs.Any()
                ? RouteCardVMs.RouteCardSubVMs.Max(x => x.SeqNo) + 1
                : 1;

            var newRow = new RouteCardSubVM
            {
                RCId = RouteCardVMs.RCId,
                IsEditable = true,
                SeqNo = nextSeqNo,
                GroupKey = Guid.NewGuid().ToString()
            };

            if (nextSeqNo == 1)
            {
                newRow.ItemIdIn  = RouteCardVMs.CompItemId;
                newRow.ItemIdOut = RouteCardVMs.RMId;
            }
            else
            {
                newRow.ItemIdIn  = RouteCardVMs.CompItemId;
                newRow.ItemIdOut = RouteCardVMs.CompItemId;
            }

            RouteCardVMs.RouteCardSubVMs.Add(newRow);

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await LoggingService.LogDeveloperError(ex, "Route-Card Sub Process Add failed.");
        }
    }

    private async Task SaveRow(RouteCardSubVM row)
    {
        try
        {
            if (!await ValidateRowAsync(row))
            {
                row.IsEditable = true;
                return;
            }

            if (string.IsNullOrEmpty(row.GroupKey))
                row.GroupKey = Guid.NewGuid().ToString();

            row.IsEditable = false;

            if (!RouteCardVMs.RouteCardSubVMs.Any(x => x.IsEditable))
            {
                RouteCardVMs.RouteCardSubVMs.Add(new RouteCardSubVM
                {
                    RCId = RouteCardVMs.RCId,
                    IsEditable = true,
                    GroupKey = Guid.NewGuid().ToString()
                });
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for RcSubId: {row?.RCSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(RouteCardSubVM row)
    {
        try
        {
            row.IsEditable = true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for RcSubId: {row?.RCSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(RouteCardSubVM row, RouteCardVM routeCardVm)
    {
        try
        {
            if (row == null || routeCardVm == null) return;

            bool isInvalid = (row.ProcessId == null || row.ProcessId <= 0);

            if (isInvalid)
            {
                routeCardVm.RouteCardSubVMs.Remove(row);
                await ResetSlno();
            }
            else
            {
                row.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for RcSubId: {row?.RCSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(RouteCardSubVM row)
    {
        try
        {
            if (RouteCardVMs.RouteCardSubVMs.Count == 1 && row.RCSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row is required.");
                return;
            }

            if(row.RCSubId > 0)
            {
                await _js.ToastrWarning("Deletion not allowed. Already allocated processes can only be skipped, not removed.");
                return;
            }

            rowToDelete = row;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteProcessRow_Click";

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for RcSubId: {row?.RCSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in RouteCardVMs.RouteCardSubVMs)
            {
                sub.SlNo = counter++;
            }

            await RecalculateSubProcess();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to reset row serial numbers.");
        }
    }

