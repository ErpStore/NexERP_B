            StateHasChanged();
        }
        catch (Exception ex)
        {
            int? failedId = rowToBOM?.RCSubId;

            await _js.ToastrError("An error occurred while updating the BOM allocation status.");
            await LoggingService.LogDeveloperError(ex,$"BOM Allocation failed for RCSubId: {failedId}");

            rowToBOM = null;
            ReasonForSkipCancelBom = null;
        }
        finally
        {
            rowToBOM = null;
            ReasonForSkipCancelBom = null;
            isProcessing = false;
        }
    }

    private async Task ConfirmQualityCheck_Click()
    {
        if (rowToQuality == null) return;

        try
        {
            isProcessing = true;

            bool previousStatus = rowToQuality.IsInspection;

            rowToQuality.IsInspection = !rowToQuality.IsInspection;

            await rcService.UpsertRouteCardSubAsync(rowToQuality);

            string statusText = rowToQuality.IsInspection ? "Quality Check Completed" : "Quality Check Reverted";

            await LoggingService.LogUserAction(
                await _userService.GetUsernameAsync(),
                _userService.MachineName,
                _userService.IpAddress,
                screen: "Route Card",
                action: $"{statusText} for Process Name: {rowToQuality.ProcessName}",
                additionalInfo: ""
            );

            RouteCardVMs.RouteCardSubVMs =
                await rcService.GetRouteCardSubsByRCIdAsync(RouteCardVMs.RCId);

            await ResetSlno();

            string toastMessage = rowToQuality.IsInspection ? "Quality Check completed successfully." : "Quality Check reverted successfully.";

            await _js.ToastrSuccess(toastMessage);

            rowToQuality = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            int? failedId = rowToQuality?.RCSubId;

            await _js.ToastrError("An error occurred while updating the Quality Check.");

            await LoggingService.LogDeveloperError(ex,$"Quality Check failed for RCSubId: {failedId}");

            rowToQuality = null;
        }
        finally
        {
            rowToBOM = null;
            ReasonForSkipCancelBom = null;
            isProcessing = false;
        }
    }


    #endregion
    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            bool Cancel = false;

            if (RouteCardVMs.RcStatus == 3)
            {
                Cancel = true;
            }

            var pdfBytes = await reportService.Generate_Report(RCId.GetValueOrDefault(), "RouteCard.frx", "RcId", Cancel, ScreenName, "Sp_Print_RouteCard");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);

        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Route Card");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Route Card");
        }
        finally
        {
            isProcessing = false;
        }
    }
}