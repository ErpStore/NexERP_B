    private async Task<PreloadedData> PreloadAllDataAsync(List<MRAPoItems> items)
    {
        var bomByParent = new Dictionary<int, List<BOMItem>>();
        var rmByComponent = new Dictionary<int, List<CompMasterVM>>();
        var allItemIds = new HashSet<int>();

        var queue = new Queue<int>(
            items.Select(x => x.ItemId).Distinct());

        while (queue.Count > 0)
        {
            int parentId = queue.Dequeue();

            if (allItemIds.Contains(parentId))
                continue;

            allItemIds.Add(parentId);


            var children =
                await _mraService.GetDirectBOMItemsAsync(parentId)
                ?? new List<BOMItem>();

            bomByParent[parentId] = children;

            foreach (var child in children)
            {
                if (!allItemIds.Contains(child.ItemID))
                {
                    queue.Enqueue(child.ItemID);
                }
            }


            var rmData =
                await _mraService.GetRawMaterialsForComponentsBatchAsync(
                    new List<int> { parentId });

            if (rmData.TryGetValue(parentId, out var rms))
            {
                rmByComponent[parentId] = rms;

                foreach (var rm in rms.Where(x => x.RMId.HasValue))
                {
                    int rmId = rm.RMId.Value;


                    if (!allItemIds.Contains(rmId))
                    {
                        queue.Enqueue(rmId);
                    }
                }
            }
        }

        return new PreloadedData
        {
            AllItemIds = allItemIds,
            BOMByParentId = bomByParent,
            RawMaterialsByComponentId = rmByComponent
        };
    }
    private void AddAssemblyBOMItems(
     MRAPoItems parentItem,
     List<MRAPoSubItemsVM> subItems,
     PreloadedData preloaded)
    {
        ProcessAssemblyRecursive(
            sourceItem: parentItem,
            currentItemId: parentItem.ItemId,
            currentQty: parentItem.RequiredQty ?? 0,
            cumulativeUtilQty: 1,
            subItems: subItems,
            preloaded: preloaded);
    }

    private void AddComponentWithRawMaterials(MRAPoItems item, List<MRAPoSubItemsVM> subItems, PreloadedData preloaded)
    {
        if (!_runningItemStock.TryGetValue(item.ItemId, out var stock))
            stock = 0;

        var reqQty = item.RequiredQty ?? 0;
        var originalStock = stock;
        var diffQty = Math.Max(0, reqQty - originalStock);
        _runningItemStock[item.ItemId] = Math.Max(0, stock - reqQty);

        if (!preloaded.RawMaterialsByComponentId.TryGetValue(item.ItemId, out var rmList) || rmList == null || !rmList.Any())
        {
            AddSingleItemRunningStock(item, subItems);
            return;
        }

        foreach (var rm in rmList)
        {
            if (!rm.RMId.HasValue) continue;

            if (!_runningItemStock.TryGetValue(rm.RMId.Value, out var rmStock))
                rmStock = 0;

            var rmReqQty = rm.Weight * reqQty;
            var originalRmStock = rmStock;
            var rmDiff = Math.Max(0, rmReqQty - originalRmStock);
            _runningItemStock[rm.RMId.Value] = Math.Max(0, rmStock - rmReqQty);

            subItems.Add(new MRAPoSubItemsVM
            {
                CustId = item.CustId.Value,
                CustName = item.custName,
                RefPoSubId = item.RefPoSubId,
                RefPoId = item.RefPoId,
                RefPoNo = item.RefPoNo,
                RefPoDate = item.RefPoDate,
                AssyCompItemId = item.ItemId,
                AssyCompCode = item.ItemCode,
                AssyCompName = item.ItemName,
                AssyCompUtilityQty = 1,
                AssyCompReqQty = reqQty,
                AssyCompStokQty = originalStock,
                AssyCompDiffQty = diffQty,
                RMItemId = rm.RMId,
                RMItemCode = rm.RMCode,
                RMUtilityQty = rm.Weight,
                RMReqQty = rmReqQty,
                RMStockQty = originalRmStock,
                RMDiffQty = rmDiff,
                Type = item.Type,
                CostId = item.CostId,
                ProjectNo = item.ProjectNo,
                IsLabourMaterial = item.IsLabourMaterial
            });
        }
    }

    private class PreloadedData
    {
        public HashSet<int> AllItemIds { get; set; }
        public Dictionary<int, List<BOMItem>> BOMByParentId { get; set; }
        public Dictionary<int, List<CompMasterVM>> RawMaterialsByComponentId { get; set; }
    }
    private void ProcessAssemblyRecursive(
      MRAPoItems sourceItem,
      int currentItemId,
      decimal currentQty,
      decimal cumulativeUtilQty,
      List<MRAPoSubItemsVM> subItems,
      PreloadedData preloaded)
    {
        if (!preloaded.BOMByParentId.TryGetValue(
            currentItemId,
            out var children))
            return;

        foreach (var child in children)
        {
            decimal childQty = currentQty * child.UtilQty;

            decimal effectiveUtilQty =
                cumulativeUtilQty * child.UtilQty;

            bool hasChildBom =
                preloaded.BOMByParentId.TryGetValue(
                    child.ItemID,
                    out var nextLevelChildren)
                && nextLevelChildren.Any();

            // Has child BOM => Assembly/SubAssembly
            if (hasChildBom)
            {
                ProcessAssemblyRecursive(
                    sourceItem,
                    child.ItemID,
                    childQty,
                    effectiveUtilQty,
                    subItems,
                    preloaded);

                continue;
            }

            // Leaf Component
            if (!_runningItemStock.TryGetValue(
                child.ItemID,
                out var compStock))
            {
                compStock = 0;
            }

            decimal originalCompStock = compStock;

            decimal compDiffQty =
                Math.Max(0, childQty - compStock);

            _runningItemStock[child.ItemID] =
                Math.Max(0, compStock - childQty);

            // First RM only
            CompMasterVM? rm = null;

            if (preloaded.RawMaterialsByComponentId.TryGetValue(
                child.ItemID,
                out var rmList))
            {
                rm = rmList
                    .FirstOrDefault(x => x.RMId.HasValue);
            }

            decimal rmStock = 0;
            decimal rmReqQty = 0;
            decimal rmDiffQty = 0;

            if (rm?.RMId != null)
            {
                _runningItemStock.TryGetValue(
                    rm.RMId.Value,
                    out rmStock);

                rmReqQty =
                    childQty * rm.Weight;

                rmDiffQty =
                    Math.Max(0, rmReqQty - rmStock);

                _runningItemStock[rm.RMId.Value] =
                    Math.Max(0, rmStock - rmReqQty);
            }

            subItems.Add(new MRAPoSubItemsVM
            {
                CustId = sourceItem.CustId ?? 0,
                CustName = sourceItem.custName,

                RefPoSubId = sourceItem.RefPoSubId,
                RefPoId = sourceItem.RefPoId,
                RefPoNo = sourceItem.RefPoNo,
                RefPoDate = sourceItem.RefPoDate,

                AssyCompItemId = child.ItemID,
                AssyCompCode = child.ItemCode,
                AssyCompName = child.ItemName,

                AssyCompUtilityQty = effectiveUtilQty,
                AssyCompReqQty = childQty,

                AssyCompStokQty = originalCompStock,
                AssyCompDiffQty = compDiffQty,

                RMItemId = rm?.RMId,
                RMItemCode = rm?.RMCode,

                RMUtilityQty = rm?.Weight ?? 0,
                RMReqQty = rmReqQty,

                RMStockQty = rmStock,
                RMDiffQty = rmDiffQty,

                Type = sourceItem.Type,
                CostId = sourceItem.CostId,
                ProjectNo = sourceItem.ProjectNo,
                IsLabourMaterial = child.IsLabourMaterial
            });
        }
    }
