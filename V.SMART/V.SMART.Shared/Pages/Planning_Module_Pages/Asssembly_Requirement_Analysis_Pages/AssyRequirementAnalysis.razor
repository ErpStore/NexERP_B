@page "/assemblyReqAnalysis"

@using V.SMART.Shared.ViewModels.PlanningViewModel.AssyReqAnalysisVM

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject IAssemblyRequirementService _assyReqService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js

@if (isProcessing)
{
    <div class="position-fixed top-50 start-50 translate-middle d-flex align-items-center justify-content-center"
         style="width: 100vw; height: 100vh; background-color: rgba(255,255,255,0.5); z-index: 1050;">
        <img src="/_content/V.SMART.Shared/images/loading.gif" alt="Loading..." />
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-lg-5 mt-4">
        <div class="card shadow-sm border-1">
            <PageHeader TitleText="Assembly Requirement Analysis"
                        TitleIcon="bi bi-card-checklist"
                        Breadcrumbs="@AssemblyReqBreadcrumbs" />
            <div class="container-fluid mt-3">        
                <!-- ASSEMBLY SELECTION -->
                <div class="card shadow-sm p-1 mb-3">
                    <div class="card-body">
                        <div class="row g-2 align-items-end">

                            <!-- Assembly -->
                            <div class="col-lg-1">
                                <label class="form-label fw-semibold mb-1">Assembly</label>
                            </div>

                             <div class="col-lg-4">
                                <select class="form-select form-select-sm border-secondary" @onchange="GetSubAssembliesAsync">
                                    <option value="">-- Select Assembly --</option>
                                    @foreach (var a in Assemblies)
                                    {
                                        <option value="@a.ItemId">@a.ItemCode</option>
                                    }
                                </select>
                            </div>

                            <!-- Sub Assembly Checkbox -->
                            <div class="col-lg-3 d-flex align-items-center mb-2">
                                <div class="form-check form-switch text-success">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           @onchange="OnSubAssemblyChanged"/>
                                    <label class="form-check-label fw-semibold">
                                        Sub Assembly
                                    </label>
                                </div>
                            </div>

                             <div class="col-lg-1">
                            </div>

                            <!-- Required Qty -->
                            <div class="col-lg-2 d-flex flex-column flex-lg-row align-items-start align-items-lg-end justify-content-lg-end">
                                <label class="form-label fw-semibold mb-1 mb-lg-0">Required Qty</label>
                            </div>


                            <div class="col-lg-1">
                                <input type="number" class="form-control form-control-sm border-secondary" step="any" value="@RequiredQty" @oninput="OnRequiredQtyChanged" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MAIN CONTENT -->
                <div class="row align-items-stretch">

                    <!-- LEFT TREE -->
                    <div class="col-lg-4 d-flex">
                        <div class="card shadow-sm mb-3 w-100 d-flex flex-column">
                            <div class="card-header fw-semibold bg-danger-subtle">
                                Assembly Structure 
                            </div>

                            <div class="card-body p-2 flex-grow-1 overflow-auto" style="font-size:12px">
                                <ul class="list-group list-group-flush">
                                    @foreach (var node in Tree)
                                    {
                                        <AssemblyTreeNode Node="node"
                                                          SelectedNodeId="SelectedNodeId"
                                                          OnSelect="OnTreeNodeSelected" />
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT GRID -->
                    <div class="col-lg-8 d-flex">
                        <div class="card shadow-sm mb-3 w-100 d-flex flex-column">
                            <div class="card-header bg-primary-subtle d-flex justify-content-between align-items-center">
                                <span class="fw-semibold">
                                    Assembly Requirements
                                </span>

                                <div class="form-check form-switch m-0 text-danger">
                                    <input class="form-check-input" type="checkbox" @onchange="LoadDetailsForSelectedNode" checked="@IsDetails"/>
                                    <label class="form-check-label fw-semibold">
                                        Details
                                    </label>
                                </div>
                            </div>
                            @if (SelectedAssemblyId != null)
                            {
                                <div class="alert alert-warning py-1 mb-2" style="font-size:14px;">
                                    <strong>@(SelectedAssemblyCategory ?? "Assembly") : </strong>

                                    @SelectedAssemblyCode<span class="ms-2 text-muted">@SelectedAssemblyName</span>
                                </div>
                            }

                            <div class="table-responsive  flex-grow-1 overflow-auto">
                                <table class="table table-bordered table-sm text-center align-middle mb-0" style="min-width:800px;">
                                    <thead class="table-info align-middle">
                                        <tr class="text-center fw-semibold" style="font-size:12px;">
                                            @if(IsDetails==false)
                                            {
                                                <th style="width:10px">Level</th>
                                            }
                                            else
                                            {
                                                <th style="width:10px">Order No</th>
                                            }
                                            <th style="width:100px">Item Code</th>
                                            <th style="width:100px">Item Name</th>
                                            <th style="width:10px">UOM</th>
                                            <th style="width:12px">Utility Qty</th>
                                            <th style="width:12px">Req Qty</th>
                                            <th style="width:12px">Rate</th>
                                            <th style="width:15px">Amount</th>
                                            <th style="width:12px">StockQty</th>
                                            <th style="width:15px">Category</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var r in RequirementRows)
                                        {
                                            <tr style="font-size:12px;">
                                                @if (IsDetails == false)
                                                {
                                                   <td class="text-center">@r.Level</td>
                                                }
                                                else
                                                {
                                                   <td class="text-center">@r.OrderNo</td>
                                                }
                                                <td>@r.ItemCode</td>
                                                <td>@r.ItemName</td>
                                                <td>@r.UOM</td>
                                                <td>@r.UtilQty.ToString("F2")</td>
                                                <td>@((r.UtilQty*RequiredQty).ToString("F2"))</td>
                                                <td>@r.Rate.ToString("F2")</td>
                                                <td>@(((r.UtilQty* RequiredQty)*r.Rate).ToString("F2"))</td>
                                                <td>@r.StkQty.ToString("F2")</td>
                                                <td>@r.Category</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- TOTALS -->
                            <div class="card-footer mt-3">
                                <div class="row fw-bold">
                                    <div class="col-12 col-lg-6">
                                        Total Qty : <span style="color:#FF1D8D;">@TotalQty.ToString("F2")</span>
                                    </div>
                                    <div class="col-12 col-lg-6 text-lg-end mt-2 mt-lg-0">
                                        Total Amount : <span style="color:#0000FF;"> ₹ @TotalAmount.ToString("F2")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- ACTIONS -->
                    <div class="mt-2 text-end">
                        <button class="btn btn-outline-success me-2 mb-2">Export Excel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@code {

    #region Declarations and Properties
    protected override string ScreenName => "Assembly Requirement Analysis";
    private bool isProcessing = true;
    public int? SelectedNodeId;
    public int? SelectedAssemblyId;
    public string? SelectedAssemblyCode;
    public string? SelectedAssemblyName;
    public string? SelectedAssemblyCategory;

    public string SelectedAssembly;
    public int RequiredQty = 1;
    public bool IsDetails = false;
    public TreeNode SelectedNode;

    public List<ItemVM> Assemblies = new List<ItemVM>();
    private List<AssemblyDefVM> allAssemblyRows = new List<AssemblyDefVM>();
    private List<TreeNode> Tree=new List<TreeNode>();
    private List<RequirementRow> RequirementRows = new();

    public decimal TotalQty => RequirementRows.Sum(x => x.ReqQty);
    public decimal TotalAmount => RequirementRows.Sum(x => x.Amount);

    private List<PageHeader.BreadcrumbItem> AssemblyReqBreadcrumbs = new()
    {
        new() { Text = "Planning" },
        new() { Text = "Assembly Requirement Analysis", IsLast = true }
    };
    #endregion

    #region Initialization 
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            Assemblies = await _assyReqService.GetAllItemsByCategoryCode(3);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
    #endregion

    #region Get SubAssemblies Async

    public async Task GetSubAssembliesAsync(ChangeEventArgs e)
    {
        try
        {
            int parentItemId = Convert.ToInt32(e.Value);

            RequirementRows = new List<RequirementRow>();
            var selectedAssembly = Assemblies.FirstOrDefault(i => i.ItemId == parentItemId);
            if (selectedAssembly == null)
                return;
            SelectedAssemblyId = selectedAssembly.ItemId;
            SelectedAssemblyCode = selectedAssembly.ItemCode;
            SelectedAssemblyName = selectedAssembly.ItemName;
            SelectedAssemblyCategory = selectedAssembly.CategoryName;
            //Loading the all BOMS Data

            allAssemblyRows = await _assyReqService.GetAllAssemblyItemsAsync();

            Tree = new List<TreeNode>
            {
                new TreeNode
                {
                    Id = parentItemId,
                    ItemCode = selectedAssembly.ItemCode,
                    ItemName = selectedAssembly.ItemName,
                    Level = 1,
                    IsExpanded = false,
                    Children = _assyReqService.BuildBomTree(parentItemId, allAssemblyRows, 2)
                }
            };
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error Occured in GetSubAssembliesAsync");
            await _js.InvokeVoidAsync("alert", "An error occurred in GetSubAssembliesAsync");
        }
    }
    #endregion

    #region On Tree Node Selected

    public async Task OnTreeNodeSelected(TreeNode node)
    {
        try
        {
            //node.IsExpanded = true;
            SelectedNodeId = node.Id;
            SelectedAssemblyCode = node.ItemCode;
            SelectedAssemblyName = node.ItemName;
            SelectedAssemblyCategory = node.Category;
            SelectedNode = node;
            await LoadGridForSelectedNode(node.Id,node);
        }
        catch(Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnTreeNodeSelected failed.");
            await _js.InvokeVoidAsync("alert", "An error occurred in OnTreeNodeSelected");
        }
    }
   
    public async Task LoadGridForSelectedNode(int parentItemId,TreeNode node)
    {
        try
        {
            IsDetails = false; 

            var itemIds = allAssemblyRows.Where(x => x.AssmblyID == parentItemId)
                            .Select(x => x.ItemId ?? 0)
                            .Distinct()
                            .ToList();

            // Dictionary<int, decimal>
            var rateDict = await _assyReqService.GetItemRatesByItemIdsAsync(itemIds);

            var stockDict = await _assyReqService.GetStockForItemsAsync(itemIds, 1);

            RequirementRows = allAssemblyRows.Where(x => x.AssmblyID == parentItemId)
                            .Select(x => new RequirementRow
                            {
                                Level = node.Level,
                                ItemCode = x.PartItemCode ?? String.Empty,
                                ItemName = x.PartItemCode ?? String.Empty,
                                UOM = x.UOM ?? String.Empty,
                                UtilQty = x.UtilQty ?? 0,
                                ReqQty = x.UtilQty * RequiredQty ?? 0,
                                Rate = rateDict.GetValueOrDefault(x.ItemId ?? 0),
                                StkQty = stockDict.GetValueOrDefault(x.ItemId ?? 0),
                                Amount = rateDict.GetValueOrDefault(x.ItemId ?? 0) * (x.UtilQty??0) * RequiredQty,
                                Category = x.CategoryName ?? String.Empty
                            }).ToList();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadGridForSelectedNode failed.");
            await _js.InvokeVoidAsync("alert", "An error occurred in LoadGridForSelectedNode");
        }
    }
    #endregion

    #region Load Details For Selected Node

    public async Task LoadDetailsForSelectedNode(ChangeEventArgs e)
    {
        try
        {
            IsDetails = Convert.ToBoolean(e.Value);
            if (IsDetails == true)
            {
                RequirementRows.Clear();

                if (SelectedNode == null)
                    return;
                SelectedNode.OrderNo = "1";
                await AddNodeToGrid(SelectedNode, RequiredQty, SelectedNode.OrderNo);
            }
            else
            {
                RequirementRows.Clear();
                await OnTreeNodeSelected(SelectedNode);
            }
        }
        catch(Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadDetailsForSelectedNode failed.");
            await _js.InvokeVoidAsync("alert", "An error occurred in LoadDetailsForSelectedNode");
        }
    }

    public async Task AddNodeToGrid(TreeNode node, decimal requiredQty, string parentOrderNo)
    {
        try
        {
            var itemIds = allAssemblyRows
                .Where(x => x.AssmblyID == node.Id)
                .Select(x => x.ItemId ?? 0)
                .Distinct()
                .ToList();

            var rateDict = await _assyReqService.GetItemRatesByItemIdsAsync(itemIds);
            var stockDict = await _assyReqService.GetStockForItemsAsync(itemIds, 1);

            int subAssemblyIndex = 1;

            foreach (var row in allAssemblyRows.Where(x => x.AssmblyID == node.Id))
            {
                var itemId = row.ItemId ?? 0;
                var utilQty = row.UtilQty ?? 0;

                string orderNo = node.Level == 1
                    ? subAssemblyIndex.ToString()              // 1, 2, 3
                    : $"{parentOrderNo}.{subAssemblyIndex}";   // 1.1, 2.1

                subAssemblyIndex++;

                RequirementRows.Add(new RequirementRow
                {
                    OrderNo = orderNo,
                    Level = node.Level + 1,
                    ItemCode = row.PartItemCode,
                    ItemName = row.PartItemName,
                    UOM = row.UOM,
                    UtilQty = utilQty,
                    ReqQty = utilQty * requiredQty,
                    Rate = rateDict.GetValueOrDefault(itemId),
                    StkQty = stockDict.GetValueOrDefault(itemId),
                    Amount = rateDict.GetValueOrDefault(itemId) * utilQty * requiredQty,
                    Category = row.CategoryName
                });

                // recurse for children
                var childNode = node.Children.FirstOrDefault(c => c.Id == itemId);
                if (childNode != null)
                    await AddNodeToGrid(childNode, utilQty * requiredQty, orderNo);
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "AddNodeToGrid failed.");
            await _js.ToastrWarning("An error occurred while adding node to grid.");
        }
    }
    #endregion

    #region On Required Qty Changed

    private async Task OnRequiredQtyChanged(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var qty))
                return;

            RequiredQty = qty;

            if (IsDetails && SelectedNode != null)
            {
                RequirementRows.Clear();
                SelectedNode.OrderNo = "1";
                await AddNodeToGrid(SelectedNode, RequiredQty, "1");
            }
            else if (SelectedNode != null)
            {
                await LoadGridForSelectedNode(SelectedNode.Id, SelectedNode);
            }

            StateHasChanged();
        }
        catch(Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnRequiredQtyChanged failed.");
            await _js.InvokeVoidAsync("alert", "An error occurred while changing required quantity.");
        }
    }
    #endregion

    #region On Sub Assembly Changed

    public async Task OnSubAssemblyChanged(ChangeEventArgs e)
    {
        try
        {
            RequirementRows = new List<RequirementRow>();
            Tree = new List<TreeNode>();
            bool IsAssemblies = Convert.ToBoolean(e.Value);
            if (IsAssemblies == false)
            {
                Assemblies = await _assyReqService.GetAllItemsByCategoryCode(3);
            }
            else
            {
                Assemblies = await _assyReqService.GetAllItemsByCategoryCode(7);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnSubAssemblyChanged failed.");
            await _js.InvokeVoidAsync("alert", "An error occurred while changing assembly type.");
        }
    }
    #endregion

}

