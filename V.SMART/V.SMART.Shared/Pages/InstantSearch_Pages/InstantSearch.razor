    private string InstantSearchTitle => "Instant Search";

    private List<PageHeader.BreadcrumbItem> instantSearchBreadcrumbs =
    [
        new PageHeader.BreadcrumbItem { Text = "Instant Search", IsLast = true }
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await LoadScreens();
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task LoadScreens()
    {
        screens = await commonService.GetAllScreenAsync();

        if (!string.IsNullOrEmpty(Screen))
        {
            var screenObj = screens.FirstOrDefault(x =>
                x.ScreenName.Equals(Screen, StringComparison.OrdinalIgnoreCase));

            if (screenObj != null)
            {
                selectedScreenId = screenObj.ScreenCode;
                parentScreenName = screenObj.ScreenName;
                await LoadSearchFieldsByScreenName(Screen);
            }
        }
    }


    private async Task OnScreenChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            selectedScreenId = id;

            var selected = screens.FirstOrDefault(x => x.ScreenCode == id);

            if (selected != null)
            {
                // If coming from modal and screen changed → modal mode off
                if (isModelVisible && parentScreenName != selected.ScreenName)
                {
                    isModelVisible = false;
                }

                await LoadSearchFieldsByScreenName(selected.ScreenName);
            }
        }
    }


