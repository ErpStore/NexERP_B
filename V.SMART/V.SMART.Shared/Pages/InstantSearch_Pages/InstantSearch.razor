    private async Task Search()
    {
        try
        {
            // Build filters
            var filterDict = new Dictionary<string, object>();

            foreach (var f in DynamicFields)
            {
                var val = f.GetValueAsString();

                if (!string.IsNullOrWhiteSpace(val))
                {
                    filterDict[f.Key] = val;

                }
                
            }

            var selected = screens.FirstOrDefault(x => x.ScreenCode == selectedScreenId);
            if (selected == null)
                return;

            string route = selected.ScreenName switch
            {

                var s when s.Contains("User", StringComparison.OrdinalIgnoreCase) => "user",
                var s when s.Contains("User Level Authorization", StringComparison.OrdinalIgnoreCase) => "userLevelAuthorization",

                //Inventory
                var s when s.Contains("Item", StringComparison.OrdinalIgnoreCase) => "itemList",

                var s when s.Contains("Store", StringComparison.OrdinalIgnoreCase) => "stores",
                var s when s.Contains("HSN Master", StringComparison.OrdinalIgnoreCase) => "hsnMaster",
                var s when s.Contains("BOM", StringComparison.OrdinalIgnoreCase) => "bomList",
                var s when s.Contains("BOM Labour", StringComparison.OrdinalIgnoreCase) => "bomLabourList", 
                var s when s.Contains("Process", StringComparison.OrdinalIgnoreCase) => "processList",
                var s when s.Contains("Factors", StringComparison.OrdinalIgnoreCase) => "factorlist",
                var s when s.Contains("Grouping", StringComparison.OrdinalIgnoreCase) => "groupingList",

                //General
                var s when s.Contains("Customer", StringComparison.OrdinalIgnoreCase) => "customer",
                var s when s.Contains("Vendor", StringComparison.OrdinalIgnoreCase) => "vendor",
                var s when s.Contains("Machine", StringComparison.OrdinalIgnoreCase) => "machineList",
                var s when s.Contains("Terms and Conditions", StringComparison.OrdinalIgnoreCase) => "terms-and-conditions",
                var s when s.Contains("Contract Review", StringComparison.OrdinalIgnoreCase) => "contractReviewMasterList",

                //Accounts
                var s when s.Contains("Expense", StringComparison.OrdinalIgnoreCase) => "expense",
                var s when s.Contains("Income", StringComparison.OrdinalIgnoreCase) => "income",
                var s when s.Contains("Currency", StringComparison.OrdinalIgnoreCase) => "currency",
                var s when s.Contains("Cost-Center", StringComparison.OrdinalIgnoreCase) => "costcenter",

                //Human Resource Service
                var s when s.Contains("LeaveType", StringComparison.OrdinalIgnoreCase) => "leaveType",
                var s when s.Contains("Employee Leave Balance", StringComparison.OrdinalIgnoreCase) => "employeeLeaveBalance",
                var s when s.Contains("Shift Allocation", StringComparison.OrdinalIgnoreCase) => "shiftAllocation",
                var s when s.Contains("Staff", StringComparison.OrdinalIgnoreCase) => "Staff",

                // Sales And Labour
                var s when s.Contains("Enquiry Sales", StringComparison.OrdinalIgnoreCase) => "enquirySales",
                var s when s.Contains("Enquiry Feasibility", StringComparison.OrdinalIgnoreCase) => "enquiryfeasibility",
                var s when s.Contains("Manufacturing Quotation", StringComparison.OrdinalIgnoreCase) => "mfgQuoteList",
                var s when s.Contains("Sales Order", StringComparison.OrdinalIgnoreCase) => "mfgPOList",
                var s when s.Contains("Contract Review CheckList", StringComparison.OrdinalIgnoreCase) => "contractReviewCheckList",
                var s when s.Contains("Performa Invoice", StringComparison.OrdinalIgnoreCase) => "PerformaInvList",

                var s when s.Contains("Labour GRN", StringComparison.OrdinalIgnoreCase) => "labourGRNList",
                var s when s.Contains("Labour SCN", StringComparison.OrdinalIgnoreCase) => "labourSCNList",
                var s when s.Contains("Labour Delivery Challan", StringComparison.OrdinalIgnoreCase) => "labourDcoutgoingList",
                var s when s.Contains("Labour Invoice", StringComparison.OrdinalIgnoreCase) => "LabourInvoiceList",



                var s when s.Contains("Stock-Add", StringComparison.OrdinalIgnoreCase) => "scnGenList",

                var s when s.Contains("Category", StringComparison.OrdinalIgnoreCase) => "Category",
                var s when s.Contains("Job Order", StringComparison.OrdinalIgnoreCase) => "jobOrderList",
                var s when s.Contains("Production Issue WO Assembly", StringComparison.OrdinalIgnoreCase) => "productionIssueList",
                var s when s.Contains("Production Return GRN Assembly", StringComparison.OrdinalIgnoreCase) => "productionReturnAssyList",

                var s when s.Contains("Enquiry Purchase", StringComparison.OrdinalIgnoreCase) => "EnquiryPurchase",
                var s when s.Contains("Purchase-Quotation", StringComparison.OrdinalIgnoreCase) => "purchaseQuoteList",
                var s when s.Contains("Purchase Order", StringComparison.OrdinalIgnoreCase) => "PurchPOList",
                var s when s.Contains("Purchase Invoice", StringComparison.OrdinalIgnoreCase) => "purchaseInvoiceList",
                var s when s.Contains("Purchase SCN", StringComparison.OrdinalIgnoreCase) => "purchaseSCNList",
                var s when s.Contains("Purchase GRN", StringComparison.OrdinalIgnoreCase) => "purchaseGRNList",


                var s when s.Contains("Route Card", StringComparison.OrdinalIgnoreCase) => "routeCardList",
                var s when s.Contains("Invoice", StringComparison.OrdinalIgnoreCase) => "Invoice",

                var s when s.Contains("Mfg Invoice", StringComparison.OrdinalIgnoreCase) => "mfgInvList",
                var s when s.Contains("Export Invoice", StringComparison.OrdinalIgnoreCase) => "expInvList",
                var s when s.Contains("Mfg Dc", StringComparison.OrdinalIgnoreCase) => "mfgDcList",
                var s when s.Contains("Credit Note", StringComparison.OrdinalIgnoreCase) => "creditNoteList",

                var s when s.Contains("Sub-Contract DC-Out", StringComparison.OrdinalIgnoreCase) => "subConDcOutList",

                var s when s.Contains("Sub-Contract SCN", StringComparison.OrdinalIgnoreCase) => "subConScnList",

                var s when s.Contains("Sub-Contrect GRN", StringComparison.OrdinalIgnoreCase) => "subConGrnList",

                var s when s.Contains("Sub-Contract Invoice", StringComparison.OrdinalIgnoreCase) => "subConInvList",

                var s when s.Contains("Daily Production Log", StringComparison.OrdinalIgnoreCase) => "productionLogList",

                var s when s.Contains("Tool-Crib Return", StringComparison.OrdinalIgnoreCase) => "tcReturnList",

                var s when s.Contains("Tool-Crib Issue", StringComparison.OrdinalIgnoreCase) => "tcIssueList",

                var s when s.Contains("Estimation", StringComparison.OrdinalIgnoreCase) => "Estimation",//Estmation


                var s when s.Contains("Receipts", StringComparison.OrdinalIgnoreCase) => "ReceiptList",

                var s when s.Contains("Payments", StringComparison.OrdinalIgnoreCase) => "PaymentList",


                _ => selected.ScreenName
            };

            //===============Don't Touch This Code this Search getting By Multiple Ways==========================

            // CASE 1: Modal + same parent screen → return filter data
            if (isModelVisible && parentScreenName == selected.ScreenName && OnSearch.HasDelegate)
            {
                await OnSearch.InvokeAsync(filterDict);
                await OnClose.InvokeAsync();
                return;
            }

            // CASE 2: Modal but screen changed → open full navigation
            if (isModelVisible && parentScreenName != selected.ScreenName)
            {
                isModelVisible = false;
            }

            // NAVIGATION
            var json = JsonSerializer.Serialize(filterDict);
            var encoded = Uri.EscapeDataString(json);

            _navigation.NavigateTo($"{route}?filter={encoded}", false);

            if (isModelVisible)
                await OnClose.InvokeAsync();

            //===============Don't Touch This Code ==========================
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error executing search");
            await _js.ToastrError("Search failed.");
        }
    }
