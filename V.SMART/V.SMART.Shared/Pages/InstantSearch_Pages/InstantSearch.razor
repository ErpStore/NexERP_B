@page "/instantSearch"

@using V.SMART.Shared.Data.Master.MasterScreeenManagement
@using System.Text.Json
@using V.SMART.Shared.ViewModels.InstantSerchViewModel

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService _userService
@inject IJSRuntime _js
@inject NavigationManager _navigation
@inject ICommonService commonService

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    if (!CanView)
    {
        <RedirectToLogin />
        return;
    }

    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-0 rounded-3">

            @if (!isModelVisible)
            {
                <PageHeader TitleText="@InstantSearchTitle"
                            TitleIcon="bi bi-search"
                            Breadcrumbs="@instantSearchBreadcrumbs" />
            }

            <div class="card-body p-3 p-md-4">

                <!-- Screen Selection -->
                <div class="row mb-3">
                    <div class="col-12 col-md-6">
                        <div class="p-3 border rounded-3 shadow-sm bg-white">

                            <label class="form-label fw-bold text-secondary mb-2">
                                <i class="bi bi-ui-checks-grid me-1"></i> Select Screen
                            </label>

                            <select class="form-select fw-semibold"
                                    value="@selectedScreenId"
                                    @onchange="OnScreenChanged">
                                <option value="0" disabled>Select Screen</option>
                                @foreach (var s in screens)
                                {
                                    <option value="@s.ScreenCode">@s.ScreenName</option>
                                }
                            </select>

                        </div>
                    </div>

                    <!-- Search Button -->
                    
                        <div class="col-12 col-md-4 mt-1">
                            <button class="btn btn-primary w-100 shadow-sm" @onclick="Search">
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    

                </div>

                <!-- Dynamic Fields -->
                @if (DynamicFields.Any())
                {
                    <div>
                        <h5 class="fw-bold mb-3 text-primary">
                            <i class="bi bi-funnel"></i> Search Filters
                        </h5>

                        <div class="row g-3">

                            @foreach (var field in DynamicFields)
                            {
                                var id = $"fld_{field.Label.Replace(" ", "")}";

                                <div class="col-12 col-sm-6">

                                    @if (field.Type == "bool")
                                    {
                                        <!-- Checkbox -->
                                        <div class="form-check mt-4">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   id="@id"
                                                   @bind="field.BoolValue" />

                                            <label class="form-check-label" for="@id">
                                                @field.Label
                                            </label>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Floating Label -->
                                        <div class="form-floating shadow-sm">

                                            @switch (field.Type)
                                            {
                                                case "text":
                                                    <TrimmedInputText id="@id"
                                                                      CssClass="form-control rounded-3"
                                                                      placeholder="@field.Label"
                                                                      @bind-value="field.Value" />
                                                    break;

                                                case "number":
                                                    <input type="number"
                                                           id="@id"
                                                           class="form-control rounded-3"
                                                           placeholder="@field.Label"
                                                           @bind="field.NumberValue" />
                                                    break;

                                                case "date":
                                                    <input type="date"
                                                           id="@id"
                                                           class="form-control rounded-3"
                                                           placeholder="@field.Label"
                                                           @bind="field.DateValue" />
                                                    break;

                                                case "dropdown":
                                                    <select id="@id"
                                                            class="form-select rounded-3"
                                                            @bind="field.DropdownValue">
                                                        <option value=""></option>
                                                        @foreach (var opt in field.Options)
                                                        {
                                                            <option value="@opt">@opt</option>
                                                        }
                                                    </select>
                                                    break;
                                            }

                                            <label for="@id">@field.Label</label>
                                        </div>
                                    }
                                </div>
                            }

                        </div>


                       @*  <!-- Search Button -->
                        <div class="row mt-4">
                            <div class="col-12 col-md-4">
                                <button class="btn btn-primary w-100 shadow-sm" @onclick="Search">
                                    <i class="bi bi-search"></i> Search
                                </button>
                            </div>
                        </div> *@

                    </div>
                }


            </div>
        </div>
    </div>
}

@code {

    protected override string ScreenName => "Instant Search";

    [Parameter, SupplyParameterFromQuery] public string? Screen { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Dictionary<string, object>> OnSearch { get; set; }

    [Parameter] public bool isModelVisible { get; set; } = false;
    [Parameter] public Dictionary<string, object>? Filters { get; set; }

    private bool isProcessing = true;
    private int selectedScreenId;
   

    private string? parentScreenName;
    private List<Screens> screens = new();
