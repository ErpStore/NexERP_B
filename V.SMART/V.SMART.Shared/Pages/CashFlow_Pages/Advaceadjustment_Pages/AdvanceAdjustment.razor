    private async Task GenerateQR()
    {
        decimal amount = AdvaceadjustmentVMs.Amount;
        if (amount <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Enter valid amount first");
            return;
        }

        var bank = await _unitOfWork.Banks
                  .GetQueryable()
                  .FirstOrDefaultAsync(x => x.BankId == AdvaceadjustmentVMs.BankId);
        if (bank != null)
        {
            string upiId = bank.UpiId;
            string name = bank.UpiName;
            string note = BillNote;
            if (!string.IsNullOrEmpty(upiId) && !string.IsNullOrEmpty(name) && AdvaceadjustmentVMs.AdjumentId > 0)
            {

                byte[] qrBytes = UpiQrService.GenerateUpiQr(upiId, name, amount, note);
                QrImage = Convert.ToBase64String(qrBytes);
                await Task.CompletedTask;

            }
            else
            {
                JS.ToastrError($"Bank valid UPI Id And Name And Save Bill : {banks.BankName}");

            }

        }
    }

