    public async Task EnforceAdjustmentLimit()
    {
        decimal runningTotal = 0;

        foreach (var row in AdvaceadjustmentVMs.AdvaceadjustmentSubVM)
        {
            var allowed = AdvaceadjustmentVMs.Amount - runningTotal;

            if (allowed <= 0)
            {
                row.AdjustAmount = 0;
            }
            else if (row.AdjustAmount > allowed)
            {
                row.AdjustAmount = allowed; // 🔒 force reduce
                await JS.ToastrWarning("Amount exceeds Bill balance. Adjusted to maximum allowed.");
            }

            runningTotal += row.AdjustAmount;
        }
        AdvaceadjustmentVMs.Amount = runningTotal;
        StateHasChanged();
    }

    public async Task AutoAdjust()
    {
        if (!IsBillAdjustmentAllowed || SelectedParty == null)
            return;

        decimal originalPaymentAmount = AdvaceadjustmentVMs.Amount;

        if (AdvaceadjustmentVMs.PaymentTypeName == "Automatic Adjust")
        {

            originalPaymentAmount = Bills.Sum(b => b.Balance);
        }
        decimal adjustedAmount = originalPaymentAmount;
        decimal? availableBankBalance = 0;

        // 🔥 2. TOTAL BILL BALANCE CHECK NEXT
        var pendingBills = Bills
            .Where(b => b.PartyCode == SelectedParty.PartyCode && b.Balance > 0)
            .OrderBy(b => b.BillDate)
            .ThenBy(b => b.Id)
            .ToList();

        decimal totalBillBalance = pendingBills.Sum(b => b.Balance);

        // 🔥 3. ADJUST BILLS (Before Save OR Edit Mode)
        decimal remaining = adjustedAmount;

        if (AdvaceadjustmentVMs.AdjumentId == 0) // ➤ NEW payment (before save)
        {

            if (totalBillBalance > adjustedAmount)
            {
                totalBillBalance = adjustedAmount;
                AdvaceadjustmentVMs.Amount = adjustedAmount;
                await JS.ToastrError($"Payment reduced to Total Bill Balance: {adjustedAmount}");
            }
            if (adjustedAmount > SelectedParty.AdvancePaid)
            {
                AdvaceadjustmentVMs.Amount = SelectedParty.AdvancePaid;
                remaining = AdvaceadjustmentVMs.Amount;
                await JS.ToastrError($"Party Advance reduce to Total Advance Balance: {SelectedParty.AdvancePaid}");
            }
            AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Clear();

            foreach (var b in pendingBills)
            {
                if (remaining <= 0) break;

                var adj = Math.Min(b.Balance, remaining);

                AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Add(new AdvaceadjustmentSubVM
                {
                    AdjustSubId = 0,
                    RefId = b.Id,
                    BillNo = b.BillNo,
                    BillDate = b.BillDate,
                    BalanceAmount = b.Balance,
                    SavedAdjustAmount = 0,
                    AdjustAmount = adj
                });

                remaining -= adj;
            }
        }
        else
        {
            foreach (var sub in AdvaceadjustmentVMs.AdvaceadjustmentSubVM.OrderBy(x => x.BillDate))
            {
                decimal savedAdj = await _AdvanceAdjustService
                    .GetAdvaceAdjustSubAmountByIdAsync(sub.AdjustSubId);

                var realBill = pendingBills.FirstOrDefault(b => b.Id == sub.RefId);
                decimal realBalance = realBill?.Balance ?? 0;

                // TOTAL BILL (constant)
                decimal billTotal = savedAdj + realBalance;

                // PARTY ADVANCE LIMIT
                if (adjustedAmount > (SelectedParty.AdvancePaid + savedAdj))
                {
                    AdvaceadjustmentVMs.Amount = SelectedParty.AdvancePaid;
                    remaining = AdvaceadjustmentVMs.Amount;

                    await JS.ToastrError(
                        $"Party Advance reduced to Total Advance Balance: {SelectedParty.AdvancePaid}"
                    );
                }

                // DISTRIBUTE
                decimal newAdjust = sub.AdjustAmount;

                if (remaining > 0)
                {
                    newAdjust = Math.Min(billTotal, remaining);
                }
                else
                {
                    newAdjust = savedAdj; // keep old
                }

                // CLAMP
                if (newAdjust > billTotal)
                    newAdjust = billTotal;

                if (newAdjust < 0)
                    newAdjust = 0;

                // APPLY
                sub.SavedAdjustAmount = savedAdj;
                sub.AdjustAmount = newAdjust;

                // 🔥 KEY LINE — BALANCE FROM TOTAL
                sub.BalanceAmount = billTotal - newAdjust;

                // 🔥 REDUCE ONLY NEW PART
                decimal newPortion = newAdjust - savedAdj;
                if (newPortion > 0)
                    remaining -= newPortion;
            }

            // foreach (var sub in AdvaceadjustmentVMs.AdvaceadjustmentSubVM.OrderBy(x => x.BillDate))
            // {

            //     decimal savedAdj = await _AdvanceAdjustService.GetAdvaceAdjustSubAmountByIdAsync(sub.AdjustSubId);


            //     var realBill = pendingBills.FirstOrDefault(b => b.Id == sub.RefId);
            //     decimal realBalance = realBill?.Balance ?? 0;

            //     decimal RealAdvancepaid = SelectedParty.AdvancePaid;


            //     decimal originalBillAmount = savedAdj + realBalance;
            //     decimal OriginalAmountAsdvace = savedAdj + RealAdvancepaid;




            //     if (sub.AdjustAmount > originalBillAmount)
            //     {
            //         await JS.ToastrError($"Bill {sub.BillNo}: Adjust exceeds original bill amount");
            //         sub.AdjustAmount = originalBillAmount;
            //     }

            //     if (adjustedAmount > OriginalAmountAsdvace)
            //     {
            //         AdvaceadjustmentVMs.Amount = OriginalAmountAsdvace;
            //         remaining = AdvaceadjustmentVMs.Amount;
            //         await JS.ToastrError($"Party Advance reduce to Total Advance Balance: {SelectedParty.AdvancePaid}");
            //     }
            //     if (remaining > 0)
            //     {
            //         var adj = Math.Min(realBalance + savedAdj, remaining);
            //         sub.SavedAdjustAmount = savedAdj;
            //         sub.BalanceAmount = originalBillAmount;
            //         sub.AdjustAmount = adj;
            //         remaining -= adj;
            //     }
            //     else
            //     {

            //         sub.SavedAdjustAmount = savedAdj;
            //         sub.BalanceAmount = realBalance;
            //         sub.AdjustAmount = savedAdj;
            //     }
            // }
        }
        decimal finalTotalAdjust = AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Sum(x => x.AdjustAmount);

        if (finalTotalAdjust == 0)
        {
            await JS.ToastrError("No pending bills available for adjustment");
            AdvaceadjustmentVMs.Amount = 0;
            return;
        }

        AdvaceadjustmentVMs.Amount = finalTotalAdjust;
        await FilterBills(); // refresh bill lists

        ActiveTab = TAB_LINKED;
        AdvaceadjustmentVMs.AdvaceadjustmentSubVM = AdvaceadjustmentVMs.AdvaceadjustmentSubVM.ToList();
        await EnforceAdjustmentLimit();
        StateHasChanged();
    }


