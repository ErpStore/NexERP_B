    private string ExpenseTypeNormalized =>
    SelectedExpenseType?.Trim().ToUpper() ?? "";

    private string PaymentTypeNormalized =>
     PaymentType?.Trim().ToUpper() ?? "";


    bool IsBillAdjustmentAllowed
    {
        get
        {
            var expense = ExpenseTypeNormalized;
            var payment = PaymentTypeNormalized;

            // Opening balance → never
            if (payment == "OPENING BALANCE")
                return false;

            // PO / Subcontract Advance → show ORDER bills
            if (expense == "PURCHASE ORDER ADVANCE" ||
                expense == "SUBCONTRACT ORDER ADVANCE")
            {
