    public async Task FilterBills()
    {
        if (SelectedParty == null)
        {
            FilteredBills.Clear();
            return;
        }

        var search = BillSearch?.Trim().ToLowerInvariant() ?? "";
        var linkedIds = AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Select(x => x.RefId).ToHashSet();

        var linkedBills = Bills.Where(b => linkedIds.Contains(b.Id)).ToList();

        var unlinkedBills = Bills
            .Where(b => b.PartyCode == SelectedParty.PartyCode && !linkedIds.Contains(b.Id))
            .Where(b => string.IsNullOrEmpty(search) ||
                        b.BillNo.ToLowerInvariant().Contains(search) ||
                        b.Id.ToString().Contains(search))
            .OrderByDescending(b => b.BillDate)
            .ThenBy(b => b.BillNo)
            .ToList();
        if (AdvaceadjustmentVMs.AdjumentId > 0)
        {
            if (AdvaceadjustmentVMs.AdjumentId > 0)
            {
                foreach (var bill in linkedBills)
                {
                    var rows = AdvaceadjustmentVMs.AdvaceadjustmentSubVM
                        .Where(x => x.RefId == bill.Id)
                        .ToList();   // get ALL rows for same bill

                    foreach (var row in rows)
                    {
                        if (row.AdjustSubId > 0)
                        {
                            decimal savedAdj = await _AdvanceAdjustService
                                .GetAdvaceAdjustSubAmountByIdAsync(row.AdjustSubId);

                            decimal realBal = bill.Balance;

                            decimal originalBillAmount = savedAdj + realBal;

                            row.BalanceAmount = originalBillAmount; // correct balance for each row

                            if (row.AdjustAmount > originalBillAmount)
                            {
                                row.AdjustAmount = originalBillAmount;
                                await JS.ToastrError($"Bill {row.BillNo}: Adjust exceeds original bill amount!");
                            }
                        }
                        else
                        {
                            row.BalanceAmount = bill.Balance; // if no saved adjustment
                        }
                    }
                }
            }

        }


        if (!linkedBills.Any() && !unlinkedBills.Any() && AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Any())
        {
            foreach (var row in AdvaceadjustmentVMs.AdvaceadjustmentSubVM)
            {
                row.BalanceAmount = row.AdjustAmount;
            }
        }

        FilteredBills = unlinkedBills;
        ActiveTab = TAB_BILLS;

        StateHasChanged();
    }



