    private async Task LoadExistingPaymnets(int paymentId)
    {
        try
        {
            isProcessing = true;
            StateHasChanged();

            AdvaceadjustmentVMs = await _AdvanceAdjustService.GetAdvaceAdjustsByIdAsync(paymentId);

            if (AdvaceadjustmentVMs == null)
            {
                await JS.ToastrWarning("Payment not found.");
                return;
            }

            if (AdvaceadjustmentVMs.PayToRefCode.HasValue && AdvaceadjustmentVMs.PayToRefCode > 0)
            {
                if (!AdvaceadjustmentVMs.IsIncome)
                {
                    var vendor = await _PaymentsService.GetVendorByIdAsync(AdvaceadjustmentVMs.PayToRefCode.Value);
                    if (vendor != null)
                    {
                        SelectedParty = PartyMapper.FromVendor(vendor);

                        PartySearch = SelectedParty.PartyName;
                        await LoadBillsPending(SelectedParty.PartyCode, AdvaceadjustmentVMs.ExpenseName);
                        SelectedExpenseType = AdvaceadjustmentVMs.ExpenseName;
                        await LoadPaymentTypes(AdvaceadjustmentVMs.ExpenseName);
                        var paymentType = PaymentTypeList.FirstOrDefault(pt =>
                            pt.PaymentTypeName == AdvaceadjustmentVMs.PaymentTypeName);
                        SelectedPaymentTypeId = paymentType?.PaymentTypeId ?? 0;

                        SelectedParty.AdvancePaid = await _PaymentsService.GetAdvanceAmountPaid(SelectedExpenseType, paymentType.PaymentTypeName, AdvaceadjustmentVMs.PayToRefCode.Value);
                        await FilterBills();
                    }
                }
                else
                {
                    var customer = await _ReceiptsService.GetCustomerByIdAsync(AdvaceadjustmentVMs.PayToRefCode.Value);
                    if (customer != null)
                    {
                        SelectedParty = PartyMapper.FromCustomer(customer);

                        PartySearch = SelectedParty.PartyName;
                        await LoadBillsPendings(SelectedParty.PartyCode, AdvaceadjustmentVMs.IncomeName ?? "");
                        SelectedExpenseType = AdvaceadjustmentVMs.IncomeName ?? "";
                        await LoadReceiptsTypes(AdvaceadjustmentVMs.IncomeName ?? "");
                        var paymentType = PaymentTypeList.FirstOrDefault(pt =>
                        pt.PaymentTypeName == AdvaceadjustmentVMs.PaymentTypeName);
                        SelectedPaymentTypeId = paymentType?.PaymentTypeId ?? 0;

                        SelectedParty.AdvancePaid = await _ReceiptsService.GetAdvanceAmountPaid(SelectedExpenseType, paymentType?.PaymentTypeName ?? "", AdvaceadjustmentVMs.PayToRefCode.Value);
                        await FilterBills();
                    }

                }


            }

            IsBank = AdvaceadjustmentVMs.BankId > 0;

            PaymentType = AdvaceadjustmentVMs.PaymentTypeName ?? "Manual Selection";

            if (IsBillAdjustmentAllowed)
            {
                if (PaymentType == "Automatic Adjust")
                    await AutoAdjust();
                else
                    await FilterBills();
            }

            ActiveTab = TAB_LINKED;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.ToastrError("Failed to load payment details.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingPayments failed for AdjumentId: {paymentId}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
    private async Task HandleBackClick()
    {
        if (AdvaceadjustmentVMs.AdjumentId > 0 && IsBillAdjustmentAllowed && AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Count == 0)
