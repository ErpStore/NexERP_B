    private async Task ExpenseSearchChanged(ChangeEventArgs e)
    {
        ExpenseSearch = e.Value?.ToString() ?? "";
        AdvaceadjustmentVMs.ExpenseName = ExpenseSearch;
        ShowExpenseDropdown = !string.IsNullOrWhiteSpace(ExpenseSearch);
        PartyListDisplay.Clear();
        AllPartys.Clear();
        PartySearch = "";
        if (ShowExpenseDropdown)
        {
            FilteredExpenses = expense
                .Where(exp => exp.ExpenseName.Contains(ExpenseSearch, StringComparison.OrdinalIgnoreCase))
                .Take(10)
                .ToList();
        }
        else
        {
            FilteredExpenses.Clear();
            PartyListDisplay.Clear();
            SelectedExpenseType = "";
            PartySearch = "";
            AdvaceadjustmentVMs.Amount = 0;
            PaymentTypeList.Clear();
            Bills.Clear();


        }

        StateHasChanged();
    }

