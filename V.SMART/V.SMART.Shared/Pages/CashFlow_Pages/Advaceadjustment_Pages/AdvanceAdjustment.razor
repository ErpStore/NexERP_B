    public async Task ValidateBillAdjust(ChangeEventArgs e, AdvaceadjustmentSubVM bill)
    {

        if (!decimal.TryParse(e.Value?.ToString(), out var input)) return;

        bill.AdjustAmount = input;

        if (!decimal.TryParse(e.Value?.ToString(), out decimal newAdj))
            return;

        bill.AdjustAmount = newAdj;

        if (bill.AdjustSubId > 0)
        {
            decimal savedAdj = bill.SavedAdjustAmount;
            decimal realBalance = bill.BalanceAmount;
            decimal originalBillAmount = savedAdj + realBalance;

            if (newAdj + savedAdj > originalBillAmount)
            {
                JS.ToastrError($"Adjustment exceeds bill amount. Max allowed: {originalBillAmount - savedAdj}");
                bill.AdjustAmount = originalBillAmount - savedAdj;
            }
        }

        if (bill.AdjustAmount > bill.BalanceAmount)
        {
            bill.AdjustAmount = bill.BalanceAmount;
            await JS.ToastrWarning("Amount exceeds Bill balance. Adjusted to maximum allowed.");
        }

        if (bill.AdjustAmount < 0)
            bill.AdjustAmount = 0;

        var totalAdjusted = AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Sum(x => x.AdjustAmount);

        if (PaymentType == "Manual Selection")
        {
            if (bill.AdjustSubId == 0)
            {
                if (totalAdjusted > SelectedParty.AdvancePaid)
                    AdvaceadjustmentVMs.Amount = SelectedParty.AdvancePaid;
            }

        }
        else if (PaymentType == "OPENING BALANCE")
        {
            if (AdvaceadjustmentVMs.Amount > PartyVMs.OpeningBalancePending)
            {
                await JS.ToastrWarning("Amount exceeds pending opening balance. Adjusted to maximum allowed.");

                AdvaceadjustmentVMs.Amount = PartyVMs.OpeningBalancePending;
                StateHasChanged();
                return;
            }

        }
        else
        {

            if (totalAdjusted > bill.AdjustAmount)
            {
                var excess = totalAdjusted - bill.AdjustAmount;
                bill.AdjustAmount -= excess;
                await JS.ToastrWarning("Amount exceeds Bill balance. Adjusted to maximum allowed.");
                if (bill.AdjustAmount < 0)
                    bill.AdjustAmount = 0;
            }
            totalAdjusted = AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Sum(x => x.AdjustAmount);
            AdvaceadjustmentVMs.Amount = totalAdjusted;
        }


        await AutoAdjust();
        await EnforceAdjustmentLimit();
        StateHasChanged();

    }

