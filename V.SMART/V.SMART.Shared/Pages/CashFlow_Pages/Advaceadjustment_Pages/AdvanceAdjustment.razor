            }
            else
            {
                AdvaceadjustmentVMs.AdvaceadjustmentNo = await _AdvanceAdjustService.GenerateAdvanceAdjustNumberAsync();
                AdvaceadjustmentVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
                FilteredBills = new List<BillsVM>();
            }
        }
        catch (Exception ex)
