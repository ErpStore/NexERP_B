            incomes = lists
            .Where((item, index) => index != 3)
            .ToList();


            var firstBank = bankList.FirstOrDefault(b => b.BankName != "CASH");
            if (firstBank != null)
                AdvaceadjustmentVMs.BankId = firstBank.BankId;

            if (AdjumentId.HasValue)
