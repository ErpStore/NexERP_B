    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            bankList = await bankService.GetAllBanksAsync();
            var list = (await _unitOfWork.Expenses.GetAllAsync()).ToList();
            expense = list
            .Where((item, index) => index != 1 && index != 3 && index != 6)
            .ToList();

