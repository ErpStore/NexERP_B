    private async Task UpsertPayments()
    {
        var toRemove = AdvaceadjustmentVMs.AdvaceadjustmentSubVM
     .Where(x => x.AdjustSubId == 0 &&
                 x.AdjustAmount <= 0)
     .ToList();

        foreach (var item in toRemove)
        {
            AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Remove(item);
        }
        try
        {
            if (await SavePayment())
            {
                var isNewEnquiry = AdvaceadjustmentVMs.AdjumentId == 0;

                if (isNewEnquiry)
                    await _AdvanceAdjustService.GenerateAdvanceAdjustNumberAsync();

                AdvaceadjustmentVMs.IsIncome = IsIncome;
                var parent = await _AdvanceAdjustService.UpsertAdvanceAdjustAsync(AdvaceadjustmentVMs, IsBillAdjustmentAllowed);

                await JS.ToastrSuccess(isNewEnquiry
                    ? "AdvanceAdjustment saved successfully."
                    : "AdvanceAdjustment updated successfully.");

                // Discard popup Clear
                await JS.InvokeVoidAsync("NavigationGuard.clear");

                _navigationManager.NavigateTo("/AdvanceAdjustmentList");
            }
        }
        catch (Exception ex)
        {
            await JS.ToastrError("An error occurred while saving the Enquiry.");
            await LoggingService.LogDeveloperError(ex, "Error in UpsertEnquiryPurchase()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task<bool> SavePayment()
    {
        bool Valid = true;
        if (SelectedParty == null)
        {
            JS.ToastrError("Please select a vendor.");
            Valid = false;

        }

        if (AdvaceadjustmentVMs.Amount <= 0)
        {
            JS.ToastrError("Enter a valid amount.");
            Valid = false;
        }

        if (PaymentType == "Manual Selection")
        {
            var sumAdj = AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Sum(x => x.AdjustAmount);
            if (sumAdj < AdvaceadjustmentVMs.Amount)
            {
                JS.ToastrError($"Allocated ₹{sumAdj:N2} is less than payment amount ₹{AdvaceadjustmentVMs.Amount:N2}.");
                Valid = false;
            }
        }
        if (IsBillAdjustmentAllowed)
        {
            if (AdvaceadjustmentVMs.AdvaceadjustmentSubVM.Count == 0)
            {
                JS.ToastrError("select At least One Bill");
                Valid = false;
            }


        }

        return Valid;

    }

