@page "/ReceiptList"


@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IAccountsService
@using V.SMART.Shared.ViewModels.AccountsViewModel
@inject NavigationManager _navigationManager
@inject IReceiptsService _ReceiptsService
@inject ILoggingService LoggingService
@inject IBankService bankService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">

    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>
<BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="btn-danger"
         ButtonText="Delete"
         Title="Are you sure you want to delete this Purchase Enquiry?">
</BsModal>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <PageHeader TitleText="Receipt List"
                        TitleIcon="bi bi-list-check"
                        Breadcrumbs="@ReceiptBreadcrumbs" />

            <div class="card-body p-4">
                <div class="row g-3 align-items-center mb-3">

                    <div class="col-12 col-md-2">
                        <ColumnMenu Columns="Columns" ScreenName="@ScreenName" UserId="@UserName" MaxVisible="int.MaxValue" OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                @onchange="OnPageSizeChanged"
                                title="Select number of records per page">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                      <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                 value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Short Close">Short Close</option>

                        </select>
                    </div>


                    @if (CanCreate)
                    {
                        <div class="col-12 col-lg-2 ms-md-auto text-end">
                            <a class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                               href="Receipts/Create">
                                <i class="bi bi-plus-circle me-1"></i> Add New Receipts
                            </a>
                        </div>

                    }

                </div>
                @if (ReceiptsVMs.Any())
                {
                    <div class="table-responsive">
                    @*     <QuickGrid Items="EnquiryPurchase.AsQueryable()"
                                  @*  Pagination="@pagination" 
                                   Class="quickgrid table table-bordered text-wrap"> *@

                          <QuickGrid Items="ReceiptsVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                          
                                            case "ReceiptId":
                                                <PropertyColumn Title="ReceiptId" Property="@(c => c.ReceiptId)" Sortable="true" />
                                                break;
                                            case "ReceiptNo":
                                                <PropertyColumn Title="Receipt No." Property="@(c => $"{c.ReceiptNo}{c.Suffix ?? string.Empty}")" Sortable="true" />
                                                break;
                                            case "ReceiptDate":
                                                <PropertyColumn Title="Receipt Date" Property="@(c => c.ReceiptDate)" Format="dd/MM/yyyy" />
                                                break;
                                            case "Suffix":
                                                <PropertyColumn Title="Suffix" Property="@(c => c.Suffix)" />
                                                break;
                                            case "PayFromRefCode":
                                                <PropertyColumn Title="Cust ID" Property="@(c => c.PayFromRefCode)" Sortable="true" />
                                                break;
                                          case "PayFromName":
                                               <PropertyColumn Title="Customer Name" Property="@(c => c.PayFromName ?? string.Empty)" />
                                                break;
                                            case "InComeName":
                                                <PropertyColumn Title="InComeName" Property="@(c => c.InComeName)" />
                                                break;
                                            case "PaymentMode":
                                                <PropertyColumn Title="PaymentMode" Property="@(c => c.PaymentMode)" />
                                                break;
                                            case "PaymentTypeName":
                                                <PropertyColumn Title="PaymentTypeName" Property="@(c => c.PaymentTypeName)" />
                                                break;
                                           case "Amount":
                                                <PropertyColumn Title="Amount" Property="@(c => c.Amount)" />
                                                break;
                                         
                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" Sortable="true" />
                                                break;
                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                                break;
                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" Sortable="true" />
                                                break;
                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date" Property="@(c => c.ModifiedDate)" Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }

                            }
                            else
                            {
                                 
                                <PropertyColumn Title="Receipt No" Property="@(c => c.ReceiptNo)" Sortable="true" />
                                <PropertyColumn Title="Receipt Date" Property="@(c => c.ReceiptDate)" Sortable="true" />
                                <PropertyColumn Title="PayFromName" Property="@(c => c.PayFromName)" Sortable="true" />
                                <PropertyColumn Title="Amount" Property="@(c => c.Amount)" Sortable="true" />
                                <PropertyColumn Title="InComeName" Property="@(c => c.InComeName)" Sortable="true" />
                               <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" Sortable="true" />
                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                            }
                            <TemplateColumn Title="Actions" Context="c" >
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                       
                                        <a href="@($"Receipts/update/{c.ReceiptId}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Purchase Enquiry">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if(CanView)
                                    {

                                        <a href="@($"ReceiptDetails/{c.ReceiptId}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Enquiry">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        
                                    }
                                   @if (CanDelete)
                                    {
                                         <button class="btn btn-sm btn-outline-danger"
                                                title="Delete Receipts"
                                                @onclick="() => HandleDelete(c)">
                                            <i class="bi bi-trash3"></i>
                                        </button>

                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>
                    </div>
                    
                     <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>
                }
                else
                {
                    <p class="text-center">No Customer available.</p>
                }
            </div>
        </div>
    </div>
}
@code
{
    protected override string ScreenName => "Receipts";
    private bool isProcessing = true;
    private string searchText = string.Empty;
    private string? UserName;
    private int DeleteRecptID = 0;
    private string selectedStatus = string.Empty;
    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;


    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    private IEnumerable<ReceiptsVM> ReceiptsVMs = new List<ReceiptsVM>();

    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    

    private List<PageHeader.BreadcrumbItem> ReceiptBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "CashFlow" },
        new PageHeader.BreadcrumbItem { Text = "Receipt", IsLast = true }
    };
    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await  InitializeColumns(IsHidden);
            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllReceipts();
           
            await LoadColumnPreferences(UserName);

            
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the PaymentsList OnInitializedAsync() method");

        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {

                new() { Title = "ReceiptId", Field = "ReceiptId", IsVisible = false },
                new() { Title = "Receipt No", Field = "ReceiptNo", IsVisible = true },
                new() { Title = "Receipt Date", Field = "ReceiptDate", IsVisible = true },
                new() { Title = "Suffix", Field = "Suffix", IsVisible = false },
                new() { Title = "PayFromRefCode", Field = "PayFromRefCode", IsVisible = true },
                new() { Title = "PayFromName", Field = "PayFromName", IsVisible = true },
                new() { Title = "InComeName", Field = "InComeName", IsVisible = false },
                new() { Title = "PaymentMode", Field = "PaymentMode", IsVisible = false },
                new() { Title = "PaymentTypeName", Field = "PaymentTypeName", IsVisible = false },
                new() { Title = "Amount", Field = "Amount", IsVisible = false },
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = false },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = false },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false },
            };

            if (!Hidden)
            {
                // Columns.AddRange(new[]
                // {
                //     new GridColumn { Title = "Vendor Name", Field = "VendorName", IsVisible = false },

                // });
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the PaymentsList InitializeColumns() method");
            await _JS.ToastrError("An error occurred while handling the PaymentsList InitializeColumns() method");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Debit Note List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task confirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (isConfirmed && DeleteRecptID > 0)
            {

                isProcessing = true;
               
                
                bool success =  await _ReceiptsService.DeletePaymentAsync(DeleteRecptID);
                if (success)
                {
                    await _JS.ToastrSuccess("Payments Deleted successfully.");
                    await LoadAllReceipts();
                }
                else
                {
                    await _JS.ToastrError("Payments Delete failed.");
                }
                isProcessing = false;
                DeleteRecptID = 0;
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the PaymentsList  confirmDelete_Click() method");
            await _JS.ToastrError("An error occurred while handling the PaymentsList confirmDelete_Click() method");
        }
    }

    private async Task HandleDelete(ReceiptsVM ReceiptsVMs)
    { 
        // var totalQty = enquiry.EnquiryVendorSubs.Sum(s => s.Qty);
        // var totalBalQty = enquiry.EnquiryVendorSubs.Sum(s => s.BalQty);
        //   if ((totalQty != totalBalQty) || enquiry.EnquiryTally)
        //     {
        //          await _JS.ToastrError("Oops! You can't delete this enquiry because some items have already been processed.");
        //           return;
               
        //     }
        //      var (canDelete, message) = await EnquiryPurchaseService.CanDeleteEnquiryAsync(enquiry.EnquiryId);
        //     if (!canDelete)
        //     {
        //         await _JS.ToastrWarning(message);
        //         return;
        //     }
             
            DeleteRecptID =ReceiptsVMs.ReceiptId;
            _JS.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the PaymentsList HandleColumnChange() Method");
            await _JS.ToastrError("An error occurred while handling the PaymentsList HandleColumnChange() event");
        }
    }

    private async Task loadAllEnquirySales()
    {
        try
        {
           ReceiptsVMs = (await _ReceiptsService.GetAllReceiptsAsync())
                .OrderByDescending(c => c.CreatedDate)
                .ToList();

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the PaymentsList loadAllCustomers() Method");
            await _JS.ToastrError("An error occurred while handling the PaymentsList loadAllCustomers() method");
        }
    }
   
    private async Task LoadAllReceipts()
    {
        try
        {
            var result = await _ReceiptsService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            ReceiptsVMs = result.ReceiptsVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading categories in PaymentsList");
            await _JS.ToastrError("Failed to load PaymentsList.");
        }
    }

 
    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllReceipts();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in PaymentsList");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllReceipts();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in PaymentsList");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllReceipts();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in PaymentsList");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllReceipts();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in PaymentsList");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllReceipts();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in PaymentsList");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllReceipts();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing PaymentsList page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion
    #region MODAL HANDLERS

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }
    #endregion
    #region Search order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? "";

        // Update filters
       if (string.IsNullOrWhiteSpace(selectedStatus))
            SearchFilters.Remove("Status");
        else
            SearchFilters["Status"] = selectedStatus;


        currentPage = 1;
        await LoadAllReceipts();
    }

    #endregion 
      #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllReceipts();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in PaymentsList");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }
     
    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion

}
