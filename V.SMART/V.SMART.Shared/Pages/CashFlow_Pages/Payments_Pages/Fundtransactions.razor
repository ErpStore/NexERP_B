                                        disabled="@(!deleteConfirmChecked)">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            </div>
        </div>
    }
}



@code {
    protected override string ScreenName => "Fundtransactions";
    private List<FundTrans> transactions = new();
    private FundTransFilter filter = new();
    private bool isLoading = false;
    private int totalItems = 0;
    private int totalPages = 1;
    private List<string> distinctTypes = new();

    private FundTrans? deleteItem = null;
    private bool deleteConfirmChecked = false;

    private decimal TotalCredits;
    private decimal TotalDebits;
    private decimal NetBalance;
    private bool isProcessing = true;
    private List<PageHeader.BreadcrumbItem> FundtransBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "CashFlow" },
        new PageHeader.BreadcrumbItem { Text = "Fundtransactions", IsLast = true }
    };
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;

            await LoadRightsAsync();

            filter.SortBy = "FundTransId";
            await LoadDistinctTransactionTypes();
            await LoadTransactions();

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    private async Task LoadDistinctTransactionTypes()
    {
        var all = await FundTransRepository.LoadDistinctTransactionTypes();
        distinctTypes = all.ToList();
    }

    private async Task LoadTransactions()
    {
        isLoading = true;
        try
        {
            var result = await FundTransRepository.GetWithFiltersAsync(filter);
            transactions = result.Items;
            TotalCredits = result.TotalCredits;
            TotalDebits = result.TotalDebits;
            NetBalance = result.NetBalance;
            totalItems = await FundTransRepository.GetTotalCountAsync(filter);
            totalPages = (int)Math.Ceiling(totalItems / (double)filter.PageSize);
        }
        catch (Exception ex)
        {
            await JSRuntime.ToastrError("LoadTransactions");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResetFilters()
    {
        filter = new FundTransFilter();
     
        filter.SearchTerm = null;
        filter.StartDate = null;
        filter.EndDate = null;
        filter.TransactionType = null;
        filter.SortBy = "FundTransId";
        filter.SortDescending = true;

        await LoadTransactions();
    }

    private async Task SortByColumn(string columnName)
    {
        if (filter.SortBy == columnName)
        {
            filter.SortDescending = !filter.SortDescending;
        }
        else
        {
            filter.SortBy = columnName;
            filter.SortDescending = true;
        }
        filter.Page = 1;
        await LoadTransactions();
    }

    private string GetSortIcon(string columnName)
    {
        if (filter.SortBy != columnName)
            return "bi-arrow-down-up text-muted";

        return filter.SortDescending ? "bi-sort-down" : "bi-sort-up";
    }

    private string GetTypeBadgeClass(string? transType)
    {
        return transType switch
        {
            "PAYMENT" => "bg-danger",
            "RECEIPT" => "bg-success",
            "CONTRA" => "bg-primary",
            "JOURNAL" => "bg-info",
            "TRANSFER" => "bg-warning",
            "Opening Balance" => "bg-secondary",
            _ => "bg-dark"
        };
    }

    // Pagination methods
    private async Task FirstPage() { filter.Page = 1; await LoadTransactions(); }
    private async Task PrevPage() { filter.Page--; await LoadTransactions(); }
    private async Task NextPage() { filter.Page++; await LoadTransactions(); }
    private async Task LastPage() { filter.Page = totalPages; await LoadTransactions(); }
    private async Task ChangePage(int page) { filter.Page = page; await LoadTransactions(); }

    private void ViewTransaction(int id) => Navigation.NavigateTo($"/fundtransactions/view/{id}");
    private void EditTransaction(int id) => Navigation.NavigateTo($"/fundtransactions/edit/{id}");
    private void AddNewTransaction() => Navigation.NavigateTo("/fundtransactions/new");

    private void ConfirmDelete(FundTrans transaction)
    {
        deleteItem = transaction;
        deleteConfirmChecked = false;
    }

    private void CloseDeleteModal()
    {
        deleteItem = null;
        deleteConfirmChecked = false;
    }

    private async Task DeleteTransactionNow()
    {
        if (deleteItem != null)
        {
            await FundTransRepository.DeleteAsync(deleteItem.FundTransId);
            CloseDeleteModal();
            await LoadTransactions();
        }
    }

    private async Task ExportToExcel()
    {
        try
        {
            var csvContent = "Transaction No,Date,Type,Mode,Ledger Name,Ledger Type,Amount,Balance,Advance Balance,Bank Name,Expense Name,Cheque No\n";

            foreach (var trans in transactions)
            {
                csvContent += $"\"{trans.TransNo}\",";
                csvContent += $"\"{trans.TransDate:dd/MM/yyyy HH:mm}\",";
                csvContent += $"\"{trans.TransType}\",";
                csvContent += $"\"{trans.TrasactionMode}\",";
                csvContent += $"\"{trans.LedgerName}\",";
                csvContent += $"\"{trans.LedgerType}\",";
                csvContent += $"\"{trans.PaidOrReceived}\",";
                csvContent += $"\"{trans.RunningBalance}\",";
                csvContent += $"\"{trans.AdvanceBalance}\",";
                csvContent += $"\"{trans.Banks?.BankName}\",";
                csvContent += $"\"{trans.Expense?.ExpenseName}\",";
                csvContent += $"\"{trans.ChequeNo}\"\n";
            }

            var fileName = $"Transactions_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent);
            var base64 = Convert.ToBase64String(bytes);
            var js = $"const link = document.createElement('a'); link.href = 'data:text/csv;base64,{base64}'; link.download = '{fileName}'; link.click();";
            await JSRuntime.InvokeVoidAsync("eval", js);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Export error: {ex.Message}");
        }
    }
}

