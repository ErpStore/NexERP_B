                    <!-- Pagination -->
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small">
                                    Showing @((filter.Page - 1) * filter.PageSize + 1) to @Math.Min(filter.Page * filter.PageSize, totalItems) of @totalItems entries
                                </span>
                            </div>
                            <div>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(filter.Page == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="FirstPage">
                                                <i class="bi bi-chevron-double-left"></i>
                                            </button>
                                        </li>
                                        <li class="page-item @(filter.Page == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="PrevPage">
                                                <i class="bi bi-chevron-left"></i>
                                            </button>
                                        </li>

                                        @for (int i = Math.Max(1, filter.Page - 2); i <= Math.Min(totalPages, filter.Page + 2); i++)
                                        {
                                            <li class="page-item @(i == filter.Page ? "active" : "")">
                                                <button class="page-link" @onclick="@(() => ChangePage(i))">
                                                    @i
                                                </button>
                                            </li>
                                        }

                                        <li class="page-item @(filter.Page == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="NextPage">
                                                <i class="bi bi-chevron-right"></i>
                                            </button>
                                        </li>
                                        <li class="page-item @(filter.Page == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="LastPage">
                                                <i class="bi bi-chevron-double-right"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div> 

            <!-- Delete Confirmation Modal -->
            @if (deleteItem != null)
            {
                <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5)">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-danger text-white">
                                <h6 class="modal-title">
                                    <i class="bi bi-exclamation-triangle me-2"></i>Delete Transaction
                                </h6>
                                <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                            </div>
                            <div class="modal-body">
