@page "/Fundtransactions"

@using V.SMART.Shared.Data.AccountsModule
@using V.SMART.Shared.Repository.IRepository.IAccountRepository.IPaymentsRepository
@using V.SMART.Shared.ViewModels.AccountsViewModel

@inherits BaseUserRightsComponent
@inject IFundTransRepository FundTransRepository
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILoggingService LoggingService


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container-fluid px-2 px-md-4 mt-3">
            <div class="adjustment-container">
                <!-- Header -->

                <PageHeader TitleText="@("Trasaction History")"
                            TitleIcon="bi bi-tag"
                            Breadcrumbs="@FundtransBreadcrumbs" />


            <div class="container-fluid">
                <!-- Page Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-1">Fund Transactions</h2>
                        <p class="text-muted small mb-0">View and manage all financial transactions</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm" @onclick="ExportToExcel">
                            <i class="bi bi-file-excel me-1"></i> Export
                        </button>
         
                    </div>
                </div>

                <!-- Summary Cards -->
                <div class="row mb-4">
                    <div class="col-md-3 mb-3">
                        <div class="card border">
                            <div class="card-body py-3">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted small mb-1">Total Transactions</h6>
                                        <h5 class="mb-0">@transactions.Count</h5>
                                    </div>
                                    <div class="text-primary">
                                        <i class="bi bi-receipt fs-4"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card border">
                            <div class="card-body py-3">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted small mb-1">Total Credits</h6>
                                        <h5 class="mb-0 text-success">@TotalCredits.ToString("N2")</h5>
                                    </div>
                                    <div class="text-success">
                         
                                        <i class="bi bi-arrow-down-circle fs-4"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card border">
                            <div class="card-body py-3">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted small mb-1">Total Debits</h6>
                                        <h5 class="mb-0 text-danger">@TotalDebits.ToString("N2")</h5>
                                    </div>
                                    <div class="text-danger">
                                        <i class="bi bi-arrow-up-circle fs-4"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="card border">
                            <div class="card-body py-3">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h6 class="text-muted small mb-1">Net Balance</h6>
                                        <h5 class="mb-0 @(NetBalance >= 0 ? "text-success" : "text-danger")">@NetBalance.ToString("N2")</h5>
                                    </div>
                                    <div class="text-info">
                                        <i class="bi bi-pie-chart fs-4"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filter Panel -->
                <div class="card border mb-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Filters</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <!-- Search -->
                            <div class="col-lg-3 col-md-6">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Search..."
                                       @bind="filter.SearchTerm"
                                       @bind:event="oninput" />
                            </div>

                            <!-- Date Range -->
                            <div class="col-lg-3 col-md-6">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">From</span>
                                    <input type="date" class="form-control" @bind="filter.StartDate" />
                                    <span class="input-group-text">To</span>
                                    <input type="date" class="form-control" @bind="filter.EndDate" />
                                </div>
                            </div>

                            <!-- Transaction Type -->
                            <div class="col-lg-2 col-md-6">
                                <select class="form-select form-select-sm" @bind="filter.TransactionType">
                                    <option value="">All Types</option>
                                    @foreach (var type in distinctTypes)
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </div>

                            <!-- Page Size -->
                            <div class="col-lg-2 col-md-6">
                                <select class="form-select form-select-sm" @bind="filter.PageSize">
                                    <option value="10">10 rows</option>
                                    <option value="25">25 rows</option>
                                    <option value="50">50 rows</option>
                                    <option value="100">100 rows</option>
                                </select>
                            </div>

                            <!-- Buttons -->
                            <div class="col-lg-2 col-md-12">
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary btn-sm flex-grow-1" @onclick="LoadTransactions">
                                        <i class="bi bi-filter me-1"></i> Apply
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFilters" title="Reset">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!----<<<<<<<<<<<<<<<<<---  --->
                <div class="card border">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 ledger-table">
                                <thead class="table-light">
                                    <tr>
                                        <th width="80" @onclick="@(() => SortByColumn("TransNo"))" style="cursor:pointer">
                                            # <i class="bi @GetSortIcon("TransNo") ms-1"></i>
                                        </th>

                                        <th width="110" @onclick="@(() => SortByColumn("TransDate"))" style="cursor:pointer">
                                            Date <i class="bi @GetSortIcon("TransDate") ms-1"></i>
                                        </th>

                                        <th>Ledger</th>
                                        <th>Type</th>
                                        <th width="100">Mode</th>

                                        <!-- NEW Separate Columns -->
                                        <th class="text-end" width="120"
                                            @onclick="@(() => SortByColumn("PaidOrReceived"))"
                                            style="cursor:pointer">
                                            Debit <i class="bi @GetSortIcon("PaidOrReceived") ms-1"></i>
                                        </th>

                                        <th class="text-end" width="120">
                                            Credit
                                        </th>

                                        <th class="text-end" width="140">
                                            Balance
                                        </th>

                                        <th width="100">Bank</th>
                                        <th width="100">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (isLoading && !transactions.Any())
                                    {
                                        <tr>
                                            <td colspan="10" class="text-center py-5">
                                                <div class="spinner-border spinner-border-sm text-primary"></div>
                                                <span class="ms-2">Loading transactions...</span>
                                            </td>
                                        </tr>
                                    }
                                    else if (!transactions.Any())
                                    {
                                        <tr>
                                            <td colspan="10" class="text-center py-4 text-muted">
                                                No transactions found
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        DateTime? lastDate = null;

                                        decimal openingBalance =
                                        transactions.First().RunningBalance
                                        - transactions.First().PaidOrReceived;

                                        <!-- Opening Balance -->
                                        <tr class="table-secondary fw-bold">
                                            <td colspan="7">Opening Balance</td>
                                            <td class="text-end">
                                                @openingBalance.ToString("N2")
                                            </td>
                                            <td colspan="2"></td>
                                        </tr>

                                        @foreach (var trans in transactions)
                                        {
                                            if (lastDate != trans.TransDate.Date)
                                            {
                                                <tr class="table-light">
                                                    <td colspan="10" class="fw-bold text-primary">
                                                        @trans.TransDate.ToString("dd MMM yyyy")
                                                    </td>
                                                </tr>
                                                lastDate = trans.TransDate.Date;
                                            }

                                        <tr class="@(trans.PaidOrReceived < 0 ? "debit-row" : "credit-row")">

                                            <!-- Voucher -->
                                            <td>
                                                <span class="badge bg-secondary">
                                                    @trans.TransNo
                                                </span>
                                            </td>

                                            <!-- Date -->
                                            <td>
                                                <div>@trans.TransDate.ToString("dd/MM/yyyy")</div>
                                                <small class="text-muted">
                                                    @trans.TransDate.ToString("hh:mm tt")
                                                </small>
                                            </td>

                                            <!-- Ledger -->
                                            <td>
                                                <div class="fw-semibold">
                                                    @trans.LedgerName
                                                </div>
                                                <small class="text-muted">
                                                    @trans.LedgerType
                                                </small>
                                            </td>

                                            <!-- Type -->
                                            <td>
                                                <span class="badge @GetTypeBadgeClass(trans.TransType)">
                                                    @trans.TransType
                                                </span>
                                            </td>

                                            <!-- Mode -->
                                            <td>
                                                <span class="badge @(trans.TrasactionMode == "BANK" ? "bg-info" : "bg-secondary")">
                                                    @trans.TrasactionMode
                                                </span>
                                            </td>

                                            <!-- Debit -->
                                            <td class="text-end text-danger fw-bold">
                                                @(trans.PaidOrReceived < 0
                                                                                ? Math.Abs(trans.PaidOrReceived).ToString("N2")
                                                                                : "-")
                                                                                  </td>

                                            <!-- Credit -->
                                            <td class="text-end text-success fw-bold">
                                                @(trans.PaidOrReceived > 0
                                                                                ? trans.PaidOrReceived.ToString("N2")
                                                                                : "-")
                                                                                  </td>

                                            <!-- Running Balance -->
                                            <td class="text-end fw-bold">
                                                @trans.RunningBalance.ToString("N2")
                                                <div class="small text-muted">
                                                    Adv: @trans.AdvanceBalance.ToString("N2")
                                                </div>
                                            </td>

                                            <!-- Bank -->
                                            <td>
                                                @(trans.Banks?.BankName ?? "-")
                                            </td>

                                                <!-- Actions -->
                                                <td>
                                                    <div class="d-flex gap-1">
                                                        <button class="btn btn-sm btn-outline-info"
                                                                @onclick="@(() => ViewTransaction(trans.FundTransId))">
                                                            <i class="bi bi-eye"></i>
                                                        </button>

                                                        <button class="btn btn-sm btn-outline-warning"
                                                                @onclick="@(() => EditTransaction(trans.FundTransId))">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>

                                                        <button class="btn btn-sm btn-outline-danger"
                                                                @onclick="@(() => ConfirmDelete(trans))">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>

                                            </tr>
                                                            }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    </div>

                <!-- Transactions Table -->
