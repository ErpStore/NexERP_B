    private async Task UpsertPayments()
    {
        var toRemove = PaymentsVMs.PaymentSubVM
     .Where(x => x.PaymentSubId == 0 &&
                 x.AdjustAmount <= 0)
     .ToList();

        foreach (var item in toRemove)
        {
            PaymentsVMs.PaymentSubVM.Remove(item);
        }
        try
        {
            if (await SavePayment())
            {
                var isNewEnquiry = PaymentsVMs.PaymentId == 0;

                if (isNewEnquiry)
                    PaymentsVMs.PaymentNo=await _PaymentsService.GeneratePaymentNumberAsync();

                var parent = await _PaymentsService.UpsertPaymentsAsync(PaymentsVMs,IsBillAdjustmentAllowed);

                await JS.ToastrSuccess(isNewEnquiry
                    ? "Payments saved successfully."
                    : "Payments updated successfully.");

                // Discard popup Clear
                await JS.InvokeVoidAsync("NavigationGuard.clear");

                _navigationManager.NavigateTo("/PaymentList");
            }
        }
        catch (Exception ex)
        {
            await JS.ToastrError("An error occurred while saving the Enquiry.");
            await LoggingService.LogDeveloperError(ex, "Error in UpsertEnquiryPurchase()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task<bool> SavePayment()
    {
        bool Valid = true;

        if (IsDefaultExpense)
        {

            if (SelectedParty == null)
            {
                JS.ToastrError("Please select a vendor.");
                Valid=false;

            }
        }
        if (PaymentsVMs.Amount <= 0)
        {
            JS.ToastrError("Enter a valid amount.");
            Valid=false;
        }
        if (PaymentsVMs.BankId>0)
        {
            if (string.IsNullOrEmpty(PaymentsVMs.ChequeNo))
            {
                JS.ToastrError("Enter a valid Cheque Number.");
                Valid=false;
            }
            decimal originalPaymentAmount = PaymentsVMs.Amount;
            decimal adjustedAmount = originalPaymentAmount;
            decimal availableBankBalance = 0;
            var sumAdj = PaymentsVMs.PaymentSubVM.Sum(x => x.AdjustAmount);
            var bank = await bankService.GetBankAsync(PaymentsVMs.BankId ?? 0);

            if (PaymentsVMs.PaymentId > 0)
            {
                var oldPayment = await _PaymentsService.GetPaymentsByIdAsync(PaymentsVMs.PaymentId);

                if (oldPayment?.BankId == PaymentsVMs?.BankId)
                {
                    availableBankBalance = bank.CurrentBalance + (oldPayment?.Amount ?? 0);
                }
                else
                {
                    availableBankBalance = bank.CurrentBalance;
                }
                // availableBankBalance = bank.CurrentBalance + oldPayment.Amount;
            }
            else
            {
                availableBankBalance = bank.CurrentBalance;
            }

            if (originalPaymentAmount > availableBankBalance)
            {
                adjustedAmount = availableBankBalance;
                PaymentsVMs.Amount = adjustedAmount;
                await JS.ToastrWarning($"Payment reduced to Bank Balance: {adjustedAmount}");
                await AutoAdjust();
                Valid = false;
            }
        }
        if (IsDefaultExpense)
        {
            if (PaymentType == "Manual Selection")
            {
                var sumAdj = PaymentsVMs.PaymentSubVM.Sum(x => x.AdjustAmount);
                if (sumAdj < PaymentsVMs.Amount)
                {
                    JS.ToastrError($"Allocated ₹{sumAdj:N2} is less than payment amount ₹{PaymentsVMs.Amount:N2}.");
                    Valid = false;
                }
            }
            if (IsBillAdjustmentAllowed)
            {
                if (PaymentsVMs.PaymentSubVM.Count == 0)
                {
                    JS.ToastrError("select At least One Bill");
                    Valid = false;
                }


            }
        }

        return Valid;

    }

