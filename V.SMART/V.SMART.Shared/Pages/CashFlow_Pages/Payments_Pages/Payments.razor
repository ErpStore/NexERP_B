            if (PaymentsVMs.PaymentId > 0 && IsBillAdjustmentAllowed && PaymentsVMs.PaymentSubVM.Count == 0)
            {
                await JS.ToastrError("Back not allowed. Please link bill first.");
                return; // ❌ Stop navigation
            }
        }
        _navigationManager.NavigateTo("/PaymentList"); // ✔ Allow only when bill is linked

