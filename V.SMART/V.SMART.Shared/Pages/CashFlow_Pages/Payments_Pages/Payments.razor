    private async Task LoadExistingPaymnets(int paymentId)
    {
        try
        {
            isProcessing = true;
            StateHasChanged();

            PaymentsVMs = await _PaymentsService.GetPaymentsByIdAsync(paymentId);

            if (PaymentsVMs == null)
            {
                await JS.ToastrWarning("Payment not found.");
                return;
            }

            if (PaymentsVMs.PayToRefCode.HasValue && PaymentsVMs.PayToRefCode > 0)
            {
                var vendor = await _PaymentsService.GetVendorByIdAsync(PaymentsVMs.PayToRefCode.Value);
                if (vendor != null)
                {
                    SelectedParty = PartyMapper.FromVendor(vendor);

                    PartySearch = SelectedParty.PartyName;
                    await LoadBillsPending(SelectedParty.PartyCode, PaymentsVMs.ExpenseName);
                    SelectedExpenseType = PaymentsVMs.ExpenseName;
                    LoadPaymentTypes(PaymentsVMs.ExpenseName);
                    var paymentType = PaymentTypeList.FirstOrDefault(pt =>
                        pt.PaymentTypeName == PaymentsVMs.PaymentTypeName);
                    SelectedPaymentTypeId = paymentType?.PaymentTypeId ?? 0;

                    SelectedParty.AdvancePaid = await _PaymentsService.GetAdvanceAmountPaid(SelectedExpenseType, paymentType.PaymentTypeName, PaymentsVMs.PayToRefCode.Value);
                    FilterBills();
                }
            }

            IsBank = PaymentsVMs.BankId > 0;

            PaymentType = PaymentsVMs.PaymentTypeName ?? "Manual Selection";

            if (IsBillAdjustmentAllowed)
            {
                if (PaymentType == "Automatic Adjust")
                    AutoAdjust();
                else
                    FilterBills();
            }

            ActiveTab = TAB_LINKED;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.ToastrError("Failed to load payment details.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingPayments failed for PaymentId: {paymentId}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
    private async Task HandleBackClick()
