    private async Task SelectExpense(Expense selectedExpense)
    {
        try
        {
            PaymentsVMs.ExpenseName = selectedExpense.ExpenseName;
            PaymentsVMs.ExpenseCode = selectedExpense.ExpenseCode;
            ExpenseSearch = selectedExpense.ExpenseName;
            SelectedExpenseType = selectedExpense.ExpenseName;
            IsDefaultExpense = selectedExpense.IsDefault;
            ShowExpenseDropdown = false;
            FilteredExpenses.Clear();
            PaymentsVMs.PaymentSubVM.Clear();
            Bills.Clear();
            await LoadPaymentTypes(PaymentsVMs.ExpenseName);
            PaymentsVMs.PaymentTypeId = 0;
            PaymentsVMs.PaymentTypeName = "";
            PartySearch = "";
            BillSearch = ""; 
            StateHasChanged();

