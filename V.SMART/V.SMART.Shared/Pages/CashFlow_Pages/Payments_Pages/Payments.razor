    private async Task GenerateQR()
    {
        decimal amount = PaymentsVMs.Amount;
        if (amount <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Enter valid amount first");
            return;
        }

        var bank = await _unitOfWork.Banks
                  .GetQueryable()
                  .FirstOrDefaultAsync(x => x.BankId == PaymentsVMs.BankId);
        if (bank != null)
        {
            string upiId = bank.UpiId;
            string name = bank.UpiName;
            string note = BillNote;
            if (!string.IsNullOrEmpty(upiId) && !string.IsNullOrEmpty(name) && PaymentsVMs.PaymentId>0)
            {

                byte[] qrBytes = UpiQrService.GenerateUpiQr(upiId, name, amount, note);
                QrImage = Convert.ToBase64String(qrBytes);
                await Task.CompletedTask;

