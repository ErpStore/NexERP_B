    }

    public async Task AmountChanged(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var amt))
            return;

        PaymentsVMs.Amount = amt;

        if (PaymentType == "Automatic Adjust")
        {
            await  AutoAdjust();
            await EnforceAdjustmentLimit();

        }
        else if(PaymentType.ToUpper()=="OPENING BALANCE")
        {
            if(PaymentsVMs.PaymentId>0)
            {
                var OldAmount = await _PaymentsService.GetPaymentsByIdAsync(PaymentsVMs.PaymentId);
                var vendor = await _PaymentsService.GetVendorByIdAsync(PaymentsVMs.PayToRefCode.Value);
                if (vendor != null)
                {
                    SelectedParty = PartyMapper.FromVendor(vendor);
                    PartyVMs.OpeningBalancePending = OldAmount.Amount + SelectedParty.OpeningBalancePending;
                    SelectedParty.OpeningBalancePending = PartyVMs.OpeningBalancePending;
                    decimal AdvanceBal = await _PaymentsService.GetAdvanceAmountPaid(PaymentsVMs.ExpenseName, PaymentsVMs.PaymentTypeName, PaymentsVMs.PayToRefCode.Value);
                    decimal alreadyAdjusted = OldAmount.Amount - AdvanceBal;
                    if (PaymentsVMs.Amount < alreadyAdjusted)
                    {
                        PaymentsVMs.Amount = alreadyAdjusted;
                        await JS.ToastrWarning($"Amount cannot be less than already adjusted amount ({alreadyAdjusted}).");
                        StateHasChanged();
                        return;
                    }
                }

            }
            if(PaymentsVMs.Amount> SelectedParty.OpeningBalancePending)
            {
                await JS.ToastrWarning("Amount exceeds pending opening balance. Adjusted to maximum allowed.");
                PaymentsVMs.Amount = PartyVMs.OpeningBalancePending;
                StateHasChanged();
                return;
            }
        }
        else if (PaymentType.ToUpper() == "PAY ADVANCE")
        {
            await AutoAdjustBank();
        }
        else
        {
            await  AutoAdjust();
            await EnforceAdjustmentLimit();
        }

        StateHasChanged();
    }
    public async Task EnforceAdjustmentLimit()
    {
        decimal runningTotal = 0;

        foreach (var row in PaymentsVMs.PaymentSubVM)
        {
            var allowed = PaymentsVMs.Amount - runningTotal;

            if (allowed <= 0)
            {
                row.AdjustAmount = 0;
            }
            else if (row.AdjustAmount > allowed)
            {
                row.AdjustAmount = allowed; // 🔒 force reduce
                await JS.ToastrWarning("Amount exceeds Bill balance. Adjusted to maximum allowed.");
            }

            runningTotal += row.AdjustAmount;
        }
        PaymentsVMs.Amount = runningTotal;
        StateHasChanged();
    }

    public async Task AutoAdjustBank()
    {
        if (IsBillAdjustmentAllowed || SelectedParty == null)
            return;

        decimal originalPaymentAmount = PaymentsVMs.Amount;



        decimal adjustedAmount = originalPaymentAmount;
        decimal availableBankBalance = 0;

        // 🔥 1. BANK BALANCE CHECK FIRST
        if (PaymentsVMs.BankId > 0 && IsBank)
        {
            var bank = await bankService.GetBankAsync(PaymentsVMs.BankId ?? 0);

            if (PaymentsVMs.PaymentId > 0)
            {
                var oldPayment = await _PaymentsService.GetPaymentsByIdAsync(PaymentsVMs.PaymentId);
                availableBankBalance = bank.CurrentBalance + oldPayment.Amount;
            }
            else
            {
                availableBankBalance = bank.CurrentBalance;
            }

            if (originalPaymentAmount > availableBankBalance)
            {
                adjustedAmount = availableBankBalance;
                PaymentsVMs.Amount = adjustedAmount;
                await JS.ToastrWarning($"Payment reduced to Bank Balance: {adjustedAmount}");
            }


        }
        PaymentsVMs.Amount = adjustedAmount;
        StateHasChanged();
    }



    public async Task AutoAdjust()
    {
        if (!IsBillAdjustmentAllowed || SelectedParty == null)
            return;

        decimal originalPaymentAmount = PaymentsVMs.Amount;

        if (PaymentsVMs.PaymentTypeName == "Automatic Adjust")
        {
            originalPaymentAmount = Bills.Sum(b => b.Balance);
        }

        decimal adjustedAmount = originalPaymentAmount;
        decimal availableBankBalance = 0;

        // 🔥 1. BANK BALANCE CHECK FIRST
        if (PaymentsVMs.BankId > 0 && IsBank)
        {
            var bank = await bankService.GetBankAsync(PaymentsVMs.BankId ?? 0);

            if (PaymentsVMs.PaymentId > 0)
            {
                var oldPayment = await _PaymentsService.GetPaymentsByIdAsync(PaymentsVMs.PaymentId);
                if (oldPayment?.BankId == PaymentsVMs?.BankId)
                {
                    availableBankBalance = bank.CurrentBalance + (oldPayment?.Amount ?? 0);
                }
                else
                {
                    availableBankBalance = bank.CurrentBalance;
                }
                // availableBankBalance = bank.CurrentBalance + oldPayment.Amount;
            }
            else
            {
                availableBankBalance = bank.CurrentBalance;
            }

            if (originalPaymentAmount > availableBankBalance)
            {
                adjustedAmount = availableBankBalance;
                PaymentsVMs.Amount = adjustedAmount;
                await JS.ToastrWarning($"Payment reduced to Bank Balance: {adjustedAmount}");
            }
        }

        // 🔥 2. TOTAL BILL BALANCE CHECK NEXT

        var pendingBills = Bills
            .Where(b => b.PartyCode == SelectedParty.PartyCode && b.Balance > 0)
            .OrderBy(b => b.BillDate)
            .ThenBy(b => b.Id)
            .ToList();

        decimal totalBillBalance = pendingBills.Sum(b => b.Balance);

        // 🔥 3. ADJUST BILLS (Before Save OR Edit Mode)
        decimal remaining = adjustedAmount;

        if (PaymentsVMs.PaymentId == 0) // ➤ NEW payment (before save)
        {

            if (adjustedAmount > totalBillBalance)
            {
                adjustedAmount = totalBillBalance;
                PaymentsVMs.Amount = adjustedAmount;
                await JS.ToastrError($"Payment reduced to Total Bill Balance: {adjustedAmount}");
            }
            PaymentsVMs.PaymentSubVM.Clear();

            foreach (var b in pendingBills)
            {
                if (remaining <= 0) break;

                var adj = Math.Min(b.Balance, remaining);

                PaymentsVMs.PaymentSubVM.Add(new PaymentSubVM
                {
                    PaymentSubId = 0,
                    RefId = b.Id,
                    BillNo = b.BillNo,
                    BillDate = b.BillDate,
                    BalanceAmount = b.Balance,
                    SavedAdjustAmount = 0,
                    AdjustAmount = adj
                });

                remaining -= adj;
            }
        }
        else 
        {
            // EDIT MODE
            decimal remainingEdit = adjustedAmount;

            // STEP 1 – RESET ALL TO SAVED
            foreach (var sub in PaymentsVMs.PaymentSubVM)
            {
                decimal savedAdj = await _PaymentsService
                    .GetPaymentSubAmountByIdAsync(sub.PaymentSubId ?? 0);

                var realBill = pendingBills.FirstOrDefault(b => b.Id == sub.RefId);
                decimal realBalance = realBill?.Balance ?? 0;

                sub.SavedAdjustAmount = savedAdj;

                // Reset to saved only
                sub.AdjustAmount = savedAdj;

                // Restore full real balance
                sub.BalanceAmount = realBalance;

                remainingEdit -= savedAdj;
            }

            if (remainingEdit < 0)
                remainingEdit = 0;

            // STEP 2 – DISTRIBUTE NEW AMOUNT
            foreach (var sub in PaymentsVMs.PaymentSubVM.OrderBy(x => x.BillDate))
            {
                if (remainingEdit <= 0)
                    break;

                decimal usableBalance = sub.BalanceAmount;

                if (usableBalance <= 0)
                    continue;

                decimal use = Math.Min(usableBalance, remainingEdit);

                sub.AdjustAmount += use;
                sub.BalanceAmount -= use;

                remainingEdit -= use;
            }

            // OPTIONAL WARNING
            if (remainingEdit > 0)
            {
                await JS.ToastrWarning($"Extra amount {remainingEdit} not adjusted");
            }


            // foreach (var sub in PaymentsVMs.PaymentSubVM.OrderBy(x => x.BillDate))
            // {
            //     decimal savedAdj = await _PaymentsService
            //         .GetPaymentSubAmountByIdAsync(sub.PaymentSubId ?? 0);

            //     var realBill = pendingBills.FirstOrDefault(b => b.Id == sub.RefId);
            //     decimal realBalance = realBill?.Balance ?? 0;

            //     decimal billTotal = savedAdj + realBalance;

            //     decimal newAdjust = sub.AdjustAmount;

            //     MAX LIMIT
            //     if (newAdjust > billTotal)
            //     {
            //         newAdjust = billTotal;
            //         await JS.ToastrWarning($"Bill {sub.BillNo}: Adjust exceeds {billTotal}");
            //     }

            //     if (newAdjust < 0)
            //         newAdjust = 0;

            //     DISTRIBUTE REMAINING SAFELY
            //     if (remaining > 0)
            //     {
            //         decimal maxAllowedNow = savedAdj + remaining;
            //         newAdjust = Math.Min(billTotal, maxAllowedNow);
            //     }

            //     sub.SavedAdjustAmount = savedAdj;
            //     sub.AdjustAmount = newAdjust;

            //     FINAL BALANCE
            //     sub.BalanceAmount = billTotal - newAdjust;

            //     REDUCE ONLY NEW PART
            //     decimal newPortion = newAdjust - savedAdj;
            //     if (newPortion > 0)
            //         remaining -= newPortion;
            // }
            ////050326

            // foreach (var sub in PaymentsVMs.PaymentSubVM.OrderBy(x => x.BillDate))
            // {

            //     decimal savedAdj = await _PaymentsService.GetPaymentSubAmountByIdAsync(sub.PaymentSubId ?? 0);


            //     var realBill = pendingBills.FirstOrDefault(b => b.Id == sub.RefId);
            //     decimal realBalance = realBill?.Balance ?? 0;

            //     decimal originalBillAmount = savedAdj + realBalance;


            //     if (sub.AdjustAmount> originalBillAmount)
            //     {
            //         await JS.ToastrError($"Bill {sub.BillNo}: Adjust exceeds original bill amount");
            //         sub.AdjustAmount = originalBillAmount;
            //     }


            //     if (remaining > 0)
            //     {
            //         var adj = Math.Min(realBalance + savedAdj, remaining);
            //         sub.SavedAdjustAmount = savedAdj;
            //         sub.BalanceAmount = originalBillAmount;
            //         sub.AdjustAmount = adj;
            //         remaining -= adj;
            //     }
            //     else
            //     {
            //         sub.SavedAdjustAmount = savedAdj;
            //         sub.BalanceAmount = realBalance;
            //         sub.AdjustAmount = 0;
            //     }
            // }
        }

        decimal finalTotalAdjust = PaymentsVMs.PaymentSubVM.Sum(x => x.AdjustAmount);

        if (finalTotalAdjust == 0)
        {
            await JS.ToastrError("No pending bills available for adjustment");
            PaymentsVMs.Amount = 0;
            return;
        }

        PaymentsVMs.Amount = finalTotalAdjust;
        await FilterBills(); // refresh bill lists

        ActiveTab = TAB_LINKED;
        PaymentsVMs.PaymentSubVM = PaymentsVMs.PaymentSubVM.ToList();
        await EnforceAdjustmentLimit();
        StateHasChanged();
    }


