    private async Task LoadPaymentTypes(string expenseName)
    {
        try
        {
            PaymentTypeList.Clear();
            var name = expenseName?.ToUpper();

            switch (name)
            {
                case "PURCHASE":
                case "SUBCONTRACT":
                    PaymentTypeList = new List<PaymentTypeModel>
                {
                    new() { PaymentTypeId = 1, PaymentTypeName = "Manual Selection" },
                    new() { PaymentTypeId = 2, PaymentTypeName = "Automatic Adjust" },
                    new() { PaymentTypeId = 3, PaymentTypeName = "Opening Balance" },
                    new() { PaymentTypeId = 4, PaymentTypeName = "Pay Advance" }
                };
                    break;

                case "PURCHASE ORDER ADVANCE":
                case "SUBCONTRACT ORDER ADVANCE":
                    PaymentTypeList = new List<PaymentTypeModel>
                {
                    new() { PaymentTypeId = 4, PaymentTypeName = "Pay Advance" }
                };
                    break;

                case "SERVICE BILL(IN)":
                    PaymentTypeList = new List<PaymentTypeModel>
                {
                    new() { PaymentTypeId = 1, PaymentTypeName = "Manual Selection" },
                    new() { PaymentTypeId = 2, PaymentTypeName = "Automatic Adjust" }
                };
                    break;

                case "SALARY":
                    PaymentTypeList = new List<PaymentTypeModel>
