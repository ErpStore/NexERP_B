    private async Task LoadVendorByExpenseType(string expenseType)
    {
        try
        {
            PartyListDisplay.Clear();
            AllPartys.Clear();
            FilteredBills.Clear();
            Bills.Clear();
            PaymentsVMs.PaymentSubVM.Clear();
            PaymentsVMs.Amount = 0;
            AllPartys = await _PaymentsService.GetVendorsByPurchaseTypeAsync(expenseType,PaymentsVMs.PaymentTypeName);
            PartyListDisplay = AllPartys;

            if (!string.IsNullOrWhiteSpace(PartySearch))
            {
                await FilterVendorList();
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadVendorByExpenseType failed.");
        }

    }


    public async Task ValidateBillAdjust(ChangeEventArgs e, PaymentSubVM bill)
    {

        if (!decimal.TryParse(e.Value?.ToString(), out var input)) return;

        bill.AdjustAmount = input;

        if (!decimal.TryParse(e.Value?.ToString(), out decimal newAdj))
            return;

        bill.AdjustAmount = newAdj;

        if (bill.PaymentSubId > 0)
        {
            decimal savedAdj = bill.SavedAdjustAmount;
            decimal realBalance = bill.BalanceAmount;
            decimal originalBillAmount = savedAdj + realBalance;

            if (newAdj + savedAdj > originalBillAmount)
            {
                JS.ToastrError($"Adjustment exceeds bill amount. Max allowed: {originalBillAmount - savedAdj}");
                bill.AdjustAmount = originalBillAmount - savedAdj;
            }
        }


        if (bill.AdjustAmount > bill.BalanceAmount)
        {
            bill.AdjustAmount = bill.BalanceAmount;
            await JS.ToastrWarning("Amount exceeds Bill balance. Adjusted to maximum allowed.");
        }

        if (bill.AdjustAmount < 0)
            bill.AdjustAmount = 0;


        var totalAdjusted = PaymentsVMs.PaymentSubVM.Sum(x => x.AdjustAmount);

        if (PaymentType == "Manual Selection")
        {
            PaymentsVMs.Amount = totalAdjusted;
        }
        else if(PaymentType=="OPENING BALANCE")
        {
            if(PaymentsVMs.Amount> PartyVMs.OpeningBalancePending)
            {
                await JS.ToastrWarning("Amount exceeds pending opening balance. Adjusted to maximum allowed.");

                PaymentsVMs.Amount = PartyVMs.OpeningBalancePending;
                StateHasChanged();
                return;
            }

        }
        else
        {

            if (totalAdjusted > bill.AdjustAmount)
            {
                var excess = totalAdjusted - bill.AdjustAmount;
                bill.AdjustAmount -= excess;
                await JS.ToastrWarning("Amount exceeds Bill balance. Adjusted to maximum allowed.");
                if (bill.AdjustAmount < 0)
                    bill.AdjustAmount = 0;
            }
            totalAdjusted = PaymentsVMs.PaymentSubVM.Sum(x => x.AdjustAmount);
            PaymentsVMs.Amount = totalAdjusted;
        }

        StateHasChanged();
        EnforceAdjustmentLimit();
        /// AutoAdjust();
        // StateHasChanged();
    }

