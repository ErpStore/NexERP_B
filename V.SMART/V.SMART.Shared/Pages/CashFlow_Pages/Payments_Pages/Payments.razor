    public async Task FilterBills()
    {
        if (SelectedParty == null)
        {
            FilteredBills.Clear();
            return;
        }

        var search = BillSearch?.Trim().ToLowerInvariant() ?? "";
        var linkedIds = PaymentsVMs.PaymentSubVM.Select(x => x.RefId).ToHashSet();

        var linkedBills = Bills.Where(b => linkedIds.Contains(b.Id)).ToList();

        var unlinkedBills = Bills
            .Where(b => b.PartyCode == SelectedParty.PartyCode && !linkedIds.Contains(b.Id))
            .Where(b => string.IsNullOrEmpty(search) ||
                        b.BillNo.ToLowerInvariant().Contains(search) ||
                        b.Id.ToString().Contains(search))
            .OrderByDescending(b => b.BillDate)
            .ThenBy(b => b.BillNo)
            .ToList();
        if (PaymentsVMs.PaymentId > 0)
        {
            foreach (var bill in linkedBills)
            {
                var row = PaymentsVMs.PaymentSubVM.FirstOrDefault(x => x.RefId == bill.Id);

                if (row != null && row.PaymentSubId > 0)
                {
                    decimal savedAdj = await _PaymentsService.GetPaymentSubAmountByIdAsync(row.PaymentSubId??0);

                    decimal realBal = bill.Balance;

                    decimal originalBillAmount = savedAdj + realBal;

                    row.BalanceAmount = savedAdj + realBal;

                    if (row.AdjustAmount > originalBillAmount)
                    {
                        row.AdjustAmount = originalBillAmount;
                        await JS.ToastrError($"Bill {row.BillNo}: Adjust exceeds original bill amount!");
                    }
                }
                else if (row != null) 
                {

                    row.BalanceAmount = bill.Balance;
                }
            }
        }


        if (!linkedBills.Any() && !unlinkedBills.Any() && PaymentsVMs.PaymentSubVM.Any())
        {
            foreach (var row in PaymentsVMs.PaymentSubVM)
            {
                row.BalanceAmount = row.AdjustAmount; 
            }
        }

        FilteredBills = unlinkedBills;
        ActiveTab = TAB_BILLS;

        StateHasChanged();
    }



    public async Task AddBill(BillsVM b)
    {
        PaymentsVMs.PaymentSubVM ??= new List<PaymentSubVM>();

        if (PaymentsVMs.PaymentSubVM.Any(x => x.RefId == b.Id))
            return;

        PaymentsVMs.PaymentSubVM.Add(new PaymentSubVM
        {
            RefId = b.Id,
            BillNo = b.BillNo,
            BillDate = b.BillDate,
            BalanceAmount = b.Balance,
            AdjustAmount = b.Balance
        });

        FilterBills();
        ActiveTab = TAB_LINKED;

        PaymentsVMs.Amount = PaymentsVMs.PaymentSubVM.Sum(x => x.AdjustAmount);

        StateHasChanged();
    }


    public async Task RemoveBill(PaymentSubVM bill)
    {
        PaymentsVMs.PaymentSubVM.Remove(bill);
        if(PaymentsVMs.PaymentId>0)
        {
            var oldItem = new PaymentsSub
            {
                RefId = bill.RefId??0,
                AdjustAmount = bill.AdjustAmount
            };

            await _PaymentsService.UpdatePendingBalanceAsync(
                PaymentsVMs.ExpenseName,
                new List<PaymentSubVM>(),     // no new adjustment
                new List<PaymentsSub> { oldItem } // revert the old adjustment
            );
            bool success  =await _PaymentsService.DeletePaymentSubidAsync(bill.PaymentSubId??0);
            if (success)

            {
                await JS.ToastrSuccess("Payments Deleted successfully.");
                Bills = await _PaymentsService.GetBillsByVendorAsync(PaymentsVMs.PayToRefCode??0, PaymentsVMs.ExpenseName);
                FilteredBills = Bills;
            }
            else
            {
                await JS.ToastrError("Payments Delete failed.");
            }
        }

        FilterBills();
        PaymentsVMs.Amount = PaymentsVMs.PaymentSubVM.Sum(x => x.AdjustAmount);
        StateHasChanged();
    }


    public async Task OnPaymentTypeChanged()
    {
        var selected = PaymentTypeList
            .FirstOrDefault(x => x.PaymentTypeId == SelectedPaymentTypeId);

        PaymentsVMs.PaymentTypeId = selected?.PaymentTypeId ?? 0;
        PaymentsVMs.PaymentTypeName = selected?.PaymentTypeName ?? "";
        PaymentType = PaymentsVMs.PaymentTypeName;
        PartySearch = "";
        // 🔵 ADVANCE / OPENING BAL → NO BILL LOGIC
