    #region UtilityQty

    private async Task OnUtilQtyChanged(ChangeEventArgs e, AssemblyDefLabourVM assyVM)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty))
                return;

            if (assyVM.Id == 0)
            {
                assyVM.UtilQty = newQty;
                assyVM.BalQty = newQty;
            }
            else
            {
                var original = await _assyDefService.GetUtiliyQtyById(assyVM.Id);
                var alreadyTransacted = original.UtilQty - original.BalQty;

                if (newQty < alreadyTransacted)
                {
                    assyVM.UtilQty = alreadyTransacted;
                    assyVM.BalQty = 0;
                    await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} as it is already transacted.");
                }
                else
                {
                    var difference = newQty - original.UtilQty;
                    assyVM.UtilQty = newQty;
                    assyVM.BalQty = original.BalQty + difference;
                }
            }
            await CalculateRowCosts();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in OnUtilQtyChanged");
            await _js.ToastrError("Unexpected error while updating Utility Qty.");
        }
    }

