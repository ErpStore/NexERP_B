    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.PartItemCode;

            if (rowToDelete.Id > 0)
            {
                await _assyDefService.DeleteAndResequenceAsync(rowToDelete);
                bomRows.Remove(rowToDelete);
                await ResetSlno();
                StateHasChanged();
            }
            else
            {
                bomRows.Remove(rowToDelete);

                if (!bomRows.Any())
                {
                    bomRows.Add(new AssemblyDefLabourVM
                    {
                        AssmblyID = assemblyDef.AssmblyID,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    await ResetSlno();
                }
            }

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error confirming deletion for Assembly Child Item: {rowToDelete.PartItemCode}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

