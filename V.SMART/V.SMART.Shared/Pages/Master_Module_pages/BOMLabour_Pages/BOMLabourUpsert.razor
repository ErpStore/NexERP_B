    #region Row Operations

    private async Task<bool> ValidateRowAsync(AssemblyDefLabourVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null || row.ItemId <= 0)
                errors.Add("Please select an Item.");

            if (row.UtilQty <= 0)
                errors.Add("Utilization quantity must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await _logs.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = bomRows.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await _logs.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (!await ValidateLastRowAsync()) return;

            var newRow = new AssemblyDefLabourVM
            {
                Id = 0,
                IsEditable = true,
                SlNo = bomRows.Count + 1,
                AssmblyID = assemblyDef.AssmblyID,
                IsComponent = assemblyDef.IsComponent,
                Cancel = false
            };

            bomRows.Add(newRow);

            await ResetSlno();
           
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await _logs.LogDeveloperError(ex, "AddRow failed.");
        }
    }

    private async Task SaveRow(AssemblyDefLabourVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            if (!bomRows.Any())
                bomRows.Add(item);




            await ResetSlno();
            await CalculateRowCosts();
            StateHasChanged();

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"SaveRow failed for Row Id: {item?.Id}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(AssemblyDefLabourVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItemVMs == null && item.ItemId.HasValue && item.ItemId.Value > 0)
            {
                try
                {
                    item.SelectedItemVMs = await _assyDefService.GetItemByItemIdAsync(item.ItemId.Value);
                    await CalculateRowCosts();
                }
                catch
                {
                }
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"EditRowAsync failed for Row Id: {item?.Id}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(AssemblyDefLabourVM? item)
    {
        try
        {
            if (item == null) return;

            bool isEmptyOrInvalid =
                (item.ItemId == null || item.ItemId <= 0) ||
                (item.UtilQty <= 0 && (item.ReqQty <= 0 || item.BalQty <= 0));

            if (isEmptyOrInvalid)
            {
                if (item.Id == 0)
                {
                    bomRows.Remove(item);
                    await ResetSlno();
                    await CalculateRowCosts();
                }
                else
                {
                    item.IsEditable = false;
                }
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CancelEdit failed for Row Id: {item?.Id}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(AssemblyDefLabourVM item)
    {
        try
        {
            if (bomRows.Count == 1 && item.Id > 0)
            {
                await _js.ToastrWarning("At least one row item is required.");
                return;
            }

            if (item.Id > 0 && (item.UtilQty != item.BalQty))
            {
                await _js.ToastrWarning("This row cannot be deleted because transactions exist for it.");
                return;
            }

            if (item.Id == 0)
            {
                bomRows.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");
                if (!bomRows.Any()) bomRows = new List<AssemblyDefLabourVM>();

                await ResetSlno();
                await CalculateRowCosts();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
