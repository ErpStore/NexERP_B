    #region Bom Operations/ Update or Insert

    private async Task UpsertBOM()
    {
        try
        {
            isProcessing = true;

            if (!bomRows.Any())
            {
                await _js.ToastrError("Cannot save a BOM without valid items.");
                return;
            }

            foreach (var line in bomRows)
            {
                bool isValid = await ValidateBOMLineAsync(line);
                if (!isValid) return;
            }

            bool isNew = await _assyDefService.IsNewBOMAsync(assemblyDef.AssmblyID.Value);

            await _assyDefService.UpsertBOMAsync(isNew, assemblyDef, bomRows);

            if (isNew)
                await _js.ToastrSuccess("BOM created successfully.");
            else
                await _js.ToastrSuccess("BOM updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/bomLabourList");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "UpsertBOM failed.");
            await _js.ToastrError("Error saving BOM.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateBOMLineAsync(AssemblyDefLabourVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.UtilQty.HasValue || line.UtilQty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Utilized Quantity must be greater than 0.");
                return false;
            }
            return true;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ValidateBOMLineAsync failed.");
            await _js.ToastrError("Error Validate BOM LineAsync BOM line.");
            return false;
        }
    }

