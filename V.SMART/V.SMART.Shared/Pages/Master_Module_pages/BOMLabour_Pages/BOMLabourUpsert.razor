@page "/bomLabour/create"
@page "/bomLabour/update/{AssmblyID:int}"

@inherits BaseUserRightsComponent

@using V.SMART.Shared.BusinessLayer.BusinessService.MasterService.InventoryService
@using MudBlazor

@inject ILoggingService _logs
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject IAssemblyDefLabourService _assyDefService
@inject IExcelTemplateService excelTemplateService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle>
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <PageHeader TitleText="Bill of Material"
                        TitleIcon="bi bi-diagram-3-fill"
                        Breadcrumbs="@bomBreadcrumbs" />

            <div class="card-body">
                <div class="accordion" id="bomAccordion">
                    <div class="accordion-item border-0">
                        <h2 class="accordion-header" id="headingAssembly">
                            <button class="accordion-button fw-semibold" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseAssembly"
                                    aria-expanded="true"
                                    aria-controls="collapseAssembly">
                                <i class="bi bi-box-seam me-2"></i> Assembly Details
                            </button>
                        </h2>

                        <div id="collapseAssembly"
                             class="accordion-collapse collapse show"
                             aria-labelledby="headingAssembly"
                             data-bs-parent="#bomAccordion">
                            <div class="accordion-body bg-light rounded-3">
                                @if (assemblyDef != null)
                                {
                                    <EditForm Model="@bomRows" OnValidSubmit="UpsertBOM">
                                        <ObjectGraphDataAnnotationsValidator />
                                        <ValidationSummary />

                                        <div class="row mb-3 align-items-center">
                                            <label class="col-12 form-label fw-semibold">
                                                @(assemblyDef.IsComponent ? "Select Component Item" : "Select Assembly Item")
                                            </label>

                                            <div class="col-md-4">
                                                <MudAutocomplete T="ItemVM"
                                                                 Value="assemblyDef.SelectedAssyItemVMs"
                                                                 ValueChanged="@(async item =>
                                                                                                                                                     {
                                                                     if (assemblyDef.IsComponent)
                                                                         await OnComponentChanged(item);
                                                                     else
                                                                         await OnAssemblyChanged(item);
                                                                 })"
                                                                   ToStringFunc="@(item => item?.ItemCode.Trim() ?? string.Empty)"
                                                                   SearchFunc="@(assemblyDef.IsComponent
                                                                                                                                                     ? SearchBOMAssinedComponentItems
                                                                                                                                     : SearchAssySubAssyItems)"
                                                         Dense="true"
                                                         Variant="Variant.Outlined"
                                                         Placeholder="@(assemblyDef.IsComponent ? "Search Component Item" : "Search Assembly Item")"
                                                         Class="w-100 autocomplete-sm"
                                                         MaxItems="50"
                                                         OnBlur="@(e => TrimAutocompleteValue())" />
                                        <ValidationMessage For="@(() => assemblyDef.AssmblyID)" />
                                    </div>

                                            <div class="col-md-4 ">
                                                <div class="form-floating">
                                                    <InputText @bind-Value="assemblyDef.AssemblyItemName"
                                                               class="form-control rounded-3"
                                                               id="Description" readonly />

                                                </div>
                                            </div>

                                            <div class="col-md-4 d-flex align-items-center justify-content-start mt-4 mt-md-0">
                                                <div class="form-check form-switch d-flex align-items-center">
                                                    <InputCheckbox @bind-Value="assemblyDef.IsComponent"
                                                                   id="componentCheck"
                                                                   class="form-check-input me-2"
                                                                   disabled="@(bomRows.Any(r => !string.IsNullOrWhiteSpace(r.PartItemCode)))" />
                                                    <label for="componentCheck" class="@($"fw-semibold rounded px-2 py-1 shadow-sm {(assemblyDef.IsComponent ? "bg-success text-white" : "bg-light text-dark")}")">
                                                        As Components
                                                    </label>
                                                </div>
                                            </div>

                                        </div>
                                        <div>
                                            <!-- Cost Summary Cards -->
                                    @if (assemblyDef.AssmblyID > 0 && !assemblyDef.IsComponent)
                                            {
                                                <div class="row mb-4">
                                                    <div class="col-md-3">
                                                        <div class="card bg-primary text-white">
                                                            <div class="card-body">
                                                                <h6 class="card-title">Total Material Cost</h6>
                                                                <h4 class="mb-0">@string.Format("{0:N2}", totalMaterialCost)</h4>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="card bg-success text-white">
                                                            <div class="card-body">
                                                                <h6 class="card-title">Total Labor Cost</h6>
                                                                <h4 class="mb-0">@string.Format("{0:N2}", totalLaborCost)</h4>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="card bg-warning text-white">
                                                            <div class="card-body">
                                                                <h6 class="card-title">Grand Total</h6>
                                                                <h4 class="mb-0">@string.Format("{0:N2}", FinalGrandTotal)</h4>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="card bg-info text-white">
                                                            <div class="card-body">
                                                                <h6 class="card-title">Assembly Cost </h6>
                                                                <h4 class="mb-0">@string.Format("{0:N2}", AssemblyCost)</h4>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        

                                        <!-- Component Table -->
                                        <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto; overflow-x: auto;">
                                            <table class="table table-bordered table-sm align-middle text-center mb-0"
                                                   style="table-layout: fixed; min-width: 1200px;">
                                                <thead class="custom-blue sticky-top" style="z-index: 2;">
                                                    <tr>
                                                        <th style="width: 60px;">Sl No.</th>
                                                        <th style="width: 140px;">Item Code</th>
                                                        <th style="width: 240px;">Item Name</th>
                                                        <th style="width: 80px;">UOM</th>
                                                        <th style="width: 100px;">Utility Qty</th>
                                                        <th style="width: 100px;">Unit Cost</th>
                                                        <th style="width: 100px;">Material Cost</th>
                                                @if (assemblyDef.IsComponent)
                                                        {
                                                            <th style="width: 120px;">Process</th>
                                                        }
                                                        <th style="width: 90px;">Cancel</th>
                                                        @* SNS *@
                                                        <th style="width: 200px;">Customer Material</th>

                                                        <th style="width: 220px;">Remarks</th>
                                                        <th style="width: 150px;">Rack No.</th>
                                                        @* <th style="width: 120px;">Action</th> *@
                                                        <th style="width:100px;" class="freeze-last-col">

                                                            <div class="d-flex align-items-center justify-content-end gap-2">

                                                                <button type="button" class="btn btn-sm @(IsAllEditable ? "btn-success" : "btn-danger")"
                                                                        title="Lock / Unlock All Rows" @onclick="ToggleAllEditable">

                                                                    <i class="bi @(IsAllEditable ? "bi-unlock-fill" : "bi-lock-fill")"></i>

                                                                </button>

                                                                <span>Action</span>

                                                            </div>

                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody class="custom-size">
                                                    @if (bomRows?.Any() == true)
                                                    {
                                                        @foreach (var row in bomRows)
                                                        {
                                                            <tr @ondblclick="() => OnRowDoubleClick(row)">
                                                                <td>@row.SlNo</td>
                                                                <td>
                                                                    @if (row.IsEditable)
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                         Value="row.SelectedItemVMs"
                                                                                         ValueChanged="@(async item => await OnItemChanged(row, item))"
                                                                                         ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                         SearchFunc="@(assemblyDef.IsComponent
                                                                                                                                                                                       ? SearchOnlyComponentItems
                                                                                                                                                                 : SearchSubAssyAndItemsAsync)"
                                                                     Dense="true"
                                                                     Variant="Variant.Outlined"
                                                                     Placeholder="Search Item"
                                                                     Class="w-100 autocomplete-sm"
                                                                     MaxItems="50" />
                                                    <ValidationMessage For="@(() => row.ItemId)" />
                                                                                                        }
                                                                    else
                                                                    {

                                                                        <span>@row.PartItemCode</span>
                                                                    }
                                                                </td>
                                                                <td class="text-start">@row.PartItemName</td>
                                                                <td>@row.UOM</td>
                                                                <td>
                                                                    @if (row.IsEditable)
                                                                    {
                                                                        <input type="number"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="Utility Qty"
                                                                               title="Enter Utility Qty"
                                                                               step="any"
                                                                               @bind="row.UtilQty"
                                                                               @bind:event="oninput"
                                                                               @onchange="@(e => OnUtilQtyChanged(e, row))" />
                                                                        <ValidationMessage For="@(() => row.UtilQty)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @row.UtilQty
                                                                    }
                                                                </td>

                                                                <td class="text-end">@string.Format("{0:N2}", row.UnitPrice)</td>
                                                                <td class="text-end">@string.Format("{0:N2}", row.MaterialCost)</td>
                                                                @* <td>@row.UnitPrice</td>
                                                                <td>@row.MaterialCost</td> *@

                                                                @if (assemblyDef.IsComponent)
                                                                {
                                                                    <td>
                                                                        <select class="form-control form-control-sm"
                                                                                @bind="row.ProcessId">
                                                                            <option value="0">-- Select Process --</option>
                                                                            @foreach (var p in process)
                                                                            {
                                                                                <option value="@p.ProcessId">
                                                                                    @p.ProcessName
                                                                                </option>
                                                                            }
                                                                        </select>
                                                                        <ValidationMessage For="@(() => row.ProcessId)" />
                                                                    </td>
                                                                }

                                                                <td class="text-center align-middle">
                                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                                        <InputCheckbox @bind-Value="row.Cancel"
                                                                                       @bind-Value:event="onchange"
                                                                                       ValueChanged="@(async (value) => await OnItemCancelChanged(row))"
                                                                                       class="form-check-input border border-2 shadow-lg focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                                    </div>
                                                                    <ValidationMessage For="@(() => row.Cancel)"
                                                                                       class="text-danger fw-semibold small mt-2 d-block" />

                                                                </td>
                                                                <td class="text-center align-middle">
                                                                    <div class="form-check form-switch d-flex justify-content-center">

                                                                        <InputCheckbox @bind-Value="row.IsLabourMaterial"
                                                                                       class="form-check-input border border-2 shadow-lg p-2 fs-4 rounded-pill" />

                                                                    </div>

                                                                    <ValidationMessage For="@(() => row.IsLabourMaterial)"
                                                                                       class="text-danger fw-semibold small mt-2 d-block" />
                                                                </td>

                                                                <td>
                                                                    @if (row.IsEditable)
                                                                    {
                                                                        <InputTextArea @bind-Value="row.Remarks" Rows="1" class="form-control form-control-sm" />
                                                                        <ValidationMessage For="@(() => row.Remarks)" />
                                                                    }
                                                                    else
                                                                    {

                                                                        @row.Remarks
                                                                    }
                                                                </td>

                                                                <td>
                                                                    @row.RackNo
                                                                </td>

                                                                <td class="text-end">
                                                                    @if (row.IsEditable)
                                                                    {
                                                                        <button type="button" class="btn btn-success btn-sm me-1"
                                                                                title="Save" @onclick="async () => await SaveRow(row)">
                                                                            <i class="bi bi-check-lg"></i>
                                                                        </button>
                                                                        <button type="button" class="btn btn-secondary btn-sm"
                                                                                title="Cancel" @onclick="async () => await CancelEdit(row)">
                                                                            <i class="bi bi-x-lg"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-primary btn-sm me-1"
                                                                                title="Edit" @onclick="async () => await EditRowAsync(row)">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>
                                                                        <button type="button" class="btn btn-danger btn-sm"
                                                                                title="Delete" @onclick="async () => await RemoveRow(row)">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="8" class="text-center text-muted">No records found.</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- Footer Controls -->
                                        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>

                                        <div class="row mb-2">
                                            @if (CanCreate || CanEdit)
                                            {
                                                <div class="col-6 col-md-3 mt-3">
                                                    <button type="submit" class="btn btn-primary w-100" disabled="@isProcessing">
                                                        <i class="bi bi-floppy2-fill me-1"></i> @(IsAssyExistsinAssydef ? "Update" : "Create")
                                                    </button>
                                                </div>

                                               @*  @if (IsAssyExistsinAssydef)
                                                {
                                                    <div class="col-6 col-md-3 mt-3">
                                                        <button type="button" class="btn btn-outline-secondary w-100"
                                                                @onclick="OnPrintBOMModifyTrack">
                                                            <i class="bi bi-printer-fill me-1"></i> Print BOM Modify Track
                                                        </button>
                                                    </div>
                                                } *@

                                            }
                                            <div class="col-6 col-md-3 mt-3">
                                                <SmartBackButton Url="@($"/bomLabourList?currentPage={currentPage}")" />
                                            </div>
                                        </div>
                                    </EditForm>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
}


@code {
    [Parameter] public int? AssmblyID { get; set; }

    protected override string ScreenName => "BOM Labour";

    private bool isProcessing = true;

    private AssemblyDefLabourVM assemblyDef = new();
    private List<AssemblyDefLabourVM> bomRows = new();

    private AssemblyDefLabourVM? rowToDelete = null;
    private AssemblyDefLabourVM? rowToCancel = null;
    private AssemblyDefLabourVM? rowToView = null;
    private bool IsAssyExistsinAssydef { get; set; } = false;
    private List<AssemblyChargeVM> AssemblyChargeVMs = new();

    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private IEnumerable<Process> process = Enumerable.Empty<Process>();

    private bool IsAllSelected => bomRows != null && bomRows.All(r => r.IsSelected);


    // Cost summary properties
    private decimal totalMaterialCost = 0;
    private decimal totalLaborCost = 0;
    private decimal totalOverheadCost = 0;
    private decimal grandTotalCost = 0;

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    private decimal ExtraChargesTotal =>
        AssemblyChargeVMs.Sum(x => x.CalculatedAmount ?? 0m);

    private decimal MaterialCost =>
       bomRows?
           .Where(x => !x.IsLabourMaterial)
           .Sum(x => x.MaterialCost ?? 0) ?? 0;

    private decimal LabourCost =>
        bomRows?
            .Where(x => x.IsLabourMaterial)
            .Sum(x => x.MaterialCost ?? 0) ?? 0;
    private decimal AssemblyCost =>
    bomRows?.FirstOrDefault()?.AssemblyCost ?? 0m;

    private decimal FinalGrandTotal =>
        MaterialCost + LabourCost + ExtraChargesTotal;


    private List<PageHeader.BreadcrumbItem> bomBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "Inventory" },
        new PageHeader.BreadcrumbItem { Text = "BOM Labour", IsLast = true }
    };
    private bool IsAllEditable;

    private void TrimAutocompleteValue()
    {
        if (assemblyDef?.SelectedAssyItemVMs?.ItemCode != null)
        {
            assemblyDef.SelectedAssyItemVMs.ItemCode = assemblyDef.SelectedAssyItemVMs.ItemCode.Trim();
        }
    }

    private async Task SelectAll(int rowId)
    {
        await _js.InvokeVoidAsync("selectInputText", $"ReqQty-{rowId}");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            if (AssmblyID > 0)
            {
                var Assy = await _assyDefService.GetAssyByAssemblyIdAsync(AssmblyID.Value);

                assemblyDef.AssmblyID = AssmblyID;
                assemblyDef.AssemblyItemCode = Assy.AssemblyItemCode;
                assemblyDef.AssemblyItemName = Assy.AssemblyItemName;
                assemblyDef.SelectedAssyItemVMs = await _assyDefService.GetItemByItemIdAsync(AssmblyID);
                assemblyDef.AssemblyPrice = Assy.AssemblyPrice;
                assemblyDef.IsComponent = Assy.IsComponent;

                await LoadSelectedProcessAsync(assemblyDef.AssmblyID.Value);

                bomRows = await _assyDefService.GetAssemblyDefByAssemblyIdAsync(AssmblyID.Value);
                IsAssyExistsinAssydef = await _assyDefService.IsAssyExistsInAssyDefAsync(assemblyDef.AssmblyID.Value);
                await CalculateRowCosts();
            }
            else
            {
                assemblyDef = new AssemblyDefLabourVM();
                bomRows.Clear();
            }

            isProcessing = false;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error on OnInitializedAsync ");
        }
    }

    #region Assembly and Item Handlers

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool isChecked = e?.Value is bool b && b;
        foreach (var row in bomRows)
            row.IsSelected = isChecked;
    }

    private void OnRowSelected(AssemblyDefLabourVM row, object? value)
    {
        if (value is bool isChecked)
            row.IsSelected = isChecked;
    }

    private async Task OnAssemblyChanged(ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                assemblyDef.AssmblyID = item.ItemId;
                assemblyDef.AssemblyItemCode = item.ItemCode;
                assemblyDef.AssemblyItemName = item.ItemName;
                assemblyDef.SelectedAssyItemVMs = item;
                assemblyDef.AssemblyCost = item.AssemblyPrice;

                bomRows = await _assyDefService.GetAssemblyDefByAssemblyIdAsync(item.ItemId);

                if (bomRows.Any())
                {
                    foreach (var sub in bomRows)
                    {
                        await CalculateRowCosts();
                    }
                   
                }
               
                await ResetSlno();

                IsAssyExistsinAssydef = await _assyDefService.IsAssyExistsInAssyDefAsync(assemblyDef.AssmblyID.Value);
                await AddRow();
            }
            else
            {
                assemblyDef.AssmblyID = null;
                assemblyDef.AssemblyItemCode = null;
                assemblyDef.AssemblyItemName = null;
                assemblyDef.SelectedAssyItemVMs = null;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error on OnAssemblyChanged");
            await _js.ToastrError("Failed to process assembly selection. Please try again.");
        }
    }


    private async Task OnComponentChanged(ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                assemblyDef.AssmblyID = item.ItemId;
                assemblyDef.AssemblyItemCode = item.ItemCode;
                assemblyDef.AssemblyItemName = item.ItemName;
                assemblyDef.SelectedAssyItemVMs = item;

                bomRows = await _assyDefService.GetAssemblyDefByAssemblyIdAsync(item.ItemId);

                if (bomRows.Count == 0)
                {
                    await AddRow();
                }

                await ResetSlno();

                IsAssyExistsinAssydef =
                    await _assyDefService.IsAssyExistsInAssyDefAsync(assemblyDef.AssmblyID.Value);

                await LoadSelectedProcessAsync(assemblyDef.AssmblyID.Value);
            }
            else
            {
                assemblyDef.AssmblyID = null;
                assemblyDef.AssemblyItemCode = null;
                assemblyDef.AssemblyItemName = null;
                assemblyDef.SelectedAssyItemVMs = null;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in OnComponentChanged");
            await _js.ToastrError("Failed to process component selection. Please try again.");
        }
    }


    private async Task<IEnumerable<ItemVM>> SearchSubAssyAndItemsAsync(string value, CancellationToken token)
    {
        value = value?.Trim();
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        try
        {
            var results = await _assyDefService.SearchSubAssyAndItemsAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<ItemVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<ItemVM>();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"SearchItems failed for value: {value}");
            await _js.ToastrError("Failed to search items. Please try again.");
            return Enumerable.Empty<ItemVM>();
        }
    }

    private async Task<IEnumerable<ItemVM>> SearchOnlyComponentItems(string value, CancellationToken token)
    {
        value = value?.Trim();
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        try
        {
            var results = await _assyDefService.SearchOnlyComponentItems(value);
            token.ThrowIfCancellationRequested();

            return results?.Take(50) ?? Enumerable.Empty<ItemVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<ItemVM>();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"SearchItems failed for value: {value}");
            await _js.ToastrError("Failed to search items. Please try again.");
            return Enumerable.Empty<ItemVM>();
        }
    }

    private async Task<IEnumerable<ItemVM>> SearchAssySubAssyItems(string value, CancellationToken token)
    {
        value = value?.Trim();
        assemblyDef.AssemblyItemCode = value;
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        try
        {
            var results = await _assyDefService.SearchAssyAndSubAssyItemsAsync(value);

            token.ThrowIfCancellationRequested();

            return results?.Take(50) ?? Enumerable.Empty<ItemVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<ItemVM>();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"SearchAssySubAssyItems failed for value: {value}");
            await _js.ToastrError("Failed to search items. Please try again.");
            return Enumerable.Empty<ItemVM>();
        }
    }


    private async Task<IEnumerable<ItemVM>> SearchBOMAssinedComponentItems(string value, CancellationToken token)
    {
        value = value?.Trim();
        assemblyDef.AssemblyItemCode = value;
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        try
        {
            var results = await _assyDefService.SearchBOMAssinedComponentItems(value);

            token.ThrowIfCancellationRequested();

            return results?.Take(50) ?? Enumerable.Empty<ItemVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<ItemVM>();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"SearchBOMAssinedComponentItems failed for value: {value}");
            await _js.ToastrError("Failed to search items. Please try again.");
            return Enumerable.Empty<ItemVM>();
        }
    }


    private async Task OnItemChanged(AssemblyDefLabourVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItemVMs = item;
                subitem.ItemId = item.ItemId;
                subitem.PartItemCode = item.ItemCode;
                subitem.PartItemName = item.ItemName;
                subitem.UOM = item.MeasureUnit;
                await CalculateRowCosts();

            }
            else
            {
                subitem.SelectedItemVMs = null;
                subitem.ItemId = null;
                subitem.PartItemCode = null;
                subitem.PartItemName = null;
                subitem.UOM = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
