    public async Task UpsertLabBbom()
    {

        try
        {
            isProcessing = true;
            string createdBy = await _userService.GetUsernameAsync();

            // Get valid records only (exclude rows where Assembly is missing)
            var validRecords = processedRows
                .Where(r => !string.IsNullOrEmpty(GetCellValue(r, "AssmblyID")))
                .Select(r => new AssemblyDefLabourVM
                {
                    AssmblyID = int.TryParse(GetCellValue(r, "AssmblyID"), out var assemblyId) ? assemblyId : (int?)null,
                    AssemblyItemCode = GetCellValue(r, "AssemblyItemCode"),
                    AssemblyItemName = GetCellValue(r, "AssemblyItemName"),
                    AssemblyUOM = GetCellValue(r, "AssemblyUOM"),
                    AssemblyUnitPrice = decimal.TryParse(GetCellValue(r, "AssemblyUnitPrice"), out var assmPrice) ? assmPrice : (decimal?)null,
                    AssemblyCategoryName = GetCellValue(r, "AssemblyCategoryName"),
                    ItemId = int.TryParse(GetCellValue(r, "ItemId"), out var itemId) ? itemId : (int?)null,
                    PartItemCode = GetCellValue(r, "PartItemCode"),
                    PartItemName = GetCellValue(r, "PartItemName"),
                    UOM = GetCellValue(r, "UOM"),
                    UnitPrice = decimal.TryParse(GetCellValue(r, "UnitPrice"), out var partPrice) ? partPrice : (decimal?)null,
                    CategoryName = GetCellValue(r, "CategoryName"),
                    UtilQty = decimal.TryParse(GetCellValue(r, "UtilQty"), out var qty) ? qty : 0,
                    BalQty = decimal.TryParse(GetCellValue(r, "UtilQty"), out var balqty) ? balqty : 0,
                    ReqQty = decimal.TryParse(GetCellValue(r, "UtilQty"), out var reqqty) ? reqqty : 0,
                    LabourPrice = decimal.TryParse(GetCellValue(r, "LabourPrice"), out var labour) ? labour : 0,
                    AssemblyPrice = decimal.TryParse(GetCellValue(r, "AssemblyPrice"), out var assm) ? assm : 0,
                    CreatedBy = createdBy,
                    CreatedDate = DateTime.Now,
                })
                .ToList();

            if (!validRecords.Any())
            {
                await _js.ToastrError("No valid records to save. Please fix Assembly Item errors.");
                return;
            }

            // Group records by Assembly ID to assign SlNo per Assembly
            var groupedByAssembly = validRecords
                .Where(r => r.AssmblyID.HasValue)
                .GroupBy(r => r.AssmblyID.Value)
                .ToDictionary(g => g.Key, g => g.ToList());

            int savedCount = 0;
            int updatedCount = 0;
            int skippedCount = 0;
            var duplicateRecords = new List<string>();

            foreach (var assemblyGroup in groupedByAssembly)
            {
                int assemblyId = assemblyGroup.Key;
                var records = assemblyGroup.Value;

                int currentMaxSlNo = await assemblyLabDefService.GetMaxSlNoByAssemblyIdAsync(assemblyId);
                int slNoCounter = currentMaxSlNo + 1;
                int MaxSlNoassembly = await assemblyDefService.GetMaxSlNoByAssemblyIdAsync(assemblyId);
                int slNoCount = MaxSlNoassembly + 1;

                foreach (var vm in records.OrderBy(r => r.PartItemCode))
                {
                    bool exists = await _unitOfWork.AssmblyDefLabs.ExistsAsync(
                        vm.AssmblyID ?? 0,
                        vm.ItemId ?? 0);

                    if (exists)
                    {

                        var existingEntity = await assemblyLabDefService.GetByAssemblyAndItemAsync(
                            vm.AssmblyID ?? 0,
                            vm.ItemId ?? 0);

                        if (existingEntity != null)
                        {

                            existingEntity.UtilQty = vm.UtilQty ?? 0;
                            existingEntity.BalQty = vm.BalQty ?? 0;
                            existingEntity.ModifiedBy = createdBy;
                            existingEntity.ModifiedDate = DateTime.Now;

                            await _unitOfWork.AssmblyDefLabs.UpdateAsync(existingEntity);

                        }

                    }
                    else
                    {

                        var entity = new AssemblyDefLabour
                        {
                            AssmblyID = vm.AssmblyID ?? 0,
                            ItemId = vm.ItemId ?? 0,
                            UtilQty = vm.UtilQty ?? 0,
                            BalQty = vm.BalQty ?? 0,

                            // Assign next SlNo
                            SlNo = slNoCounter,

                            CreatedBy = createdBy,
                            CreatedDate = DateTime.Now
                        };

                        await _unitOfWork.AssmblyDefLabs.CreateAsync(entity);

                        slNoCounter++;
                        savedCount++;
                    }
                    bool existAssembly = await _unitOfWork.AssmblyDefs.ExistsAsync(vm.AssmblyID ?? 0, vm.ItemId ?? 0);
                    var partItem = vm.ItemId.HasValue ? await assemblyDefService.GetItemByItemIdAsync(vm.ItemId.Value) : null;
                    bool isLabour = partItem.IsLabourItem;
                    if (existAssembly)
                    {

                        var existingEntity = await assemblyDefService.GetByAssemblyAndItemAsync(vm.AssmblyID ?? 0, vm.ItemId ?? 0);
                        if (!isLabour)
                        {
                            var existingEntityass = await assemblyDefService.GetByAssemblyAndItemAsync(
                                vm.AssmblyID ?? 0,
                                vm.ItemId ?? 0);
                            if (existingEntityass != null)
                            {

                                existingEntityass.UtilQty = vm.UtilQty ?? 0;
                                existingEntityass.BalQty = vm.BalQty ?? 0;
                                existingEntityass.ModifiedBy = createdBy;
                                existingEntityass.ModifiedDate = DateTime.Now;


                                await _unitOfWork.AssmblyDefs.UpdateAsync(existingEntityass);

                            }
                        }
                    }
                    else
                    {
                        if (!isLabour)
                        {
                            var entityAssmbly = new AssmblyDef
                            {
                                AssmblyID = vm.AssmblyID ?? 0,
                                ItemId = vm.ItemId ?? 0,
                                UtilQty = vm.UtilQty ?? 0,
                                BalQty = vm.BalQty ?? 0,
                                SlNo = slNoCount,
                                CreatedBy = createdBy,
                                CreatedDate = DateTime.Now
                            };
                            await _unitOfWork.AssmblyDefs.CreateAsync(entityAssmbly);
                        }
                        slNoCount++;

                    }
                }
            }

            // Save all changes
            await _unitOfWork.SaveAsync();

            // Show success message
            string message = $"BOM records processed successfully!";
            if (savedCount > 0) message += $" {savedCount} new record(s) saved.";
            if (updatedCount > 0) message += $" {updatedCount} record(s) updated.";
            if (skippedCount > 0) message += $" {skippedCount} record(s) skipped.";

            await JS.ToastrSuccess(message);

            // Log the action
            await LoggingService.LogUserAction(
                UserName: await _userService.GetUsernameAsync(),
                Machine: _userService.MachineName,
                IP_Address: _userService.IpAddress,
                screen: "BOM Upload",
                action: $"BOM Labour processed: {savedCount} saved, {updatedCount} updated, {skippedCount} skipped",
                additionalInfo: $"File: {SelectedFileName}");

            _navigationManager.NavigateTo("/bomLabourList");
        }
        catch (Exception ex)
        {
            await JS.ToastrError("An error occurred while saving BOM.");
            await LoggingService.LogDeveloperError(ex, "SaveBOM");
        }
        finally
        {
            isProcessing = false;
        }

        
    }




