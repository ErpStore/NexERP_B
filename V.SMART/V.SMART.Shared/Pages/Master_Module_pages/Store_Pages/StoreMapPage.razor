@page "/store-map"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.ISettingsService
@using V.SMART.Shared.Data.GeneralSettingsMaster
@inherits BaseUserRightsComponent

@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject IStoreMappingService _storeMapService
@inject ILoggingService _logs

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Page Header -->
            <PageHeader TitleText="Store Map"
                        TitleIcon="bi bi-map"
                        Breadcrumbs="@storeMapBreadcrumbs" />

            <div class="card-body">

                <!-- Search -->
                <div class="row mb-3">
                    <div class="col-12 col-md-6">
                        <input type="text" class="form-control" placeholder="Search by Screen Name or Store"
                               @bind="searchText" @bind:event="oninput" />
                    </div>
                </div>

                <EditForm Model="StoreMaps" OnValidSubmit="SaveStoreMap">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle">
                            <thead class="custom-blue">
                                <tr>
                                    <th style="width:5%">Sl No.</th>
                                    <th style="width:40%">Screen Name</th>
                                    <th style="width:55%">Store</th>
                                </tr>
                            </thead>
                            <tbody class="custom-size">
                                @foreach (var map in FilteredStoreMaps)
                                {
                                    <tr>
                                        <td>@map.SlNo</td>
                                        <td>@map.ScreenName</td>

                                        @if (map.FormName == "PMIssueForm" || map.FormName == "MaterialIssueForm"|| map.FormName == "ToolCribIssueForm" 
                                            || map.FormName == "PMIssueAssyForm" || map.FormName == "ProdLogIssueForm")
                                        {

                                            <td>
                                                <select class="form-select form-select-sm" @bind="map.StoreId">
                                                    <option value="">-- Select Store --</option>
                                                    @foreach (var store in IssueStores)
                                                    {
                                                        <option value="@store.StoreId">@store.StoreName</option>
                                                    }
                                                </select>
                                            </td>

                                        }
                                        else
                                        {
                                           <td>
                                                <select class="form-select form-select-sm" @bind="map.StoreId">
                                                    <option value="">-- Select Store --</option>
                                                    @foreach (var store in AllStores)
                                                    {
                                                        <option value="@store.StoreId">@store.StoreName</option>
                                                    }
                                                </select>
                                            </td>
 
                                        }

                                        
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </EditForm>

            </div>
        </div>
    </div>
}

@code {
    protected override string ScreenName => "Store Map";

    private bool isProcessing = true;
    private string searchText = string.Empty;

    private List<PageHeader.BreadcrumbItem> storeMapBreadcrumbs = new()
    {
        new() { Text = "Master" },
        new() { Text = "Inventory Master" },
        new() { Text = "Store Map Master", IsLast = true }
    };

    private List<StoreMap> StoreMaps { get; set; } = new();
    private List<Store> AllStores { get; set; } = new();
    private List<Store> IssueStores { get; set; } = new();

    private IEnumerable<StoreMap> FilteredStoreMaps =>
        string.IsNullOrWhiteSpace(searchText)
            ? StoreMaps
            : StoreMaps.Where(m =>
                m.ScreenName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                AllStores.FirstOrDefault(s => s.StoreId == m.StoreId)?.StoreName
                      ?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true
              );

    protected override async Task OnInitializedAsync()
    {
        await LoadRightsAsync();
        if (!CanView)
        {
            _navigationManager.NavigateTo("/access-denied");
            return;
        }

        await LoadStores();
        await LoadIssueStores();
        await LoadStoreMaps();

        isProcessing = false;
    }

    private async Task LoadStores()
    {
        try
        {
            var existing = await _storeMapService.GetAllActiveStoresAsync();
            AllStores = existing.ToList();

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error while LoadStores in StoreMapPages");
        }
    }

    private async Task LoadIssueStores()
    {
        try
        {
            var existing = await _storeMapService.GetAllStoreIssueAsync();
            IssueStores = existing.ToList();

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error while Load Issue Stores in StoreMapPages");
        }
    }

    private async Task LoadStoreMaps()
    {
        try
        {
            var existing = await _storeMapService.GetAllScreenStoreMapAsync();
            StoreMaps = existing.ToList();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error while LoadStoreMaps in StoreMapPages");
        }
    }

    private async Task SaveStoreMap()
    {
        try
        {
            isProcessing = true;

            await _storeMapService.SaveScreenStoreMapsAsync(StoreMaps);
            await _js.ToastrSuccess("Store map updated successfully.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error while saving store map");
            await _js.ToastrError("Failed to save store map.");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
