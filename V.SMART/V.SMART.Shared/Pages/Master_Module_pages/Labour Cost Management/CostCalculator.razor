    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "ItemCancel":
                    await CancelItem(rowToCancel);
                    break;

                case "Confirm_View":
                    await confirmViewRow_Click(true);
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.PartItemCode;

            if (rowToDelete.Id > 0)
            {
                await _assyDefService.DeleteAndResequenceAsync(rowToDelete);
                bomRows.Remove(rowToDelete);
                await ResetSlno();
                await CalculateSummaryTotals();
                StateHasChanged();
            }
            else
            {
                bomRows.Remove(rowToDelete);

                if (!bomRows.Any())
                {
                    bomRows.Add(new AssemblyDefLabourVM
                    {
                        AssmblyID = assemblyDef.AssmblyID,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    await ResetSlno();
                }
                await CalculateSummaryTotals();
            }

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error confirming deletion for Assembly Child Item: {rowToDelete.PartItemCode}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

