    private void AddSelectedItemToBOM(ItemVM item)
    {
        if (bomRows == null)
            bomRows = new List<AssemblyDefLabourVM>();

        // Check if already exists
        if (bomRows.Any(r => r.ItemId == item.ItemId)) 
            bomRows.Clear();

        var row = new AssemblyDefLabourVM
    {
        SlNo = bomRows.Count + 1,
        AssmblyID=item.ItemId,
        ItemId = item.ItemId,
        SelectedItemVMs = item,
        PartItemCode = item.ItemCode,
        PartItemName = item.ItemName,
        UOM = item.MeasureUnit,
        UtilQty = 1,
        BalQty=1,
        UnitPrice = item.Rate,
        MaterialCost = 1 * item.Rate,
        IsEditable = false,
        IsLabourMaterial = item.IsLabourItem
    };

        // Append to BOM table
        bomRows.Add(row);
    }
