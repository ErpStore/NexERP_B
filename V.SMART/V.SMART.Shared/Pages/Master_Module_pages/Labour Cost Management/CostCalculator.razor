        try
        {
            if (!string.Equals(row.CategoryName, "Assembly", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(row.CategoryName, "Sub-Assembly", StringComparison.OrdinalIgnoreCase))
            {
                await _js.ToastrInfo("The selected item does not belong to the Assembly or Sub-Assembly category.");
                return;
            }

            if (row.ItemId.HasValue)
            {
                ModalTitle = "Are you sure you want to view this Assembly/Sub-Assembly??";
                btnColor = "btn-primary";
                btnText = "Yes! View";
                confirmation = "Confirm_View";
            }
            else
            {
                await _js.ToastrError("ItemCode is missing or invalid.");
                return;
            }
            rowToView = row;

            await _js.InvokeVoidAsync("ShowConfirmationModal");

        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the OnRowDoubleClick method");
            await _logs.LogDeveloperError(ex, "Error in OnRowDoubleClick in BOM");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task confirmViewRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToView == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            if (!rowToView.ItemId.HasValue)
            {
                await _js.ToastrWarning("Item Code is missing for the selected row.");
                return;
            }

            var subAssembly = await _assyDefService.GetAssemblyDefByAssemblyIdAsync(rowToView.ItemId.Value);

            if (subAssembly != null && subAssembly.Any())
            {
                var mainAssembly = subAssembly.First(); // take the first assembly as main

                assemblyDef.AssmblyID = mainAssembly.AssmblyID;
                assemblyDef.AssemblyItemCode = mainAssembly.AssemblyItemCode;
                assemblyDef.AssemblyItemName = mainAssembly.AssemblyItemName;

                assemblyDef.SelectedAssyItemVMs = await _assyDefService.GetItemByItemIdAsync(mainAssembly.AssmblyID);
                bomRows = subAssembly;
                await CalculateRowCosts();
            }
            else
            {
                var item = await _assyDefService.GetItemByItemIdAsync(rowToView.ItemId);
                await OnAssemblyChanged(item);
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error confirming View for Assembly/Sub-Assembly Item: {assemblyDef?.AssemblyItemCode}");
            await _js.ToastrError("An error occurred during rowDoubleClick. Please try again.");
        }
        finally
        {
            rowToView = null;
            StateHasChanged();
        }
    }

