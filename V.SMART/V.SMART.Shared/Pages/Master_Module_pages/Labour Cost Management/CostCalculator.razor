    private decimal BaseCost =>
        bomRows?.Sum(x => x.TotalCost ?? 0) ?? 0;

    private decimal ExtraChargesTotal =>
        AssemblyChargeVMs.Sum(x => x.CalculatedAmount ?? 0m);

    // private decimal FinalGrandTotal =>
    //     BaseCost + ExtraChargesTotal;

    private decimal MaterialCost =>
        bomRows?
            .Where(x => !x.IsLabourMaterial)
            .Sum(x => x.MaterialCost ?? 0) ?? 0;

    private decimal LabourCost =>
        bomRows?
            .Where(x => x.IsLabourMaterial)
            .Sum(x => x.MaterialCost ?? 0) ?? 0;


    private decimal FinalGrandTotal =>
        MaterialCost + LabourCost + ExtraChargesTotal;




