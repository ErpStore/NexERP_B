            await _js.ToastrSuccess("Cost Breakdown printed successfully.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OnPrintCostBreakdown failed.");
            await _js.ToastrError("Failed to print Cost Breakdown.");
        }
        finally
        {
            isProcessing = false;
        }
    }
