    private async Task OnPrintBOMModifyTrackWithCharges()
    {
        if (assemblyDef.AssmblyID == null || assemblyDef.AssmblyID <= 0)
        {
            await _js.ToastrError("Please select a valid Assembly.");
            return;
        }

        var bomData = await _costingService.GetAssemblyModifyTrackByAssyId(assemblyDef.AssmblyID.Value);
        var chargesData = await _costingService.GetAssemblyChargesByAssemblyIdAsync(assemblyDef.AssmblyID.Value);
        var assemblyprice = await _assyDefService.GetItemByItemIdAsync(assemblyDef.AssmblyID.Value);

        if (!bomData.Any() && !chargesData.Any())
        {
            await _js.ToastrWarning("No data found.");
            return;
        }

        using var workbook = new ClosedXML.Excel.XLWorkbook();
        var ws = workbook.Worksheets.Add("BOM Cost Estimation");

        int currentRow = 1;

        // ==================== BOM MODIFY TRACK ====================
        if (bomData.Any())
        {
            // Headers
            ws.Cell(currentRow, 1).Value = "SlNo";
            ws.Cell(currentRow, 2).Value = "ItemCode";
            ws.Cell(currentRow, 3).Value = "ItemName";
            ws.Cell(currentRow, 4).Value = "MeasureUnit";
            ws.Cell(currentRow, 5).Value = "UtilityQty";
            ws.Cell(currentRow, 6).Value = "UnitCost";
            ws.Cell(currentRow, 7).Value = "MaterialCost";
            ws.Cell(currentRow, 8).Value = "CreatedBy";
            ws.Cell(currentRow, 9).Value = "CreatedDate";

            currentRow++;

            // Data
            foreach (var item in bomData)
            {
                ws.Cell(currentRow, 1).Value = item.SlNo;
                ws.Cell(currentRow, 2).Value = item.PartItemCode;
                ws.Cell(currentRow, 3).Value = item.PartItemName;
                ws.Cell(currentRow, 4).Value = item.UOM;
                ws.Cell(currentRow, 5).Value = item.UtilQty;
                ws.Cell(currentRow, 6).Value = item.UnitPrice;
                ws.Cell(currentRow, 7).Value = item.MaterialCost;
                ws.Cell(currentRow, 8).Value = item.CreatedBy;
                ws.Cell(currentRow, 9).Value = item.CreatedDate.ToString("dd/MM/yyyy");
                currentRow++;
            }
        }

        // ==================== GAP ROW ====================
        currentRow += 2; // leave 1 empty row

        // ==================== ASSEMBLY CHARGES ====================
        if (chargesData.Any())
        {
            // Headers
            ws.Cell(currentRow, 7).Value = "Charge Name";
            ws.Cell(currentRow, 8).Value = "Percentage";
            ws.Cell(currentRow, 9).Value = "Amount";
            currentRow++;

            // Data
            foreach (var charge in chargesData)
            {
                ws.Cell(currentRow, 7).Value = charge.Name;
                ws.Cell(currentRow, 8).Value = charge.Percent;
                ws.Cell(currentRow, 9).Value = charge.CalculatedAmount;
                currentRow++;
            }
        }
        currentRow += 1;
        ws.Cell(currentRow, 8).Value = "Grand Total";
        ws.Cell(currentRow, 9).Value = assemblyprice.AssemblyPrice;

        // ==================== SAVE AND DOWNLOAD ====================
        using var ms = new MemoryStream();
        workbook.SaveAs(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        await _js.InvokeVoidAsync("downloadExcelFile", base64, "BOMCostEstimation.xlsx");
    }


    private async Task OnPrintCostBreakdown()
    {
        try
        {
            isProcessing = true;

            if (assemblyDef.AssmblyID == null || assemblyDef.AssmblyID <= 0)
            {
                await _js.ToastrError("Please select a valid Assembly before printing the Cost Breakdown report.");
                return;
            }

            var headers = new[]
            {
                "Sl No",
                "Item Code",
                "Item Name",
                "UOM",
                "Quantity",
                "Unit Cost",
                "Material Cost",
                "Labor Cost",
                "Overhead Cost",
                "Total Cost",
                "Cost % of Total"
            };

            var costBreakdown = bomRows.Select((r, index) => new
            {
                SlNo = index + 1,
                r.PartItemCode,
                r.PartItemName,
                r.UOM,
                Quantity = r.UtilQty,
                r.UnitPrice,
                r.MaterialCost,
                r.LaborCost,
                r.TotalCost,
                CostPercentage = grandTotalCost > 0 ? Math.Round((r.TotalCost ?? 0) / grandTotalCost * 100, 2) : 0
            }).ToList();

            var fileBytes = await excelTemplateService.CreateTemplateAsync(
