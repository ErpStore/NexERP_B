    private async Task OnLabourChanged(AssemblyChargeVM charge, bool value)
    {
        charge.IsLabour = value;

        // 🔔 Show message to user
        if (value)
        {
            await _js.ToastrInfo("This charge will be calculated based on Labour Cost.");
        }
        else
        {
            await _js.ToastrInfo("This charge will be calculated based on Material Cost.");
        }

        await RecalculateCharge(charge);
    }

    private async Task RecalculateCharge(AssemblyChargeVM charge)
    {
        try
        {
            if (charge.IsAmount)
            {
                charge.CalculatedAmount = charge.Amount;
            }
            else
            {
                if (charge.IsLabour)
                {
                    charge.CalculatedAmount =
                   (LabourCost * charge.Percent) / 100;
                }
                else
                {
                    // Material charges (MaterialCost + Handling Charges)
                    decimal materialBase = 0;

                    if(charge.Name== "GST Material Cost")
                    {
                        materialBase = GetMaterialBase();
                    }
                    else
                    {
                        materialBase = MaterialCost;
                    }


                    charge.CalculatedAmount = (materialBase * charge.Percent) / 100;

                    // charge.CalculatedAmount =
                    //   (MaterialCost * charge.Percent) / 100;
                }

            }

            // await CalculateRowCosts();
            // foreach (var charges in AssemblyChargeVMs)
            // {
            //     await RecalculateCharge(charges);
            // }

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "RecalculateCharge failed.");
            await _js.ToastrError("Failed to RecalculateCharge.");
        }

    }
    private decimal GetMaterialBase()
    {
        // Sum all material charges that are not GST, like Handling Charges
        decimal handlingCharges = AssemblyChargeVMs?
            .Where(c => c.Name == "Handling Charges")
            .Sum(c => c.CalculatedAmount)??0m;

        // MaterialCost + Handling Charges
        return MaterialCost + handlingCharges;
    }
    private async Task OnItemChanged(ItemVM? item, WorkType type)
    {
        try
        {
            if (item == null)
            {
                assemblyDef.AssmblyID = null;
                assemblyDef.AssemblyItemCode = null;
                assemblyDef.AssemblyItemName = null;
                assemblyDef.SelectedAssyItemVMs = null;
                AssemblyChargeVMs.Clear();
            }
            else
            {
                assemblyDef.AssmblyID = item.ItemId;
                assemblyDef.AssemblyItemCode = item.ItemCode;
                assemblyDef.AssemblyItemName = item.ItemName;
                assemblyDef.SelectedAssyItemVMs = item;

                if (type != WorkType.JobWork && type !=WorkType.Trading)
                {
                    bomRows = await _costingService.GetAssemblyDefByAssemblyIdAsync(item.ItemId);

                }
                else
                {
                    IsAssyExistsinAssydef = true;
                }
                var productionCharges = await _costingService.GetAssemblyChargesByAssemblyIdAsync(item.ItemId);

                LoadChargesWithSaved(
                    productionCharges?.Select(x => new AssemblyChargeVM
                    {
                        AssemblyExtraChargeId = x.AssemblyExtraChargeId,
                        AssmblyID = x.AssmblyID,
                        Name = x.Name,
                        IsAmount = x.IsAmount,
                        Amount = x.Amount,
                        Percent = x.Percent,
                        IsLabour = x.IsLabour,
                        CalculatedAmount = x.CalculatedAmount,
                        IsDefault=x.IsDefault

                    }).ToList(),
                    type,item.ItemId
                );
          
                await CalculateRowCosts();
                  
                await ResetSlno();
                foreach (var charge in AssemblyChargeVMs)
                {
                    await RecalculateCharge(charge);
                }


                if (type != WorkType.JobWork)
                    IsAssyExistsinAssydef = await _assyDefService.IsAssyExistsInAssyDefAsync(assemblyDef.AssmblyID.Value);


            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error in OnItemChanged ({type})");
            await _js.ToastrError("Failed to process selection. Please try again.");
        }
    }
    // Load defaults + merge saved charges
 private async Task LoadChargesWithSaved(
    List<AssemblyChargeVM>? savedCharges,
    WorkType type,
    int? itemid)
{
    var savedDict = savedCharges?.ToDictionary(s => s.Name);

    var itemDetails = await _assyDefService.GetItemByItemIdAsync(itemid);

    decimal tax = 0;
    decimal handlingCharges = 0;

    if (itemDetails != null)
    {
        tax = itemDetails.CGST + itemDetails.SGST + itemDetails.IGST;
        handlingCharges = itemDetails.HandlingCharges ;
    }

    AssemblyChargeVM[] defaultCharges = type switch
    {
        WorkType.Assembly => new[]
        {
            new AssemblyChargeVM { Name = "GST Labour Cost", IsAmount = false, IsLabour = true, Percent = tax, IsDefault=true },
            new AssemblyChargeVM { Name = "Handling Charges", IsAmount = false, Percent = handlingCharges,IsDefault=true  },
            new AssemblyChargeVM { Name = "GST Material Cost", IsAmount = false, Percent = tax,IsDefault=true  }
        },
        WorkType.Trading => new[]
        {
            new AssemblyChargeVM { Name = "Handling Charges", IsAmount = false, Percent = handlingCharges,IsDefault=true  },
            new AssemblyChargeVM { Name = "GST Material Cost", IsAmount = false, Percent = tax ,IsDefault=true }
        },
        WorkType.JobWork => new[]
        {
            new AssemblyChargeVM { Name = "GST Labour Cost", IsLabour = true, IsAmount = false, Percent = tax, IsDefault=true }
        },
        _ => Array.Empty<AssemblyChargeVM>()
    };

    // 🔥 If list is null, initialize it
    if (AssemblyChargeVMs == null)
        AssemblyChargeVMs = new List<AssemblyChargeVM>();

    // 🔥 Add defaults only if not already existing
   foreach (var def in defaultCharges)
{
    var existing = AssemblyChargeVMs
        .FirstOrDefault(x => x.Name == def.Name);

    if (existing == null)
    {
        var saved = savedDict?.GetValueOrDefault(def.Name);

        AssemblyChargeVMs.Add(new AssemblyChargeVM
        {
            Name = def.Name,
            IsLabour = saved?.IsLabour ?? def.IsLabour,
            IsAmount = saved?.IsAmount ?? def.IsAmount,
            AssemblyExtraChargeId = saved?.AssemblyExtraChargeId ?? 0,
            AssmblyID = saved?.AssmblyID ?? 0,
            Amount = saved?.Amount ?? def.Amount,
            Percent = saved?.Percent ?? def.Percent,
            CalculatedAmount = saved?.CalculatedAmount ?? 0,
            IsDefault = saved?.IsDefault ?? def.IsDefault
        });
    }
}

    // 🔥 Also add saved charges that are NOT part of defaults (custom added)
    if (savedCharges != null)
    {
        foreach (var saved in savedCharges)
        {
            if (!AssemblyChargeVMs.Any(x => x.Name == saved.Name))
            {
                AssemblyChargeVMs.Add(saved);
            }
        }
    }
}
private async Task OnWorkTypeChanged(WorkType selected)
{
    SelectedWorkType = selected;

    AssemblyChargeVMs.Clear();
    bomRows.Clear();

    assemblyDef.AssmblyID = null;
    assemblyDef.AssemblyItemCode = null;
