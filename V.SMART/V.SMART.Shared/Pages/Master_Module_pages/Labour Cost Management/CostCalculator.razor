@page "/costcalculator"
@inherits BaseUserRightsComponent

@using V.SMART.Shared.BusinessLayer.BusinessService.MasterService.InventoryService
@using V.SMART.Shared.ViewModels.InventoryViewModel
@using MudBlazor

@inject ILoggingService _logs
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject IAssemblyDefLabourService _assyDefService
@inject IExcelTemplateService excelTemplateService
@inject ICostingService _costingService  // Add this service injection

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle>
</BsModal>

@if (isProcessing)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-white z-3 loading-overlay">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="ms-3 h5 text-primary">Processing...</p>
    </div>
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <PageHeader TitleText="BOM Labour Cost"
                        TitleIcon="bi bi-diagram-3-fill"
                        Breadcrumbs="@bomBreadcrumbs" />

            <div class="card-body">
                <div class="accordion" id="bomAccordion">
                    <div class="accordion-item border-0">
                        <h2 class="accordion-header" id="headingAssembly">
                            <button class="accordion-button fw-semibold" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseAssembly"
                                    aria-expanded="true"
                                    aria-controls="collapseAssembly">
                                <i class="bi bi-box-seam me-2"></i> Assembly Details
                            </button>
                        </h2>

                        <div id="collapseAssembly"
                             class="accordion-collapse collapse show"
                             aria-labelledby="headingAssembly"
                             data-bs-parent="#bomAccordion">
                            <div class="accordion-body bg-light rounded-3">
                                @if (assemblyDef != null)
                                {
                                    <EditForm Model="@bomRows" OnValidSubmit="UpsertBOMLabourCost">
                                        <ObjectGraphDataAnnotationsValidator />
                                        <ValidationSummary />
                                       <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Work Type</label>
                                                <InputSelect class="form-select" @bind-Value="SelectedWorkType">
                                                    <option value="@WorkType.Assembly">Assembly</option>
                                                    <option value="@WorkType.Trading">Trading</option>
                                                    <option value="@WorkType.JobWork">Job Work</option>
                                                </InputSelect>
                                            </div>
                                         </div>

                                        <div class="row mb-3 align-items-center">
                                            <label class="col-12 form-label fw-semibold">
                                               @(SelectedWorkType == WorkType.Assembly
                                                      ? "Search Assembly Item"
                                                      : SelectedWorkType == WorkType.Trading
                                                      ? "Search Component Item"
                                                      : "Search Labour Item")
                                            </label>

                                            <div class="col-md-6">
                                                <MudAutocomplete T="ItemVM"
                                                                 Value="assemblyDef.SelectedAssyItemVMs"
                                                                 ValueChanged="@(async item =>
                                                                          {
                                                                     if (SelectedWorkType == WorkType.Assembly)
                                                                         await OnAssemblyChanged(item);
                                                                     else if (SelectedWorkType == WorkType.Trading)
                                                                         await OnComponentChanged(item);
                                                                     else if (SelectedWorkType == WorkType.JobWork)
                                                                         await OnLabourItemChanged(item);
                                                                 })"
                                                                   ToStringFunc="@(item => item?.ItemCode?.Trim() ?? string.Empty)"
                                                                   SearchFunc="@(SelectedWorkType == WorkType.Assembly
                                                                                                 ? SearchAssySubAssyItems
                                                                                                 : SelectedWorkType == WorkType.Trading
                                                                                                     ? SearchOnlyComponentItems
                                                                                                     : SearchOnlyLabourItems)"
                                                         Dense="true"
                                                         Variant="Variant.Outlined"
                                                         Placeholder="@(SelectedWorkType == WorkType.Assembly
                                                                                         ? "Search Assembly Item"
                                                                                         : SelectedWorkType == WorkType.Trading
                                                                                             ? "Search Component Item"
                                                                                             : "Search Labour Item")"
                                                         Class="w-100 autocomplete-sm"
                                                         MaxItems="50"
                                                         OnBlur="@(e => TrimAutocompleteValue())" />
                                                <ValidationMessage For="@(() => assemblyDef.AssmblyID)" />
                                            </div>
                                            <div class="col-md-6">
                                                        <input class="form-control"
                                                               value="@(assemblyDef.SelectedAssyItemVMs?.ItemName ?? "")"
                                                               readonly />
                                            </div>

                                     
                                        </div>

                                        <!-- Cost Summary Cards -->
                                        @if (assemblyDef.AssmblyID > 0 && !assemblyDef.IsComponent)
                                        {
                                            <div class="row mb-4">
                                                <div class="col-md-3">
                                                    <div class="card bg-primary text-white">
                                                        <div class="card-body">
                                                            <h6 class="card-title">Total Material Cost</h6>
                                                            <h4 class="mb-0">@string.Format("{0:N2}", totalMaterialCost)</h4>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="card bg-success text-white">
                                                        <div class="card-body">
                                                            <h6 class="card-title">Total Labor Cost</h6>
                                                            <h4 class="mb-0">@string.Format("{0:N2}", totalLaborCost)</h4>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="card bg-warning text-white">
                                                        <div class="card-body">
                                                            <h6 class="card-title">Grand Total</h6>
                                                            <h4 class="mb-0">@string.Format("{0:N2}", FinalGrandTotal)</h4>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- Component Table -->
                                        <div class="table-responsive mt-3" style="max-height: 400px; overflow-y: auto; overflow-x: auto;">
                                            <table class="table table-bordered table-sm align-middle text-center mb-0"
                                                   style="table-layout: fixed; min-width: 990px;">
                                                <thead class="custom-blue sticky-top" style="z-index: 2;">
                                                    <tr>
                                                        <th style="width: 60px;">Sl No.</th>
                                                        <th style="width: 140px;">Item Code</th>
                                                        <th style="width: 200px;">Item Name</th>
                                                        <th style="width: 80px;">UOM</th>
                                                        <th style="width: 100px;">Utility Qty</th>
                                                        <!-- Cost Columns -->
                                                        <th style="width: 100px;">Unit Cost</th>
                                                        <th style="width: 100px;">Material Cost</th>
                                                        @* <th style="width: 100px;">Total Cost</th> *@

                                                        <th style="width: 120px;">Customer Material</th>
                                                        @* <th style="width: 200px;">Remarks</th> *@
                                                        <th style="width: 90px;">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="custom-size">
                                                    @if (bomRows?.Any() == true)
                                                    {
                                                        @foreach (var row in bomRows)
                                                        {
                                                            <tr @ondblclick="() => OnRowDoubleClick(row)">
                                                                <td>@row.SlNo</td>
                                                                <td>
                                                                    @if (row.IsEditable)
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                         Value="row.SelectedItemVMs"
                                                                                         ValueChanged="@(async item => await OnItemChanged(row, item))"
                                                                                         ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                         SearchFunc="@(SelectedWorkType == WorkType.Assembly
                                                                                                 ? SearchAssySubAssyItems
                                                                                                 : SelectedWorkType == WorkType.Trading
                                                                                                     ? SearchOnlyComponentItems
                                                                                                     : SearchOnlyLabourItems)"
                                                                                         Dense="true"
                                                                                         Variant="Variant.Outlined"
                                                                                         Placeholder="Search Item"
                                                                                         Class="w-100 autocomplete-sm"
                                                                                         MaxItems="50" />
                                                                                         <ValidationMessage For="@(() => row.ItemId)" />
                                                                                                        }
                                                                    else
                                                                    {

                                                                        <span>@row.PartItemCode</span>
                                                                    }
                                                                </td>
                                                                <td class="text-start">@row.PartItemName</td>
                                                                <td>@row.UOM</td>
                                                                <td>
                                                                    @if (row.IsEditable)
                                                                    {
                                                                        <input type="number"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="Utility Qty"
                                                                               title="Enter Utility Qty"
                                                                               step="any"
                                                                               @bind="row.UtilQty"
                                                                               @bind:event="oninput"
                                                                               @onchange="@(async (e) => await OnUtilQtyChanged(e, row))" />
                                                                       
                                                                    }
                                                                    else
                                                                    {
                                                                        @row.UtilQty
                                                                    }
                                                                </td>

                                                                <!-- Cost Cells -->
                                                                <td class="text-end">@string.Format("{0:N2}", row.UnitPrice)</td>
                                                                <td class="text-end">@string.Format("{0:N2}", row.MaterialCost)</td>
                                                               
                                                                <InputCheckbox @bind-Value="row.IsLabourMaterial"
                                                                               class="form-check-input border border-2 shadow-lg p-2 fs-4 rounded-pill"
                                                                               disabled="@(row.SelectedItemVMs?.IsLabourItem == true)"
                                                                               title="@(row.SelectedItemVMs?.IsLabourItem == true
                                                                                                       ? "Already Labour, cannot change"
                                                                                                       : "If checked, consider as Labour Material")" />


                                                                <td class="text-end">
                                                                    @if (row.IsEditable)
                                                                    {
                                                                        <button type="button" class="btn btn-success btn-sm me-1"
                                                                                title="Save" @onclick="async () => await SaveRow(row)">
                                                                            <i class="bi bi-check-lg"></i>
                                                                        </button>
                                                                      
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-primary btn-sm me-1"
                                                                                title="Edit" @onclick="async () => await EditRowAsync(row)">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>
                                                                      
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="14" class="text-center text-muted">No records found.</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <!-- Table Footer with Totals -->
                                                @if (bomRows?.Any() == true && !assemblyDef.IsComponent)
                                                {
                                                    <tfoot class="table-secondary fw-bold">
                                                        <tr>
                                                            <td colspan="6" class="text-end">Total Cost:</td>
                                                                  <td class="text-end">@string.Format("{0:N2}", bomRows.Sum(r => r.MaterialCost ?? 0))</td>
                                                          
                                                            <td colspan="2"></td>
                                                        </tr>
                                                    </tfoot>
                                                }
                                            </table>
                                        </div>

                                        <!-- Footer Controls -->
                                        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                                           
                                            
                                            @if (assemblyDef.AssmblyID > 0 && !assemblyDef.IsComponent)
                                            {
                                                <button type="button" class="btn btn-info btn-sm" @onclick="RefreshCostCalculations">
                                                    <i class="bi bi-arrow-repeat me-1"></i> Refresh Costs
                                                </button>
                                            }
                                        </div>
                                   
                                          <!-- ADDITIONAL CHARGES CARD -->
                                                   
                                             <div class="row mt-4 justify-content-end">
                                                <div class="col-12 col-lg-9 col-xl-8">
                                                  <div class="card shadow-sm border-0 rounded-4">

                                                            <!-- HEADER -->
                                                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                                                <h6 class="fw-bold mb-0">
                                                                    <i class="bi bi-cash-coin text-primary me-2"></i>
                                                                    Additional Charges
                                                                </h6>
                                                                @if(IsAddCharges)
                                                                {
                                                                       <button type="button" class="btn btn-sm btn-success"
                                                                            @onclick="AddNewCharge">
                                                                                <i class="bi bi-plus-circle me-1"></i>
                                                                                Add Charge
                                                                        </button>

                                                                }
                                                             
                                                            </div>

                                                            <div class="card-body">
                                                                    <div class="mb-3">
                                                                        <div class="row mb-1">
                                                                            <div class="col-6 text-muted">Material Charges</div>
                                                                            <div class="col-6 text-end fw-semibold">
                                                                                ₹ @MaterialCost.ToString("0.00")
                                                                            </div>
                                                                        </div>
                                                                        <div class="row mb-1">
                                                                            <div class="col-6 text-muted">Labour Charges</div>
                                                                            <div class="col-6 text-end fw-semibold">
                                                                                ₹ @LabourCost.ToString("0.00")
                                                                            </div>
                                                                        </div>
                                                                        <hr class="my-2" />
                                                                    </div>


                                                               @foreach (var charge in AssemblyChargeVMs)
                                                                {
                                                                    <div class="row align-items-center mb-2 py-2 border-bottom gx-2">

                                                                        <!-- Name -->
                                                                        <div class="col-3">
                                                                            <div class="d-flex align-items-center">
                                                                                <input class="form-control form-control-sm"
                                                                                       @bind="charge.Name"
                                                                                       placeholder="Enter Charge Name"
                                                                                       disabled="@charge.IsDefault" />

                                                                            </div>
                                                                        </div>
                                                                        @if(IsAddCharges)
                                                                            {
                                                                                 <!-- Labour (Rounded Clean Checkbox) -->
                                                                                    <div class="col-1 text-center">
                                                                                        <div class="form-check d-flex justify-content-center">
                                                                                            <input type="checkbox"
                                                                                                   class="form-check-input labour-check"
                                                                                                   @bind="charge.IsLabour"
                                                                                                   disabled="@charge.IsDefault" />
                                                                                        </div>
                                                                                    </div>
                                                                            }
                                                               

                                                                        <!-- ₹ / % Toggle -->
                                                                        <div class="col-2">
                                                                            <div class="btn-group btn-group-sm w-100">
                                                                                <button type="button"
                                                                                        class="btn @(charge.IsAmount ? "btn-primary" : "btn-outline-primary")"
                                                                                       
                                                                                        @onclick="() => SetChargeType(charge, true)">
                                                                                    ₹
                                                                                </button>
                                                                                <button type="button"
                                                                                        class="btn @(!charge.IsAmount ? "btn-primary" : "btn-outline-primary")"
                                                                                       
                                                                                        @onclick="() => SetChargeType(charge, false)">
                                                                                    %
                                                                                </button>
                                                                            </div>
                                                                        </div>

                                                                        <!-- Value -->
                                                        <div class="col-2">
                                                        @if (charge.IsAmount)
                                                        {
                                                            <input type="number"
                                                                   class="form-control form-control-sm text-end" step="any"
                                                                   @bind="charge.Amount"
                                                                   @bind:event="oninput"
                                                                   @bind:after="RecalculateAllCharges" />
                                                        }
                                                        else
                                                        {
                                                            <input type="number" class="form-control form-control-sm text-end" step="any"
                                                                   @bind="charge.Percent"
                                                                   @bind:event="oninput"
                                                                   @bind:after="RecalculateAllCharges" />
                                                        }
                                                                </div>

                                                                <!-- Calculated -->
                                                              <div class="col-3 text-end">
                                                                <div class="form-control form-control-sm text-end bg-light fw-semibold"
                                                                     style="pointer-events:none;">
                                                                    @($"{(charge.CalculatedAmount ?? 0m):0.00}")
                                                                </div>
                                                            </div>
                                                                @if (IsAddCharges)
                                                                {
                                                                    <!-- Delete -->
                                                                    <div class="col-1 text-center">
                                                                        @if (!charge.IsDefault)
                                                                        {
                                                                            <button type="button"
                                                                            class="btn btn-sm btn-outline-danger"
                                                                            @onclick="() => RemoveCharge(charge)">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        }
                                                                    </div>
                                                                }
                                                           
                                                            </div>
                                                        }
                                                            <div class="mt-4 p-3 rounded-4 bg-light border">
                                                                        <div class="d-flex justify-content-between fs-5 fw-bold">
                                                                            <span>Final Grand Total</span>
                                                                            <span class="text-success">
                                                                                ₹ @FinalGrandTotal.ToString("0.00")
                                                                            </span>
                                                                        </div>
                                                                    </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                         <div class="row mb-2">
                                            @if (CanCreate || CanEdit)
                                            {
                                                <div class="col-6 col-md-3 mt-3">
                                                    <button type="submit" class="btn btn-primary w-100" disabled="@isProcessing">
                                                        <i class="bi bi-floppy2-fill me-1"></i> @(IsAssyExistsinAssydef ? "Update" : "Create")
                                                    </button>
                                                </div>

                                                @* @if (IsAssyExistsinAssydef)
                                                {
                                                    <div class="col-6 col-md-3 mt-3">
                                                        <button type="button" class="btn btn-outline-secondary w-100"
                                                                @onclick="OnPrintBOMModifyTrackWithCharges">
                                                            <i class="bi bi-printer-fill me-1"></i> Print
                                                        </button>
                                                    </div>
                                                    
                                                  
                                                } *@

                                            }
                                        
                                        </div>
                                    </EditForm>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
}


@code {
    [Parameter] public int? AssmblyID { get; set; }

    protected override string ScreenName => "BOMLabourCost";

    private bool isProcessing = true;

    // private AssemblyDefVM assemblyDef = new();
    // private List<AssemblyDefVM> bomRows = new();

    // private AssemblyDefVM? rowToDelete = null;
    // private AssemblyDefVM? rowToCancel = null;
    // private AssemblyDefVM? rowToView = null;
    private AssemblyDefLabourVM assemblyDef = new();
    private List<AssemblyDefLabourVM> bomRows = new();

    private AssemblyDefLabourVM? rowToDelete = null;
    private AssemblyDefLabourVM? rowToCancel = null;
    private AssemblyDefLabourVM? rowToView = null;
    private bool IsAssyExistsinAssydef { get; set; } = false;
    private bool IsAddCharges { get; set; } = false;

    private IEnumerable<Process> process = Enumerable.Empty<Process>();

    private bool IsAllSelected => bomRows != null && bomRows.All(r => r.IsSelected);

    // Cost summary properties
    private decimal totalMaterialCost = 0;
    private decimal totalLaborCost = 0;
    private decimal totalOverheadCost = 0;
    private decimal grandTotalCost = 0;

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;


    private List<AssemblyChargeVM> AssemblyChargeVMs = new();

    private List<PageHeader.BreadcrumbItem> bomBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "Inventory" },
        new PageHeader.BreadcrumbItem { Text = "BOM Labour Cost", IsLast = true }
    };

    // public WorkType SelectedWorkType { get; set; } = WorkType.Assembly;

    private void TrimAutocompleteValue()
    {
        if (assemblyDef?.SelectedAssyItemVMs?.ItemCode != null)
        {
            assemblyDef.SelectedAssyItemVMs.ItemCode = assemblyDef.SelectedAssyItemVMs.ItemCode.Trim();
        }
    }

    private async Task SelectAll(int rowId)
    {
        await _js.InvokeVoidAsync("selectInputText", $"ReqQty-{rowId}");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            IsAddCharges= await _costingService.IsAdditionalChargesEnabledAsync();
            if (AssmblyID > 0)
            {
                var Assy = await _assyDefService.GetAssyByAssemblyIdAsync(AssmblyID.Value);

                assemblyDef.AssmblyID = AssmblyID;
                assemblyDef.AssemblyItemCode = Assy.AssemblyItemCode;
                assemblyDef.AssemblyItemName = Assy.AssemblyItemName;
                assemblyDef.SelectedAssyItemVMs = await _assyDefService.GetItemByItemIdAsync(AssmblyID);

                assemblyDef.IsComponent = Assy.IsComponent;

                await LoadSelectedProcessAsync(assemblyDef.AssmblyID.Value);

                bomRows = await _assyDefService.GetAssemblyDefByAssemblyIdAsync(AssmblyID.Value);

                // Calculate costs for each row
                await CalculateRowCosts();

                IsAssyExistsinAssydef = await _assyDefService.IsAssyExistsInAssyDefAsync(assemblyDef.AssmblyID.Value);

            }
            else
            {
                assemblyDef = new AssemblyDefLabourVM();
                bomRows.Clear();
            }

            isProcessing = false;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error on OnInitializedAsync ");
        }
    }

    #region Cost Calculation Methods

    private async Task CalculateRowCosts()
    {
        try
        {
            if (bomRows == null || !bomRows.Any())
                return;

            foreach (var row in bomRows)
            {
                if (row.ItemId is not > 0)
                    continue;

                var costing = await _assyDefService.GetItemByItemIdAsync(row.ItemId.Value);
                if (costing == null)
                    continue;

                decimal price = row.IsLabourMaterial
                    ? costing.LabourPrice 
                    : costing.Rate;

                decimal quantity = row.UtilQty ?? 1m;

                row.UnitPrice = price;
                row.MaterialCost = price * quantity;
                row.TotalCost = row.MaterialCost;
            }

            await CalculateSummaryTotals();
            RecalculateAllCharges();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error calculating row costs");
        }
    }
    private void RecalculateAllCharges()
    {
        decimal handlingCharges = 0m;

        foreach (var charge in AssemblyChargeVMs)
        {
            if (charge.IsAmount)
            {
                charge.CalculatedAmount = charge.Amount ?? 0m;
            }
            else
            {
                decimal percent = charge.Percent ?? 0m;

                if (charge.IsLabour)
                {
                    charge.CalculatedAmount =
                        Math.Round((LabourCost * percent) / 100m, 2);
                }
                else
                {
                    charge.CalculatedAmount =
                        Math.Round((MaterialCost * percent) / 100m, 2);
                }
            }

            if (charge.Name == "Handling Charges")
                handlingCharges += charge.CalculatedAmount ?? 0m;
        }

        var gst = AssemblyChargeVMs
            .FirstOrDefault(x => x.Name == "GST Material Cost");

        if (gst != null && !gst.IsAmount)
        {
            decimal gstPercent = gst.Percent ?? 0m;
            decimal gstBase = MaterialCost + handlingCharges;

            gst.CalculatedAmount =
                Math.Round((gstBase * gstPercent) / 100m, 2);
        }
    }
    private async Task CalculateSummaryTotals()
    {
        try
        {
            if (bomRows == null || !bomRows.Any() || assemblyDef.IsComponent)
            {
                totalMaterialCost = 0;
                totalLaborCost = 0;
                totalOverheadCost = 0;
                grandTotalCost = 0;
                return;
            }


            totalMaterialCost = bomRows ?
                    .Where(x => !x.IsLabourMaterial)
                    .Sum(x => x.MaterialCost ?? 0) ?? 0;

            totalLaborCost = bomRows ?
                    .Where(x => x.IsLabourMaterial)
                    .Sum(x => x.MaterialCost ?? 0) ?? 0;

            grandTotalCost = bomRows.Sum(r => r.TotalCost ?? 0);
            RecalculateAllCharges();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error calculating summary totals");
        }
    }

    private async Task RefreshCostCalculations()
    {
        try
        {
            isProcessing = true;
            await CalculateRowCosts();
            RecalculateAllCharges();
            await _js.ToastrSuccess("Cost calculations refreshed successfully.");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error refreshing cost calculations");
            await _js.ToastrError("Failed to refresh cost calculations.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion

    #region Assembly and Item Handlers

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool isChecked = e?.Value is bool b && b;
        foreach (var row in bomRows)
            row.IsSelected = isChecked;
    }

    private void OnRowSelected(AssemblyDefVM row, object? value)
    {
        if (value is bool isChecked)
            row.IsSelected = isChecked;
    }

    private async Task OnAssemblyChanged(ItemVM? item)
    {
        try
