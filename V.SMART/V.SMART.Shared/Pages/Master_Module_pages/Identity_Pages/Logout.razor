@page "/logout"

@inject CurrentUserService currentUserService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager _nav
@inject ILoggingService LoggingService

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body flex-column">
                <div class="text-center">
                    <img src="/_content/V.SMART.Shared/images/logout.jpg" style="max-height: 5rem;" />
                </div>
                <div class="text-center mt-2">
                    <span class="text-danger fw-bolder">
                        You have successfully logged out.
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    protected override async Task OnInitializedAsync()
    {
        try
        {

            ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsLoggedOut();
            await LoggingService.LogUserAction(UserName: await currentUserService.GetUsernameAsync(), Machine: currentUserService.MachineName, IP_Address: currentUserService.IpAddress, screen: "User Logout", action: $"Log Out",
            additionalInfo: $"");

            _nav.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the OnInitializedAsync() Method for User");
        }
    }
}

