@page "/access-denied"

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="card shadow border-0 w-100" style="max-width: 400px;">
        <div class="card-body text-center p-4">
            <img src="/_content/V.SMART.Shared/images/authorize-denied.jpg"
                 alt="Access Denied"
                 class="img-fluid mb-4"
                 style="max-height: 120px;" />

            <h4 class="text-danger fw-bold mb-3">Access Denied</h4>

            <p class="text-secondary mb-4">
                You do not have permission to view this page.
            </p>

            <a href="/" class="btn btn-outline-danger w-100">
                <i class="bi bi-arrow-left-circle me-1"></i> Return to Home
            </a>
        </div>
    </div>
</div>
