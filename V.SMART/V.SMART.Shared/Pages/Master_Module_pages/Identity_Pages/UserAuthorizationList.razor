@page "/userLevelAuthorization"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IMasterServices.IAdminService
@using V.SMART.Shared.ViewModels.MasterViewModel.AdminViewmodel

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@inject IUserAuthorityService userAuthorityService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch isModelVisible="true"
                       Screen="@ScreenName"
                       Filters="SearchFilters"
                       OnClose="CloseModal"
                       OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="User Level Authorization"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@UserBreadcrumbs" />

            <div class="card-body p-4">

                <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                    </div>

                    @if (CanCreate)
                    {
                        <div class="col-6 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewUser">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </button>
                        </div>
                    }
                </div>

                @if (UserAuthorityVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="UserAuthorityVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Any(c => c.IsVisible))
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    @switch (col.Field)
                                    {
                                        case "UserId":
                                            <PropertyColumn Title="User ID"
                                                            Property="@(x => x.UserId)" />
                                            break;

                                        case "UserName":
                                            <PropertyColumn Title="User Name"
                                                            Property="@(x => x.UserName)"
                                                            Sortable="true" />
                                            break;

                                        // ===== MFG Quote =====
                                        case "IsMfgQuoteLevel":
                                            <TemplateColumn Title="MFG Quote Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsMfgQuoteLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsMfgQuoteLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsMfgQuoteLevel
                                                    </span>
                                                }
                                            </TemplateColumn>


                                            break;

                                        // ===== PR =====
                                        case "IsPRLevel":
                                            <TemplateColumn Title="PR Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsPRLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsPRLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsPRLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        // ===== PO =====
                                        case "IsPOLevel":
                                            <TemplateColumn Title="PO Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsPOLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsPOLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsPOLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        // ===== Purchase SCN =====
                                        case "IsPurchSCNLevel":
                                            <TemplateColumn Title="Purchase SCN Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsPurchSCNLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsPurchSCNLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsPurchSCNLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        // ===== SubCon SCN =====
                                        case "IsSubConSCNLevel":
                                            <TemplateColumn Title="SubCon SCN Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsSubConSCNLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsSubConSCNLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsSubConSCNLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        // ===== Production Assembly =====
                                        case "IsProdAssySCNLevel":
                                            <TemplateColumn Title="Prod Assembly Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsProdAssySCNLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsProdAssySCNLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsProdAssySCNLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        // ===== Production Component =====
                                        case "IsProdCompSCNLevel":
                                            <TemplateColumn Title="Prod Component Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsProdCompSCNLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsProdCompSCNLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsProdCompSCNLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        // ===== Labour =====
                                        case "IsLabourSCNLevel":
                                            <TemplateColumn Title="Labour Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsLabourSCNLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsLabourSCNLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsLabourSCNLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        // ===== Leave =====
                                        case "IsLeaveLevel":
                                            <TemplateColumn Title="Leave Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsLeaveLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsLeaveLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsLeaveLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        // ===== Route Card =====
                                        case "IsRcLevel":
                                            <TemplateColumn Title="Route Card Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsRcLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsRcLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsRcLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                        case "IsSalespoLevel":
                                            <TemplateColumn Title="Sales PO Level" Context="x">
                                                @if (!string.IsNullOrWhiteSpace(x.IsSalesPoLevel))
                                                {
                                                    var badge = GetLevelBadgeInfo(x.IsSalesPoLevel);

                                                    <span class="@badge.CssClass">
                                                        <i class="bi @badge.Icon"></i>
                                                        @x.IsSalesPoLevel
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;


                                    }
                                }
                            }

                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">

                                    @if (CanEdit)
                                    {
                                        <a href="@($"userLevelAuthorization/update/{c.Id}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit User">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }

                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete User"
                                                @onclick="() => HandleDelete(c.Id)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }

                                </div>
                            </TemplateColumn>

                        </QuickGrid>

                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>
                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}


@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "User Level Authorization";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteId = 0;
    private string searchText = string.Empty;
    private string selectedStatus = "";

    private List<UserAuthorityVM> UserAuthorityVMs = new();

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter, SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> UserBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "Admin Master" },
        new PageHeader.BreadcrumbItem { Text = "Authority Manage Master", IsLast = true }
    };

    #endregion


    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllUserAuths();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in User list OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    private void AddNewUser()
    {
        _navigation.NavigateTo($"/userLevelAuthorization/create");
    }
    #endregion


    #region Badge colour

    private (string CssClass, string Icon) GetLevelBadgeInfo(string? level)
    {
        return level?.Trim() switch
        {
            "Level1" => ("badge bg-primary d-inline-flex align-items-center gap-1", "bi-person-fill"),
            "Level2" => ("badge bg-warning text-dark d-inline-flex align-items-center gap-1", "bi-shield-check"),
            "Level3" => ("badge bg-success d-inline-flex align-items-center gap-1", "bi-patch-check"),
            _ => ("badge bg-secondary", "bi-question-circle")
        };
    }


    #endregion


    #region === Data Loading ===

    private async Task LoadAllUserAuths()
    {
        try
        {
            var result = await userAuthorityService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            UserAuthorityVMs = result.userAuthVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading data in User Authority List");
            await _JS.ToastrError("Failed to load User Authority List.");
        }
    }

    #endregion



    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "ID", Field = "Id", IsVisible = false },
                new() { Title = "User ID", Field = "UserId", IsVisible = true },
                new() { Title = "User Name", Field = "UserName", IsVisible = true },

                // ===== Manufacturing Quote =====
                new() { Title = "MFG Quote Level", Field = "IsMfgQuoteLevel", IsVisible = true },

                // ===== Purchase Requisition =====
                new() { Title = "PR Level", Field = "IsPRLevel", IsVisible = true },

                // ===== Purchase Order =====
                new() { Title = "PO Level", Field = "IsPOLevel", IsVisible = true },

                // ===== Purchase SCN =====
                new() { Title = "Purchase SCN Level", Field = "IsPurchSCNLevel", IsVisible = true },

                // ===== Subcontract SCN =====
                new() { Title = "SubCon SCN Level", Field = "IsSubConSCNLevel", IsVisible = false },

                // ===== Production Assembly SCN =====
                new() { Title = "Prod Assembly Level", Field = "IsProdAssySCNLevel", IsVisible = false },

                // ===== Production Component SCN =====
                new() { Title = "Prod Component Level", Field = "IsProdCompSCNLevel", IsVisible = false },

                // ===== Labour SCN =====
                new() { Title = "Labour Level", Field = "IsLabourSCNLevel", IsVisible = false },

                // ===== Leave Approval =====
                new() { Title = "Leave Level", Field = "IsLeaveLevel", IsVisible = false },

                // ===== Route Card =====
                new() { Title = "Route Card Level", Field = "IsRcLevel", IsVisible = false },

                //===== Sales Po ====
                new() { Title = "Sales PO Level", Field = "IsSalespoLevel", IsVisible = false }
            };

            if (!Hidden)
            {
                // future optional columns
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in User InitializeColumns()");
        }
    }


    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for User Authority List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the User Authority List HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllUserAuths();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in User Authority List");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllUserAuths();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in User Authority List");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllUserAuths();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in User Authority List");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllUserAuths();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in User Authority List");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllUserAuths();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in User Authority List");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllUserAuths();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing User Authority List page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int id)
    {
        try
        {
            if (!await ValidateDeleteHierarchy(id))
                return;

            DeleteId = id;

            ModalTitle = "Are you sure you want to delete this User Access Level Authority?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for Access Level Authority Id: {id}");

            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }


    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;

            var deleted = await userAuthorityService.DeleteUserAuthByIdAsync(DeleteId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Access Level Authority deleted successfully.");
                await LoadAllUserAuths();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("User could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting Acces Level Id: {DeleteId}");
            await _JS.ToastrError("Failed to delete User Level Authority.");
        }
        finally
        {
            DeleteId = 0;
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateDeleteHierarchy(int deleteId)
    {
        var allUsers = await userAuthorityService.GetAllUserAuthoritiesAsync();

        var deletingUser = allUsers.FirstOrDefault(x => x.Id == deleteId);
        if (deletingUser == null)
            return true;

        var otherUsers = allUsers.Where(x => x.Id != deleteId).ToList();

        async Task<bool> CheckModule(string moduleName, Func<UserAuthorityVM, string?> levelSelector)
        {
            var deletingLevel = levelSelector(deletingUser)?.Trim();

            if (string.IsNullOrWhiteSpace(deletingLevel))
                return true;

            bool level2Exists = otherUsers.Any(x => levelSelector(x)?.Trim() == "Level2");
            bool level3Exists = otherUsers.Any(x => levelSelector(x)?.Trim() == "Level3");

            // If deleting Level 1
            if (deletingLevel == "Level1")
            {
                if (level2Exists || level3Exists)
                {
                    await _JS.ToastrError(
                        $"{moduleName}: Cannot delete Level 1 because Level 2 or Level 3 approvers exist.");
                    return false;
                }
            }

            // If deleting Level 2
            if (deletingLevel == "Level2")
            {
                if (level3Exists)
                {
                    await _JS.ToastrError(
                        $"{moduleName}: Cannot delete Level 2 because Level 3 approver exists.");
                    return false;
                }
            }

            // Level 3 always safe to delete
            return true;
        }

        if (!await CheckModule("Manufacturing Quotation", x => x.IsMfgQuoteLevel)) return false;
        if (!await CheckModule("Purchase Requisition", x => x.IsPRLevel)) return false;
        if (!await CheckModule("Purchase Order", x => x.IsPOLevel)) return false;
        if (!await CheckModule("Purchase SCN", x => x.IsPurchSCNLevel)) return false;
        if (!await CheckModule("Sub Contract SCN", x => x.IsSubConSCNLevel)) return false;
        if (!await CheckModule("Production Assembly SCN", x => x.IsProdAssySCNLevel)) return false;
        if (!await CheckModule("Production Component SCN", x => x.IsProdCompSCNLevel)) return false;
        if (!await CheckModule("Labour SCN", x => x.IsLabourSCNLevel)) return false;
        if (!await CheckModule("Route Card", x => x.IsRcLevel)) return false;
        if (!await CheckModule("Leave", x => x.IsLeaveLevel)) return false;

        return true;
    }



    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllUserAuths();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in User Authority List");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion

}
