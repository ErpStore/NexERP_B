@page "/login"
@layout BlankLayout
@using V.SMART.Shared.Layout
@using Microsoft.Extensions.Configuration
@using System.Reflection
@using V.SMART.Shared.Repository.IRepository.IMasterRepository.IAdminRepository

@inject AuthenticationStateProvider AuthStateProvider
@inject CurrentUserService currentUserService
@inject IUserRepository _userRepository
@inject NavigationManager _nav
@inject IJSRuntime _js
@inject ILoggingService LoggingService
@inject IUserRightService userRightService
@inject ThemeStateService ThemeStateService
@inject IUserService UserService
@inject IProductionLogService ProductionLogService
@inject UserSession session
@inject IAppVersionService AppVersionService
@inject IConfiguration Configuration

@if (isProcessing)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;background:#030712;gap:16px;">
        <div style="width:36px;height:36px;border:3px solid rgba(37,99,235,0.2);border-top-color:#2563EB;border-radius:50%;animation:ng-spin 0.7s linear infinite;"></div>
        <span style="font-family:'Inter',sans-serif;font-size:13px;color:rgba(255,255,255,0.4);">Authenticating…</span>
    </div>
}
else
{
    <div style="min-height:100vh;display:flex;background:#030712;font-family:'Inter',sans-serif;overflow:hidden;">

        <!-- ── LEFT PANEL ─────────────────────────────────────────── -->
        <div style="flex:1;display:flex;flex-direction:column;justify-content:center;padding:60px 80px;background:linear-gradient(145deg,#060B18 0%,#0D1A3A 100%);border-right:1px solid rgba(255,255,255,0.05);position:relative;overflow:hidden;" class="d-none d-lg-flex">

            <!-- Background radial -->
            <div style="position:absolute;top:-200px;right:-200px;width:600px;height:600px;background:radial-gradient(circle,rgba(37,99,235,0.15) 0%,transparent 70%);pointer-events:none;"></div>
            <div style="position:absolute;bottom:-100px;left:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(124,58,237,0.12) 0%,transparent 70%);pointer-events:none;"></div>

            <!-- Brand -->
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:56px;position:relative;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="44" height="44">
                    <defs>
                        <linearGradient id="ng-login-logo" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#2563EB"/>
                            <stop offset="100%" stop-color="#7C3AED"/>
                        </linearGradient>
                    </defs>
                    <rect width="48" height="48" rx="12" fill="url(#ng-login-logo)"/>
                    <path d="M11 37V11h6.5l13.5 18.5V11H37v26h-6.5L17 18.5V37z" fill="rgba(255,255,255,0.95)"/>
                </svg>
                <div>
                    <div style="font-family:'DM Sans',sans-serif;font-size:20px;font-weight:700;color:#fff;letter-spacing:-0.02em;">NexGenERP</div>
                    <div style="font-size:11px;color:rgba(255,255,255,0.4);margin-top:1px;">Enterprise Resource Planning</div>
                </div>
            </div>

            <!-- Headline -->
            <h1 style="font-family:'DM Sans',sans-serif;font-size:44px;font-weight:800;color:#fff;line-height:1.1;letter-spacing:-0.035em;margin-bottom:16px;position:relative;">
                One Platform.<br />
                <span style="background:linear-gradient(135deg,#60A5FA 0%,#A78BFA 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Infinite Scale.</span>
            </h1>
            <p style="font-size:15px;color:rgba(255,255,255,0.45);max-width:400px;line-height:1.7;margin-bottom:48px;position:relative;">
                Manufacturing · Inventory · HR · Accounts · Analytics — all unified in one modern platform.
            </p>

            <!-- Module pills -->
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:48px;position:relative;">
                @foreach (var (label, icon, color) in new[]{
                    ("Sales & Labour","bi-cart-check-fill","#14B8A6"),
                    ("Purchase","bi-bag-check-fill","#D97706"),
                    ("Planning","bi-calendar2-week-fill","#7C3AED"),
                    ("Production","bi-gear-wide-connected","#DC2626"),
                    ("Human Resource","bi-people-fill","#EC4899"),
                    ("Accounts","bi-cash-stack","#059669"),
                    ("QC / Inspection","bi-clipboard2-check-fill","#0891B2"),
                    ("Maintenance","bi-tools","#EA580C"),
                    ("Reports","bi-bar-chart-fill","#2563EB"),
                })
                {
                    <div style="display:inline-flex;align-items:center;gap:6px;padding:5px 12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:100px;font-size:12px;color:rgba(255,255,255,0.6);">
                        <i class="bi @icon" style="color:@color;font-size:12px;"></i>@label
                    </div>
                }
            </div>

            <!-- Stats -->
            <div style="display:flex;gap:32px;position:relative;">
                @foreach (var (val, label) in new[]{ ("12+","ERP Modules"), ("Real-Time","Data Sync"), ("Cloud","Ready") })
                {
                    <div>
                        <div style="font-family:'DM Sans',sans-serif;font-size:22px;font-weight:700;color:#fff;letter-spacing:-0.02em;">@val</div>
                        <div style="font-size:11px;color:rgba(255,255,255,0.35);margin-top:2px;">@label</div>
                    </div>
                }
            </div>
        </div>

        <!-- ── RIGHT FORM PANEL ────────────────────────────────────── -->
        <div style="width:480px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 40px;background:#030712;position:relative;">

            <!-- Mobile logo (shown on small screens) -->
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:40px;" class="d-lg-none">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="32" height="32">
                    <defs>
                        <linearGradient id="ng-login-mob" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#2563EB"/>
                            <stop offset="100%" stop-color="#7C3AED"/>
                        </linearGradient>
                    </defs>
                    <rect width="48" height="48" rx="11" fill="url(#ng-login-mob)"/>
                    <path d="M11 37V11h6.5l13.5 18.5V11H37v26h-6.5L17 18.5V37z" fill="rgba(255,255,255,0.95)"/>
                </svg>
                <span style="font-family:'DM Sans',sans-serif;font-size:18px;font-weight:700;color:#fff;">NexGenERP</span>
            </div>

            <!-- Login card -->
            <div style="width:100%;background:#111827;border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:40px;box-shadow:0 32px 80px rgba(0,0,0,0.5);">

                <!-- Lock icon -->
                <div style="width:52px;height:52px;border-radius:14px;background:rgba(37,99,235,0.15);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
                    <i class="bi bi-shield-lock-fill" style="font-size:22px;color:#60A5FA;"></i>
                </div>

                <h2 style="font-family:'DM Sans',sans-serif;font-size:22px;font-weight:700;color:#fff;margin:0 0 6px;letter-spacing:-0.02em;">Welcome Back</h2>
                <p style="font-size:13.5px;color:rgba(255,255,255,0.4);margin:0 0 28px;">Sign in to your NexGenERP workspace</p>

                <EditForm Model="LoginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div style="margin-bottom:16px;">
                        <label style="display:block;font-size:13px;font-weight:500;color:rgba(255,255,255,0.65);margin-bottom:6px;">
                            <i class="bi bi-person-fill me-1"></i>Username
                        </label>
                        <div style="position:relative;">
                            <InputText class="ng-login-input" @bind-Value="LoginModel.UserName" placeholder="Enter your username" />
                        </div>
                        <ValidationMessage For="@(() => LoginModel.UserName)" class="ng-val-msg" />
                    </div>

                    <div style="margin-bottom:24px;">
                        <label style="display:block;font-size:13px;font-weight:500;color:rgba(255,255,255,0.65);margin-bottom:6px;">
                            <i class="bi bi-lock-fill me-1"></i>Password
                        </label>
                        <div style="position:relative;">
                            <InputText type="@(showPass ? "text" : "password")"
                                       class="ng-login-input"
                                       style="padding-right:44px;"
                                       @bind-Value="LoginModel.Password"
                                       placeholder="Enter your password" />
                            <button type="button"
                                    style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:rgba(255,255,255,0.35);cursor:pointer;font-size:16px;padding:4px;"
                                    @onclick="TogglePassword" tabindex="-1">
                                <i class="bi @(showPass ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => LoginModel.Password)" class="ng-val-msg" />
                    </div>

                    <button class="ng-login-submit" type="submit">
                        <span>Sign In</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </EditForm>

                <div style="display:flex;align-items:center;gap:12px;margin:20px 0;">
                    <div style="flex:1;height:1px;background:rgba(255,255,255,0.08);"></div>
                    <span style="font-size:12px;color:rgba(255,255,255,0.25);">OR</span>
                    <div style="flex:1;height:1px;background:rgba(255,255,255,0.08);"></div>
                </div>

                <div style="margin-bottom:20px;">
                    <label style="display:block;font-size:13px;font-weight:500;color:rgba(255,255,255,0.65);margin-bottom:6px;">
                        <i class="bi bi-qr-code-scan me-1"></i>Scan QR Code
                    </label>
                    <input type="text"
                           class="ng-login-input"
                           @bind="QrLoginText"
                           @bind:event="oninput"
                           @onchange="HandleQrLogin"
                           placeholder="Scan QR here..." />
                </div>

                <div style="display:flex;justify-content:space-between;gap:12px;">
                    <a href="/register" style="display:inline-flex;align-items:center;gap:5px;font-size:12.5px;color:rgba(255,255,255,0.35);text-decoration:none;transition:color 0.18s;">
                        <i class="bi bi-person-plus-fill"></i> Request Access
                    </a>
                    <a href="mailto:support@nexgenerp.com" style="display:inline-flex;align-items:center;gap:5px;font-size:12.5px;color:rgba(255,255,255,0.35);text-decoration:none;transition:color 0.18s;">
                        <i class="bi bi-headset"></i> Support
                    </a>
                </div>

            </div>

            <div style="margin-top:24px;display:flex;align-items:center;gap:6px;font-size:12px;color:rgba(255,255,255,0.2);">
                <i class="bi bi-shield-check-fill"></i>
                Secure · Enterprise-Grade · ISO Compliant
            </div>

        </div>

    </div>
}

<style>
    @@keyframes ng-spin { to { transform: rotate(360deg); } }
    .ng-val-msg { display: block; font-size: 11.5px; color: #F87171; margin-top: 4px; }
    @@media (max-width: 991px) {
        div[style*="width:480px"] { width: 100% !important; }
    }
</style>


@code {
    private bool isProcessing { get; set; } = true;
    private bool showPass { get; set; } = false;
    private bool isDark { get; set; } = false;
    private LoginModel LoginModel { get; set; } = new();

    private bool _isQrProcessing;
    private string QrLoginText { get; set; } = "";

    //11072026----------------------------------------------------------
    private bool IsDesktop => Configuration["AppEnvironment"] == "Desktop";
    //-----------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        isDark = ThemeStateService.IsDarkMode;
        ThemeStateService.OnChange += ThemeChanged;
        isProcessing = false;
    }

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeStateService.OnChange -= ThemeChanged;
    }

    private void TogglePassword() => showPass = !showPass;

    private async Task HandleLogin()
    {
        isProcessing = true;

        try
        {
            if (string.IsNullOrWhiteSpace(LoginModel.UserName) ||
                string.IsNullOrWhiteSpace(LoginModel.Password))
            {
                await _js.ToastrWarning("Please enter valid credentials.");
                await LoggingService.LogDeveloperInfo($"Invalid login attempt: {LoginModel.UserName}");
                return;
            }

            var user = await _userRepository.LoginAsync(LoginModel.UserName, LoginModel.Password);

            if (user == null)
            {
                await _js.ToastrError("Invalid credentials");
                await LoggingService.LogDeveloperInfo($"Invalid login attempt: {LoginModel.UserName}");
                return;
            }

            //11072026----------------------------------------------------------
            if (!IsDesktop && user.UserId>1 && user != null && user.TrialDays > 0 && user.ExpiryDate.HasValue && DateTime.Today > user.ExpiryDate.Value.Date)
            {
                await _js.ToastrWarning("Your trial period has expired. Please contact Administrator.");
                return;
            }

            if (user.UserId > 1 && (user.IsMobile || user.IsDesktop))
            {
                var deviceId = await _js.InvokeAsync<string>("deviceHelper.getDeviceId");
                var isMobile = await _js.InvokeAsync<bool>("deviceHelper.isMobile");

                if (isMobile)
                {
                    if (!user.IsMobile)
                    {
                        await _js.ToastrError("Mobile login is not allowed.");
                        return;
                    }

                    // First Login
                    if (string.IsNullOrWhiteSpace(user.MobileDeviceId))
                    {
                        await UserService.UpdateUserDeviceAsync(user.UserId);
                    }
                    // Existing Device Validation
                    else if (user.MobileDeviceId != deviceId)
                    {
                        await _js.ToastrError("This account is already registered on another mobile device.");
                        return;
                    }
                }
                else
                {
                    if (!user.IsDesktop)
                    {
                        await _js.ToastrError("Desktop login is not allowed.");
                        return;
                    }

                    // First Login
                    if (string.IsNullOrWhiteSpace(user.DesktopDeviceId))
                    {
                        await UserService.UpdateUserDeviceAsync(user.UserId);
                    }
                    // Existing Device Validation
                    else if (user.DesktopDeviceId != deviceId)
                    {
                        await _js.ToastrError("This account is already registered on another desktop.");
                        return;
                    }
                }
            }

            
            if (IsDesktop)
            {
                if (!await CheckDesktopAppVersionAsync())
                {
                    return;
                }
            }
            //-----------------------------------------------------------------------


            if (AuthStateProvider is CustomAuthStateProvider customAuth)
            {
                customAuth.MarkUserAsAuthenticated( user.UserName, user.UserId, user.Role.ToString(),
                    false, // QR Login
                    false  // Production User
                );
                session.UserName=user.UserName;
                session.UserId=user.UserId;
            }

            if (user.UserId == 1)
            {
                await LoggingService.LogDeveloperInfo($"[UserRights] Administrator login detected. Syncing rights for UserId: {user.UserId}.");
                await userRightService.SyncRightsForUserAsync(user.UserId);
            }



            await _js.InvokeVoidAsync("toastr.success", "Login successful!");
            await LoggingService.LogDeveloperInfo($"User logged in successfully: {LoginModel.UserName}");
            _nav.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in HandleLogin()");
            await _js.InvokeVoidAsync("toastr.error", "Something went wrong. Please try again.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleQrLogin(ChangeEventArgs e)
    {
        if (_isQrProcessing)
            return;

        try
        {
            QrLoginText = e.Value?.ToString()?.Trim();

            if (string.IsNullOrWhiteSpace(QrLoginText))
                return;

            _isQrProcessing = true;

            string tokenText = QrLoginText;

            // Scanner may scan full URL
            if (tokenText.Contains("/"))
            {
                tokenText = tokenText.Split('/').Last();
            }

            // Scanner may append CR/LF
            tokenText = tokenText
                .Replace("\r", "")
                .Replace("\n", "")
                .Trim();

            if (!Guid.TryParse(tokenText, out Guid token))
            {
                await _js.ToastrError("Invalid QR Code");

                QrLoginText = "";
                return;
            }

            var user = await _userRepository.GetUserByQrToken(token);

            if (user == null)
            {
                await _js.ToastrError("QR Login Failed");

                QrLoginText = "";
                return;
            }

            if (!user.IsQrEnabled)
            {
                await _js.ToastrError("QR Login Disabled");

                QrLoginText = "";
                return;
            }

            if (user.QrExpiryDate.HasValue &&
                user.QrExpiryDate.Value < DateTime.Now)
            {
                await _js.ToastrError("QR Expired");

                QrLoginText = "";
                return;
            }

            var isProductionLog =
                await UserService.IsProductionLogEnabledAsync(user.UserId);

            if (AuthStateProvider is CustomAuthStateProvider customAuth)
            {
                customAuth.MarkUserAsAuthenticated(
                    user.UserName,
                    user.UserId,
                    user.Role.ToString(),
                    true,
                    isProductionLog);
            }

            await _js.ToastrSuccess("Login Successful");

            await Task.Delay(500);

            if (isProductionLog)
            {
                var pendingLogId =
                    await ProductionLogService
                        .GetPendingProductionLogIdAsync(
                            user.UserName.Trim());

                if (pendingLogId.HasValue)
                {
                    _nav.NavigateTo(
                        $"/productionLog/update/{pendingLogId.Value}/true",
                        false);
                }
                else
                {
                    _nav.NavigateTo(
                        "/productionLog/create/true",
                        false);
                }
            }
            else
            {
                _nav.NavigateTo("/dashboard", false);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "QR Login Error");

            await _js.ToastrError("QR Login Failed");
        }
        finally
        {
            QrLoginText = "";
            _isQrProcessing = false;
        }
    }

    private async Task<bool> CheckDesktopAppVersionAsync()
    {
        try
        {
            // Web application: skip version check
            if (!IsDesktop)
                return true;

            string? databaseVersion = await AppVersionService.GetLatestVersionAsync();

            string currentVersion =Assembly.GetEntryAssembly()?.GetName().Version?.ToString() ?? "0.0.0.0";

            if (string.IsNullOrWhiteSpace(databaseVersion))
                return true;

            if (Version.TryParse(databaseVersion, out var latest) && Version.TryParse(currentVersion, out var current) &&  latest > current)
            {
                bool updateNow = await _js.InvokeAsync<bool>(
                    "confirm",
                    $"A new application update is available.\n\n" +
                    $"Current Version: {currentVersion}\n" +
                    $"Latest Version: {databaseVersion}\n\n" +
                    $"Would you like to install the update now?");

                if (updateNow)
                {
                    // Start installer
                    try
                    {
                        string setupPath = Configuration["UpdateSettings:SetupPath"] ?? "";

                        if (!File.Exists(setupPath))
                        {
                            await _js.ToastrError("Setup file not found.");
                            return false;
                        }

                        System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                        {
                            FileName = setupPath,
                            UseShellExecute = true
                        });

                        // System.Diagnostics.Process.Start(
                        //  new System.Diagnostics.ProcessStartInfo
                        //  {
                        //      FileName = setupPath,
                        //      Arguments = "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART",
                        //      UseShellExecute = true
                        //  });

                        // Close MAUI Desktop Application
                        Environment.Exit(0);
                    }
                    catch (Exception ex)
                    {
                        await _js.ToastrError($"Unable to start installer.\n{ex.Message}");
                    }

                    // Stop login/navigation
                    return false;
                }

                // User selected No → continue login
                return true;
            }

            return true;

        }
        catch (Exception ex)
        {

            throw;
        }
    }

    
}
