                    </div>

                    <div class="login-field-group">

                        <label class="login-label">

                            <i class="bi bi-qr-code-scan"></i>

                            Scan QR Code

                        </label>

                        <div class="login-input-wrap">

                            <input type="text"
                                   class="login-input"
                                   @bind="QrLoginText"
                                   @bind:event="oninput"
                                   @onchange="HandleQrLogin"
                                   placeholder="Scan QR here..."
                                   autofocus />

                        </div>

                    </div>

                    <div class="login-footer-links">
                        <a href="/register" class="login-link">
                            <i class="bi bi-person-plus-fill"></i>
                            Request Access
                        </a>
                        <a href="mailto:contactbspl@bhargavigroup.com" class="login-link">
                            <i class="bi bi-headset"></i>
                            Support
                        </a>
                    </div>

                    <!-- Decorative corner accents -->
                    <div class="login-card-corner login-card-corner-tl"></div>
                    <div class="login-card-corner login-card-corner-br"></div>
                </div>

                <!-- Company info strip -->
                <div class="login-company-strip">
                    <i class="bi bi-geo-alt-fill"></i>
                     Bangalore · contactbspl@bhargavigroup.com
                </div>
