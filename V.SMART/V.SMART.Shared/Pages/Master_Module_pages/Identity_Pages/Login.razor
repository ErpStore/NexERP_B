@page "/login"
@using Microsoft.Extensions.Configuration

@using System.Reflection
@using V.SMART.Shared.Repository.IRepository.IMasterRepository.IAdminRepository


@inject AuthenticationStateProvider AuthStateProvider
@inject CurrentUserService currentUserService
@inject IUserRepository _userRepository
@inject NavigationManager _nav
@inject IJSRuntime _js

@inject ILoggingService LoggingService
@inject IUserRightService userRightService
@inject ThemeStateService ThemeStateService
@inject IUserService UserService
@inject IProductionLogService ProductionLogService
@inject UserSession session
@inject IAppVersionService AppVersionService
@inject IConfiguration Configuration




@if (isProcessing)
{
    <div class="login-loading-overlay @(isDark ? "" : "login-light")">
        <div class="login-spinner-ring"></div>
        <p class="login-loading-text">Authenticating...</p>
    </div>
}
else
{
    <div class="login-page-wrapper @(isDark ? "login-dark" : "login-light")">

        <!-- Animated Background Orbs -->
        <div class="login-orb login-orb-1"></div>
        <div class="login-orb login-orb-2"></div>
        <div class="login-orb login-orb-3"></div>
        <div class="login-orb login-orb-4"></div>

        <!-- Floating Particles -->
        <div class="login-particles">
            @for (int i = 1; i <= 12; i++)
            {
                <div class="login-particle login-particle-@i"></div>
            }
        </div>

        <div class="login-container">

            <!-- LEFT PANEL — ERP Module Showcase -->
            <div class="login-left">
                <div class="login-left-header">
                    <div class="login-logo-badge">
                        <i class="bi bi-grid-1x2-fill"></i>
                    </div>
                    <div>
                        <div class="login-left-brand">V.SMART ERP</div>
                        <div class="login-left-tagline">Bhargavi Soft-Tech Pvt. Ltd.</div>
                    </div>
                </div>

                <h2 class="login-left-headline">
                    One Platform.<br />
                    <span class="login-left-accent">Infinite Possibilities.</span>
                </h2>
                <p class="login-left-subtext">
                    Manufacturing · Inventory · HR · Accounts · Analytics — all unified.
                </p>

                <!-- ERP Module Cards Grid -->
                <div class="login-module-grid">

                    <div class="login-mod-card login-mod-blue">
                        <i class="bi bi-cart-check-fill"></i>
                        <span>Sales &amp; Labour Work</span>
                    </div>

                    <div class="login-mod-card login-mod-teal">
                        <i class="bi bi-bag-check-fill"></i>
                        <span>Purchase &amp; Subcontract</span>
                    </div>

                    <div class="login-mod-card login-mod-purple">
                        <i class="bi bi-calendar2-week-fill"></i>
                        <span>Planning</span>
                    </div>

                    <div class="login-mod-card login-mod-orange">
                        <i class="bi bi-gear-wide-connected"></i>
                        <span>Production</span>
                    </div>

                    <div class="login-mod-card login-mod-pink">
                        <i class="bi bi-people-fill"></i>
                        <span>HUMAN Resource Management System</span>
                    </div>

                    <div class="login-mod-card login-mod-green">
                        <i class="bi bi-cash-stack"></i>
                        <span>Accounts</span>
                    </div>

                    <div class="login-mod-card login-mod-purple">
                        <i class="bi bi-clipboard2-check-fill"></i>
                        <span>Inspection (QC)</span>
                    </div>

                    <div class="login-mod-card login-mod-orange">
                        <i class="bi bi-tools"></i>
                        <span>Maintanence</span>
                    </div>

                    <div class="login-mod-card login-mod-blue">
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>Reports</span>
                    </div>

                </div>
                <!-- Floating stat pills -->
                <div class="login-stat-row">
                    <div class="login-stat-pill">
                        <i class="bi bi-shield-check"></i>
                        <span>ISO Compliant</span>
                    </div>
                    <div class="login-stat-pill">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>Real-Time Sync</span>
                    </div>
                    <div class="login-stat-pill">
                        <i class="bi bi-cloud-check-fill"></i>
                        <span>Cloud Ready</span>
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL — Login Form -->
            <div class="login-right">
                <div class="login-card glass-card">

                    <!-- Top logo for mobile -->
                    <div class="login-card-top-logo d-md-none">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>V.SMART</span>
                    </div>

                    <div class="login-card-icon">
                        <i class="bi bi-person-lock"></i>
                    </div>

                    <h3 class="login-card-title">Welcome Back</h3>
                    <p class="login-card-subtitle">Sign in to your ERP dashboard</p>

                    <EditForm Model="LoginModel" OnValidSubmit="HandleLogin">
                        <DataAnnotationsValidator />

                        <div class="login-field-group">
                            <label class="login-label">
                                <i class="bi bi-person-fill"></i>
                                Username
