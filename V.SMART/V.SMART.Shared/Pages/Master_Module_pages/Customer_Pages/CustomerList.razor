@page "/customer"
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@inject ICustomerService customerService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Customers List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@QuoteBreadcrumbs" />

            <div class="card-body p-4">

                 <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                 value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Active">Active</option>
                            <option value="In Active">In Active</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                       <div class="col-6 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewQuote">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </button>
                       </div>
                    }

                </div>

                @if (CustomerVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="CustomerVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Any(c => c.IsVisible))
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>

                                        @switch (col.Field)
                                        {
                                            case "CustId":
                                                <PropertyColumn Title="Customer ID" Property="@(x => x.CustId)" />
                                                break;

                                            case "CustName":
                                                <PropertyColumn Title="Customer Name" Property="@(x => x.CustName)" Sortable="true" />
                                                break;

                                            case "CustAddr":
                                                <PropertyColumn Title="Customer Address" Property="@(x => x.CustAddr)" />
                                                break;

                                            case "GSTNo":
                                                <PropertyColumn Title="GST No" Property="@(x => x.GSTNo)" />
                                                break;

                                            case "PANNo":
                                                <PropertyColumn Title="PAN No" Property="@(x => x.PANNo)" />
                                                break;

                                            case "ContactNo":
                                                <PropertyColumn Title="Contact No" Property="@(x => x.ContactNo)" />
                                                break;

                                            case "Email":
                                                <PropertyColumn Title="Email" Property="@(x => x.Email)" />
                                                break;

                                            case "StateId":
                                                <PropertyColumn Title="State ID" Property="@(x => x.StateId)" />
                                                break;

                                            case "StateName":
                                                <PropertyColumn Title="State Name" Property="@(x => x.StateName)" />
                                                break;

                                            case "PinCode":
                                                <PropertyColumn Title="PIN Code" Property="@(x => x.PinCode)" />
                                                break;

                                            case "Location":
                                                <PropertyColumn Title="Location" Property="@(x => x.Location)" />
                                                break;

                                            case "Distance":
                                                <PropertyColumn Title="Distance (KM)" Property="@(x => x.Distance)" />
                                                break;

                                            case "BusiType":
                                                <PropertyColumn Title="Business Type" Property="@(x => x.BusiType)" />
                                                break;

                                            case "SupTyp":
                                                <PropertyColumn Title="Customer Type" Property="@(x => x.SupTyp)" />
                                                break;

                                            case "Scope":
                                                <PropertyColumn Title="Scope" Property="@(x => x.Scope)" />
                                                break;

                                            case "TanNo":
                                                <PropertyColumn Title="TAN No" Property="@(x => x.TanNo)" />
                                                break;

                                            case "CINNo":
                                                <PropertyColumn Title="CIN No" Property="@(x => x.CINNo)" />
                                                break;

                                            case "CurrId":
                                                <PropertyColumn Title="Currency ID" Property="@(x => x.CurrId)" />
                                                break;

                                            case "CurrName":
                                                <PropertyColumn Title="Currency Name" Property="@(x => x.CurrName)" />
                                                break;

                                            case "OpenBal":
                                                <PropertyColumn Title="Opening Balance" Property="@(x => x.OpenBal)" Format="N2" />
                                                break;

                                            case "OpenBalPndg":
                                                <PropertyColumn Title="Pending Balance" Property="@(x => x.OpenBalPndg)" Format="N2" />
                                                break;

                                            case "OpenBalDate":
                                                <PropertyColumn Title="Opening Balance Date" Property="@(x => x.OpenBalDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "TDS":
                                                <PropertyColumn Title="TDS %" Property="@(x => x.TDS)" Format="N3" />
                                                break;

                                            case "TDSExmptdAmt":
                                                <PropertyColumn Title="TDS Exempted Amount" Property="@(x => x.TDSExmptdAmt)" Format="N3" />
                                                break;

                                            case "TDSBillval":
                                                <PropertyColumn Title="TDS Bill Value" Property="@(x => x.TDSBillval)" Format="N3" />
                                                break;

                                            case "TDSDeductper":
                                                <PropertyColumn Title="TDS Deduct %" Property="@(x => x.TDSDeductper)" Format="N3" />
                                                break;

                                            case "TdsDeduct":
                                                <PropertyColumn Title="TDS Deduct" Property="@(x => x.TdsDeduct)" />
                                                break;

                                            case "TdsDeductInSales":
                                                <PropertyColumn Title="TDS Deduct In Sales" Property="@(x => x.TdsDeductInSales)" />
                                                break;

                                            case "RejectRetrac":
                                                <TemplateColumn Title="Reject Retract" Context="x">
                                                    <span class="badge @(x.RejectRetrac ? "bg-success" : "bg-secondary")">
                                                        @(x.LineId ? "Required" : "Not Required")
                                                    </span>
                                                </TemplateColumn>
                                                break;

                                            case "LineId":
                                                <TemplateColumn Title="Line ID" Context="x">
                                                    <span class="badge @(x.LineId ? "bg-success" : "bg-secondary")">
                                                        @(x.LineId ? "Required" : "Not Required")
                                                    </span>
                                                </TemplateColumn>
                                                break;

                                            case "IsWoNoReq":
                                                <TemplateColumn Title="WO Required" Context="x">
                                                    <span class="badge @(x.IsWoNoReq ? "bg-success" : "bg-secondary")">
                                                        @(x.IsWoNoReq ? "Required" : "Not Required")
                                                    </span>
                                                </TemplateColumn>
                                                break;

                                            case "TaxValidate":
                                                <TemplateColumn Title="Tax Validate" Context="x">
                                                    <span class="badge @(x.TaxValidate ? "bg-success" : "bg-secondary")">
                                                        @(x.TaxValidate ? "Required" : "Not Required")
                                                    </span>
                                                </TemplateColumn>
                                                break;

                                            case "Inactive":
                                                <TemplateColumn Title="Status" Context="x">
                                                    @if (!x.Inactive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Inactive</span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            case "BankDetails":
                                                <PropertyColumn Title="Bank Details" Property="@(x => x.BankDetails)" />
                                                break;

                                            case "Remark":
                                                <PropertyColumn Title="Remark" Property="@(x => x.Remark)" />
                                                break;

                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(x => x.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date" Property="@(x => x.CreatedDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(x => x.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date" Property="@(x => x.ModifiedDate)" Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }
                            }

                            <!-- ACTION COLUMN -->
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">

                                    @if (CanEdit)
                                    {
                                        <a href="@($"Customer/update/{c.CustId}?currentPage={currentPage}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Customer">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }

                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete Customer"
                                                @onclick="() => HandleDelete(c.CustId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }

                                </div>
                            </TemplateColumn>

                        </QuickGrid>

                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}


@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Customer";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteCustId = 0;
    private string searchText = string.Empty;
    private string selectedStatus = "";

    private List<CustomerVM> CustomerVMs = new();


    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    // === Paging & Search ===
    private int totalItems;
   // private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> QuoteBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "General Master" },
        new PageHeader.BreadcrumbItem { Text = "Customer Master", IsLast = true }
    };

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }
            //Sathish
            if (currentPage < 1)
            {
                currentPage = 1;
            }

            await LoadAllCustomers();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in Customers OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    #region === Data Loading ===

    private async Task LoadAllCustomers()
    {
        try
        {
            var result = await customerService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            CustomerVMs = result.customerVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading data in Customer List");
            await _JS.ToastrError("Failed to load Customer List.");
        }
    }

    private void AddNewQuote()
    {
        _navigation.NavigateTo("/customer/create");
    }

    #endregion



    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                // =========================
                // KEYS
                // =========================
                new() { Title = "Customer ID", Field = "CustId", IsVisible = false },

                // =========================
                // BASIC DETAILS
                // =========================
                new() { Title = "Customer Name", Field = "CustName", IsVisible = true },
                new() { Title = "Customer Address", Field = "CustAddr", IsVisible = false },
                new() { Title = "GST No", Field = "GSTNo", IsVisible = true },
                new() { Title = "PAN No", Field = "PANNo", IsVisible = false },
                new() { Title = "Contact No", Field = "ContactNo", IsVisible = true },
                new() { Title = "Email", Field = "Email", IsVisible = false },

                // =========================
                // LOCATION DETAILS
                // =========================
                new() { Title = "State ID", Field = "StateId", IsVisible = false },
                new() { Title = "State Name", Field = "StateName", IsVisible = true },
                new() { Title = "PIN Code", Field = "PinCode", IsVisible = true },
                new() { Title = "Location", Field = "Location", IsVisible = true },
                new() { Title = "Distance", Field = "Distance", IsVisible = false },

                // =========================
                // BUSINESS DETAILS
                // =========================
                new() { Title = "Business Type", Field = "BusiType", IsVisible = true },
                new() { Title = "Customer Type", Field = "SupTyp", IsVisible = true },
                new() { Title = "Scope", Field = "Scope", IsVisible = false },
                new() { Title = "TAN No", Field = "TanNo", IsVisible = false },
                new() { Title = "CIN No", Field = "CINNo", IsVisible = false },

                // =========================
                // FINANCIAL DETAILS
                // =========================
                new() { Title = "Currency ID", Field = "CurrId", IsVisible = false },
                new() { Title = "Currency Name", Field = "CurrName", IsVisible = false },
                new() { Title = "Opening Balance", Field = "OpenBal", IsVisible = true },
                new() { Title = "Pending Balance", Field = "OpenBalPndg", IsVisible = false },
                new() { Title = "Opening Balance Date", Field = "OpenBalDate", IsVisible = false },

                // =========================
                // TDS DETAILS
                // =========================
                new() { Title = "TDS %", Field = "TDS", IsVisible = false },
                new() { Title = "TDS Exempted Amount", Field = "TDSExmptdAmt", IsVisible = false },
                new() { Title = "TDS Bill Value", Field = "TDSBillval", IsVisible = false },
                new() { Title = "TDS Deduct %", Field = "TDSDeductper", IsVisible = false },
                new() { Title = "TDS Deduct", Field = "TdsDeduct", IsVisible = false },
                new() { Title = "TDS Deduct In Sales", Field = "TdsDeductInSales", IsVisible = false },

                // =========================
                // FLAGS
                // =========================
                new() { Title = "Reject Retract", Field = "RejectRetrac", IsVisible = false },
                new() { Title = "Line ID", Field = "LineId", IsVisible = false },
                new() { Title = "WO Required", Field = "IsWoNoReq", IsVisible = false },
                new() { Title = "Tax Validate", Field = "TaxValidate", IsVisible = false },
                new() { Title = "Inactive", Field = "Inactive", IsVisible = true },

                // =========================
                // OTHER DETAILS
                // =========================
                new() { Title = "Bank Details", Field = "BankDetails", IsVisible = false },
                new() { Title = "Remark", Field = "Remark", IsVisible = false },

                // =========================
                // AUDIT
                // =========================
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };

            if (!Hidden)
            {
                // Columns.AddRange(new[]
                // {
                //     new GridColumn { Title = "Extra Column 1", Field = "Extra1", IsVisible = false },
                //     new GridColumn { Title = "Extra Column 2", Field = "Extra2", IsVisible = false },
                // });
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Customer List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Customer HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllCustomers();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Customer List");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllCustomers();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Customer List");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllCustomers();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Customer List");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllCustomers();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Customer List");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllCustomers();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Customer List");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllCustomers();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Customer List page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int custId)
    {
        try
        {
            var (canDelete, message) = await customerService.CanDeleteCustomerAsync(custId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteCustId = custId;

            ModalTitle = "Are you sure you want to delete this Customer";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for CustId: {custId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;
           
            var deleted = await customerService.DeleteCustomerByCustIdAsync(DeleteCustId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Customer deleted successfully.");
                await LoadAllCustomers();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Customer could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting CustId: {DeleteCustId}");
            await _JS.ToastrError("Failed to delete Customer.");
        }
        finally
        {
            DeleteCustId = 0;
            isProcessing = false;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllCustomers();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Customer List");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion


    #region Job order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

           if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;


            currentPage = 1;
            await LoadAllCustomers();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in Customer List");
            await _JS.ToastrError("Failed to Load Customer List filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion 

}
