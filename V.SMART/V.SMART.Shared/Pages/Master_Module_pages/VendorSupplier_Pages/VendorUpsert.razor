@page "/vendor/create"
@page "/vendor/update/{VendorCode:int}"
@using V.SMART.Shared.Data.Master.General
@using V.SMART.Shared.Data.Master.General_Module
@using System.Text.RegularExpressions

@inherits BaseUserRightsComponent
@inject CurrentUserService _userService
@inject ILoggingService LoggingService
@inject IUnitOfWork _unitOfWork
@inject NavigationManager _navigationManager
@inject IJSRuntime _JS

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container-fluid px-2 px-md-5 mt-4">
            <div class="card shadow-sm border-1">

                <PageHeader TitleText="@VendorHeaderText"
                            TitleIcon="bi bi-person-badge me-1"
                            Breadcrumbs="@vendorBreadcrumbs" />

                <div class="card-body">
                    <EditForm Model="Vendor" OnValidSubmit="UpsertVendor">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <!-- Checkboxes -->
                        <div class="row g-3 mb-3">

                            @if (Vendor != null && Vendor.VendorCode > 0 && !string.IsNullOrWhiteSpace(Vendor.VendorName))
                            {
                                <CorrespondenceStatus ReferenceType="Vendors"
                                                      ReferenceId="@Vendor.VendorCode"
                                                      ReferenceTypeName="@Vendor.VendorName" />
                            }

                            <div class="col-12 ps-3">
                                <div class="col-12 d-flex flex-wrap gap-3 ps-2">
                                    <div class="form-check me-3">
                                        <InputCheckbox @bind-Value="Vendor.IsitPurch" id="Purchase" class="form-check-input " />
                                        <label class="form-check-label text-primary " for="Purchase">Purchase</label>
                                    </div>

                                    <div class="form-check me-3">
                                        <InputCheckbox @bind-Value="Vendor.IsitSubCon" id="SubContract" class="form-check-input" />
                                        <label class="form-check-label text-primary " for="SubContract">SubContract</label>
                                    </div>

                                    <div class="form-check me-3">
                                        <InputCheckbox @bind-Value="Vendor.Inactive" id="Inactive" class="form-check-input" />
                                        <label class="form-check-label text-danger " for="Inactive">Inactive</label>
                                    </div>
                                    <div class="form-check me-3">
                                        <InputCheckbox @bind-Value="Vendor.RejectionRetract" id="Rejection" class="form-check-input" />
                                        <label class="form-check-label text-danger " for="Rejection">Rejection-Retract</label>
                                    </div>

                                    <div class="form-check me-3">
                                        <InputCheckbox @bind-Value="Vendor.TaxValidate" id="Taxation" class="form-check-input" />
                                        <label class="form-check-label text-success " for="Taxation">Taxation Validation Not Required?</label>
                                    </div>
                                    <div class="form-check me-3">
                                        <InputCheckbox @bind-Value="Vendor.IsAllowAccRejRew" id="RejectSCN" class="form-check-input" />
                                        <label class="form-check-label text-success " for="RejectSCN">SCN Full Qty(AQ+RQ+RQ) Required to Invoice? </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <TrimmedInputText @bind-Value="Vendor.VendorName" id="VendorName" class="form-control" placeholder="Vendor/Supplier Name" CssClass="form-control" maxlength="100" />
                                    <label for="VendorName">Vendor/Supplier Name</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.VendorName)" />
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputTextArea @bind-Value="Vendor.VendorAddress" id="Address" class="form-control" placeholder="Vendor Address" maxlength="250" style="height: 50px;" />
                                    <label for="Address">Vendor Address</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.VendorAddress)" />
                            </div>

                            <!-- Pin, GST, PAN -->

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.PinCode" id="Pincode" class="form-control" placeholder="PIN Code" maxlength="6"
                                               oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                    <label for="PinCode">PINCode</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.PinCode)" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <select id="BusiType"
                                            class="form-select"
                                            value="@Vendor.BusiType"
                                            @onchange="OnBusinessTypeChanged">
                                        <option value="">Select Business Type</option>
                                        @foreach (var business in BusinessTypes)
                                        {
                                            <option value="@business.Name">@business.Name</option>
                                        }
                                    </select>
                                    <label for="BusiType">Business Type</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.BusiType)" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.GSTNo" @oninput="OnVATChanged" id="GSTNo" class="form-control" placeholder="GSTNo" maxlength="15" />
                                    <label for="GSTNo">GSTNo</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.GSTNo)" />
                            </div>





                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.PANNo" id="PANNo" class="form-control" placeholder="PANNo" readonly maxlength="10" />
                                    <label for="PANNo">PANNo</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.PANNo)" />
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">

                                    <select class="form-select"
                                            value="@Vendor.StateCode"
                                            @onchange="OnStateChanged">
                                        <option value="">--Select State--</option>
                                        @foreach (var sta in States)
                                        {
                                            <option value="@sta.StateCode">@sta.StateCode - @sta.StateName</option>
                                        }
                                    </select>


                                    <label for="stateSelect">State</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.StateName)" />
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input class="form-control" @bind="Vendor.StateCode" readonly />
                                    <label for="stateSelect">StateCode</label>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputNumber @bind-Value="Vendor.Distance" id="Distance" class="form-control" placeholder="Distance" />
                                    <label for="Distance">Distance</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.Distance)" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.Location" id="Location" class="form-control" placeholder="Location" maxlength="100" />
                                    <label for="Location">Location</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.Location)" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.Email" id="Email" class="form-control" placeholder="Email" maxlength="100" />
                                    <label for="Email">Email</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.Email)" />
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.CustomerCode" id="CustomerCode" class="form-control" placeholder="CustomerCode" maxlength="15" />
                                    <label for="CustomerCode">CustomerCode</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.CustomerCode)" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.TANNo" id="TANNo" class="form-control" placeholder="TANNo" maxlength="50" />
                                    <label for="TANNo">TANNo</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.TANNo)" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.CINNo" id="CINNo" class="form-control" placeholder="CINNo" maxlength="50" />
                                    <label for="CINNo">CINNo</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.CINNo)" />
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-value="Vendor.Country" id="Country" class="form-control" placeholder="Country" maxlength="100" />
                                    <label for="Country">Country</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.Country)" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.Remarks" id="Remarks" class="form-control" placeholder="Remarks" maxlength="500" />
                                    <label for="Remarks">Remarks</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.Remarks)" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.Scope" id="Scope" class="form-control" placeholder="Scope" maxlength="250" />
                                    <label for="Scope">Scope</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.Scope)" />
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputTextArea @bind-Value="Vendor.TermsAndCondition" id="TermsAndCondition" class="form-control" placeholder="Terms And Conditions" maxlength="500" />
                                    <label for="TermsAndCondition">Terms And Conditions</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.TermsAndCondition)" />
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputSelect id="currencySelect" class="form-select" @bind-Value="Vendor.CurrId">
                                        <option value="">Select Currency</option>
                                        @foreach (var curr in Currencies)
                                        {
                                            <option value="@curr.CurrId">@curr.CurrName</option>
                                        }
                                    </InputSelect>
                                    <label for="currencySelect">Currency</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.CurrId)" />
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <InputText @bind-Value="Vendor.ContactNo"
                                               id="ContactNo"
                                               class="form-control"
                                               placeholder="Contact No"
                                               maxlength="15"
                                               oninput="this.value = this.value.replace(/[^0-9+]/g, '')" />
                                    <label for="ContactNo">Contact No</label>
                                </div>
                                <ValidationMessage For="@(() => Vendor.ContactNo)" />
                            </div>

                        </div>

                        <div class="row g-3 mt-1">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "contacts" ? "active" : (IsNoTabActive ? "tab-contacts" : ""))"
                                       @onclick="@(() => SetTab("contacts"))">Add Contacts</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "consignee" ? "active" : (IsNoTabActive ? "tab-consignee" : ""))"
                                       @onclick="@(() => SetTab("consignee"))">Add Consignee</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "tds" ? "active" : (IsNoTabActive ? "tab-tds" : ""))"
                                       @onclick="@(() => SetTab("tds"))">TDS</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "bank" ? "active" : (IsNoTabActive ? "tab-bank" : ""))"
                                       @onclick="@(() => SetTab("bank"))">BANK Details</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeTab == "more" ? "active" : (IsNoTabActive ? "tab-more" : ""))"
                                       @onclick="@(() => SetTab("more"))">More Details</a>
                                </li>
                            </ul>
                        </div>

                        <div class="tab-content mt-3">
                            @if (activeTab == "contacts")
                            {
                                <!-- Contacts Table -->
                                <div class="container-fluid my-4">
                                    <div class="card shadow border-0">
                                        <div class="bg-secondary text-center py-2 card-header">
                                            <h5 class="text-white">Vendor Contact Details</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-sm align-middle text-center" style="table-layout: fixed; width: 100%;">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th style="width: 160px;font-size: 12px;background-color: #1f7fb9; color: white;">Contact Person</th>
                                                                <th style="width: 160px;font-size: 12px;background-color: #1f7fb9; color: white;">Contact No</th>
                                                                <th style="width: 160px;font-size: 12px;background-color: #1f7fb9; color: white;">Email</th>
                                                                <th style="width: 80px;font-size: 12px;background-color: #1f7fb9; color: white;">Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var contact in Contacts)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <InputText class="form-control" @bind-Value="contact.ContactPerson" maxlength="100" />
                                                                        <ValidationMessage For="@(() => contact.ContactPerson)" />
                                                                    </td>
                                                                    <td>
                                                                        <InputText class="form-control" @bind-Value="contact.ContactNo" maxlength="15"
                                                                                   oninput="this.value = this.value.replace(/[^0-9+]/g, '')" />
                                                                        <ValidationMessage For="@(() => contact.ContactNo)" />
                                                                    </td>
                                                                    <td>
                                                                        <InputText class="form-control" @bind-Value="contact.Email" maxlength="100" />
                                                                        <ValidationMessage For="@(() => contact.Email)" />
                                                                    </td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-danger btn-sm" @onclick="@(() => RemoveContact(contact))">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div class="row mt-1">
                                                    <div class="col-md-3 d-flex align-items-center " style="height: 50px;">
                                                        <button type="button" class="btn" style="font-size: 12px; background-color:Purple;color:white" @onclick="AddContact">
                                                            <i class="bi bi-plus-circle"></i> Add Row
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "consignee")
                            {
                                <!-- Consignee Table -->
                                <div class="container-fluid my-4">
                                    <div class="card shadow border-0">
                                        <div class="bg-secondary text-center py-2 card-header">
                                            <h5 class="text-white">Consignee Details</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">

                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-sm align-middle text-center" style="table-layout: fixed; width: 100%;">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th style="width: 190px;font-size: 12px;background-color: #1f7fb9; color: white;">Alternate Vendor/Supplier</th>
                                                                <th style="width: 180px;font-size: 12px;background-color: #1f7fb9; color: white;">Address</th>
                                                                <th style="width: 180px;font-size: 12px;background-color: #1f7fb9; color: white;">Address-2</th>
                                                                <th style="width: 100px;font-size: 12px;background-color: #1f7fb9; color: white;">PinCode</th>
                                                                <th style="width: 160px;font-size: 12px;background-color: #1f7fb9; color: white;">GSTNo</th>
                                                                <th style="width: 130px;font-size: 12px;background-color: #1f7fb9; color: white;">PANNo</th>
                                                                <th style="width: 200px;font-size: 12px;background-color: #1f7fb9; color: white;">Email</th>
                                                                <th style="width: 150px;font-size: 12px;background-color: #1f7fb9; color: white;">Contact Person</th>
                                                                <th style="width: 130px;font-size: 12px;background-color: #1f7fb9; color: white;">Contact No</th>
                                                                <th style="width: 150px;font-size: 12px;background-color: #1f7fb9; color: white;">State</th>
                                                                <th style="width: 120px;font-size: 12px;background-color: #1f7fb9; color: white;">City</th>
                                                                <th style="width: 120px;font-size: 12px;background-color: #1f7fb9; color: white;">Country</th>
                                                                <th style="width: 80px; font-size: 12px;background-color: #1f7fb9; color: white;">Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var VendInd in Indirects)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="VendInd.AltVendorName" maxlength="100" />
                                                                        <ValidationMessage For="@(() => VendInd.Email)" />
                                                                    </td>
                                                                    <td>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="VendInd.AltVendorAddr1" maxlength="250" />
                                                                        <ValidationMessage For="@(() => VendInd.AltVendorAddr1)" />
                                                                    </td>
                                                                    <td>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="VendInd.AltVendorAddr2" IsFrozen="true" maxlength="250" />
                                                                        <ValidationMessage For="@(() => VendInd.AltVendorAddr2)" />
                                                                    </td>
                                                                    <td>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="VendInd.PinCode"
                                                                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="6" />
                                                                        <ValidationMessage For="@(() => VendInd.PinCode)" />
                                                                    </td>
                                                                    <td>
                                                                        <InputText class="form-control form-control-sm"
                                                                                   @bind-Value="VendInd.GSTNo"
                                                                                   @oninput="@(e => OnGstChanged(e, VendInd))" maxlength="15" /><ValidationMessage For="@(() => VendInd.GSTNo)" />
                                                                    </td>

                                                                    <td>
                                                                        <InputText class="form-control form-control-sm"
                                                                                   @bind-Value="VendInd.PANNo" /><ValidationMessage For="@(() => VendInd.PANNo)" readonly />
                                                                    </td>

                                                                    <td>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="VendInd.Email" maxlength="100" />
                                                                        <ValidationMessage For="@(() => VendInd.Email)" />
                                                                    </td>
                                                                    <td>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="VendInd.ContactPerson" maxlength="50" />
                                                                        <ValidationMessage For="@(() => VendInd.ContactPerson)" />
                                                                    </td>
                                                                    <td>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="VendInd.ContactNo" maxlength="15"
                                                                                   oninput="this.value = this.value.replace(/[^0-9+]/g, '')" />
                                                                        <ValidationMessage For="@(() => VendInd.ContactNo)" />
                                                                    </td>

                                                                    <td>


                                                                        <select id="SateSelect" @bind="VendInd.StateName" class="form-select">

                                                                            <option value="">Select State</option>
                                                                            @foreach (var sta in States)
                                                                            {
                                                                                <option value="@sta.StateName">@sta.StateName</option>

                                                                            }
                                                                        </select>
                                                                    </td>

                                                                    <td>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="VendInd.City" maxlength="50" />
                                                                        <ValidationMessage For="@(() => VendInd.City)" />
                                                                    </td>
                                                                    <td>
                                                                        <InputText class="form-control form-control-sm" @bind-Value="VendInd.Country" maxlength="100" />
                                                                        <ValidationMessage For="@(() => VendInd.Country)" />
                                                                    </td>
                                                                    <td>
                                                                        <button type="button" class="btn btn-danger btn-sm" @onclick="@(() => RemoveVendorIndirect(VendInd))">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <div class="row mt-1">
                                                    <div class="col-md-3 d-flex align-items-center " style="height: 50px;">
                                                        <button type="button" class="btn" style="font-size: 12px; background-color:Purple;color:white" @onclick="AddVendorIndirect">
                                                            <i class="bi bi-plus-circle"></i> Add Row
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "tds")
                            {

                                <div class="container-fluid my-4">
                                    <div class="card shadow border-0">
                                        <div class="bg-secondary text-center py-2 card-header">
                                            <h5 class="text-white">TDS Details</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <InputNumber @bind-Value="Vendor.TDSExmptdAmt" id="TDSExmptdAmt" class="form-control" placeholder="TDS Exempted Amount (Yearly)" onkeypress="return isNumericWithDot(event)" />
                                                        <label for="TDSExmptdAmt">TDS Exempted Amount (Yearly)</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => Vendor.TDSExmptdAmt)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <InputNumber @bind-Value="Vendor.TDSDeductper" id="TDSDeductper" class="form-control" placeholder="TDS Deduction (%)" onkeypress="return isNumericWithDot(event)" />
                                                        <label for="TDSDeductper">TDS Deduction (%)</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => Vendor.TDSDeductper)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <InputNumber @bind-Value="Vendor.TDSBillval" id="TDSBillval" class="form-control" placeholder="Maximum Amount per Single Invoice" onkeypress="return isNumericWithDot(event)" />
                                                        <label for="TDSBillval">Maximum Amount per Single Invoice</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => Vendor.TDSBillval)" />
                                                </div>
                                            </div>
                                            <div class="row g-3 mt-3">
                                                <div class="col-md-6">
                                                    <div class="form-check">
                                                        <InputCheckbox @bind-Value="Vendor.TdsDeduct" id="TDSAutoDeduct" class="form-check-input" />
                                                        <label class="form-check-label text-primary" for="TDSAutoDeduct">Auto TDS Deduction</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (activeTab == "bank")
                            {
                                <!-- Bank Details -->
                                <div class="container-fluid my-4">
                                    <div class="card shadow border-0">
                                        <div class="bg-secondary text-center py-2 card-header">
                                            <h5 class="text-white">BANK Details</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="form-floating">
                                                        <InputText @bind-Value="Vendor.BankName" id="BankName" class="form-control" placeholder="BANK Name" maxlength="100" />
                                                        <label for="BankName">BANK Name</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => Vendor.BankName)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-floating">
