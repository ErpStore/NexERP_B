@code
{
    protected override string ScreenName => "Vendor";

    [Parameter]
    public int? VendorCode { get; set; }

    [Parameter]
    public bool isModelVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private bool isProcessing = true;
    private Vendor Vendor { get; set; } = new Vendor();

    private List<State> States { get; set; } = new();
    private List<VendorInDirect> Indirects { get; set; } = new();
    private List<VendorContact> Contacts { get; set; } = new();
    private List<Currency> Currencies { get; set; } = new List<Currency>();
    private List<VendorInDirect> _originalIndirects;
    private List<VendorContact> _originalContacts;

    private string activeTab = "";
    private void SetTab(string tab) => activeTab = tab;
    private bool IsNoTabActive => string.IsNullOrEmpty(activeTab);

    private List<PageHeader.BreadcrumbItem> vendorBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "General" },
        new PageHeader.BreadcrumbItem { Text = "Vendor/Supplier", IsLast = true }
    };

    private string VendorHeaderText => VendorCode == 0 || VendorCode == null
        ? "Create Vendor/Supplier"
        : "Update Vendor/Supplier";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            await LoadStates();
            await LoadCurrencies();
            await LoadVendorSupplierData();

            isProcessing = false;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred during the execution of the Vendor.OnInitializedAsync() Method");
            isProcessing = false;
        }
    }


    private async Task LoadStates()
    {
        try
        {
            var existing = await _unitOfWork.States.GetAllAsync();
            if (existing != null)
            {
                States = existing.ToList();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Vendor LoadState() Method");
        }
    }

    private async Task LoadCurrencies()
    {
        try
        {
            var existing = await _unitOfWork.Currencyis.GetAllAsync();
            if (existing != null)
            {
                Currencies = existing.ToList();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Customer LoadCurrency() Method");
        }
    }

    private async Task LoadVendorSupplierData()
    {
        try
        {
            if (VendorCode > 0)
            {
                var existing = await _unitOfWork.Vendors.GetAsync(VendorCode.Value);
                if (existing != null)
                {
                    Vendor = existing;

                    var indirects = await _unitOfWork.VendorInDirects.FindAsync(x => x.VendorCode == Vendor.VendorCode);
                    Indirects = indirects?.ToList() ?? new();

                    var contacts = await _unitOfWork.VendorContacts.FindAsync(x => x.VendorCode == Vendor.VendorCode);
                    Contacts = contacts?.ToList() ?? new();

                    _originalIndirects = Indirects.ToList();
                    _originalContacts = Contacts.ToList();
                }
            }

            if (!Indirects.Any())
            {
                Indirects.Add(new VendorInDirect());
            }
            if (!Contacts.Any())
            {
                Contacts.Add(new VendorContact());
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Vendor.LoadVendorData() Method");
        }
    }

    private async Task UpsertVendor()
    {
        isProcessing = true;
        using var transaction = await _unitOfWork.BeginTransactionAsync();
        try
        {
            // --- Validation ---
            bool isDuplicate = await _unitOfWork.Vendors.ExistsByNameAsync("VendorName", Vendor.VendorName?.Trim(), "VendorCode", Vendor.VendorCode == 0 ? null : Vendor.VendorCode);
            if (isDuplicate)
            {
                await _JS.ToastrError("Vendor Name already exists.");
                isProcessing = false;
                return;
            }

            var errors = new List<string>();

            if (!Vendor.IsitPurch && !Vendor.IsitSubCon)
            {
                errors.Add("Please select the checkbox whether it is Subcontract or Purchase type.");
            }
            else if (Vendor.IsitSubCon)
            {
                double dist = 0;
                double.TryParse(Vendor.Distance.ToString(), out dist);
                if (dist == 0)
                {
                    errors.Add("Please enter Distance.");
                }
            }

            string busiType = Vendor.BusiType?.ToString()?.Trim();
            if (busiType == "Imports" || busiType == "Exports")
            {
                if (!string.Equals(Vendor.GSTNo, "URP", StringComparison.OrdinalIgnoreCase))
                {
                    errors.Add("For Imports/Exports, GST No must be 'URP'.");
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(Vendor.GSTNo))
                {
                    errors.Add("Please enter GST No.");
                }
                else if (Vendor.GSTNo.Length != 15)
                {
                    errors.Add("GST No must be 15 characters.");
                }
                else if (!Regex.IsMatch(Vendor.GSTNo, @"^(URP|[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1})$"))
                {
                    errors.Add("Invalid GST No format.");
                }

                if (string.IsNullOrWhiteSpace(Vendor.PANNo))
                {
                    errors.Add("Please enter PAN No.");
                }
                else if (!Regex.IsMatch(Vendor.PANNo, @"^[A-Z]{5}[0-9]{4}[A-Z]{1}$"))
                {
                    errors.Add("Invalid PAN No format.");
                }
            }

            var matchedState = States.FirstOrDefault(s => s.StateCode == Vendor.StateCode);
            if (Vendor.StateCode == 0 || matchedState == null)
            {
                errors.Add("Please select a valid State.");
            }
            else
            {
                Vendor.StateName = matchedState.StateName;
            }

            if (errors.Any())
            {
                foreach (var err in errors)
                {
                    await _JS.ToastrError(err);
                }
                isProcessing = false;
                return;
            }

            if (Vendor.OpenBal.HasValue)
            {
                Vendor.OpenBalPndg = Vendor.OpenBal;
                Vendor.OpenBalDate = DateTime.Now;
            }
            else
            {
                Vendor.OpenBalPndg = null;
                Vendor.OpenBalDate = null;
            }

            var currentUsername = await _userService.GetUsernameAsync();

            if (Vendor.VendorCode == 0)
            {
                Vendor.CreatedBy = currentUsername;
                Vendor.CreatedDate = DateTime.Now;

                await _unitOfWork.Vendors.CreateAsync(Vendor);
                await _unitOfWork.SaveAsync();

                foreach (var indirect in Indirects.Where(i => !string.IsNullOrWhiteSpace(i.AltVendorName)))
                {
                    indirect.VendorCode = Vendor.VendorCode;
                    await _unitOfWork.VendorInDirects.CreateAsync(indirect);
                }

                foreach (var contact in Contacts.Where(c => !string.IsNullOrWhiteSpace(c.ContactPerson)))
                {
                    contact.VendorCode = Vendor.VendorCode;
                    await _unitOfWork.VendorContacts.CreateAsync(contact);
                }

                await _unitOfWork.SaveAsync();
                await transaction.CommitAsync();

                await LoggingService.LogUserAction(
                    UserName: currentUsername,
                    Machine: _userService.MachineName,
                    IP_Address: _userService.IpAddress,
                    screen: "Vendor",
                    action: $"Vendor Created: {Vendor.VendorName}",
                    additionalInfo: $"VendorName: {Vendor.VendorName}");

                await _JS.ToastrSuccess("Vendor Created Successfully");
            }
            else
            {
                var currentIndirectIds = Indirects.Where(i => i.AltVendorCode != 0).Select(i => i.AltVendorCode).ToHashSet();
                var indirectsToDelete = _originalIndirects
                                        .Where(original => !currentIndirectIds.Contains(original.AltVendorCode))
                                        .ToList();

                foreach (var indirectToDelete in indirectsToDelete)
                {
                    await _unitOfWork.VendorInDirects.DeleteAsync(indirectToDelete.AltVendorCode);
                }

                var currentContactIds = Contacts.Where(c => c.Id != 0).Select(c => c.Id).ToHashSet();
                var contactsToDelete = _originalContacts
                                        .Where(original => !currentContactIds.Contains(original.Id))
                                        .ToList();

                foreach (var contactToDelete in contactsToDelete)
                {
                    await _unitOfWork.VendorContacts.DeleteAsync(contactToDelete.Id);
                }

                Vendor.ModifiedBy = currentUsername;
                Vendor.ModifiedDate = DateTime.Now;
                await _unitOfWork.Vendors.UpdateAsync(Vendor);

                foreach (var indirect in Indirects.Where(i => !string.IsNullOrWhiteSpace(i.AltVendorName)))
                {
                    indirect.VendorCode = Vendor.VendorCode;

                    if (indirect.AltVendorCode == 0)
                    {
                        await _unitOfWork.VendorInDirects.CreateAsync(indirect);
                    }
                    else
                    {
                        await _unitOfWork.VendorInDirects.UpdateAsync(indirect);
                    }
                }

                foreach (var contact in Contacts.Where(c => !string.IsNullOrWhiteSpace(c.ContactPerson)))
                {
                    contact.VendorCode = Vendor.VendorCode;
                    if (contact.Id == 0)
                    {
                        await _unitOfWork.VendorContacts.CreateAsync(contact);
                    }
                    else
                    {
                        await _unitOfWork.VendorContacts.UpdateAsync(contact);
                    }
                }

                await _unitOfWork.SaveAsync();
                await transaction.CommitAsync();

                await LoggingService.LogUserAction(
                    UserName: currentUsername,
                    Machine: _userService.MachineName,
                    IP_Address: _userService.IpAddress,
                    screen: "Vendor/Supplier",
                    action: $"Vendor/Supplier Modified: {Vendor.VendorName}",
                    additionalInfo: $"VendorName: {Vendor.VendorName}");

                await _JS.ToastrSuccess("Vendor Updated Successfully");
            }

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/vendor");
        }
        catch (Exception ex)
        {
            await transaction.RollbackAsync();
            await _JS.ToastrError("An error occurred while saving the vendor.");
            await LoggingService.LogDeveloperError(ex, "An error occurred during the execution of the Vendor.UpsertVendor() Method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    // --- Event Handlers ---

    private async Task OnBusinessTypeChanged(ChangeEventArgs e)
    {
        try
        {
            if (e?.Value is null) return;

            var value = e.Value.ToString();
            Vendor.BusiType = value; // Direct assignment is fine here

            if (value == "Imports" || value == "Exports")
            {
                Vendor.GSTNo = "URP";
                var urpState = States.FirstOrDefault(s => s.StateCode == 99);
                if (urpState != null)
                {
                    Vendor.StateCode = 99;
                    Vendor.StateName = urpState.StateName;
                    Vendor.PANNo = string.Empty; // Clear PAN for URP
                }
            }
            else
            {

                if (string.Equals(Vendor.GSTNo, "URP", StringComparison.OrdinalIgnoreCase) || Vendor.GSTNo?.Length < 15)
                {
                    Vendor.GSTNo = string.Empty;
                }
                Vendor.PANNo = string.Empty; // Clear PAN
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred during the execution of the Vendor.OnBusinessTypeChanged() event");
        }
    }

    private List<(int Id, string Name)> BusinessTypes = new()
    {
        (1, "Local"),
        (2, "InterState"),
        (3, "Imports"),
        (4, "Exports")
    };

    private async Task OnVATChanged(ChangeEventArgs e)
    {
        try
        {
            if (e.Value is string vatValue)
            {
                vatValue = vatValue.ToUpper();
                Vendor.GSTNo = vatValue;

                if (!string.IsNullOrEmpty(vatValue) && vatValue.Length == 15)
                {

                    Vendor.PANNo = vatValue.Substring(2, 10);
                }
                else
                {
                    Vendor.PANNo = string.Empty;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred during the execution of the Vendor.OnVATChanged() event");
        }
    }

    private async Task OnStateChanged(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out int statecode))
            {
                var stateItem = States.FirstOrDefault(s => s.StateCode == statecode);
                if (stateItem != null)
                {
                    Vendor.StateCode = stateItem.StateCode;
                    Vendor.StateName = stateItem.StateName;
                }
            }
            else
            {
                Vendor.StateCode = 0;
                Vendor.StateName = "";
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred during the execution of the Vendor.OnStateChanged() event");
        }
    }

    private async Task AddContact()
    {
        try
        {
            if (Contacts.Any() && string.IsNullOrWhiteSpace(Contacts.Last().ContactPerson))
            {
                await _JS.ToastrWarning("Please fill the current row before adding a new one.");
                return;
            }
            Contacts.Add(new VendorContact());
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred during the execution of the Vendor.AddContact() event");
        }
    }

    private void RemoveContact(VendorContact contact)
    {
        Contacts.Remove(contact);
    }

    private async Task AddVendorIndirect()
    {
        try
        {
            if (Indirects.Any() && string.IsNullOrWhiteSpace(Indirects.Last().AltVendorName))
            {
                await _JS.ToastrWarning("Please fill the current row before adding a new one.");
                return;
            }
            Indirects.Add(new VendorInDirect());
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred during the execution of the Vendor.AddVendorIndirect() event");
        }
    }

    private void RemoveVendorIndirect(VendorInDirect indirect)
    {
        Indirects.Remove(indirect);
    }

    private async Task OnGstChanged(ChangeEventArgs e, VendorInDirect vendorIndirect) // Renamed CustInd to vendorIndirect for clarity
    {
        try
        {
            var gst = e.Value?.ToString();
            vendorIndirect.GSTNo = gst?.Trim(); // Handle null for gst

            if (!string.IsNullOrWhiteSpace(gst) && gst.Length == 15)
            {
                vendorIndirect.PANNo = gst.Substring(2, 10);
            }
            else
            {
                vendorIndirect.PANNo = string.Empty; // Clear PAN if GST is invalid
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Vendor Consignee GST OnGstChanged event");
        }
    }
}

