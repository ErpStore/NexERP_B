@page "/bom/details/{AssmblyID:int}"

@using V.SMART.Shared.Services.ReportViewer

@inherits BaseUserRightsComponent
@inject ICalculationService _calculationService
@inject ILoggingService LoggingService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject ReportService reportService
@inject ExcelExportService ExcelExportService

@inject IAssemblyDefService assemblyDefService  

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">
        <!-- Company Details Section -->
        <MyCompanyDetails />

        <hr class="border-2 border-primary-subtle mb-4" />

        <!-- Assembly & Document Details Section -->
        <div class="row g-3 mb-4">

            <!-- Assembly Type -->
            <div class="col-md-12">
                <div class="card border-1 shadow-sm rounded-3 h-100">
                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Assembly Details:
                    </div>
                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                <tr>
                                    <td>@(!string.IsNullOrEmpty(AssemblyDefVMs?.AssemblyItemCode) ? AssemblyDefVMs.AssemblyItemCode : "N/A")</td>
                                    <td>@(!string.IsNullOrEmpty(AssemblyDefVMs?.AssemblyItemName) ? AssemblyDefVMs.AssemblyItemName : "N/A")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-1 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                Assembly Items
            </div>
            <div class="table-responsive" style="overflow-x:auto;">
                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 500px;">
                    <thead class="custom-blue">
                        <tr>
                            <th>Sl No.</th>
                            <th>Item Code</th>
                            <th>Description</th>
                            <th >UOM</th>
                            <th>Util Qty</th>
                            <th>Remarks</th>
                            <th>Rack No.</th>
                        </tr>
                    </thead>

                    <tbody class="custom-size">
                        @if (bomRows != null && bomRows.Any())
                        {
                            @foreach (var item in bomRows)
                            {
                                <tr>
                                    <td>@item.SlNo</td>
                                    <td>@(item.PartItemCode ?? "—")</td>
                                    <td>@(item.PartItemName ?? "—")</td>
                                    <td class="text-center">@(item.UOM ?? "—")</td>
                                    <td class="text-end">@FormatDecimal(item.UtilQty)</td>
                                    <td>@(item.Remarks ?? "—")</td>
                                    <td>@(item.RackNo ?? "—")</td>
                                </tr>
                            }
                           
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    No items found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

       
        <!-- Actions -->
        <div class="d-flex gap-2 justify-content-end">
            <a href="@($"/bomList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                <i class="bi bi-arrow-bar-left me-1"></i> Back To List
            </a>

            <button type="button" class="btn btn-outline-secondary "
                    @onclick="OnPrint">
                <i class="bi bi-printer-fill me-1"></i> Print 
            </button>

        </div>

    </div>
}

@code
{
    protected override string ScreenName => "BOM";

    [Parameter] public int? AssmblyID { get; set; }

    private bool isProcessing { get; set; } = true;
    private AssemblyDefVM AssemblyDefVMs { get; set; } = new AssemblyDefVM();
    private Companydetails company { get; set; } = new Companydetails();
    private int Decimalplaces { get; set; } = 2;

    private List<AssemblyDefVM> bomRows = new();

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    string? pdfBase64;

    private string FormatDecimal(decimal? value)
    {
        if (value == null) return "0";
        return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
    }


    protected override async Task OnInitializedAsync()
    {
        company = await assemblyDefService.GetCompanyDetailsAsync();
        await LoadAssemblyAsync();
        isProcessing = false;
    }

    private async Task LoadAssemblyAsync()
    {
        try
        {
            if (AssmblyID > 0)
            {

                var Assy = await assemblyDefService.GetAssyByAssemblyIdAsync(AssmblyID.Value);

                AssemblyDefVMs.AssmblyID = AssmblyID;
                AssemblyDefVMs.AssemblyItemCode = Assy.AssemblyItemCode;
                AssemblyDefVMs.AssemblyItemName = Assy.AssemblyItemName;

                bomRows = await assemblyDefService.GetAssemblyDefByAssemblyIdAsync(AssmblyID.Value);

            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"LoadAssemblyAsync({AssmblyID})");

        }
    }

    private async Task OnPrint()
    {
        try
        {
            if (!bomRows.Any())
                return;

            var exportData = GetBomExportData();

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "AssemblyDetails", "", $"{AssemblyDefVMs.AssemblyItemCode}{AssemblyDefVMs.AssemblyItemName}");

            var base64 = Convert.ToBase64String(bytes);

            await _js.DownloadExcelAsync(base64, "AssemblyDetails.xlsx");

        }
        catch (Exception ex)
        {
            
            throw;
        }
    }

    private List<Dictionary<string, object>> GetBomExportData()
    {
        return bomRows
            .Select((row, index) =>
            {
                var dict = new Dictionary<string, object>();

                dict["Sl No."] = index + 1;
                dict["Item Code"] = row.PartItemCode;
                dict["Description"] = row.PartItemName;
                dict["UOM"] = row.UOM;
                dict["Util Qty"] = row.UtilQty;
                dict["Remarks"] = row.Remarks;
                dict["Rack No."] = row.RackNo;
                dict["Customer Material"] =row.IsLabourMaterial?"Customer Material":"In House";

                return dict;
            })
            .ToList();
    }
}
