@page "/costcenter"
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@inject ICostCenterService costCenterService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Cost Center List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@CostCenterBreadcrumbs" />

            <div class="card-body p-4">

                 <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">

                    </div>

                    @if (CanCreate)
                    {
                       <div class="col-6 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewCostCenter">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </button>
                       </div>
                    }

                </div>

                @if (CostCenterVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="CostCenterVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Any(c => c.IsVisible))
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>

                                        @switch (col.Field)
                                        {
                                            // =========================
                                            // BASIC DETAILS
                                            // =========================
                                            case "Id":
                                                <PropertyColumn Title="ID" Property="@(x => x.Id)" />
                                                break;

                                            case "ProjectTypeName":
                                                <PropertyColumn Title="Project Type"
                                                                Property="@(x => x.ProjectTypeName)"
                                                                Sortable="true" />
                                                break;

                                            case "ProjectNo":
                                                <PropertyColumn Title="Project No"
                                                                Property="@(x => x.ProjectNo)"
                                                                Sortable="true" />
                                                break;

                                            case "CostCenterName":
                                                <PropertyColumn Title="Project Name"
                                                                Property="@(x => x.CostCenterName)"
                                                                Sortable="true" />
                                                break;

                                            case "CustomerName":
                                                <PropertyColumn Title="Customer"
                                                                Property="@(x => x.CustomerName)" />
                                                break;

                                            case "ProjectManager":
                                                <PropertyColumn Title="Project Manager"
                                                                Property="@(x => x.ProjectManager)" />
                                                break;

                                            case "Description":
                                                <PropertyColumn Title="Description"
                                                                Property="@(x => x.Description)" />
                                                break;

                                            // =========================
                                            // BUDGET SUMMARY
                                            // =========================
                                            case "AllocatedBudget":
                                                <PropertyColumn Title="Allocated Budget"
                                                                Property="@(x => x.AllocatedBudget)"
                                                                Format="N2" />
                                                break;

                                            case "TotalBudget":
                                                <PropertyColumn Title="Total Budget"
                                                                Property="@(x => x.TotalBudget)"
                                                                Format="N2" />
                                                break;

                                            case "AvailableBudget":
                                                <PropertyColumn Title="Available Budget"
                                                                Property="@(x => x.AvailableBudget)"
                                                                Format="N2" />
                                                break;

                                            // =========================
                                            // STATUS
                                            // =========================
                                            case "ProjectStatus":
                                                <PropertyColumn Title="Status"
                                                                Property="@(x => x.ProjectStatus)" />
                                                break;

                                            case "IsClosed":
                                                <TemplateColumn Title="Closed" Context="x">
                                                    <span class="badge @(x.IsClosed ? "bg-danger" : "bg-success")">
                                                        @(x.IsClosed ? "Yes" : "Open")
                                                    </span>
                                                </TemplateColumn>
                                                break;

                                            case "IsDispatch":
                                                <TemplateColumn Title="Dispatch" Context="x">
                                                    <span class="badge @(x.IsDispatch ? "bg-primary" : "bg-secondary")">
                                                        @(x.IsDispatch ? "Yes" : "No")
                                                    </span>
                                                </TemplateColumn>
                                                break;

                                            case "AssToEnq":
                                                <PropertyColumn Title="Assign To Enquiry"
                                                                Property="@(x => x.AssToEnq)" />
                                                break;

                                            case "AssToQuote":
                                                <PropertyColumn Title="Assign To Quote"
                                                                Property="@(x => x.AssToQuote)" />
                                                break;

                                            case "AssToMfgPO":
                                                <PropertyColumn Title="Assign To Mfg PO"
                                                                Property="@(x => x.AssToMfgPO)" />
                                                break;

                                            // =========================
                                            // DATES
                                            // =========================
                                            case "StartDate":
                                                <PropertyColumn Title="Start Date"
                                                                Property="@(x => x.StartDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "EndDate":
                                                <PropertyColumn Title="End Date"
                                                                Property="@(x => x.EndDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            // =========================
                                            // AUDIT
                                            // =========================
                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By"
                                                                Property="@(x => x.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date"
                                                                Property="@(x => x.CreatedDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By"
                                                                Property="@(x => x.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date"
                                                                Property="@(x => x.ModifiedDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;
                                        }

                                    </div>
                                }
                            }

                            <!-- ACTION COLUMN -->
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">

                                    @if (CanEdit)
                                    {
                                        <a href="@($"costCenter/update/{c.Id}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Cost Center">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }

                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete Cost Center"
                                                @onclick="() => HandleDelete(c.Id)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }

                                </div>
                            </TemplateColumn>

                        </QuickGrid>

                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                        <div class="d-flex align-items-center gap-2 justify-content-center">

                            <button class="btn btn-outline-primary" title="First Page" @onclick="FirstPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-skip-backward-fill"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Previous Page" @onclick="PreviousPage" disabled="@(currentPage == 1)">
                                <i class="bi bi-arrow-left-circle"></i>
                            </button>

                            <span class="px-3 fw-semibold">
                                Page @currentPage of @totalPages
                            </span>

                            <button class="btn btn-outline-primary" title="Next Page" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-arrow-right-circle"></i>
                            </button>

                            <button class="btn btn-outline-primary" title="Last Page" @onclick="LastPage" disabled="@(currentPage >= totalPages)">
                                <i class="bi bi-skip-forward-fill"></i>
                            </button>

                        </div>
                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}


@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Cost-Center";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteCostId = 0;
    private string searchText = string.Empty;
    private string selectedStatus = "";

    private List<CostCenterVM> CostCenterVMs = new();

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> CostCenterBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "Accounts Master" },
        new PageHeader.BreadcrumbItem { Text = "Cost Center Master", IsLast = true }
    };

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllCostCenters();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in Cost Center OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    #region === Data Loading ===

    private async Task LoadAllCostCenters()
    {
        try
        {
            var result = await costCenterService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            CostCenterVMs = result.costCenterVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading data in Cost Center List");
            await _JS.ToastrError("Failed to load Machine List.");
        }
    }

    private void AddNewCostCenter()
    {
        _navigation.NavigateTo("/costCenter/create");
    }

    #endregion



    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                // =========================
                // KEYS
                // =========================
                new() { Title = "ID", Field = "Id", IsVisible = false },

                // =========================
                // PROJECT BASIC DETAILS
                // =========================
                new() { Title = "Project Type", Field = "ProjectTypeName", IsVisible = true },
                new() { Title = "Project No", Field = "ProjectNo", IsVisible = true },
                new() { Title = "Project Name", Field = "CostCenterName", IsVisible = true },
                new() { Title = "Customer", Field = "CustomerName", IsVisible = true },
                new() { Title = "Project Manager", Field = "ProjectManager", IsVisible = true },
                new() { Title = "Description", Field = "Description", IsVisible = false },

                // =========================
                // BUDGET SUMMARY
                // =========================
                new() { Title = "Allocated Budget", Field = "AllocatedBudget", IsVisible = true },
                new() { Title = "Total Budget", Field = "TotalBudget", IsVisible = true },
                new() { Title = "Available Budget", Field = "AvailableBudget", IsVisible = true },

                // =========================
                // STATUS
                // =========================
                new() { Title = "Project Status", Field = "ProjectStatus", IsVisible = true },
                new() { Title = "Closed", Field = "IsClosed", IsVisible = true },
                new() { Title = "Dispatch", Field = "IsDispatch", IsVisible = true },
                new() { Title = "Assign To Enquiry", Field = "AssToEnq", IsVisible = false },
                new() { Title = "Assign To Quote", Field = "AssToQuote", IsVisible = false },
                new() { Title = "Assign To Mfg PO", Field = "AssToMfgPO", IsVisible = false },

                // =========================
                // DATES
                // =========================
                new() { Title = "Start Date", Field = "StartDate", IsVisible = true },
                new() { Title = "End Date", Field = "EndDate", IsVisible = true },

                // =========================
                // DEPARTMENT ALLOCATION
                // =========================
                new() { Title = "Mechanical Design", Field = "MechanicalDesign", IsVisible = false },
                new() { Title = "Electrical Design", Field = "ElectricalDesign", IsVisible = false },
                new() { Title = "PLC Offline Program", Field = "PlcofflineProgram", IsVisible = false },
                new() { Title = "Software Design", Field = "SoftwareDesign", IsVisible = false },
                new() { Title = "Mechanical Assembly", Field = "MechanicalAssembly", IsVisible = false },
                new() { Title = "Electrical Wiring", Field = "ElectricalWiring", IsVisible = false },
                new() { Title = "Commission", Field = "Commision", IsVisible = false },
                new() { Title = "PLC Online Program", Field = "PLCOnlineProgram", IsVisible = false },

                // =========================
                // EXPENSE BREAKDOWN
                // =========================
                new() { Title = "Raw Material", Field = "RawMaterial", IsVisible = false },
                new() { Title = "Tooling Cost", Field = "ToolingCost", IsVisible = false },
                new() { Title = "Fabrication", Field = "Fabrication", IsVisible = false },
                new() { Title = "Machining", Field = "Machining", IsVisible = false },
                new() { Title = "Finishing", Field = "Finishing", IsVisible = false },
                new() { Title = "Design Cost", Field = "DesignCost", IsVisible = false },
                new() { Title = "Assembly FAT", Field = "AssemblyFAT", IsVisible = false },
                new() { Title = "Installation", Field = "Installation", IsVisible = false },
                new() { Title = "Documentation", Field = "Documentation", IsVisible = false },
                new() { Title = "Logistics", Field = "Logistics", IsVisible = false },
                new() { Title = "Financial Cost", Field = "FinancialCost", IsVisible = false },
                new() { Title = "Admin OverHead", Field = "AdminOverHead", IsVisible = false },
                new() { Title = "Others", Field = "Others", IsVisible = false },
                new() { Title = "Consumable", Field = "ConsumableAmt", IsVisible = false },
                new() { Title = "Maintenance", Field = "MaintenanceAmt", IsVisible = false },
                new() { Title = "Safety", Field = "SafetyAmt", IsVisible = false },
                new() { Title = "Service Dabaspet", Field = "ServiceDabaspetAmt", IsVisible = false },
                new() { Title = "Service Halol", Field = "ServiceHalolAmt", IsVisible = false },
                new() { Title = "Capex", Field = "CapexAmt", IsVisible = false },

                // =========================
                // AUDIT
                // =========================
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = false },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = false },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };

            if (!Hidden)
            {
                // Columns.AddRange(new[]
                // {
                //     new GridColumn { Title = "Extra Column 1", Field = "Extra1", IsVisible = false },
                //     new GridColumn { Title = "Extra Column 2", Field = "Extra2", IsVisible = false },
                // });
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Cost Center List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Cost Center HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllCostCenters();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Cost Center List");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllCostCenters();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Cost Center List");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllCostCenters();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Cost Center List");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllCostCenters();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Cost Center List");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllCostCenters();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Cost Centers List");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllCostCenters();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Cost Centers List page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int costId)
    {
        try
        {
            var (canDelete, message) = await costCenterService.CanDeleteCostCenterAsync(costId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteCostId = costId;

            ModalTitle = "Are you sure you want to delete this Cost Center";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for CostId: {costId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;
           
            var deleted = await costCenterService.DeleteCostCenterByCostIdAsync(DeleteCostId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Cost Center deleted successfully.");
                await LoadAllCostCenters();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Cost Center could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting CostId: {DeleteCostId}");
            await _JS.ToastrError("Failed to delete Cost Ceneter.");
        }
        finally
        {
            DeleteCostId = 0;
            isProcessing = false;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllCostCenters();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Cost Center List");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion


    #region Job order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

           if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;


            currentPage = 1;
            await LoadAllCostCenters();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in Cost Center List");
            await _JS.ToastrError("Failed to Load Cost Center List filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion 

}
