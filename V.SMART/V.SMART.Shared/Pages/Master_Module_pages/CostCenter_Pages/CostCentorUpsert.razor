                                                               class="form-control"
                                                               step="any"
                                                               placeholder="Brought-Out Mechanical" />
                                                        <label for="BroughtOutMechanical">Brought-Out Mechanical</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.BroughtOutMechanical)" />
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.MechanicalFabricated"
