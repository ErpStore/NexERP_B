                                                        <label for="Fabrication">Fabrication </label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.Fabrication)" />
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.Machining"
                                                               id="Machining"
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.Machining))"
                                                               class="form-control"
                                                               placeholder="Machining" />
                                                        <label for="Machining">Machining</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.Machining)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.Finishing"
                                                               step="any"
                                                               id="Finishing" @oninput="e => OnBudgetChanged(e, nameof(CostCenter.Finishing))"
