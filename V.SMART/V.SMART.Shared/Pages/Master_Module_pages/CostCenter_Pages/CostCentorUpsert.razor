                                                               class="form-control" placeholder="Admin Over Head" />
                                                        <label for="AdminOverHead">Admin Over Head</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.AdminOverHead)" />
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.ConsumableAmt"
                                                               id="ConsumableAmt"
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.ConsumableAmt))"
                                                               class="form-control" placeholder="Consumable Amount" />
                                                        <label for="ConsumableAmt">Consumable Amount</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.ConsumableAmt)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.MaintenanceAmt"
                                                               id="MaintenanceAmt"
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.MaintenanceAmt))"
                                                               class="form-control" placeholder="Maintenance Amount" />
                                                        <label for="MaintenanceAmt">Maintenance Amount</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.MaintenanceAmt)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.SafetyAmt"
                                                               id="SafetyAmt "
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.SafetyAmt))"
                                                               class="form-control" placeholder="Safety Amount " />
                                                        <label for="SafetyAmt ">Safety Amount </label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.SafetyAmt)" />
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.ServiceDabaspetAmt"
                                                               id="ServiceDabaspetAmt"
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.ServiceDabaspetAmt))"
                                                               class="form-control" placeholder="ServiceDabaspet Amount" />
                                                        <label for="ServiceDabaspetAmt">ServiceDabaspet Amount</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.ServiceDabaspetAmt)" />
