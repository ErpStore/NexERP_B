@page "/costCenter/create"
@page "/costCenter/update/{Id:int}"

@inherits BaseUserRightsComponent

@inject CurrentUserService _userService
@inject ILoggingService LoggingService
@inject IUnitOfWork _unitOfWork
@inject NavigationManager _navigationManager
@inject IJSRuntime _js


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{

    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container-fluid px-2 px-md-5 mt-4">
            <div class="card shadow-sm border-1">

                <PageHeader TitleText="@(Id == 0 || Id == null ? "Create Project / Cost Center" : "Update Project / Cost Center")"
                            TitleIcon="@(Id == 0 || Id == null ? "bi bi-plus-circle" : "bi bi-pencil-square")"
                            Breadcrumbs="@projectCostCenterBreadcrumbs" />

                <div class="card-body">
                    <EditForm Model="CostCenter" OnValidSubmit="UpsertCostCenter">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="row g-3">

                            @if (CostCenter != null && CostCenter.Id > 0 && !string.IsNullOrWhiteSpace(CostCenter.ProjectNo))
                            {
                                <CorrespondenceStatus ReferenceType="CostCenter"
                                                      ReferenceId="@CostCenter.Id"
                                                      ReferenceTypeName="@CostCenter.ProjectNo" />
                            }

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select class="form-select" id="ProjectTypeId"
                                            value="@CostCenter.ProjectTypeId"
                                            @onchange="OnProjectTypeChanged">
                                        <option value="">-- Select Type Of Project --</option>
                                        @foreach (var sta in type)
                                        {
                                            <option value="@sta.Id">@sta.TypeOfProject</option>
                                        }
                                    </select>
                                    <label for="ProjectTypeId">Type Of Project</label>
                                </div>
                                <ValidationMessage For="@(() => CostCenter.ProjectTypeId)" />
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <TrimmedInputText @bind-Value="CostCenter.ProjectNo" id="ProjectNo" class="form-control" placeholder="Project No" CssClass="form-control" readonly />
                                    <label for="ProjectNo">Project No</label>
                                </div>
                                <ValidationMessage For="@(() => CostCenter.ProjectNo)" />
                            </div>

                          <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="Customer" name="Customer"
                                        @bind="CostCenter.CustId">
                                    <option value="">--Select Customer--</option>
                                    @foreach (var cust in Customer)
                                    {
                                        <option value="@cust.CustId">@cust.CustName</option>
                                    }
                                </select>
                                <label for="Customer">Customer</label>
                            </div>
                            <ValidationMessage For="@(() => CostCenter.CustId)" />
                        </div>



                            <div class="col-md-6">
                                <div class="form-floating">
                                    <TrimmedInputText @bind-Value="CostCenter.CostCenterName" id="CostCenterName" class="form-control" placeholder="CostCenter Name" CssClass="form-control" maxlength="150" />
                                    <label for="CostCenterName">CostCenter Name</label>
                                </div>
                                <ValidationMessage For="@(() => CostCenter.CostCenterName)" />
                            </div>


                            <!-- Description Field -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <TrimmedInputText @bind-Value="CostCenter.Description"
                                                      id="Description"
                                                      class="form-control"
                                                      placeholder="Description" CssClass="form-control" maxlength="200" />
                                    <label for="Description">Description</label>
                                </div>
                                <ValidationMessage For="@(() => CostCenter.Description)" />
                            </div>
                            <!-- Is closed and Dispatched -->
                            <div class="col-md-6">
                                <div class="d-flex gap-4 align-items-center mt-2">
                                    <div class="form-check checkbox-green ms-2">
                                        <InputCheckbox @bind-Value="CostCenter.IsClosed" id="IsClosed" class="form-check-input" />
                                        <label class="form-check-label text-success ms-2" for="IsClosed">Closed</label>
                                    </div>
                                    <div class="form-check checkbox-orange ms-5">
                                        <InputCheckbox @bind-Value="CostCenter.IsDispatch" id="IsDispatch" class="form-check-input" />
                                        <label class="form-check-label" style="color: darkorange; margin-left: 0.5rem;" for="IsDispatch">Dispatched</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">


                                    <select class="form-select"
                                            value="@SelectedUserId"
                                            @onchange="OnUserIdChanged">
                                        <option value="">--Select Project Manager--</option>
                                        @foreach (var User in User)
                                        {
                                            <option value="@User.UserId">@User.UserName</option>
                                        }
                                    </select>
                                    <label for="User">Project Manager</label>
                                </div>
                                <ValidationMessage For="@(() => CostCenter.ProjectManager)" />
                            </div>

                            <!-- Start Date -->
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <InputDate @bind-Value="CostCenter.StartDate"
                                               id="StartDate"
                                               class="form-control" />
                                    <label for="StartDate">Start Date</label>
                                </div>
                                <ValidationMessage For="@(() => CostCenter.StartDate)" />
                            </div>

                            <!-- End Date -->
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <InputDate @bind-Value="CostCenter.EndDate"
                                               id="EndDate"
                                               class="form-control" />
                                    <label for="EndDate">End Date</label>
                                </div>
                                <ValidationMessage For="@(() => CostCenter.EndDate)" />
                            </div>

                            <!--AllocatedBudget-->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputNumber @bind-Value="CostCenter.AllocatedBudget"
                                                 id="AllocatedBudget"
                                                 class="form-control"
                                                 placeholder="AllocatedBudget" CssClass="form-control" />
                                    <label for="AllocatedBudget">Allocated Budget</label>
                                </div>
                                <ValidationMessage For="@(() => CostCenter.AllocatedBudget)" />
                            </div>
                            <!-- Spent -->
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <InputNumber @bind-Value="SpentAmount" id="spent" class="form-control" readonly />
                                    <label for="spent">Purchase Spent</label>
                                </div>
                            </div>

                            <!-- Balance -->
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <InputNumber @bind-Value="BalanceAmount" id="balance" class="form-control" readonly />
                                    <label for="balance">Balance</label>
                                </div>
                            </div>
                            <div class="ms-0 mt-3">
                                <ul class="nav nav-tabs">
                                    <li class="nav-item">
                                        <a class="nav-link @(activeTab == "budget" ? "active" : (IsNoTabActive ? "tab-contacts" : ""))"
                                           @onclick="@(() => SetTab("budget"))">
                                            <i class="bi bi-cash-stack me-1 text-success"></i> Budget
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(activeTab == "department" ? "active" : (IsNoTabActive ? "tab-consignee" : ""))"
                                           @onclick="@(() => SetTab("department"))">
                                            <i class="bi bi-briefcase me-1 text-primary"></i> Mandays Allocate
                                        </a>
                                    </li>

                                </ul>
                            </div>

                            @if (activeTab == "budget")
                            {
                                <!-- Contacts Table -->
                                <div class="container my-4">
                                    <div class="card shadow border-0">
                                        <div class="bg-secondary text-center py-2 card-header">
                                            <h5 class="text-white">Budget</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.BroughtOutMechanical"
