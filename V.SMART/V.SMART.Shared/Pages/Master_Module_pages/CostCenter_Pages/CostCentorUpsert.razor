                            </div>

                            <div class="col-6 col-md-3">
                                <div class="form-floating">
                                    <input class="form-control" id="CreatedDate" value="@CostCenter.CreatedDate?.ToString("dd/MM/yyyy")" disabled />
                                    <label for="CreatedDate">Created Date</label>
                                </div>
                            </div>

                            <div class="col-6 col-md-3">
                                <div class="form-floating">
                                    <InputText @bind-Value="CostCenter.ModifiedBy" class="form-control" id="ModifiedBy" placeholder="Modified By" CssClass="form-control" disabled />
                                    <label for="ModifiedBy">Modified By</label>
                                </div>
                            </div>

                            <div class="col-6 col-md-3">
                                <div class="form-floating">
                                    <input class="form-control" id="ModifiedDate" value="@CostCenter.ModifiedDate?.ToString("dd/MM/yyyy")" disabled />
                                    <label for="ModifiedDate">Modified Date</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">


                            @if (CanCreate || CanEdit)
                            {
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-primary w-100" disabled="@isProcessing">
                                        <i class="bi bi-floppy2-fill me-1"></i> @(Id == 0 || Id == null ? "Create" : "Update")
                                    </button>
                                </div>
                            }
                            <div class="col-md-3">
                                <SmartBackButton Url="/costCenter" />
                            </div>
                        </div>
                    </EditForm>

                </div>
            </div>

        </div>

    }

}

@code
{
    protected override string ScreenName => "Cost-Center";
    [Parameter]
    public int? Id { get; set; }

    private bool isProcessing = true;
    private CostCenter CostCenter { get; set; } = new CostCenter();
    private List<ProjectTypeMaster> type = new();
    private List<Customer> Customer = new();
    private List<User> User = new();

    private decimal SpentAmount = 0, BalanceAmount = 0;
    private decimal total = 0;
    private int? SelectedUserId { get; set; } = null;

    private string activeTab = "";
    private void SetTab(string tab) => activeTab = tab;
    private bool IsNoTabActive => string.IsNullOrEmpty(activeTab);

    private List<PageHeader.BreadcrumbItem> projectCostCenterBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "Account Master" },
        new PageHeader.BreadcrumbItem { Text = "Cost Center Master", IsLast = true }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync(); // sets CanView, CanCreate, etc.

            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }


            await LoadCostCenter();


            await LoadProjectType();
            await LoadCustomer();

            await Task.CompletedTask;
            isProcessing = false;

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the CostCenter OnInitializedAsync event");
        }
    }

    private async Task OnUserIdChanged(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out int Id))
            {
                SelectedUserId = Id;
                var selectedUser = User.FirstOrDefault(u => u.UserId == Id);
                if (selectedUser != null)
                {
                    CostCenter.ProjectManager = selectedUser.UserName;
                }
            }
            else
            {
                CostCenter.ProjectManager = string.Empty;
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Customer OnStateChanged event");
        }
    }


    private async Task UpsertCostCenter()
    {
        try
        {
            isProcessing = true;

            string Uname = await _userService.GetUsernameAsync();

            if (await costcenterValidation() == true && await CalculateTotalBudget() == true)
            {
                if (CostCenter.Id == 0)
                {
                    CostCenter.CreatedBy = Uname;
                    CostCenter.CreatedDate = DateTime.Now;
                    await _unitOfWork.CostCenters.CreateAsync(CostCenter);
                    await _unitOfWork.SaveAsync();
                    await LoggingService.LogUserAction(UserName: Uname, Machine: _userService.MachineName, IP_Address: _userService.IpAddress, screen: "CostCenter", action: $"CostCenter Created to {CostCenter.CostCenterName}",
                    additionalInfo: $"CostCentername: {CostCenter.CostCenterName}");
                    await _js.ToastrSuccess("CostCenter Created Successfully");
                }
                else
                {



                    CostCenter.ModifiedBy = Uname;
                    CostCenter.ModifiedDate = DateTime.Now;

                    await _unitOfWork.CostCenters.UpdateAsync(CostCenter);
                    await _unitOfWork.SaveAsync();
                    await LoggingService.LogUserAction(UserName: Uname, Machine: _userService.MachineName, IP_Address: _userService.IpAddress, screen: "CostCenter", action: $"CostCenter Modified to {CostCenter.CostCenterName}",
                    additionalInfo: $"CostCentername: {CostCenter.CostCenterName}");
                    await _js.ToastrSuccess("CostCenter Modified Successfully");


                }

                // Discard popup Clear
                await _js.InvokeVoidAsync("NavigationGuard.clear");

                _navigationManager.NavigateTo("/costcenter");
            }
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while saving the Costcenter.");
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Costcenter UpsertCustomer() Method");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task<bool> costcenterValidation()
    {
        try
        {
            bool isValid = true;
            bool isDuplicate = await _unitOfWork.CostCenters.ExistsByNameAsync("CostCenterName", CostCenter.CostCenterName?.Trim(), "Id", CostCenter.Id == 0 ? null : CostCenter.Id);
            if (isDuplicate)
            {
                await _js.ToastrError("CostCenter name already exists.");
                isProcessing = false;
                isValid = false;
            }
            if (CostCenter.CustId == 0)
            {
                await _js.ToastrError("Please select customer name first?.");
                isProcessing = false;
                isValid = false;
            }
            if (string.IsNullOrWhiteSpace(CostCenter.ProjectNo))
            {
                await _js.ToastrError("Please select project no first.");
                isProcessing = false;
                isValid = false;
            }
            var matchedUser = User.FirstOrDefault(s => s.UserId == SelectedUserId);
            if (CostCenter.ProjectManager == "" || matchedUser == null)
            {
                await _js.ToastrError("Please select a valid User.");
                isProcessing = false;
                isValid = false;
            }
            else
            {
                CostCenter.ProjectManager = matchedUser.UserName;
            }


            var matchedCustomer = Customer.FirstOrDefault(s => s.CustId == CostCenter.CustId);
            if (CostCenter.CustId == 0 || matchedCustomer == null)
            {
                await _js.ToastrError("Please select a valid Customer.");
                isProcessing = false;
                isValid = false;
            }

            if (CostCenter.Id > 0)
            {
                var existing = await _unitOfWork.CostCenters.GetAsync(CostCenter.Id);

                bool? isDispatch = existing?.IsDispatch;

                if (CostCenter.IsClosed)
                {
                    if (isDispatch == false)
                    {
                        await _js.ToastrWarning("Please dispatch the project before closing.");
                        isValid = false;
                    }
                }
            }
            CostCenter.IsClosed = CostCenter.IsClosed;
            CostCenter.IsDispatch = CostCenter.IsDispatch;

            return isValid;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Costcenter costcenterValidation() Method");
            return false;
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task OnStateChanged(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out int Id))
            {

                var typeProject = type.FirstOrDefault(s => s.Id == Id);

                if (typeProject != null)
                {
                    CostCenter.ProjectTypeId = typeProject.Id;

                }

            }
