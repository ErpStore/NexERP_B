                                                        <label for="Finishing">Finishing</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.Finishing)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.DesignCost"
                                                               id="DesignCost"
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.DesignCost))"
                                                               class="form-control" placeholder="Design Cost" />
                                                        <label for="DesignCost">Design Cost</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.DesignCost)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.AssemblyFAT"
                                                               id="AssemblyFAT"
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.AssemblyFAT))"
                                                               class="form-control" placeholder="Assembly FAT" />
                                                        <label for="AssemblyFAT">Assembly FAT</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.AssemblyFAT)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.Installation"
                                                               id="Installation"
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.Installation))"
                                                               class="form-control" placeholder="Installation" />
                                                        <label for="Installation">Installation</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.Installation)" />
                                                </div>



                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.Documentation"
                                                               id="Documentation"
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.Documentation))"
                                                               class="form-control" placeholder="Documentation" />
                                                        <label for="Documentation">Documentation</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.Documentation)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.Logistics"
                                                               id="Logistics"
                                                               step="any"
                                                               @oninput="e => OnBudgetChanged(e, nameof(CostCenter.Logistics))"
                                                               class="form-control" placeholder="Logistics" />
                                                        <label for="Logistics">Logistics</label>
                                                    </div>
                                                    <ValidationMessage For="@(() => CostCenter.Logistics)" />
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-floating">
                                                        <input type="number"
                                                               value="@CostCenter.FinancialCost"
                                                               id="FinancialCost"
                                                               step="any"
