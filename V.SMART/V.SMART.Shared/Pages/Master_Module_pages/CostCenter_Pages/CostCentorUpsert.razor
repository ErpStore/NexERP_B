                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <InputNumber @bind-Value="CostCenter.AvailableBudget" id="AvailableBudget" class="form-control" placeholder="Available Budget" readonly />
                                    <label for="AvailableBudget">Available Budget</label>
                                </div>
                                <ValidationMessage For="@(() => CostCenter.AvailableBudget)" />
                            </div>
                        </div>

                        <div class="row g-3 mt-2">
                            <div class="col-6 col-md-3">
                                <div class="form-floating">
                                    <InputText @bind-Value="CostCenter.CreatedBy" class="form-control" id="CreatedBy" placeholder="Created By" CssClass="form-control" disabled />
                                    <label for="CreatedBy">Created By</label>
