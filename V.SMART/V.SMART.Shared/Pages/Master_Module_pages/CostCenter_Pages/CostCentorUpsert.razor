        }
    }
    private async Task LoadCustomer()
    {
        try
        {
            var existing = await _unitOfWork.Customers.GetAllAsync();
            if (existing != null)
            {
                Customer = existing.ToList();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the CostCenter upsert LoadCustomers()");
        }
    }

    public async Task<bool> CalculateTotalBudget()
    {
        try
        {
            bool isValid = true;
            total = (CostCenter.BroughtOutMechanical)
             + (CostCenter.MechanicalFabricated)
             + (CostCenter.CEFieldElement)
             + (CostCenter.CePanelElement)
             + (CostCenter.RawMaterial)
             + (CostCenter.ToolingCost)
             + (CostCenter.Fabrication)
             + (CostCenter.Machining)
             + (CostCenter.Finishing)
             + (CostCenter.DesignCost)
             + (CostCenter.AssemblyFAT)
             + (CostCenter.Installation)
             + (CostCenter.Documentation)
             + (CostCenter.Logistics)
             + (CostCenter.FinancialCost)
             + (CostCenter.AdminOverHead)
             + (CostCenter.ConsumableAmt)
             + (CostCenter.MaintenanceAmt)
             + (CostCenter.SafetyAmt)
             + (CostCenter.ServiceDabaspetAmt)
             + (CostCenter.ServiceHalolAmt)
             + (CostCenter.CapexAmt)
             + (CostCenter.Others);

            CostCenter.TotalBudget = total;

            if (total > CostCenter.AllocatedBudget)
            {
                await _js.ToastrError("Total budget exceeds allocated budget!");
                isProcessing = false;
                isValid = false;
            }
            CostCenter.AvailableBudget = CostCenter.AllocatedBudget - total;
            return isValid;
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the CostCenter upsert CalculateTotalBudget()");
            return false;
        }
    }

    private async Task OnBudgetChanged(ChangeEventArgs e, string propertyName)
    {
        try
        {
            var property = typeof(CostCenter).GetProperty(propertyName);
            if (decimal.TryParse(e.Value?.ToString(), out var newValue))
            {

                if (property != null && property.PropertyType == typeof(decimal))
                {
                    property.SetValue(CostCenter, newValue);
                    await CalculateTotalBudget();
                }

            }
            else if (total > 0)
            {
                property.SetValue(CostCenter, Convert.ChangeType(0, property.PropertyType));
                await CalculateTotalBudget();

            }
            else
            {
                CostCenter.TotalBudget = 0;
                CostCenter.AvailableBudget = 0;
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the CostCenter upsert OnBudgetChanged()");
        }
    }


    private async Task OnProjectTypeChanged(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out int selectedTypeId))
            {
                CostCenter.ProjectTypeId = selectedTypeId;
                CostCenter.ProjectNo = await GenerateNextProjectNo(selectedTypeId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the CostCenter upsert OnProjectTypeChanged()");
        }
    }

    private async Task<string> GenerateNextProjectNo(int projectTypeId)
    {
        var projectType = await _unitOfWork.ProjectTypeMasters.GetAsync(projectTypeId);
        var lastProjectNo = await _unitOfWork.CostCenters.GetLastProjectNoByTypeAsync(projectTypeId);

        if (!string.IsNullOrWhiteSpace(lastProjectNo))
        {
            var parts = lastProjectNo.Split('-');
            int lastIndex = parts.Length - 1;

            if (int.TryParse(parts[lastIndex], out int lastNumber))
            {
                lastNumber += 1;
                parts[lastIndex] = lastNumber.ToString(new string('0', parts[lastIndex].Length));
            }

            return string.Join("-", parts);
        }

        if (projectType != null)
        {
            if (!string.IsNullOrWhiteSpace(projectType.TypeOfCode) && projectType.TypeOfCode.Contains('-'))
            {
                return projectType.TypeOfCode + "" + projectType.StartSeries;
            }
            else if (!string.IsNullOrWhiteSpace(projectType.TypeOfCode))
            {
                return projectType.TypeOfCode + "-" + projectType.StartSeries;
            }
            else
            {
                return projectType.StartSeries;
            }
        }
        else
        {
            await _js.ToastrError("projectType is null in GenerateNextProjectNo");
            return string.Empty;
        }
    }


