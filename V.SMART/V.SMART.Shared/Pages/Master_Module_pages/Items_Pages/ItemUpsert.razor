                return;
            }

            if (isNewItem)
                await _js.ToastrSuccess("Item saved successfully.");
            else
                await _js.ToastrSuccess("Item updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            if(!isModelVisible)
            {
