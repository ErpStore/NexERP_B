    private async Task OnProgramChanged(string? value, ProcessFlowChartVM processFlow)
    {
        processFlow.Program = value;

        // Program is optional
        if (string.IsNullOrWhiteSpace(value))
            return;

        bool isDuplicate = compMaster.ProcessFlowCharts
            .Any(x => x != processFlow &&
                      !string.IsNullOrWhiteSpace(x.Program) &&
                      x.Program.Trim().Equals(value.Trim(), StringComparison.OrdinalIgnoreCase));

        if (isDuplicate)
        {
            _focusProcess = true;
            processFlow.Program = string.Empty;

            await _js.ToastrWarning($"Program No '{value}' already exists.");
            _focusProcess = false;
        }
    }

    private Task<IEnumerable<int>> SearchProcesses(string term, CancellationToken token)
    {
        IEnumerable<int> result;

        if (string.IsNullOrWhiteSpace(term))
        {
            result = _process.Select(x => x.ProcessId);
        }
        else
        {
            result = _process
                .Where(x => x.ProcessName.Contains(term, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.ProcessId);
        }

        return Task.FromResult(result);
    }


    private async Task OnProChanged(int ProcessId, ProcessFlowChartVM processFlowVM)
    {
        try
        {
            if (ProcessId > 0)
            {
                processFlowVM.ProcId = ProcessId;

                // Find the previous record based on same item and previous SlNo
                var previousRec = compMaster.ProcessFlowCharts
                    .Where(x => x.CompItemId == ItemId && x.SlNo < processFlowVM.SlNo)
                    .OrderByDescending(x => x.SlNo)
                    .FirstOrDefault();

                if (previousRec != null)
                {
                    //06072026 processFlowVM.RmWt = previousRec.RmWt;

                    processFlowVM.RmWt = previousRec.CompWt;
                    processFlowVM.CompWt = previousRec.CompWt;

                    processFlowVM.MachId = previousRec.MachId;
                    processFlowVM.MachineName = previousRec.MachineName;

                    processFlowVM.VendorCode = previousRec.VendorCode;
                    processFlowVM.VendorName = previousRec.VendorName;

                    processFlowVM.ScrapEndBit = previousRec.ScrapEndBit;
                    processFlowVM.ScrapMaterialName = previousRec.ScrapMaterialName;

                    processFlowVM.UnitPrice = previousRec.UnitPrice;

                }
                else if (Items != null)
                {

                    processFlowVM.RmWt = compMaster.Weight;
                    processFlowVM.CompWt = compMaster.Weight;
                }
            }
            else
            {
                processFlowVM.ProcId = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logger.LogDeveloperError(ex, "Error in OnProcessChanged");
            await _js.ToastrError("An error occurred while changing the process.");
        }
    }

    private async Task OnCategoryChanged()
    {
        try
        {
            var category = _categories.FirstOrDefault(x => x.CategoryCode == Items.CategoryCode);

            if (category != null && category.CategoryName.Equals("Raw Material", StringComparison.OrdinalIgnoreCase))
            {
                Items.MeasureUnit = "KGS";
                Items.PurchaseUnit = "KGS";
            }
            else
            {
                Items.MeasureUnit = "NOS";
                Items.PurchaseUnit = "NOS";
            }
        }
        catch (Exception ex)
        {
            await _logger.LogDeveloperError(ex, "Error in OnCategoryChanged");
            await _js.ToastrError("An error occurred while changing the category.");
        }
    }
