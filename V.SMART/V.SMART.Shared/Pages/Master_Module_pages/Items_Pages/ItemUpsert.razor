            // Load previous RM process
            var prevComp = await itemService
                .GetProcessFlowChartByCompMasterIdAndRMIdAsync(
                    Items.ItemId,
                    compMaster.PrevProcessFlowRMId.Value);

            if (prevComp == null || prevComp.Count == 0)
            {
                await _js.ToastrError("No previous RM Process found.");
                return;
            }

            foreach (var item in prevComp)
            {
                item.Id = 0;
                item.SubId = 0;
                item.RMId = compMaster.RMId;
                item.CompItemId = Items.ItemId;
                item.IsEditable = true;
            }

            // Assign to ProcessFlowCharts
            compMaster.ProcessFlowCharts = prevComp;

            await _js.ToastrSuccess("Previous RM Process loaded successfully.");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logger.LogDeveloperError(ex, "Error in LoadSelectedCompMaster()");
            await _js.ToastrError("Error loading previous RM Process.");
        }
        finally
        {
            isProcessing = false;
        }
