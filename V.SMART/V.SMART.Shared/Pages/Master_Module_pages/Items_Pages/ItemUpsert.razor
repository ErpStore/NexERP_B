    private async Task ValidateAndSaveRow(ItemSub sub)
    {
        try
        {
            // ---------- VALIDATION ----------
            if (sub.ClassId == 0)
            {
                await _js.ToastrError("Please select a valid Category.");
                return;
            }

            if ((sub.ClassId == 1 && (!sub.CustomerId.HasValue || sub.CustomerId == 0)) ||
                (sub.ClassId == 2 && (!sub.VendorId.HasValue || sub.VendorId == 0)))
            {
                await _js.ToastrError("Please select a valid Customer or Vendor.");
                return;
            }

            if (sub.Rate <= 0)
            {
                await _js.ToastrError("Rate must be greater than zero.");
                return;
            }
            sub.IsEditable = false;

            bool isNew = sub.Id == 0;

            bool isDuplicate = itemSubModel.Any(s =>
                s.Id != sub.Id &&
                s.ClassId == sub.ClassId &&
                ((s.ClassId == 1 && s.CustomerId == sub.CustomerId) ||
                 (s.ClassId == 2 && s.VendorId == sub.VendorId)));

            if(isDuplicate)
            {
                await _js.ToastrError("Duplicate entry for the same Customer/Vendor is not allowed.");
                sub.IsEditable = true;
                return;
            }

            try
            {
                await itemService.UpsertItemRateAssign(sub);
            }
            catch (Exception ex)
            {
                await _logger.LogDeveloperError(ex, "Upsert failed in ValidateAndSaveRow");
                await _js.ToastrError("Failed to save Item Rate Assign.");
                return;
            }

            // ---------- SUCCESS MESSAGE ----------
            if (isNew)
                await _js.ToastrSuccess("Item Rate Assign row saved successfully.");
            else
                await _js.ToastrSuccess("Item Rate Assign row updated successfully.");

            await LoadItemSub();
        }
        catch (Exception ex)
        {
            await _logger.LogDeveloperError(ex, "Error in ValidateAndSaveRow in Item Upsert");
            await _js.ToastrError("An error occurred while saving the row.");
        }
    }

