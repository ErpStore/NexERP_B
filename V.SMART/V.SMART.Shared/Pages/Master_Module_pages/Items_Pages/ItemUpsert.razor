                                                <tr>
                                                    <th style="width: 160px;">Category</th>
                                                    <th style="width: 160px;">Customer/Vendor</th>
                                                    <th style="width: 160px;">Rate</th>
                                                    <th style="width: 80px;">Actions</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var sub in itemSubModel)
                                                {
                                                    <tr>
                                                        <!-- CATEGORY -->
                                                        <td>
                                                            @if (sub.IsEditable)
                                                            {
                                                                <InputSelect class="form-control form-control-sm" @bind-Value="sub.ClassId">
                                                                    <option value="">-- Select Category --</option>
                                                                    <option value="1">Customer</option>
                                                                    <option value="2">Vendor</option>
                                                                </InputSelect>
                                                            }
                                                            else
                                                            {
                                                                <span>@(sub.ClassId == 1 ? "Customer" : sub.ClassId == 2 ? "Vendor" : "")</span>
                                                            }
                                                        </td>

                                                        <!-- CUSTOMER / VENDOR -->
                                                        <td>
                                                            @if (sub.IsEditable)
                                                            {
                                                                <div class="mb-3">

                                                                    @if (sub.ClassId == 1)
                                                                    {
                                                                        <MudAutocomplete T="CustomerVM"
                                                                                    Value="SelectedCustomerVM"
                                                                                    ValueChanged="@(async customer => await OnCustomerChanged(sub, customer))"
                                                                                    ToStringFunc="@(customer => customer?.CustName ?? string.Empty)"
                                                                                    SearchFunc="SearchCustomers"
                                                                                    Dense="true"
                                                                                    Clearable="true"
                                                                                    Placeholder="Search Customer"
                                                                                    Title="Search Atleast 3 Letters in Customer"
                                                                                    Class="w-100 autocomplete-sm"
                                                                                    MaxItems="50" />
                                                                    }
                                                                    else if (sub.ClassId == 2)
                                                                    {
                                                                        <MudAutocomplete T="VendorVM"
                                                                                Value="SelectedVendorVM"
                                                                                ValueChanged="@(async vendor => await OnVendorChanged(sub, vendor))"
                                                                                ToStringFunc="@(vendor => vendor?.VendorName ?? string.Empty)"
                                                                                SearchFunc="SearchVendor"
                                                                                Dense="true"
                                                                                Clearable="true"
                                                                                Placeholder="Search Vendor"
                                                                                Title="Search Atleast 3 Letters in Vendor"
                                                                                Class="w-100 autocomplete-sm"
                                                                                MaxItems="50" />
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span>
                                                                    @(sub.ClassId == 1 
                                                                        ? sub.Customer?.CustName
                                                                        : sub.Vendor?.VendorName)
                                                                </span>
                                                            }
                                                        </td>

                                                        <!-- RATE -->
                                                        <td>
                                                            @if (sub.IsEditable)
                                                            {
                                                                <InputNumber class="form-control form-control-sm" @bind-Value="sub.Rate" />
                                                            }
                                                            else
                                                            {
                                                                <span>@sub.Rate</span>
                                                            }
                                                        </td>

                                                        <!-- ACTION BUTTONS -->
                                                        <td>
                                                            @if (sub.IsEditable)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-success me-1"
                                                                        @onclick="() => ValidateAndSaveRow(sub)">
                                                                    <i class="bi bi-check-lg"></i>
                                                                </button>
