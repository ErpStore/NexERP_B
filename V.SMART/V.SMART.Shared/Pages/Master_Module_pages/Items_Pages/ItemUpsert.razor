                                                            <tr>
                                                                <th style="width: 80px;">Sl No.</th>
                                                                <th style="width: 200px;">Process</th>
                                                                <th style="width: 130px;">RM Weight</th>
                                                                <th style="width: 130px;">Comp. Weight</th>
                                                                <th style="width: 130px;">Scrap Weight</th>
                                                                <th style="width: 170px;">Scrap/EndBit</th>
                                                                <th style="width: 170px;">Machine</th>
                                                                <th style="width: 190px;">Supplier</th>
                                                                <th style="width: 190px;">Process Price</th>
                                                                <th style="width: 130px;">Program No.</th>
                                                                <th style="width: 130px;">Cycle Time</th>
                                                                <th style="width: 130px;">Setting Time</th>
                                                                <th style="width: 80px;">BOM</th>
                                                                <th style="width: 120px;">Inspection</th>
                                                                <th style="width: 120px;">ProcessSkip</th>
                                                                <th style="width: 300px;">Remarks</th>
                                                                <th style="width: 170px;">Use Same Sub-Process</th>
                                                                <th style="width: 100px;">Sub-Process</th>
                                                                <th style="width: 80px;">Actions</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            @foreach (var processFlow in compMaster.ProcessFlowCharts)
                                                            {
                                                                <tr>
                                                                    @* SlNo *@
                                                                    <td>
                                                                        <span>@processFlow.SlNo</span>
                                                                    </td>

                                                                    @* Process *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                        
                                                                            @*  <select class="form-control form-control-sm"
                                                                                    @ref="processSelectRef"
                                                                                    value="@processFlow.ProcId"
                                                                                    @onchange="e => OnProcessChanged(e, processFlow)">
                                                                                <option value="0">-- Select Process --</option>
                                                                                @foreach (var process in _process)
                                                                                {
                                                                                    <option value="@process.ProcessId">@process.ProcessName</option>
                                                                                }
                                                                            </select> *@

                                                                            <MudAutocomplete T="int"
                                                                                             Label="Select Process"
                                                                                             SearchFunc="SearchProcesses"
                                                                                             ToStringFunc="@(id => _process.FirstOrDefault(x => x.ProcessId == id)?.ProcessName ?? string.Empty)"
                                                                                             Value="@(processFlow.ProcId ?? 0)"
                                                                                             ValueChanged="@(async id => await OnProChanged(id, processFlow))"
                                                                                             MinCharacters="0"
                                                                                             MaxItems="100"
                                                                                             Dense="true"
                                                                                             Variant="Variant.Outlined" />

                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@_process.FirstOrDefault(p => p.ProcessId == processFlow.ProcId)?.ProcessName</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.ProcId)" />

                                                                    </td>

                                                                    @* RM Weight *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <InputNumber class="form-control form-control-sm"
                                                                            @bind-Value="processFlow.RmWt" 
                                                                            placeholder="RM Wt." 
                                                                            readonly = "@compMaster.LabWORM"/>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@processFlow.RmWt</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.RmWt)" />

                                                                    </td>

                                                                    @* Comp Weight *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            @* <InputNumber class="form-control form-control-sm"
                                                                            @bind-Value="processFlow.CompWt"
                                                                            placeholder="Comp Wt" 
                                                                            readonly = "@compMaster.LabWORM" /> *@
                                                                            <InputNumber TValue="decimal?"
                                                                                         class="form-control form-control-sm"
                                                                                         Value="processFlow.CompWt"
                                                                                         ValueChanged="@(async (decimal? value) => await OnCompWeightChange(value, processFlow))"
                                                                                         ValueExpression="@(() => processFlow.CompWt)"
                                                                                         placeholder="Comp Wt"
                                                                                         readonly="@compMaster.LabWORM" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@processFlow.CompWt</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.CompWt)" />

                                                                    </td>

                                                                    @* Scrap Weight *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <InputNumber class="form-control form-control-sm" @bind-Value="processFlow.ScrapWt" placeholder="Scrap Wt" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@processFlow.ScrapWt</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.ScrapWt)" />

                                                                    </td>

                                                                    @* Scrap/EndBit *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <InputSelect class="form-control form-control-sm" @bind-Value="processFlow.ScrapEndBit"
                                                                                 placeholder="End Bit">
                                                                                <option value="">-- Select Scrap/EndBit --</option>
                                                                                @foreach (var rm in _rawMaterial)
                                                                                {
                                                                                    <option value="@rm.RMId">@rm.RMName</option>
                                                                                }
                                                                            </InputSelect>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@_rawMaterial.FirstOrDefault(r => r.RMId == processFlow.ScrapEndBit)?.RMName</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.ScrapEndBit)" />
                                                                    </td>

                                                                    @* Machine *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <select class="form-control form-control-sm"
                                                                                    value="@processFlow.MachId"
                                                                                    @onchange="e => OnMachineChanged(e, processFlow)">
                                                                                <option value="">-- Select Machine --</option>
                                                                                @foreach (var machine in Machines)
                                                                                {
                                                                                    <option value="@machine.MachineId">@machine.MachineName</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@Machines.FirstOrDefault(m => m.MachineId == processFlow.MachId)?.MachineName</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.MachId)" />

                                                                    </td>

                                                                    @* Vendor *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <select class="form-control form-control-sm"
                                                                                    value="@processFlow.VendorCode"
                                                                                    @onchange="e => OnVendorChanged(e, processFlow)">
                                                                                <option value="">-- Select Supplier --</option>
                                                                                @foreach (var vendor in _vendors)
                                                                                {
                                                                                    <option value="@vendor.VendorCode">@vendor.VendorName</option>
                                                                                }
                                                                            </select>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@_vendors.FirstOrDefault(v => v.VendorCode == processFlow.VendorCode)?.VendorName</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.VendorCode)" />
                                                                    </td>

                                                                    @* Rate *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <InputNumber class="form-control form-control-sm" @bind-Value="processFlow.UnitPrice" placeholder="Process price" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@processFlow.UnitPrice</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.UnitPrice)" />

                                                                    </td>

                                                                    @* Program No *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                           @*  <InputText class="form-control form-control-sm" @bind-Value="processFlow.Program" placeholder="Program No."/> *@
                                                                            <InputText class="form-control form-control-sm"
                                                                                       Value="@processFlow.Program"
                                                                                       ValueChanged="@(value => OnProgramChanged(value, processFlow))"
                                                                                       ValueExpression="@(() => processFlow.Program)"
                                                                                       placeholder="Program No." />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@processFlow.Program</span>
                                                                        }
                                                                       <ValidationMessage For="@(() => processFlow.Program)" />

                                                                    </td>

                                                                    @* Cycle Time *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <InputText class="form-control form-control-sm"
                                                                                       placeholder="HH:MM or Min"
                                                                                       @bind-Value="processFlow.CycleTimeText" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@processFlow.CycleTime?.ToString(@"hh\:mm")</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.CycleTime)" />

                                                                    </td>

                                                                    @* Setting Time *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <InputText class="form-control form-control-sm"
                                                                                       placeholder="HH:MM or Min"
                                                                                       @bind-Value="processFlow.SettingTimeText" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@processFlow.SettingTime?.ToString(@"hh\:mm")</span>
                                                                        }
                                                                        <ValidationMessage For="@(() => processFlow.SettingTime)" />

                                                                    </td>

                                                                    @* BOM *@
                                                                    <td>
                                                                        <div class="form-check d-flex justify-content-center">
                                                                            <InputCheckbox class="form-check-input border border-3 p-2"
                                                                                            style="transform: scale(1);"
                                                                                            @bind-Value="processFlow.BOM"/>
                                                                        </div>

                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <ValidationMessage For="@(() => processFlow.BOM)" />
                                                                        }
                                                                    </td>

                                                                    @* Inspection *@
                                                                    <td>
                                                                       <div class="form-check d-flex justify-content-center">
                                                                            <InputCheckbox class="form-check-input border border-3 p-2"
                                                                                           style="transform: scale(1);"
                                                                                           @bind-Value="processFlow.Inspection"/>
                                                                        </div>

                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <ValidationMessage For="@(() => processFlow.Inspection)" />
                                                                        }
                                                                    </td>

                                                                    @* Process Skip *@
                                                                    <td>
                                                                        <div class="form-check d-flex justify-content-center">
                                                                            <InputCheckbox class="form-check-input border border-3 p-2"
                                                                                            style="transform: scale(1);"
                                                                                            @bind-Value="processFlow.ProcessSkip" />
                                                                        </div>

                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <ValidationMessage For="@(() => processFlow.ProcessSkip)" />
                                                                        }
                                                                    </td>

                                                                    @* Remarks *@
                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <InputTextArea class="form-control form-control-sm" @bind-Value="processFlow.Remarks"  rows="1"
                                                                            placeholder="Remarks"/>
                                                                            <ValidationMessage For="@(() => processFlow.Remarks)" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@processFlow.Remarks</span>
                                                                        }
                                                                    </td>

                                                                    <td>
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <div class="form-check form-switch d-flex justify-content-center">
                                                                                <InputCheckbox class="form-check-input border border-2 shadow-lg 
                                                                                        focus-ring focus-ring-primary p-2 fs-4 rounded-pill"
                                                                                        @bind-Value="processFlow.UseSameSubProcess"
                                                                                        @bind-Value:event="onchange"
                                                                                        ValueChanged="@(value => OnUseSameSubProcessChanged(processFlow, value))" />
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@(processFlow.UseSameSubProcess ? "Yes" : "No")</span>
                                                                        }
                                                                    </td>

                                                                    <td>@processFlow.SubProcess</td>

                                                                    @* Actions *@
                                                                    <td class="freeze-last-col text-end">
                                                                        @if (processFlow.IsEditable)
                                                                        {
                                                                            <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                                    @onclick="async () => await SaveRow(processFlow)">
                                                                                <i class="bi bi-check-lg"></i>
                                                                            </button>
                                                                            <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                                    @onclick="async () => await CancelEdit(processFlow, compMaster)">
                                                                                <i class="bi bi-x-lg"></i>
                                                                            </button>
                                                                        }
                                                                        else
                                                                        {
                                                                            <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit" 
                                                                                    @onclick="async () => await EditRowAsync(processFlow)">
                                                                                <i class="bi bi-pencil"></i>
                                                                            </button>
                                                                            <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete" 
                                                                                    @onclick="async () => await RemoveRow(processFlow)">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>


                                            <div class="row align-items-center g-2 mb-3">
                                                <!-- Add Row Button -->
                                                <div class="col-12 col-sm-4 col-md-2 d-flex">
                                                    <button type="button"
                                                            class="btn btn-sm btn-dark w-100 d-flex align-items-center justify-content-center"
                                                            @onclick="ProcessFlowAdd"
                                                            disabled="@isProcessing"
                                                            title="Add a new row to the process flow">
                                                        <i class="bi bi-plus-circle me-2"></i>
                                                        Add Row
                                                    </button>
                                                </div>

                                                <!-- Total Rows -->
                                                <div class="col-12 col-sm-4 col-md-5 d-flex justify-content-center align-items-center text-muted small fst-italic">
                                                    <i class="bi bi-table me-1"></i>
                                                    Total Rows: <strong class="ms-1">@compMaster.ProcessFlowCharts.Count</strong>
                                                </div>

                                                <!-- RM + Process Cost Summary -->
                                                <div class="col-12 col-sm-4 col-md-4 d-flex justify-content-end align-items-center">
                                                    <span class="badge bg-secondary p-2 fs-6 d-flex align-items-center">
                                                        <i class="bi bi-currency-rupee me-1"></i>
                                                        Total Cost:
                                                        <strong class="ms-1">@Math.Round(RMCost + ProcessCost, 2)</strong>
                                                    </span>
                                                </div>
                                            </div>

                                               

                                            <!-- ================== Action Buttons Section ================== -->
                                            <div class="card shadow-sm border-0 mb-3">
                                                <div class="card-body py-3">

                                                    <div class="row g-3 align-items-center">

                                                        <div class="row g-3 mt-4">
                                                            @if (CanCreate || CanEdit)
                                                            {
                                                                <!-- Create or Update -->
                                                                <div class="col-12 col-md-6 col-lg-3">
                                                                    <button type="submit" 
                                                                        class="btn btn-primary w-100 d-flex align-items-center justify-content-center" 
                                                                        disabled="@isProcessing">
                                                                        <i class="bi bi-save-fill me-2"></i>
                                                                        @(compMaster.Id == 0 || compMaster.Id == null ? "Create" : "Update")
                                                                    </button>
                                                                </div>
                                                            }

                                                            <!-- Back To List -->
                                                            @if(!isModelVisible)
                                                            {
                                                                <div class="col-12 col-md-6 col-lg-3">
                                                                    <SmartBackButton OnNavigate="OnProcessBackClick" />
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </EditForm>
                                    </div>
                                }
                            </div>
                        </div> 
                    }


                    @if (activeTab == "itemSubstitution")
                    {
                        <div class="container-fluid my-4">
                            <div class="card shadow border-0">

                                <div class="bg-secondary text-center py-2 card-header">
                                    <h5 class="text-white">Item Substitution Details</h5>
                                </div>

                                <div class="card-body">

                                    <div class="row g-3 mb-2">
                                        <div class="col-12 col-md-6 text-sm-start">

                                            <!-- Label -->
                                            <label class="form-label fw-semibold text-muted mb-1">
                                                Selected Item Code
                                            </label>

                                            <!-- Highlighted Value -->
                                            <div class="form-control fw-bold border-primary text-primary bg-light">
                                                @Items.ItemCode
                                            </div>

                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm align-middle text-center"
                                               style="table-layout: fixed; width: 100%;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 160px;">Customer</th>
                                                    <th style="width: 160px;">Product Name</th>
                                                    <th style="width: 160px;">Description</th>
                                                    <th style="width: 160px;">HSN Code</th>
                                                    <th style="width: 80px;">Actions</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var assign in itemProductAssign)
                                                {
                                                    <tr>

                                                        <!-- CUSTOMER -->
                                                        <td>
                                                            @if (assign.IsEditable)
                                                            {
                                                                <InputSelect class="form-control form-control-sm"
                                                                             @bind-Value="assign.CustId">
                                                                    <option value="">-- Select Customer --</option>

                                                                    @foreach (var cust in customerVMs)
                                                                    {
                                                                        bool used = itemProductAssign.Any(x => x.CustId == cust.CustId && x != assign);

                                                                        <option value="@cust.CustId" disabled="@used">
                                                                            @cust.CustName
                                                                        </option>
                                                                    }
                                                                </InputSelect>
                                                            }
                                                            else
                                                            {
                                                                <span>@customerVMs.FirstOrDefault(c => c.CustId == assign.CustId)?.CustName</span>
                                                            }
                                                        </td>

                                                        <!-- PRODUCT NAME -->
                                                        <td>
                                                            @if (assign.IsEditable)
                                                            {
                                                                <InputText class="form-control form-control-sm"
                                                                           @bind-Value="assign.ProductName" />
                                                            }
                                                            else
                                                            {
                                                                <span>@assign.ProductName</span>
                                                            }
                                                        </td>

                                                        <!-- DESCRIPTION -->
                                                        <td>
                                                            @if (assign.IsEditable)
                                                            {
                                                                <InputText class="form-control form-control-sm"
                                                                           @bind-Value="assign.Description" />
                                                            }
                                                            else
                                                            {
                                                                <span>@assign.Description</span>
                                                            }
                                                        </td>

                                                        <!-- HSN CODE -->
                                                        <td>
                                                            @if (assign.IsEditable)
                                                            {
                                                                <MudAutocomplete T="string"
                                                                                 @bind-Value="assign.HSNCode"
                                                                                 Dense="true"
                                                                                 SearchFunc="SearchHsnCodes"
                                                                                 Placeholder="Select HSN Code"
                                                                                 Clearable="true"
                                                                                 DisableUnderLine="true"
                                                                                 Class="w-100" />
                                                            }
                                                            else
                                                            {
                                                                <span>@assign.HSNCode</span>
                                                            }
                                                        </td>

                                                        <!-- ACTION BUTTONS -->
                                                        <td>
                                                            @if (assign.IsEditable)
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-success me-1"
                                                                        @onclick="() => ValidateAndSaveRow(assign)">
                                                                    <i class="bi bi-check-lg"></i>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-primary me-1"
                                                                        @onclick="() => EditItemSubstitutionRow(assign)">
                                                                    <i class="bi bi-pencil-square"></i>
                                                                </button>
                                                            }

                                                            <button type="button"
                                                                    class="btn btn-sm btn-danger"
                                                                    @onclick="() => DeleteItemSubstitutionRow(assign)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>

                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>

                                    <div class="text-end text-muted small fst-italic">
                                        Total Rows: @itemProductAssign.Count
                                    </div>

                                    <div class="row mt-4">
                                        <div class="col-md-3">
                                            <button class="btn btn-outline-dark w-100"
                                                    @onclick="AddRowAssignProduct">
                                                <i class="bi bi-plus-circle me-2"></i> Add Row
                                            </button>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    }


                    @if (activeTab == "assignTo")
                    {
                        <div class="container-fluid my-4">
                            <div class="card shadow border-0">
                                <div class="bg-secondary text-center py-2 card-header">
                                    <h5 class="text-white">Rate Assign To</h5>
                                </div>

                                <div class="card-body">

                                    <div class="row g-3 mb-2">
                                        <div class="col-12 col-md-6 text-sm-start">

                                            <!-- Label -->
                                            <label class="form-label fw-semibold text-muted mb-1">
                                                Selected Item Code
                                            </label>

                                            <!-- Highlighted Value -->
                                            <div class="form-control fw-bold border-primary text-primary bg-light">
                                                @Items.ItemCode
                                            </div>

                                        </div>
                                    </div>


