    #region CompMaster And ProcessFlowChart Save

    private async Task UpsertCompMaster()
    {
        try
        {
            isProcessing = true;

            if(!compMaster.RMId.HasValue  || compMaster.RMId == 0)
            {
                await _js.ToastrWarning("Raw-Material is Required");
                return;
            }

            if(compMaster.Weight <= 0)
            {
                await _js.ToastrWarning("RM Weight Should Be Greater than Zero");
                return;
            }

            compMaster.ProcessFlowCharts.RemoveAll(x =>
                !x.ProcId.HasValue &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            // Validate each line
            foreach (var line in compMaster.ProcessFlowCharts)
            {

                line.RMId = compMaster.RMId;
                line.CompItemId = compMaster.CompItemId;


                bool isValid = await ValidateRowAsync(line);
                if (!isValid) return;
            }

            if (compMaster.IsDefaultRM)
            {
                await itemService.EnsureSingleDefaultRMAsync(compMaster.CompItemId.Value);
            }

            var duplicatePrograms = compMaster.ProcessFlowCharts
            .Where(x => !string.IsNullOrWhiteSpace(x.Program))
            .GroupBy(x => x.Program.Trim(), StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() > 1)
            .Select(g => g.Key)
            .ToList();

            if (duplicatePrograms.Any())
            {
                await _js.ToastrWarning(
                    $"Duplicate Program Number(s): {string.Join(", ", duplicatePrograms)}");
                return;
            }


            // Save
            var isNew = compMaster.Id == 0;

            try
            {
                await itemService.UpsertProcessFlow(compMaster);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNew)
                await _js.ToastrSuccess("Raw-Material And Process Flow saved successfully.");
            else
                await _js.ToastrSuccess("Raw-Material And Process Flow  updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            await LoadAllMoreDetailsData();
        }
        catch (Exception ex)
        {
            await _logger.LogDeveloperError(ex, "UpsertCompMaster failed.");
            await _js.ToastrError("Error saving Component Master and Process Flow.");
        }
        finally
        {
            isProcessing = false;
        }
    }

