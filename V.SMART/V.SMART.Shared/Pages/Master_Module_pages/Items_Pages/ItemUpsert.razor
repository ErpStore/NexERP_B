    #region Process Flow Operations

    private async Task OnUseSameSubProcessChanged(ProcessFlowChartVM row, bool value)
    {
        try
        {
            row.UseSameSubProcess = value;

            // If ungrouping → give new GroupKey
            if (!value)
            {
                row.GroupKey = Guid.NewGuid().ToString();
            }
            else
            {
                // If grouping → copy previous row group
                var ordered = compMaster.ProcessFlowCharts.OrderBy(x => x.SlNo).ToList();
                int idx = ordered.IndexOf(row);

                if (idx > 0)
                {
                    var prev = ordered[idx - 1];
                    row.GroupKey = prev.GroupKey;
                }
            }

            await RecalculateSubProcess();
        }
        catch (Exception ex)
        {
            await _logger.LogDeveloperError(ex, "Toggle SubProcess Error");
            await _js.ToastrError("Error updating SubProcess grouping.");
        }
    }


    private async Task RecalculateSubProcess()
    {
        try
        {
            var list = compMaster?.ProcessFlowCharts;
            if (list == null || list.Count == 0)
                return;

            var ordered = list.OrderBy(x => x.SlNo).ToList();

            string lastGroupKey = null;
            int subProcessCounter = 0;

            foreach (var row in ordered)
            {
                // If first row OR group changed → new SubProcess ID
                if (row.GroupKey != lastGroupKey)
                {
                    subProcessCounter++;
                    row.UseSameSubProcess = false;
                }
                else
                {
                    // Same group → same SubProcess ID
                    row.UseSameSubProcess = true;
                }

                row.SubProcess = subProcessCounter;
                lastGroupKey = row.GroupKey;
            }
        }
        catch (Exception ex)
        {
            await _logger.LogDeveloperError(ex, "Recalc SubProcess Error");
            await _js.ToastrError("Error recalculating SubProcess.");
        }
    }

    private async Task<bool> ValidateRowAsync(ProcessFlowChartVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ProcId == null || row.ProcId == 0)
                errors.Add("Please select a Process.");

            if (!row.CycleTime.HasValue || row.CycleTime.Value.TotalSeconds <= 0)
                errors.Add("Cycle Time must be greater than 0.");

            if (!row.SettingTime.HasValue || row.SettingTime.Value.TotalSeconds <= 0)
                errors.Add("Setting Time must be greater than 0.");

            if ((row.MachId == null || row.MachId <= 0) &&
                (row.VendorCode == null || row.VendorCode <= 0))
                errors.Add("Please select either Machine or Vendor for this Process.");

            if (errors.Any())
            {
                await _js.ToastrInfo(string.Join("<br>", errors));
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await _logger.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = compMaster.ProcessFlowCharts.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await _logger.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

