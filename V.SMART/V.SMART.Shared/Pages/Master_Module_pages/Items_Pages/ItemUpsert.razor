                                                            <div class="col-md-6 col-12">
                                                                <div class="input-group">
                                                                    <div class="form-floating flex-grow-1">
                                                                        <input type="number"
                                                                               class="form-control form-control-sm"
                                                                               step="0.001"
                                                                               @bind="Items.Thickness"
                                                                               @bind:event="oninput"
                                                                               @bind:after="CalculateWeightAsync"
                                                                               placeholder="Thickness" />
                                                                        <label>Thickness (T)</label>
                                                                    </div>
                                                                    <span class="input-group-text">mm</span>
                                                                </div>
                                                                <ValidationMessage For="@(() => Items.Thickness)" />
                                                            </div>
                                                        }

                                                        <!-- WALL THICKNESS -->
                                                        @if (new[] { "Round Tube", "Square Tube", "U or C Channel", "I or H Channel", "L Angle", "Rectangle Tube" }.Contains(Items.Shape))
