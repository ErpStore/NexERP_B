            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteProcessRow_Click":
                    await DeleteProcessFlow(); ;
                    break;

                case "confirmCompMaster_Click":
                    await DeleteCompMaster(DeleteCompId);
                    break;

                case "confirmDeleteItemSubstitution":
                    await DeleteItemSubstitution();
                    break;

                case "confirmDeleteItemRateAssign":
                    await DeleteItemRateAssign();
                    break;

                case "AddRevision":
                    await AddRevision();
                    break;

                case "CopyItem":
                    await CopyItem();
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await _logger.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
