                                                                    <div class="form-floating flex-grow-1">
                                                                        <input type="number"
                                                                               class="form-control form-control-sm"
                                                                               step="0.001"
                                                                               @bind="Items.Height"
                                                                               @bind:event="oninput"
                                                                               @bind:after="CalculateWeightAsync"
                                                                               placeholder="Height" />
