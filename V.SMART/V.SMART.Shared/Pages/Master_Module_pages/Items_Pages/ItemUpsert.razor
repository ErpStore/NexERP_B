                                                            else
                                                            {
                                                                <button type="button"
                                                                        class="btn btn-sm btn-primary me-1"
                                                                        @onclick="() => EditRow(sub)">
                                                                    <i class="bi bi-pencil-square"></i>
                                                                </button>
                                                            }

                                                            <button type="button"
                                                                    class="btn btn-sm btn-danger"
                                                                    @onclick="() => DeleteItemRateRow(sub)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>

                                                    </tr>
