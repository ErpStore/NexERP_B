                                                                    </div>
                                                                    <span class="input-group-text">mm</span>
                                                                </div>
                                                                <ValidationMessage For="@(() => Items.Height)" />
                                                            </div>
                                                        }

                                                        <!-- CALCULATE BUTTON -->
                                                        <div class="col-12">
                                                            <button type="button" class="btn btn-secondary w-100" @onclick="CalculateWeightAsync">
                                                                <i class="bi bi-calculator"></i> Calculate
                                                            </button>
                                                        </div>
                                                    }

                                                </div>

                                                <div class="row g-3 mt-2">

                                                    <!-- Reorder Level -->
                                                    <div class="col-12 col-md-6">
                                                        <div class="form-floating">
                                                            <InputNumber class="form-control" @bind-Value="Items.ROL" placeholder="Reorder Level" />
                                                            <label>Reorder Level (Minimum Stock Level)</label>
                                                            <ValidationMessage For="@(() => Items.ROL)" />
                                                        </div>
                                                    </div>

                                                    <!-- Maximum Order Level -->
                                                    <div class="col-12 col-md-6">
                                                        <div class="form-floating">
                                                            <InputNumber class="form-control" @bind-Value="Items.MOL" placeholder="Maximum Order Level" />
                                                            <label>Maximum Order Quantity (Max Stock Level)</label>
                                                            <ValidationMessage For="@(() => Items.MOL)" />
                                                        </div>
                                                    </div>

                                                    <!-- Rack No -->
                                                    <div class="col-12 col-md-6">
                                                        <div class="form-floating">
                                                            <InputText class="form-control" @bind-Value="Items.RackNo" placeholder="Rack No" />
                                                            <label>Rack No</label>
                                                            <ValidationMessage For="@(() => Items.RackNo)" />
                                                        </div>
                                                    </div>

                                                    <!-- Bin Location -->
                                                    <div class="col-12 col-md-6">
                                                        <div class="form-floating">
                                                            <InputText class="form-control" @bind-Value="Items.BinLocation" placeholder="Bin Location" />
                                                            <label>Bin Location</label>
                                                            <ValidationMessage For="@(() => Items.BinLocation)" />
                                                        </div>
                                                    </div>


                                                    <!-- Consider As RM -->
                                                    @* <div class="col-12 col-md-6">
                                                        <div class="switch-card shadow-sm p-3">
                                                            <div class="form-check">
                                                                <InputCheckbox class="form-check-input" @bind-Value="Items.ConsiderAsRm" id="ConsiderAsRm" />
                                                                <label class="form-check-label ms-2" for="ConsiderAsRm">
                                                                    Consider As RM
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div> *@

                                                      <!--Total Area-->
                                                    <div class="col-12 col-md-6">
                                                        <div class="input-group">
                                                            <div class="form-floating flex-grow-1">
                                                                <InputNumber @bind-Value="Items.TotalArea"
                                                                             class="form-control rounded-3"
                                                                             id="PartArea"
                                                                             step="any"
                                                                             placeholder="Part Total Area" />
                                                                <label for="Total Area">Total Area</label>
                                                            </div>
                                                            <span class="input-group-text">Sq Inch</span>
                                                        </div>
                                                        <ValidationMessage For="@(() => Items.TotalArea)" />
                                                    </div>



                                                     <div class="col-12 col-md-6">
                                                        <div class="form-floating">
                                                            <InputTextArea class="form-control" @bind-Value="Items.Remarks" placeholder="Remarks" />
                                                            <label>Remarks</label>
                                                            <ValidationMessage For="@(() => Items.Remarks)" />
                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <div class="form-floating">
                                                            <InputNumber class="form-control" @bind-Value="Items.LotSize" placeholder="LotSize" />
                                                            <label>Lot Size</label>

                                                        </div>
                                                    </div>
                                                    <div class="col-12 col-md-6">
                                                        <div class="form-floating">

                                                            <InputNumber class="form-control"
                                                                         @bind-Value="Items.DeliveryDays"
                                                                         placeholder="Delivery Days"
                                                                         min="0"
                                                                         step="1" />

                                                            <label>Delivery Days</label>

                                                            <ValidationMessage For="@(() => Items.DeliveryDays)" />

                                                        </div>
                                                    </div>


                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="row g-3 mt-2" >

                                    <div class="col-xxl-6 col-12">
                                        <div class="card h-100 shadow-sm">

                                            <!-- Header -->
                                            <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                                <span class="fw-bold fs-6">
                                                    <i class="bi bi-person-lines-fill me-2"></i> Assign Customer
                                                </span>
                                            </div>

                                            <div class="card-body">

                                             <MudAutocomplete T="CustomerVM"
                                                    Value="CustomerVMs"
                                                    ValueChanged="OnCustomerSelected"
                                                    ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                    SearchFunc="SearchCustomers"
                                                    Dense="true"
                                                    Variant="Variant.Outlined"
                                                    Placeholder="Search Customer (min 3 letters)"
                                                    Clearable="true"
                                                    Class="w-100" />

                                                <MudChipSet T="CustomerVM" MultiSelection="true" Class="mt-2">
                                                    @foreach (var itemCustomer in Items.SelectedCustomers)
                                                    {
                                                        <MudChip T="CustomerVM"
                                                            OnClose="() => RemoveItemCustomerAssign(itemCustomer)">
                                                            @itemCustomer.CustName
                                                        </MudChip>
                                                    }
                                                </MudChipSet>

                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <!-- Row 4: Audit Fields -->
                                @if(Items.ItemId>0)
                                {
                                    <div class="row g-3">
                                        <div class="col-6 col-md-3">
                                            <div class="form-floating">
                                                <InputText @bind-Value="Items.CreatedBy" class="form-control" id="CreatedBy" placeholder="Created By" CssClass="form-control" disabled />
                                                <label for="CreatedBy">Created By</label>
                                            </div>
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <div class="form-floating">
                                                <input class="form-control" id="CreatedDate" value="@Items.CreatedDate?.ToString("dd/MM/yyyy")" disabled />
                                                <label for="CreatedDate">Created Date</label>
                                            </div>
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <div class="form-floating">
                                                <InputText @bind-Value="Items.ModifiedBy" class="form-control" id="ModifiedBy" placeholder="Modified By" CssClass="form-control" disabled />
                                                <label for="ModifiedBy">Modified By</label>
                                            </div>
                                        </div>

                                        <div class="col-6 col-md-3">
                                            <div class="form-floating">
                                                <input class="form-control" id="ModifiedDate" value="@Items.ModifiedDate?.ToString("dd/MM/yyyy")" disabled />
                                                <label for="ModifiedDate">Modified Date</label>
                                            </div>
                                        </div>
                                    </div>
                                }
                           

                                <!-- Action Buttons Row -->
                                <div class="row g-3 mt-4">

                                    @if (CanCreate || CanEdit)
                                    {
                                        <!-- Create or Update -->
                                        <div class="col-12 col-md-6 col-lg-3">
                                            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center" disabled="@isProcessing">
                                                <i class="bi bi-save-fill me-2"></i>
                                                @(ItemId == 0 || ItemId == null ? "Create" : "Update")
                                            </button>
                                        </div>
                                    }

                                    <!-- Back To List -->
                                    @if (!isModelVisible)
                                    {
                                        <div class="col-12 col-md-6 col-lg-3">
                                            <SmartBackButton Url="@($"/itemList?currentPage={currentPage}")" />
                                        </div>
                                    }
                                


                                    @if (ItemId > 0)
                                    {
                                        <!-- Add Revision -->
                                        <div class="col-12 col-md-6 col-lg-3">
                                            <button type="button" class="btn btn-outline-success w-100 d-flex align-items-center justify-content-center"
                                                    @onclick="ConfirmAddRevision" disabled="@isProcessing">
                                                <i class="bi bi-plus-circle me-2"></i>
                                                Add Revision
                                            </button>
                                        </div>

                                        <!-- Copy Item -->
                                        <div class="col-12 col-md-6 col-lg-3">
                                            <button type="button" class="btn btn-outline-info w-100 d-flex align-items-center justify-content-center"
                                                    @onclick="ConfirmCopy" disabled="@isProcessing">
                                                <i class="bi bi-files me-2"></i>
                                                Copy
                                            </button>
                                        </div>
                                    }

                                </div>


                            }
                        </div>
                    </EditForm>

                    @if (activeTab == "moreDetails")
                    {
                        <div class="container-fluid my-4">
                            <div class="card shadow border-0">
                                <div class="bg-secondary text-center py-2 card-header">
                                    <h5 class="text-white">More Details</h5>
                                </div>

                                @if(CompMasterListCount > 0)
                                {
                                   <div class="card-body">
                                        <!-- Add New Raw Material Button -->
                                        <div class="mb-2 text-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    @onclick="AssignNewRawMaterial">
                                                <i class="bi bi-plus-circle"></i> Assign New Raw Material
                                            </button>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table table-bordered table-sm align-middle text-center"
                                                   style="table-layout: fixed; width: 100%;">
                                                <thead>
                                                    <tr>
                                                        <th style="width: 200px;">Comp ItemCode</th>
                                                        <th style="width: 130px;">Comp ItemName</th>
                                                        <th style="width: 130px;">Raw Material</th>
                                                        <th style="width: 130px;">Raw Material Name</th>
                                                        <th style="width: 170px;">Weight</th>
                                                        <th style="width: 170px;">Other Details</th>
                                                        <th style="width: 190px;">Is Default RM</th>
                                                        <th style="width: 100px;">Actions</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (var vm in CompMasterListVMs)
                                                    {
                                                        <tr>
                                                            <td>@vm.CompItemCode</td>
                                                            <td>@vm.CompItemName</td>
                                                            <td>@vm.RMCode</td>
                                                            <td>@vm.RMName</td>
                                                            <td>@vm.Weight</td>
                                                            <td>@vm.OtherDet</td>
                                                            <td>@vm.IsDefaultRM</td>

                                                            <td>
                                                                <button type="button"
                                                                        class="btn btn-sm btn-outline-info me-1"
                                                                        @onclick="() => EditRM(vm)">
                                                                    <i class="bi bi-pencil-square"></i>
                                                                </button>

                                                                <button type="button"
                                                                        class="btn btn-sm btn-outline-danger"
                                                                        @onclick="() => DeleteRM(vm)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                }
                                else
                                {
                                    <div class="card-body">

                                        <EditForm Model="compMaster" OnValidSubmit="UpsertCompMaster">
                                            <ObjectGraphDataAnnotationsValidator  />
                                            <ValidationSummary />

                                            <div class="row g-3 mb-2">
                                                <div class="col-12 col-md-6 text-sm-start">

                                                    <!-- Label -->
                                                    <label class="form-label fw-semibold text-muted mb-1">
                                                        Selected Item Code
                                                    </label>

                                                    <!-- Highlighted Value -->
                                                    <div class="form-control fw-bold border-primary text-primary bg-light">
                                                        @Items.ItemCode
                                                    </div>

                                                </div>
                                            </div>

                                            <div class="row g-3">

                                                @if (compMaster.LabWORM)
                                                {
                                                    <div class="col-12 col-md-6 text-success text-sm-start">
                                                         <div class="form-floating">
                                                            <input type="text" @bind="compMaster.RMCode"
                                                                            class="form-control"
                                                                            id="OtherDet"
                                                                            placeholder="Raw Matrial" readonly />
                                                            <label for="OtherDet">Raw Material</label>
                                                            <ValidationMessage For="@(() => compMaster.RMId)" />
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="col-12 col-md-6">
                                                        <MudAutocomplete T="ItemVM"
                                                                            Value="compMaster.SelectedRawMaterialVM"
                                                                            ValueChanged="@(async item => await OnItemChanged(compMaster, item))"
                                                                            ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                            SearchFunc="SearchItems"
                                                                            Dense="true"
                                                                            Variant="Variant.Outlined"
                                                                            Placeholder="Search Item Code"
                                                                            Title="Search Atleast 3 Letters in Item-Code"
                                                                            Class="w-100 autocomplete-sm"
                                                                            MaxItems="50" />
                                                        <ValidationMessage For="@(() => compMaster.RMId)" />
                                                    </div>
                                                }

                                                <div class="col-12 col-md-6">
                                                    <div class="border rounded p-3 d-flex align-items-center h-100">
                                                        <div class="form-check form-switch">
                                                            <input type="checkbox"
                                                                    id="LabWORM"
                                                                    class="form-check-input"
                                                                    checked="@compMaster.LabWORM"
                                                                    disabled="@(compMaster.ProcessFlowCharts != null && compMaster.ProcessFlowCharts.Any(x => x.ProcId > 0))"
                                                                    @onchange="OnLabWORMChanged" />
                                                            <label class="form-check-label ms-2" for="LabWORM">Lab RM</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-6 col-md-3">
                                                    <div class="input-group">
                                                        <div class="form-floating flex-grow-1">
                                                            <InputNumber @bind-Value="compMaster.Weight" class="form-control" id="Weight" 
                                                            placeholder="Weight" onkeypress="return isNumericWithDot(event)" 
                                                            readonly = "@compMaster.LabWORM"/>
                                                            <label for="Weight">RM Weight</label>
                                                        </div>
                                                        <span class="input-group-text">@compMaster.MeasureUnit</span>
                                                    </div>
                                                    <ValidationMessage For="@(() => compMaster.Weight)" />
                                                </div>

                                                <div class="col-6 col-md-3">
                                                    <div class="input-group">
                                                        <div class="form-floating flex-grow-1">
                                                            <InputNumber @bind-Value="compMaster.RMCuttingSize" class="form-control" id="RMCuttingSize" 
                                                            placeholder="Weight" onkeypress="return isNumericWithDot(event)" />
                                                            <label for="RMCuttingSize">RM Cutting Size</label>
                                                        </div>
                                                       
                                                    </div>
                                                    <ValidationMessage For="@(() => compMaster.RMCuttingSize)" />
                                                </div>

                                                <div class="col-12 col-md-6">
                                                    <div class="border rounded p-3 d-flex align-items-center h-100">
                                                        <div class="form-check form-switch">
                                                            <InputCheckbox class="form-check-input"
                                                                            id="Grouping"
                                                                            Value="@compMaster.isGroupingEnabled"
                                                                            ValueChanged="OnGroupingChanged"
                                                                            ValueExpression="() => compMaster.isGroupingEnabled" 
                                                                            disabled="@(compMaster.ProcessFlowCharts != null && compMaster.ProcessFlowCharts.Any(x => x.ProcId > 0))"/>
                                                            <label class="form-check-label ms-2" for="Grouping">Grouping</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                @if (compMaster.isGroupingEnabled && Factors.Any())
                                                {
                                                    <div class="col-12 col-md-6">
                                                        <div class="form-floating w-100">
                                                            <select class="form-select"
                                                                    value="@compMaster.selectedFactorId"
                                                                    @onchange="OnFactorChanged">
                                                                <option value="">-- Select Factor --</option>

                                                                @foreach (var f in Factors)
                                                                {
                                                                    <option value="@f.Id">@f.Factors</option>
                                                                }
                                                            </select>
                                                            <label>Select Factor</label>
                                                        </div>
                                                    </div>

                                                    @if (frcNoList?.Any() == true)
                                                    {
                                                        <div class="col-12 col-md-6">
                                                            <div class="form-floating w-100">
                                                                <select class="form-select"
                                                                         value="@compMaster.SelectedGroupingId"
                                                                        @onchange="OnFrcNoChanged">
                                                                    <option value="">-- Select FRC No --</option>

                                                                    @foreach (var frc in frcNoList)
                                                                    {
                                                                        <option value="@frc.ID">@($"{frc.Prefix}{frc.FRCNo}")</option>
                                                                    }
                                                                </select>
                                                                <label>Select FRC No</label>
                                                            </div>
                                                        </div>
                                                    }
                                                }


                                                <div class="col-12 col-md-6">
                                                    <div class="form-floating">
                                                        <InputTextArea @bind-Value="compMaster.OtherDet"
                                                                        class="form-control"
                                                                        id="OtherDet"
                                                                        placeholder="Other Details" />
                                                        <label for="OtherDet">Other Details</label>
                                                        <ValidationMessage For="@(() => compMaster.OtherDet)" />
                                                    </div>
                                                </div>


                                                <div class="col-12 col-md-6">
                                                    <div class="border rounded p-3 d-flex align-items-center h-100">
                                                        <div class="form-check form-switch">
                                                            <input type="checkbox"
                                                                   id="isDefaultRM"
                                                                   class="form-check-input"
                                                                   @bind="compMaster.IsDefaultRM"
                                                                   title="If enabled, this Raw Material will be treated as the Primary (Default) RM in Material Requirement Analysis and Route Card processes." />
            
                                                            <label class="form-check-label ms-2" for="isDefaultRM">
                                                                Primary Raw Material
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>

                                                @if (compMaster.Id == 0 && PreviousProcessAllocatedCount > 0)
                                                {
                                                    <!-- Dropdown -->
                                                    <div class="col-12 col-md-6">
                                                        <div class="form-floating">
                                                            <select class="form-control form-control-sm"
                                                                    id="PrevProcess"
                                                                    @bind="compMaster.PrevProcessFlowRMId">
