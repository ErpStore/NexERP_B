                    compMaster.SelectedRawMaterialVM = itemvm; 
                    vm.RMCode = itemvm.ItemCode;
                    vm.RMName = itemvm.ItemName;
                    vm.MeasureUnit = itemvm.MeasureUnit;

                    await _js.ToastrInfo("Component Raw Material already linked with existing Component Master. Loaded existing details.");
                    return;
                }
                else
                {
                    vm.SelectedRawMaterialVM = itemvm;
                    vm.RMId = itemvm.ItemId;
                    vm.RMCode = itemvm.ItemCode;
                    vm.RMName = itemvm.ItemName;

                    vm.Weight = Items.Weight;
                    vm.CompItemId = Items.ItemId;
                }
            }
            else
            {
                // Reset when user clears the item
                vm.SelectedRawMaterialVM = null;
                vm.RMId = null;
                vm.RMCode = null;
                vm.RMName = null;
                vm.Weight = 0;
