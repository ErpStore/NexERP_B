                                                            <div class="col-md-6 col-12">
                                                                <div class="input-group">
                                                                    <div class="form-floating flex-grow-1">
                                                                        <input type="number"
                                                                               class="form-control form-control-sm"
                                                                               step="0.001"
                                                                               @bind="Items.WallThickness"
                                                                               @bind:event="oninput"
                                                                               @bind:after="CalculateWeightAsync"
                                                                               placeholder="Wall Thickness" />
                                                                        <label>Wall Thickness (WT)</label>
                                                                    </div>
                                                                    <span class="input-group-text">mm</span>
                                                                </div>
                                                                <ValidationMessage For="@(() => Items.WallThickness)" />
                                                            </div>
                                                        }

                                                        <!-- OUTER DIAMETER -->
                                                        @if (new[] { "Round Tube", "Hexagonal Plate", "Round", "Octagonal", "Ring" }.Contains(Items.Shape))
                                                        {
                                                            <div class="col-md-6 col-12">
                                                                <div class="input-group">
                                                                    <div class="form-floating flex-grow-1">
                                                                        <input type="number"
                                                                               class="form-control form-control-sm"
                                                                               step="0.001"
                                                                               @bind="Items.OuterDia"
                                                                               @bind:event="oninput"
                                                                               @bind:after="CalculateWeightAsync"
                                                                               placeholder="Outer Diameter" />
                                                                        <label>Outer Diameter (OD)</label>
                                                                    </div>
                                                                    <span class="input-group-text">mm</span>
                                                                </div>
                                                                <ValidationMessage For="@(() => Items.OuterDia)" />
                                                            </div>
                                                        }

