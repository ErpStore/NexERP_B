        }
    }

    private async Task<bool> ValidateItemAsync()
    {
        try
        {
            // Check Item-Code Exists
            if(Items.ItemId == 0 || Items.ItemId == null)
            {
                bool codeExists = await itemService.CheckItemExistsAsync(Items.ItemCode);

                if (codeExists)
                {
                    await _js.ToastrError("Item-Code already exists.");
                    return false;
                }
            }

            // Get Weight Configuration
            var weightConfig = await itemService.GetWeightConfigAsync();

            if (weightConfig?.Required == true && Items.CategoryCode == 2)
            {
                if (Items.Weight == null || Items.Weight == 0)
                {
                    await _js.ToastrError("Material Weight is required for Component items.");
                    return false;
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await _logger.LogDeveloperError(ex, "Error in ValidateItemAsync in Item Upsert");
            await _js.ToastrError("Validation failed due to unexpected error.");
            return false;
        }
    }

