                                                                               class="form-control form-control-sm"
                                                                               step="0.001"
                                                                               @bind="Items.InnerDia"
                                                                               @bind:event="oninput"
                                                                               @bind:after="CalculateWeightAsync"
                                                                               placeholder="Inner Diameter" />
