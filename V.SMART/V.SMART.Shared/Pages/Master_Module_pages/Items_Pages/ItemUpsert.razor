                                                                    </div>
                                                                    <span class="input-group-text">mm</span>
                                                                </div>
                                                                <ValidationMessage For="@(() => Items.InnerDia)" />
                                                            </div>
                                                        }

                                                        <!-- HEIGHT -->
                                                        @if (Items.Shape == "Rectangle Tube")
                                                        {
                                                            <div class="col-md-6 col-12">
