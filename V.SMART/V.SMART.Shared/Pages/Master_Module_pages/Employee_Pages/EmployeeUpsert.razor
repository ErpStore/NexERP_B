    private async Task HandlePhotoUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            if (file == null || file.Size > 200 * 1024) // 200 KB max
            {
                PhotoError = "Image must be smaller than 200KB.";
                Employee.Img = null;
                return;
            }

            var extension = Path.GetExtension(file.Name).ToLower();
            if (extension != ".jpg" && extension != ".jpeg" && extension != ".png")
            {
                PhotoError = "Only JPG or PNG images are allowed.";
                Employee.Img = null;
                return;
            }

            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 500 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                Employee.Img = ms.ToArray();
                PhotoError = string.Empty;
            }
            catch (Exception ex)
            {
                PhotoError = "Error uploading image: " + ex.Message;
                Employee.Img = null;
            }
        }
        catch (Exception ex) 
        {
            await loggingService.LogDeveloperError(ex, "An Error Occured while handling the  Employee HandlePhotoUpload() Method");
        }
    }

    private async Task HandleSubmit()
    {
        isProcessing = true;

        await using var transaction = await _unitOfWork.BeginTransactionAsync();
        try
        {
              bool isDuplicate = await _unitOfWork.Staffs.ExistsByNameAsync("StaffRefId", Employee.StaffRefId?.Trim(), "StaffID", Employee.StaffID == 0 ? null : Employee.StaffID);

            if (isDuplicate)
            {
                await _js.ToastrError("Employee RefId/ Bio-Metric name already exists.");
                isProcessing = false;
                await transaction.RollbackAsync();
                return;
            }

            EmergencyContacts = EmergencyContacts
                .Where(c => !string.IsNullOrWhiteSpace(c.Name) ||
                            !string.IsNullOrWhiteSpace(c.Relation) ||
                            !string.IsNullOrWhiteSpace(c.Landline) ||
                            !string.IsNullOrWhiteSpace(c.MobileNo))
                .ToList();

            EducationHistory = EducationHistory
                .Where(c => !string.IsNullOrWhiteSpace(c.Degree) ||
                            !string.IsNullOrWhiteSpace(c.Institution) ||
                            !string.IsNullOrWhiteSpace(c.FromYear) ||
                            !string.IsNullOrWhiteSpace(c.ToYear))
                .ToList();

            FamilyMembers = FamilyMembers
                .Where(c => !string.IsNullOrWhiteSpace(c.Name) ||
                            !string.IsNullOrWhiteSpace(c.Relation) ||
                            !string.IsNullOrWhiteSpace(c.Landline) ||
                            !string.IsNullOrWhiteSpace(c.Mobno))
                .ToList();

            bool isCreate = Employee.StaffID == 0;

            if (isCreate)
            {
                // Create new employee
                Employee.CreatedBy = UserName;
                Employee.CreatedDate = DateTime.Now;

                await _unitOfWork.Staffs.CreateAsync(Employee);
                await _unitOfWork.SaveAsync();

                // Add details
                foreach (var emergency in EmergencyContacts)
                {
                    emergency.StaffID = Employee.StaffID;
                    await _unitOfWork.StaffEmergencys.CreateAsync(emergency);
                }

                foreach (var family in FamilyMembers)
                {
                    family.StaffID = Employee.StaffID;
                    await _unitOfWork.StaffFamilyDetails.CreateAsync(family);
                }

                foreach (var edu in EducationHistory)
                {
                    edu.StaffID = Employee.StaffID;
                    await _unitOfWork.StaffEducations.CreateAsync(edu);
                }

                await _unitOfWork.SaveAsync();

                // Logs
                await loggingService.LogUserAction(UserName, _userService.MachineName, _userService.IpAddress,
                    screen: "Employee", action: $"Created Employee: {Employee.StaffName}",
                    additionalInfo: $"StaffID: {Employee.StaffID}");

                if (EmergencyContacts.Any())
                    await loggingService.LogUserAction(UserName, _userService.MachineName, _userService.IpAddress,
                        screen: "Employee Emergency Contacts", action: "Added Emergency Contacts",
                        additionalInfo: $"{EmergencyContacts.Count} records for StaffID: {Employee.StaffID}");

                if (FamilyMembers.Any())
                    await loggingService.LogUserAction(UserName, _userService.MachineName, _userService.IpAddress,
                        screen: "Employee Family Details", action: "Added Family Details",
                        additionalInfo: $"{FamilyMembers.Count} records for StaffID: {Employee.StaffID}");

                if (EducationHistory.Any())
                    await loggingService.LogUserAction(UserName, _userService.MachineName, _userService.IpAddress,
                        screen: "Employee Education History", action: "Added Education History",
                        additionalInfo: $"{EducationHistory.Count} records for StaffID: {Employee.StaffID}");

                await _js.ToastrSuccess("Employee Created Successfully");
            }
            else
            {
                // Update existing employee
                Employee.ModifiedBy = UserName;
                Employee.ModifiedDate = DateTime.Now;
                await _unitOfWork.Staffs.UpdateAsync(Employee);

                // Remove old details
                await _unitOfWork.StaffEmergencys.DeleteByStaffIdAsync(Employee.StaffID);
                await _unitOfWork.StaffFamilyDetails.DeleteByStaffIdAsync(Employee.StaffID);
                await _unitOfWork.StaffEducations.DeleteByStaffIdAsync(Employee.StaffID);
                await _unitOfWork.SaveAsync();

                // Add updated details
                foreach (var emergency in EmergencyContacts)
                {
                    emergency.SlNo = 0;
                    emergency.StaffID = Employee.StaffID;
                    await _unitOfWork.StaffEmergencys.CreateAsync(emergency);
                }

                foreach (var family in FamilyMembers)
                {
                    family.Slno = 0;
                    family.StaffID = Employee.StaffID;
                    await _unitOfWork.StaffFamilyDetails.CreateAsync(family);
                }

                foreach (var edu in EducationHistory)
                {
                    edu.Slno = 0;
                    edu.StaffID = Employee.StaffID;
                    await _unitOfWork.StaffEducations.CreateAsync(edu);
                }

                await _unitOfWork.SaveAsync();

                // Logs
                await loggingService.LogUserAction(UserName, _userService.MachineName, _userService.IpAddress,
                    screen: "Employee", action: $"Updated Employee: {Employee.StaffName}",
                    additionalInfo: $"StaffID: {Employee.StaffID}");

                if (EmergencyContacts.Any())
                    await loggingService.LogUserAction(UserName, _userService.MachineName, _userService.IpAddress,
                        screen: "Employee Emergency Contacts", action: "Updated Emergency Contacts",
                        additionalInfo: $"{EmergencyContacts.Count} records for StaffID: {Employee.StaffID}");

                if (FamilyMembers.Any())
                    await loggingService.LogUserAction(UserName, _userService.MachineName, _userService.IpAddress,
                        screen: "Employee Family Details", action: "Updated Family Details",
                        additionalInfo: $"{FamilyMembers.Count} records for StaffID: {Employee.StaffID}");

                if (EducationHistory.Any())
                    await loggingService.LogUserAction(UserName, _userService.MachineName, _userService.IpAddress,
                        screen: "Employee Education History", action: "Updated Education History",
                        additionalInfo: $"{EducationHistory.Count} records for StaffID: {Employee.StaffID}");

                await _js.ToastrSuccess("Employee Updated Successfully");
            }

            await transaction.CommitAsync();

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/Staff");
        }
        catch (DbUpdateException ex)
        {
            await transaction.RollbackAsync();
            await loggingService.LogDeveloperError(ex, "An error occurred in HandleSubmit() for Employee");
            await _js.ToastrError("Error occurred while saving employee.");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task OnIfscInout(string value)
    {
        try
        {
            if (!string.IsNullOrEmpty(value))
            {
                Employee.IFSC = value.ToUpperInvariant();
                await FetchIfscDetails(Employee.IFSC);
            }
        }
        catch (Exception ex)
        {
            await loggingService.LogDeveloperError(ex, "An Error Occured while handling the  Employee OnIfscInout() Method");
        }
    }

    private async Task FetchIfscDetails(string ifscCode)
    {
        try
        {
            if (string.IsNullOrEmpty(ifscCode) || !IsValidIfscFormat(ifscCode))
            {
                EmptyControl();
                return;
            }

            var response = await Http.GetFromJsonAsync<BankDetailsResponse>($"https://ifsc.razorpay.com/{ifscCode}");
            if (response != null)
            {
                Employee.BankName = response.BANK;
                Employee.BranchName = response.BRANCH;
                Employee.BankAddress = response.ADDRESS;
                Employee.BankState = response.STATE;
                Employee.IFSC = response.IFSC;
            }
            else
            {
                EmptyControl();
            }
        }
        catch (Exception ex)
        {
            await loggingService.LogDeveloperError(ex, "An Error Occured while handling the  Employee FetchIfscDetails() Method");
        }
    }
