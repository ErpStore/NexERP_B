                }
                await _unitOfWork.SaveAsync();
                
                if (DeleteType != "IsInActive"  && !string.IsNullOrWhiteSpace(DeleteType))
                {
                    await _js.ToastrSuccess("Row Removed successfully.");
                }
                PendingDeleteItem = null;
                DeleteType = null;
            }
        }
        catch (Exception ex)
        {
            await loggingService.LogDeveloperError(ex, "An Error Occured while handling the  Employee Row confirmDelete() Method");

        }
