    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                await LoadRightsAsync(); // Must be awaited before other DB operations

                if (!CanView)
                {
                    _navigationManager.NavigateTo("/access-denied");
                    return;
                }

                await LoadEmployee();

                if (CandidateID > 0)
                {
                     await LoadCandidateToStaff(CandidateID.Value);
                }
                DepartmentList = await LoadDepartmentsAsync();
                DesignationList = await LoadDesignationsAsync();
                UserName = await CurrentUserService.GetUsernameAsync();

                isProcessing = false;
                StateHasChanged(); // update UI after data load
            }
        }
        catch (Exception ex)
        {
            await loggingService.LogDeveloperError(ex, "Error in OnAfterRenderAsync()");
        }
    }


    private async Task LoadEmployee()
    {
        try
        {
            if (StaffID.HasValue && StaffID > 0)
            {
                var existing = await _unitOfWork.Staffs.GetAsync(StaffID.Value);
                if (existing != null)
                    Employee = existing;

                FamilyMembers = (await _unitOfWork.StaffFamilyDetails.FindAsync(x => x.StaffID == Employee.StaffID))?.ToList() ?? new();
                EmergencyContacts = (await _unitOfWork.StaffEmergencys.FindAsync(x => x.StaffID == Employee.StaffID))?.ToList() ?? new();
                EducationHistory = (await _unitOfWork.StaffEducations.FindAsync(x => x.StaffID == Employee.StaffID))?.ToList() ?? new();

                var user = await _unitOfWork.Users.GetQueryable().Where(u => u.StaffId == Employee.StaffID).FirstOrDefaultAsync();
                IsStaffUserExists = user != null;
            }
            else
            {
                Employee = new Staff
                {
                    Status = "Active"
                };
            }
        }
        catch (Exception ex)
        {
            await loggingService.LogDeveloperError(ex, "An Error Occured while handling the LoadEmployee() Method");
        }
    }



    private async Task AskToRemoveAsync(object item, string type)
    {
        try
        {
            PendingDeleteItem = item;
            DeleteType = type;
            ModalTitle = "Are you sure you want to Remove?";
            ModalButtonText = "Remove";
            ModalButtonStyle = "btn-danger";
            await _js.InvokeVoidAsync("ShowConfirmationModal");
