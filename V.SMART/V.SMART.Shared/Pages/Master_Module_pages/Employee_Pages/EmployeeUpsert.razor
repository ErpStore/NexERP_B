    private bool IsValidIfscFormat(string ifsc)
    {
        if (string.IsNullOrWhiteSpace(ifsc)) return false;
        var regex = new System.Text.RegularExpressions.Regex("^[A-Za-z]{4}0[A-Za-z0-9]{6}$");
        return regex.IsMatch(ifsc.Trim());
    }

    private async Task<List<string>> LoadDesignationsAsync()
    {
        var staffList = await _unitOfWork.Staffs.GetAllAsync();
        return staffList
            .Where(s => !string.IsNullOrWhiteSpace(s.Designation))
            .Select(s => s.Designation!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private async Task<List<string>> LoadDepartmentsAsync()
    {
        var staffList = await _unitOfWork.Staffs.GetAllAsync();
      
        return  staffList
            .Where(s => !string.IsNullOrWhiteSpace(s.Department))
            .Select(s => s.Department!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(d => d)
            .ToList();
    }

    private async Task LoadCandidateToStaff(int CandidateID)
    {
        try
        {
            var candidate = await _unitOfWork.Candidate.GetAsync(CandidateID);
            if (candidate == null)
                return;
            Employee.StaffName = candidate.CandidateName;
            Employee.PhoneNo = candidate.PhoneNo;
            Employee.PresentAddr = candidate.Address;
            Employee.PermanentAddr = candidate.Address;
            Employee.Designation = candidate.Position;
            Employee.TotExp = candidate.Experience;
            Employee.Gmail = candidate.Gmail;
            Employee.Gender = candidate.Gender;
            Employee.DOB = candidate.DOB;
            Employee.Department = candidate.Department;
            Employee.DOJ = DateTime.Now;
            Employee.Status = "Active";
        }
        catch (Exception)
        {

            throw;
        }

    }
