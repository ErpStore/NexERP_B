    private async Task confirmDelete_Click(bool isConfirmed)
    {
        try

        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (isConfirmed && !string.IsNullOrWhiteSpace(DeleteType))
            {
                switch (DeleteType)
                {
                    case "Education":
                        if (PendingDeleteItem is StaffEducation edu)
                        {
                            await _unitOfWork.StaffEducations.DeleteAsync(edu.Slno);
                            EducationHistory.Remove(edu);

                        }

                        break;

                    case "Family":
                        if (PendingDeleteItem is StaffFamilyDetails family)
                        {
                            await _unitOfWork.StaffFamilyDetails.DeleteAsync(family.Slno);
                            FamilyMembers.Remove(family);
                        }

                        break;

                    case "Emergency":
                        if (PendingDeleteItem is StaffEmergency contact)
                        {
                            await _unitOfWork.StaffEmergencys.DeleteAsync(contact.SlNo);
                            EmergencyContacts.Remove(contact);
                        }

                        break;
                    case "IsInActive":
                        await MarkAsInActive();
