    private async Task MarkAsInActive()
    {
        try
        {
            if (StaffID > 0)
            {
                Employee.Status = Employee.Status == "Active" ? "InActive" : "Active";
                await _unitOfWork.Staffs.UpdateAsync(Employee);

                var userToUpdate = await _unitOfWork.Users.GetQueryable().Where(u => u.StaffId == StaffID).FirstOrDefaultAsync();
                if (userToUpdate != null)
                {
                    var RightsDelete = await _unitOfWork.UserRights.GetQueryable().Where(u =>  u.UserId == userToUpdate.UserId).FirstOrDefaultAsync();
                    if(RightsDelete !=null)
                    {
                        await _unitOfWork.UserRights.DeleteAsync(RightsDelete.Id);
                        await loggingService.LogUserAction(UserName: UserName, 
                        Machine: CurrentUserService.MachineName, IP_Address: CurrentUserService.IpAddress,
                        screen: "UserRights", 
                        action: $"User Rights Deleted successfully. {userToUpdate?.UserName ?? "Unknown"}",
                        additionalInfo: $"User Name:{userToUpdate?.UserName ?? "Unknown"}");
                    }

                    Employee.ModifiedBy = UserName;
                    Employee.ModifiedDate = DateTime.Now;
                    await _unitOfWork.Users.DeleteAsync(userToUpdate.UserId);
                    await loggingService.LogUserAction(UserName: UserName, 
                        Machine: CurrentUserService.MachineName, IP_Address: CurrentUserService.IpAddress,
                        screen: "UserRights", 
                        action: $"User Rights Deleted successfully. {userToUpdate?.UserName ?? "Unknown"}",
                        additionalInfo: $"User Name:{userToUpdate?.UserName ?? "Unknown"}");

                }

                await loggingService.LogUserAction(
                    UserName: UserName,
                    Machine: _userService.MachineName,
                    IP_Address: _userService.IpAddress,
                    screen: "Employee",
                    action: $"Employee Modified to {Employee.StaffName}",
                    additionalInfo: $"EmployeeName: {Employee.StaffName}"
                );

                await _unitOfWork.SaveAsync();
                await _js.ToastrSuccess("Employee status updated successfully.");
                _navigationManager.NavigateTo("/Staff");
            }
        }
        catch (Exception ex)
        {
            await loggingService.LogDeveloperError(ex, "Error in OnAfterRenderAsync()");
        }
    }

