@page "/employee-details/create"
@page "/employee-details/update/{StaffID:int}"
@page "/employee-details/create/candidate/{CandidateID:int}"

@inject HttpClient Http

@inherits BaseUserRightsComponent
@inject CurrentUserService CurrentUserService
@inject ILoggingService loggingService
@inject IUnitOfWork _unitOfWork
@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<BsModal OnModalConfirmation="confirmDelete_Click"
         Title="@ModalTitle"
         ButtonText="@ModalButtonText"
         ButtonBootstrapStyle="@ModalButtonStyle">
</BsModal>
  <style>
            .nav-tabs .nav-link {
            color: #6c757d;
            font-weight: 500;
            border: none;
            border-bottom: 3px solid transparent;
            transition: all 0.3s ease-in-out;
            padding: 10px 20px;
            margin-right: 5px;
            background-color: #f8f9fa;
            border-radius: 8px 8px 0 0;
        }

        .nav-tabs .nav-link:hover {
            color: #007bff;
            background-color: #e2e6ea;
            transform: translateY(-2px);
        }

        .nav-tabs .nav-link.active {
            color: #fff !important;
            background-color: #20c997 !important; /* Teal background */
            border-bottom: 3px solid #138f75 !important; /* Slightly darker teal */
            font-weight: bold;
            transform: scale(1.05);
            box-shadow: 0 4px 8px rgba(32, 201, 151, 0.3);
        }
        .bg-teal {
            background-color: #20c997 !important; /* Elegant teal */
        }
        .bg-indigo {
            background-color: #6610k8 !important; /* Deep purple-indigo */
        }
        .bg-rose {
            background-color: #e83e8c !important; /* Soft rose pink */
        }
        .bg-soft-blue {
            background-color: #e7f1ff !important;  /* Light sky blue */
            color: #004085;                        /* Darker text */
        }

  </style>

    @if (isProcessing)
    {
        <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
    }
    else
    {
        if (!CanView)
        {
            <RedirectToLogin />
            return;
        }
       else
       {
           <div class="container-fluid px-2 px-md-5 mt-4">
                <div class="card shadow-sm border-1">

                    <PageHeader 
                        TitleText="@EmployeeTitle"
                        TitleIcon="@EmployeeIcon"
                        Breadcrumbs="@employeeBreadcrumbs" />

                    <div class="card-body">
                        <EditForm Model="Employee" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <!-- Basic Information -->
                            <div class="row g-4">

                                 @if (Employee != null && Employee.StaffID > 0 && !string.IsNullOrWhiteSpace(Employee.StaffName))
                                {
                                    <CorrespondenceStatus ReferenceType="Employee"
                                                          ReferenceId="@Employee.StaffID"
                                                          ReferenceTypeName="@Employee.StaffName" />
                                }

                                <div class="col-lg-9">
                                    <div class="row g-4">
                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                <InputText id="StaffRefId" @bind-Value="Employee.StaffRefId" class="form-control" placeholder="Employee ID" />
                                                <label for="StaffRefId">Employee ID</label>
                                                <ValidationMessage For="@(() => Employee.StaffRefId)" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                <TrimmedInputText id="StaffName" @bind-Value="Employee.StaffName" CssClass="form-control" placeholder="Full Name" />
                                                <label for="StaffName">Full Name</label>
                                                <ValidationMessage For="@(() => Employee.StaffName)" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                <InputDate id="DOB" @bind-Value="Employee.DOB" class="form-control" />
                                                <label for="DOB">Date of Birth</label>
                                                <ValidationMessage For="@(() => Employee.DOB)" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                <InputSelect id="Gender" @bind-Value="Employee.Gender" class="form-select">
                                                    <option value="">-- Select Gender --</option>
                                                    @foreach (var sex in GenderList)
                                                    {
                                                        <option value="@sex">@sex</option>
                                                    }
                                                </InputSelect>
                                                <label for="Gender">Gender</label>
                                                <ValidationMessage For="@(() => Employee.Gender)" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                <input list="departmentList" class="form-control" id="Department" @bind="Employee.Department"
                                                        placeholder="Type or select department" @onkeydown="HandleDepartmentEnter" />
                                                <label for="Department">Department</label>
                                                <datalist id="departmentList">
                                                    @foreach (var item in DepartmentList)
                                                    {
                                                        <option value="@item" />
                                                    }
                                                </datalist>
                                                <ValidationMessage For="@(() => Employee.Department)" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                <input list="designationList" class="form-control" id="Designation" @bind="Employee.Designation"
                                                        placeholder="Type or select designation" @onkeydown="HandleEnter" />
                                                <label for="Designation">Designation</label>
                                                <datalist id="designationList">
                                                    @foreach (var item in DesignationList)
                                                    {
                                                        <option value="@item" />
                                                    }
                                                </datalist>
                                                <ValidationMessage For="@(() => Employee.Designation)" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                <InputDate id="DOJ" @bind-Value="Employee.DOJ" class="form-control" />
                                                <label for="DOJ">Date of Joining</label>
                                                <ValidationMessage For="@(() => Employee.DOJ)" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                <TrimmedInputText id="Phone" @bind-Value="Employee.PhoneNo" CssClass="form-control" placeholder="Phone"
                                                                maxlength="13" inputmode="tel" onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || (event.charCode == 43 && this.selectionStart == 0)" />
                                                <label for="Phone">Phone</label>
                                                <ValidationMessage For="@(()=>Employee.PhoneNo)" />
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-floating">
                                                <TrimmedInputText id="Gmail" @bind-Value="Employee.Gmail" CssClass="form-control" placeholder="Email" @onblur="ValidateGmail" />
                                                <label for="Gmail">Email</label>
                                                <ValidationMessage For="@(() => Employee.Gmail)" />
                                                @if (!string.IsNullOrEmpty(EmailError))
                                                {
                                                    <div class="text-danger mt-1">@EmailError</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-3 d-flex flex-column align-items-center text-center mt-5">

                                    @if (Employee.Img != null)
                                    {
                                        <!-- Display Uploaded Photo -->
                                        <div class="rounded-circle bg-light shadow-sm border"
                                             style="width: 120px; height: 120px; overflow: hidden;">
                                            <img src="data:image/png;base64,@Convert.ToBase64String(Employee.Img)"
                                                 alt="Employee Photo"
                                                 class="w-100 h-100"
                                                 style="object-fit: cover;" />
                                        </div>

                                        <!-- Delete Photo Button -->
                                        <div class="mt-3">
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    title="Delete uploaded photo"
                                                    @onclick="DeletePhoto">
                                                <i class="bi bi-trash"></i> Delete Photo
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Upload Photo Placeholder -->
                                        <label for="photoInput"
                                               class="rounded-circle bg-light border d-flex flex-column justify-content-center align-items-center shadow-sm"
                                               style="width: 120px; height: 120px; cursor: pointer;"
                                               title="Click to upload photo">
                                            <i class="bi bi-person-circle fs-1 text-secondary"></i>
                                            <small class="text-muted">Upload</small>
                                        </label>

                                        <!-- Hidden File Input -->
                                        <InputFile id="photoInput"
                                                   class="d-none"
                                                   accept="image/jpeg,image/png"
                                                   OnChange="HandlePhotoUpload" />

                                        <!-- File Info -->
                                        <div class="text-muted small mt-2">Max size: 200 KB (JPG/PNG)</div>

                                        <!-- Error Message -->
                                        @if (!string.IsNullOrEmpty(PhotoError))
                                        {
                                            <div class="text-danger small mt-1">@PhotoError</div>
                                        }
                                    }
                                </div>
                            </div>


                            <div class="row g-4 mt-3">
                                <div class="col-md-12 mt-3 mb-0">
                                    <div class="border rounded p-3 bg-light shadow-sm d-flex align-items-center">
                                        <div class="form-check d-flex align-items-center m-0">
                                            <InputCheckbox id="SameAsPresentAddress"
                                                            class="form-check-input me-3"
                                                            @bind-Value="SameAsPresentAddress" />
                                            <label for="SameAsPresentAddress"
                                                    class="form-check-label fw-bold text-dark mb-0 fs-9">
                                                Same as Present Address
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                    <div class="col-md-6">

                                        <div class="form-floating">
                                            <InputTextArea id="PresentAddress"
                                                            class="form-control"
                                                            placeholder="Present Address"
                                                            @bind-Value="Employee.PresentAddr"
                                                            @oninput="OnPresentAddressChanged" CssClass="form-control"/>
                                            <label for="PresentAddress">Present Address</label>
                                                <ValidationMessage For="@(() =>Employee.PresentAddr)"/>
                                        </div>
                                      
                                    </div>
                                            
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <InputTextArea id="PermanentAddress"
                                                            class="form-control"
                                                            placeholder="Permanent Address"
                                                            @bind-Value="Employee.PermanentAddr"
                                                            disabled="@SameAsPresentAddress" CssClass="form-control" />
                                            <label for="PermanentAddress">Permanent Address</label>
                                        </div>
                                    </div>

                                    <!-- City -->
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <TrimmedInputText id="City" @bind-Value="Employee.City" class="form-control" placeholder="City" CssClass="form-control"/>
                                            <label for="City">City</label>
                                                <ValidationMessage For="@(() =>Employee.City)"/>
                                        </div>
                                    </div>
                                    <!-- 🧩 Relation Dropdown -->
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputSelect id="Relation" @bind-Value="Employee.RelationType" class="form-select">
                                                <option value="">-- Select Relation Type --</option>
                                                @foreach (var rl in Relations)
                                                {
                                                    <option value="@rl">@rl</option>
                                                }
                                            </InputSelect>
                                            <label for="Relation">Relation Type</label>
                                        </div>
                                    </div>

                                    <!-- 🧍 Name Field for Selected Relation -->
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputText id="FatherOrHusband"
                                                                @bind-Value="Employee.FatherHusbName" 
                                                                class="form-control"  CssClass="form-control" disabled="@string.IsNullOrWhiteSpace(Employee.RelationType)" />
                                                                     
                                            <label for="FatherOrHusband">@GetRelationLabel()</label>
                                            </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputNumber id="Height" @bind-Value="Employee.Height" class="form-control" Placeholder="Height"/>
                                            <label for="Height">Height</label>
                                            <ValidationMessage For="@(()=>Employee.Height)"/>
                                            </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputSelect id="BloodGroup" @bind-Value="Employee.BloodGroup" class="form-select">
                                                <option value="">-- Select Blood Group --</option>
                                                @foreach (var bg in BloodGroups)
                                                {
                                                    <option value="@bg">@bg</option>
                                                }
                                            </InputSelect>
                                            <label for="BloodGroup">Blood Group</label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputSelect id="Criteria" @bind-Value="Employee.Criteria" class="form-select">
                                                <option value="">-- Criteria --</option>
                                                @foreach (var c in CriteriaList)
                                                {
                                                    <option value="@c">@c</option>
                                                }
                                            </InputSelect>
                                            <label for="Criteria">Criteria</label>

                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputSelect id="Reporting" @bind-Value="Employee.Reporting" class="form-select">
                                                <option value="">-- Reporting --</option>
                                                @foreach (var report in ReportingList)
                                                {
                                                    <option value="@report">@report</option>
                                                }
                                            </InputSelect>
                                            <label for="Reporting">Reporting</label>
                                                <ValidationMessage For="@(() =>Employee.Reporting)"/>
                                        </div>
                                    </div>
                                    <!-- Languages -->
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <TrimmedInputText id="LanguagesToRead" @bind-Value="Employee.LngRead" class="form-control" placeholder="Languages to Read" CssClass="form-control" />
                                            <label for="LanguagesToRead">Languages to Read</label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <TrimmedInputText id="LanguagesToWrite" @bind-Value="Employee.LngWrite" class="form-control" mul placeholder="Languages to Write" CssClass="form-control"/>
                                            <label for="LanguagesToWrite">Languages to Write</label>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <TrimmedInputText id="LanguagesToSpeak" @bind-Value="Employee.LngSpeak" class="form-control" placeholder="Languages to Speak" CssClass="form-control"/>
                                            <label for="LanguagesToSpeak">Languages to Speak</label>
                                        </div>
                                    </div>

                                <!-- Experience -->
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputNumber id="TotalExperience" @bind-Value="Employee.TotExp" class="form-control" placeholder="Total Experience" CssClass="form-control"/>
                                            <label for="TotalExperience">Total Experience </label>
                                            <ValidationMessage For="@(()=>Employee.TotExp)" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <InputNumber id="RelevantExperience" @bind-Value="Employee.RelExp" class="form-control" placeholder="Relevant Experience" CssClass="form-control"/>
                                            <label for="RelevantExperience">Relevant Experience</label>
                                            <ValidationMessage For="@(()=>Employee.RelExp)"/>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                                <InputSelect id="Status" @bind-Value="Employee.Status" class="form-select">
                                                <option value="">-- Select Status --</option>
                                                @foreach (var status in StatusList)
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            </InputSelect>
                                            <label for="Status">Status</label>
                                            <ValidationMessage For="@(() =>Employee.Status)" />
                                            </div>
                                        </div>
                                          
                                    <div class="col-md-4 form-floating">
                                        <TrimmedInputText id="MinWorkingTime" class="form-control"
                                                @bind-value="Employee.WorkingHrs"
                                                placeholder="Min Working Time" CssClass="form-control"/>
                                        <label for="MinWorkingTime">Min Working Hours (HH:mm)</label>
                                        <ValidationMessage For="@(()=>Employee.WorkingHrs)"/>
                                    </div>

                                    <div class="col-md-4 form-floating">
                                        <TrimmedInputText id="GraceHours" class="form-control"
                                                @bind-value="Employee.GraceHrs"
                                                placeholder="Grace Hours" CssClass="form-control"/>
                                        <label for="GraceHours">Grace Hours (HH:mm)</label>
                                        <ValidationMessage For="@(()=>Employee.GraceHrs)"/>
                                    </div>

                                       

                                    <div class="col-md-4 form-floating">
                                        <InputTextArea id="OtherRemarks" class="form-control text-danger"
                                                            @bind-Value="Employee.OtherDet"
                                                            placeholder="Other Details" CssClass="form-control" />
                                        <label for="OtherRemarks">Other Details</label>

                                    </div>

                                    <div class="col-md-4 d-flex align-items-center mt-4">
                                        <InputCheckbox @bind-Value="Employee.OtCount" class="form-check-input me-2 text-info" id="OtRequired" />
                                        <label for="OtRequired" class="form-check-label">OT Hours Required</label>

                                    </div>

                                    @if (!IsStaffUserExists)
                                    {
                                        <div class="col-md-4 d-flex align-items-center mt-4">
                                            <InputCheckbox @bind-Value="Employee.IsUser" class="form-check-input me-2" id="IsUser" />
                                            <label for="IsUser" class="form-check-label">Employee As User</label>
                                        </div>
                                    }

                                     <div class="col-md-4 form-floating">
                                         <TrimmedInputText id="DepartmentCode" class="form-control text-danger"
                                                             @bind-Value="Employee.DepartmentCode"
                                                             placeholder="Department Code" CssClass="form-control" />
                                             <label for="DepartmentCode">Department Code </label>
                                     </div>
                                    

                                </div>

                            <div class="row g-3 mt-2 ms-0">
                                <ul class="nav nav-tabs">
                                    <li class="nav-item">
                                        <a class="nav-link @(activeTab == "Legal Identifiers" ? "active" : "")"
                                            @onclick="@(() => SetTab("Legal Identifiers"))">
                                            Legal Identifiers
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(activeTab == "Education" ? "active" : "")"
                                            @onclick="@(() => SetTab("Education"))">
                                            Education
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(activeTab == "Accounting" ? "active" : "")"
                                            @onclick="@(() => SetTab("Accounting"))">
                                            Accounting Details
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(activeTab == "Family" ? "active" : "")"
                                            @onclick="@(() => SetTab("Family"))">
                                            Family Contacts
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link @(activeTab == "Emergency" ? "active" : "")"
                                            @onclick="@(() => SetTab("Emergency"))">
                                            Emergency Contacts
                                        </a>
                                    </li>
                                </ul>
                            </div>

                                   
                                <div class="tab-content mt-3">
                                    <!-- 📜 Legal Identifiers -->
                                        @if (activeTab == "Legal Identifiers")
                                        {   
                                            <div class="card mb-3">
                                                <div class="card-header bg-rose text-white d-flex align-items-center gap-2">
                                                <i class="bi bi-person-badge fs-5"></i>
                                                <h5 class="mb-0 text-white">Legal Identifiers</h5>
                                            </div>

                                             
                                                <div class="card-body">
                                                    
                                                    <div class="row g-3">

                                                            <div class="col-md-4 form-floating">
                                                            <TrimmedInputText id="EmployeeAadhaar" @bind-Value="Employee.Aadhaar" class="form-control" placeholder="Aadhaar" CssClass="form-control" maxlength="12" inputmode="numeric"onkeypress="return (event.charCode >=48 && event.charCode<=57)"/>
                                                            <label for="EmployeeAadhaar">Aadhaar Number</label>
                                                            <ValidationMessage For="@(()=>Employee.Aadhaar)"/>
                                                            </div>

                                                        <div class="col-md-4 form-floating">
                                                            <TrimmedInputText id="EmployeePan" @bind-Value="Employee.PAN" class="form-control" placeholder="PAN" CssClass="form-control"/>
                                                            <label for="EmployeePan">PAN Number</label>
                                                            <ValidationMessage For="@(()=>Employee.PAN)"/>
                                                        </div>

                                                        <div class="col-md-4 form-floating">
                                                            <TrimmedInputText id="EmployeeUAN" @bind-Value="Employee.UANNo" class="form-control" placeholder="UAN" CssClass="form-control" />
                                                            <label for="EmployeeUAN">UAN Number</label>
                                                            <ValidationMessage For="@(()=>Employee.UANNo)"/>

                                                        </div>

                                                        <div class="col-md-4 form-floating">
                                                            <TrimmedInputText id="EmployeePF" @bind-Value="Employee.PFCodeNo" class="form-control" placeholder="PF Code" CssClass="form-control"/>
                                                            <label for="EmployeePF">PF Code</label>
                                                                <ValidationMessage For="@(()=>Employee.PFCodeNo)"/>
                                                        </div>

                                                        <div class="col-md-4 form-floating">
                                                            <TrimmedInputText id="EmployeeESI" @bind-Value="Employee.ESICodeNo" class="form-control" placeholder="ESI Code" CssClass="form-control"/>
                                                            <label for="EmployeeESI">ESI Code</label>
                                                            <ValidationMessage For="@(()=>Employee.ESICodeNo)"/>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                               
                                        }
                                        else if(activeTab == "Education")
                                        {
                                            <!-- 🎓 Education Details Card -->
                                                <div class="card mb-3">
                                                    <div class="card-header bg-info text-white d-flex align-items-center gap-2">
                                                        <i class="bi bi-mortarboard fs-6"> </i>
                                                        <h5 class="mb-0 text-white">Education Details </h5>
                                                    </div>

                                                    <div class="card-body">
                                                        @foreach (var edu in EducationHistory.ToList())
                                                        {
                                                            <div class="row g-2 mb-3">
                                                              
                                                                    <div class="col-md-4 form-floating">
                                                                        <TrimmedInputText id="School" class="form-control"
                                                                                            @bind-Value="edu.Institution"
                                                                                            placeholder="School / College Name" CssClass="form-control" />
                                                                        <label for="School">School / College Name</label>

                                                                    </div>

                                                                    <div class="col-md-3 form-floating">
                                                                        <TrimmedInputText Id="Qualification" class="form-control"
                                                                        @bind-Value="edu.Degree" CssClass="form-control" Placeholder="Qualification (e.g., SSLC, PUC, B.Sc, ITI)"/>
                                                                        <ValidationMessage For="@(()=>edu.Degree)"/>
                                                                        <label for="Qualification">Qualification (e.g., SSLC, PUC, B.Sc, ITI)</label>
                                                                    </div>


                                                                <div class="col-md-2  form-floating">
                                                                        <TrimmedInputText id="From" class="form-control"
                                                                                        placeholder="From Year"
                                                                                        @bind-Value="edu.FromYear"
                                                                                        CssClass="form-control" />
                                                                    <ValidationMessage For="@(() => edu.FromYear)" />
                                                                            <label for="From">From Year</label>
                                                                </div>

                                                                <div class="col-md-2 form-floating">
                                                                    <TrimmedInputText id="To" class="form-control"
                                                                                        placeholder="To Year"
                                                                                        @bind-Value="edu.ToYear"
                                                                                        CssClass="form-control" />
                                                                    <ValidationMessage For="@(() => edu.ToYear)" />
                                                                            <label for="To" >To Year</label>
                                                                </div>

                                                                <div class="col-md-1 d-flex align-items-center form-floating">
                                                                    <button type="button" class="btn btn-danger btn-sm w-100"
                                                                            @onclick="() => AskToRemoveAsync(edu, EducationType)"
                                                                            title="Delete this Education History">
                                                                        <i class="bi bi-trash3"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        }

                                                        <button type="button" class="btn btn-sm btn-outline-success" @onclick="AddEducation">
                                                            <i class="bi bi-plus-circle"></i> Add Education
                                                        </button>
                                                    </div>
                                                </div>

                                        }
                                    else if(activeTab == "Accounting")
                                    {
                                        <!-- 💳 Accounting Details Card -->
                                                <div class="card mb-3">
                                                    <div class="card-header bg-rose text-white d-flex align-items-center gap-2">
                                                        <i class="bi bi-bank fs-6"></i>
                                                        <h5 class="mb-0 text-white">Accounting Details</h5>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="row g-3">
                                                            <div class="col-md-6 form-floating">
                                                                <TrimmedInputText id="AccountNo" class="form-control"
                                                                                    @bind-Value="Employee.AccNo"
                                                                                    placeholder="Account Number"
                                                                                    CssClass="form-control"
                                                                                    maxlength="20"
                                                                                    inputmode="numeric"
                                                                                    onkeypress="return (event.charCode >= 48 && event.charCode <=57)" />
                                                                <label for="AccountNo">Account Number</label>
