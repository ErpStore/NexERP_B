@page "/employeeLeaveBalance"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IMasterServices.IHRMasterservice
@using V.SMART.Shared.ViewModels.MasterViewModel.HumanResourceViewModel


@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@inject IEmployeeLeavebalanceService empLeaveBalService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Employee Leave Balance List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@leavebalBreadcrumbs" />

            <div class="card-body p-4">

                 <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                    </div>

                    @if (CanCreate)
                    {
                       <div class="col-6 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewLeavebal">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </button>
                       </div>
                    }

                </div>

                    @if (EmployeeLeaveBalanceVMs.Any())
                    {
                        <div class="table-responsive">

                            <QuickGrid Items="EmployeeLeaveBalanceVMs.AsQueryable()"
                                       Class="quickgrid table table-bordered text-wrap">

                                @if (Columns.Any(c => c.IsVisible))
                                {
                                    @foreach (var col in Columns.Where(c => c.IsVisible))
                                    {
                                        <div>

                                            @switch (col.Field)
                                            {
                                                case "LeaveBalanceID":
                                                    <PropertyColumn Title="Leave Balance ID" Property="@(x => x.LeaveBalanceID)" />
                                                    break;

                                                case "EmployeeID":
                                                    <PropertyColumn Title="Employee ID" Property="@(x => x.EmployeeID)" />
                                                    break;

                                                case "EmployeeName":
                                                    <PropertyColumn Title="Employee Name" Property="@(x => x.EmployeeName)" Sortable="true" />
                                                    break;

                                                case "LeaveTypeId":
                                                    <PropertyColumn Title="Leave Type ID" Property="@(x => x.LeaveTypeId)" />
                                                    break;

                                                case "LeaveTypeName":
                                                    <PropertyColumn Title="Leave Type" Property="@(x => x.LeaveTypeName)" />
                                                    break;

                                                case "Year":
                                                    <PropertyColumn Title="Year" Property="@(x => x.Year)" Sortable="true" />
                                                    break;

                                                case "TotalAllocatedLeave":
                                                    <PropertyColumn Title="Total Allocated Leave"
                                                                    Property="@(x => x.TotalAllocatedLeave)"
                                                                    Format="N2" />
                                                    break;

                                                case "LeavesTaken":
                                                    <PropertyColumn Title="Leaves Taken"
                                                                    Property="@(x => x.LeavesTaken)"
                                                                    Format="N2" />
                                                    break;

                                                case "Balance":
                                                    <PropertyColumn Title="Balance"
                                                                    Property="@(x => x.Balance)"
                                                                    Format="N2" />
                                                    break;

                                                case "CreatedBy":
                                                    <PropertyColumn Title="Created By" Property="@(x => x.CreatedBy)" />
                                                    break;

                                                case "CreatedDate":
                                                    <PropertyColumn Title="Created Date"
                                                                    Property="@(x => x.CreatedDate)"
                                                                    Format="dd/MM/yyyy" />
                                                    break;

                                                case "ModifiedBy":
                                                    <PropertyColumn Title="Modified By" Property="@(x => x.ModifiedBy)" />
                                                    break;

                                                case "ModifiedDate":
                                                    <PropertyColumn Title="Modified Date"
                                                                    Property="@(x => x.ModifiedDate)"
                                                                    Format="dd/MM/yyyy" />
                                                    break;
                                            }

                                        </div>
                                    }
                                }

                                <!-- ACTION COLUMN -->
                                <TemplateColumn Title="Actions" Context="e">
                                    <div class="d-flex gap-2">

                                        @if (CanEdit)
                                        {
                                            <a href="@($"EmployeeLeaveBalance/update/{e.LeaveBalanceID}")"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit Leave Balance">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        }

                                        @if (CanDelete)
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                    title="Delete Leave Balance"
                                                    @onclick="() => HandleDelete(e.LeaveBalanceID)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        }
                                    </div>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>

                        <!-- PAGINATION -->
                        <div class="pagination-fixed bg-white shadow-sm py-2 border-top">
                            <div class="d-flex align-items-center gap-2 justify-content-center">

                                <button class="btn btn-outline-primary"
                                        title="First Page"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary"
                                        title="Previous Page"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="px-3 fw-semibold">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary"
                                        title="Next Page"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary"
                                        title="Last Page"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-center">No Leave Balance records available.</p>
                    }


            </div>
        </div>
    </div>
}


@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Employee Leave Balance";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteLeaveTypeId = 0;
    private string searchText = string.Empty;
    private string selectedStatus = "";

    private List<EmployeeLeaveBalanceVM> EmployeeLeaveBalanceVMs = new();

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> leavebalBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Master" },
        new PageHeader.BreadcrumbItem { Text = "Human Resource Master" },
        new PageHeader.BreadcrumbItem { Text = "Employee Leave Balance Master", IsLast = true }
    };

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllEmpLeaveBal();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in Employee Leave Balance OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    #region === Data Loading ===

    private async Task LoadAllEmpLeaveBal()
    {
        try
        {
            var result = await empLeaveBalService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            EmployeeLeaveBalanceVMs = result.leaveBalanceVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading data in Employee Leave Balance List");
            await _JS.ToastrError("Failed to load Employee Leave Balance List.");
        }
    }

    private void AddNewLeavebal()
    {
        _navigation.NavigateTo("/employeeLeaveBalance/create");
    }

    #endregion



    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                // =========================
                // KEY
                // =========================
                new() { Title = "Leave Balance ID", Field = "LeaveBalanceID", IsVisible = false },

                // =========================
                // EMPLOYEE DETAILS
                // =========================
                new() { Title = "Employee ID", Field = "EmployeeID", IsVisible = false },
                new() { Title = "Employee Name", Field = "EmployeeName", IsVisible = true },

                // =========================
                // LEAVE DETAILS
                // =========================
                new() { Title = "Leave Type ID", Field = "LeaveTypeId", IsVisible = false },
                new() { Title = "Leave Type", Field = "LeaveTypeName", IsVisible = true },
                new() { Title = "Year", Field = "Year", IsVisible = true },

                // =========================
                // LEAVE BALANCE DETAILS
                // =========================
                new() { Title = "Total Allocated Leave", Field = "TotalAllocatedLeave", IsVisible = true },
                new() { Title = "Leaves Taken", Field = "LeavesTaken", IsVisible = true },
                new() { Title = "Balance", Field = "Balance", IsVisible = true },

                // =========================
                // AUDIT
                // =========================
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };

            if (!Hidden)
            {
                // Add extra dynamic columns here if needed
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }


    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Employee Leave Balance List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Employee Leave Balance HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllEmpLeaveBal();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Employee Leave Balance List");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllEmpLeaveBal();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Employee Leave Balance List");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllEmpLeaveBal();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Employee Leave Balance List");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllEmpLeaveBal();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Employee Leave Balance List");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllEmpLeaveBal();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Employee Leave Balance List");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllEmpLeaveBal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Employee Leave Balance List page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int typeId)
    {
        try
        {
            var (canDelete, message) = await empLeaveBalService.CanDeleteEmpLeaveBalAsync(typeId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteLeaveTypeId = typeId;

            ModalTitle = "Are you sure you want to delete this Employee Leave Balance";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for LeaveTypeId: {typeId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;
           
            var deleted = await empLeaveBalService.DeleteEmpLeaveBalAsync(DeleteLeaveTypeId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Employee Leave Balance deleted successfully.");
                await LoadAllEmpLeaveBal();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Employee Leave Balance could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting LeaveTypeId: {DeleteLeaveTypeId}");
            await _JS.ToastrError("Failed to delete Employee Leave Type.");
        }
        finally
        {
            DeleteLeaveTypeId = 0;
            isProcessing = false;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllEmpLeaveBal();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Employee Leave Balance List");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion

}
