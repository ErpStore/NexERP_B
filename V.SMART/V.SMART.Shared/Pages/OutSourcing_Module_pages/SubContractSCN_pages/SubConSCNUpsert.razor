    private async Task OnProductionReturnSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (SubConSCNVMs.SubConSCNSubVMs == null)
            SubConSCNVMs.SubConSCNSubVMs = new List<SubConSCNSubVM>();

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .Distinct()
                .ToList();

            int storeId = SubConSCNVMs.IssueStoreId ?? 0;

            var storeStock = await _unitOfWork.StockAdds.GetQueryable()
                .Where(s => s.StoreId == storeId && itemIds.Contains(s.ItemId))
                .GroupBy(s => s.ItemId)
                .Select(g => new
                {
                    ItemId = g.Key,
                    StockQty = g.Sum(x => x.BalQty)
                })
                .ToDictionaryAsync(x => x.ItemId, x => x.StockQty);


            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefReturnSubId = item.ContainsKey("RefReturnSubId") && item["RefReturnSubId"] != null
                    ? Convert.ToInt32(item["RefReturnSubId"])
                    : (int?)null;

                int? RefPoSubId = item.ContainsKey("POSubId") && item["POSubId"] != null
                    ? Convert.ToInt32(item["POSubId"])
                    : (int?)null;

                int? RefRcSubId = item.ContainsKey("RCSubId") && item["RCSubId"] != null
                    ? Convert.ToInt32(item["RCSubId"])
                    : (int?)null;

                if (SubConSCNVMs.SubConSCNSubVMs
                    .Any(x => x.ItemId == itemId && x.RefGRNSubId == RefReturnSubId))
                    continue;

                decimal stockQty = storeStock.ContainsKey(itemId)
                    ? storeStock[itemId]
                    : 0;


                var subVm = new SubConSCNSubVM
                {
                    RefGRNSubId = RefReturnSubId,
                    RefGRNNo = item.ContainsKey("ReturnNo") ? item["ReturnNo"]?.ToString() : "",
                    RefGRNDate = item.ContainsKey("ReturnDate") && item["ReturnDate"] != null
                        ? Convert.ToDateTime(item["ReturnDate"])
                        : null,

                    RcSubId = RefRcSubId,
                    RefRcNo = item.ContainsKey("RCNo") ? item["RCNo"]?.ToString() : "",
                    RefRcDate = item.ContainsKey("RCDt") && item["RCDt"] != null
                        ? Convert.ToDateTime(item["RCDt"])
                        : null,

                    PoSubId = RefPoSubId,
                    RefPoNo = item.ContainsKey("PONo") ? item["PONo"]?.ToString() : "",
                    RefPoDate = item.ContainsKey("PODt") && item["PODt"] != null
                        ? Convert.ToDateTime(item["PODt"])
                        : null,

                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("MeasureUnit") ? item["MeasureUnit"]?.ToString() : "",

                    AccQty = item.ContainsKey("BalQty") ? Convert.ToDecimal(item["BalQty"]) : 0,
                    BalQty = item.ContainsKey("BalQty") ? Convert.ToDecimal(item["BalQty"]) : 0,
                    QtyReceived=item.ContainsKey("BalQty") ? Convert.ToDecimal(item["BalQty"]) : 0,
                    UnitPrice =  item.ContainsKey("UnitPrice") ? Convert.ToDecimal(item["UnitPrice"]) : 0,

                    StockQty = stockQty,

                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,
                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",

                    IsEditable = true
                };

                SubConSCNVMs.SubConSCNSubVMs.Add(subVm);
            }

            int slNo = 1;
            foreach (var row in SubConSCNVMs.SubConSCNSubVMs)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnProductionReturnSelectedAsync failed.");
            await _js.ToastrError("Error processing selected items.");
        }
    }
     private async Task Cancel()
    {
        try
        {
            if (!SCNId.HasValue || SCNId == 0)
            {
                await _js.ToastrError("Labour SCN cancel is not allowed before saving the Labour SCN.");
                return;
            }
            if (IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Labour SCN");
                return;
            }

            if (SubConSCNVMs.ShortClose)
            {
                await _js.ToastrError("Labour SCN  is already short closed. You can't cancel it.");
                return;
            }


            if(SubConSCNVMs.SCNCancel)
            {
                var subs = await subConSCNService.GetSCNSubDetailsBySCNIdAsync(SubConSCNVMs.SCNId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    await subConSCNService.ValidateGRNBalanceBeforeRevertAsync(sub);

                }
            }

            if (!SubConSCNVMs.SCNCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this SCN?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this SCN?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            SubConSCNVMs = await subConSCNService.GetSubconSCNByIdAsync(SubConSCNVMs.SCNId);
            await _js.ToastrError( "Cannot revert SCN. Issued quantity exceeds the available GRN balance Qty.");
            await LoggingService.LogDeveloperError(ex, "Error in Labour SCN  Cancel() method");

        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Labour SCN.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Labour SCN  Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }
