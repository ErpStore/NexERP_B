    private async Task<decimal> GetIssueQtyAsync(SubConSCNSubVM subVM)
    {
        if (subVM.RefGRNSubId is null or 0)
            return 0;

        return await subConSCNService.GetProdReturnItemBalQtyFromReturnSubId(subVM.RefGRNSubId.Value);
    }
    private async Task AdjustQty( SubConSCNSubVM subVM,  string field, decimal max, decimal accp, decimal rej, decimal rew)
    {
        switch (field)
        {
            case "Accepted":
                subVM.AccQty = max - (rej + rew);
                break;

            case "Rejected":
                subVM.RejQty = max - (accp + rew);

                break;

            case "Rework":
                subVM.RewQty = max - (accp + rej);

                break;
        }

    }


     private async Task<bool> ValidateAndAdjustAsync( SubConSCNSubVM subVM,  decimal newAccp,  decimal newRej,  decimal newRew,  string fieldName)
    {
        var grnBalQty = await subConSCNService
            .GetProdReturnItemBalQtyFromReturnSubId(subVM.RefGRNSubId!.Value);

        var original = subVM.SCNSubId > 0
            ? await subConSCNService.GetSCNCompItemDetailByScnSubIdAsync(subVM.SCNSubId)
            : null;

        decimal origAccp = original?.AccQty ?? 0;
        decimal origRej  = original?.RejQty ?? 0;
        decimal origRew  = original?.RewQty ?? 0;
        decimal origBal  = original?.BalQty ?? 0;
        decimal origSCnBal  = original?.SCNBalQty ?? 0;

        decimal originalTotal = origAccp + origRej + origRew;
        decimal maxAllowed = grnBalQty + originalTotal;
        decimal total = newAccp + newRej + newRew;
        decimal totalRejRew =  newRej + newRew;


        decimal originalRejRewTotal =  origRej + origRew;

        decimal alreadyTransacted = 0;
        decimal alreadyTransactedSCN = 0;

        if( original != null)
        {
            alreadyTransacted = originalTotal - (origBal + origRej + origRew);
            alreadyTransactedSCN=originalRejRewTotal - origSCnBal;
        }
        else
        {
            alreadyTransacted = 0;
        }

        if (subVM.SCNSubId > 0 && total < alreadyTransacted)
        {
            alreadyTransacted = alreadyTransacted + origRej + origRew;

            await AdjustQty(subVM, fieldName, alreadyTransacted, newAccp, newRej, newRew);
            subVM.BalQty = 0m;

            if(originalRejRewTotal < alreadyTransactedSCN)
            {
                subVM.SCNBalQty = 0m;
            }

            await _js.ToastrWarning(
                $"Total Qty cannot be less than {alreadyTransacted} (already transacted).");
            return false;
        }
        if(subVM.SCNSubId > 0 && totalRejRew < alreadyTransactedSCN)
        {
            alreadyTransactedSCN = originalTotal - alreadyTransactedSCN;

            await AdjustQty(subVM, fieldName, alreadyTransactedSCN, newAccp, newRej, newRew);
            subVM.SCNBalQty = 0m;

            await _js.ToastrWarning(
                $"Total Qty cannot be less than {alreadyTransacted} (already transacted).");
            return false;
        }

        if (total > maxAllowed)
        {
            await AdjustQty(subVM, fieldName, maxAllowed, newAccp, newRej, newRew);

            if (original != null)
            {
                var diff = subVM.AccQty.GetValueOrDefault() - origAccp;
                subVM.BalQty = Math.Max(0m, origBal + diff);

                var Diffrej =(subVM.RejQty.GetValueOrDefault() + subVM.RewQty.GetValueOrDefault()) - originalRejRewTotal;
                subVM.SCNBalQty = Math.Max(0m, alreadyTransactedSCN + Diffrej);


            }
            else
            {
                subVM.BalQty = subVM.AccQty??0;
                subVM.SCNBalQty =
                   subVM.RejQty.GetValueOrDefault()
                  + subVM.RewQty.GetValueOrDefault();

            }

            await _js.ToastrWarning($"{fieldName} change exceeded limit. Max allowed total is {maxAllowed}.");
            return false;
        }

        if (original != null)
        {
            var diff = subVM.AccQty.GetValueOrDefault() - origAccp;

            subVM.BalQty = Math.Max(0m, origBal + diff);

            var Diffrej =(subVM.RejQty.GetValueOrDefault() + subVM.RewQty.GetValueOrDefault()) - originalRejRewTotal;
            subVM.SCNBalQty = Math.Max(0m, alreadyTransactedSCN + Diffrej);

        }
        else
        {
            subVM.BalQty = subVM.AccQty??0;
            subVM.SCNBalQty =subVM.RejQty.GetValueOrDefault() + subVM.RewQty.GetValueOrDefault();
        }

        return true;
    }
    private async Task<bool> ValidateAndAdjustAsync1(
                        SubConSCNSubVM subVM,
                        decimal newAccp,
                        decimal newRej,
                        decimal newRew,
                        decimal stockQty,
                        string fieldName)
    {
        var issueQty = await GetIssueQtyAsync(subVM);

        var original = await subConSCNService
            .GetSCNCompItemDetailByScnSubIdAsync(subVM.SCNSubId);

        decimal originalAccp = original?.AccQty ?? 0;
        decimal originalRej = original?.RejQty ?? 0;
        decimal originalRew = original?.RewQty ?? 0;

        decimal originalTotal = originalAccp + originalRej + originalRew;

        var currentStock = stockQty;

        decimal effectiveStock = currentStock + originalTotal;

        decimal maxAllowedBasedOnIssue = issueQty + originalTotal;
        decimal finalMaxAllowed = Math.Min(maxAllowedBasedOnIssue, effectiveStock);

        decimal enteredTotal = newAccp + newRej + newRew;

        if (enteredTotal > finalMaxAllowed)
        {
            await _js.ToastrWarning($"{fieldName} change exceeded limit. Max allowed total is {finalMaxAllowed}. Auto-adjusted.");

            if (fieldName == "Accepted")
                subVM.AccQty = finalMaxAllowed - (newRej + newRew);

            else if (fieldName == "Rejected")
                subVM.RejQty = finalMaxAllowed - (newAccp + newRew);

            else if (fieldName == "Rework")
                subVM.RewQty = finalMaxAllowed - (newAccp + newRej);

            return false;
        }

        return true;
    }



