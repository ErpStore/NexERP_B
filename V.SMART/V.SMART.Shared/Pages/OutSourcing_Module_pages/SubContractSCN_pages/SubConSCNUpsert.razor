    protected override async Task OnInitializedAsync()
     {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            screenCode = await subConSCNService.GetScreenCodeByScreenNameAsync(ScreenName);
           // IssueStores = await subConSCNService.GetAllIssueStoresAsync();
            AddStores = await subConSCNService.GetAllAddStoresAsync();
            prodReturnPendingCount= await subConSCNService.GetReturnPendingCountAsync();

            IsRejectionSelection = await subConSCNService.GetRejectionSelectionEnableAsync();
            RejectionMasterVMs = await subConSCNService.GetAllRejectionReasonAsync();

            if (SCNId.HasValue)
            {
                await LoadExistingProdSCN(SCNId.Value);
            }
            else
            {
                await InitializeNewProdScn();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

