    private async Task<IEnumerable<VendorVM>> SearchCustomers(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<VendorVM>();

        try
        {
            var results = await subConSCNService.SearchVendors(value,token);
            return results?.Take(50) ?? Enumerable.Empty<VendorVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<VendorVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"In SubConDcOut SearchCustomers failed for value: {value}");
            await _js.ToastrError("Failed to search Customers in Production Issue component Upsert. Please try again.");
            return Enumerable.Empty<VendorVM>();
        }
    }

