    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
                    await CancelSCN();
                    break;
            
                case "ShortClose":
                    await ShortCloseLabourSCN();
                    break;


                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }
    private async Task CancelSCN()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!SubConSCNVMs.SCNCancel)
            {
                SubConSCNVMs.SCNCancel = true;
                SubConSCNVMs.CancelReason = cancelReason;
                SubConSCNVMs.CanceledBy = username;
                await subConSCNService.UpdatedCancelStatusAndAddOrRevertQty(SubConSCNVMs, screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Labour SCN",
                    action: $"Cancelled Labour SCN No: {SubConSCNVMs.SCNNo}",
                    additionalInfo: $"SCN Id: {SubConSCNVMs.SCNId}"
                );

                await _js.ToastrSuccess("Labour SCN cancelled successfully.");
            }
            else
            {
                SubConSCNVMs.SCNCancel = false;
                SubConSCNVMs.CancelDate = null;
                SubConSCNVMs.CancelReason = string.Empty;
                SubConSCNVMs.CanceledBy = string.Empty;

                await subConSCNService.UpdatedCancelStatusAndAddOrRevertQty(SubConSCNVMs, screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Labour SCN",
                    action: $"Reverted Labour SCN No: {SubConSCNVMs.SCNNo}",
                    additionalInfo: $"SCN Id: {SubConSCNVMs.SCNId}"
                );

                await _js.ToastrSuccess("Labour SCN has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            if (SCNId.HasValue && SCNId > 0)
                await LoadExistingProdSCN(SCNId.Value);

            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"CancelSCN failed for SCNId: {SubConSCNVMs.SCNId}");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the Labour SCN.");
            await LoggingService.LogDeveloperError(ex, $"Cancel Labour SCN failed for SCNId: {SubConSCNVMs.SCNId}");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task ShortCloseLabourSCN()
    {
        if (SubConSCNVMs == null)
        {
            await _js.ToastrError("No Labour SCN selected.");
            return;
        }
        try
        {
            isProcessing = true;

            SubConSCNVMs.ShortClose = !SubConSCNVMs.ShortClose;

            await subConSCNService.UpsertSubConSCNShortCloseAsync(SubConSCNVMs);

            StateHasChanged();

            string msg = SubConSCNVMs.ShortClose
                 ? "Labour SCN ShortClose Successfully!"
                 : "Labour SCN ReOpen Successfully!";

            await _js.ToastrSuccess(msg);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while updating ShortClose");
            await LoggingService.LogDeveloperError(ex, "Error in ShortClose()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.SCNSubId > 0)
            {
                await subConSCNService.DeleteAndResequenceAsync(rowToDelete, SubConSCNVMs, screenCode);

                SubConSCNVMs.SubConSCNSubVMs = await subConSCNService.GetProdSCNSubBySCNIdAsync(SubConSCNVMs.SCNId);
            }
            else
            {
                SubConSCNVMs.SubConSCNSubVMs.Remove(rowToDelete);

                if (!SubConSCNVMs.SubConSCNSubVMs.Any())
                {
                    SubConSCNVMs.SubConSCNSubVMs.Add(new SubConSCNSubVM
                    {
                        SCNId = SubConSCNVMs.SCNId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < SubConSCNVMs.SubConSCNSubVMs.Count; i++)
                        SubConSCNVMs.SubConSCNSubVMs[i].SlNo = i + 1;
                }
            }

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for SCNId: {SubConSCNVMs.SCNId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

