    private async Task UpsertProdSCN()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            SubConSCNVMs.SubConSCNSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue || x.ItemId == 0);

            if (!SubConSCNVMs.SubConSCNSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a SubCon SCN without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in SubConSCNVMs.SubConSCNSubVMs)
            {
                bool isValid = await ValidateProdSCNLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewProdSCN = SubConSCNVMs.SCNId == 0;

            try
            {
                await subConSCNService.UpsertproductionSCNAsync(SubConSCNVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewProdSCN)
                await _js.ToastrSuccess("SubCon SCN saved successfully.");
            else
                await _js.ToastrSuccess("SubCon SCN updated successfully.");

            _navigationManager.NavigateTo("/subConScnList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertProdSCN failed.");
            await _js.ToastrError("Error saving SubCon SCN.");
        }
        finally
        {
            isProcessing = false;
        }
    }

     private async Task<bool> ValidateProdSCNLineAsync(SubConSCNSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrWarning("One or more items are missing Item selection.");
                return false;
            }


            decimal acceptQty = line.AccQty ?? 0m;
            decimal rejectQty = line.RejQty ?? 0m;
            decimal reworkQty = line.RewQty ?? 0m;
            decimal enteredTotal = acceptQty + rejectQty + reworkQty;

            decimal stockQty = await subConSCNService.GetStockQtyFromStockManager(line.ItemId.Value, SubConSCNVMs.IssueStoreId.Value);

            if (SubConSCNVMs.SCNId == 0 && stockQty <= 0)
            {
                await _js.ToastrWarning($"AccQty+RejQty+RewQty Quantity should not be greater than Stock Qty.");
                return false;
            }

            decimal totalEnteredForSameItem = SubConSCNVMs.SubConSCNSubVMs.Where(x => x.ItemId == line.ItemId)
            .Sum(x => (x.AccQty ?? 0) + (x.RejQty ?? 0) + (x.RewQty ?? 0));

            if (enteredTotal > (totalEnteredForSameItem + stockQty))
            {
                await _js.ToastrWarning(
                    $"Total issued quantity for Item {line.ItemCode} ({totalEnteredForSameItem}) " +
                    $"cannot exceed Available Stock ({stockQty})."
                );
                return false;
            }
            

             if (totalEnteredForSameItem <= 0m)
                {
                    await _js.ToastrWarning($"AccQty+RejQty+RewQty Quantity should be greater 0");
                    return false;
                }



            if ((line.AccQty + line.RejQty + line.RewQty) > line.QtyReceived)
            {
                await _js.ToastrWarning($"AccQty+RejQty+RewQty Quantity should not be greater than Qty Received.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrWarning($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            if (SubConSCNVMs.IssueStoreId == SubConSCNVMs.AddStoreId)
            {
                await _js.ToastrWarning($"Add Store and Issue Store should not be the same.");
                return false;
            }



            // Qty vs PO / Already Transacted validation
            if (line.SCNSubId == 0 && line.RefGRNSubId > 0)
            {

                var grnBalQty = await subConSCNService.GetProdReturnItemBalQtyFromReturnSubId(line.RefGRNSubId.Value);

                if ((line.AccQty > grnBalQty))
                {
                    line.BalQty = grnBalQty;
                    line.AccQty = grnBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed SCN Balance Qty ({grnBalQty}).");
                    return false;
                }
            }
            else if (line.SCNSubId > 0)
            {
                    var grnBalQty = await subConSCNService.GetProdReturnItemBalQtyFromReturnSubId(line.RefGRNSubId.Value);

                    var original = await subConSCNService.GetProdScnSubItemDetailByScnSubIdAsync(line.SCNSubId);

                    decimal originalAccp = original?.AccQty ?? 0;
                    decimal originalRej = original?.RejQty ?? 0;
                    decimal originalRew = original?.RewQty ?? 0;

                    var originalTotal = originalAccp + originalRej + originalRew;

                    var maxAllowed = grnBalQty + originalTotal;
                    var total = line.AccQty + line.RewQty + line.RejQty;
                      var alreadyTransacted = originalTotal - (original.BalQty+original.SCNBalQty);

                    // Cannot decrease below transacted quantity
                    if (total < alreadyTransacted)
                    {
                        if (line.AccQty>0)
                        {
                            line.AccQty = maxAllowed - (line.RejQty + line.RewQty);
                           
                        }

                        else if (line.RejQty > 0)
                            line.RejQty = maxAllowed - (line.AccQty + line.RewQty);

                        else if (line.RewQty > 0)
                            line.RewQty = maxAllowed - (line.AccQty + line.RejQty);

                        await _js.ToastrWarning($"Qty cannot be less than {maxAllowed} (already transacted).");
                        return false;
                    }
                    else if (total > maxAllowed)
                    {
                        if (line.AccQty>0)
                        {
                            line.AccQty = maxAllowed - (line.RejQty + line.RewQty);
                           
                        }

                        else if (line.RejQty > 0)
                            line.RejQty = maxAllowed - (line.AccQty + line.RewQty);

                        else if (line.RewQty > 0)
                            line.RewQty = maxAllowed - (line.AccQty + line.RejQty);

                        await _js.ToastrWarning(
                            $" Qty change exceeded limit. Max allowed total is {maxAllowed}. Auto-adjusted.");
                        return false;
                    }

            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateDcLineAsync failed.");
            await _js.ToastrError("Error Validate Labour-SCN line.");
            return false;
        }
    }


    private async Task<bool> ValidateProdSCNLineAsync1(SubConSCNSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            if (line.SCNSubId == 0 && line.RefGRNSubId > 0)
            {
                var returnBalQty = await subConSCNService.GetProdReturnItemBalQtyFromReturnSubId(line.RefGRNSubId.Value);
                if (line.AccQty + line.RejQty +line.RewQty > returnBalQty)
                {
                    line.AccQty = returnBalQty;
                    line.RejQty = 0;
                    line.RewQty = 0;
                    line.BalQty = returnBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed SubCon Return Balance Qty ({returnBalQty}).");
                    return false;
                }
            }
            else if (line.SCNSubId > 0)
            {
                var original = await subConSCNService.GetProdScnSubItemDetailByScnSubIdAsync(line.SCNSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty;
                    decimal origQty = original.AccQty ?? 0m;
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.AccQty < alreadyTransacted)
                    {
                        line.AccQty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _js.ToastrWarning($"AccQty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.AccQty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateQuoteLineAsync failed.");
            await _js.ToastrError("Error validating quotation line.");
            return false;
        }
    }

