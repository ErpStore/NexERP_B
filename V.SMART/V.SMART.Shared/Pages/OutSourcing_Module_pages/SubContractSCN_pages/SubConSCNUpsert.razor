    private async Task InitializeNewProdScn()
    {
        try
        {
            SubConSCNVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            SubConSCNVMs.SCNNo = await subConSCNService.GetSCNNumberAsync(SubConSCNVMs.Suffix);

            var MapStoreForProdIssue = await subConSCNService.GetMappedStoreForFormAsync("SubConGRNForm");
            if (MapStoreForProdIssue.StoreId > 0)
            {
                //////////////////vs
                 IssueStores.Clear();

                IssueStores.Add(new Store
                {
                    StoreId = MapStoreForProdIssue.StoreId,
                    StoreName = MapStoreForProdIssue.StoreName
                });
                //--------------------------------------

                SubConSCNVMs.IssueStoreId = MapStoreForProdIssue.StoreId;
                SubConSCNVMs.IssueStoreName = MapStoreForProdIssue.StoreName;
            }
            else
            {
                SubConSCNVMs.IssueStoreId = null;
                SubConSCNVMs.IssueStoreName = null;
            }

            var MapStoreFromProdAdd = await subConSCNService.GetMappedStoreForFormAsync("SubConSCNForm");
            if (MapStoreFromProdAdd.StoreId > 0)
            {
                SubConSCNVMs.AddStoreId = MapStoreFromProdAdd.StoreId;
                SubConSCNVMs.AddStoreName = MapStoreFromProdAdd.StoreName;
            }
            else
            {
                SubConSCNVMs.AddStoreId = null;
                SubConSCNVMs.AddStoreName = null;
            }
            SelectedVendor = await subConSCNService.GetVendorByIdAsync(VendorCode);
            if (SelectedVendor != null)
            {
                await ApplyVendorSelectionAsync(SelectedVendor);
            }

        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new Production SCN.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewProdScn failed");
        }
    }
    private async Task ApplyVendorSelectionAsync(VendorVM? vendor)
    {
        try
        {
            SelectedVendor = vendor;
            SubConSCNVMs.VendorCode = vendor?.VendorCode ?? 0;
            SubConSCNVMs.VendorName = vendor?.VendorName;
            SubConSCNVMs.VendorAddress = vendor?.VendorAddress;
            SubConSCNVMs.VendorContactNo = vendor?.ContactNo;

            if (vendor == null)
            {
                return;
            }


            var MapStoreForProdIssue = await subConSCNService.GetMappedStoreForFormAsync("SubConGRNForm");
