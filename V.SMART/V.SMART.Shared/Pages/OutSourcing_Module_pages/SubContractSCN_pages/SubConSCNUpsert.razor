            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Labour SCN?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while AskToShortCloseAsync Labour SCN.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }
     private void OnRejectionChanged(SubConSCNSubVM subitem)
    {
        var selected = RejectionMasterVMs
            .FirstOrDefault(x => x.RejectionId == subitem.RejectionId);

        if (selected != null)
        {
            subitem.RejReason = selected.RejectionDescription;
        }
    }
    #endregion
    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;
            // Sathish
            var pdfBytes = await reportService.Generate_Report(SCNId.GetValueOrDefault(), "SubconSCN.frx", "SCNId", SubConSCNVMs.SCNCancel, ScreenName, "Sp_Print_SubconSCN");
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf LabourSCN");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in LabourSCN.");
        }
        finally
        {
            isProcessing = false;
        }
    }
