    private async Task OpenModal(string type) 
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "Vendor" => "Add New Vendor",
                "Item" => "Add New Item",
                "Attachments" => "Attached Drawing's",
                _ => "Modal"
            };
            isModalVisible = true;
            await Task.CompletedTask;

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OpenModal.");
            await _JS.ToastrError("Error fetching enquiry OpenModal.");

