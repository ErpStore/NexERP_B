    private async Task UpsertEnquiryPurchase()
    {

        if (IsSomeItemsTransMade)
        {
            await _JS.ToastrWarning("Some items have already been transacted. You cannot modify this record.");
            return;
        }

        isProcessing = true;

        EnquiryPurchaseVM.EnquiryPurchaseSubVMs.RemoveAll(x =>
            (x.ItemId.GetValueOrDefault() == 0) &&
            (x.Qty.GetValueOrDefault() <= 0));

        try
        {
            if (await toValidateEnuiry())
            {
                if (IsSomeItemsTransMade)
                {
                    await _JS.ToastrWarning("Some items are already transacted. You cannot modify this record.");
                    return;
                }

                var isNewEnquiry = EnquiryPurchaseVM.EnquiryId == 0;

                var parent = await enquiryService.UpsertEnquiryPurchaseAsync(EnquiryPurchaseVM);

                await _JS.ToastrSuccess(isNewEnquiry
                    ? "Enquiry saved successfully."
                    : "Enquiry updated successfully.");

                // Discard popup Clear
                await _JS.InvokeVoidAsync("NavigationGuard.clear");

                _navigationManager.NavigateTo("/enquiryPurchase");
            }
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while saving the Enquiry.");
            await LoggingService.LogDeveloperError(ex, "Error in UpsertEnquiryPurchase()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnQtyChanged(EnquiryPurchaseSubVM enq, ChangeEventArgs e)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                enq.Qty = 0;
                enq.BalQty = 0;
                await _JS.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW Enq line
            if (enq.EnquirySubId == 0)
            {
                if (enq.RefMReqSubId > 0)
                {
                    var mreqBalQty = await enquiryService.GetMreqBalQtyByMreqSubId(enq.RefMReqSubId.Value);

                    if (newQty <= mreqBalQty)
                    {
                        enq.Qty = newQty;
                        enq.BalQty = newQty;
                    }
                    else
                    {
                        enq.Qty = mreqBalQty;
                        enq.BalQty = mreqBalQty;
                        await _JS.ToastrWarning($"Qty can't be greater than PR Balance Qty ({mreqBalQty}).");
                    }
                }
                else
                {
                    enq.Qty = newQty;
                    enq.BalQty = newQty;
                }
            }
            // EXISTING Enq line
            else
            {
                var original = await enquiryService.GetEnqSubItemDetailByEnquirySubIdAsync(enq.EnquirySubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    enq.Qty = alreadyTransacted;
                    enq.BalQty = 0;
                    await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (enq.RefMReqSubId > 0)
                {
                    var mreqBalQty = await enquiryService.GetMreqBalQtyByMreqSubId(enq.RefMReqSubId.Value);
                    var maxAllowedQty = original.Qty + mreqBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        enq.Qty = maxAllowedQty;
                        enq.BalQty = maxAllowedQty - alreadyTransacted;
                        await _JS.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        enq.Qty = newQty;
                        enq.BalQty = newQty - alreadyTransacted;
                    }
                }
                else
                {
                    enq.Qty = newQty;
                    enq.BalQty = newQty - alreadyTransacted;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for EnqSubId: {enq?.EnquirySubId}");
            await _JS.ToastrError("Failed to update quantity. Please try again.");
        }
    }

