                                    </div>

                                    <div class="col-6 col-md-3">
                                        <div class="form-floating">
                                            <input class="form-control" id="CreatedDate" value="@EnquiryPurchaseVM.CreatedDate.ToString("dd/MM/yyyy hh:mm:ss")" readonly />
                                            <label for="CreatedDate">Created Date</label>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-3">
                                        <div class="form-floating">
                                            <InputText @bind-Value="EnquiryPurchaseVM.ModifiedBy" class="form-control" id="ModifiedBy" placeholder="Modified By" CssClass="form-control" readonly />
                                            <label for="ModifiedBy">Modified By</label>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-3">
                                        <div class="form-floating">
                                            <input class="form-control" id="ModifiedDate" value="@EnquiryPurchaseVM.ModifiedDate?.ToString("dd/MM/yyyy  hh:mm:ss")" readonly />
                                            <label for="ModifiedDate">Modified Date</label>
                                        </div>
                                    </div>
                                </div>
                            }

                            <hr style="border: 0; height: 1px; background-color: #007bff; margin: 10px 0;" />

                            <div class="row mt-3">
                                @if (!EnquiryPurchaseVM.Cancel && !EnquiryPurchaseVM.EnquiryShortClose)
                                {
                                    @if (CanCreate || CanEdit) 
                                    {
                                        <div class="col-md-3">
                                            <button type="submit" class="btn btn-primary w-100" disabled="@isProcessing">
                                                <i class="bi bi-floppy2-fill me-1"></i> @(EnquiryId == 0 || EnquiryId == null ? "Create" : "Update")
                                            </button>
                                        </div>
                                    }
                                }

                                <div class="col-md-3">
                                    <SmartBackButton Url="/enquiryPurchase" />
                                </div>

                                @if (CanCreate || CanEdit && EnquiryId > 0)
                                {
                                    <div class="col-12 col-md-3">
                                        <button type="button" class="btn btn-info w-100 h-100" @onclick="OpenPdf">
                                            <i class="bi bi-printer me-1"></i>Print
                                        </button>
                                    </div>
                                }

                            </div>

                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
}


