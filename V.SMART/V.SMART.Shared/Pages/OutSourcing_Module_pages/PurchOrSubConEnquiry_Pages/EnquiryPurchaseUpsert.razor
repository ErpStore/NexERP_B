    private string GetRowClass(EnquiryPurchaseSubVM subitem)
    {
        if (subitem.ItemCancel)
            return "table-danger"; // Bootstrap red background
        else
            return ""; // Optional: green background for active
    }


    private async Task OnItemCancelChanged(EnquiryPurchaseSubVM subitem)
    {
        try
        {
            if (subitem.EnquirySubId == 0)
            {
                await _JS.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if (EnquiryPurchaseVM.Cancel)
            {
                await _JS.ToastrError("Enquiry is already Cancel. You can't cancel Item.");
                return;
            }

             if(subitem.ItemCancel )
                    await enquiryService.ValidateBeforeRevertAsync(subitem.EnquirySubId);

            var (CanItemCancel, message) = await enquiryService.CheckAnyTransectionsExists(subitem.EnquirySubId);

            if (!CanItemCancel)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _JS.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _JS.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingEnquiry(EnquiryPurchaseVM.EnquiryId);
            await _JS.ToastrWarning(ex.Message);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in Sales Quotation");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ToggleVendor(VendorVM vendor)
    {
        var isSelected = EnquiryPurchaseVM.SelectedVendors
            .Any(v => v.VendorCode == vendor.VendorCode);

        // ✅ ADD VENDOR (always allowed)
        if (!isSelected)
        {
            EnquiryPurchaseVM.SelectedVendors.Add(vendor);
            return;
        }

        // ✅ REMOVE VENDOR (check transaction)
        var vendorAssignId = await _unitOfWork.EnquiryPurchaseVendorAssigns.GetQueryable()
            .Where(x => x.EnquiryId == EnquiryId.Value && x.VendorCode == vendor.VendorCode)
            .Select(x => x.EnqPurchVendorId)
            .FirstOrDefaultAsync();

        bool hasQuotation = vendorAssignId > 0 && await _unitOfWork.PurchaseQuotesSubs
            .AnyAsync(x => x.RefEnqVendorAssignId == vendorAssignId);

        if (hasQuotation)
        {
            await _JS.ToastrWarning("Cannot remove vendor because quotation already exists.");
            return;
        }

        // ✅ Remove vendor safely
        EnquiryPurchaseVM.SelectedVendors.RemoveAll(v => v.VendorCode == vendor.VendorCode);
    }





    #region Attachments / Modal

    private async Task OpenAttachmentButton(int ItemId, int count)
    {
        try
        {
            if (ItemId == 0)
            {
                await _JS.ToastrWarning("Please select an ItemCode/Part No.!");
