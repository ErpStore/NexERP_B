    private async Task<bool> toValidateEnuiry()
    {

        bool valid = true;

        if (string.IsNullOrEmpty(EnquiryPurchaseVM.EnquiryNo))
        {
            await _JS.ToastrWarning($"Please eneter enquiry No. first?");
            valid = false;
        }
        else if (EnquiryPurchaseVM.SelectedVendors.Count == 0)
            {
                await _JS.ToastrWarning($"Please select at least one vendor.");
                valid = false;
            }
        else if (string.IsNullOrEmpty(EnquiryPurchaseVM.EnquiryDate.ToString()))
        {
            await _JS.ToastrWarning($"Please select EnquiryDate.");
            valid = false;
        }

        else if (!EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Any())
        {
            await _JS.ToastrWarning("At least one row item is required.");
            valid = false;
        }
        else
        {
            foreach (var line in EnquiryPurchaseVM.EnquiryPurchaseSubVMs)
            {
                if (line.ItemId.GetValueOrDefault() == 0)
                {
                    await _JS.ToastrWarning("Please select Item for all rows.");
                    valid = false;
                    break;
                }
                if (line.Qty <= 0 || line.Qty ==null)
                {
                    await _JS.ToastrWarning("Quantity must be greater than 0 for all rows.");
                    valid = false;
                    break;
                }
            }
        }
       
        return valid;
    }

