        try
        {
            if (item.ItemId == 0)
            {
                EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Remove(item);
                await ResetSlno();
                return;
            }

            if (EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Count == 1 && EnquiryPurchaseVM.EnquiryId > 0)
            {
                await _JS.ToastrWarning("At least one item must be present in the Purchase Enquiry.");
                return;
