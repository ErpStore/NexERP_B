                                <div class="row g-3">
                                    <div class="col-6 col-md-3">
                                        <div class="form-floating">
                                            <InputText @bind-Value="EnquiryPurchaseVM.CreatedBy" class="form-control" id="CreatedBy" placeholder="Created By" CssClass="form-control" readonly />
                                            <label for="CreatedBy">Created By</label>
