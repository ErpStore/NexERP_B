    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.EnquiryId > 0)
            {
                await enquiryService.DeleteAndResequenceAsync(rowToDelete, EnquiryPurchaseVM);

                EnquiryPurchaseVM = await enquiryService.GetEnquiryDetailsByEnqIdAsync(EnquiryPurchaseVM.EnquiryId);
            }
            else
            {
                EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Remove(rowToDelete);

                if (!EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Any())
                {
                    EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Add(new EnquiryPurchaseSubVM
                    {
                        EnquiryId = EnquiryPurchaseVM.EnquiryId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    for (int i = 0; i < EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Count; i++)
                        EnquiryPurchaseVM.EnquiryPurchaseSubVMs[i].SlNo = i + 1;
                }
            }

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for EnquiryId: {EnquiryPurchaseVM.EnquiryId}");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }


    private async Task CancelItem()
    {
        if (rowToCancel == null || isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            bool isCancelling = !rowToCancel.ItemCancel;

            if (isCancelling && string.IsNullOrWhiteSpace(cancelReason))
            {
                await _JS.ToastrWarning("Cancel reason is required.");
                return;
            }

            rowToCancel.ItemCancel = isCancelling;
            rowToCancel.ItemCancelReason = isCancelling ? cancelReason : string.Empty;

            await enquiryService.UpdateItemCancelAndAddorRevertAsync(rowToCancel, EnquiryId.Value);

            string actionText = isCancelling ? "Cancelled" : "Reverted";

            await LoggingService.LogUserAction(
                username,
                machine,
                ip,
                screen: "Enquiry Purchase",
                action: $"{actionText} Enquiry No: {EnquiryPurchaseVM.EnquiryNo}, ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: isCancelling
                    ? $"Reason: {cancelReason}"
                    : "Item revert operation"
            );

            await LoadExistingEnquiry(EnquiryId.Value);

            await ResetSlno();

            await _JS.ToastrSuccess($"Item has been {actionText.ToLower()} successfully.");

            cancelReason = string.Empty;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await _JS.ToastrWarning(ex.Message);

            await LoadExistingEnquiry(EnquiryId.Value);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the item.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Revert failed for EnquId: {EnquiryPurchaseVM?.EnquiryId}");
        }
        finally
        {
            isProcessing = false;
        }
    }


