@page "/enquiryPurchase/create"
@page "/enquiryPurchase/create/{VendorCode:int}"
@page "/enquiryPurchase/update/{EnquiryId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.IPurchOrSubConEnquiryService
@using V.SMART.Shared.Data.OutSourcing.PurchaseEnquiry
@using V.SMART.Shared.Pages.Master_Module_pages.VendorSupplier_Pages
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.MaterialRequisitionViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchOrSubConEnquiryVM
@using MudBlazor

@inherits BaseUserRightsComponent
@inject IEnquiryPurchaseService enquiryService
@inject ILoggingService LoggingService
@inject NavigationManager _navigationManager
@inject IJSRuntime _JS
@inject IUnitOfWork _unitOfWork
@inject ICommonService _commonService
@inject ReportService reportService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="Material Requisition Detail"
              Columns="@EnquiryColumns"
              ColumnFields="@EnquiryFields"
              HiddenColumns="@EnquiryHiddenColumns"
              Data="@EnquiryData"
              IsVisible="@IsEnquiryModalVisible"
              IsVisibleChanged="@((val) => IsEnquiryModalVisible = val)"
              OnSelectedItems="OnEnquirySelectedAsync">
</DetailsModal>

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "Vendor")
    {
        <VendorUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
            refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>
 
<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div tabindex="0" @onkeydown="HandleKeyDown">
                                      
            <div class="container-fluid px-2 px-md-5 mt-4">
                <div class="card shadow-sm border-1">

                    <!-- Cancelled Watermark -->
                    @if (EnquiryPurchaseVM.Cancel)
                    {
                        <div class="cancelWatermark">CANCELLED</div>
                    }
                    else if (EnquiryPurchaseVM.EnquiryShortClose)
                    {
                        <div class="cancelWatermark">SHORT CLOSED</div>
                    }

                    <PageHeader TitleText="@(EnquiryId == 0 || EnquiryId == null ? "Create EnquiryPurchase" : "Update EnquiryPurchase")"
                                TitleIcon="bi bi-person"
                                Breadcrumbs="@EnquirySalesBreadcrumbs" />

                    <div class="card-body">
                        <EditForm Model="EnquiryPurchaseVM" OnValidSubmit="UpsertEnquiryPurchase">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="row g-3 mb-3  me-2">
                                <!-- Purchase / SubContract Switch -->
                                <div class="col-12 col-md-6">
                                    <div class="row g-2 align-items-center mb-3">
                                        <div class="col-md-4 d-flex justify-content-start">
                                            <div class="form-check">
                                                <input type="radio" class="form-check-input me-2" id="MfgSwitch" name="PurchORSubCon"
                                                        checked="@EnquiryPurchaseVM.PurchORSubCon"
                                                        @onchange="() => SetPurchORSuCon(true)" 
                                                        disabled="@IsSomeItemsTransMade"/>
                                                <label for="MfgSwitch" class="form-check-label fw-semibold @(EnquiryPurchaseVM.PurchORSubCon ? "text-success" : "")">
                                                    <i class="bi bi-gear me-1"></i> Purchase
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-4 d-flex justify-content-start">
                                            <div class="form-check">
                                                <input type="radio" class="form-check-input me-2" id="LabSwitch" name="MfgOrLab"
                                                        checked="@(!EnquiryPurchaseVM.PurchORSubCon)"
                                                        @onchange="() => SetPurchORSuCon(false)" disabled="@IsSomeItemsTransMade"/>
                                                <label for="LabSwitch" class="form-check-label fw-semibold @(!EnquiryPurchaseVM.PurchORSubCon ? "text-danger" : "")">
                                                    <i class="bi bi-people-fill me-1"></i> SubContract
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6 d-flex justify-content-end align-items-center">
                                    @if (EnquiryPurchaseVM is not null
                                                            && EnquiryPurchaseVM.EnquiryId > 0
                                                            && !string.IsNullOrWhiteSpace(EnquiryPurchaseVM.EnquiryNo))
                                    {
                                        <CorrespondenceStatus ReferenceType="@ScreenName"
                                                                ReferenceId="@EnquiryPurchaseVM.EnquiryId"
                                                                ReferenceTypeName="@EnquiryPurchaseVM.EnquiryNo" />
                                    }
                                </div>
                            </div>
            
                            <div class="container-fluid px-0">
                                <div class="row g-3" >

                                    <div class="col-xxl-6 col-12">
                                        <div class="card h-100 shadow-sm">

                                            <!-- Header -->
                                            <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                                <span class="fw-bold fs-6">
                                                    <i class="bi bi-person-lines-fill me-2"></i> Vendor Details
                                                </span>

                                                <button type="button"
                                                        class="btn btn-sm btn-success rounded-3"
                                                        @onclick='() => OpenModal("Vendor")'>
                                                    <i class="bi bi-person-plus me-1"></i> Add Vendor
                                                </button>
                                            </div>

                                            <div class="card-body">

                                             <MudAutocomplete T="VendorVM"
                                                    Value="SearchVendor"
                                                    ValueChanged="OnVendorSelected"
                                                    ToStringFunc="@(v => v?.VendorName ?? string.Empty)"
                                                    SearchFunc="SearchVendors"
                                                    Dense="true"
                                                    Variant="Variant.Outlined"
                                                    Placeholder="Search Vendor (min 3 letters)"
                                                    Clearable="true"
                                                    Disabled="IsSomeItemsTransMade"
                                                    Class="w-100" />

                                                <MudChipSet T="VendorVM" MultiSelection="true" Class="mt-2">
                                                    @foreach (var vendor in EnquiryPurchaseVM.SelectedVendors)
                                                    {
                                                        <MudChip T="VendorVM"
                                                                    Closeable="!IsSomeItemsTransMade"
                                                                    OnClose="() => RemoveVendor(vendor)">
                                                            @vendor.VendorName
                                                        </MudChip>
                                                    }
                                                </MudChipSet>



                                                <!-- Selected Vendor Details -->
                                                @if (EnquiryPurchaseVM.SelectedVendors != null && EnquiryPurchaseVM.SelectedVendors.Count == 1)
                                                {
                                                    var selectedVendor = EnquiryPurchaseVM.EnquiryPurchaseVendorAssignVMs.FirstOrDefault();

                                                    if (selectedVendor != null)
                                                    {
                                                        <div class="mt-4 p-3 border rounded bg-light shadow-sm">

                                                            <!-- Vendor Name -->
                                                            <div class="row mb-2">
                                                                <div class="col-md-3 text-start">
                                                                    <label class="form-label mb-0"><small>Vendor Name</small></label>
                                                                </div>
                                                                <div class="col-md-9 fw-bold">@selectedVendor.VendorName</div>
                                                            </div>

                                                            <!-- Vendor Address -->
                                                            <div class="row mb-2">
                                                                <div class="col-md-3 text-start">
                                                                    <label class="form-label mb-0"><small>Address</small></label>
                                                                </div>
                                                                <div class="col-md-9">@selectedVendor.VendorAddress</div>
                                                            </div>

                                                            <!-- Contact Number -->
                                                            <div class="row mb-2">
                                                                <div class="col-md-3 text-start">
                                                                    <label class="form-label mb-0"><small>Contact No.</small></label>
                                                                </div>
                                                                <div class="col-md-9">@selectedVendor.VendorPhoneNo</div>
                                                            </div>

                                                            <!-- GST Number -->
                                                            <div class="row mb-2">
                                                                <div class="col-md-3 text-start">
                                                                    <label class="form-label mb-0"><small>GST No.</small></label>
                                                                </div>
                                                                <div class="col-md-9">@selectedVendor.VendorGSTNo</div>
                                                            </div>

                                                            <!-- Contact Person Dropdown -->
                                                            <div class="row mb-2">
                                                                <div class="col-md-3 text-start">
                                                                    <label class="form-label mb-0"><small>Contact Person</small></label>
                                                                </div>
                                                                <div class="col-md-9">
                                                                    <select class="form-select form-select-sm"
                                                                            @bind="@EnquiryPurchaseVM.KindOfAttention">
                                                                        <option disabled value="">Select a Contact Person</option>

                                                                        @foreach (var cp in VendorContacts)
                                                                        {
                                                                            <option value="@cp.ContactPerson">@cp.ContactPerson</option>
                                                                        }
                                                                    </select>

                                                                    <ValidationMessage For="@(() => EnquiryPurchaseVM.KindOfAttention)" />
                                                                </div>
                                                            </div>

                                                        </div>
                                                    }
                                                }

                                            </div>
                                        </div>
                                    </div>


                                    <!-- Document Details -->
                                    <div class="col-12 col-xxl-6">
                                        <div class="card h-100 shadow-sm">

                                            <!-- Card Header -->
                                            <div class="card-header d-flex justify-content-between align-items-center bg-dark-subtle text-dark">
                                                <span class="bi bi-file-earmark-text fw-bold fs-6">Document Details</span>

                                                <div @onkeydown="HandleKeyDown" tabindex="0" class="d-flex gap-2">

                                                    @if (EnquiryId > 0 &&
                                                        (EnquiryPurchaseVM.EnquiryPurchaseSubVMs == null ||
                                                        !EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Any(x => x.ItemCancel)) && (CanCreate || CanEdit))
                                                    {
                                                        <!-- Cancel / Revert Button -->
                                                        <button type="button"
                                                                class="btn btn-sm rounded-3 @(EnquiryPurchaseVM.Cancel ? "btn-success" : "btn-danger")"
                                                                @onclick="() => AskToCancelAsync(EnquiryPurchaseVM)"
                                                                disabled="@EnquiryPurchaseVM.EnquiryShortClose">

                                                            @if (!EnquiryPurchaseVM.Cancel)
                                                            {
                                                                <i class="bi bi-x-circle me-1"></i>
                                                                <span>Cancel</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                                <span>Revert</span>
                                                            }
                                                        </button>

                                                        <!-- Short Closed / Reopen Button -->
                                                        <button type="button"
                                                                class="btn btn-sm rounded-3 @(EnquiryPurchaseVM.EnquiryShortClose ? "btn-success" : "btn-warning")"
                                                                @onclick="() => AskToShortCloseAsync(EnquiryPurchaseVM)"
                                                                disabled="@EnquiryPurchaseVM.Cancel">
                
                                                            @if (!EnquiryPurchaseVM.EnquiryShortClose)
                                                            {
                                                                <i class="bi bi-box-seam me-1"></i>
                                                                <span>Short Closed</span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                                <span>Reopen</span>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Card Body -->
                                            <div class="card-body pt-2">

                                                <!-- Row 1: Enquiry No + Enquiry Date -->
                                                <div class="row g-2 align-items-center mb-2">
                                                    <div class="col-md-3 text-start">
                                                        <label class="form-label text-dark mb-0"><small>Enquiry No.</small></label>
                                                    </div>
                                                   <div class="col-md-9">
                                                        <div class="input-group input-group-sm w-100">
                                                            <!-- Prefix -->
                                                            <input type="text"
                                                                   class="form-control rounded-start"
                                                                   placeholder="Prefix"
                                                                   maxlength="10"
                                                                   @bind="@EnquiryPurchaseVM.Prefix"
                                                                   style="max-width: 120px;" />

                                                            <!-- Enquiry Number -->
                                                            <input type="text"
                                                                   class="form-control"
                                                                   placeholder="Enquiry No."
                                                                   @bind="@EnquiryPurchaseVM.EnquiryNo"
                                                                   style="flex: 1;" readonly/>

                                                            <!-- Suffix -->
                                                            <span class="input-group-text rounded-end text-dark" style="min-width: 80px; text-align: center;">
                                                                <small>@EnquiryPurchaseVM.Suffix</small>
                                                            </span>
                                                        </div>

                                                        <!-- Validation Messages -->
                                                        <div class="mt-1">
                                                            <ValidationMessage For="@(() => EnquiryPurchaseVM.Prefix)" />
                                                            <ValidationMessage For="@(() => EnquiryPurchaseVM.EnquiryNo)" />
                                                        </div>
                                                    </div>

                                                </div>
                                            
                                                <!-- Row 2: Enquiry Date -->
                                                <div class="row g-2 align-items-center mb-2">
                                                    <div class="col-md-3 text-start">
                                                        <label class="form-label text-dark mb-0"><small>Enquiry Date</small></label>
                                                    </div>
                                                    <div class="col-md-9">
                                                        <InputDate class="form-control form-control-sm rounded-2"
                                                                   @bind-Value="@EnquiryPurchaseVM.EnquiryDate" />
                                                        <ValidationMessage For="@(() => EnquiryPurchaseVM.EnquiryDate)" />
                                                    </div>
                                                </div>

                                                <!-- PRN Details -->
                                                @if(!EnquiryPurchaseVM.EnquiryShortClose && !EnquiryPurchaseVM.Cancel && !IsSomeItemsTransMade)
                                                {
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>Ref. PRN No.</small>
                                                        </label>
                                                        <div class="col-12 col-sm-9 position-relative">
                                                            <button type="button"
                                                                    class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                                    @onclick="ShowPRNModal">
                                                                <i class="bi bi-list-ul me-1"></i> PRN Details
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                                


                                                <!-- Row 3: POC Name -->
                                                <div class="row g-2 align-items-center mb-2">
                                                    <div class="col-md-3 text-start">
                                                        <label class="form-label text-dark mb-0"><small>POC Name</small></label>
                                                    </div>
                                                    <div class="col-md-9">
                                                        <input type="text" class="form-control form-control-sm"
                                                               placeholder="POC Name"
                                                               @bind="@EnquiryPurchaseVM.POCName" />
                                                        <ValidationMessage For="@(() => EnquiryPurchaseVM.POCName)" />
                                                    </div>
                                                </div>

                                                <!-- Row 4: POC Contact -->
                                                <div class="row g-2 align-items-center mb-2">
                                                    <div class="col-md-3 text-start">
                                                        <label class="form-label text-dark mb-0"><small>POC Contact No.</small></label>
                                                    </div>
                                                    <div class="col-md-9">
                                                        <input type="text" class="form-control form-control-sm"
                                                               placeholder="POC Contact No."
                                                               @bind="@EnquiryPurchaseVM.POCContactNo"
                                                               maxlength="10"
                                                               onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                                                        <ValidationMessage For="@(() => EnquiryPurchaseVM.POCContactNo)" />
                                                    </div>
                                                </div>

                                                <!-- Row 5: Expected Date -->
                                                <div class="row g-2 align-items-center mb-2">
                                                    <div class="col-md-3 text-start">
                                                        <label class="form-label text-dark mb-0"><small>Expected Date</small></label>
                                                    </div>
                                                    <div class="col-md-9">
                                                        <InputDate class="form-control form-control-sm rounded-2"
                                                                   @bind-Value="@EnquiryPurchaseVM.ExpactedReplayDate" />
                                                        <ValidationMessage For="@(() => EnquiryPurchaseVM.ExpactedReplayDate)" />
                                                    </div>
                                                </div>

                                                <!-- Row 6: Remarks -->
                                                <div class="row g-2 align-items-start mb-2">
                                                    <div class="col-md-3 text-start">
                                                        <label class="form-label text-dark mb-0"><small>Remarks</small></label>
                                                    </div>
                                                    <div class="col-md-9">
                                                        <InputTextArea class="form-control form-control-sm rounded-2 w-100"
                                                                       @bind-Value="@EnquiryPurchaseVM.MainRemarks"
                                                                       maxlength="250"
                                                                       rows="1" />
                                                        <ValidationMessage For="@(() => EnquiryPurchaseVM.MainRemarks)" />
                                                    </div>
                                                </div>

                                                @if (EnquiryPurchaseVM.Cancel)
                                                {
                                                    <div class="row mb-2">
                                                        <label class="col-sm-3 col-form-label text-danger fw-bold">
                                                            Cancel Remarks
                                                        </label>

                                                        <div class="col-sm-9">
                                                            <textarea class="form-control form-control-sm rounded-3"
                                                                        rows="1"
                                                                        @bind="EnquiryPurchaseVM.CancellationRemarks"
                                                                        readonly>
                                                            </textarea>

                                                            <ValidationMessage For="@(() => EnquiryPurchaseVM.CancellationRemarks)" />
                                                        </div>
                                                    </div>
                                                }


                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Item Details Table -->
                            <div class="col-12 mt-3">
                                <div class="card h-100 shadow-sm border-0">

                                    <!-- Card Header -->
                                    <div class="card-header bg-primary-subtle text-dark d-flex justify-content-between align-items-center py-2">
                                        <span class="fw-bold fs-6">Item Details</span>

                                        <div class="d-flex align-items-center gap-2">

                                            <!-- Due Date Input -->
                                            <input type="date"
                                                   class="form-control form-control-sm"
                                                   style="width: 120px;"
                                                   @bind="CommonDueDate" />

                                            <!-- Apply Due Date Button -->
                                            <button type="button"
                                                    class="btn btn-sm btn-warning rounded-3"
                                                    @onclick="ApplyDueDateToAll"
                                                    disabled="@(!CanApplyDueDate)">
                                                <i class="bi bi-calendar-check me-1"></i> Apply Due Date
                                            </button>

                                            <!-- Create New Item Button -->
                                            <button type="button"
                                                    class="btn btn-sm btn-success rounded-3"
                                                    @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>

                                        </div>
                                    </div>

                                    <!-- Card Body -->
                                    <div class="card-body pt-1 px-0">
                                        <div class="table-responsive" style="overflow-x:auto;">
                                            <table class="table table-bordered table-sm align-middle text-center mb-0"
                                               style="table-layout: fixed; min-width: 1700px;">
                                                <thead class="custom-blue">

                                                    <tr>
                                                        <th style="width: 60px;">Sl.No</th>
                                                        <th style="width: 230px;" class="text-start">Item Code</th>
                                                        <th style="width: 220px;" class="text-start">Item Name</th>
                                                        <th style="width: 70px;">UOM</th>
                                                        <th style="width: 90px;">HSN Code</th>
                                                        <th style="width: 130px;">Qty</th>
                                                        <th style="width: 140px;" class="text-start">Due Date</th>
                                                        <th style="width: 170px;" class="text-start">Remarks</th>
                                                        <th style="width: 180px;">Cost-Center</th>
                                                        <th style="width: 100px;">PRN No.</th>
                                                        <th style="width: 110px;">PR Date</th>
                                                        <th class="d-none">MatReqSubId</th>
                                                        @if (EnquiryId.HasValue && EnquiryId > 0 && (!EnquiryPurchaseVM.Cancel))
                                                        {
                                                            <th style="width: 160px;">Item Cancel</th>
                                                            <th style="width: 250px;">Cancellation Remarks</th>
                                                        }
                                                        @if (!EnquiryPurchaseVM.Cancel && !EnquiryPurchaseVM.EnquiryShortClose )
                                                        {
                                                            <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                        }
                                                    </tr>
                                                </thead>

                                                <!-- Table Body -->
                                                <tbody class="custom-size">
                                                    @if (EnquiryPurchaseVM.EnquiryPurchaseSubVMs != null && EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Any())
                                                    {
                                                        @foreach (var enq in EnquiryPurchaseVM.EnquiryPurchaseSubVMs)
                                                        {
                                                            <tr class="@GetRowClass(enq)" @key="enq">

                                                                <td>@enq.SlNo</td>

                                                                <!-- Item Code -->
                                                                <td class="text-start">
                                                                    <div class="d-flex align-items-center gap-2">

                                                                        <div class="col-10">
                                                                            @if (enq.IsEditable && enq.CanEditItem && !IsSomeItemsTransMade)
                                                                            {
                                                                                <MudAutocomplete T="ItemVM"
                                                                                                 @ref="itemAutoCompleteRef"
                                                                                                 Value="enq.SelectedItem"
                                                                                                 ValueChanged="@(item => OnItemChanged(enq, item))"
                                                                                                 SearchFunc="SearchItems"
                                                                                                 ToStringFunc="@(c => c == null ? string.Empty : c.ItemCode)"
                                                                                                 Clearable="true"
                                                                                                 ResetValueOnEmptyText="true"
                                                                                                 Dense="true"
                                                                                                 Variant="Variant.Outlined"
                                                                                                 Placeholder="Select Item"
                                                                                                 Class="w-100"
                                                                                                 Required="true"
                                                                                                 AvoidSubmit="true"
                                                                                                 @onkeydown="HandleKeyDown" />

                                                                                <!-- Validation for Item Code -->
                                                                                <ValidationMessage For="@(() => enq.ItemId)" />
                                                                            }
                                                                            else
                                                                            {
                                                                                @enq.ItemCode
                                                                            }
                                                                        </div>

                                                                        <!-- Attachment -->
                                                                        <div class="col-2 text-center">
                                                                            @if (enq.ItemId is not null && enq.ItemId > 0
                                                                                && attachmentCounts.TryGetValue(enq.ItemId.Value, out var count)
                                                                                && count > 0)
                                                                            {
                                                                                <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                               Size="Size.Small"
                                                                                               Color="Color.Primary"
                                                                                               OnClick="@(async () => await OpenAttachmentButton(enq.ItemId.Value, count))"
                                                                                               Title="@($"This Item has {count} attachment(s)")" />
                                                                            }
                                                                        </div>

                                                                    </div>
                                                                </td>

                                                                <!-- Item Name -->
                                                                <td class="text-start text-truncate" title="@enq.ItemName">@enq.ItemName</td>

                                                                <td>@enq.UOM</td>
                                                                <td>@enq.HsnCode</td>

                                                                <!-- Qty -->
                                                                <td>
                                                                    @if (enq.IsEditable && !IsSomeItemsTransMade)
                                                                    {
                                                                        <input type="number"
                                                                            class="form-control form-control-sm"
                                                                            placeholder="Qty"
                                                                            title="Enter Quantity"
                                                                            step="any"
                                                                            @bind="enq.Qty"
                                                                            @bind:event="oninput"
                                                                            @onchange="@(e => OnQtyChanged(enq, e))" />

                                                                        <ValidationMessage For="@(() => enq.Qty)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @enq.Qty
                                                                    }
                                                                </td>

                                                                <!-- Due Date -->
                                                                <td>
                                                                    @if (enq.IsEditable)
                                                                    {
                                                                        <InputDate @bind-Value="enq.DueDate"
                                                                                   class="form-control form-control-sm w-100"
                                                                                   @onchange="(e) => OnDueDateChanged(enq, e)" />
                                                                        <ValidationMessage For="@(() => enq.DueDate)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>@enq.DueDate.ToString("dd/MM/yyyy")</span>
                                                                    }
                                                                </td>

                                                                <!-- Remarks -->
                                                                <td>
                                                                    @if (enq.IsEditable)
                                                                    {
                                                                        <InputTextArea class="form-control form-control-sm w-100"
                                                                                       @bind-Value="enq.Remark"
                                                                                       rows="1"
                                                                                       maxlength="250"
                                                                                       placeholder="Remarks" />

                                                                        <!-- Remarks Validation -->
                                                                        <ValidationMessage For="@(() => enq.Remark)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @enq.Remark
                                                                    }
                                                                </td>

                                                                <!-- Cost Center + PR -->
