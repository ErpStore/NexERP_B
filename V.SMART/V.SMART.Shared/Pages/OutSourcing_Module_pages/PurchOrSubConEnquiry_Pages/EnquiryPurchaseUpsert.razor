            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OpenAttachmentButton");
            await _JS.ToastrError("Error while opening attachments.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task  ShowPRNModal()
    {

        try
        {
            isProcessing = true;
            EnquiryData = await enquiryService.GetMreqDetails(EnquiryPurchaseVM.PurchORSubCon);
            IsEnquiryModalVisible = true;
        }
        catch (Exception ex)
        {
