    private async Task AskToCancelAsync(EnquiryPurchaseVM enquiry)
    {
        try
        {
            if (!EnquiryId.HasValue || EnquiryId == 0)
            {
                await _JS.ToastrError("Cancellation is not allowed before saving the Purchase Enquiry.");
                return;
            }

            if (EnquiryPurchaseVM.EnquiryShortClose)
            {
                await _JS.ToastrError("PR/Indent is already short closed. You can't cancel it.");
                return;
            }

            if (EnquiryPurchaseVM.EnquiryPurchaseSubVMs?.Any(x => x.ItemCancel) == true)
            {
                await _JS.ToastrError("Some items are already cancelled. Complete PR/Indent cancellation is not allowed.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrError("Some items transactions are made! You can't cancel this Purchase Enquiry.");
                return;
            }


            if (EnquiryPurchaseVM.Cancel)
            {
                var subs = await enquiryService.GetEnqPurchSubByEnqIdAsync(EnquiryPurchaseVM.EnquiryId);

                foreach (var sub in subs)
                {
                    if(sub.RefMReqSubId.GetValueOrDefault()> 0)
                        await enquiryService.ValidateMreqBalanceBeforeRevertAsync(sub);
                }
            }

            if (!EnquiryPurchaseVM.Cancel)
            {
                ModalTitle = "Are you sure you want to cancel this Purchase Enquiry?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to revert this Purchase Enquiry?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Cancel";
                showCancelReasonBox = false;
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            EnquiryPurchaseVM= await enquiryService.GetEnquiryDetailsByEnqIdAsync(EnquiryPurchaseVM.EnquiryId);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }

        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Enquiry Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Purchase Enquiry Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }


