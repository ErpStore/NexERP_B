    private async Task CancelEnquiry()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!EnquiryPurchaseVM.Cancel)
            {
                EnquiryPurchaseVM.Cancel = true;
                EnquiryPurchaseVM.CancellationRemarks = cancelReason;
                EnquiryPurchaseVM.CancelDate = DateTime.Now;
                EnquiryPurchaseVM.CancelBy = username;

                await enquiryService.UpdatedCancelStatusAndAddOrRevertQty(EnquiryPurchaseVM);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Enquiry",
                    action: $"Cancelled Enquiry: {EnquiryPurchaseVM.EnquiryNo}",
                    additionalInfo: $"Enquiry Id: {EnquiryPurchaseVM.EnquiryId}"
                );

                await _JS.ToastrSuccess("Enquiry cancelled successfully.");
            }
            else
            {
                EnquiryPurchaseVM.Cancel = false;
                EnquiryPurchaseVM.CancellationRemarks = string.Empty;
                EnquiryPurchaseVM.CancelDate = null;
                EnquiryPurchaseVM.CancelBy = null;

                await enquiryService.UpdatedCancelStatusAndAddOrRevertQty(EnquiryPurchaseVM);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Enquiry",
                    action: $"Reverted Enquiry: {EnquiryPurchaseVM.EnquiryNo}",
                    additionalInfo: $"Enquiry Id: {EnquiryPurchaseVM.EnquiryId}"
                );

                await _JS.ToastrSuccess("Enquiry has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            EnquiryPurchaseVM= await enquiryService.GetEnquiryDetailsByEnqIdAsync(EnquiryPurchaseVM.EnquiryId);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"CancelEnquiry failed for EnquiryId: {EnquiryPurchaseVM.EnquiryId}");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the Purchase Enquiry.");
            await LoggingService.LogDeveloperError(ex, $"CancelEnquiry failed for EnquiryId: {EnquiryPurchaseVM.EnquiryId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

