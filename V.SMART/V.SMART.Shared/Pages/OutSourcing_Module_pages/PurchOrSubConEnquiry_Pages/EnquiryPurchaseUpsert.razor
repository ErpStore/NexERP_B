    #region Load Enquiry purchase

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            DecimalPlaces = await enquiryService.GetDecimalPlacesAsync();

            if (EnquiryId.HasValue)
            {
                await LoadExistingEnquiry(EnquiryId.Value);

            }
            else if (VendorCode > 0)
            {
                await LoadNewEnquiry(VendorCode.Value);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadExistingEnquiry(int enquiryId)
    {
        try
        {
            EnquiryPurchaseVM = await enquiryService.GetEnquiryDetailsByEnqIdAsync(enquiryId);

            if (EnquiryPurchaseVM == null)
            {
                await _JS.ToastrError("Enquiry not found.");
                return;
            }

            var assignedVendors = await enquiryService.GetAssignedVendorsByEnquiryIdAsync(enquiryId);

            EnquiryPurchaseVM.SelectedVendors = assignedVendors.Select(v => new VendorVM
                                                {
                                                    VendorCode = v.VendorCode,
                                                    VendorName = v.VendorName,
                                                    ContactNo = v.VendorPhoneNo,
                                                    GSTNo = v.VendorGSTNo
                                                }).ToList();

            if (EnquiryPurchaseVM.SelectedVendors.Any())
            {
                await ApplyVendorSelectionAsync(EnquiryPurchaseVM.SelectedVendors.First());
            }

            foreach (var sub in EnquiryPurchaseVM.EnquiryPurchaseSubVMs)
            {
                if (sub.ItemId.HasValue && sub.ItemId.Value > 0)
                {
                    attachmentCounts[sub.ItemId.Value] =
                        await enquiryService.GetCorrespondenceAttachmentsCountAsync(sub.ItemId.Value, "Item");
                }
            }

            var enquirySubIds = EnquiryPurchaseVM.EnquiryPurchaseSubVMs
                                 .Where(x => x.EnquirySubId > 0)
                                 .Select(x => x.EnquirySubId)
                                 .ToList();

            IsSomeItemsTransMade = await CheckIsTransMade();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadExistingEnquiry");
            await _JS.ToastrError("Failed to load existing Enquiry details.");
        }
    }



    private async Task OnEnquirySelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (EnquiryPurchaseVM.EnquiryPurchaseSubVMs == null)
            EnquiryPurchaseVM.EnquiryPurchaseSubVMs = new List<EnquiryPurchaseSubVM>();

        // int VendorCode = EnquiryPurchaseVM.VendorCode;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefEnqSubId = item.ContainsKey("MatReqSubId") && item["MatReqSubId"] != null
                    ? Convert.ToInt32(item["MatReqSubId"])
                    : (int?)null;

                if (EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Any(x => x.ItemId == itemId && x.RefMReqSubId == RefEnqSubId))
                    continue;

                var subVm = new EnquiryPurchaseSubVM
                {
                    RefMReqSubId = RefEnqSubId ?? 0,
                    RefMReqNo = item.ContainsKey("MreqNo") ? item["MreqNo"]?.ToString() : "",
                    RefMReqDate = item.ContainsKey("MreqDate") && item["MreqDate"] != null
                                    ? DateTime.ParseExact(item["MreqDate"].ToString(), "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)
                                    : (DateTime?)null,
                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    UOM= item.ContainsKey("UOM") ? item["UOM"]?.ToString() : "",
                    HsnCode = item.ContainsKey("HSNCODE") ? item["HSNCODE"]?.ToString() : "",

                    Qty = item.ContainsKey("BalQty") && item["BalQty"] != null 
                            ? Convert.ToDecimal(item["BalQty"]) 
                            : 0m,

                    BalQty = item.ContainsKey("BalQty") && item["BalQty"] != null 
                            ? Convert.ToDecimal(item["BalQty"]) 
                            : 0m,

                    //UnitPrice = priceDict.TryGetValue(itemId, out var price) ? price : 0,
                    CostCenterId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,
                    ProjectNo = item.ContainsKey("CostCenterName") ? item["CostCenterName"]?.ToString() : "",

                    DueDate = item.ContainsKey("DueDate") && item["DueDate"] != null
                                ? DateTime.ParseExact(item["DueDate"].ToString(), "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)
                                : DateTime.Today,

                    IsEditable = true
                };

                var existing = EnquiryPurchaseVM.EnquiryPurchaseSubVMs
                .FirstOrDefault(x => x.ItemId == subVm.ItemId && x.RefMReqSubId == subVm.RefMReqSubId)
                 ?? EnquiryPurchaseVM.EnquiryPurchaseSubVMs .FirstOrDefault(x => x.ItemId == 0 || string.IsNullOrEmpty(x.ItemName));

                if(existing != null)
                {
                    existing.RefMReqSubId = subVm.RefMReqSubId;
                    existing.RefMReqNo = subVm.RefMReqNo;
                    existing.RefMReqDate = subVm.RefMReqDate;
                    existing.ItemCode = subVm.ItemCode;
                    existing.ItemName = subVm.ItemName;
                    existing.UOM = subVm.UOM;
                    existing.HsnCode = subVm.HsnCode;
                    existing.Qty = subVm.Qty;
                    existing.BalQty = subVm.BalQty;
                    existing.UnitPrice = subVm.UnitPrice;
                    existing.CostCenterId = subVm.CostCenterId;
                    existing.ProjectNo = subVm.ProjectNo;
                    existing.DueDate = subVm.DueDate;
                    existing.IsEditable = subVm.IsEditable;
                    existing.ItemId= subVm.ItemId;
                }
                else
                {
                    EnquiryPurchaseVM.EnquiryPurchaseSubVMs.Add(subVm);
                }
            }

            int slNo = 1;
            foreach (var row in EnquiryPurchaseVM.EnquiryPurchaseSubVMs)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnEnquirySelectedAsync failed.");
            await _JS.ToastrError("Error processing selected enquiry items.");
        }
    }


    private async Task<bool> CheckIsTransMade()
    {
        return await enquiryService.IsEnquiryTransactionsMatchedAsync(EnquiryId.Value,EnquiryPurchaseVM);
    }

    private async Task LoadNewEnquiry(int vendorCode)
    {
        try
        {
            var vendor = await enquiryService.GetVendorByIdAsync(vendorCode);

            if (vendor == null)
            {
                await _JS.ToastrError("Selected Vendor not found.");
                return;
            }

            EnquiryPurchaseVM.SelectedVendors = new List<VendorVM> { vendor };

            await ApplyVendorSelectionAsync(vendor);

            EnquiryPurchaseVM.Prefix = await enquiryService.GetPrefixFromDbAsync();
            EnquiryPurchaseVM.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            EnquiryPurchaseVM.EnquiryNo = await enquiryService.GenerateEnquiryNumberAsync(EnquiryPurchaseVM.Suffix);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadNewEnquiry");
            await _JS.ToastrError("Failed to initialize new Enquiry.");
        }
    }



    private async Task ApplyVendorSelectionAsync(VendorVM? vendor)
    {
        try
        {
            SelectedVendor = vendor;

            if (vendor == null)
            {
                VendorContacts.Clear();
                CostCenterVMs.Clear();
                return;
            }

            VendorContacts = await enquiryService.GetContactPersonsVendorAsync(vendor.VendorCode);

            var usedCostCenters = EnquiryPurchaseVM.EnquiryPurchaseSubVMs
                .Where(x => x.CostCenterId.HasValue)
                .Select(x => x.CostCenterId.Value)
                .ToHashSet();

            CostCenterVMs = await enquiryService.GetCostCenterDetailsByCustId(vendor.VendorCode, usedCostCenters);

            if (VendorContacts.Count == 1)
                EnquiryPurchaseVM.KindOfAttention = VendorContacts.First().ContactPerson;
            else
                EnquiryPurchaseVM.KindOfAttention = string.Empty;

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ApplyCustomerSelectionAsync");
            await _JS.ToastrError("Failed to apply customer selection.");
        }

    }

    private async Task ToggleEdit(EnquiryPurchaseSubVM enq)
    {
        try
        {
            if(enq.Qty >0)
                enq.IsEditable = !enq.IsEditable;

            enq.SelectedItem = await enquiryService.GetItemByItemIdAsync(enq.ItemId);

            if (!enq.IsEditable)
                await AddRow();
