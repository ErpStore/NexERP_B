    #endregion


    #region Vendor Selection

    private async Task<IEnumerable<VendorVM>> SearchVendors(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<VendorVM>();

        try
        {
            var vendors = await _commonService.SearchVendorsAsync(value);
            return vendors?.Where(v => !EnquiryPurchaseVM.SelectedVendors.Any(sv => sv.VendorCode == v.VendorCode))
                           .Take(50) 
                   ?? Enumerable.Empty<VendorVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchVendors failed for value: {value}");
            await _JS.ToastrError("Failed to search vendors. Please try again.");
            return Enumerable.Empty<VendorVM>();
        }
    }


    private async Task OnVendorSelected(VendorVM? vendor)
    {
        if (vendor == null || EnquiryPurchaseVM.SelectedVendors.Any(v => v.VendorCode == vendor.VendorCode))
            return;

        EnquiryPurchaseVM.SelectedVendors.Add(vendor);

        await ApplyVendorSelectionAsync(vendor);

        SearchVendor = null;

        StateHasChanged();
    }

    private void RemoveVendor(VendorVM vendor)
    {
        if (IsSomeItemsTransMade)
            return;

        EnquiryPurchaseVM.SelectedVendors.Remove(vendor);

        // Optionally, clear fields if this vendor was applied
        if (SearchVendor?.VendorCode == vendor.VendorCode)
            SearchVendor = null;

        StateHasChanged();
    }


