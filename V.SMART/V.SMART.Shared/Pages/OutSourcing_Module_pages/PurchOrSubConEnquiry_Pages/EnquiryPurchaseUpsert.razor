                                                </tbody>
                                            </table>

                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            @if (!EnquiryPurchaseVM.Cancel && !EnquiryPurchaseVM.EnquiryShortClose )
                            {
                                <button type="button" class="btn btn-sm rounded-3 mt-3 text-white"
