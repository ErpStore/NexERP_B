                    IP_Address: ip,
                    screen: "Purchase Invoice",
                    action: $"Cancelled Purchase invoice No: {PurchaseInvoiceVMs.InvNo}",
                    additionalInfo: $"Inv Id: {PurchaseInvoiceVMs.InvId}"
