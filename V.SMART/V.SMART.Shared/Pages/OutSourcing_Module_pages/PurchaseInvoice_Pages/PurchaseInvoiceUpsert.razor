    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.InvSubId > 0)
            {
                await _invService.DeleteAndResequenceAsync(rowToDelete, PurchaseInvoiceVMs);
                if(InvId.HasValue || InvId > 0)
                    await LoadExistingInvoice(InvId.Value);
            }
            else
            {
                PurchaseInvoiceVMs.PurchaseInvoiceSubVMs.Remove(rowToDelete);

                if (!PurchaseInvoiceVMs.PurchaseInvoiceSubVMs.Any())
                {
                    PurchaseInvoiceVMs.PurchaseInvoiceSubVMs.Add(new PurchaseInvoiceSubVM
                    {
                        InvId = PurchaseInvoiceVMs.InvId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    await ResetSlno();
                }
            }

            await _calculationService.UpdateTotalsAsync(PurchaseInvoiceVMs);

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for InvId: {PurchaseInvoiceVMs.InvId}");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

