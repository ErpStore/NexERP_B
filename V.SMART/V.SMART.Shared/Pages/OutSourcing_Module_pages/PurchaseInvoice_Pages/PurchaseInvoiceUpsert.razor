    private async Task UpsertPurchaseInvoice()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            PurchaseInvoiceVMs.PurchaseInvoiceSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!PurchaseInvoiceVMs.PurchaseInvoiceSubVMs.Any())
            {
                await _JS.ToastrError("Cannot save a Purchase-Invoice without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in PurchaseInvoiceVMs.PurchaseInvoiceSubVMs)
            {
                bool isValid = await ValidateSCNLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewInv = PurchaseInvoiceVMs.InvId == 0;

            if(isNewInv)
            {
                var isduplicate = await _invService.IsDuplicateInvoiceAsync(PurchaseInvoiceVMs.InvNo, PurchaseInvoiceVMs.Suffix, PurchaseInvoiceVMs.InvId, PurchaseInvoiceVMs.VendorCode);

                if (isduplicate)
                {
                    await _JS.ToastrWarning("This invoice number already exists for the selected vendor. Please verify and try again.");
                    return;
                }
            }

            try
            {
                await _invService.UpsertPurchaseInvoice(PurchaseInvoiceVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewInv)
                await _JS.ToastrSuccess("Purchase Invoice saved successfully.");
            else
                await _JS.ToastrSuccess("Purchase Invoice updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigation.NavigateTo("/purchaseInvoiceList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertPurchaseInvoice failed.");
            await _JS.ToastrError("Error saving purchase Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateSCNLineAsync(PurchaseInvoiceSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _JS.ToastrWarning("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _JS.ToastrWarning($"Item {line.ItemCode}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _JS.ToastrWarning($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            decimal cgst=0,sgst=0,igst=0,lcgst=0,lsgst=0,ligst=0;

            decimal.TryParse(PurchaseInvoiceVMs.CGstRate.ToString(),out cgst);
            decimal.TryParse(PurchaseInvoiceVMs.SGstRate.ToString(),out sgst);
            decimal.TryParse(PurchaseInvoiceVMs.IGstRate.ToString(),out igst);

            decimal.TryParse(line.LineCGSTRate.ToString(),out lcgst);
            decimal.TryParse(line.LineSGSTRate.ToString(),out lsgst);
            decimal.TryParse(line.LineIGSTRate.ToString(),out ligst);

            bool isCGST_SGST_Zero = (cgst + lcgst) == 0 &&  (sgst + igst) == 0;

            bool isIGST_Zero =(igst + ligst) == 0;

            if (!SelectedVendor.TaxValidate && (isCGST_SGST_Zero && isIGST_Zero))
            {
                await _JS.ToastrWarning("Please verify tax rates. Item-wise CGST/SGST/IGST cannot be empty or zero.");
                return false;
            }


            if (line.InvSubId == 0 && line.RefSCNSubId > 0)
            {
                var purchaseSCNSub = await _invService.GetSCNQtyDetailsFromSCNSubId(line.RefSCNSubId.Value);

                var SCNSubBalQty = PurchaseInvoiceVMs.IsAcptRejRewQtyRequired ? (purchaseSCNSub.BalQty + purchaseSCNSub.RejectQty + purchaseSCNSub.ReworkQty) : purchaseSCNSub.BalQty;

                if (line.Qty > SCNSubBalQty.GetValueOrDefault())
                {
                    line.Qty = SCNSubBalQty;
                    await _JS.ToastrWarning($"Qty cannot exceed Purchase SCN Balance Qty ({SCNSubBalQty.GetValueOrDefault()}).");
                    return false;
                }
            }
            else if (line.InvSubId > 0)
            {
                var original = await _invService.GetInvSubItemDetailByInvSubIdAsync(line.InvSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty.GetValueOrDefault();
                    decimal origQty = original.Qty.GetValueOrDefault();
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateSCNLineAsync failed.");
            await _JS.ToastrError("Error Validate Purchase-SCN line.");
            return false;
        }
    }

