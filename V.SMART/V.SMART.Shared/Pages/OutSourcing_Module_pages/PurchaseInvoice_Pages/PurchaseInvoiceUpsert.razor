    private async Task OnSCNSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (PurchaseInvoiceVMs.PurchaseInvoiceSubVMs == null)
            PurchaseInvoiceVMs.PurchaseInvoiceSubVMs = new List<PurchaseInvoiceSubVM>();

        try
        {
            foreach (var item in selectedItems)
            {
                int itemId = item.TryGetValue("ItemId", out var itemObj) && int.TryParse(itemObj?.ToString(), out var id) ? id : 0;
                int? scnSubId = item.TryGetValue("SCNSubId", out var scnObj) && int.TryParse(scnObj?.ToString(), out var sid) ? sid : (int?)null;
                int? poSubId = item.TryGetValue("PoSubId", out var poSubObj) && int.TryParse(poSubObj?.ToString(), out var psId) ? psId : (int?)null;

                if (itemId == 0 || PurchaseInvoiceVMs.PurchaseInvoiceSubVMs.Any(x => x.ItemId == itemId && x.RefSCNSubId == scnSubId))
                    continue;

                decimal balQty = TryDecimal(item, "BalQty");
                decimal rejectQty = TryDecimal(item, "RejectQty");
                decimal reworkQty = TryDecimal(item, "RewQty");

                decimal poUnitPrice = TryDecimal(item, "PoUnitPrice");
                decimal poDiscPercent = TryDecimal(item, "PoLineDiscountPercent");
                decimal poDiscAmount = TryDecimal(item, "PoLineDiscountAmount");

                decimal poCgstRate = TryDecimal(item, "PoLineCGSTRate");
                decimal poSgstRate = TryDecimal(item, "PoLineSGSTRate");
                decimal poIgstRate = TryDecimal(item, "PoLineIGSTRate");

                // RECALCULATE DISCOUNT AMOUNT BASED ON CURRENT QTY
                var gross = balQty * poUnitPrice;
                var recalculatedDiscount = (gross * poDiscPercent) / 100m;

                var sub = new PurchaseInvoiceSubVM
                {
                    RefPoSubId = poSubId,
                    RefSCNSubId = scnSubId,
                    RefSCNNo = GetString(item, "SCNNo"),
                    RefSCNDate = GetDate(item, "SCNDate"),

                    ItemId = itemId,
                    ItemCode = GetString(item, "ItemCode"),
                    ItemName = GetString(item, "ItemName"),
                    Specification = GetString(item, "Specification"),
                    MeasureUnit = GetString(item, "UOM"),
                    HSNCode = GetString(item, "HSNCode"),
                    Category = GetString(item, "Category"),

                    Qty = PurchaseInvoiceVMs.IsAcptRejRewQtyRequired ? balQty+ rejectQty + reworkQty : balQty,
                    BalQty = PurchaseInvoiceVMs.IsAcptRejRewQtyRequired ? balQty+ rejectQty + reworkQty : balQty,
                    DbBalQty = PurchaseInvoiceVMs.IsAcptRejRewQtyRequired ? balQty + rejectQty + reworkQty : balQty,
                    UnitPrice = poUnitPrice,

                    LineDiscountPercent = poDiscPercent,
                    LineDiscountAmount = recalculatedDiscount,

                    LineCGSTRate = CommonConstants.GetGST(poCgstRate),
                    LineSGSTRate = CommonConstants.GetGST(poSgstRate),
                    LineIGSTRate = CommonConstants.GetIGST(poIgstRate),

                    CostId = TryInt(item, "CostCenterId"),
                    ProjectNo = GetString(item, "ProjectNo"),

                    IsEditable = true
                };
                PurchaseInvoiceVMs.PurchaseInvoiceSubVMs.Add(sub);
            }

            await ResetSlno();

            if (await _invService.IsInvoiceExistsForVendorAsync(PurchaseInvoiceVMs.VendorCode.Value))
            {
                await _invService.LoadPreviousInvoiceHeaderAsync(PurchaseInvoiceVMs);
            }
            else
            {
                var poSubIds = PurchaseInvoiceVMs.PurchaseInvoiceSubVMs
                                .Where(x => x.RefPoSubId.HasValue)
                                .Select(x => x.RefPoSubId.Value)
                                .Distinct()
                                .ToList();

                if (poSubIds.Any())
                {
                    var poIds = await _invService.GetPOIdsByPOSubIdsAsync(poSubIds);

                    if (poIds.Distinct().Count() == 1)
                    {
                        await _invService.LoadPOHeaderToInvoiceAsync(PurchaseInvoiceVMs,poIds.First());
                    }
                }
            }

            await _calculationService.UpdateTotalsAsync(PurchaseInvoiceVMs);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnSCNSelectedAsync failed.");
            await _JS.ToastrError("Error processing SCN selected items.");
        }
    }

    private decimal TryDecimal(Dictionary<string, object> dict, string key)
    {
        return dict.TryGetValue(key, out var value) &&
               decimal.TryParse(value?.ToString(), out var result)
               ? result
               : 0m;
    }

    private int? TryInt(Dictionary<string, object> dict, string key)
    {
        return dict.TryGetValue(key, out var value) &&
               int.TryParse(value?.ToString(), out var result)
               ? result
               : (int?)null;
    }

    private string GetString(Dictionary<string, object> dict, string key)
    {
        return dict.TryGetValue(key, out var value) ? value?.ToString() ?? "" : "";
    }

    private DateTime? GetDate(Dictionary<string, object> dict, string key)
    {
        return dict.TryGetValue(key, out var value) &&
               DateTime.TryParse(value?.ToString(), out var dt)
               ? dt
               : (DateTime?)null;
    }

    #endregion

    #region Formatting
    // Common decimal formatter
    private string FormatDecimal(decimal? value)
    {
        return value?.ToString($"F{DecimalPlaces}") ?? (0m).ToString($"F{DecimalPlaces}");
    }

    #endregion

    #region TDS Deduct

    private async Task UpdateTDS()
    {
        if (PurchaseInvoiceVMs == null)
            return;
        await _invService.UpdateTDSAmountAsync(PurchaseInvoiceVMs);
        await _JS.ToastrSuccess($" TDS Amount {PurchaseInvoiceVMs.TDSAmount} ₹ Updated successfully.");
    }

    #endregion

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;
            var pdfBytes = await reportService.Generate_Report(InvId.GetValueOrDefault(), "PurchaseInvoice.frx", "InvId", PurchaseInvoiceVMs.InvCancel, "PurchaseInvoice", "Sp_Print_PurchaseInvoice");
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _JS.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf PurchaseInvoice");
            await _JS.ToastrError("An unexpected error occurred while generating the PDF in PurchaseInvoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
