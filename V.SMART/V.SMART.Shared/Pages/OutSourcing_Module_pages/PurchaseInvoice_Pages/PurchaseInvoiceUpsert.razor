    private async Task AskToShortCloseAsync()
    {
        try
        {
            if (PurchaseInvoiceVMs == null)
            {
                await _JS.ToastrError("Invalid Purchase Invoice selected.");
                return;
            }

            if (!InvId.HasValue || InvId == 0)
            {
                await _JS.ToastrError("Quotation Short Closed is not allowed before saving the Quotation.");
                return;
            }

            if (PurchaseInvoiceVMs.InvTally)
            {
                await _JS.ToastrWarning("This Purchase Invoice is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (PurchaseInvoiceVMs.InvCancel)
            {
                await _JS.ToastrWarning("This Purchase Invoice is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!PurchaseInvoiceVMs.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Purchase Invoice?";
                btnText = "Short Closed";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Purchase Invoice?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while AskToShortCloseAsync Purchase Invoice.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task Cancel()
    {
        try
        {
            if (!InvId.HasValue || InvId == 0)
            {
                await _JS.ToastrError("Invoice cancel is not allowed before saving the Purchase Invoice.");
                return;
            }

            if(IsSomeItemsTransMade)
            {
                await _JS.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Purchase Invoice");
                return;
            }

            if (PurchaseInvoiceVMs.ShortClose)
            {
                await _JS.ToastrError("Invoice is already short closed. You can't cancel it.");
                return;
            }

            if (PurchaseInvoiceVMs.PurchaseInvoiceSubVMs?.Any(x => x.ItemCancel) == true)
            {
                await _JS.ToastrError("Some items are already cancelled. Complete Purchase Invoice cancellation is not allowed.");
                return;
            }

            bool exist = false;
            foreach (var refId in PurchaseInvoiceVMs.PurchaseInvoiceSubVMs)
            {
                exist = await _invService.HasAnyItemOrInvoiceDebitNoteAsync(refId.InvSubId);
                if (exist)
                {
                    await _JS.ToastrWarning("Cannot Cancel this invoice. Debit Note already exists for this invoice or its items.");
                    return;
                }
            }

            if (PurchaseInvoiceVMs.InvCancel)
            {
                var subs = await _invService.GetInvSubByInvIdAsync(PurchaseInvoiceVMs.InvId); 

                foreach (var sub in subs)
                {
                    await _invService.ValidatePurchaseSCNBalanceBeforeRevertAsync(sub);
                }
            }

            if (!PurchaseInvoiceVMs.InvCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Purchase Invoice?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Purchase Invoice?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            if (InvId.HasValue || InvId > 0)
                await LoadExistingInvoice(InvId.Value);

            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }

        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Invoice.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Purchase Invoice Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {

        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
                    await CancelInvoice();
                    break;

                case "ShortClose":
                    await ShortCloseInvoice();
                    break;

                case "TDS":
                    await UpdateTDS();
                    break;

                default:
                    await _JS.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action in PurchaseGRNUpsert: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action in PurchaseGRNUpsert. Please try again.");
        }
    }

