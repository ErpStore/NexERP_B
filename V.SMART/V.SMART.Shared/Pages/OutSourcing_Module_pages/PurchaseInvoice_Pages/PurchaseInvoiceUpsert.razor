                await _JS.ToastrSuccess("Purchase Invoice cancelled successfully.");
            }
            else
            {
                PurchaseInvoiceVMs.InvCancel = false;
                await _invService.UpdatedCancelStatusAndAddOrRevertQty(PurchaseInvoiceVMs, screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Purchase Invoice",
