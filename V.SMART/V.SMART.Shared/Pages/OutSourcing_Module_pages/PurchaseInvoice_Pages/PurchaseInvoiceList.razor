    #region === Deletion Flow ===

    private async Task HandleDelete(PurchaseInvoiceVM purchhInv)
    {
        try
        {

            var (canDelete, message) = await purchaseInvService.CanDeletePurchaseInvAsync(purchhInv.InvId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            bool exist = false;
            foreach (var refId in purchhInv.PurchaseInvoiceSubVMs)
            {
                exist = await purchaseInvService.HasAnyItemOrInvoiceDebitNoteAsync(refId.InvSubId);
                if (exist)
                {
                    await _JS.ToastrWarning("Cannot delete this invoice. Debit Note already exists for this invoice or its items.");
                    return;
                }
            }

            DeleteInvId = purchhInv.InvId;

            ModalTitle = "Are you sure you want to delete this Purchase Invoice";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for InvoiceId: {purchhInv.InvId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;

            var deleted = await purchaseInvService.DeletePurchaseInvoiceByIdAsync(DeleteInvId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Purchase Invoice deleted successfully.");
                await LoadAllInvoices();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Purchase Invoice could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting InvoiceId: {DeleteInvId}");
            await _JS.ToastrError("Failed to delete Purchase Invoice.");
        }
        finally
        {
            DeleteInvId = 0;
            isProcessing = false;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else if (confirmation=="Export")
            {
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
