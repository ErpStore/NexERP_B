    private async Task HandleExport()
    {

        selectedStatus = selectedStatus == "" ? "All" : selectedStatus;

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;

            var exportData = await purchaseInvService.GetPurchaseInvoicePendingListAsync(selectedStatus);

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "PurchaseInvoice", "Purchase Invoice's Pending List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "PurchaseInvoiceExport.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (Purchase Invoice)");
            await _JS.ToastrError("Error while exporting Purchase Invoice!");
        }
        finally
        {
            isProcessing = false;
        }
    }


