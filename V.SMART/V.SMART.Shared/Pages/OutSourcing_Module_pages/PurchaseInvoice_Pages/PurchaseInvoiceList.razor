    #region Job order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

           if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;

            currentPage = 1;
            await LoadAllInvoices();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in Purchase Invoice List");
            await _JS.ToastrError("Failed to Load Purchase Invoice List filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

