    #region Cancel And Short-Close

    private async Task Cancel()
    {
        try
        {
            if (DcId.GetValueOrDefault() == 0)
            {
                await _JS.ToastrError("Save the Subcontract DC Outgoing first.");
                return;
            }
            bool trans = await subConDcOutService.IsSubConDcTransactionsMatchedwilecancelAsync(SubConDcOutVMs.DcId,SubConDcOutVMs);
          
            if (trans)
            {
                await _JS.ToastrWarning("Some Items Transaction Are Made!.. You Can't Cancel the Complete Subcontract DC");
                return;
            }


            if (SubConDcOutVMs.ShortClose)
            {
                await _JS.ToastrError("Delivery Challan is already short closed. You can't cancel it.");
                return;
            }

            // If ANY item is already cancelled → stop GRN cancel
            if (SubConDcOutVMs.SubConDcOutSubVMs.Any(s => s.ItemCancel))
            {
                await _JS.ToastrWarning("DC cannot be cancelled — one or more items are already cancelled.");
                return;
            }

            if(SubConDcOutVMs.Cancel)
            {
                var subs = await subConDcOutService.GetSubConDcSubDetailsByDcIdAsync(SubConDcOutVMs.DcId);

                if (subs == null || subs.Count == 0)
                    return;
                
                foreach (var sub in subs)
                {
                    if(sub.TransType =="In")
                    {
                        if(sub.RefPoSubId.GetValueOrDefault() > 0)
                        {
                            await subConDcOutService.ValidatePoBalanceBeforeRevertAsync(sub);
                        }
                        else if(sub.RcSubId.GetValueOrDefault() > 0)
                        {
                            await subConDcOutService.ValidateRcBalanceBeforeRevertAsync(sub);
                        }
                    }
                }
            }

            if (!SubConDcOutVMs.Cancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Delivery Challan?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Delivery Challan?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            SubConDcOutVMs = await subConDcOutService.GetSubConDcOutByDcIdAsync(DcId.Value);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Subcontract Delivery Challan .Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Subcontract Delivery Challan Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task AskToShortCloseAsync(SubConDcOutVM subConDcOutVMs)
