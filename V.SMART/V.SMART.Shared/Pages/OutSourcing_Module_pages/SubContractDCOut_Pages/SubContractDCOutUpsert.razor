            {
                await subConDcOutService.DeleteAndResequenceAsync(rowToDelete, SubConDcOutVMs,screenCode);

                SubConDcOutVMs.SubConDcOutSubVMs = await subConDcOutService.GetSubConDcOutSubsByDcIdAsync(SubConDcOutVMs.DcId);
            }
            else
            {
                SubConDcOutVMs.SubConDcOutSubVMs.Remove(rowToDelete);

                if (!SubConDcOutVMs.SubConDcOutSubVMs.Any())
                {
                    SubConDcOutVMs.SubConDcOutSubVMs.Add(new SubConDcOutSubVM
                    {
                        DcId = SubConDcOutVMs.DcId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < SubConDcOutVMs.SubConDcOutSubVMs.Count; i++)
                        SubConDcOutVMs.SubConDcOutSubVMs[i].SlNo = i + 1;
                }
            }

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for DcId:{SubConDcOutVMs.DcId} ");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

