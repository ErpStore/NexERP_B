    private async Task OnStoreChanged(ChangeEventArgs e)
    {
        SubConDcOutVMs.StoreIssId = int.Parse(e.Value.ToString());
        await LoadStockForAllItems(SubConDcOutVMs.StoreIssId.Value);
    }
    private async Task LoadStockForAllItems(int storeId)
    {
        foreach (var item in SubConDcOutVMs.SubConDcOutSubVMs)
        {
            item.StockQty = await subConDcOutService.GetStockForItemsAsync(item.ItemId.Value, storeId);
        }
    }
    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;
            
            var pdfBytes = await reportService.Generate_Report(DcId.GetValueOrDefault(),"SubConDC.frx","DcId", SubConDcOutVMs.Cancel,ScreenName,"Sp_Print_SubConDcOut");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _JS.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _JS.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _JS.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,"Unexpected error occurred while generating pdf in SubConDcout.");
            await _JS.ToastrError("Unexpected error occurred while generating report in SubConDcout");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
