            }

            if (subConDcOutVMs.Cancel)
            {
                await _JS.ToastrWarning("This Delivery Challan is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!subConDcOutVMs.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Delivery Challan?";
                btnText = "Short Close";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
