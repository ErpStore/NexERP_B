
@page "/DcSubConOutgoing/create/{VendorCode:int}"
@page "/DcSubConOutgoing/update/{DcId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.ISubContractDcOutservice
@using V.SMART.Shared.Pages.Master_Module_pages.VendorSupplier_Pages
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.SubContractViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ReportService reportService

@inject ISubConDcOutService subConDcOutService
@inject IStockManagerService _stockManagerService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="PO Details"
              Columns="@PoColumns"
              ColumnFields="@PoFields"
              HiddenColumns="@PoHiddenColumns"
              Data="@PoData"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="OnPoSelectedAsync">
</DetailsModal>

<DetailsModal Title="Rout Card Details"
              Columns="@RcColumns"
              ColumnFields="@RcFields"
              HiddenColumns="@RcHiddenColumns"
              Data="@RcData"
              IsVisible="@IsRcModalVisible"
              IsVisibleChanged="@((val) => IsRcModalVisible = val)"
              OnSelectedItems="OnRcSelectedAsync">

    <HeaderContent>
        <div class="d-flex justify-content-end gap-2 mb-2">

            <label class="d-flex align-items-center cursor-pointer px-2 py-1
                          rounded-pill
                          @(SelectedOption == "Stock" ? "bg-primary text-white" : "bg-light text-dark")"
                   style="font-size: 0.75rem;">
                <input type="radio" class="d-none" name="itemType" id="onlyStock" value="Stock"
                       checked="@(SelectedOption == "Stock")"
                       @onchange="OnStockFilterChanged" />
                <i class="bi bi-box-seam fs-6 me-1"></i>
                Load only Stock exists Items
            </label>

            <label class="d-flex align-items-center cursor-pointer px-2 py-1
                          rounded-pill
                          @(SelectedOption == "All" ? "bg-success text-white" : "bg-light text-dark")"
                   style="font-size: 0.75rem;">
                <input type="radio" class="d-none" name="itemType" id="allItems" value="All"
                       checked="@(SelectedOption == "All")"
                       @onchange="OnStockFilterChanged" />
                <i class="bi bi-list-ul fs-6 me-1"></i>
                Load All Items related Assembly
            </label>

        </div>
    </HeaderContent>
</DetailsModal>


<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Vendor")
    {
        <VendorUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
    else if (ActiveModal == "Eway")
    {
         <EwayDcListModel isDcListDetailsModelVisible=true CustId=@SubConDcOutVMs.VendorCode.Value Customer=@SubConDcOutVMs.VendorName DcType="SubConDc" OnClose="CloseModal" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if (SubConDcOutVMs.Cancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (SubConDcOutVMs.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }

            <PageHeader TitleText="@(SubConDcOutVMs.DcId > 0 ? "Update Delivery Challan" : "Create Delivery Challan")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@DuSubContractDcOutgoing" />

            <div class="card-body bg-light">
                <EditForm Model="SubConDcOutVMs" OnValidSubmit="UpsertSubConDcOut">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Correspondence Status -->
                        @if (SubConDcOutVMs.DcId > 0 && !string.IsNullOrWhiteSpace(SubConDcOutVMs.DcNo))
                        {
                            <CorrespondenceStatus ReferenceType=@ScreenName
                                                  ReferenceId="@SubConDcOutVMs.DcId"
                                                  ReferenceTypeName="@SubConDcOutVMs.DcNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">
                         
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                 <div class="card-header equal-card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                     <!-- Title -->
                                    <span class="fw-bold fs-6 mb-0">Customer Information</span>
                                    <!-- Right Section -->
                                    <div class="d-flex align-items-center gap-3">

                                       <!-- Checkbox -->
                                        @if(!SubConDcOutVMs.IsWithoutPoDc)
                                        {
                                            <div class="form-check d-flex align-items-center mb-0">
                                                <input class="form-check-input me-2 mt-0"
                                                        type="checkbox"
                                                        id="chkSameItem"
                                                        style="border:2px solid #6c757d;"
                                                        checked="@SubConDcOutVMs.IsOutItemSameAsInItem"
                                                        @onchange="OnSameItemChanged"
                                                        disabled="@(SubConDcOutVMs.DcId > 0 || (SubConDcOutVMs.SubConDcOutSubVMs?.Any(x => (x.ItemId ?? 0) > 0) ?? false))">

                                                <label class="form-check-label small mb-0" for="chkSameItem">
                                                    Out Item Same as In Item
                                                </label>
                                            </div>                                   
                                        }
        
                                       <button type="button" class="btn btn-sm btn-success rounded-3"
                                             @onclick='() => OpenModal("Vendor")'>
                                        <i class="bi bi-person-add me-1"></i> Add Vendor
                                    </button>

                                    </div>
                                </div>


                                <div class="card-body">
                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                              <MudAutocomplete T="VendorVM"
                                              Value="SelectedVendor"
                                              ValueChanged="@(async c => await OnVendorChanged(c))"
                                              ToStringFunc="@(c => c?.VendorName ?? string.Empty)"
                                              SearchFunc="SearchVendors"
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Placeholder="Search Vendor"
                                              Title="Search atleast 3 letters in Vendor"
                                              Class="w-100 autocomplete-sm"
                                              MaxItems="50"
                                              Clearable="true"
                                              ResetValueOnEmptyText="true"
                                              Required="true"
                                              AvoidSubmit="true"
                                              Disabled="@IsSomeItemsTransMade" />
                                        </div>
                                    </div>

                                    <!-- Mode Of Transport -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Mode Of Transport</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputSelect @bind-Value="SubConDcOutVMs.ModeOfTransportId"
                                                         class="form-select form-select-sm rounded-3 w-100">

                                                <option value="">--Select Mode Of Transport--</option>
                                                <option value="1">By Road</option>
                                                <option value="2">By Railway</option>
                                                <option value="3">By Airway</option>
                                                <option value="4">By Seaway</option>

                                            </InputSelect>

                                            <ValidationMessage For="@(() => SubConDcOutVMs.ModeOfTransportId)" />

                                        </div>
                                    </div>

                                    <!-- Vehicle No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Vehicle No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="SubConDcOutVMs.VehicleNo" />
                                            <ValidationMessage For="@(() => SubConDcOutVMs.VehicleNo)" />
                                        </div>
                                    </div>

                                    <!-- Transport From -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Transport From</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="SubConDcOutVMs.TransFrom" />
                                            <ValidationMessage For="@(() => SubConDcOutVMs.TransFrom)" />
                                        </div>
                                    </div>
                                    <!-- Transport TO -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Transport To</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="SubConDcOutVMs.TransTo" />
                                            <ValidationMessage For="@(() => SubConDcOutVMs.TransTo)" />
                                        </div>
                                    </div>

                                                         
                                    <!-- Sub Supply Type -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Sub Supply Type</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputSelect @bind-Value="SubConDcOutVMs.SubSupplyType"
                                                         class="form-select form-select-sm rounded-3 w-100">
                                                <option value="0">-- Select Sub Supply Type --</option>
                                                <option value="4">JobWork</option>
                                                <option value="5">ForOwnUse</option>
                                                <option value="8">Others</option>
                                            </InputSelect>
                                            <ValidationMessage For="@(() => SubConDcOutVMs.SubSupplyType)" />

                                        </div>
                                    </div>

                                @if (SubConDcOutVMs.SubSupplyType == 8)
                                {
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Description for Others*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="2"
                                                        @bind="SubConDcOutVMs.SubSupplyDesc"
                                                        placeholder="Please specify the sub supply type..."></textarea>
                                            <ValidationMessage For="@(() => SubConDcOutVMs.SubSupplyDesc)" class="text-danger small" />
                                        </div>
                                    </div>
                                }

                                <div class="accordion mb-3" id="transportAccordion">
                                    <div class="accordion-item border-0 shadow-sm rounded-3">

                                        <!-- Accordion Header -->
                                        <h2 class="accordion-header" id="headingTransport">
                                            <button class="accordion-button collapsed fw-semibold"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapseTransport"
                                                    aria-expanded="false"
                                                    aria-controls="collapseTransport">
                                                Transport And E-Way Bill Details
                                            </button>
                                        </h2>

                                        <!-- Accordion Body -->
                                        <div id="collapseTransport"
                                             class="accordion-collapse collapse"
                                             aria-labelledby="headingTransport"
                                             data-bs-parent="#transportAccordion">

                                            <div class="accordion-body p-3">

                                                <!-- Transport ID -->
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>Transport ID</small>
                                                    </label>
                                                    <div class="col-12 col-sm-9">
                                                        <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                   @bind-Value="SubConDcOutVMs.EwayTransId" />
                                                        <ValidationMessage For="@(() => SubConDcOutVMs.EwayTransId)" />
                                                    </div>
                                                </div>

                                                <!-- Transport Doc No -->
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>Transport Doc No.</small>
                                                    </label>
                                                    <div class="col-12 col-sm-9">
                                                        <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                   @bind-Value="SubConDcOutVMs.EwayTransDocNo" />
                                                        <ValidationMessage For="@(() => SubConDcOutVMs.EwayTransDocNo)" />
                                                    </div>
                                                </div>

                                                <!-- Transport Name -->
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>Transport Name</small>
                                                    </label>
                                                    <div class="col-12 col-sm-9">
                                                        <InputText class="form-control form-control-sm rounded-3 w-100"
                                                                   @bind-Value="SubConDcOutVMs.EwayTransName" />
                                                        <ValidationMessage For="@(() => SubConDcOutVMs.EwayTransName)" />
                                                    </div>
                                                </div>

                                                <!-- E-Way Bill No -->
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>E-Way Bill No</small>
                                                    </label>
                                                    <div class="col-12 col-sm-9">
                                                        <input type="text"
                                                               class="form-control form-control-sm rounded-3 w-100"
                                                               @bind="SubConDcOutVMs.EwayBillNumber"
                                                                />
                                                    </div>
                                                </div>

                                                <!-- E-Way Bill Date -->
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>E-Way Bill Date</small>
                                                    </label>
                                                    <div class="col-12 col-sm-9">
                                                        <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                                   @bind-Value="SubConDcOutVMs.EwayBillDate"
                                                                    />
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                </div>
                            </div>
                        </div>


                        <!-- =================== Dc Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">

                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Delivery Challan Outgoing Details</span>

                                    @if (SubConDcOutVMs.DcId > 0 && (CanCreate || CanEdit))
                                    {
                                        <div class="d-flex gap-2">

                                            <button type="button"
                                                    class="btn btn-sm rounded-3 @(SubConDcOutVMs.Cancel ? "btn-success" : "btn-danger")"
                                                    @onclick="Cancel">

                                                @if (!SubConDcOutVMs.Cancel)
                                                {
                                                    <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                                }
                                            </button>

                                            <!-- Short Close / Re-Open -->
                                            <button type="button"
                                                class="btn btn-sm rounded-3 @(SubConDcOutVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                @onclick="() => AskToShortCloseAsync(SubConDcOutVMs)"
                                                disabled="@SubConDcOutVMs.Cancel">

                                                @if (!SubConDcOutVMs.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Close</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>

                                        </div>
                                    }
                                </div>

                                <div class="card-body">

                                    <div class="mb-2 row g-2">

                                        @if (SubConDcOutVMs.SubConDcOutSubVMs.Any(x => x.RefPoSubId.HasValue))
                                        {
                                            <!-- Manual Material Out -->
                                            <div class="col-12 col-sm-6 col-md-4">
                                                <div class="form-check form-switch d-flex align-items-center">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           id="IsManualMaterialOut"
                                                           checked="@SubConDcOutVMs.IsManualMaterialOut"
                                                           @onchange="ToggleManualMaterialOut"
                                                           disabled="@(SubConDcOutVMs.IsManualMaterialOut 
                                                                        && (SubConDcOutVMs.DcId > 0 
                                                                        || SubConDcOutVMs.SubConDcOutSubVMs?.Any(x => x.ItemId.HasValue) == true))"/>
                                                    <label class="form-check-label ms-2 fw-semibold" for="IsManualMaterialOut">
                                                        Manual Material Out
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Without PO DC -->
                                            <div class="col-12 col-sm-6 col-md-4">
                                                <div class="form-check form-switch d-flex align-items-center">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           id="IsWithoutPoDc"
                                                           checked="@SubConDcOutVMs.IsWithoutPoDc"
                                                           @onchange="ToggleDc"
                                                           disabled="@(SubConDcOutVMs.DcId > 0)" />
                                                    <label class="form-check-label ms-2 fw-semibold" for="IsWithoutPoDc">
                                                        Without Purchase Order
                                                    </label>
                                                </div>
                                            </div>

                                            <!-- Purchase Rework -->
                                            <div class="col-12 col-sm-6 col-md-4">
                                                <div class="form-check form-switch d-flex align-items-center">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           id="IsPurchaseRework"
                                                           checked="@SubConDcOutVMs.IsPurchaseRework"
                                                           @onchange="TogglePurchRework"
                                                           disabled="@(SubConDcOutVMs.DcId > 0)" />
                                                    <label class="form-check-label ms-2 fw-semibold" for="IsPurchaseRework">
                                                        Is Purchase Rework
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>


                                    <!-- Dc No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Dc No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm flex-wrap w-100">
                                                <input type="text"
                                                       class="form-control form-control-sm rounded-start"
                                                       placeholder="Prefix"
                                                       maxlength="10"
                                                       @bind="SubConDcOutVMs.Prefix" />

                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="Dc No."
                                                       @bind="SubConDcOutVMs.DcNo"/>

                                                <span class="input-group-text rounded-end">@SubConDcOutVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => SubConDcOutVMs.Prefix)" />
                                            <ValidationMessage For="@(() => SubConDcOutVMs.DcNo)" />
                                            <ValidationMessage For="@(() => SubConDcOutVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- Dc Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>DC Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                @bind-Value="@SubConDcOutVMs.DcDate" />
                                            <ValidationMessage For="@(() => SubConDcOutVMs.DcDate)" />
                                        </div>
                                    </div>

                                    @if (!SubConDcOutVMs.IsWithoutPoDc)
                                    {
                                        <div class="mb-2 row align-items-center g-2">

                                            <!-- Label -->
                                            <label class="col-12 col-md-3 col-form-label text-dark">
                                                <small>References</small>
                                            </label>

                                            <div class="col-12 col-md-9">
                                                <div class="row g-2">

                                                    @* ===== Normal Flow ===== *@
                                                    @if (!SubConDcOutVMs.IsPurchaseRework)
                                                    {
                                                        @if (poPendingCount > 0)
                                                        {
                                                            <div class="col-12 col-sm-6">
                                                                <button type="button"
                                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center rounded-3"
                                                                        @onclick="ShowPoDetails">
                                                                    <i class="bi bi-list-ul me-1"></i> PO Details
                                                                </button>
                                                            </div>
                                                        }

                                                        @if (rcPendingCount > 0)
                                                        {
                                                            <div class="col-12 col-sm-6">
                                                                <button type="button"
                                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center rounded-3"
                                                                        @onclick="ShowRcDetails">
                                                                    <i class="bi bi-list-ul me-1"></i> Route Card Details
                                                                </button>
                                                            </div>
                                                        }
                                                    }

                                                    @* ===== Purchase Rework Flow ===== *@
                                                    else if (poPendingCount > 0)
                                                    {
                                                        <div class="col-12 col-sm-6">
                                                            <button type="button"
                                                                    class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center rounded-3"
                                                                    @onclick="ShowPurchaseReworkDetails">
                                                                <i class="bi bi-list-ul me-1"></i> Purchase Rework Details
                                                            </button>
                                                        </div>
                                                    }

                                                </div>
                                            </div>
                                        </div>
                                    }


                                    <!-- Issue From Store -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issue From Store</small>
                                        </label>

                                        <div class="col-12 col-sm-9">
                                            <select value="@SubConDcOutVMs.StoreIssId"
                                                    class="form-select form-select-sm rounded-3 w-100"
                                                    id="SubConDcOut"  @onchange="OnStoreChanged"
                                                    disabled="@(DcId.GetValueOrDefault() > 0)">
            
                                                <option value="0">--Select Store--</option>

                                                @foreach (var storeid in stores)
                                                {
                                                    <option value="@storeid.StoreId">@storeid.StoreName</option>
                                                }
                                            </select>

                                            <ValidationMessage For="@(() => SubConDcOutVMs.StoreIssId)" />
                                        </div>
                                    </div>


                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="SubConDcOutVMs.MainRemarks"></textarea>
                                            <ValidationMessage For="@(() => SubConDcOutVMs.MainRemarks)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>


                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1"
                                 style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0"
                                               style="table-layout: fixed; min-width: 1300px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:80px;">Group</th>
                                                    <th style="width:100px;">Trans Type</th>
                                                    <th style="width:200px;">Item-Code</th>
                                                    <th style="width:200px;">Item Name</th>
                                                    <th style="width:70px;">UOM</th>
                                                    <th style="width:130px;">Qty</th>
                                                    <th style="width:130px;">Unit Price</th>
                                                    <th style="width:90px;">Bal Qty</th>
                                                    <th style="width:90px;">Stock Qty</th>

                                                    <th style="width:120px;">Batch No</th>
                                                    <th style="width:120px;">Heat No</th>

                                                    @if(SubConDcOutVMs.SubConDcOutSubVMs.Any(x => x.RefPoSubId > 0))
                                                    {
                                                        <th style="width:90px;">Ref. PO No</th>
                                                        <th style="width:90px;">Ref. PO Dt.</th>
                                                    }
                                                    @if(SubConDcOutVMs.SubConDcOutSubVMs.Any(x => x.RcSubId > 0))
                                                    {
                                                        <th style="width:90px;">RC No.</th>
                                                        <th style="width:90px;">RC Dt.</th>
                                                        <th style="width:130px;">Process</th>
                                                    }

                                                    <th style="width:200px;">Remarks</th>

                                                    <th style="width:120px;">Cost Center</th>

                                                    @if (!SubConDcOutVMs.Cancel && (DcId.GetValueOrDefault() > 0))
                                                    {
                                                        <th style="width:130px;">Item Cancel</th>
                                                        <th style="width:160px;">Cancel Reason</th>
                                                    }
                                                    @if (!SubConDcOutVMs.Cancel && !SubConDcOutVMs.ShortClose)
                                                    {
                                                        <th style="width:130px;" class="freeze-last-col text-end">Action</th>
                                                    }
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @if (SubConDcOutVMs.SubConDcOutSubVMs?.Any() == true)
                                                {
                                                    @foreach (var subitem in SubConDcOutVMs.SubConDcOutSubVMs)
                                                    {
                                                        if (subitem.TransType == "Out" && SubConDcOutVMs.IsOutItemSameAsInItem && !SubConDcOutVMs.IsWithoutPoDc)
                                                        {
                                                            continue;
                                                        }

                                                        <tr @key="subitem"
                                                            class="@(StockErrorSlNos.Contains(subitem.SlNo) ? "table-danger" : "")">

                                                            @if(!SubConDcOutVMs.IsOutItemSameAsInItem)
                                                             {
                                                             <td>@subitem.SlNo</td>
                                                             }
                                                             else
                                                             {
                                                                 <td>@GetDisplaySlNo(subitem)</td>
                                                             }

                                                              <td>@subitem.GroupId</td>

                                                           @if ((subitem.RefPoSubId == 0 || subitem.RefPoSubId == null) && subitem.IsEditable)
                                                             {
                                                                 <td style="width:120px;">
                                                                     <select class="form-select form-select-sm"
                                                                             @bind="subitem.TransType"
                                                                             @bind:after="() => OnTransTypeChanged(subitem)">

                                                                         @if (SubConDcOutVMs.IsWithoutPoDc)
                                                                         {
                                                                             <option value="Out">Out</option>
                                                                             <option value="In">In</option>
                                                                         }
                                                                         else
                                                                         {
                                                                           <option value="Out">Out</option>
                                                                              <option value="In">In</option>
                                                                         }

                                                                     </select>
                                                                 </td>
                                                             }
                                                             else
                                                             {
                                                                 <td style="width:120px;">
                                                                     @subitem.TransType
                                                                 </td>
                                                             }


                                                            <td>
                                                                <div class="row g-1 align-items-center">
                                                                    <div class="col-10">
                                                                        @if (subitem.IsEditable
                                                                           && (subitem.RefPoSubId == null || subitem.TransType=="Out")
                                                                            && subitem.RcSubId == null
                                                                            && subitem.Qty.GetValueOrDefault() == subitem.BalQty.GetValueOrDefault())
                                                                        {
                                                                            <MudAutocomplete T="ItemVM"
                                                                                Value="subitem.SelectedItem"
                                                                                ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                SearchFunc="SearchItems"
                                                                                Dense="true"
                                                                                Variant="Variant.Outlined"
                                                                                Placeholder="Search Item Code"
                                                                                Title="Search at least 3 letters in Item Code"
                                                                                Class="w-100 autocomplete-sm"
                                                                                MaxItems="50" />
                                                                            <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@subitem.ItemCode</span>
                                                                        }
                                                                    </div>

                                                                    <div class="col-2 text-center">
                                                                        @if (subitem.ItemId is > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count)
                                                                            && count > 0)
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                           Size="Size.Small"
                                                                                           Color="Color.Primary"
                                                                                           Edge="Edge.End"
                                                                                           Title="@($"This Item has {count} attachment(s). Click to view.")"
                                                                                           OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))" />
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </td>

                                                            <td>@subitem.ItemName</td>
                                                            <td>@subitem.MeasureUnit</td>
                                                            
                                                            <td>
                                                                @* @if (subitem.IsEditable && CanEditQty(subitem)) *@
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Qty"
                                                                           title="Enter Quantity"
                                                                           step="any"
                                                                           @bind="subitem.Qty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                    <ValidationMessage For="@(() => subitem.Qty)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.Qty
                                                                }
                                                            </td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Unit Price"
                                                                           step="any"
                                                                           title="Enter Unit Price"
                                                                           @bind="subitem.UnitPrice" />
                                                                    <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.UnitPrice
                                                                }
                                                            </td>

                                                            <td>@subitem.BalQty</td>

                                                            <td class="text-danger fw-bold">@subitem.StockQty</td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputText @bind-Value="subitem.BatchNo"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="BatchNo" />
                                                                    <ValidationMessage For="@(() => subitem.BatchNo)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.BatchNo
                                                                }
                                                            </td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputText @bind-Value="subitem.HeatNo"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="HeatNo" />
                                                                    <ValidationMessage For="@(() => subitem.HeatNo)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.HeatNo
                                                                }
                                                            </td>

                                                            @if(SubConDcOutVMs.SubConDcOutSubVMs.Any(x => x.RefPoSubId > 0))
                                                            {
                                                                <td>
                                                                    @subitem.RefPoNo
                                                                </td>
                                                                <td>
                                                                    @(subitem.RefPoDate?.ToString("dd/MM/yyyy") ?? "-")
                                                                </td>
                                                            }
                                                            @if(SubConDcOutVMs.SubConDcOutSubVMs.Any(x => x.RcSubId > 0))
                                                            {
                                                                <td>
                                                                    @subitem.RefRcNo
                                                                </td>

                                                                <td>
                                                                    @(subitem.RefRcDate?.ToString("dd/MM/yyyy") ?? "-")
                                                                </td>

                                                                <td>
                                                                    @subitem.ProcessName
                                                                </td>

                                                            }

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputTextArea @bind-Value="subitem.Remark"
                                                                               class="form-control form-control-sm"
                                                                               rows ="1"
                                                                               placeholder="Enter Remarks" />
                                                                    <ValidationMessage For="@(() => subitem.Remark)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.Remark
                                                                }
                                                            </td>

                                                            <td>@subitem.ProjectNo</td>

                                                            @if (!SubConDcOutVMs.Cancel  && (DcId.GetValueOrDefault() > 0))
                                                            {
                                                                <td class="text-center align-middle">
                                                                    
                                                                    <div class="form-check form-switch d-flex justify-content-center">
                                                                        <InputCheckbox 
                                                                            @bind-Value="subitem.ItemCancel"
                                                                            @bind-Value:event="onchange"
                                                                            ValueChanged="@(async (value) => await OnItemCancelChanged(subitem))"
                                                                            class="form-check-input border border-2 shadow-lg focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                                    </div>
                                                                    <ValidationMessage For="@(() => subitem.ItemCancel)" />
                                                                    
                                                                </td>

                                                                <td>
                                                                    @subitem.ItemCancelReason 
                                                                </td>
                                                            }

                                                            <!-- Action Buttons -->
                                                            @if (!SubConDcOutVMs.Cancel && !SubConDcOutVMs.ShortClose)
                                                            {
                                                                <td class="position-sticky end-0 bg-light text-end">

                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <button type="button"
                                                                                class="btn btn-success btn-sm me-1"
                                                                                title="Save"
                                                                                @onclick="async () => await SaveRow(subitem)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-check-lg"></i>
                                                                        </button>

                                                                        <button type="button"
                                                                                class="btn btn-secondary btn-sm"
                                                                                title="Cancel"
                                                                                @onclick="async () => await CancelEdit(subitem, SubConDcOutVMs)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-x-lg"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button"
                                                                                class="btn btn-primary btn-sm me-1"
                                                                                title="Edit"
                                                                                @onclick="async () => await EditRowAsync(subitem)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>

                                                                        <button type="button"
                                                                                class="btn btn-danger btn-sm"
                                                                                title="Delete"
                                                                                @onclick="async () => await RemoveRow(subitem)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    }

                                                                    @if(subitem.TransType =="In" )
                                                                    {
                                                                        <button type="button"
                                                                                class="btn btn-info btn-icon btn-sm"
                                                                                title="Add to Group"
                                                                                @onclick="async () => await AddToGroup(subitem)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-plus-lg"></i>
                                                                        </button>
                                                                    }

                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="11" style="height:150px;" class="text-center align-middle text-muted fs-6 fw-semibold">
                                                            <div class="d-flex justify-content-center align-items-center" style="min-height:100px;">
                                                                <i class="bi bi-info-circle me-2 text-secondary"></i>
                                                                No items to display
                                                            </div>
                                                        </td>
                                                    </tr>

                                                }
                                            </tbody>

                                            @if (SubConDcOutVMs.SubConDcOutSubVMs?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark fw-bold">
                                                    <tr>
                                                        <td colspan="5" class="text-end">Totals:</td>

                                                        <td>
                                                            @(SubConDcOutVMs?.SubConDcOutSubVMs?
                                                                .Sum(x => x.Qty ?? 0).ToString("F3") ?? "0.000")
                                                        </td>

                                                        <td>
                                                            Avg:
                                                            @(SubConDcOutVMs?.SubConDcOutSubVMs != null 
                                                                && SubConDcOutVMs.SubConDcOutSubVMs.Any()
                                                                ? SubConDcOutVMs.SubConDcOutSubVMs
                                                                    .Average(x => x.UnitPrice ?? 0).ToString("F3")
                                                                : "0.000")
                                                        </td>

                                                        <td>
                                                            @(SubConDcOutVMs?.SubConDcOutSubVMs?
                                                                .Sum(x => x.BalQty ?? 0).ToString("F3") ?? "0.000")
                                                        </td>

                                                        <td>
                                                            @(SubConDcOutVMs?.SubConDcOutSubVMs?
                                                                .Sum(x => x.StockQty ?? 0).ToString("F3") ?? "0.000")
                                                        </td>

                                                        @if(SubConDcOutVMs?.SubConDcOutSubVMs?.Any(x => x.RefPoSubId > 0) == true)
                                                        {
                                                            <td colspan="9"></td>
                                                        }
                                                        else if(SubConDcOutVMs?.SubConDcOutSubVMs?.Any(x => x.RcSubId > 0) == true)
                                                        {
                                                            <td colspan="12"></td>
                                                        }

                                                        <td colspan="8"></td>
                                                    </tr>
                                                </tfoot>

                                            }
                                        </table>
                                    </div>

                                    @if(SubConDcOutVMs.IsWithoutPoDc || SubConDcOutVMs.IsManualMaterialOut)
                                    {
                                        <div class="mt-2 text-start">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        @if (SubConDcOutVMs.DcId > 0)
                        {
                            <!-- Top Blue Line -->
                            <hr class="border-1 border-primary mt-2 mb-1 opacity-100" />
                            <div class="row g-3 mb-1 mt-1 align-items-end">
                                <!-- Created By -->
                                <div class="col-12 col-lg-3 mb-0 pb-0">
                                    <div class="form-floating mb-0 pb-0">
                                        <InputText @bind-Value="SubConDcOutVMs.CreatedBy"
                                                   id="CreatedBy"
                                                   class="form-control bg-light"
                                                   placeholder="Created By"
                                                   disabled />
                                        <label for="CreatedBy">Created By</label>
                                    </div>
                                </div>

                                <!-- Created Date -->
                                <div class="col-12 col-lg-3 mb-0 pb-0">
                                    <div class="form-floating mb-0 pb-0">
                                        <input class="form-control bg-light"
                                               id="CreatedDate"
                                               placeholder="Created Date"
                                               value="@SubConDcOutVMs.CreatedDate.ToString("dd/MM/yyyy ")"
                                               disabled />
                                        <label for="CreatedDate">Created Date</label>
                                    </div>
                                </div>

                                <!-- Modified By -->
                                <div class="col-12 col-lg-3 mb-0 pb-0">
                                    <div class="form-floating mb-0 pb-0">
                                        <InputText @bind-Value="SubConDcOutVMs.ModifiedBy"
                                                   id="ModifiedBy"
                                                   class="form-control bg-light"
                                                   placeholder="Modified By"
                                                   disabled />
                                        <label for="ModifiedBy">Modified By</label>
                                    </div>
                                </div>

                                <!-- Modified Date -->
                                <div class="col-12 col-lg-3 mb-0 pb-0">
                                    <div class="form-floating mb-0 pb-0">
                                        <input class="form-control bg-light"
                                               id="ModifiedDate"
                                               placeholder="Modified Date"
                                               value="@SubConDcOutVMs.ModifiedDate"
                                               disabled />
                                        <label for="ModifiedDate">Modified Date</label>
                                    </div>
                                </div>

                            </div>
                            <!-- Bottom Blue Line -->
                            <hr class="border-1 border-primary mt-1 mb-0 opacity-100" />
                        }

                        <div class="row g-3">
                            <!-- Action Buttons -->
                            @if (CanCreate || CanEdit)
                            {
                                <div class="col-4 col-md-3 mt-3">
                                    <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                        <i class="bi bi-floppy2-fill me-1"></i> @(SubConDcOutVMs.DcId > 0 ? "Update" : "Create")
                                    </button>
                                </div>
                            }

                            
                            @if(SubConDcOutVMs.DcId>0 && string.IsNullOrEmpty(SubConDcOutVMs.EwayBillNumber))
                            {
                                 <div class="col-4 col-md-3 mt-3">
                                    <button type="button" class="btn  btn-success w-100 rounded-3 rounded-3" @onclick='() => OpenModal("Eway")'>
                                        <i class="bi bi-person-add me-1"></i> E-Way
                                    </button>
                            
                                 </div>
                            }

                            <div class="col-4 col-md-3 mt-3">
                                <SmartBackButton Url="/subConDcOutList" />
                            </div>

                            @if (CanCreate || CanEdit && DcId > 0)
                            {
                                <div class="col-12 col-md-3">
                                    <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                        <i class="bi bi-printer me-1"></i>Print
                                    </button>
                                </div>
                            }

                        </div>

                    </div>

                </EditForm>
            </div>
        </div>
    </div>
}


@code
{

    #region Parameters & Properties

    protected override string ScreenName => "Sub-Contract DC-Out";

    [Parameter] public int? DcId { get; set; }
    [Parameter] public int VendorCode { get; set; }

    private bool isProcessing = false;
    private int screenCode { get; set; }

    private SubConDcOutVM SubConDcOutVMs { get; set; } = new();
    private SubConDcOutSubVM? rowToDelete;
    private SubConDcOutSubVM? rowToCancel;

    private const int QTY_DECIMAL = 3;
    private int rcPendingCount = 0;
    string? pdfBase64;

    private VendorVM? SelectedVendor;
    private List<VendorContact> contactPersons = new();
    private List<VendorInDirect> consineeAddress = new();
    private List<CostCenterVM> CostCenterVMs = new();
    private bool IsSomeItemsTransMade { get; set; } = false;

    private CustomerVM? SelectedCustomer;
    private List<Store> stores = new();

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private bool IsPoModalVisible = false;
    private List<Dictionary<string, object>>? PoData;

    private Dictionary<int, int> attachmentCountsOut = new Dictionary<int, int>();

    private HashSet<int> StockErrorSlNos = new();
    private int poPendingCount = 0;

    #region PO-Model

    private List<string> PoColumns = new()
    {
        "PoSubId","PoId", "IsOpenPo","Trans Type","Po No", "Po Date","ItemId",
        "Item Code", "Item Name", "UOM", "Qty", "Bal Qty", "Unit Price","Stock Qty", "Po Due Date","CostCenterId","Project No", "Remark"
    };

    private List<string> PoFields = new()
    {
        "PoSubId","PoId", "IsOpenPo", "TransType", "PoNo", "PoDate","ItemId",
        "ItemCode", "ItemName", "UOM", "Qty", "BalQty", "UnitPrice", "StockQty", "PoDuedate","CostCenterId", "ProjectNo", "Remark"
    };

    private List<string> PoHiddenColumns = new()
    {
        "PoSubId", "PoId", "ItemId", "CostCenterId"
    };

    #endregion

    #region Route-Card Model

    private string SelectedOption = "Stock";
    private bool IsRcModalVisible = false;
    private List<Dictionary<string, object>> RcData = new();
    private List<Dictionary<string, object>> AllRcData = new();

    private List<string> RcColumns = new()
    {
        "PoSubId","Has Po","PO NO.","PO Date",
        "RcId","RcSubId","Ref RC No","Ref RC Date",
        "ItemIdIn","Item Code In","Item Name In","MeasureUnit","Qty In",
        "ItemIdOut","Item Code Out","Item Name Out","MeasureUnit",
        "StockQty","Unit Price",
        "ProcessId","Process Name",
        "Qty Out","Process Cost",
        "CostCenterId","Cost Center"
    };

    private List<string> RcFields = new()
    {
        "PoSubId","HasPo","PoNo","PoDate",
        "RcId","RcSubId","RefRCNo","RefRCDate",
        "ItemIdIn","ItemCodeIn","ItemNameIn","MeasureUnitIn","QtyIn",
        "ItemIdOut","ItemCodeOut","ItemNameOut","MeasureUnitOut",
        "StockQty","UnitPrice",
        "ProcessId","ProcessName",
        "QtyOut","ProcessCost",
        "CostCenterId","CostCenter"
    };

    private List<string> RcHiddenColumns = new()
    {
        "PoSubId",
        "RcId","RcSubId",
        "ItemIdIn","ItemIdOut",
        "ProcessId",
        "CostCenterId"
    };

    #endregion


    private List<PageHeader.BreadcrumbItem> DuSubContractDcOutgoing = new()
    {
        new PageHeader.BreadcrumbItem { Text = "OutSourcing" },
        new PageHeader.BreadcrumbItem { Text = "Sub Contract" },
        new PageHeader.BreadcrumbItem { Text = "Delivery Challan", IsLast = true }
    };

    private int DecimalPlaces { get; set; } = 2;
    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    #endregion

    private string FormatCurrency(decimal? value)
    {
        return value?.ToString("C2") ?? "₹0.00";
    }

    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            rcPendingCount = await subConDcOutService.GetPendingRcCountAsync();

            DecimalPlaces = await subConDcOutService.GetDecimalPlacesAsync();
            screenCode = await subConDcOutService.GetScreenCodeByScreenNameAsync(ScreenName);
            stores = await subConDcOutService.GetAllActiveStoresAsync();

            if (DcId.HasValue)
            {
                await LoadExistingSubConDc(DcId.Value);
            }
            else
            {
                await InitializeNewSubConDc();
                SubConDcOutVMs.IsOutItemSameAsInItem = await subConDcOutService.GetIsSameItemasInAsync();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingSubConDc(int dcId)
    {
        try
        {
            SubConDcOutVMs = await subConDcOutService.GetSubConDcOutByDcIdAsync(dcId);

            if (SubConDcOutVMs == null)
            {
                await _JS.ToastrWarning("Production Issue Component not found.");
                return;
            }

            SelectedVendor = await subConDcOutService.GetVendorByIdAsync(SubConDcOutVMs.VendorCode.Value);
            if (SelectedVendor != null)
                await ApplyVendorSelectionAsync(SelectedVendor);

            foreach (var prodSub in SubConDcOutVMs.SubConDcOutSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[prodSub.ItemId.Value] =
                    await subConDcOutService.GetCorrespondenceAttachmentsCountAsync(prodSub.ItemId.Value, "Item");
            }

