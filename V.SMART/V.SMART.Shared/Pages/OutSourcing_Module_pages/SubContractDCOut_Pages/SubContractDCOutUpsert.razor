    private async Task UpsertSubConDcOut()
    {
        try
        {
            isProcessing = true;

            // Remove empty rows
            SubConDcOutVMs.SubConDcOutSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                x.Qty.GetValueOrDefault() == 0);

            if (!await ValidateRepeatedItemStock())
                return;

            if (!SubConDcOutVMs.SubConDcOutSubVMs.Any())
            {
                await _JS.ToastrError("Cannot save SubContract Dc-Out without valid items.");
                return;
            }
            if (SubConDcOutVMs.IsOutItemSameAsInItem)
            {
                var inRows = SubConDcOutVMs.SubConDcOutSubVMs
                    .Where(x => x.TransType == "In")
                    .ToList();

                foreach (var inRow in inRows)
                {
                    var outRow = SubConDcOutVMs.SubConDcOutSubVMs
                        .FirstOrDefault(x =>
                            x.TransType == "Out" &&
                            x.SlNo == inRow.SlNo + 1);

                    if (outRow != null)
                    {
                        // Keep Out row synchronized with In row
                        outRow.ItemId = inRow.ItemId;
                        outRow.Qty = inRow.Qty;
                        outRow.UnitPrice = inRow.UnitPrice;
                        outRow.BalQty = inRow.Qty;
                        outRow.RefPoSubId = inRow.RefPoSubId;
                    }
                }
            }

            bool hasIn = SubConDcOutVMs.SubConDcOutSubVMs
                .Any(x => x.TransType?.Equals("In", StringComparison.OrdinalIgnoreCase) == true);

            bool hasOut = SubConDcOutVMs.SubConDcOutSubVMs
                .Any(x => x.TransType?.Equals("Out", StringComparison.OrdinalIgnoreCase) == true);

            if (!hasIn || !hasOut)
            {
                await _JS.ToastrError("At least one IN item and one OUT item are required.");
                return;
            }

            if (SubConDcOutVMs.StoreIssId == null)
            {
                await _JS.ToastrError("Store selection is required.");
                return;
            }

            foreach (var line in SubConDcOutVMs.SubConDcOutSubVMs)
            {
                bool isValid = await ValidateRowAsync(line);
                if (!isValid) return;
            }

            bool isNew = SubConDcOutVMs.DcId == 0;

            await subConDcOutService.UpsertDeliveryChallan(SubConDcOutVMs, screenCode);

            await _JS.ToastrSuccess( isNew ? "Delivery Challan saved successfully." : "Delivery Challan updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigation.NavigateTo("/subConDcOutList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Upsert SubContract DC failed.");
            await _JS.ToastrError("Error saving Delivery Challan.");
        }
        finally
        {
            isProcessing = false;
        }
    }


