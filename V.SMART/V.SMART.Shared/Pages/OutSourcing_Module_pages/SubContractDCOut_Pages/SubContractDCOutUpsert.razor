    private async Task CancelEdit(SubConDcOutSubVM? item, SubConDcOutVM? issueCompVm)
    {
        try
        {
            if (item == null || issueCompVm == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

