    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, SubConDcOutSubVM SubVM)
    {
        try
        {
            //TransType ======== IN  =================
            if (SubVM.TransType == "In")
            {
                // 1. Validate input qty
                if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
                {
                    await _JS.ToastrWarning("Qty must be a positive number.");
                    return;
                }

                if (SubVM.DcSubId == 0)
                {
                    decimal maxAllowedQty = newQty;

                    if (SubVM.RefPoSubId > 0)
                    {
                        maxAllowedQty = await subConDcOutService.GetPurchPoItemBalQtyFromPoSubId(SubVM.RefPoSubId.Value);

                        if (newQty > maxAllowedQty)
                        {
                            await _JS.ToastrWarning($"Qty can't be greater than Purchase PO Balance Qty ({maxAllowedQty}).");
                            newQty = maxAllowedQty;
                        }
                    }
                    else if (SubVM.RcSubId > 0)
                    {
                        maxAllowedQty = await subConDcOutService.GetRouteCardSubBalQtyFromRcSubId(SubVM.RcSubId.Value);

                        if (newQty > maxAllowedQty)
                        {
                            await _JS.ToastrWarning($"Qty can't be greater than RouteCard Process Balance Qty ({maxAllowedQty}).");
                            newQty = maxAllowedQty;
                        }
                    }

                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty;
                    return;
                }

                // =========================
                // EXISTING RECORD
                // =========================
                var original = await subConDcOutService
                    .GetSubConDcOutDetailsByDcSubIdAsync(SubVM.DcSubId);

                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                // Cannot reduce below already transacted
                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.BalQty = 0;

                    await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                decimal extraAllowedQty = 0;

                if (SubVM.RefPoSubId > 0)
                {
                    extraAllowedQty = await subConDcOutService.GetPoItemBalQtyFromPoSubId(SubVM.RefPoSubId.Value);
                }
                else if (SubVM.RcSubId > 0)
                {
                    extraAllowedQty = await subConDcOutService.GetRcItemBalQtyFromRcSubId(SubVM.RcSubId.Value);
                }

                var maxAllowedQtyExisting = original.Qty + extraAllowedQty;

                if (SubVM.RefPoSubId > 0 || SubVM.RcSubId > 0)
                {
                    if (newQty > maxAllowedQtyExisting)
                    {
                        SubVM.Qty = maxAllowedQtyExisting;
                        SubVM.BalQty = maxAllowedQtyExisting - alreadyTransacted;

                        await _JS.ToastrWarning($"Qty cannot be greater than {maxAllowedQtyExisting}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted;
                }
            }

            //TransType ======== OUT  =================
            else
            {
                if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
                {
                    SubVM.Qty = 0;
                    SubVM.BalQty = 0;
                    await _JS.ToastrWarning("IssueQty must be a positive number.");
                    return;
                }

                var stockQty = SubVM.StockQty;

                if (stockQty <= 0 && SubVM.DcSubId == 0)
                {
                    SubVM.Qty = 0;
                    SubVM.BalQty = 0;
                    await _JS.ToastrError("No stock available for this item.");
                    return;
                }

                if (SubVM.DcSubId == 0)
                {
                    if (SubVM.RcSubId > 0)
                    {
                        var RcItemBalQty = await subConDcOutService
                            .GetRcItemBalQtyFromRcSubId(SubVM.RcSubId.Value);

                        var allowedQty = Math.Min(RcItemBalQty, stockQty.GetValueOrDefault());

                        if (newQty <= allowedQty)
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty;
                        }
                        else
                        {
                            SubVM.Qty = allowedQty;
                            SubVM.BalQty = allowedQty;

                            await _JS.ToastrWarning($"Issue Qty cannot exceed Route Card Qty ({RcItemBalQty}) OR Stock Qty ({stockQty}).");
                        }
                    }
                    else
                    {
                        if (newQty > stockQty)
                        {
                            SubVM.Qty = stockQty;
                            SubVM.BalQty = stockQty;
                            await _JS.ToastrWarning($"Issue Qty cannot exceed Stock Qty ({stockQty}).");
                        }
                        else
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty;
                        }
                    }
                }
                else
                {
                    var original = await subConDcOutService.GetSubConDcOutDetailsByDcSubIdAsync(SubVM.DcSubId);
                    if (original == null) return;

                    var alreadyTransacted = original.Qty - original.BalQty;

                    var effectiveStock = (stockQty + original.Qty);

                    if (newQty < alreadyTransacted)
                    {
                        SubVM.Qty = alreadyTransacted;
                        SubVM.BalQty = 0;
                        await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return;
                    }

                    if (SubVM.RcSubId > 0)
                    {
                        var RcItemBalQty = await subConDcOutService
                            .GetRcItemBalQtyFromRcSubId(SubVM.RcSubId.Value);

                        var maxAllowedQty = original.Qty + RcItemBalQty;

                        var allowedQty = Math.Min(maxAllowedQty.GetValueOrDefault(), effectiveStock.GetValueOrDefault());

                        if (newQty > allowedQty)
                        {
                            SubVM.Qty = allowedQty;
                            SubVM.BalQty = allowedQty - alreadyTransacted;

                            await _JS.ToastrWarning(
                                $"Issue Qty cannot exceed RouteCard Allowed Qty ({maxAllowedQty}) OR Available Stock ({effectiveStock})."
                            );
                        }
                        else
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty - alreadyTransacted;
                        }
                    }
                    else
                    {
                        var allowedQty = effectiveStock;

                        if (newQty > allowedQty)
                        {
                            SubVM.Qty = allowedQty;
                            SubVM.BalQty = allowedQty - alreadyTransacted;

                            await _JS.ToastrWarning($"Issue Qty cannot exceed Stock Qty ({effectiveStock}).");
                        }
                        else
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty - alreadyTransacted;
                        }
                    }
                }

                if(!await ValidateRepeatedItemStock())
                    return;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for IssueSubId: {SubVM?.DcSubId}");
            await _JS.ToastrError("Failed to update quantity. Please try again.");
        }
    }

