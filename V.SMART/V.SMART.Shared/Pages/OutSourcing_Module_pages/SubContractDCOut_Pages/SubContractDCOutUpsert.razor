    private async Task OnItemChanged(SubConDcOutSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItem = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.MeasureUnit = item.MeasureUnit;

                // 1️⃣ Last Unit Price
                if (subitem.ItemId.HasValue)
                {
                    var rates = await subConDcOutService
                        .GetBulkLastUnitPricesAsync(
                            new List<int> { subitem.ItemId.Value },
                            SubConDcOutVMs?.VendorCode);

                    if (rates.TryGetValue(subitem.ItemId.Value, out var rate))
                    {
                        subitem.UnitPrice = rate;
                    }
                    else
                    {
                        subitem.UnitPrice = 0;
                    }
                }

                // 2️⃣ Stock Qty (IMPORTANT)
                if (subitem.ItemId.HasValue)
                {
                    subitem.StockQty = await subConDcOutService.GetStockForItemsAsync(subitem.ItemId.Value,SubConDcOutVMs.StoreIssId.Value);
                }

                // 3️⃣ Attachments
                if (subitem.ItemId > 0)
                {
                    var count = await subConDcOutService
                        .GetCorrespondenceAttachmentsCountAsync(
                            subitem.ItemId.Value, "Item");

                    attachmentCounts[subitem.ItemId.Value] = count;
                }
            }
            else
            {
                // Reset on deselect
                subitem.SelectedItem = null;
                subitem.ItemId = null;
                subitem.ItemCode = null;
                subitem.ItemName = null;
                subitem.MeasureUnit = null;
                subitem.UnitPrice = 0;
                subitem.StockQty = 0;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,$"OnItemChanged failed for ItemId: {item?.ItemId}");
            await _JS.ToastrError("Failed to apply item selection. Please try again.");
        }
    }


