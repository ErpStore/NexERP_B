    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                SubConDcOutVMs.IsSameAsShipping = true;
                ResetShippingDefaults();
                StateHasChanged();
                return;
            }

            SubConDcOutVMs.IsSameAsShipping = false;  
            var selectedConsignee = consineeAddress
                .FirstOrDefault(c => c.AltVendorCode == selectedId);

            if (selectedConsignee == null)
                return;

            SubConDcOutVMs.ShipAddrsId = selectedConsignee.AltVendorCode;

            SubConDcOutVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltVendorAddr1, selectedConsignee.AltVendorAddr2 }
                .Where(x => !string.IsNullOrWhiteSpace(x)));

            SubConDcOutVMs.ShippingGstin = selectedConsignee.GSTNo ?? string.Empty;
            SubConDcOutVMs.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;



            StateHasChanged();

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

