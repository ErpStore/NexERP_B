                        : 0;
                  decimal stockQty1 = item.GetValueOrDefault("StockQty") != null
                      ? Convert.ToDecimal(item["StockQty"])
                      : 0;

                    // 🔥 TAKE MIN(QTY, STOCK)
                    decimal issueQty = Math.Min(qtyOut, stockQty1);

                    SubConDcOutVMs.SubConDcOutSubVMs.Add(
                        new SubConDcOutSubVM
                        {
                            TransType = "Out",
                            RcSubId = rcSubId.Value,

                            RefRcNo = item.GetValueOrDefault("RefRCNo")?.ToString() ?? "",
                            RefRcDate = item.GetValueOrDefault("RefRCDate") != null
                                ? Convert.ToDateTime(item["RefRCDate"])
                                : null,

                            ItemId = itemIdOut,
                            ItemCode = item.GetValueOrDefault("ItemCodeOut")?.ToString() ?? "",
                            ItemName = item.GetValueOrDefault("ItemNameOut")?.ToString() ?? "",
                            MeasureUnit = item.GetValueOrDefault("MeasureUnitOut")?.ToString() ?? "",

                            // ✅ FIXED HERE
                            Qty = issueQty,
                            BalQty = issueQty,

                            ProcessId = item.GetValueOrDefault("ProcessId") != null
                                ? Convert.ToInt32(item["ProcessId"])
                                : (int?)null,

                            ProcessName = item.GetValueOrDefault("ProcessName")?.ToString() ?? "",

                            MachineId = item.GetValueOrDefault("MachineId") != null
                                ? Convert.ToInt32(item["MachineId"])
                                : (int?)null,

                            MachineName = item.GetValueOrDefault("MachineName")?.ToString() ?? "",

                            UnitPrice = item.GetValueOrDefault("ProcessCost") != null
                                ? Convert.ToDecimal(item["ProcessCost"])
                                : 0,

