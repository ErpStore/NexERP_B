                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Subcontract Delivery Challan",
                    action: $"Cancelled DC No: {SubConDcOutVMs.DcNo}",
                    additionalInfo: $"Dc Id: {SubConDcOutVMs.DcId}"
