            await _JS.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(SubConDcOutSubVM item)
    {
        try
        {
            if (SubConDcOutVMs.SubConDcOutSubVMs.Count == 1 && item.DcSubId > 0)
            {
                await _JS.ToastrWarning("At least 1 row item is required.");
                return;
            }

            // New validation
            var dcItems = SubConDcOutVMs.SubConDcOutSubVMs
                    .Where(x => x.DcId == item.DcId)
                    .ToList();

            int dcCount = dcItems.Count();
            int inCount = dcItems.Count(x => x.TransType == "In");
            int outCount = dcItems.Count(x => x.TransType == "Out");

            bool isOnlyOneDc = dcCount <= 1;
            bool isOnlyOneInItem = inCount <= 1 && item.TransType == "In";
            bool isOnlyOneOutItem = outCount <= 1 && item.TransType == "Out";

            bool isExistingGRNSub = item.DcSubId > 0;

            if ((isOnlyOneDc || isOnlyOneInItem || isOnlyOneOutItem) && isExistingGRNSub)
            {
                await _JS.ToastrWarning("Cannot delete. At least one In and one Out item required.");
                return;
            }

            if (SubConDcOutVMs.Cancel)
            {
                await _JS.ToastrError("This SubContract DC is already cancelled. Row deletion is not allowed.");
                return;
            }

            if (SubConDcOutVMs.ShortClose)
            {
                await _JS.ToastrError("This SubContract DC is already short closed. Row deletion is not allowed.");
                return;
            }

            if (item.ItemCancel)
            {
                await _JS.ToastrWarning("This item has already been cancelled and cannot be removed.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if (item.ItemId == 0)
            {
                SubConDcOutVMs.SubConDcOutSubVMs.Remove(item);
                await _JS.ToastrSuccess("New item row removed successfully.");

                if (!SubConDcOutVMs.SubConDcOutSubVMs.Any())
                    SubConDcOutVMs.SubConDcOutSubVMs = new List<SubConDcOutSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";

            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for DcSubid: {item?.DcSubId}");
            await _JS.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in SubConDcOutVMs.SubConDcOutSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _JS.ToastrError("Failed to reset row serial numbers.");
        }
    }

    private async Task<bool> ValidateRepeatedItemStock()
    {
        StockErrorSlNos.Clear();

        var outItems = SubConDcOutVMs.SubConDcOutSubVMs
            .Where(x =>
                x.TransType == "Out" &&
                x.ItemId.HasValue &&
                x.Qty.HasValue &&
                x.Qty.Value > 0)
            .GroupBy(x => x.ItemId!.Value)
            .Select(g => new
            {
                ItemId = g.Key,
                TotalQty = g.Sum(x => x.Qty ?? 0),
                StockQty = g.First().StockQty ?? 0,
                SlNos = g.Select(x => x.SlNo).ToList()
            })
            .ToList();

        foreach (var item in outItems)
        {
            decimal effectiveStock = item.StockQty;

            var editedRows = SubConDcOutVMs.SubConDcOutSubVMs
                .Where(x =>
                    x.ItemId == item.ItemId &&
                    x.DcSubId > 0)
                .ToList();

            if (editedRows.Any())
            {
                decimal previouslyIssuedQtyTotal = 0;

                foreach (var row in editedRows)
                {
                    var original =await subConDcOutService.GetSubConDcOutDetailsByDcSubIdAsync(row.DcSubId);

                    if (original != null)
                    {
                        previouslyIssuedQtyTotal += original.Qty.GetValueOrDefault();
                    }
                }

                effectiveStock = item.StockQty + previouslyIssuedQtyTotal;
            }

            if (item.TotalQty > effectiveStock)
            {
                foreach (var slNo in item.SlNos)
                    StockErrorSlNos.Add(slNo);

                var slText = string.Join(", ", item.SlNos.OrderBy(x => x));

                await _JS.ToastrWarning(
                    $"Stock exceeded at row(s): {slText}. " +
                    $"Issued: {item.TotalQty}, Available: {effectiveStock}"
                );

                StateHasChanged();
                return false;
            }
        }

        StateHasChanged();
        return true;
    }



