    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (SubConDcOutVMs.SubConDcOutSubVMs == null)
            SubConDcOutVMs.SubConDcOutSubVMs = new List<SubConDcOutSubVM>();

        try
        {
            foreach (var item in selectedItems)
            {
                if (!item.TryGetValue("ItemId", out var itemObj) || itemObj == null)
                    continue;

                int itemId = Convert.ToInt32(itemObj);

                int poSubId = item.TryGetValue("PoSubId", out var ps) && ps != null
                    ? Convert.ToInt32(ps)
                    : 0;

                string categoryName = item.TryGetValue("CategoryName", out var cn)
                    ? cn?.ToString() ?? ""
                    : "";

                decimal qty = item.TryGetValue("BalQty", out var bq) &&
                              decimal.TryParse(bq?.ToString(), out var q)
                    ? q
                    : 0m;

                // Prevent duplicate selection
                if (SubConDcOutVMs.SubConDcOutSubVMs
                    .Any(x => x.ItemId == itemId && x.RefPoSubId == poSubId))
                    continue;

                // ================= IN ITEM =================
                var subVm = new SubConDcOutSubVM
                {
                    TransType = item.TryGetValue("TransType", out var tt) ? tt?.ToString() ?? "In" : "In",

                    ItemId = itemId,
                    ItemCode = item.TryGetValue("ItemCode", out var ic) ? ic?.ToString() : null,
                    ItemName = item.TryGetValue("ItemName", out var iname) ? iname?.ToString() : null,
                    MeasureUnit = item.TryGetValue("UOM", out var uom) ? uom?.ToString() : null,

                    Qty = item.TryGetValue("Qty", out var qtyObj) && qtyObj != null
                        ? Math.Round(Convert.ToDecimal(qtyObj), QTY_DECIMAL)
                        : 0m,

                    BalQty = Math.Round(qty, QTY_DECIMAL),

                    UnitPrice = item.TryGetValue("UnitPrice", out var up) && up != null
                        ? Convert.ToDecimal(up)
                        : 0m,

                    RefPoSubId = poSubId,
                    RefPoNo = item.TryGetValue("PoNo", out var pno) ? pno?.ToString() : null,
                    RefPoDate = item.TryGetValue("PoDate", out var pd) && pd != null
                        ? Convert.ToDateTime(pd)
                        : null,

                    StockQty = item.TryGetValue("StockQty", out var sq) && sq != null
                        ? Convert.ToDecimal(sq)
                        : 0m,

                    CostId = item.TryGetValue("CostCenterId", out var cc) && cc != null
                        ? Convert.ToInt32(cc)
                        : (int?)null,

                    ProjectNo = item.TryGetValue("ProjectNo", out var pj) ? pj?.ToString() : null,

                    Remark = item.TryGetValue("Remark", out var rm) ? rm?.ToString() : null,

                    IsEditable = true
                };

                SubConDcOutVMs.SubConDcOutSubVMs.Add(subVm);

                if (SubConDcOutVMs.IsOutItemSameAsInItem)
                {
                    await AddSameItemChildAsync(subVm);
                }
                // ================= ASSEMBLY / SUB-ASSEMBLY =================
                else if (categoryName == "ASSEMBLY" || categoryName == "SUB-ASSEMBLY")
                {
                    var assemblyItems = await subConDcOutService.GetAssemblyItemsAsync(itemId);

                    foreach (var assembly in assemblyItems)
                    {
                        if (!assembly.ItemId.HasValue) continue;

                        decimal stock = await subConDcOutService.GetStockForItemsAsync(
                            assembly.ItemId.Value,
                            SubConDcOutVMs.StoreIssId ?? 0);

                        var rates = await subConDcOutService.GetBulkLastUnitPricesAsync(
                            new List<int> { assembly.ItemId.Value },
                            SubConDcOutVMs?.VendorCode);

                        decimal unitRate = rates.TryGetValue(assembly.ItemId.Value, out var rate)
                            ? rate
                            : 0;

                        SubConDcOutVMs.SubConDcOutSubVMs.Add(new SubConDcOutSubVM
                        {
                            TransType = "Out",

                            SelectedItem = await subConDcOutService
                                .GetItemByItemIdAsync(assembly.ItemId.Value),

                            ItemId = assembly.ItemId,
                            ItemCode = assembly.PartItemCode,
                            ItemName = assembly.PartItemName,
                            MeasureUnit = assembly.UOM,

                            Qty = Math.Round(assembly.UtilQty.GetValueOrDefault() * qty, QTY_DECIMAL),
                            BalQty = Math.Round(assembly.UtilQty.GetValueOrDefault() * qty, QTY_DECIMAL),

                            StockQty = stock,
                            UnitPrice = unitRate,

                            IsEditable = true
                        });
                    }
                }

                // ================= COMPONENT =================
                else if (categoryName == "COMPONENT")
                {
                    var compRM = await subConDcOutService.GetDefaultRawMaterialItemAsync(itemId);

                    if (compRM != null && compRM.RMId.HasValue)
                    {
                        decimal stock = await subConDcOutService.GetStockForItemsAsync(
                            compRM.RMId.Value,
                            SubConDcOutVMs.StoreIssId ?? 0);

                        var rates = await subConDcOutService.GetBulkLastUnitPricesAsync(
                            new List<int> { compRM.RMId.Value },
                            SubConDcOutVMs?.VendorCode);

                        decimal unitRate = rates.TryGetValue(compRM.RMId.Value, out var rate)
                            ? rate
                            : 0;

                        SubConDcOutVMs.SubConDcOutSubVMs.Add(new SubConDcOutSubVM
                        {
                            TransType = "Out",

                            SelectedItem = await subConDcOutService
                                .GetItemByItemIdAsync(compRM.RMId.Value),

                            ItemId = compRM.RMId.Value,
                            ItemCode = compRM.RMCode,
                            ItemName = compRM.RMName,
                            MeasureUnit = compRM.MeasureUnit,

                            Qty = Math.Round(compRM.Weight * qty, QTY_DECIMAL),
                            BalQty = Math.Round(compRM.Weight * qty, QTY_DECIMAL),

                            StockQty = stock,
                            UnitPrice = unitRate,

                            IsEditable = true
                        });
                    }
                }
            }

            // ===== Reset Serial Numbers =====
            await ResetSlno();
            RecalculateGroupIds(); 
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected PO items.");
        }
    }

    private async Task AddSameItemChildAsync(SubConDcOutSubVM parentVm)
