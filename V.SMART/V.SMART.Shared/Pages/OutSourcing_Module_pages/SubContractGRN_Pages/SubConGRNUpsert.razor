    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)

    {
        if (SubConGRNVMs.SubConGRNSubVMs == null)
            SubConGRNVMs.SubConGRNSubVMs = new List<SubConGRNSubVM>();

        int custid = SubConGRNVMs.VendorCode.Value;

        if (SubConGRNVMs.AddStoreId == 0)
        {
            await _js.ToastrWarning("Please select Purchase Store");
            return;
        }
        int storeissueid = SubConGRNVMs.AddStoreId.Value;

        // var selectedStoreName = IssStores.FirstOrDefault(s => s.StoreId == storeid);
        var selectedDcIds =DcOuts.Where(p => p.IsSelected).Select(p => p.DcId).ToList();

        try
        {

            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            decimal Price = 0, subdiscAmt = 0, qty = 0, totqty = 0,StockQty = 0;
            int i = 0;

            if (!SubConGRNVMs.IsReturn)
            {

                foreach (var item in selectedItems)
                {
                    Price = 0; subdiscAmt = 0; qty = 0;

                    int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                        ? Convert.ToInt32(item["ItemId"])
                        : 0;

                    int? PoSubId = item.ContainsKey("PoSubId") && item["PoSubId"] != null
                        ? Convert.ToInt32(item["PoSubId"])
                        : (int?)null;

                    int? LineNo = item.ContainsKey("LineNo") && item["LineNo"] != null
                        ? Convert.ToInt32(item["LineNo"])
                        : (int?)null;
                   
                        
                    int? RefRcSubId = item.ContainsKey("RefRcSubId") && item["RefRcSubId"] != null
                        ? Convert.ToInt32(item["RefRcSubId"])
                        : (int?)null;

                    int? categorycode = item.ContainsKey("CategoryCode") && item["CategoryCode"] != null
                        ? Convert.ToInt32(item["CategoryCode"])
                        : (int?)null;

                   int? ProcessId= item.ContainsKey("ProcessId") && item["ProcessId"] != null
                        ? Convert.ToInt32(item["ProcessId"])
                        : (int?)null;

                    if (item.TryGetValue("BalQty", out var QtyObj))
                        decimal.TryParse(QtyObj?.ToString(), out qty);

                    if (item.TryGetValue("UnitPrice", out var unitpriceObj))
                        decimal.TryParse(unitpriceObj?.ToString(), out Price);

                    if (item.TryGetValue("TotalQty", out var TotalQty))
                        decimal.TryParse(TotalQty?.ToString(), out totqty);

                    if (item.TryGetValue("Stock Qty", out var stkQtyObj))
                        decimal.TryParse(stkQtyObj?.ToString(), out StockQty);

                    string suffix = item.TryGetValue("Suffix", out var Suffix) ? Suffix?.ToString() : string.Empty;

                    if (SubConGRNVMs.SubConGRNSubVMs.Any(x => x.ItemId == itemId && x.RefPoSubId == PoSubId))
                    {
                        continue;
                    }

                    var receivedData = await subConGRNService.GetSubConDcOutQtyByDcIdsAsync(selectedDcIds);

                    var ReceivedLookup = receivedData.GroupBy(x => x.ItemId).ToDictionary(g => g.Key, g => g.Sum(x => x.BalQty ?? 0));


                    selectedDCids = selectedDcIds;

                    decimal possibleQty = 0;

                    if (!SubConGRNVMs.IsManual)
                    {
                        if (categorycode == 3 || categorycode == 7)
                        {
                            var bomData = await subConGRNService.GetAssemblyItemsAsync(itemId);

                            decimal? minPossible = null;

                            foreach (var bom in bomData)
                            {

                                if (!ReceivedLookup.TryGetValue(bom.ItemId, out decimal receivedQty))
                                    continue;

                                if (bom.UtilQty <= 0)
                                    continue;

                                var possible = receivedQty / bom.UtilQty;

                                if (minPossible == null || possible < minPossible)
                                    minPossible = possible;
                            }



                            possibleQty = Math.Min(minPossible ?? 0, qty);
                        }
                        else if (categorycode == 2)
                        {
                            decimal weight = await subConGRNService.GetRawMaterialWeightAsync(itemId);

                            var compData = await subConGRNService.GetRawMaterialItemsAsync(itemId);

                            decimal? minPossible = null;

                            foreach (var com in compData)
                            {
                                if (!ReceivedLookup.TryGetValue(com.ItemId, out decimal receivedQty))
                                    continue;

                                if (com.Weight <= 0)
                                    continue;

                                var possible = receivedQty / com.Weight;

                                if (minPossible == null || possible < minPossible)
                                    minPossible = possible;
                            }
                            possibleQty = Math.Min(minPossible ?? 0, qty);


                        }

                    }
                    else
                    {
                        possibleQty = qty;

                    }
                   // var rcDetail = RcDetails.FirstOrDefault();
                    var subVm = new SubConGRNSubVM();

                    subVm.TransType = "In";
                      
                    subVm.ItemId = itemId;
                    subVm.ItemCode = item.TryGetValue("ItemCode", out var itemCode) ? itemCode?.ToString() : string.Empty;
                    subVm.ItemName = item.TryGetValue("ItemName", out var itemName) ? itemName?.ToString() : string.Empty;
                   
                    subVm.MeasureUnit = item.TryGetValue("UOM", out var uom) ? uom?.ToString() : string.Empty;
                 
                    subVm.Qty = possibleQty;
                    subVm.BalQty = possibleQty;
                    subVm.UnitPrice = Price;
                    subVm.CostId = item.TryGetValue("CostCenterId", out var costId) && int.TryParse(costId?.ToString(), out var parsedCostId) && parsedCostId != 0 ? parsedCostId : (int?)null;
                    subVm.ProjectNo = item.TryGetValue("ProjectNo", out var projectNo) ? projectNo?.ToString() : string.Empty;
                    

                    subVm.PossibleQty = possibleQty;
                    subVm.RefPoSubId = PoSubId;
                    subVm.RefRcSubId = RefRcSubId;

                    subVm.RefPoNo = item.TryGetValue("PoNo", out var PONo) ? PONo?.ToString() + "" + (PONo == null ? "" : Suffix) : string.Empty;
                   
                    subVm.RefPoDate = item.TryGetValue("PODate", out var PODate) &&
                       DateTime.TryParseExact(
                           PODate?.ToString(),
                           "dd/MM/yyyy",
                           System.Globalization.CultureInfo.InvariantCulture,
                           System.Globalization.DateTimeStyles.None,
                           out var parsedPODate)
                       ? parsedPODate
                       : DateTime.Today;
                    subVm.CategoryCode = categorycode ?? 0;

                    subVm.RefRCNo = item.TryGetValue("RCNo", out var RCNo) ? RCNo?.ToString() + "" + (RCNo == null ? "" : Suffix) : string.Empty;
                    subVm.RefRcDate = item.TryGetValue("RCDt", out var rcDateObj) &&
                                      DateTime.TryParseExact(
                                          rcDateObj?.ToString(),
                                          "dd/MM/yyyy",
                                          System.Globalization.CultureInfo.InvariantCulture,
                                          System.Globalization.DateTimeStyles.None,
                                          out var rcDate)
                                      ? rcDate
                         : DateTime.Today;
                    subVm.ProcessId = ProcessId;

                    subVm.ProcessName = item.TryGetValue("ProcessName", out var ProcessName) ? ProcessName?.ToString() : string.Empty;

                    subVm.IsEditable = true;

                    SubConGRNVMs.SubConGRNSubVMs.Add(subVm);

                }

            }
            else
            {
                selectedDCids = selectedDcIds;
            }

            var receivedDatas = selectedDCids.Any() ? await subConGRNService.GetDcSubConOutQtyByDcIdsAsync(selectedDCids) : new List<SubConDcOutSubVM>();

            var itemIdss = receivedDatas
                        .Where(x => x.ItemId.HasValue)
                            .Select(x => x.ItemId.Value)
                            .Distinct()
                            .ToList();

            // If  Manual 
            if(SubConGRNVMs.IsManual)
            {
                if (receivedDatas != null && receivedDatas.Any())
                {

                    List<SubConDcOutSubVM> receivedData;
                    receivedData = await subConGRNService.GetSubConDcOutQtyByDcIdsAsync(selectedDcIds);

                    var receivedLookup = receivedData
                        .GroupBy(x => x.ItemId)
                        .ToDictionary(g => g.Key, g => g.Sum(x => x.BalQty ?? 0));


                    foreach (var item in selectedItems)
                    {
                        int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                            ? Convert.ToInt32(item["ItemId"])
                            : 0;

                        int? poSubId = item.ContainsKey("PoSubId") && item["PoSubId"] != null
                            ? Convert.ToInt32(item["PoSubId"])
                            : (int?)null;
                        int? LineNo = item.ContainsKey("LineNo") && item["LineNo"] != null
                            ? Convert.ToInt32(item["LineNo"])
                            : (int?)null;

                        int? categoryCode = item.ContainsKey("CategoryCode") && item["CategoryCode"] != null
                            ? Convert.ToInt32(item["CategoryCode"])
                            : (int?)null;


                       int? RefRcSubId = item.ContainsKey("RefRcSubId") && item["RefRcSubId"] != null
                        ? Convert.ToInt32(item["RefRcSubId"])
                        : (int?)null;

                        List<int> allowedItemIds = new();

                        if (!SubConGRNVMs.IsReturn && RefRcSubId == null)
                        {
                            if (categoryCode == 3 || categoryCode == 7)
                            {
                                var bomData = await subConGRNService.GetAssemblyItemsAsync(itemId);

                                if (bomData.Any())
                                    allowedItemIds = bomData.Select(x => x.ItemId.Value).ToList();
                            }
                            else if (categoryCode == 2)
                            {
                                var compData = await subConGRNService.GetRawMaterialItemsAsync(itemId);

                                if (compData.Any())
                                    allowedItemIds = compData.Select(x => x.ItemId).ToList();

                            }
                        }
                        else
                        {
                            allowedItemIds.Add(itemId);
                        }

                var filteredReceived = !allowedItemIds.Any()
                    ? receivedDatas.ToList()   
                    : receivedDatas
                        .Where(r => r.ItemId.HasValue && allowedItemIds.Contains(r.ItemId.Value))
                        .ToList();



                foreach (var outItem in filteredReceived)
                {

                    if (SubConGRNVMs.SubConGRNSubVMs
                        .Any(x => x.ItemId == outItem.ItemId && x.RefDcSubId == outItem.DcSubId))
                        continue;

                        var outVm = new SubConGRNSubVM
                            {
                                RefDcSubId = outItem.DcSubId,
                                ItemId = outItem.ItemId ?? 0,
                                ItemCode = outItem.ItemCode,
                                ItemName = outItem.ItemName,
                                MeasureUnit = outItem.MeasureUnit,
                             
                                UnitPrice = outItem.UnitPrice,

                                ProjectNo = outItem.ProjectNo,
                                RefPoSubId = outItem.RefPoSubId,
                                IsEditable = false
                            };

                            if (!SubConGRNVMs.IsReturn)
                            {
                                    outVm.TransType = "Out";
                            }
                            else
                            {
                                 outVm.TransType = "In";
                            }

                            outVm.BalQty = outItem.BalQty ?? 0;
                            outVm.Qty = outItem.BalQty;
                            outVm.PossibleQty = outItem.BalQty;
                        

                    SubConGRNVMs.SubConGRNSubVMs.Add(outVm);
                }
            }
        }

    }

    int slNo = 1;
    foreach (var row in SubConGRNVMs.SubConGRNSubVMs)
    {
        row.SlNo = slNo++;
    }

    StateHasChanged();

    }
    catch (Exception ex)
    {
    await logs.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
    await _js.ToastrError("Error processing selected SCN Selected items.");
    }
