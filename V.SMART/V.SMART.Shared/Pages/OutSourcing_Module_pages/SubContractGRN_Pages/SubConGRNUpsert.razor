    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
                    await CancelDc();
                    break;

                case "ShortClose":
                    await ShortCloseLabourDcOutgoing();
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;


            var (canDelete, message) = await subConGRNService.CanRemoveSubConGRNAsync(rowToDelete.GRNId, rowToDelete.GRNSubId);
            if (!canDelete)
            {
                await _js.ToastrWarning(message);
                return;
            }

            if (rowToDelete.GRNSubId > 0)
            {
                await subConGRNService.DeleteByDcsubConIncomingSubIdAsync(rowToDelete.GRNSubId, screenCode);

                await LoadExistingSubconGRNByGRNId(SubConGRNVMs.GRNId);
            }
            else
            {
                SubConGRNVMs.SubConGRNSubVMs.Remove(rowToDelete);

                if (!SubConGRNVMs.SubConGRNSubVMs.Any())
                {
                    SubConGRNVMs.SubConGRNSubVMs.Add(new SubConGRNSubVM
                    {
                        GRNId = SubConGRNVMs.GRNId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    await ResetSlno();
                }
            }

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex,
                $"Error confirming deletion for GRNId: {SubConGRNVMs.GRNId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

    private async Task CancelDc()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!SubConGRNVMs.Cancel)
            {
                SubConGRNVMs.Cancel   = true;
                SubConGRNVMs.CancelReason = cancelReason;
                SubConGRNVMs.CancelDate = DateTime.Now;
                SubConGRNVMs.CancelBy = username;

                await subConGRNService.UpdatedCancelStatusAndAddOrRevertQtyPoWiseAync(SubConGRNVMs, screenCode);


                await logs.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "SubCon GRN",
                    action: $"Cancelled SubCon GRN No: {SubConGRNVMs.GRNNo}",
                    additionalInfo: $"SubCon DC Id: {SubConGRNVMs.GRNId}"
                );

                await _js.ToastrSuccess("SubConGRN cancelled successfully.");
            }
            else
            {
                SubConGRNVMs.Cancel = false;
                SubConGRNVMs.CancelReason = string.Empty;

                await subConGRNService.UpdatedCancelStatusAndAddOrRevertQtyPoWiseAync(SubConGRNVMs, screenCode);

                await logs.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "SubConGRN",
                    action: $"Reverted SubConGRN GRN No: {SubConGRNVMs.GRNNo}",
                    additionalInfo: $"DC Id: {SubConGRNVMs.GRNId}"
                );

                await _js.ToastrSuccess("SubConGRN has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the SubCon GRN.");
            await logs.LogDeveloperError(ex, $"CancelDc failed for DcId: {SubConGRNVMs.GRNId}");
        }
        finally
        {
            isProcessing = false;
        }
    }
