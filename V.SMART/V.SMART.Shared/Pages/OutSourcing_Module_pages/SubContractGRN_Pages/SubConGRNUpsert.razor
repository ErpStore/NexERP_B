    #region SubContract GRN Operations

    private async Task UpsertSubConGRN()
    {
        try
        {
            isProcessing = true;

            SubConGRNVMs.SubConGRNSubVMs.RemoveAll(x => !x.ItemId.HasValue || !x.Qty.HasValue || x.Qty == 0);

            if (!SubConGRNVMs.SubConGRNSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a SubContract GRN without valid items.");
                return;
            }

            foreach (var line in SubConGRNVMs.SubConGRNSubVMs)
            {
                bool isValid = await ValidateProdReturnSubAsync(line, SubConGRNVMs);
                if (!isValid) return;
            }

            // Save
            var isNewProdIsssue = SubConGRNVMs.GRNId == 0;

            try
            {
                await subConGRNService.UpsertSubConGRNAsync(SubConGRNVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewProdIsssue)
                await _js.ToastrSuccess("SubContract GRN saved successfully.");
            else
                await _js.ToastrSuccess("SubContract GRN updated successfully.");

                 // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/subConGrnList");
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "UpsertSubConGRN failed.");
            await _js.ToastrError("Error saving SubContract GRN.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateProdReturnSubAsync(SubConGRNSubVM line, SubConGRNVM productionReturnCompVM)
