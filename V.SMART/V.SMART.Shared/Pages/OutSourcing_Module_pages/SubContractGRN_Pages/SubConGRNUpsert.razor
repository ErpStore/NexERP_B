                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Return Quantity must be greater than 0.");
                return false;
            }


            if (!productionReturnCompVM.Rejection && !productionReturnCompVM.IsReturn)
            {
                if (line.GRNSubId == 0 && line.RefRcSubId > 0)
