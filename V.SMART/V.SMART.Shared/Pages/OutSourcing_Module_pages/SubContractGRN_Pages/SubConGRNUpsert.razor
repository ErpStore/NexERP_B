    private async Task OnRcSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        SubConGRNVMs.SubConGRNSubVMs ??= new();

        bool isReturnOrRejection =
            SubConGRNVMs.IsReturn || SubConGRNVMs.Rejection;

        try
        {
            // =============================
            // STEP 1: Collect all DcSubIds
            // =============================
            var dcSubIds = selectedItems
                .Where(x => x.ContainsKey("RefRcSubId") && x["RefRcSubId"] != null)
                .Select(x => Convert.ToInt32(x["RefRcSubId"]))
                .Distinct()
                .ToList();

            var issueIds = await subConGRNService
                          .GetDcIdsByRcSubIdsAsync(dcSubIds);
            // =============================
            // STEP 2: Fetch ALL issued data once
            // =============================
            // var allDcIds = await subConGRNService.GetDcIdsByDcSubIdsAsync(issueIds);

            var issuedData = issueIds.Any()
                ? await subConGRNService.GetSubConGrnSubVMsByDcIdsAsync(issueIds)
                : new List<SubConGRNSubVM>();

            var issuedLookup = issuedData
                .GroupBy(x => x.ItemId)
                .ToDictionary(g => g.Key,
                    g => Math.Truncate(g.Sum(x => x.BalQty ?? 0m) * 100) / 100m);



            foreach (var item in selectedItems)
            {
                if (!item.TryGetValue("ItemId", out var itemIdObj) || itemIdObj == null)
                    continue;

                int itemId = Convert.ToInt32(itemIdObj);

                int rcSubId = item.TryGetValue("RefRcSubId", out var rcObj) && rcObj != null
                    ? Convert.ToInt32(rcObj)
                    : 0;

                int issueSubId = item.TryGetValue("IssueSubId", out var issueObj) && issueObj != null
                    ? Convert.ToInt32(issueObj)
                    : 0;

                int CategoryCode = item.TryGetValue("CategoryCode", out var catObj) && catObj != null
                    ? Convert.ToInt32(catObj)
                    : 0;

                decimal balQty = item.TryGetValue("Qty", out var qtyObj) && qtyObj != null
                    ? Convert.ToDecimal(qtyObj)
                    : 0m;

                decimal utility = item.TryGetValue("Utility", out var utilObj) && utilObj != null
                    ? Convert.ToDecimal(utilObj)
                    : 1m;

                // avoid duplicates
                if (SubConGRNVMs.SubConGRNSubVMs
                    .Any(x => x.ItemId == itemId && x.RefRcSubId == rcSubId))
                    continue;

                decimal qty = balQty;

                // Return / Rejection qty calculation
                // if (!isReturnOrRejection && rcSubId > 0)
                // {
                //     var issueIds = await subConGRNService
                //         .GetIssueIdsByRcSubIdAsync(rcSubId);

                //     if (issueIds.Any())
                //     {
                //         var issuedData = await subConGRNService
                //             .GetSubConGrnSubVMsByDcIdsAsync(issueIds);

                //         qty = Math.Min(
                //             issuedData.Sum(x => x.BalQty ?? 0) * utility,
                //             balQty
                //         );
                //     }

                //     if (qty < 0) qty = 0;
                // }

                var subVm = new SubConGRNSubVM
                {
                    //TransType = isReturnOrRejection ? "In" : "Out",

                    TransType = "In",
                    ItemId = itemId,
                    ItemCode = item.TryGetValue("ItemCode", out var c) ? c?.ToString() : null,
                    ItemName = item.TryGetValue("ItemName", out var n) ? n?.ToString() : null,
                    MeasureUnit = item.TryGetValue("MeasureUnit", out var u) ? u?.ToString() : null,
                    CategoryCode = CategoryCode,

                    Qty = qty,
                    BalQty = balQty,
                    PossibleQty = qty,

                    UnitPrice = item.TryGetValue("UnitPrice", out var r) && r != null
                        ? Convert.ToDecimal(r)
                        : 0m,

                    RefRcSubId = rcSubId,
                    RefRCNo = item.TryGetValue("RCNo", out var rcNo) ? rcNo?.ToString() : null,
                    RefRcDate = item.TryGetValue("RCDt", out var rcDt) && rcDt != null
                        ? Convert.ToDateTime(rcDt)
                        : (DateTime?)null,

                    //Important IssueId Mapping
                    RefDcSubId = issueSubId > 0 ? issueSubId: null ,

                    RefDcNo = item.TryGetValue("IssueNo", out var inNo) ? inNo?.ToString() : null,
                    RefDCDate = item.TryGetValue("IssueDt", out var inDt) && inDt != null
                        ? Convert.ToDateTime(inDt)
                        : (DateTime?)null,

                    ProcessId = item.TryGetValue("ProcessId", out var pId) && pId != null
                        ? Convert.ToInt32(pId)
                        : (int?)null,

                    ProcessName = item.TryGetValue("ProcessName", out var pNm)
                        ? pNm?.ToString()
                        : null,

                    MachineId = item.TryGetValue("MachineId", out var mId) && mId != null
                        ? Convert.ToInt32(mId)
                        : (int?)null,

                    MachineName = item.TryGetValue("MachineName", out var mNm)
                        ? mNm?.ToString()
                        : null,

                    CostId = item.TryGetValue("CostCenterId", out var ccId) && ccId != null
                        ? Convert.ToInt32(ccId)
                        : (int?)null,

                    ProjectNo = item.TryGetValue("ProjectNo", out var prj)
                        ? prj?.ToString()
                        : null,

                    IsEditable = true
                };

                SubConGRNVMs.SubConGRNSubVMs.Add(subVm);
            }

            if (issuedData.Any())
            {
                foreach (var outItem in issuedData)
                {
                    if (SubConGRNVMs.SubConGRNSubVMs
                        .Any(x => x.ItemId == outItem.ItemId && x.RefDcSubId == outItem.RefDcSubId))
                        continue;

                    SubConGRNVMs.SubConGRNSubVMs.Add(new SubConGRNSubVM
                    {
                        TransType = "Out",
                        RefDcSubId=outItem.RefDcSubId,
                        ItemId = outItem.ItemId,
                        ItemCode = outItem.ItemCode,
                        ItemName = outItem.ItemName,
                        MeasureUnit = outItem.MeasureUnit,

                        Qty = outItem.Qty,
                        PossibleQty = outItem.BalQty,
                        UnitPrice = outItem.UnitPrice,

                        RefDcNo = outItem.RefDcNo,
                        RefDCDate = outItem.RefDCDate,

                        ProjectNo = outItem.ProjectNo,
                        Remarks = outItem.Remarks,
                        IsEditable = true
                    });
                }
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "OnRcSelectedAsync failed.");
            await _js.ToastrError("Error processing selected Route Card items.");
        }
    }

    

