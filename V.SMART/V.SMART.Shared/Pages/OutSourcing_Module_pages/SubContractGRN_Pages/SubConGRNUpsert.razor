    private async Task LoadExistingSubconGRNByGRNId(int GRNId)
    {
        try
        {
            SubConGRNVMs = await subConGRNService.GetSubcontractGRNByGRNIdAsync(GRNId);

            if (SubConGRNVMs == null)
            {
                await _js.ToastrWarning("Subcontract GRN not found.");
                return;
            }

            SelectedVendor = await subConGRNService.GetVendorByVenerCodeAsync(SubConGRNVMs.VendorCode.Value);
            if (SelectedVendor != null)
                await ApplyVendorSelectionAsync(SelectedVendor);

            // await ApplyCustomerSelectionAsync(SelectedVendor);

            bool isReturnOrRejection =
                SubConGRNVMs.IsReturn || SubConGRNVMs.Rejection;

            foreach (var sub in SubConGRNVMs.SubConGRNSubVMs)

            {
                decimal balQty = sub.BalQty ?? 0m;
                decimal? possibleQty = balQty;

                // =====================================================
                // 🔹 CASE 1: NORMAL FLOW (NOT Return / Rejection)
                // =====================================================
                if (!isReturnOrRejection && sub.RefDcSubId.HasValue && sub.RefDcSubId > 0)
                {
                    var issueIds = await subConGRNService.GetDcIdsByDcSubIdAsync(sub.RefDcSubId.Value);

                    var issuedData = issueIds.Any()
                        ? await subConGRNService.GetSubConGrnSubVMsByDcIdsAsync(issueIds)
                        : new List<SubConGRNSubVM>();

                    var issuedLookup = issuedData
                        .Where(x => x.ItemId.HasValue)
                        .ToDictionary(x => x.ItemId!.Value, x => x.BalQty ?? 0m);

                    // 🔹 Assembly / Sub-Assembly
                    if (sub.CategoryCode == 3 || sub.CategoryCode == 7)
                    {
                        var bomData = await _unitOfWork.AssmblyDefs
                            .GetQueryable()
                            .Where(x => x.AssmblyID == sub.ItemId)
                            .Select(x => new { x.ItemId, x.UtilQty })
                            .ToListAsync();

                        decimal? minPossible = null;

                        foreach (var bom in bomData)
                        {
                            issuedLookup.TryGetValue(bom.ItemId, out var issuedQty);

                            if (bom.UtilQty > 0)
                            {
                                var possible = issuedQty / bom.UtilQty;
                                minPossible = minPossible == null
                                    ? possible
                                    : Math.Min(minPossible.Value, possible);
                            }
                        }

                        possibleQty = Math.Min(minPossible ?? 0m, balQty);
                    }
                    // 🔹 Component
                    else if (sub.ItemId.HasValue)
                    {
                        if(sub.RefDcSubId>0)
                        {
                            possibleQty= await subConGRNService.GetDcOutBalQtyByDcSubId(sub.RefDcSubId??0);
                        }
                        else if(sub.RefPoSubId>0)
                        {
                            possibleQty= await subConGRNService.GetDcOutBalQtyByPoSubId(sub.RefPoSubId??0);
                        }

                        // issuedLookup.TryGetValue(sub.ItemId.Value, out var issuedQty);
                        // /possibleQty = Math.Min(issuedQty, balQty);
                        // possibleQty = issuedQty;
                    }
                }

                // =====================================================
                // 🔹 CASE 2: RETURN / REJECTION (RC-based)
                // =====================================================
                else if (!isReturnOrRejection && sub.RefRcSubId.HasValue && sub.RefRcSubId > 0)
                {
                    var issueIds = await subConGRNService.GetIssueIdsByRcSubIdAsync(sub.RefRcSubId.Value);

                    if (issueIds.Any())
                    {
                        var issuedData = await subConGRNService.GetSubConGrnSubVMsByDcIdsAsync(issueIds);
                        var rcData = await subConGRNService.GetRcDetailsByRcSubIdAsync(sub.RefRcSubId.Value);

                        if (rcData != null)
                        {
                            decimal utility =
                                rcData.SeqNo == 1
                                    ? rcData.RouteCard?.RMWeight ?? 1m
                                    : 1m;

                            possibleQty = Math.Min(
                                issuedData.Sum(x => x.BalQty ?? 0m) * utility,
                                balQty
                            );
                        }
                    }
                }
                else if (!isReturnOrRejection && sub.RefDcSubId.HasValue && sub.RefDcSubId > 0)
                {
                    decimal? issueBalQty = 0;

                    // if (sub.TransType == "In")
                    // {
                    issueBalQty = await subConGRNService
                        .GetIssueBalQtyByIssueSubId(sub.RefDcSubId.Value);
                    //}

                    possibleQty = issueBalQty.GetValueOrDefault();
                }
                // =====================================================
                // 🔹 CASE 3: DIRECT ISSUE RETURN (IssueSub based)
                // =====================================================
                else if (isReturnOrRejection && sub.RefDcSubId.HasValue && sub.RefDcSubId > 0)
                {
                    var issueBalQty =
                        await subConGRNService.GetIssueBalQtyByIssueSubId(sub.RefDcSubId.Value);

                    possibleQty = issueBalQty.GetValueOrDefault();
                }

                // =====================================================
                // 🔹 FINAL SAFETY
                // =====================================================
                if (possibleQty < 0)
                    possibleQty = 0;

                sub.PossibleQty = Math.Round(possibleQty??0, 3);
                //sub.Qty = Math.Min(sub.Qty ?? sub.PossibleQty.Value, sub.PossibleQty.Value);
            }

            // 🔹 Attachment count
            foreach (var prodSub in SubConGRNVMs.SubConGRNSubVMs.Where(x => x.ItemId.HasValue))
            {
                attachmentCounts[prodSub.ItemId.Value] =
                    await subConGRNService
                        .GetCorrespondenceAttachmentsCountAsync(prodSub.ItemId.Value, "Item");
            }

            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing Subcontract GRN.");
            await logs.LogDeveloperError(ex,$"LoadExistingSubcontractGRN failed for GRNId: {GRNId}");
        }
    }


    private bool CheckIsTransMade()
    {
        var list = SubConGRNVMs?.SubConGRNSubVMs
                    .Where(x => x.TransType == "In")
                    .ToList();
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalQty += list[i].Qty.GetValueOrDefault();
            totalBalQty += list[i].BalQty.GetValueOrDefault();
        }

        return totalQty != totalBalQty;
    }

    private async Task InitializeNewSubconGRN()
    {
        try
        {
            if (SubConGRNVMs == null)
                SubConGRNVMs = new SubConGRNVM();

            SubConGRNVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            SubConGRNVMs.GRNNo = await subConGRNService.GetSubconGRNNoAsync(SubConGRNVMs.Suffix);

            var MapStoreForProdReturn = await subConGRNService.GetMappedStoreForFormAsync("SubConGRNForm");

            if (MapStoreForProdReturn.StoreId > 0)
            {
                //////////////////vs
                Stores.Clear();

                Stores.Add(new Store
                {
                    StoreId = MapStoreForProdReturn.StoreId,
                    StoreName = MapStoreForProdReturn.StoreName
                });
                ///////////////////
                SubConGRNVMs.AddStoreId = MapStoreForProdReturn.StoreId;
                SubConGRNVMs.StoreName = MapStoreForProdReturn.StoreName;
            }
            else
            {
                SubConGRNVMs.AddStoreId = null;
                SubConGRNVMs.StoreName = null;
            }

            SelectedVendor = await subConGRNService.GetVendorByVenerCodeAsync(VendorCode.Value);

            if (SelectedVendor != null)
            {
                await ApplyVendorSelectionAsync(SelectedVendor);
            }
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new Subcontract GRN.");
            await logs.LogDeveloperError(ex, "InitializeNewSubconGRN failed");
        }
    }


    private async Task ApplyVendorSelectionAsync(VendorVM? vendor)
    {
        try
        {
            SelectedVendor = vendor;
            SubConGRNVMs.VendorCode = vendor?.VendorCode ?? 0;
            SubConGRNVMs.VendorName = vendor?.VendorName;
            SubConGRNVMs.VendorAddress = vendor?.VendorAddress;
            SubConGRNVMs.VendorGstNo = vendor?.GSTNo;
            SubConGRNVMs.VendorContactNo = vendor?.ContactNo;

            poPendingCount = await subConGRNService.GetPendingPoCountAsync(vendor.VendorCode);
            if(PoWiseDcOut)
            {
                DcOutPendingCount = await subConGRNService.GetPendingDcOutsPoCountAsync(vendor.VendorCode);

                if (DcOutPendingCount>0)
                {
                    Pos= await subConGRNService.GetOpenPurchPosByReturnMaterialVendor(vendor.VendorCode);

                }
            }
            //////////////////////////////////////////////////////////////
