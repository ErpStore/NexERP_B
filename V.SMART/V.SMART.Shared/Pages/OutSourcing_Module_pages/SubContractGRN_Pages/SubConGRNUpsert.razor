    private async Task CancelEdit(SubConGRNSubVM? item, SubConGRNVM? parentProdReturnComp)
    {
        try
        {
            if (item == null || parentProdReturnComp == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentProdReturnComp.SubConGRNSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"CancelEdit failed for ReturnSubId: {item?.GRNSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(SubConGRNSubVM item)
    {
        try
        {
            if (SubConGRNVMs.SubConGRNSubVMs.Count == 1 && item.GRNSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }
            // Prevent deleting the last "In" transaction row
            if (item.TransType == "In" && SubConGRNVMs.SubConGRNSubVMs.Count(x => x.TransType == "In") == 1 && item.GRNSubId > 0)
            {
                await _js.ToastrWarning("At least one 'In' item row is required.");
                return;
            }
            // Manual mode validation
            if (SubConGRNVMs.IsManual && item.GRNSubId > 0)
            {
                // Check last IN row
                if (item.TransType == "In" &&
                    SubConGRNVMs.SubConGRNSubVMs.Count(x => x.TransType == "In") == 1)
                {
                    await _js.ToastrWarning("At least one 'In' item row is required.");
                    return;
                }

                // Check last OUT row
                if (item.TransType == "Out" &&
                    SubConGRNVMs.SubConGRNSubVMs.Count(x => x.TransType == "Out") == 1)
                {
                    await _js.ToastrWarning("At least one 'Out' item row is required.");
                    return;
                }
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            // var result = await subConGRNService.ValidateDeleteAsync(item.RefRcSubId.Value, item.ItemId.Value,
            // // item.Qty.GetValueOrDefault(), SubConGRNVMs.AddStoreId.Value);

            // if (!result.IsValid)
            // {
            //     await _js.ToastrSuccess($"{result.Message}");
            //     return;
            // }

            //important if Stock Add Need to check the same ScreenCode An the Correct Ref. item StockExists
            var (addQty, balQty) = await subConGRNService.GetQtyBalQtyByStockAddAsync(
                            screenCode,
                            SubConGRNVMs.AddStoreId.Value,
                            item.ItemId.Value,
                            item.GRNSubId);

            if (addQty != balQty)
            {
                await _js.ToastrWarning($"cannot delete item '{item.ItemCode}'. Stock already used.");
                return;
            }

            if (item.ItemId == 0)
            {
                SubConGRNVMs.SubConGRNSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!SubConGRNVMs.SubConGRNSubVMs.Any())
                    SubConGRNVMs.SubConGRNSubVMs = new List<SubConGRNSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"RemoveRow failed for ReturnSubId: {item?.GRNSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

