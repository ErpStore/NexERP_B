@page "/DcSubConIncoming/create/{VendorCode:int}"
@page "/DcSubConIncoming/update/{GRNId:int}"


@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.ISubContractGRNService
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchPoVM
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.SubContractViewModel
@using V.SMART.Shared.ViewModels.PlanningViewModel.JobOrderViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService

@inject ISubConGRNService subConGRNService
@inject ReportService reportService
@inject ILoggingService logs
@inject IJSRuntime _js

@inject NavigationManager _navigationManager

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<!--Do Detail Model-->
<DetailsModal Title="Dc Details"
              Columns="@DcColumns"
              ColumnFields="@DcFields"
              HiddenColumns="@DcHiddenColumns"
              Data="@DcData"
              IsVisible="@IsDcModalVisible"
              IsVisibleChanged="@((val) => IsDcModalVisible = val)"
              OnSelectedItems="OnDCSelectedAsync">
</DetailsModal>

<DetailsModal Title="Route Card Details"
              Columns="@RcColumns"
              ColumnFields="@RcFields"
              HiddenColumns="@RcHiddenColumns"
              Data="@RcData"
              IsVisible="@IsRcModalVisible"
              IsVisibleChanged="@((val) => IsRcModalVisible = val)"
              OnSelectedItems="OnRcSelectedAsync">
</DetailsModal>

@if (!SubConGRNVMs.IsWithoutPoDc)
{
    <DetailsModal Title="PO Details"
                  Columns="@PoColumns"
                  ColumnFields="@PoFields"
                  HiddenColumns="@PoHiddenColumns"
                  Data="@PoData"
                  IsVisible="@IsPoModalVisible"
                  IsVisibleChanged="@((val) => IsPoModalVisible = val)"
                  OnSelectedItems="@OnPoSelectedAsync">
    </DetailsModal>
}
<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }

    .disabled-card {
        pointer-events: none;
        opacity: 0.6;
    }

    .selected-card {
        box-shadow: 0 0 0 2px rgba(25, 135, 84, 0.6);
    }

</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{

    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

             @if (SubConGRNVMs.Cancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (SubConGRNVMs.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }


            <PageHeader TitleText="@(SubConGRNVMs.GRNId > 0 ? "Update GRN" : "Create GRN")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@returnGRNBreadcrumbs" />
            
            <div class="card-body bg-light">
                <EditForm Model="SubConGRNVMs" OnValidSubmit="UpsertSubConGRN">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <!-- Correspondence Status -->
                    <div class="row g-3 mb-2 align-items-center">
                        @if (SubConGRNVMs.GRNId > 0 && !string.IsNullOrWhiteSpace(SubConGRNVMs.GRNNo))
                        {
                            <CorrespondenceStatus ReferenceType="@ScreenName"
                                                  ReferenceId="@SubConGRNVMs.GRNId"
                                                  ReferenceTypeName="@SubConGRNVMs.GRNNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">

                        <!-- =================== Document Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Supplier & DC Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                            <div class="col-12 col-sm-9">
                                                <MudAutocomplete T="VendorVM"
                                                    Value="SelectedVendor"
                                                    ValueChanged="@(async c => await OnVendorChanged(c))"
                                                    ToStringFunc="@(c => c?.VendorName ?? string.Empty)"
                                                    SearchFunc="SearchVendors"
                                                    Dense="true"
                                                    Variant="Variant.Outlined"
                                                    Placeholder="Search Vendor"
                                                    Title="Search at least 3 letters in Vendor"
                                                    Class="w-100 autocomplete-sm"
                                                    MaxItems="50"
                                                    Clearable="true"
                                                    ResetValueOnEmptyText="true" />
                                            </div>

                                    </div>

                                    @if(PoWiseDcOut && !SubConGRNVMs.IsWithoutPoDc)
                                    {
                                         <div class="row g-2">

                                          <!-- LEFT : PO LIST -->
                                          <div class="col-6">
                                              <div class="d-flex align-items-center gap-2 mb-1">

                                                <!-- Search -->
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       style="flex:1;"
                                                       placeholder="@(SubConGRNVMs.IsWithoutPoDc ? "Search Ref Dc No." : "Search PO No.")"
                                                       @bind="SearchTextPo"
                                                       @bind:event="oninput" />

                                                <!-- Select All -->
                                                <div class="form-check m-0">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@IsAllPoSelected"
                                                           @onchange="ToggleAllPO" />
                                                    <label class="form-check-label small fw-semibold">
                                                        All
                                                    </label>
                                                </div>

                                            </div>
                                         
                                              <div class="border rounded-3 p-2 po-scroll" style="height: 90px; overflow-y: auto;">
                                                  @if (SubConGRNVMs.IsWithoutPoDc)
                                                  {
                                                      @foreach (var dc in FilteredDc)
                                                      {
                                                          <div class="form-check border-bottom py-1 @(dc.IsSelected ? "bg-light" : "")"
                                                               @key="dc.DcId">
                                                              <input type="checkbox"
                                                                     class="form-check-input"
                                                                     id="@dc.DcId"
                                                                     checked="@dc.IsSelected"
                                                                     @onchange="e => OnDCCheckedChanged(dc, (bool)e.Value)" />
                                                              <label class="form-check-label ms-1 small fw-semibold"
                                                                     for="po_@dc.DcId">@dc.DcNo
                                                              </label>
                                                          </div>
                                                      }

                                                  }
                                                  else
                                                  {
                                                     
                                                          @foreach (var po in FilteredPos)
                                                          {
                                                              <div class="form-check border-bottom py-1 @(po.IsSelected ? "bg-light" : "")"
                                                                   @key="po.PoId">
                                                                  <input type="checkbox"
                                                                         class="form-check-input"
                                                                         id="po_@po.PoId"
                                                                         checked="@po.IsSelected"
                                                                         @onchange="e => OnPoCheckedChanged(po, (bool)e.Value)" />
                                                                  <label class="form-check-label ms-1 small fw-semibold"
                                                                         for="po_@po.PoId">@po.PONo
                                                                  </label>
                                                              </div>
                                                           }
                                                     
                                                  }
                                               
                                              </div>
                                          </div>

                                          <!-- RIGHT : SCN LIST -->
                                          <div class="col-6">
                                              <div class="d-flex align-items-center gap-2 mb-1">

                                                    <!-- Search -->
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           style="flex:1;"
                                                           placeholder="Search GRN No..."
                                                           @bind="SearchTextDc"
                                                           @bind:event="oninput" />

                                                    <!-- Select All -->
                                                    <div class="form-check m-0">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@IsAllGRNSelected"
                                                               @onchange="ToggleAllGRN" />
                                                        <label class="form-check-label small fw-semibold ms-1">
                                                            All
                                                        </label>
                                                    </div>

                                                </div>
                                            

                                              <div class="border rounded-3 p-2 po-scroll" style="height: 90px; overflow-y: auto;">
                                                  @if (DcOuts.Count > 0)
                                                  {
                                                      @foreach (var scn in FilteredDc)
                                                      {
                                                          <div class="form-check border-bottom py-1 @(scn.IsSelected ? "bg-light" : "")"
                                                               @key="scn.DcId">
                                                              <input type="checkbox"
                                                                     class="form-check-input"
                                                                     id="scn_@scn.DcId"
                                                                     @bind="scn.IsSelected" />
                                                              <label class="form-check-label ms-1 small fw-semibold"
                                                                     for="scn_@scn.DcId"> @scn.DcNo
                                                              </label>
                                                          </div>
                                                      }
                                                  }
                                                  else
                                                  {
                                                      <div class="text-muted small text-center py-3">
                                                          No Dc Outgoing available
                                                      </div>
                                                  }
                                              </div>

                                             <div class="text-end mt-2">
                                                  <button type="button"
                                                          class="btn btn-sm btn-primary"
                                                          disabled="@(!DcOuts.Any(p => p.IsSelected))"
                                                          @onclick="Loadpos">
                                                      @(!SubConGRNVMs.IsWithoutPoDc ? "Load POs" : "Load GRN")
                                                  </button>
                                              </div>
                                          </div>

                                      </div>

                                    }
                                    else
                                    {
                                          <!-- DC Details -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. DC</small>
                                            </label>
                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                @onclick="ShowDcDetails">
                                                    <i class="bi bi-list-ul me-1"></i> DC Details
                                                </button>
                                            </div>
                                        </div>

                                        @if (jobOrderPendingCount > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Route Card</small>
                                                </label>
                                                <div class="col-12 col-sm-9 position-relative">
                                                    <button type="button"
                                                    class="btn btn-sm btn-warning w-100 d-flex align-items-center justify-content-center"
                                                    @onclick="ShowRcDetails">
                                                        <i class="bi bi-list-ul me-1"></i> Route Card Details
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }

                                        <div class="mb-3 row">
                                            <label class="col-12 col-sm-3 col-form-label fw-semibold text-dark pt-2">
                                                <small>Options</small>
                                            </label>

                                            <div class="col-12 col-sm-9 d-flex align-items-center gap-4">

                                              @*   <!-- Rejection Switch -->
                                                <div class="form-check form-switch"> 
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           role="switch"
                                                           id="rejSwitch"
                                                           checked="@SubConGRNVMs.Rejection"
                                                           @onchange="OnRejectionChanged"
                                                           disabled="@IsBothDisabled">
                                                    <label class="form-check-label fw-medium 
                                                            @(SubConGRNVMs.Rejection ? "text-danger fw-bold" : "text-dark")"
                                                            for="rejSwitch">
                                                            Rejection
                                                    </label>
                                                </div> *@

                                                <!-- Return Switch -->
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           role="switch"
                                                           id="returnSwitch"
                                                           checked="@SubConGRNVMs.IsReturn"
                                                           @onchange="OnReturnChanged"
                                                           disabled="@IsBothDisabled">

                                                    <label class="form-check-label fw-medium
                                                        @(SubConGRNVMs.IsReturn ? "text-success fw-bold" : "text-dark")"
                                                           for="returnSwitch">
                                                        Return
                                                    </label>
                                                </div>

                                            </div>
                                        </div>
                                   @* } *@
                                </div>
                            </div>
                        </div>

                        <!-- =================== Production Material Issue Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Document Details</span>
                                    @if (SubConGRNVMs.GRNId > 0 && (CanCreate || CanEdit))
                                    {
                                        <div class="d-flex gap-2">
                                            <button type="button"
                                                    class="btn btn-sm rounded-3 @(SubConGRNVMs.Cancel ? "btn-success" : "btn-danger")"
                                                    @onclick="Cancel">

                                                @if (!SubConGRNVMs.Cancel)
                                                {
                                                    <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                                }
                                            </button>
                                            <!-- Short Close / Re-Open -->
                                            <button type="button"
                                                class="btn btn-sm rounded-3 @(SubConGRNVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                @onclick="() => AskToShortCloseAsync(SubConGRNVMs)"
                                                disabled="@SubConGRNVMs.Cancel">

                                                @if (!SubConGRNVMs.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Close</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>
                                        </div>
                                    }


                                </div>

                                <div class="card-body">
                                    <div class="row g-2 mb-2 align-items-stretch">

                                    <!-- No Inspection -->
                                    <div class="col-12 col-sm-4">
                                        <div class="card shadow-sm border-2
                                             @(SubConGRNVMs.IsNoInspection
                                                 ? "border-success bg-success-subtle selected-card"
                                                 : "border-light")
                                             @(SubConGRNVMs.GRNId > 0 ? "disabled-card" : "")"
                                             style="cursor:@(SubConGRNVMs.GRNId > 0 ? "not-allowed" : "pointer"); height:60px;"
                                             @onclick="SubConGRNVMs.GRNId > 0 ? null : (() => ToggleNoInspection(true))">

                                            <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                <i class="bi
                                                    @(SubConGRNVMs.IsNoInspection
                                                        ? "bi-check-circle-fill text-success"
                                                        : "bi-circle text-muted") me-2"></i>

                                                <span class="fw-semibold
                                                    @(SubConGRNVMs.IsNoInspection
                                                        ? "text-success"
                                                        : "text-dark")">
                                                    No Inspection
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Manual Selection -->
                                    <div class="col-12 col-sm-4">
                                        <div class="card shadow-sm border-2
                                             @(SubConGRNVMs.IsManual
                                                 ? "border-success bg-success-subtle selected-card"
                                                 : "border-light")
                                             @(SubConGRNVMs.GRNId > 0 ? "disabled-card" : "")"
                                             style="cursor:@(SubConGRNVMs.GRNId > 0 || SubConGRNVMs.IsReturn ? "not-allowed" : "pointer"); height:60px;"
                                             @onclick="SubConGRNVMs.GRNId > 0 || SubConGRNVMs.IsReturn ? null : (() => ToggleManualSelection(true))">

                                            <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                <i class="bi
                                                    @(SubConGRNVMs.IsManual
                                                        ? "bi-check-circle-fill text-success"
                                                        : "bi-circle text-muted") me-2"></i>

                                                <span class="fw-semibold
                                                    @(SubConGRNVMs.IsManual
                                                        ? "text-success"
                                                        : "text-dark")">
                                                    Manual Selection
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                        @if(PoWiseDcOut)
                                        {
                                            <!-- Without PO -->
                                            <div class="col-12 col-sm-4">
                                                <div class="card shadow-sm border-2
                                             @(SubConGRNVMs.IsWithoutPoDc
                                                 ? "border-warning bg-warning-subtle selected-card"
                                                 : "border-light")
                                             @(SubConGRNVMs.GRNId > 0 ? "disabled-card" : "")"
                                                style="cursor:@(SubConGRNVMs.GRNId > 0 ? "not-allowed" : "pointer"); height:60px;"
                                                @onclick="SubConGRNVMs.GRNId > 0 ? null : (() => ToggleIsWithoutPoDc(true))">

                                                    <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                        <i class="bi
                                                    @(SubConGRNVMs.IsWithoutPoDc
                                                        ? "bi-check-circle-fill text-warning"
                                                        : "bi-circle text-muted") me-2"></i>

                                                        <span class="fw-semibold
                                                    @(SubConGRNVMs.IsWithoutPoDc
                                                        ? "text-warning"
                                                        : "text-dark")">
                                                            Without PO
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                </div>

                                    <!-- Party DC Details -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Party DC</small>
                                        </label>

                                        <div class="col-12 col-sm-9">
                                            <div class="row">
                                                <!-- Party DC No -->
                                                <div class="col-12 col-sm-6 mb-1">
                                                    <div class="input-group input-group-sm">
                                                        <InputText class="form-control form-control-sm rounded-3"
                                                                    placeholder="Party DC No."
                                                                    maxlength="30"
                                                                    @bind-Value="SubConGRNVMs.PartyDC" />
                                                    </div>
                                                    <ValidationMessage For="@(() => SubConGRNVMs.PartyDC)" />
                                                </div>

                                                <!-- Party DC Date -->
                                                <div class="col-12 col-sm-6 mb-1">
                                                    <div class="input-group input-group-sm">
                                                        <InputDate class="form-control form-control-sm rounded-3"
                                                                    @bind-Value="SubConGRNVMs.PartyDCDate" />
                                                    </div>
                                                    <ValidationMessage For="@(() => SubConGRNVMs.PartyDCDate)" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <!-- Material Return No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GRN No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                           placeholder="Material Return No."
                                                           maxlength="30"
                                                           @bind-Value="@SubConGRNVMs.GRNNo"
                                                           readonly />

                                                <span class="input-group-text rounded-3">@SubConGRNVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => SubConGRNVMs.GRNNo)" />
                                            <ValidationMessage For="@(() => SubConGRNVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- Material Return Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GRN Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@SubConGRNVMs.GRNDate" />
                                            <ValidationMessage For="@(() => SubConGRNVMs.GRNDate)" />
                                        </div>
                                    </div>

                                    <!-- Stores -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Add To Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    disabled>
                                                    @* disabled="@(SubConGRNVMs.Rejection)"> *@
                                                @foreach (var store in Stores)
                                                {
                                                    <option value="@store.StoreId"
                                                            selected="@(store.StoreId == SubConGRNVMs.AddStoreId)">
                                                        @store.StoreName
                                                    </option>
                                                }
                                            </select>

                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="SubConGRNVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => SubConGRNVMs.MainRemark)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>


                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1"
                                 style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0"
                                               style="table-layout: fixed; min-width: 1500px;">

                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:100px;">Trans Type</th>
                                                    <th style="width:200px;">Item-Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:120px;">Return Qty</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:120px;">Possible Qty</th>

                                                    @if(SubConGRNVMs.SubConGRNSubVMs.Any(x => x.RefPoSubId > 0))
                                                    {
                                                        <th style="width:130px;">Ref. PO No</th>
                                                        <th style="width:130px;">Ref. PO Dt.</th>
                                                    }
                                                    @if(SubConGRNVMs.SubConGRNSubVMs.Any(x => x.RefRcSubId > 0))
                                                    {
                                                        <th style="width:130px;">RC No.</th>
                                                        <th style="width:130px;">RC Dt.</th>
                                                        <th style="width:130px;">Process</th>
                                                        <th style="width:130px;">Machine Name</th>
                                                    }
                                                    @if(SubConGRNVMs.IsManual)
                                                    {
                                                        <th style="width:130px;">Ref. DC No</th>
                                                        <th style="width:130px;">Ref. DC Dt.</th>
                                                    }

                                                    <th style="width:120px;">Cost Center</th>

                                                    <th style="width:200px;">Remarks</th>
                                                   @*  <th style="width:90px;" class="freeze-last-col text-end">Action</th> *@
                                                    <th style="width:90px;" class="freeze-last-col">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
