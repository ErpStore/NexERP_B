    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, SubConGRNSubVM SubVM)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            if (SubVM.GRNSubId == 0)
            {
                if (SubVM.RefRcSubId > 0)
                {
                    var PossibleQty = SubVM.PossibleQty;

                    if (newQty <= PossibleQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = PossibleQty;
                        SubVM.BalQty = PossibleQty;
                        await _js.ToastrWarning($"Qty can't be greater than Possible Route Card Qty ({PossibleQty}).");
                    }
                }
                else if (SubVM.RefPoSubId > 0)
                {
                    var PossibleQty = SubVM.PossibleQty;

                    if (newQty <= PossibleQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = PossibleQty;
                        SubVM.BalQty = PossibleQty;
                        await _js.ToastrWarning($"Qty can't be greater than Possible Purchase Order Qty ({PossibleQty}).");
                    }
                }
                else
                {
                    var PossibleQty = SubVM.PossibleQty;

                    if (newQty <= PossibleQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = PossibleQty;
                        SubVM.BalQty = PossibleQty;
                        await _js.ToastrWarning($"Qty can't be greater than Possible SubConDcOut Qty ({PossibleQty}).");
                    }



                    // SubVM.Qty = newQty;
                    // SubVM.BalQty = newQty;
                }
            }
            else
            {
                var original = await subConGRNService.GetProdReturnSubItemDetailByReturnSubIdAsync(SubVM.GRNSubId);
                if (original == null) return;

                if (SubVM.TransType == "In")
                {

                    var alreadyTransacted = original.Qty - original.BalQty;

                    if (newQty < alreadyTransacted)

                    {
                        SubVM.Qty = alreadyTransacted;
                        SubVM.BalQty = 0;
                        await _js.ToastrWarning($"Qty Returned cannot be less than {alreadyTransacted} (already transacted).");
                        return;
                    }

                    if (SubVM.RefRcSubId > 0)
                    {
                        var PossibleQty = SubVM.PossibleQty;
                        var maxAllowedQty = original.Qty + PossibleQty.GetValueOrDefault();

                        if (newQty > maxAllowedQty.GetValueOrDefault())
                        {
                            SubVM.Qty = maxAllowedQty.GetValueOrDefault();
                            SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();
                            await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                        }
                        else
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty - alreadyTransacted;
                        }
                    }
                    else if (SubVM.RefPoSubId > 0)
                    {
                        var PossibleQty = SubVM.PossibleQty;
                        var maxAllowedQty = original.Qty + PossibleQty.GetValueOrDefault();

                        if (newQty > maxAllowedQty.GetValueOrDefault())
                        {
                            SubVM.Qty = maxAllowedQty.GetValueOrDefault();
                            SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();
                            await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                        }
                        else
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty - alreadyTransacted;
                        }

                    }
                    else
                    {

                        var PossibleQty = SubVM.PossibleQty;
                        var maxAllowedQty = original.Qty + PossibleQty.GetValueOrDefault();

                        if (newQty > maxAllowedQty.GetValueOrDefault())
                        {
                            SubVM.Qty = maxAllowedQty.GetValueOrDefault();
                            SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();
                            await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                        }
                        else
                        {
                            SubVM.Qty = newQty;
                            SubVM.BalQty = newQty - alreadyTransacted;
                        }

                        // SubVM.Qty = newQty;
                        // SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
                else
                {
                    var originalSub = await subConGRNService.GetProdReturnSubItemDetailByOutGoingSubIdAsync(SubVM.RefDcSubId.Value);

                    if (originalSub == null) return;
                    var alreadyTransacted = original.Qty - original.BalQty;

                    var PossibleQty = originalSub.BalQty;
                    var maxAllowedQty = original.Qty + PossibleQty.GetValueOrDefault();

                    if (newQty > maxAllowedQty.GetValueOrDefault())
                    {
                        SubVM.Qty = maxAllowedQty.GetValueOrDefault();
                        SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"OnQtyChange failed for ReturnSubId: {SubVM?.GRNSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

