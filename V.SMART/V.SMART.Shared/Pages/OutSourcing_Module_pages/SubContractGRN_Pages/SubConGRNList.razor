@page "/subConGrnList"

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ISubConGRNService _grnService
@inject ExcelExportService ExcelExportService

<style>
    .pagination-fixed {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1030; /* keeps above table */
    }

    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }

</style>

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">

    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch isModelVisible="true"
                       Screen="@ScreenName"
                       Filters="SearchFilters"
                       OnClose="CloseModal"
                       OnSearch="ApplySearchFilters" />
    }
</MasterModal>


<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">
            <PageHeader TitleText="SubContract GRN List"
                        TitleIcon="bi bi-list-check"
                        Breadcrumbs="@SubconGRNBreadcrumbs" />

            <div class="card-body p-4">

                <div class="row g-2 g-md-3 mb-3">

                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="LabourGRNList"
                                    UserId="@UserName"
                                    MaxVisible="int.MaxValue"
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm" value="@pageSize"
                                @onchange="OnPageSizeChanged"
                                title="Select number of records per page">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select status of records">
                            <option value="">-- Select Status --</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Short Closed">Short Closed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                        <div class="col-12 col-lg-2 ms-md-auto text-end">
                            <button type="button" class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewGRN">
                                <i class="bi bi-plus-square me-1"></i> Add New GRN
                            </button>
                        </div>
                    }
                </div>

                @if (SubConGRNVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="@SubConGRNVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            // Keys & Main Info
                                            case "GRNId":
                                                <PropertyColumn Title="GRN ID" Property="@(c => c.GRNId)" />
                                                break;

                                            case "GRNNo":
                                                <PropertyColumn Title="GRN No"
                                                                Property="@(c => $"{c.GRNNo}{c.Suffix}")"
                                                                Sortable="true" />
                                                break;

                                            case "GRNDate":
                                                <PropertyColumn Title="GRN Date"
                                                                Property="@(c => c.GRNDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "GRNDateNow":
                                                <PropertyColumn Title="GRN Date Now"
                                                                Property="@(c => c.GRNDateNow)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            // Vendor (Replaced Customer)
                                            case "VendorCode":
                                                <PropertyColumn Title="Vendor Code" Property="@(c => c.VendorCode)" />
                                                break;

                                            case "VendorName":
                                                <PropertyColumn Title="Vendor Name" Property="@(c => c.VendorName)" Sortable="true" />
                                                break;

                                            case "VendorAddress":
                                                <PropertyColumn Title="Vendor Address" Property="@(c => c.VendorAddress)" />
                                                break;

                                            case "VendorGstNo":
                                                <PropertyColumn Title="Vendor GST No" Property="@(c => c.VendorGstNo)" />
                                                break;

                                            case "VendorContactNo":
                                                <PropertyColumn Title="Vendor Contact No" Property="@(c => c.VendorContactNo)" />
                                                break;

                                            case "KindofAttention":
                                                <PropertyColumn Title="Kind Of Attention" Property="@(c => c.KindofAttention)" />
                                                break;

                                            // Store
                                            case "AddStoreId":
                                                <PropertyColumn Title="Store Id" Property="@(c => c.AddStoreId)" />
                                                break;

                                            case "StoreName":
                                                <PropertyColumn Title="Store Name" Property="@(c => c.StoreName)" />
                                                break;

                                            // Party DC (Replaced RefDc)
                                            case "PartyDC":
                                                <PropertyColumn Title="Party DC No" Property="@(c => c.PartyDC)" />
                                                break;

                                            case "PartyDCDate":
                                                <PropertyColumn Title="Party DC Date"
                                                                Property="@(c => c.PartyDCDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            //  Flags (Optional Visibility)
                                            case "IsNoInspection":
                                                <PropertyColumn Title="No Inspection" Property="@(c => c.IsNoInspection)" />
                                                break;

                                            case "IsManual":
                                                <PropertyColumn Title="Manual" Property="@(c => c.IsManual)" />
                                                break;

                                            case "Rejection":
                                                <PropertyColumn Title="Rejection" Property="@(c => c.Rejection)" />
                                                break;

                                            case "IsReturn":
                                                <PropertyColumn Title="Return" Property="@(c => c.IsReturn)" />
                                                break;

                                            case "CorrespondenceStatus":
                                                <TemplateColumn Title="Correspondence Status">
                                                    @if (UploadStatus.ContainsKey(context.GRNId) && UploadStatus[context.GRNId])
                                                    {
                                                        <span class="badge bg-success">Uploaded</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Not Uploaded</span>
                                                    }
                                                </TemplateColumn>
                                                break;


                                            // Status (UPDATED LOGIC)
                                            case "Status":
                                                <TemplateColumn Title="GRN Status" Context="c">
                                                    @if (c.Cancel)
                                                    {
                                                        <span class="badge bg-danger rounded-pill px-3">
                                                            <i class="bi bi-x-circle me-1"></i> Cancelled
                                                        </span>
                                                    }
                                                    else if (c.ShortClose)
                                                    {
                                                        <span class="badge bg-secondary rounded-pill px-3">
                                                            <i class="bi bi-slash-circle me-1"></i> Short Closed
                                                        </span>
                                                    }
                                                    else if (c.GRNTally)
                                                    {
                                                        <span class="badge bg-success rounded-pill px-3">
                                                            <i class="bi bi-check-circle me-1"></i> Completed
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark rounded-pill px-3">
                                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;


                                            // 🔹 Cancel Details
                                            case "CancelBy":
                                                <PropertyColumn Title="Cancel By" Property="@(c => c.CancelBy)" />
                                                break;

                                            case "CancelDate":
                                                <PropertyColumn Title="Cancel Date"
                                                                Property="@(c => c.CancelDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "CancelReason":
                                                <PropertyColumn Title="Cancel Reason" Property="@(c => c.CancelReason)" />
                                                break;


                                            // 🔹 Other Info
                                            case "MainRemark":
                                                <PropertyColumn Title="Main Remark" Property="@(c => c.MainRemark)" />
                                                break;

                                            case "NoOfItems":
                                                <PropertyColumn Title="No Of Items" Property="@(c => c.NoOfItems)" />
                                                break;

                                            case "TotalQty":
                                                <PropertyColumn Title="Total Qty" Property="@(c => c.TotalQty)" />
                                                break;

                                            // 🔹 Audit
                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date"
                                                                Property="@(c => c.CreatedDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date"
                                                                Property="@(c => c.ModifiedDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }
                            }


                            <!-- Actions -->
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"DcSubConIncoming/update/{c.GRNId}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit GRN">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }

                                    @if (CanView)
                                    {
                                        <a href="@($"DcSubConIncoming/details/{c.GRNId}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View GRN">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }

                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete GRN"
                                                @onclick="() => HandleDelete(c)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>

                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="container-fluid">

                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="fw-semibold small px-1">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                                <button class="btn btn-success btn-sm d-flex align-items-center ms-5"
                                        @onclick="HandleExport">

                                    <i class="bi bi-download me-1"></i>
                                    Export GRN's

                                </button>

                            </div>

                        </div>

                    </div>

                }
                else
                {
                    <p class="text-center">No Labour GRN found.</p>
                }


            </div>
        </div>
    </div>
}


@code
{
    protected override string ScreenName => "Sub-Contrect GRN";
    private bool isProcessing = false;
    private string? UserName;
    private int DeleteGRNID = 0;
    private string selectedStatus = string.Empty;
    private PaginationState pagination = new() { ItemsPerPage = 10 };
    public List<GridColumn> Columns { get; set; }

    private int screenCode { get; set; }

    private int totalItems;
    private int currentPage = 1;
    private int pageSize = 10;
    private string searchTerm;
    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    private List<SubConGRNVM> SubConGRNVMs = new();

    [SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private Dictionary<int, bool> UploadStatus = new();


    private void AddNewGRN()
    {
        var returnUrl = Uri.EscapeDataString("DcSubConIncoming/create/{id}");
        _navigation.NavigateTo($"/Vendor/Select?ReturnUrl={returnUrl}");
    }

    private List<PageHeader.BreadcrumbItem> SubconGRNBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Out Sourcing" },
        new PageHeader.BreadcrumbItem { Text = "Sub Contract" },
        new PageHeader.BreadcrumbItem { Text = "Goods Received Note", IsLast = true }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await InitializeColumns(IsHidden);
            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllSubconGRNDetailsAsync();
            screenCode = await _grnService.GetScreenCodeByScreenNameAsync(ScreenName);

            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);
            if (saved?.Any() == true)
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(s => s.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }

            isProcessing = false;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Subcontract GRN List OnInitializedAsync() method");

        }
        finally
        {
            isProcessing = false;
        }
    }


    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "GRN ID", Field = "GRNId", IsVisible = false },

                new() { Title = "Is No Inspection", Field = "IsNoInspection", IsVisible = false },
                new() { Title = "Is Manual", Field = "IsManual", IsVisible = false },
                new() { Title = "Rejection", Field = "Rejection", IsVisible = false },
                new() { Title = "Is Return", Field = "IsReturn", IsVisible = false },

                new() { Title = "GRN No", Field = "GRNNo", IsVisible = true },
                new() { Title = "Suffix", Field = "Suffix", IsVisible = true },
                new() { Title = "GRN Date", Field = "GRNDate", IsVisible = true },
                new() { Title = "GRN Date Now", Field = "GRNDateNow", IsVisible = false },

                new() { Title = "Vendor Code", Field = "VendorCode", IsVisible = false },
                new() { Title = "Vendor Name", Field = "VendorName", IsVisible = true },
                new() { Title = "Vendor Address", Field = "VendorAddress", IsVisible = false },
                new() { Title = "Vendor GST No", Field = "VendorGstNo", IsVisible = false },
                new() { Title = "Vendor Contact No", Field = "VendorContactNo", IsVisible = false },

                new() { Title = "Kind Of Attention", Field = "KindofAttention", IsVisible = false },

                   new() { Title = "Correspondence Status", Field = "CorrespondenceStatus", IsVisible = false },

                new() { Title = "Store Id", Field = "AddStoreId", IsVisible = false },
                new() { Title = "Store Name", Field = "StoreName", IsVisible = true },

                new() { Title = "Main Remark", Field = "MainRemark", IsVisible = false },

                new() { Title = "Party DC No", Field = "PartyDC", IsVisible = true },
                new() { Title = "Party DC Date", Field = "PartyDCDate", IsVisible = true },

                new() { Title = "Status", Field = "Status", IsVisible = true },

                new() { Title = "Cancel", Field = "Cancel", IsVisible = true },
                new() { Title = "Cancel By", Field = "CancelBy", IsVisible = false },
                new() { Title = "Cancel Date", Field = "CancelDate", IsVisible = false },
                new() { Title = "Cancel Reason", Field = "CancelReason", IsVisible = false },

                new() { Title = "Short Close", Field = "ShortClose", IsVisible = true },

                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },

                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false },

                // Computed Fields
                new() { Title = "No Of Items", Field = "NoOfItems", IsVisible = true },
                new() { Title = "Total Qty", Field = "TotalQty", IsVisible = true },
            };

            if (!Hidden)
            {
                // Optional: show all columns if needed
                // Columns.ForEach(c => c.IsVisible = true);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in SubConGRN InitializeColumns()");
            await _JS.ToastrError("Error while initializing GRN columns");
        }
    }

    private async Task LoadAllSubconGRNDetailsAsync()
    {
        isProcessing = true;
        try
        {
            var result = await _grnService.SearchWithDynamicFilterAsync(pageNumber: currentPage, pageSize: pageSize, filters: SearchFilters);
            SubConGRNVMs = result.SubconGRNVMs;
            this.totalItems = result.TotalCount;

            foreach (var item in SubConGRNVMs)
            {
                UploadStatus[item.GRNId] = await _grnService.IsDocumentUploaded(item.GRNId);
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadAllSubconGRNDetailsAsync in SubconGRNList");
            await _JS.ToastrError("Failed to load LoadAllSubconGRNDetailsAsync data in SubconGRNList");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated ?? new List<GridColumn>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "HandleColumnChange in subconGRNList");
            await _JS.ToastrError("Failed to update column preferences in subconGRNList .");
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllSubconGRNDetailsAsync();
            await InvokeAsync(StateHasChanged);

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnPageSizeChanged in subconGRNList");
            await _JS.ToastrError("Failed to update page size in subconGRNList.");
        }
    }

    private async Task HandleDelete(SubConGRNVM grn)
    {
        try
        {

            var (canDelete, message) = await _grnService.CanDeleteSubconGRNAsync(grn.GRNId, screenCode);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteGRNID = grn.GRNId;

            ModalTitle = "Are you sure you want to delete this Subcontract GRN";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error while HandleDelete in Subcontract GRN List");
            await _JS.ToastrError("Failed to  HandleDelete data.");
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else if (confirmation == "Export")
            {
                isProcessing = true;
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            isProcessing = true;

            bool success = await _grnService.DeleteSubconGRNByIdAsync(DeleteGRNID, screenCode);

            if (success)
            {
                await _JS.ToastrSuccess("Subcontract GRN Deleted successfully.");
                await LoadAllSubconGRNDetailsAsync();
            }
            else
            {
                await _JS.ToastrWarning("Subcontract GRN Delete failed.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the SubcontractGRNList confirmDelete_Click() method");
            await _JS.ToastrError("An error occurred while handling the Subcontract GRN List confirmDelete_Click() method");
        }
        finally
        {
            DeleteGRNID = 0;
            isProcessing = false;
        }
    }

    private async Task FirstPage()
    {
        if (currentPage != 1)
        {
            currentPage = 1;
            await LoadAllSubconGRNDetailsAsync();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadAllSubconGRNDetailsAsync();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadAllSubconGRNDetailsAsync();
        }
    }

    private async Task LastPage()
    {
        if (currentPage != totalPages)
        {
            currentPage = totalPages;
            await LoadAllSubconGRNDetailsAsync();
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllSubconGRNDetailsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Subcontract GRN  page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }


    #region SEARCH FILTERS
    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllSubconGRNDetailsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Subcontract GRN List");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }
    #endregion

    #region Search order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? "";


        if (string.IsNullOrWhiteSpace(selectedStatus))
            SearchFilters.Remove("Status");
        else
            SearchFilters["Status"] = selectedStatus;


        currentPage = 1;
        await LoadAllSubconGRNDetailsAsync();
    }

    #endregion

    private async Task HandleExport()
    {
        selectedStatus = selectedStatus == "" ? "All" : selectedStatus;

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var exportData = await _grnService.GetSubContractGrnPendingList(selectedStatus);


            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "SubContractGRNExport", "SubContract GRN's Pending List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "SubContractGRNExport.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (SubContractGRNExport)");
            await _JS.ToastrError("Error while exporting SubContractGRNExport!");
        }
        finally
        {
            isProcessing = false;
        }
    }

}
