@page "/purchaseGRN/details/{GRNId:int}"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.IPurchaseGRN_Service
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchaseGRNVM
@inject IPurchaseGRNService _grnService
@inject IJSRuntime _js
@inject ILoggingService LoggingService
@inject ReportService reportService
@inherits BaseUserRightsComponent
@inject NavigationManager _navigation

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
        return;
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <!-- Company Details Section -->
            <MyCompanyDetails />

            <hr class="border-2 border-primary-subtle mb-4" />
            <div class="text-center">
                <h4 class="fw-semibold mt-3">Goods Recieved Note Details</h4>
            </div>
            <hr class="border-2 border-primary-subtle mb-4" />

            <!-- Vendor & Document Details Section -->
            <div class="row g-3 mb-4">
                <!-- Vendor Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Vendor Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(PurchaseGRNVMs?.VendorName) ? PurchaseGRNVMs.VendorName : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(PurchaseGRNVMs?.VendorAddress) ? PurchaseGRNVMs.VendorAddress : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(PurchaseGRNVMs?.VendorGstNo) ? PurchaseGRNVMs.VendorGstNo : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(PurchaseGRNVMs?.VendorContactNo) ? PurchaseGRNVMs.VendorContactNo : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact Person</strong></td><td>@(!string.IsNullOrEmpty(PurchaseGRNVMs?.KindofAttention) ? PurchaseGRNVMs.KindofAttention : "N/A")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Document Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Document Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>GRN No</strong></td>
                                        <td>@(PurchaseGRNVMs != null ? $"{PurchaseGRNVMs.GRNNo}{PurchaseGRNVMs.Suffix}" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>GRN Date</strong></td>
                                        <td>@(PurchaseGRNVMs?.GRNDate.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref DC No.</strong></td>
                                        <td>@(PurchaseGRNVMs?.RefDcNo.ToString() ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Dc Dt.</strong></td>
                                        <td>@(PurchaseGRNVMs?.RefDcDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Invoice No.</strong></td>
                                        <td>@(PurchaseGRNVMs?.RefInvNo.ToString() ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Invoice Dt.</strong></td>
                                        <td>@(PurchaseGRNVMs?.RefInvDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Added Store Name.</strong></td>
                                        <td>@(PurchaseGRNVMs?.StoreName?.ToString() ?? "N/A")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DC Items Section -->
            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    Purchase GRN Items
                </div>
                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                        <thead class="custom-blue">
                            <tr>
                                <th>Sl No.</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>UOM</th>
                                <th>HSN</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Basic Amount</th>
                                <th>PoBalQty</th>
                                <th>Ref Po No.</th>
                                <th>Ref Po Date</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody class="custom-size">
                            @if (PurchaseGRNVMs?.PurchaseGRNSubVMs != null && PurchaseGRNVMs.PurchaseGRNSubVMs.Any())
                            {
                                @foreach (var item in PurchaseGRNVMs.PurchaseGRNSubVMs)
                                {
                                    <tr>
                                        <td>@item.SlNo</td>
                                        <td>@(item.ItemCode ?? "—")</td>
                                        <td>@(item.ItemName ?? "—")</td>
                                        <td>@item.MeasureUnit</td>
                                        <td>@item.HSNCode</td>
                                        <td>@FormatDecimal(item.Qty)</td>
                                        <td>@FormatDecimal(item.UnitPrice)</td>
                                        <td>@FormatDecimal(item.Qty * item.UnitPrice)</td>
                                        <td>@FormatDecimal(item.POBalQty)</td>
                                        <td>@item.RefPoNo</td>
                                        <td>@item.RefPoDate</td>
                                        <td>@item.Remark</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Actions -->

            <div class="d-flex gap-2 justify-content-end">
                <a href="@($"/purchaseGRNList?currentPage={currentPage}")" class="btn btn-secondary rounded-3" disabled="@isProcessing">
                    <i class="bi bi-arrow-bar-left me-1"></i> Back To List
                </a>
                <a href="@($"/purchaseGRN/update/{GRNId}")" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Modify
                </a>
                <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
        </div>
    }
}

@code {
    protected override string ScreenName => "Purchase GRN";

    [Parameter]
    public int GRNId { get; set; }
    string? pdfBase64;
    private bool isProcessing { get; set; } = true;
    private PurchaseGRNVM PurchaseGRNVMs { get; set; } = new PurchaseGRNVM();
    private VendorVM VendorVMs { get; set; } = new VendorVM();

    private List<PurchaseGRNSubVM> refPos = new();
    private string refPoNosDisplay = "N/A";
    private string refPoDatesDisplay = "N/A";
    private int Decimalplaces { get; set; } = 2;

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private string FormatDecimal(decimal? value)
    {
        try
        {
            if (value == null) return "0";
            return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
        }
        catch (Exception ex)
        {
            LoggingService.LogDeveloperError(ex, "Error in FormatDecimal Purchase GRN");
            _js.ToastrError("An unexpected error occurred while FormatDecimal in Purchase GRN.");
            return "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await LoadDcDetails();
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Faild in OnInitializedAsync purchase GRN");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadDcDetails()
    {
        try
        {
            if (GRNId > 0)
            {
                var grn = await _grnService.GetPurchaseGRNByIdAsync(GRNId);
                if (grn != null)
                {
                    PurchaseGRNVMs = grn;
                }

                Decimalplaces = await _grnService.GetDecimalPlacesAsync();

                VendorVMs = await _grnService.GetVendorByIdAsync(PurchaseGRNVMs.VendorCode.Value);

                /// refPos = await _grnService.GetDistinctRefPoByDcIdAsync(MfgDcVMs.DcId);

                if (refPos.Any())
                {
                    // Only join the existing items, no extra commas
                    refPoNosDisplay = string.Join(", ", refPos.Select(e => e.RefPoNo).Where(n => !string.IsNullOrEmpty(n)));
                    refPoDatesDisplay = string.Join(", ", refPos
                        .Select(e => e.RefPoDate.HasValue ? e.RefPoDate.Value.ToString("dd/MM/yyyy") : null)
                        .Where(d => !string.IsNullOrEmpty(d)));
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in LoadDcDetails Purchase GRN");
            await _js.ToastrError("An unexpected error occurred while Loading LoadDcDetails in Purchase GRN.");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;
            var pdfBytes = await reportService.Generate_Report(GRNId, "PurchaseGRN.frx", "GRNId", PurchaseGRNVMs.GRNCancel, ScreenName, "Sp_Print_PurchaseGRN");
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Purchase GRN");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Purchase GRN.");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
