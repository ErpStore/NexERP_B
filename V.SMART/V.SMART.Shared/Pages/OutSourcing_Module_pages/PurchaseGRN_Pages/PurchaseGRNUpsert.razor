    private async Task OnItemCancelChanged(PurchaseGRNSubVM subitem)
    {
        try
        {
            if (subitem.GRNSubId == 0)
            {
                await _JS.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if (subitem.Qty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _JS.ToastrError("Item cannot be cancelled — SCN transactions have been made on it.");
                return;
            }

            if (PurchaseGRNVMs.GRNCancel)
            {
                await _JS.ToastrError("GRN is already Cancel. You can't cancel Item.");
                return;
            }

            if(subitem.ItemCancel)
                await _grnService.ValidateBeforeRevertAsync(subitem.GRNSubId);

            var (CanItemCancel, message) = await _grnService.CanGRNItemCancelCheckAsync(subitem);

            if (!CanItemCancel)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _JS.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _JS.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingGRN(GRNId.Value);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling Item");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in Purchase GRN");
        }
        finally
        {
            isProcessing = false;
        }
    }

