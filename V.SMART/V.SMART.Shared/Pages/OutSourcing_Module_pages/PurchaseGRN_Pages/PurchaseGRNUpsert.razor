@page "/purchaseGRN/create"
@page "/purchaseGRN/create/{VendorCode:int}"
@page "/purchaseGRN/update/{GRNId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.IPurchaseGRN_Service
@using V.SMART.Shared.Pages.Master_Module_pages.VendorSupplier_Pages
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchaseGRNVM
@using MudBlazor

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject IPurchaseGRNService _grnService
@inject ReportService reportService


<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">

</BsModal>

<DetailsModal Title="PO Details"
              Columns="@PoColumns"
              ColumnFields="@PoFields"
              HiddenColumns="@PoHiddenColumns"
              Data="@PoData"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="OnPoSelectedAsync">
</DetailsModal>


<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Vendor")
    {
        <VendorUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }

</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }

</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if (PurchaseGRNVMs.GRNCancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }
            else if (PurchaseGRNVMs.ShortClose)
            {
                <div class="cancelWatermark">SHORT CLOSED</div>
            }

            <PageHeader TitleText="@(PurchaseGRNVMs.GRNId > 0 ? "Update Purchase GRN" : "Create Purchase GRN")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@PurchaseGRNBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="PurchaseGRNVMs" OnValidSubmit="UpsertGRN">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Correspondence Status -->
                        @if (PurchaseGRNVMs.GRNId > 0 && !string.IsNullOrWhiteSpace(PurchaseGRNVMs.GRNNo))
                        {
                            <CorrespondenceStatus ReferenceType="@ScreenName"
                                                  ReferenceId="@PurchaseGRNVMs.GRNId"
                                                  ReferenceTypeName="@PurchaseGRNVMs.GRNNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Vendor Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header equal-card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Vendor Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3"
                                            @onclick='() => OpenModal("Vendor")'>
                                        <i class="bi bi-person-add me-1"></i> Add Vendor
                                    </button>
                                </div>

                                <div class="card-body">

                                    <!-- Vendor/Supplier Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="VendorVM"
                                                    Value="SelectedVendor"
                                                    ValueChanged="@(async c => await OnVendorChanged(c))"
                                                    ToStringFunc="@(c => c?.VendorName ?? string.Empty)"
                                                    SearchFunc="SearchVendors"
                                                    Dense="true"
                                                    Variant="Variant.Outlined"
                                                    Placeholder="Search Customer"
                                                    Title="Search atleast 3 letters in Vendor"
                                                    Class="w-100 autocomplete-sm"
                                                    MaxItems="50"
                                                    Clearable="true"
                                                    ResetValueOnEmptyText="true"
                                                    Required="true"
                                                    AvoidSubmit="true"
                                                    Disabled="@IsSomeItemsTransMade" />
                                        </div>
                                    </div>

                                    <!-- Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                  rows="1" readonly>@PurchaseGRNVMs?.VendorAddress</textarea>
                                        </div>
                                    </div>

                                    <!-- GSTIN -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GSTIN</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@PurchaseGRNVMs?.VendorGstNo" readonly />
                                        </div>
                                    </div>
                                    <!-- Contact Person -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Contact Person</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    @bind="@PurchaseGRNVMs.KindofAttention">
                                                <option disabled value="">Select Contact Person</option>
                                                @foreach (var cp in contactPersons)
                                                {
                                                    <option value="@cp.ContactPerson">@cp.ContactPerson</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => PurchaseGRNVMs.KindofAttention)" />
                                        </div>
                                    </div>
                                    <!-- Phone -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Phone No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@PurchaseGRNVMs?.VendorContactNo" readonly />
                                        </div>
                                    </div>

                                    <div class="row g-2 mb-2">
                                        
                                        <div class="col-6 form-check form-switch">
                                            <input class="form-check-input"
                                                    type="checkbox"
                                                    checked="@PurchaseGRNVMs.IsWithoutPoGRN"
                                                    @onchange="e => ToggleGRN((bool)e.Value)"
                                                    disabled="@PurchaseGRNVMs.PurchaseGRNSubVMs.Any(x => x.RefPoSubId > 0)">
                                            <label class="form-check-label fw-semibold">
                                                Without PO GRN
                                            </label>
                                        </div>
                                        
                                        <div class="col-6 form-check form-switch">
                                            <input class="form-check-input"
                                                    type="checkbox"
                                                    checked="@PurchaseGRNVMs.IsWithoutInspection"
                                                    @onchange="e => ToggleNoInspection((bool)e.Value)"
                                                    disabled ="@IsSomeItemsTransMade">
                                            <label class="form-check-label fw-semibold">
                                                No Inspection
                                            </label>
                                        </div>
                                        
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- =================== GRN Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <div class="card-header d-flex justify-content-between align-items-center bg-success-subtle text-dark">
                                    <span class="fw-bold fs-6">Purchase GRN Details</span>

                                    @if (PurchaseGRNVMs.GRNId > 0 && (CanCreate || CanEdit))
                                    {
                                        <div class="d-flex gap-2">

                                            @if (PurchaseGRNVMs.PurchaseGRNSubVMs == null || !PurchaseGRNVMs.PurchaseGRNSubVMs.Any(x => x.ItemCancel))
                                            {
                                                <!-- Cancel / Revert -->
                                                <button type="button"
                                                        class="btn btn-sm rounded-3 @(PurchaseGRNVMs.GRNCancel ? "btn-success" : "btn-danger")"
                                                        @onclick="Cancel"
                                                        disabled="@PurchaseGRNVMs.ShortClose">

                                                    @if (!PurchaseGRNVMs.GRNCancel)
                                                    {
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        <span>Cancel</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                        <span>Revert</span>
                                                    }
                                                </button>
                                            }

                                            <!-- Short Closed / Re-Open -->
                                            <button type="button"
                                                    class="btn btn-sm rounded-3 @(PurchaseGRNVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                    @onclick="() => AskToShortCloseAsync()"
                                                    disabled="@PurchaseGRNVMs.GRNCancel">

                                                @if (!PurchaseGRNVMs.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Closed</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>
                                        </div>
                                    }
                                </div>


                                <div class="card-body">

                                    <!-- Dc No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GRN No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm flex-wrap w-100">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="GRN No."
                                                       @bind="PurchaseGRNVMs.GRNNo" />

                                                <span class="input-group-text rounded-end">@PurchaseGRNVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => PurchaseGRNVMs.GRNNo)" />
                                            <ValidationMessage For="@(() => PurchaseGRNVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- GRN Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GRN Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@PurchaseGRNVMs.GRNDate" />
                                            <ValidationMessage For="@(() => PurchaseGRNVMs.GRNDate)" />
                                        </div>
                                    </div>

                                    <!-- Add to Store -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Add To Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select @bind="PurchaseGRNVMs.AddStoreId"
                                                    class="form-select form-select-sm rounded-3 w-100"
                                                    id="PurchaseGRN" disabled>
                                                <option value="0">--Select Store--</option>
                                                @foreach (var storeid in stores)
                                                {
                                                    <option value="@storeid.StoreId">@storeid.StoreName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => PurchaseGRNVMs.AddStoreId)" />
                                        </div>
                                    </div>

                                    <!-- PO Details -->
                                    @if (!PurchaseGRNVMs.IsWithoutPoGRN)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. PO</small>
                                            </label>
                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center rounded-3"
                                                        @onclick="ShowPoDetails">
                                                    <i class="bi bi-list-ul me-1"></i> PO Details
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- DC No -->
                                    <div class="mb-2 row align-items-center g-2">
                                        <label class="col-12 col-md-3 col-form-label text-dark">
                                            <small>DC No.</small>
                                        </label>

                                        <div class="col-12 col-md-5">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="PurchaseGRNVMs.RefDcNo" />
                                            <ValidationMessage For="@(() => PurchaseGRNVMs.RefDcNo)" />
                                        </div>

                                        <div class="col-12 col-md-4">
                                            <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="PurchaseGRNVMs.RefDcDate" />
                                            <ValidationMessage For="@(() => PurchaseGRNVMs.RefDcDate)" />
                                        </div>
                                    </div>

                                    <!-- Invoice No -->
                                    <div class="mb-2 row align-items-center g-2">
                                        <label class="col-12 col-md-3 col-form-label text-dark">
                                            <small>Invoice No.</small>
                                        </label>

                                        <div class="col-12 col-md-5">
                                            <InputText class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="PurchaseGRNVMs.RefInvNo" />
                                        </div>

                                        <div class="col-12 col-md-4">
                                            <InputDate class="form-control form-control-sm rounded-3 w-100"
                                                       @bind-Value="PurchaseGRNVMs.RefInvDate" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="PurchaseGRNVMs.MainRemarks"></textarea>
                                            <ValidationMessage For="@(() => PurchaseGRNVMs.MainRemarks)" />
                                        </div>
                                    </div>

                                    @if(PurchaseGRNVMs.GRNCancel)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="PurchaseGRNVMs.CancelReason"
                                                            readonly ></textarea>
                                                <ValidationMessage For="@(() => PurchaseGRNVMs.CancelReason)" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header bg-primary-subtle text-dark">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                                        <!-- Title -->
                                        <span class="fw-bold fs-6">Item Details</span>

                                        <!-- Right Controls -->
                                        <div class="d-flex flex-wrap align-items-center gap-2">

                                            <!-- Add Item Button -->
                                            <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>

                                        </div>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:170px;">Specification</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:70px;">HSN</th>
                                                    <th style="width:170px;">Category</th>
                                                    <th style="width:120px;">DNQty</th>
                                                    <th style="width:120px;">Qty Received</th>
                                                    <th style="width:120px;">Bal Qty</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:120px;">PO Bal. Qty</th>
                                                    <th style="width:110px;">Ref PO No.</th>
                                                    <th style="width:110px;">Ref PO Dt.</th>
                                                    <th style="width:110px;">PO Due Dt.</th>
                                                    <th style="width:120px;">Extra Qty</th>
                                                    <th style="width:120px;">Heat No.</th>
                                                    <th style="width:120px;">Batch No.</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:150px;">Cost-Center</th>

                                                    @if((GRNId.HasValue|| GRNId> 0) && (!PurchaseGRNVMs.GRNCancel))
                                                    {
                                                        <th style="width:150px;">Item Cancel</th>
                                                    }

                                                    @if (!PurchaseGRNVMs.GRNCancel && !PurchaseGRNVMs.ShortClose)
                                                    {
                                                        <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                    }
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in PurchaseGRNVMs.PurchaseGRNSubVMs)
                                                {
                                                    <tr class="@(subitem.ItemCancel ? "table-danger" : "")" @key="subitem">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @if (subitem.IsEditable && (subitem.RefPoSubId == 0 || subitem.RefPoSubId == null)
                                                                            && subitem.Qty.GetValueOrDefault() == subitem.BalQty.GetValueOrDefault())
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                                         Value="subitem.SelectedItem"
                                                                                         ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                         ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                         SearchFunc="SearchItems"
                                                                                         Dense="true"
                                                                                         Variant="Variant.Outlined"
                                                                                         Placeholder="Search Item Code"
                                                                                         Title="Search Atleast 3 Letters in Item-Code"
                                                                                         Class="w-100 autocomplete-sm"
                                                                                         MaxItems="50" />
                                                                        <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.ItemCode
                                                                    }
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0  && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                       Size="Size.Small"
                                                                                       Color="Color.Primary"
                                                                                       OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                       Edge="Edge.End"
                                                                                       Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.Specification</td>
                                                        <td>@subitem.MeasureUnit</td>
                                                        <td>@subitem.HSNCode</td>
                                                        <td>@subitem.Category</td>
                                                       <!-- DNQty-->
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                
                                                                    <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="DN Qty"
                                                                           step="any"
                                                                           min="0.01"
                                                                           title="Enter DNQuantity"
                                                                           value="@subitem.DNQty"
                                                                           @oninput="@(e => OnDCQtyChanged(e, subitem))" />
                                                               
                                                                @* <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="DN Qty"
                                                                       title="Enter DNQuantity"
                                                                       min="0"
                                                                       step="any"
                                                                       @bind="subitem.DNQty" />
                                                                <ValidationMessage For="@(() => subitem.DNQty)" /> *@
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.DNQty</span>
                                                            }
                                                        </td>

                                                        <!-- Qty -->
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Qty"
                                                                       title="Enter Quantity"
                                                                       step="any"
                                                                       min="0"
                                                                       @bind="subitem.Qty"
                                                                       @bind:event="oninput"
                                                                       @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.Qty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.Qty</span>
                                                            }
                                                        </td>

                                                        <td>@subitem.BalQty</td>


                                                        <td>
                                                            @if (subitem.IsEditable && PurchaseGRNVMs.IsWithoutPoGRN)
                                                            {
                                                                <input type="number" class="form-control form-control-sm"
                                                                        placeholder="Price" title="Enter Unit Price"
                                                                        step="any"
                                                                        min="0"
                                                                       @bind="subitem.UnitPrice" />
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>

                                                        <td>@subitem.POBalQty</td>
                                                        <td>@subitem.RefPoNo</td>
                                                        <td>@subitem.RefPoDate?.ToString("dd/MM/yyyy")</td>
                                                        <td>@subitem.PoDueDate?.ToString("dd/MM/yyyy")</td>

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm"
                                                                       placeholder="Extra Qty"
                                                                       title="Enter Extra Quantity"
                                                                       step="any"
                                                                       min="0"
                                                                       @bind="subitem.ExtraQty"
                                                                       @bind:event="oninput"
                                                                       @onchange="@(e => OnExtraQtyChange(e, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.ExtraQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.ExtraQty</span>
                                                            }
                                                        </td>
                                                        
                                                        <!-- Heat No -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="text"
                                                                       class="form-control form-control-sm "
                                                                       placeholder="Heat No"
                                                                       title="Enter Heat No"
                                                                       @bind="subitem.HeatNo"/>
                                                                <ValidationMessage For="@(() => subitem.HeatNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.HeatNo
                                                            }
                                                        </td>

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="text"
                                                                       class="form-control form-control-sm "
                                                                       placeholder="Batch No"
                                                                       title="Enter Batch No"
                                                                       @bind="subitem.BatchNo"/>
                                                                <ValidationMessage For="@(() => subitem.BatchNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.BatchNo
                                                            }
                                                        </td>

                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputTextArea @bind-Value="subitem.Remark"
