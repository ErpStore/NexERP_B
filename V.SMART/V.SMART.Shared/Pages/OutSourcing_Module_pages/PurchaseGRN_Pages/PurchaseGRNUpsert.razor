    #region Row Operations
    private async Task<bool> ValidateRowAsync(PurchaseGRNSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (row.Qty <= 0)
                errors.Add("Quantity must be greater than 0.");

            if (row.UnitPrice <= 0)
                errors.Add("Unit Price must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _JS.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = PurchaseGRNVMs.PurchaseGRNSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (!await ValidateLastRowAsync()) return;

            PurchaseGRNVMs.PurchaseGRNSubVMs.Add(new PurchaseGRNSubVM
            {
                GRNId = PurchaseGRNVMs.GRNId,
                IsEditable = true
            });

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error adding new row.");
            await LoggingService.LogDeveloperError(ex, "AddRow failed.");
        }
    }

    private async Task SaveRow(PurchaseGRNSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            if (!PurchaseGRNVMs.PurchaseGRNSubVMs.Any(x => x.IsEditable))
            {
                PurchaseGRNVMs.PurchaseGRNSubVMs.Add(new PurchaseGRNSubVM
                {
                    GRNId = PurchaseGRNVMs.GRNId,
                    IsEditable = true
                });
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for GRNSubId: {item?.GRNSubId}");
            await _JS.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(PurchaseGRNSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItem == null && item.ItemId > 0)
            {
                item.SelectedItem = await _grnService.GetItemByItemIdAsync(item.ItemId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for GRNSubId: {item?.GRNSubId}");
            await _JS.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(PurchaseGRNSubVM? item, PurchaseGRNVM? parentDc)
    {
        try
        {
            if (item == null || parentDc == null)
                return;

            bool isEmptyOrInvalid = (item.ItemId <= 0) ||  (item.Qty.GetValueOrDefault() <= 0) ||  (item.UnitPrice <= 0);

            if (isEmptyOrInvalid)
            {
                parentDc.PurchaseGRNSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for GRNSubId: {item?.GRNSubId}");
            await _JS.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(PurchaseGRNSubVM item)
    {
        try
        {
            if (PurchaseGRNVMs.PurchaseGRNSubVMs.Count == 1 && PurchaseGRNVMs.GRNId > 0)
            {
                await _JS.ToastrWarning("At least one item must be present in the GRN.");
                return;
            }

            if (PurchaseGRNVMs.GRNCancel)
            {
                await _JS.ToastrError("This GRN is already cancelled. Row deletion is not allowed.");
                return;
            }

            if (PurchaseGRNVMs.ShortClose)
            {
                await _JS.ToastrError("This GRN is already short closed. Row deletion is not allowed.");
                return;
            }

            if (item.ItemCancel)
            {
                await _JS.ToastrError("This item is already cancelled and cannot be deleted.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction integrity.");
                return;
            }

            if (item.ItemId == 0)
            {
                PurchaseGRNVMs.PurchaseGRNSubVMs.Remove(item);
                await _JS.ToastrSuccess("New item row removed successfully.");

                if (!PurchaseGRNVMs.PurchaseGRNSubVMs.Any())
                    PurchaseGRNVMs.PurchaseGRNSubVMs = new List<PurchaseGRNSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for GRNSubId: {item?.GRNSubId}");
            await _JS.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in PurchaseGRNVMs.PurchaseGRNSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _JS.ToastrError("Failed to reset row serial numbers.");
        }
    }

