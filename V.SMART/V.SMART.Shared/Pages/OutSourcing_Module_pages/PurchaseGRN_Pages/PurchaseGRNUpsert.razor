    #region GRN Operations

    private async Task UpsertGRN()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            PurchaseGRNVMs.PurchaseGRNSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!PurchaseGRNVMs.PurchaseGRNSubVMs.Any())
            {
                await _JS.ToastrWarning("Cannot save a Purchase GRN without valid items.");
                return;
            }


            // Validate each line
            foreach (var line in PurchaseGRNVMs.PurchaseGRNSubVMs)
            {
                bool isValid = await ValidateDcLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewDc = PurchaseGRNVMs.GRNId == 0;
            if(isNewDc)
            {
                if (await _grnService.IsDuplicateDcNoAsync(PurchaseGRNVMs.VendorCode ?? 0,PurchaseGRNVMs.RefDcNo,PurchaseGRNVMs.Suffix))
                {
                    await _JS.ToastrWarning($"The same Vendor {PurchaseGRNVMs.VendorName} and DC No {PurchaseGRNVMs.RefDcNo} already exist. Please enter a different DC No.");
                    return;
                }
                if (await _grnService.IsDuplicateInvNoAsync(PurchaseGRNVMs.VendorCode ?? 0,PurchaseGRNVMs.RefInvNo,PurchaseGRNVMs.Suffix))
                {
                    await _JS.ToastrWarning($"The same Vendor {PurchaseGRNVMs.VendorName} and Invoice No {PurchaseGRNVMs.RefDcNo}  already exist. Please enter a different Invoice No.");
                    return;
                }
            }
            try
            {
                await _grnService.UpsertGRNAsync(PurchaseGRNVMs,screenCode);

            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewDc)
                await _JS.ToastrSuccess("Purchase GRN saved successfully.");
            else
                await _JS.ToastrSuccess("Purchase GRN updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigation.NavigateTo("/purchaseGRNList");
        }

        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertGRN failed.");
            await _JS.ToastrError("Error saving Purchase SCN.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateDcLineAsync(PurchaseGRNSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _JS.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _JS.ToastrError($"Item {line.ItemCode}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _JS.ToastrError($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            if (string.IsNullOrWhiteSpace(PurchaseGRNVMs.RefDcNo) && string.IsNullOrWhiteSpace(PurchaseGRNVMs.RefInvNo))
            {
                await _JS.ToastrError($"Please enter the DC number or Invoice number");
                return false;
            }


            // Qty vs PO / Already Transacted validation

            if (line.GRNSubId == 0 && line.RefPoSubId > 0)
            {
                if(!line.IsOpenPo)
                {
                    var poBalQty = await _grnService.GetPoItemBalQtyFromPoSubId(line.RefPoSubId.Value);

                    if ((line.Qty > poBalQty))
                    {
                        line.Qty = poBalQty;
                        line.BalQty = poBalQty;
                        await _JS.ToastrWarning($"Qty cannot exceed Po Balance Qty ({poBalQty}).");
                        return false;
                    }
                }
            }
            else if (line.GRNSubId > 0)
            {
                var original = await _grnService.GetGRNSubItemDetailByGRNSubIdAsync(line.GRNSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty.GetValueOrDefault();
                    decimal origQty = original.Qty.GetValueOrDefault();
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidatePOLineAsync failed.");
            await _JS.ToastrError("Error Validate Purchase-PO line.");
            return false;
        }
    }
