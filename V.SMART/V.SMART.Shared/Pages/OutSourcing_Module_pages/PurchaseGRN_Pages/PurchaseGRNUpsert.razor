    #endregion


    #region Initialization
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            DecimalPlaces = await _grnService.GetDecimalPlacesAsync();
            screenCode = await _grnService.GetScreenCodeByScreenNameAsync(ScreenName);

            if (GRNId.HasValue)
            {
                await LoadExistingGRN(GRNId.Value);
            }
            else if (VendorCode > 0)
            {
                await InitializeNewGRN(VendorCode);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    } 

    private async Task LoadExistingGRN(int grnId)
    {
        try
        {
            PurchaseGRNVMs = await _grnService.GetPurchaseGRNByIdAsync(grnId);

            if (PurchaseGRNVMs == null)
            {
                await _JS.ToastrWarning("GRN not found.");
                return;
            }

            SelectedVendor = await _grnService.GetVendorByIdAsync(PurchaseGRNVMs.VendorCode.Value);
            if (SelectedVendor != null)
                await ApplyVendorSelectionAsync(SelectedVendor);

            foreach (var dcSub in PurchaseGRNVMs.PurchaseGRNSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[dcSub.ItemId.Value] = await _grnService.GetCorrespondenceAttachmentsCountAsync(dcSub.ItemId.Value, "Item");
            }

            //Check Transaction Completed flag
            IsSomeItemsTransMade = await CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load Existing PurchaseGRN.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingDc failed in PurchaseGRN for GRNId: {grnId}");
        }
    }

    private async Task<bool> CheckIsTransMade()
    {
        try
        {
            return await _grnService.IsGRNTransactionsMatchedAsync(GRNId.Value, PurchaseGRNVMs, screenCode);

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "CheckIsTransMade failed.");
            return false;

        }
    }

    private async Task InitializeNewGRN(int vendorCode)
    {
        try
        {
            var vendor = await _grnService.GetVendorByIdAsync(vendorCode);
            if (vendor != null)
                await ApplyVendorSelectionAsync(vendor);

            PurchaseGRNVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            PurchaseGRNVMs.GRNNo = await _grnService.GetGRNnNumberAsync(PurchaseGRNVMs.Suffix);

            var MapStoreForDc = await _grnService.GetMappedStoreForFormAsync("GRNForm");

            if (MapStoreForDc.StoreId > 0)
            {
                PurchaseGRNVMs.AddStoreId = MapStoreForDc.StoreId;
                PurchaseGRNVMs.StoreName = MapStoreForDc.StoreName;
            }

        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to initialize new po.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewPo failed for VendorCode: {vendorCode}");
        }
    }
    #endregion


    #region Vendor data Handlers
    private async Task<IEnumerable<VendorVM>> SearchVendors(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<VendorVM>();

        try
        {
            var results = await _grnService.SearchVendorsAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<VendorVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<VendorVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"In PurchaseGRNUpsert SearchVendors failed for value: {value}");
            await _JS.ToastrError("Failed to search Vendors in PurchaseGRNUpsert. Please try again.");
            return Enumerable.Empty<VendorVM>();
        }
    }

    private async Task OnVendorChanged(VendorVM? vendor)
    {
        try
        {
            await ApplyVendorSelectionAsync(vendor);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error in OnVendorChanged: {ex}");
            await LoggingService.LogDeveloperError(ex, "Error in OnVendorChanged");
            await _JS.ToastrError("Error while selecting");

        }
    }

    private async Task ApplyVendorSelectionAsync(VendorVM? vendor) 
    {
        try
        {
            SelectedVendor = vendor;
            PurchaseGRNVMs.VendorCode = vendor?.VendorCode ?? 0;
            PurchaseGRNVMs.VendorName = vendor?.VendorName;
            PurchaseGRNVMs.VendorAddress = vendor?.VendorAddress;
            PurchaseGRNVMs.VendorGstNo = vendor?.GSTNo;
            PurchaseGRNVMs.VendorContactNo = vendor?.ContactNo;

            if (vendor == null)
            {
                stores.Clear();
                return;
            }
            contactPersons = await _grnService.GetContactPersonsVendorAsync(vendor.VendorCode);

          //  stores = (await _grnService.GetAllActiveStoresAsync()).ToList();
            var MapStoreForDc = await _grnService.GetMappedStoreForFormAsync("GRNForm");

            if (MapStoreForDc.StoreId > 0)
            {
                //////////////////vs
                stores.Clear();

                stores.Add(new Store
                {
                    StoreId = MapStoreForDc.StoreId,
                    StoreName = MapStoreForDc.StoreName
                });
                //////////////////////

                PurchaseGRNVMs.AddStoreId = MapStoreForDc.StoreId;
                PurchaseGRNVMs.StoreName = MapStoreForDc.StoreName;
            }

            PurchaseGRNVMs.KindofAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPerson : string.Empty;

            //Pending PoDetails
            //poPendingCount = await _grnService.GetPendingPoCountAsync(vendor.VendorCode);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyVendorSelectionAsync failed for VendorCode: {vendor?.VendorCode}");
            await _JS.ToastrError("Failed to apply vendor selection. Please try again.");
        }
    }
    #endregion

    #region Item Handlers
    private async Task<IEnumerable<ItemVM>> SearchItems(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<ItemVM>();

        try
        {
            var results = await _grnService.SearchItemsAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<ItemVM>();
        }
        catch (OperationCanceledException)
        {
            // Typing too fast, search canceled - silently ignore
            return Enumerable.Empty<ItemVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SearchItems failed for value: {value}");
            await _JS.ToastrError("Failed to search items. Please try again.");
            return Enumerable.Empty<ItemVM>();
        }
    }

    private async Task OnItemChanged(PurchaseGRNSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItem = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.HSNCode = item.HSNCode;
                subitem.MeasureUnit = item.MeasureUnit;
                subitem.Specification=item.Specification;
                subitem.Category = item.CategoryName;

                if (PurchaseGRNVMs?.VendorCode != null && subitem.ItemId.HasValue)
                {
                    var rates = await _grnService.GetBulkLastUnitPricesAsync(
                        new List<int> { subitem.ItemId.Value },
                        PurchaseGRNVMs.VendorCode.Value
                    );

                    if (rates.TryGetValue(subitem.ItemId.Value, out decimal rate))
                    {
                        subitem.UnitPrice = rate;
                    }
                }

                if (subitem.ItemId > 0)
                {
                    var count = await _grnService.GetCorrespondenceAttachmentsCountAsync(subitem.ItemId.Value, "Item");
                    attachmentCounts[subitem.ItemId.Value] = count;
                }
            }
            else
            {
                // Reset when deselected
                subitem.SelectedItem = null;
                subitem.ItemId = null;
                subitem.ItemCode = null;
                subitem.ItemName = null;
                subitem.HSNCode = null;
                subitem.MeasureUnit = null;
                subitem.UnitPrice = 0m;
                subitem.Specification = null;
                subitem.Category = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"In purchaseGRNUpsert OnItemChanged failed for ItemId: {item?.ItemId}");
            await _JS.ToastrError("Failed to apply item selection  in purchaseGRNUpsert. Please try again.");
        }
    }

    private bool IsItemAlreadySelected(int itemId, int? currentItemId)
    {
        return PurchaseGRNVMs.PurchaseGRNSubVMs?.Any(q => q.ItemId == itemId && q.ItemId != currentItemId) == true;
    }
    #endregion


    #region Quantity Handlers
    private async Task OnDCQtyChanged(ChangeEventArgs e, PurchaseGRNSubVM subitem)
    {
        try
        {
            if (decimal.TryParse(e.Value?.ToString(), out decimal qty))
            {
                subitem.DNQty = qty;

                // Auto fill Qty
                subitem.Qty = qty;
                subitem.BalQty = qty;
            }
            else
            {
                subitem.DNQty = 0;
                subitem.Qty = 0;
                subitem.BalQty = 0;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"In OnDCQtyChanged()");
            await _JS.ToastrError("Failed to apply item selection  in OnDCQtyChanged Please try again.");
        }

    }

    private async Task OnQtyChange(ChangeEventArgs e, PurchaseGRNSubVM SubVM)
    {
        try
        {

            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                await _JS.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW Po line
            if (SubVM.GRNSubId == 0)
            {
                if (SubVM.RefPoSubId > 0)
                {
                    var poBalQty = await _grnService.GetPoItemBalQtyFromPoSubId(SubVM.RefPoSubId.Value);
                    if (SubVM.IsOpenPo)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else if (newQty <= poBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = poBalQty;
                        SubVM.BalQty = poBalQty;

                        await _JS.ToastrWarning($"Qty can't be greater than PO Balance Qty ({poBalQty}).");
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty;
                }
            }

            // EXISTING DC line
            else
            {
                var original = await _grnService.GetGRNSubItemDetailByGRNSubIdAsync(SubVM.GRNSubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.BalQty = 0;
                    await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefPoSubId > 0)
                {
                    var poBalQty = await _grnService.GetPoItemBalQtyFromPoSubId(SubVM.RefPoSubId.Value);
                    var maxAllowedQty = original.Qty + poBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();
                        await _JS.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted.GetValueOrDefault();
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted.GetValueOrDefault();
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for DcSubId: {SubVM?.GRNSubId}");
            await _JS.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    private async Task OnExtraQtyChange(ChangeEventArgs e, PurchaseGRNSubVM SubVM)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.ExtraQty = 0;
                SubVM.ExtraBalQty = 0;
                await _JS.ToastrWarning("Extra Qty must be a positive number.");
                return;
            }

            if (SubVM.GRNSubId == 0)
            {
                SubVM.ExtraQty = newQty;
                SubVM.ExtraBalQty = newQty;
            }

            // EXISTING DC line
            else
            {
                var original = await _grnService.GetGRNSubItemDetailByGRNSubIdAsync(SubVM.GRNSubId);
                if (original == null) return;

                var alreadyTransacted = original.ExtraQty - original.ExtraBalQty;

                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.ExtraBalQty = 0;
                    await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefPoSubId > 0)
                {
                    SubVM.Qty = newQty;
                    SubVM.ExtraBalQty = newQty - alreadyTransacted;
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.ExtraBalQty = newQty - alreadyTransacted;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnExtraQtyChange failed for DcSubId: {SubVM?.GRNSubId}");
            await _JS.ToastrError("Failed to update extra quantity. Please try again.");
        }
    }

