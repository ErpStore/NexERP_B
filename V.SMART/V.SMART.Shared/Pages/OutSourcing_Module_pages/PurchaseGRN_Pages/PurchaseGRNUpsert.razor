    private async Task CancelItem()
    {
        if (rowToCancel == null || isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            bool isCancelling = !rowToCancel.ItemCancel;

            if (isCancelling && string.IsNullOrWhiteSpace(cancelReason))
            {
                await _JS.ToastrWarning("Cancel reason is required.");
                return;
            }

            rowToCancel.ItemCancel = isCancelling;
            rowToCancel.ItemCancelReason = isCancelling ? cancelReason : string.Empty;

            await _grnService.UpdateItemCancelAndAddorRevertAsync(rowToCancel,PurchaseGRNVMs,screenCode);

            string actionText = isCancelling ? "Cancelled" : "Reverted";

            await LoggingService.LogUserAction(
                username,
                machine,
                ip,
                screen: "Purchase GRN",
                action: $"{actionText} GRN No: {PurchaseGRNVMs.GRNNo}, ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: isCancelling
                    ? $"Reason: {cancelReason}"
                    : "Item revert operation"
            );

            if(GRNId.Value > 0)
                await LoadExistingGRN(GRNId.Value);

            await ResetSlno();

            await _JS.ToastrSuccess($"Item has been {actionText.ToLower()} successfully.");

            cancelReason = string.Empty;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await _JS.ToastrWarning(ex.Message);
            await LoadExistingGRN(GRNId.Value);

        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the item.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Revert failed for GRNId: {PurchaseGRNVMs.GRNId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

