    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.GRNSubId > 0)
            {
                await _grnService.DeleteAndResequenceAsync(rowToDelete, PurchaseGRNVMs, screenCode);

                if(GRNId > 0)
                    await LoadExistingGRN(GRNId.Value);
            }
            else
            {
                PurchaseGRNVMs.PurchaseGRNSubVMs.Remove(rowToDelete);

                if (!PurchaseGRNVMs.PurchaseGRNSubVMs.Any())
                {
                    PurchaseGRNVMs.PurchaseGRNSubVMs.Add(new PurchaseGRNSubVM
                    {
                        GRNId = PurchaseGRNVMs.GRNId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < PurchaseGRNVMs.PurchaseGRNSubVMs.Count; i++)
                        PurchaseGRNVMs.PurchaseGRNSubVMs[i].SlNo = i + 1;
                }
            }

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for GRNID: {PurchaseGRNVMs.GRNId}");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

