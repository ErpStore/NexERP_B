    #region  Toggle WithoutPO GRN and AutoSCN

    private void ToggleGRN(bool isWithoutPo)
    {
        if (isWithoutPo)
        {
            // If already selected, unselect
            if (PurchaseGRNVMs.IsWithoutPoGRN)
            {
                PurchaseGRNVMs.IsWithoutPoGRN = false;
            }
            else
            {
                PurchaseGRNVMs.IsWithoutPoGRN = true;
                PurchaseGRNVMs.PurchaseGRNSubVMs.Clear();
            }
        }
        else
        {

            PurchaseGRNVMs.IsWithoutPoGRN = false;

        }
    }
    private void ToggleNoInspection(bool NoInspection)
    {
        if (NoInspection)
        {
            // If already selected, unselect
            if (PurchaseGRNVMs.IsWithoutInspection)
            {
                PurchaseGRNVMs.IsWithoutInspection = false;
            }
            else
            {
                PurchaseGRNVMs.IsWithoutInspection = true;
            }
        }
        else
        {

            PurchaseGRNVMs.IsWithoutInspection = false;

        }
