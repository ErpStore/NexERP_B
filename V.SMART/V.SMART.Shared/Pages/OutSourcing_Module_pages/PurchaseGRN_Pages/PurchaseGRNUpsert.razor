                                                        </td>
                                                        <td>@PurchaseGRNVMs.TotalQty</td>
                                                        <td>@PurchaseGRNVMs.TotalBalQty</td>
                                                        <td>Avg: @FormatDecimal(PurchaseGRNVMs.AverageUnitPrice)</td>
                                                        <td colspan="14"></td>

                                                    </tr>
                                                </tfoot>
                                            }


                                        </table>
                                    </div>

                                    @if (PurchaseGRNVMs.IsWithoutPoGRN && !PurchaseGRNVMs.GRNCancel && !PurchaseGRNVMs.ShortClose)
                                    {
                                        <div class="mt-2 text-start">
                                            <button type="button"
                                                    class="btn btn-success btn-sm"
                                                    @onclick="AddRow"
                                                    disabled="@(PurchaseGRNVMs.GRNCancel)">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        

                        @if (PurchaseGRNVMs.GRNId > 0)
                        {
                             <!-- Top Blue Line -->
                            <hr class="border-1 border-primary mt-2 mb-1 opacity-100" />
                            <div class="row g-3 mb-1 mt-1 align-items-end">
                                <!-- Created By -->
                                <div class="col-12 col-lg-3 mb-0 pb-0">
                                    <div class="form-floating mb-0 pb-0">
                                        <InputText @bind-Value="PurchaseGRNVMs.CreatedBy"
                                                   id="CreatedBy"
                                                   class="form-control bg-light"
                                                   placeholder="Created By"
                                                   disabled />
                                        <label for="CreatedBy">Created By</label>
                                    </div>
                                </div>

                                <!-- Created Date -->
                                <div class="col-12 col-lg-3 mb-0 pb-0">
                                    <div class="form-floating mb-0 pb-0">
                                        <input class="form-control bg-light"
                                               id="CreatedDate"
                                               placeholder="Created Date"
                                               value="@PurchaseGRNVMs.CreatedDate.ToString("dd-MM-yyyy HH:mm:ss")"
                                               disabled />
                                        <label for="CreatedDate">Created Date</label>
                                    </div>
                                </div>

                                <!-- Modified By -->
                                <div class="col-12 col-lg-3 mb-0 pb-0">
                                    <div class="form-floating mb-0 pb-0">
                                        <InputText @bind-Value="PurchaseGRNVMs.ModifiedBy"
                                                   id="ModifiedBy"
                                                   class="form-control bg-light"
                                                   placeholder="Modified By"
                                                   disabled />
                                        <label for="ModifiedBy">Modified By</label>
                                    </div>
                                </div>

                                <!-- Modified Date -->
                                <div class="col-12 col-lg-3 mb-0 pb-0">
                                    <div class="form-floating mb-0 pb-0">
                                        <input class="form-control bg-light"
                                               id="ModifiedDate"
                                               placeholder="Modified Date"
                                               value="@PurchaseGRNVMs.ModifiedDate?.ToString("dd-MM-yyyy HH:mm:ss")"
                                               disabled />
                                        <label for="ModifiedDate">Modified Date</label>
                                    </div>
                                </div>
                            </div>
                             <!-- Bottom Blue Line -->
                        <hr class="border-1 border-primary mt-1 mb-0 opacity-100" />
                        }

                       

                        <div class="row g-3">
                            <!-- Action Buttons -->
                            @if (CanCreate || CanEdit)
                            {
                                @if(!PurchaseGRNVMs.GRNCancel && !PurchaseGRNVMs.ShortClose)
                                {
                                    <div class="col-6 col-md-3 mt-3">
                                        <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                            <i class="bi bi-floppy2-fill me-1"></i> @(PurchaseGRNVMs.GRNId > 0 ? "Update" : "Create")
                                        </button>
                                    </div>
                                  
                                }
                            }

                            <div class="col-6 col-md-3 mt-3">
                                <SmartBackButton Url="@($"/purchaseGRNList?currentPage={currentPage}")" />
                            </div>

                            @if (CanCreate || CanEdit && GRNId > 0)
                            {
                                <div class="col-12 col-md-3">
                                    <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                        <i class="bi bi-printer me-1"></i>Print
                                    </button>
                                </div>
                            }

                        </div>

                    </div>

                </EditForm>
            </div>

        </div>
    </div>
}

