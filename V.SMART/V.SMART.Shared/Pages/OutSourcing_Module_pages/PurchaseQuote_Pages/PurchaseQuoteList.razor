@page "/purchaseQuoteList"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IPurchaseService
@using V.SMART.Shared.ViewModels.PurchAndSubConViewModel.Purch_QuotationVM

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ExcelExportService ExcelExportService
@inject IPurchaseQuoteService purchaseQuoteService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Purchase Quotation List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@QuoteBreadcrumbs" />

            <div class="card-body p-4">

                 <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                 value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Short Closed">Short Closed</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                       <div class="col-6 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewQuote">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </button>
                       </div>
                    }

                </div>

                @if (PurchaseQuoteVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="PurchaseQuoteVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Any(c => c.IsVisible))
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            case "QuoteId":
                                                <PropertyColumn Title="Quote ID" Property="@(c => c.QuoteId)" />
                                                break;

                                            case "QuoteNo":
                                                <PropertyColumn Title="Quote No"
                                                                Property="@(c => $"{c.QuoteNo}{c.Suffix ?? string.Empty}")"
                                                                Sortable="true" />
                                                break;

                                            case "QuoteDate":
                                                <PropertyColumn Title="Quote Date"
                                                                Property="@(c => c.QuoteDate)"
                                                                Format="dd/MM/yyyy"
                                                                Sortable="true" />
                                                break;

                                            // Purchase / Subcontract Badge
                                            case "PurchOrSubText":
                                                <TemplateColumn Title="Purchase / Subcontract" Context="c">
                                                    @if (c.PurchOrSub)
                                                    {
                                                        <span class="badge text-bg-primary bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-cart-check me-1"></i> Purchase
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-info bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-people-fill me-1"></i> Subcontract
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            // Vendor Details
                                            case "VendorName":
                                                <PropertyColumn Title="Vendor Name"
                                                                Property="@(c => c.VendorName)" />
                                                break;

                                            case "VendorCode":
                                                <PropertyColumn Title="Vendor Code"
                                                                Property="@(c => c.VendorCode)" />
                                                break;

                                            case "VendorAddress":
                                                <PropertyColumn Title="Vendor Address"
                                                                Property="@(c => c.VendorAddress)" />
                                                break;

                                            case "ContactNo":
                                                <PropertyColumn Title="Contact No"
                                                                Property="@(c => c.ContactNo)" />
                                                break;

                                            case "GSTNo":
                                                <PropertyColumn Title="GST No"
                                                                Property="@(c => c.GSTNo)" />
                                                break;

                                            case "PANNo":
                                                <PropertyColumn Title="PAN No"
                                                                Property="@(c => c.PANNo)" />
                                                break;

                                            case "KindOfAttention":
                                                <PropertyColumn Title="Kind Of Attention"
                                                                Property="@(c => c.KindOfAttention)" />
                                                break;

                                            // Item Summary
                                            case "NoOfItems":
                                                <PropertyColumn Title="No Of Items"
                                                                Property="@(c => c.NoOfItems)" />
                                                break;

                                            case "TotalQty":
                                                <PropertyColumn Title="Total Qty"
                                                                Property="@(c => c.TotalQty)"
                                                                Format="N2" />
                                                break;

                                            // Amount Fields
                                            case "TotalGrossAmount":
                                                <PropertyColumn Title="Total Gross Amount"
                                                                Property="@(c => c.TotalGrossAmount)"
                                                                Format="N2" />
                                                break;

                                            case "GrandTotal":
                                                <PropertyColumn Title="Grand Total"
                                                                Property="@(c => c.GrandTotal)"
                                                                Format="N2" />
                                                break;

                                            case "MainRemark":
                                                <PropertyColumn Title="Remarks"
                                                                Property="@(c => c.MainRemark)" />
                                                break;

                                            case "Details":
                                                <PropertyColumn Title="Terms"
                                                                Property="@(c => c.Details)" />
                                                break;

                                            // Quotation Status Badge (NEW LOGIC)
                                            case "Status":
                                                <TemplateColumn Title="PR Status" Context="c">
                                                    @if (c.IsCancel)
                                                    {
                                                        <span class="badge text-bg-danger bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-x-circle me-1"></i> Cancelled
                                                        </span>
                                                    }
                                                    else if (c.QuoteShortClose)
                                                    {
                                                        <span class="badge text-bg-secondary bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-slash-circle me-1"></i> Short Closed
                                                        </span>
                                                    }
                                                    else if (c.QuotationTally)
                                                    {
                                                        <span class="badge text-bg-success bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-check-circle me-1"></i> Completed
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-warning bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;


                                            case "CancelDate":
                                                <PropertyColumn Title="Cancel Date"
                                                                Property="@(c => c.CancelDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "CancelReason":
                                                <PropertyColumn Title="Cancel Reason"
                                                                Property="@(c => c.CancelReason)" />
                                                break;

                                            case "CancelBy":
                                                <PropertyColumn Title="Cancel By"
                                                                Property="@(c => c.CancelledBy)" />
                                                break;

                                            // Audit Fields
                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By"
                                                                Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date"
                                                                Property="@(c => c.CreatedDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By"
                                                                Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date"
                                                                Property="@(c => c.ModifiedDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }
                            }
                            
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"PurchaseQuote/update/{c.QuoteId}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Quote">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"purchasequote/details/{c.QuoteId}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View Quote">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete Quote"
                                                @onclick="() => HandleDelete(c.QuoteId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="container-fluid">

                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="fw-semibold small px-1">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                                <button class="btn btn-success btn-sm d-flex align-items-center ms-5"
                                        @onclick="HandleExport">

                                    <i class="bi bi-download me-1"></i>
                                    Export Quote's

                                </button>

                            </div>

                        </div>

                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}


@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Purchase-Quotation";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteQuoteId = 0;
    private string searchText = string.Empty;
    private string selectedStatus = "";

    private List<PurchaseQuoteVM> PurchaseQuoteVMs = new();

    // === Paging & Search ===
    private int totalItems;
    private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> QuoteBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Outsourcing" },
        new PageHeader.BreadcrumbItem { Text = "Quotation-Inward", IsLast = true }
    };

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }

            await LoadAllQuote();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    #region === Data Loading ===

    private async Task LoadAllQuote()
    {
        try
        {
            var result = await purchaseQuoteService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            PurchaseQuoteVMs = result.purchaseQuoteVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading data in Purchase Quotation List");
            await _JS.ToastrError("Failed to load Purchase Quotation List.");
        }
    }

    private void AddNewQuote()
    {
        _navigation.NavigateTo("/Vendor/Select?ReturnUrl=PurchaseQuote/create/{id}");
    }

    #endregion



    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {

            Columns = new List<GridColumn>
            {
                new() { Title = "Quote ID", Field = "QuoteId", IsVisible = false },

                new() { Title = "Quote No", Field = "QuoteNo", IsVisible = true },
                new() { Title = "Quote Date", Field = "QuoteDate", IsVisible = true },

                new() { Title = "Purchase / Subcontract", Field = "PurchOrSubText", IsVisible = true },

                // ===== VENDOR DETAILS =====
                new() { Title = "Vendor Code", Field = "VendorCode", IsVisible = false },
                new() { Title = "Vendor Name", Field = "VendorName", IsVisible = true },
                new() { Title = "Vendor Address", Field = "VendorAddress", IsVisible = false },
                new() { Title = "Contact No", Field = "ContactNo", IsVisible = false },
                new() { Title = "GST No", Field = "GSTNo", IsVisible = false },
                new() { Title = "PAN No", Field = "PANNo", IsVisible = false },

                new() { Title = "Kind Of Attention", Field = "KindOfAttention", IsVisible = false },

                // ===== SHIPPING DETAILS =====
                new() { Title = "Shipping Name", Field = "ShippingName", IsVisible = false },
                new() { Title = "Shipping Address", Field = "ShippingAddress", IsVisible = false },
                new() { Title = "Shipping GSTIN", Field = "ShippingGstin", IsVisible = false },
                new() { Title = "Shipping Contact No", Field = "ShippingContactNo", IsVisible = false },

                // ===== ITEM SUMMARY =====
                new() { Title = "No Of Items", Field = "NoOfItems", IsVisible = true },
                new() { Title = "Total Qty", Field = "TotalQty", IsVisible = false },

                // ===== AMOUNT DETAILS =====
                new() { Title = "Total Gross Amount", Field = "TotalGrossAmount", IsVisible = false },
                new() { Title = "Discount %", Field = "DiscountPercent", IsVisible = false },
                new() { Title = "Discount Amount", Field = "DiscountAmount", IsVisible = false },
                new() { Title = "Total Basic Amount", Field = "TotalBasicAmount", IsVisible = false },

                new() { Title = "Freight Charges", Field = "FreightCharges", IsVisible = false },
                new() { Title = "Packing Charges", Field = "PackingCharges", IsVisible = false },
                new() { Title = "Insurance Charges", Field = "InsuranceCharges", IsVisible = false },

                new() { Title = "CGST Amount", Field = "TotalCGSTAmount", IsVisible = false },
                new() { Title = "SGST Amount", Field = "TotalSGSTAmount", IsVisible = false },
                new() { Title = "IGST Amount", Field = "TotalIGSTAmount", IsVisible = false },

                new() { Title = "Other Charges", Field = "OtherCharges", IsVisible = false },
                new() { Title = "TCS Amount", Field = "TCSAmount", IsVisible = false },

                new() { Title = "Total Taxable", Field = "TotalTaxable", IsVisible = false },
                new() { Title = "Round Off", Field = "RoundOff", IsVisible = false },

                new() { Title = "Grand Total", Field = "GrandTotal", IsVisible = true },

                new() { Title = "Remarks", Field = "MainRemark", IsVisible = false },
                new() { Title = "Terms", Field = "Details", IsVisible = false },

                new() { Title = "Quotation Status", Field = "Status", IsVisible = true },
                new() { Title = "Cancel Date", Field = "CancelDate", IsVisible = false },
                new() { Title = "Cancel Reason", Field = "CancelReason", IsVisible = false },
                new() { Title = "Cancel By", Field = "CancelBy", IsVisible = false },

                // ===== AUDIT FIELDS =====
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };


            if (!Hidden)
            {
                // Columns.AddRange(new[]
                // {
                //     new GridColumn { Title = "Extra Column 1", Field = "Extra1", IsVisible = false },
                //     new GridColumn { Title = "Extra Column 2", Field = "Extra2", IsVisible = false },
                // });
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Purchase Quotation List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Purchase Quotation List HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllQuote();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Purchase Quotation List");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllQuote();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Purchase Quotation List");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllQuote();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Purchase Quotation List");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllQuote();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Purchase Quotation List");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllQuote();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Purchase Quotation List");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllQuote();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Purchase Quotation List page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int quoteId)
    {
        try
        {
            
            var (canDelete, message) = await purchaseQuoteService.CanDeletePurchaseQuote(quoteId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteQuoteId = quoteId;


            ModalTitle = "Are you sure you want to delete this Quotation";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for EnquiryId: {quoteId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;
           
            var deleted = await purchaseQuoteService.DeleteQuotationByQuoteIdAsync(DeleteQuoteId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Purchase Quotation deleted successfully.");
                await LoadAllQuote();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Quotation could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting EnquiryId: {DeleteQuoteId}");
            await _JS.ToastrError("Failed to delete Purchase Quotation.");
        }
        finally
        {
            DeleteQuoteId = 0;
            isProcessing = false;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else if (confirmation == "Export")
            {
                isProcessing = true;
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllQuote();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Purchase Quotation List");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion


    #region Job order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

           if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;


            currentPage = 1;
            await LoadAllQuote();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in Purchase Quotation List");
            await _JS.ToastrError("Failed to Load Purchase Quotation List filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion 

    private async Task HandleExport()
    {
        selectedStatus = selectedStatus == "" ? "All" : selectedStatus;

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }
    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var exportData = await purchaseQuoteService.GetPurchSubQuotePendingList(selectedStatus);


            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "PurchaseQuotation", "Purchase and SubContract Quote's Pending List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "PurchaseQuotation.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (PurchaseQuotation)");
            await _JS.ToastrError("Error while exporting PurchaseQuotation!");
        }
        finally
        {
            isProcessing = false;
        }
    }

}



