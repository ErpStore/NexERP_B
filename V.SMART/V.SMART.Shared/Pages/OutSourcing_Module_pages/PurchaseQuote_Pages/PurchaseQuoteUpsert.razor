    private async Task Cancel(PurchaseQuoteVM quote)
    {
        try
        {
            if (!QuoteId.HasValue || QuoteId == 0)
            {
                await _JS.ToastrError("cancel is not allowed before saving the Purchase Quotation.");
                return;
            }

            if(IsSomeItemsTransMade)
            {
                await _JS.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Quotation");
                return;
            }

            if (quote.QuoteShortClose)
            {
                await _JS.ToastrError("Quotation is already short closed. You can't cancel it.");
                return;
            }

            if (quote.PurchaseQuoteSubVM?.Any(x => x.ItemCancel) == true)
            {
                await _JS.ToastrError("Some items are already cancelled. Complete Quotation cancellation is not allowed.");
                return;
            }

            if (quote.IsCancel)
            {
                var subs = await _purchQuotationService.GetQuoteSubByQuoteIdAsync(quote.QuoteId); 

                foreach (var sub in subs)
                {
                    await _purchQuotationService.ValidatePurchaseEnquiryBalanceBeforeRevertAsync(sub);
                }
            }

            if (!quote.IsCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Quotation?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Quotation?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingQuote(QuoteId.Value);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }

        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Quotation.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Quotation Sales Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnItemCancelChanged(PurchaseQuoteSubVM subitem)
    {
        try
        {
            if (subitem.QuoteSubId == 0)
            {
                await _JS.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if (subitem.Qty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _JS.ToastrError("Item cannot be cancelled — Purchase order transactions have been made on it.");
                return;
            }

            if (PurchaseQuoteVM.IsCancel)
            {
                await _JS.ToastrError("Quotation is already Cancel. You can't cancel Item.");
                return;
            }

            if(subitem.ItemCancel )
                await _purchQuotationService.ValidateBeforeRevertAsync(subitem.QuoteSubId);

            var (CanItemCancel, message) = await _purchQuotationService.CanQuoteItemCancelCheckAsync(subitem);

            if (!CanItemCancel)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _JS.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _JS.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingQuote(QuoteId.Value);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling Item");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in Purchase Quotation");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void UpdateQuantities(PurchaseQuoteSubVM subVM, decimal newQty, decimal? alreadyTransacted = null)
    {
        subVM.Qty = newQty;

        subVM.BalQty = alreadyTransacted.HasValue
            ? Math.Max(newQty - alreadyTransacted.Value, 0)
            : newQty;
    }

