    private async Task CancelQuotation()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!PurchaseQuoteVM.IsCancel)
            {
                PurchaseQuoteVM.IsCancel = true;
                PurchaseQuoteVM.CancelDate = DateTime.Now;
                PurchaseQuoteVM.CancelReason = cancelReason;
                PurchaseQuoteVM.CancelledBy = username;

                await _purchQuotationService.UpdatedCancelStatusAndAddOrRevertQty(PurchaseQuoteVM);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "PurchaseQuotation upsert",
                    action: $"Cancelled Quotation: {PurchaseQuoteVM.QuoteNo}",
                    additionalInfo: $"Quotation Id: {PurchaseQuoteVM.QuoteId}"
                );

                await _JS.ToastrSuccess("Quotation cancelled successfully.");
            }
            else
            {

                PurchaseQuoteVM.IsCancel = false;
                PurchaseQuoteVM.CancelDate = null;
                PurchaseQuoteVM.CancelReason = string.Empty;
                PurchaseQuoteVM.CancelledBy = string.Empty;


                await _purchQuotationService.UpdatedCancelStatusAndAddOrRevertQty(PurchaseQuoteVM);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "PurchaseQuotation upsert",
                    action: $"Reverted Quotation: {PurchaseQuoteVM.QuoteNo}",
                    additionalInfo: $"Quotation Id: {PurchaseQuoteVM.QuoteId}"
                );

                await _JS.ToastrSuccess("Quotation has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await LoggingService.LogDeveloperError(ex, "[UpdatedCancelStatusAndAddOrRevertQty] Validation issue");
            await _JS.ToastrError(ex.Message);

        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the purchase quotation.");
            await LoggingService.LogDeveloperError(ex, $"CancelQuotation failed for QuoteId: {PurchaseQuoteVM.QuoteId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CancelItem()
    {
        if (rowToCancel == null || isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            bool isCancelling = !rowToCancel.ItemCancel;

            if (isCancelling && string.IsNullOrWhiteSpace(cancelReason))
            {
                await _JS.ToastrWarning("Cancel reason is required.");
                return;
            }

            rowToCancel.ItemCancel = isCancelling;
            rowToCancel.ItemCancelReason = isCancelling ? cancelReason : string.Empty;

            await _purchQuotationService.UpdateItemCancelAndAddorRevertAsync(rowToCancel);

            string actionText = isCancelling ? "Cancelled" : "Reverted";

            await LoggingService.LogUserAction(
                username,
                machine,
                ip,
                screen: "Purchase Quotation",
                action: $"{actionText} Quotation No: {PurchaseQuoteVM.QuoteNo}, ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: isCancelling
                    ? $"Reason: {cancelReason}"
                    : "Item revert operation"
            );

            if(QuoteId.HasValue || QuoteId > 0)
                await LoadExistingQuote(QuoteId.Value);

            await _JS.ToastrSuccess($"Item has been {actionText.ToLower()} successfully.");

            cancelReason = string.Empty;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingQuote(QuoteId.Value);
            await _JS.ToastrWarning(ex.Message);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the item.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Revert failed for QuoteId: {PurchaseQuoteVM?.QuoteId}");
        }
        finally
        {
            cancelReason= string.Empty;
            isProcessing = false;
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.QuoteSubId > 0)
            {
                await _purchQuotationService.DeleteAndResequenceAsync(rowToDelete, PurchaseQuoteVM);

                PurchaseQuoteVM = await _purchQuotationService.GetQuotationByQuoteIdAsync(PurchaseQuoteVM.QuoteId);
            }
            else
            {
                PurchaseQuoteVM.PurchaseQuoteSubVM.Remove(rowToDelete);

                if (!PurchaseQuoteVM.PurchaseQuoteSubVM.Any())
                {
                    PurchaseQuoteVM.PurchaseQuoteSubVM.Add(new PurchaseQuoteSubVM
                    {
                        QuoteId = PurchaseQuoteVM.QuoteId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < PurchaseQuoteVM.PurchaseQuoteSubVM.Count; i++)
                        PurchaseQuoteVM.PurchaseQuoteSubVM[i].SlNo = i + 1;
                }
            }

            await _calculationService.UpdateTotalsAsync(PurchaseQuoteVM);

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for QuoteId: {PurchaseQuoteVM.QuoteId}");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

