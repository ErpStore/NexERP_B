    #region Quotation Operations

    private async Task UpsertQuote()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            PurchaseQuoteVM.PurchaseQuoteSubVM.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!PurchaseQuoteVM.PurchaseQuoteSubVM.Any())
            {
                await _JS.ToastrError("Cannot save a quotation without valid items.");
                return;
            }
            

            // Validate each line
            foreach (var line in PurchaseQuoteVM.PurchaseQuoteSubVM)
            {
                bool isValid = await ValidateQuoteLineAsync(line);
                if (!isValid) return;
            }
            var isNewQuote = PurchaseQuoteVM.QuoteId == 0;
            if (isNewQuote)
            {
                bool isDuplicat = await _purchQuotationService.IsDuplicateQuoteAsync(PurchaseQuoteVM.QuoteNo,PurchaseQuoteVM.Suffix,PurchaseQuoteVM.VendorCode,PurchaseQuoteVM.QuoteId);
                if (isDuplicat)
                {
                    await _JS.ToastrError($"Quotation number '{PurchaseQuoteVM.QuoteNo}' already exists for Vendor '{PurchaseQuoteVM.VendorName}'.");
                    return;
                }
            }        
            // Save
            try
            {
                await _purchQuotationService.UpsertQuoteAsync(PurchaseQuoteVM);
            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewQuote)
                await _JS.ToastrSuccess("Quotation saved successfully.");
            else
                await _JS.ToastrSuccess("Quotation updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/purchaseQuoteList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Purchase Quoate UpsertQuote failed.");
            await _JS.ToastrError("Error while  saving in Purchase  quotation.");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task<bool> ValidateQuoteLineAsync(PurchaseQuoteSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _JS.ToastrError("Please select an Item before saving.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _JS.ToastrError($"Item {line.ItemId}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _JS.ToastrError($"Item {line.ItemId}: Unit Price must be greater than 0.");
                return false;
            }

            // ----------------------------------------------------------
            // CASE 1: New Quotation Line
            // ----------------------------------------------------------
            if (line.QuoteSubId == 0 && line.RefEnqVendorAssignId > 0)
            {
                var enqBalQty = await _purchQuotationService.GetEnquiryItemBalQtyFromVendorAssignId(line.RefEnqVendorAssignId.Value);

                if (line.Qty > enqBalQty)
                {
                    await _JS.ToastrError(
                        $"Entered Qty ({line.Qty}) exceeds Enquiry Balance Qty ({enqBalQty})."
                    );
                    return false;   // ❌ STOP HERE
                }

                line.BalQty = line.Qty;
            }

            // ----------------------------------------------------------
            // CASE 2: Existing Quotation Line (Edit Mode)
            // ----------------------------------------------------------
            else if (line.QuoteSubId > 0)
            {
                var original = await _purchQuotationService
                    .GetQuoteSubItemDetailByQuoteSubIdAsync(line.QuoteSubId);

                if (original != null)
                {
                    decimal origBalQty = original.BalQty ?? 0;
                    decimal origQty = original.Qty ?? 0;
                    decimal alreadyTransacted = origQty - origBalQty;

                    // Qty cannot go below already transacted
                    if (line.Qty < alreadyTransacted)
                    {
                        await _JS.ToastrError(
                            $"Qty cannot be less than already transacted ({alreadyTransacted})."
                        );
                        return false;   // ❌ STOP HERE
                    }

                    // Recalculate balance
                    line.BalQty = (origBalQty + (line.Qty.Value - origQty));

                    if (line.BalQty < 0)
                        line.BalQty = 0;
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateQuoteLineAsync failed.");
            await _JS.ToastrError("An unexpected error occurred while validating the line.");
            return false;
        }
    }


