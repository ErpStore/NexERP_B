    private async Task CancelEdit(PurchaseQuoteSubVM? item, PurchaseQuoteVM? parentQuote)
    {
        try
        {
            if (item == null || parentQuote == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentQuote.PurchaseQuoteSubVM.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for purchase quote upsert QuoteSubId: {item?.QuoteSubId}");
            await _JS.ToastrError("Failed to cancel edit. Please try again.");
        }
    }
    private async Task RemoveRow(PurchaseQuoteSubVM item)
    {
        try
        {
            if (PurchaseQuoteVM.PurchaseQuoteSubVM.Count == 1 && item.QuoteSubId > 0)
            {
                await _JS.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if(item.ItemCancel)
            {
                await _JS.ToastrWarning("This item has already been cancelled and cannot be removed.");
                return;
            }

            if(PurchaseQuoteVM.IsCancel)
            {
                await _JS.ToastrWarning("This quotation has been cancelled and cannot be modified.");
                return;                
            }

            if (PurchaseQuoteVM.QuoteShortClose)
            {
                await _JS.ToastrError("This Quotation is already short closed. Row deletion is not allowed.");
                return;
            }

            if (item.ItemId == 0)
            {
                PurchaseQuoteVM.PurchaseQuoteSubVM.Remove(item);
                await _JS.ToastrSuccess("New item row removed successfully.");

                if (!PurchaseQuoteVM.PurchaseQuoteSubVM.Any())
                    PurchaseQuoteVM.PurchaseQuoteSubVM = new List<PurchaseQuoteSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(PurchaseQuoteVM);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for purchase quote QuoteSubId: {item?.QuoteSubId}");
            await _JS.ToastrError("Failed to remove the row. Please try again.");
        }
    }
    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in PurchaseQuoteVM.PurchaseQuoteSubVM)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _JS.ToastrError("Failed to reset row serial numbers.");
        }
    }
