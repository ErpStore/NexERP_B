    #region Material Requisition Operations

    private async Task UpsertMaterialRequisition()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            MaterialReqVMs.MaterialReqSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.PurchQty.HasValue || x.PurchQty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (! MaterialReqVMs.MaterialReqSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a Material Requisition without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in MaterialReqVMs.MaterialReqSubVMs)
            {
                bool isValid = await ValidatePRLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewPo = MaterialReqVMs.MreqId == 0;

            try
            {
                await _mreqService.UpsertMaterialReqAsync(MaterialReqVMs);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewPo)
                await _js.ToastrSuccess("PR/Indent saved successfully.");
            else
                await _js.ToastrSuccess("PR/Indent updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/materialRequisitionList");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "UpsertMaterialRequisition failed.");
            await _js.ToastrError("Error saving Material Requisition.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidatePRLineAsync(MaterialReqSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }


            if (!line.PurchQty.HasValue || line.PurchQty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Purchase Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            // Qty vs Po / Already Transacted validation
            if (line.MreqSubId == 0 && line.RefPoSubId > 0)
            {
                var poIndentBalQty = await _mreqService.GetPOItemIndentBalQtyFromPoSubId(line.RefPoSubId.Value);
                if (line.PurchQty > poIndentBalQty)
                {
                    line.PurchQty = poIndentBalQty;
                    line.BalQty = poIndentBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed PO Balance Qty ({poIndentBalQty}).");
                    return false;
                }
            }
            else if (line.MreqSubId > 0)
            {
                var original = await _mreqService.GetMaterialReqSubItemDetailByMreqSubIdAsync(line.MreqSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty.GetValueOrDefault();
                    decimal origQty = original.PurchQty.GetValueOrDefault();
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.PurchQty < alreadyTransacted)
                    {
                        line.PurchQty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.PurchQty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ValidatePRLineAsync failed.");
            await _js.ToastrError("Error Validate Material-Requisition line.");
            return false;
        }
    }

