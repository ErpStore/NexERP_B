    private async Task OnItemChanged(MaterialReqSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItemVM = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.CategoryName = item.CategoryName;
                subitem.UOM = item.MeasureUnit;

                if ( subitem.ItemId.HasValue)
                {
                    var rates = await _mreqService.GetBulkLastUnitPricesAsync(new List<int> { subitem.ItemId.Value },subitem.CustId.GetValueOrDefault());

                    if (rates.TryGetValue(subitem.ItemId.Value, out decimal rate))
                    {
                        subitem.UnitPrice = rate;
                    }
                }

                // 🔹 Fetch stock quantity for the selected store
                if (subitem.ItemId > 0)
                {
                    var stockDict = await _mreqService.GetStockForItemsAsync(
                        new List<int> { subitem.ItemId.Value },
                        MaterialReqVMs.StoreId ?? null
                    );

                    subitem.StockQty = stockDict.TryGetValue(subitem.ItemId.Value, out var qty) ? qty : 0m;
                }

                if (subitem.ItemId > 0)
                {
                    var count = await _mreqService.GetCorrespondenceAttachmentsCountAsync(subitem.ItemId.Value, "Item");
                    attachmentCounts[subitem.ItemId.Value] = count;
                }
            }
            else
            {
                // Reset when deselected
                subitem.SelectedItemVM = null;
                subitem.ItemId = null;
                subitem.ItemCode = null;
                subitem.ItemName = null;
                subitem.CategoryName = null;
                subitem.UOM = null;
                subitem.UnitPrice = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"OnItemChanged failed for ItemId: {item?.ItemId}");
            await _js.ToastrError("Failed to apply item selection. Please try again.");
