@page "/materialRequisition/create"
@page "/materialRequisition/update/{MreqId:int}"

@using V.SMART.Shared.Repository.IRepository.IMasterRepository.IAdmins
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject IMaterialReqService _mreqService
@inject ILoggingService _logs
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject ReportService reportService
@inject IUserAuthorityRepository userAuthority

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value" >
</BsModal>

<DetailsModal Title="Sales Order Details"
              Columns="@PoColumns"
              ColumnFields="@PoFields"
              HiddenColumns="@PoHiddenColumns"
              Data="@PoData"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="OnPoSelectedAsync">
</DetailsModal>

<RolItemDetailModel Title="Indent For ROL Items"
                    Columns="@RolItemColumns"
                    ColumnFields="@RolItemFields"
                    HiddenColumns="@RolItemHiddenColumns"
                    Data="@RolItemData"
                    IsVisible="@ISRolItemVisible"
                    IsVisibleChanged="@((val) => ISRolItemVisible = val)"
                    OnSelectedItems="OnrolItemSelectedAsync">
</RolItemDetailModel>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Customer")
    {
        <CustomerUpsert isCustModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
            refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
  position: sticky;
  right: 0;
  background-color: #f8f9fa;
  z-index: 10;
}
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if (MaterialReqVMs.MreqCancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }

            @if (MaterialReqVMs.ShortClose)
            {
                <div class="cancelWatermark">SHORT-CLOSED</div>
            }

            @if (IsIndentGeneratedFromBOM && !MaterialReqVMs.MreqCancel && !MaterialReqVMs.ShortClose)
            {
                <div class="cancelWatermark">From BOM</div>
            }

            @if (IsIndentGeneratedFromMRA && !MaterialReqVMs.MreqCancel && !MaterialReqVMs.ShortClose)
            {
                <div class="cancelWatermark">From MRA</div>
            }

            <PageHeader TitleText="@(MaterialReqVMs.MreqId > 0 ? "Update Material Requisition" : "Create Material Requisition")"
                TitleIcon="bi bi-tag"
                Breadcrumbs="@MaterialReqFormBreadcrumbs" />

            <div class="card-body bg-light">

                <EditForm Model="MaterialReqVMs" OnValidSubmit="UpsertMaterialRequisition">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">

                        <!-- Purchase / Sub-Con Toggle -->
                        <div class="col-12 col-md-6">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-body d-flex justify-content-around align-items-center">

                                    <!-- Purchase Toggle -->
                                    <div class="form-check form-switch d-flex align-items-center">
                                        <input class="form-check-input" type="checkbox" id="PurchaseSwitch"
                                               checked="@MaterialReqVMs.IsPurchOrSubCon"
                                               @onchange="OnPurchToggle"
                                               disabled ="@IsSomeItemsTransMade"/>
                                        <label class="form-check-label fw-semibold ms-2 @(MaterialReqVMs.IsPurchOrSubCon ? "text-success" : "text-muted")"
                                               for="PurchaseSwitch">
                                            <i class="bi bi-cart-fill me-1"></i> Purchase
                                        </label>
                                    </div>

                                    <!-- Sub-Contract Toggle -->
                                    <div class="form-check form-switch d-flex align-items-center">
                                        <input class="form-check-input" type="checkbox" id="SubConSwitch"
                                               checked="@(!MaterialReqVMs.IsPurchOrSubCon)"
                                               @onchange="OnSubConToggle"
                                               disabled ="@IsSomeItemsTransMade"/>
                                        <label class="form-check-label fw-semibold ms-2 @(!MaterialReqVMs.IsPurchOrSubCon ? "text-danger" : "text-muted")"
                                               for="SubConSwitch">
                                            <i class="bi bi-people-fill me-1"></i> Sub-Contract
                                        </label>
                                    </div>

                                </div>
                                <ValidationMessage For="@(() => MaterialReqVMs.IsPurchOrSubCon)" />
                            </div>
                        </div>

                        <!-- Open PO Toggle -->
                        <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">

                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="IsManualSwitch"
                                        disabled="@(MaterialReqVMs.MaterialReqSubVMs.Any(x => x.ItemId > 0))"
                                        checked="@MaterialReqVMs.IsManual"
                                        @onchange="(e) => ManualMaterialReqToggle(e)" />
                                <label class="form-check-label fw-semibold @(MaterialReqVMs.IsManual ? "text-primary" : "")"
                                        for="IsManualSwitch">
                                    <i class="bi bi-folder2-open me-1"></i> Manual PR / General
                                </label>
                            </div>
                            <ValidationMessage For="@(() => MaterialReqVMs.IsManual)" />
                            
                        </div>

                        <!-- Correspondence Status -->
                        <div class="col-12 col-md-3 d-flex justify-content-end align-items-center">
                            @if (MaterialReqVMs.MreqId > 0 && !string.IsNullOrWhiteSpace(MaterialReqVMs.MReqNo))
                            {
                                <CorrespondenceStatus ReferenceType="@ScreenName"
                                                      ReferenceId="@MaterialReqVMs.MreqId"
                                                      ReferenceTypeName="@MaterialReqVMs.MReqNo" />
                            }
                        </div>

                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Customer Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Document Details</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Customer")'>
                                        <i class="bi bi-person-add me-1"></i> Add Customer
                                    </button>
                                </div>


                                <div class="card-body">

                                    <!--Mreq No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Purchase Req No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="Purchase Req No."
                                                            maxlength="30"
                                                            @bind-Value="@MaterialReqVMs.MReqNo"
                                                            readonly/>
                                                <span class="input-group-text rounded-3">@MaterialReqVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => MaterialReqVMs.MReqNo)" />
                                        </div>
                                    </div>

                                    <!-- Mreq Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Purchase Req Dt.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                        @bind-Value="@MaterialReqVMs.MreqDate" />
                                            <ValidationMessage For="@(() => MaterialReqVMs.MreqDate)" />
                                        </div>
                                    </div>

                                    <!-- Reference Sales order Det -->
                                    @if (MaterialReqVMs != null && !MaterialReqVMs.MreqCancel && !MaterialReqVMs.ShortClose
                                        && !MaterialReqVMs.IsManual && !IsIndentGeneratedFromMRA  && !IsIndentGeneratedFromBOM)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. PO</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowPoDetails"> 
                                                    <i class="bi bi-list-ul me-1"></i> Sales Order Details
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Reference Re order  Item Det -->
                                    @if (MaterialReqVMs != null && !MaterialReqVMs.MreqCancel && !MaterialReqVMs.ShortClose
                                                                    && MaterialReqVMs.IsManual && !IsIndentGeneratedFromMRA && !IsIndentGeneratedFromBOM)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small> For ROL Items</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowRolItemDetails">
                                                    <i class="bi bi-list-ul me-1"></i> ReOrder Level Item Details
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- =================== Material Requisition Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Store And Other Details</span>

                                    @if (MaterialReqVMs.MreqId > 0 && (CanCreate || CanEdit))
                                    {
                                        <div class="d-flex gap-2">
                                            @if (MaterialReqVMs.MaterialReqSubVMs == null ||
                                                        !MaterialReqVMs.MaterialReqSubVMs.Any(x => x.ItemCancel))
                                            {
                                                <!-- Cancel / Revert -->
                                                <button type="button"
                                                class="btn btn-sm rounded-3 @(MaterialReqVMs.MreqCancel ? "btn-success" : "btn-danger")"
                                                @onclick="Cancel"
                                                disabled ="@MaterialReqVMs.ShortClose">

                                                    @if (!MaterialReqVMs.MreqCancel)
                                                    {
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        <span>Cancel</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                        <span>Revert</span>
                                                    }
                                                </button>
                                            }
                                            <!-- Short Closed / Re-Open -->
                                            <button type="button"
                                                    class="btn btn-sm rounded-3 @(MaterialReqVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                    @onclick="() => AskToShortCloseAsync(MaterialReqVMs)"
                                                    disabled="@(MaterialReqVMs.MreqCancel)">

                                                @if (!MaterialReqVMs.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Closed</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>

                                        </div>
                                    }
                                </div>


                                <div class="card-body">
                                    
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Stock Display Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select value="@selectedStoreValue"
                                                    @onchange="OnStoreChanged"
                                                    class="form-select form-select-sm rounded-3 w-100"
                                                    id="StoreId">
                                                <option value="-1">-- All Stores --</option>
                                                @foreach (var store in Stores)
                                                {
                                                    <option value="@store.StoreId">@store.StoreName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => MaterialReqVMs.StoreId)" />

                                        </div>
                                    </div>

                                    <!-- Kind attention -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Person Name</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            @* <InputText list="personList" class="form-control form-control-sm rounded-3 w-100"
                                                        placeholder="Select or enter Person"
                                                        @bind-Value="MaterialReqVMs.KindAttn" />

                                            <!-- Datalist for existing personList -->
                                            <datalist id="personList">
                                                @foreach (var user in UserList)
                                                {
                                                    <option value="@user"></option>
                                                }
                                            </datalist> *@

                                            <MudAutocomplete T="Staff"
                                                             Label="Person Name"
                                                             Variant="Variant.Outlined"
                                                             Dense="true"
                                                             Clearable="true"
                                                             ResetValueOnEmptyText="true"
                                                             SearchFunc="SearchStaff"
                                                             ToStringFunc="@(x => x?.StaffName ?? string.Empty)"
                                                             @bind-Value="SelectedStaff"
                                                             MaxItems="50" />

                                            <ValidationMessage For="@(() => MaterialReqVMs.KindAttn)" />
                                        </div>
                                    </div>

                                   <!-- Department -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Department</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputText list="departmentsList" class="form-control form-control-sm rounded-3 w-100"
                                                        placeholder="Select or enter department"
                                                        @bind-Value="MaterialReqVMs.Department" />
                                            <datalist id="departmentsList">
                                                @foreach (var dept in ExistingDepartments)
                                                {
                                                    <option value="@dept"></option>
                                                }
                                            </datalist>

                                            <ValidationMessage For="@(() => MaterialReqVMs.Department)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="MaterialReqVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => MaterialReqVMs.MainRemark)" />

                                        </div>
                                    </div>

                                    @if(MaterialReqVMs.MreqCancel)
                                    {
                                        <!-- Cancel Remarks -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Cancel Reason</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="MaterialReqVMs.CancelReason"></textarea>
                                                <ValidationMessage For="@(() => MaterialReqVMs.CancelReason)" />
                                            </div>
                                        </div>

                                        <!-- Cancel Date -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-danger fw-bold">
                                                <small>Cancel Date</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="MaterialReqVMs.CancelDate"></textarea>
                                                <ValidationMessage For="@(() => MaterialReqVMs.CancelDate)" />
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" 
                                    style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                               
                                <div class="card-header bg-primary-subtle text-dark">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                                        <!-- Title -->
                                        <span class="fw-bold fs-6">Item Details</span>

                                        <!-- Right Controls -->
                                        <div class="d-flex flex-wrap align-items-center gap-2">

                                            <!-- Due Date + Update -->
                                            <div class="d-flex align-items-center gap-2">
                                                <label class="mb-0 fw-semibold">Due Date:</label>
                                                <InputDate @bind-Value="DueDate" class="form-control form-control-sm" style="width:150px;" />
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="UpdateDueDate">
                                                    <i class="bi bi-pencil-square me-1"></i> Update
                                                </button>
                                            </div>

                                            <!-- Add Item Button -->
                                             <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>

                                        </div>
                                    </div>
                                </div>


                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" 
                                               style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:250px;">Customer Name</th>
                                                    <th style="width:250px;">Item Code/Part No.</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:120px;">Qty Req.</th>
                                                    <th style="width:130px;">Bal Qty</th>
                                                    <th style="width:130px;">Stock Qty</th>
                                                    <th style="width:170px;">Vendor</th>
                                                    <th style="width:130px;">Category</th>
                                                    <th style="width:130px;">Unit Price</th>
                                                    <th style="width:130px;">Amount</th>
                                                    <th style="width:130px;"> Due Date</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:150px;">Cost-Center</th>
                                                    <th style="width:170px;">Sales Order No.</th>
                                                    <th style="width:150px;">Sales Order Dt. </th>
                                                    @if (!MaterialReqVMs.MreqCancel && (MreqId.HasValue || MreqId > 0))
                                                    {
                                                        <th style="width:130px;">Item Cancel</th>
                                                        <th style="width:180px">Cancel Reason</th>
                                                    }
                                                    @if (!MaterialReqVMs.MreqCancel && !MaterialReqVMs.ShortClose)
                                                    {
                                                        <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                    }
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in MaterialReqVMs.MaterialReqSubVMs)
                                                {
                                                    <tr @key="subitem" class="@(subitem.ItemCancel ? "table-danger text-danger fw-bold" : "")">
                                                        <td>@subitem.SlNo</td>
                                                        <td>
                                                            @if (subitem.IsEditable && subitem.CanEditItem)
                                                            {
                                                                <MudAutocomplete T="CustomerVM"
                                                                    Value="subitem.SelectedCustomerVM"
                                                                    ValueChanged="@(async item => await OnCustomerChanged(subitem, item))"
                                                                    ToStringFunc="@(item => item?.CustName ?? string.Empty)"
                                                                    SearchFunc="SearchCustomers"
                                                                    Dense="true"
                                                                    Variant="Variant.Outlined"
                                                                    Placeholder="Search Customer"
                                                                    Title="Search Atleast 3 Letters in Customer Name"
                                                                    Class="w-100 autocomplete-sm"
                                                                    MaxItems="50" />
                                                                <ValidationMessage For="@(() => subitem.CustomerName)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.CustomerName</span>
                                                            }
                                                        </td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @if (subitem.IsEditable && subitem.CanEditItem)
                                                                    {
                                                                        <MudAutocomplete T="ItemVM"
                                                                            Value="subitem.SelectedItemVM"
                                                                            ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                            ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                            SearchFunc="SearchItems"
                                                                            Dense="true"
                                                                            Variant="Variant.Outlined"
                                                                            Placeholder="Search Item Code"
                                                                            Title="Search Atleast 3 Letters in Item-Code"
                                                                            Class="w-100 autocomplete-sm"
                                                                            MaxItems="50" />
                                                                        <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @subitem.ItemCode
                                                                    }
                                                                </div>

                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                            Size="Size.Small"
                                                                            Color="Color.Primary"
                                                                            OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                            Edge="Edge.End"
                                                                            Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.UOM</td>

                                                        <!-- Purchase Qty -->
                                                        <td>
                                                            @if (subitem.IsEditable && !IsIndentGeneratedFromMRA && !IsIndentGeneratedFromBOM) 
                                                            {
                                                                  <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Purch Qty"
                                                                           step="any"
                                                                           title="Enter Purch Qty"
                                                                           @bind="subitem.PurchQty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.PurchQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.PurchQty?.ToString("F3")</span>
                                                            }
                                                        </td>

                                                        <td>
                                                            <span>@subitem.BalQty?.ToString("F3")</span>
                                                        </td>

                                                        <td>
                                                            <span class="text-danger">@subitem.StockQty.ToString("F3")</span>
                                                        </td>

                                                        <td>
                                                            @if (subitem.IsEditable && subitem.CanEditItem)
                                                            {
                                                                <MudAutocomplete T="VendorVM"
                                                                    Value="subitem.SelectedVendorVM"
                                                                    ValueChanged="@(async item => await OnVendorChanged(subitem, item))"
                                                                    ToStringFunc="@(item => item?.VendorName ?? string.Empty)"
                                                                    SearchFunc="SearchVendors"
                                                                    Dense="true"
                                                                    Variant="Variant.Outlined"
                                                                    Placeholder="Search Vendor Name"
                                                                    Title="Search Atleast 3 Letters in Vendor Name"
                                                                    Class="w-100 autocomplete-sm"
                                                                    MaxItems="50" />
                                                                <ValidationMessage For="@(() => subitem.VendorCode)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.VendorName</span>
                                                            }
                                                        </td>

                                                        <td>
                                                            <span>@subitem.CategoryName</span>
                                                        </td>

                                                        <!-- Unit Price -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" step="any"
                                                                        class="form-control form-control-sm" placeholder="Price" title="Enter Unit Price"
                                                                        @bind="subitem.UnitPrice" />
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>

                                                        <!-- Line Gross -->
                                                        <td>
                                                            @FormatDecimal(subitem.TotalGross)
                                                        </td>

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputDate @bind-Value="subitem.DueDate"
                                                                    class="form-control form-control-sm" 
                                                                    placeholder="Enter Due Date" />
