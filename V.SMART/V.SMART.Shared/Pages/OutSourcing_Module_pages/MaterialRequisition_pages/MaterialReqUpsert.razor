                                                                        <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                                @onclick="async () => await SaveRow(subitem)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-check-lg"></i>
                                                                        </button>

                                                                        <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                                @onclick="async () => await CancelEdit(subitem, MaterialReqVMs)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-x-lg"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                                @onclick="async () => await EditRowAsync(subitem)"
                                                                                disabled="@subitem.ItemCancel">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>

                                                                        @if (!IsIndentGeneratedFromMRA)
                                                                        {
                                                                            <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                                    @onclick="async () => await RemoveRow(subitem)"
                                                                                    disabled="@subitem.ItemCancel">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                        </td>   

                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (MaterialReqVMs.MaterialReqSubVMs?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        <td colspan="5" class="text-end fw-bold">
                                                            Totals:
                                                        </td>
                                                        <td>@MaterialReqVMs.MaterialReqSubVMs.Sum(x => x.PurchQty)?.ToString("F3")</td>
                                                        <td>@MaterialReqVMs.MaterialReqSubVMs.Sum(x => x.BalQty)?.ToString("F3")</td>
                                                        <td colspan="3"> </td>
                                                        <td><span>Avg:</span> @FormatDecimal(MaterialReqVMs.MaterialReqSubVMs.Average(x => x.UnitPrice))</td>
                                                        <td>@FormatDecimal(MaterialReqVMs.MaterialReqSubVMs.Sum(x => x.TotalGross))</td>
                                                        <td colspan="8"> </td>
                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>

                                    @if(!MaterialReqVMs.MreqCancel && !IsIndentGeneratedFromMRA && !IsIndentGeneratedFromBOM && !MaterialReqVMs.ShortClose)
                                    {
                                        <div class="mt-2 text-start">
                                            <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                <i class="bi bi-plus-circle me-1"></i> Add Item
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Action Buttons -->
                            @if (CanCreate || CanEdit)
                            {
                                @if(!MaterialReqVMs.MreqCancel && !MaterialReqVMs.ShortClose)
                                {
                                    <div class="col-6 col-md-3 mt-3">
                                        <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                            <i class="bi bi-floppy2-fill me-1"></i> @(MaterialReqVMs.MreqId > 0 ? "Update" : "Create")
                                        </button>
                                    </div>
                                }
                            }

                            <div class="col-6 col-md-3 mt-3">
                                <SmartBackButton Url="/materialRequisitionList" />
                            </div>

                            @if (MaterialReqVMs.MreqId > 0 && !MaterialReqVMs.IsAuthorized && !MaterialReqVMs.IsRejected)
                            {
                                <div class="col-6 col-md-3 mt-3">
                                    <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-3">
                                        Pending Authorization
                                    </span>
                                </div>
                            }
                            else if(MaterialReqVMs.MreqId > 0 && MaterialReqVMs.IsRejected)
                            {
                                <div class="col-6 col-md-3 mt-3">
                                    <span class="badge bg-danger text-dark fs-6 px-3 py-2 rounded-3">
                                        PR Rejected
                                    </span>
                                </div>
                            }
                               
                            @if ((MreqId > 0 && CanEdit && (!Autharization || MaterialReqVMs.IsAuthorized)))
                            {
                                <div class="col-12 col-md-3">
                                    <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                        <i class="bi bi-printer me-1"></i>Print
                                    </button>
                                </div>
                            }
                            else if (Autharization && !MaterialReqVMs.IsAuthorized)
                            {
                                <div class="col-12 col-md-3">
                                    <button class="btn btn-danger" disabled title="Authorization required to generate PDF">
                                        <i class="bi bi-file-earmark-pdf"></i> Authorization Required
                                    </button>
                                </div>
                            }

                        </div>
                    </div>
                   
                </EditForm>

            </div>
        </div>
    </div>
} 


