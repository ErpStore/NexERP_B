    private async Task AskToShortCloseAsync(MaterialReqVM materialReq)
    {
        try
        {
            if (materialReq == null)
            {
                await _js.ToastrError("Invalid Materail Requisition selected.");
                return;
            }

            if (!MreqId.HasValue || MreqId == 0)
            {
                await _js.ToastrError("Short Closed is not allowed before saving the Material Requisition.");
                return;
            }

            if (materialReq.PRTally)
            {
                await _js.ToastrWarning("This PR/Indent is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (materialReq.PRTally)
            {
                await _js.ToastrWarning("This Material Requisition is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (materialReq.MreqCancel)
            {
                var subs = await _mreqService.GetMaterialReqSubByMreqIdAsync(MaterialReqVMs.MreqId); 

                foreach (var sub in subs)
                {
                    if(sub.RefBomId.GetValueOrDefault()> 0)
                        await  _mreqService.ValidateBOMBalanceBeforeRevertAsync(sub);

                    else if(sub.RefPoSubId > 0)
                        await _mreqService.ValidatePoBalanceBeforeRevertAsync(sub);
                }
            }

            if (!materialReq.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Material requisition?";
                btnText = "Short Closed";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Material Requisition?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while AskToShortCloseAsync Material Requisition.");
            await _logs.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }



    private async Task Cancel()
    {
        try
        {

            if (!MreqId.HasValue || MreqId == 0)
            {
                await _js.ToastrError("Cancellation is not allowed before saving the Material Requisition.");
                return;
            }

            if (MaterialReqVMs.ShortClose)
            {
                await _js.ToastrError("PR/Indent is already short closed. You can't cancel it.");
                return;
            }

            if (MaterialReqVMs.MaterialReqSubVMs?.Any(x => x.ItemCancel) == true)
            {
                await _js.ToastrError("Some items are already cancelled. Complete PR/Indent cancellation is not allowed.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some items transactions are made! You can't cancel this Material Requisition.");
                return;
            }


            if (MaterialReqVMs.MreqCancel)
            {

                var subs = await _mreqService.GetMaterialReqSubByMreqIdAsync(MaterialReqVMs.MreqId);

                foreach (var sub in subs)
                {
                    if(sub.RefBomId.GetValueOrDefault()> 0)
                        await  _mreqService.ValidateBOMBalanceBeforeRevertAsync(sub);

                    else if (sub.RefPoSubId.GetValueOrDefault() > 0)
                        await _mreqService.ValidatePoBalanceBeforeRevertAsync(sub);
                }
            }

            if (!MaterialReqVMs.MreqCancel)
            {
                ModalTitle = "Are you sure you want to cancel this Material Requisition?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to revert this Material Requisition?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
         catch (InvalidOperationException ex)
        {
            if (MreqId.HasValue || MreqId > 0)
                await LoadExistingMReq(MreqId.Value);

            await _js.ToastrWarning(ex.Message);
            await _logs.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error while processing the Material Requisition cancel request.");
            await _logs.LogDeveloperError(ex, "Error in Cancel() method");
        }
    }

    private async Task OnItemCancelChanged(MaterialReqSubVM subitem)
    {
        try
        {

            if (subitem.MreqSubId == 0)
            {
                await _js.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if (subitem.PurchQty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _js.ToastrError("Item cannot be cancelled — PR transactions have been made on it.");
                return;
            }

            if (MaterialReqVMs.MreqCancel)
            {
                await _js.ToastrError("PR is already Cancel. You can't cancel Item.");
                return;
            }

            if(subitem.ItemCancel)
                await _mreqService.ValidateBeforeRevertAsync(subitem.MreqSubId);

            var (CanItemCancel, message) = await _mreqService.CanPRItemCancelCheckAsync(subitem);

            if (!CanItemCancel)
            {
                await _js.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _js.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _js.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            await LoadExistingMReq(MaterialReqVMs.MreqId);
            await _js.ToastrWarning(ex.Message);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Item.Cancel method");
            await _logs.LogDeveloperError(ex, "Error in Item Cancel in Material Requisition");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;

                case "Cancel":
                case "Revert":
                    await CancelPR();
                    break;

                case "ItemCancel":
                    await CancelItem(rowToCancel);
                    break;

                case "ShortClose":
                    await ShortCloseQuotation();
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

