    #region Stock Based Store

    private async Task OnStoreChanged(ChangeEventArgs e)
    {
        try
        {
            selectedStoreValue = e.Value?.ToString() ?? "-1";

            if (int.TryParse(selectedStoreValue, out var parsedId) && parsedId != -1)
                MaterialReqVMs.StoreId = parsedId;
            else
                MaterialReqVMs.StoreId = null; // All Stores

            if (MaterialReqVMs.MaterialReqSubVMs == null || !MaterialReqVMs.MaterialReqSubVMs.Any())
            {
                await _js.ToastrInfo("No sub-items available to update stock.");
                return;
            }

            var itemIds = MaterialReqVMs.MaterialReqSubVMs
                .Where(s => s.ItemId.HasValue)
                .Select(s => s.ItemId!.Value)
                .Distinct()
                .ToList();

            if (itemIds.Count == 0)
            {
                await _js.ToastrInfo("No valid items found to update stock for this store.");
                return;
            }

            var stockDict = await _mreqService.GetStockForItemsAsync(itemIds, MaterialReqVMs.StoreId);

            foreach (var sub in MaterialReqVMs.MaterialReqSubVMs)
            {
                if (sub.ItemId.HasValue && stockDict.TryGetValue(sub.ItemId.Value, out var qty))
                    sub.StockQty = qty;
                else
                    sub.StockQty = 0;
            }

            await _js.ToastrSuccess("Stock quantities updated based on selected store.");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error occurred in OnStoreChanged while updating stock quantities.");
            await _js.ToastrError("An unexpected error occurred while updating stock. Please try again.");
        }
    }

