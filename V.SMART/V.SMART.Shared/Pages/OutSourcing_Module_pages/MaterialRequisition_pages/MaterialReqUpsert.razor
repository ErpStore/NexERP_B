            }

            MaterialReqVMs.MreqCancel = isCancelling;
            MaterialReqVMs.CancelDate = isCancelling ? DateTime.Now : null;
            MaterialReqVMs.CancelReason = isCancelling ? cancelReason : string.Empty;
            MaterialReqVMs.CancelBy = isCancelling ? username : string.Empty;

