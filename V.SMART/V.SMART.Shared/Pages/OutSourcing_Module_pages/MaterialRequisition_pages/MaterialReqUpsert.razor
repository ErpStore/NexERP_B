    private Task<IEnumerable<Staff>> SearchStaff(string value, CancellationToken token)
    {
        IEnumerable<Staff> result = StaffList;

        if (!string.IsNullOrWhiteSpace(value))
        {
            result = StaffList.Where(x => x.StaffName.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(result);
    }
