    private async Task CancelItem(MaterialReqSubVM rowToCancel)
    {
        if (rowToCancel == null || isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            bool isCancelling = !rowToCancel.ItemCancel;

            if (isCancelling && string.IsNullOrWhiteSpace(cancelReason))
            {
                await _js.ToastrWarning("Cancel reason is required.");
                return;
            }

            rowToCancel.ItemCancel = isCancelling;
            rowToCancel.ItemCancelReason = isCancelling ? cancelReason : string.Empty;

            await _mreqService.UpdateItemCancelAndAddorRevertAsync(rowToCancel);

            string actionText = isCancelling ? "Cancelled" : "Reverted";

            await _logs.LogUserAction(
                username,
                machine,
                ip,
                screen: "Material Requisition",
                action: $"{actionText} Material Req No: {MaterialReqVMs.MReqNo}, ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: isCancelling
                    ? $"Reason: {cancelReason}"
                    : "Item revert operation"
            );

            MaterialReqVMs = await _mreqService.GetMreqByMreqIdAsync(MaterialReqVMs.MreqId);

            await ResetSlno();

            await _js.ToastrSuccess($"Item has been {actionText.ToLower()} successfully.");

            cancelReason = string.Empty;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrWarning(ex.Message);

            MaterialReqVMs = await _mreqService.GetMreqByMreqIdAsync(MaterialReqVMs.MreqId);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the item.");
            await _logs.LogDeveloperError(ex, $"Item Cancel/Revert failed for MreqId: {MaterialReqVMs?.MreqId}");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task CancelPR()
    {
         if (isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (MaterialReqVMs == null || MaterialReqVMs.MreqId == 0)
            {
                await _js.ToastrWarning("Please select a valid Material Requsition.");
