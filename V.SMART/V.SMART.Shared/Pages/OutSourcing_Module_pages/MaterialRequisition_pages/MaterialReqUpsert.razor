    #endregion


    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, MaterialReqSubVM SubVM)
    {
        try
        {
            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.PurchQty = 0;
                SubVM.BalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW Po line
            if (SubVM.MreqSubId == 0)
            {
                if (SubVM.RefPoSubId > 0 && (!SubVM.MainAssyId.HasValue || SubVM.MainAssyId == 0))
                {
                    var poBalQty = await _mreqService.GetPOItemIndentBalQtyFromPoSubId(SubVM.RefPoSubId.Value);

                    if (newQty <= poBalQty)
                    {   
                        SubVM.PurchQty  = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.PurchQty = poBalQty;
                        SubVM.BalQty = poBalQty;
                        await _js.ToastrWarning($"Qty can't be greater than Po Balance Qty ({poBalQty}).");
                    }
                }
                else
                {
                    SubVM.PurchQty = newQty;
                    SubVM.BalQty = newQty;
                }
            }

            // EXISTING Indent line
            else
            {
                var original = await _mreqService.GetMaterialReqSubItemDetailByMreqSubIdAsync(SubVM.MreqSubId);
                if (original == null) return;

                var alreadyTransacted = original.PurchQty - original.BalQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.PurchQty = alreadyTransacted;
                    SubVM.BalQty = 0;
                    await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefPoSubId > 0)
                {
                    var poBalQty = await _mreqService.GetPOItemIndentBalQtyFromPoSubId(SubVM.RefPoSubId.Value);
                    var maxAllowedQty = original.PurchQty + poBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.PurchQty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty - alreadyTransacted;
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.PurchQty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
                else
                {
                    SubVM.PurchQty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted;
                }
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"OnQtyChange failed for MreqSubId: {SubVM?.MreqSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    #endregion


    #region Row Operations

    private async Task<bool> ValidateRowAsync(MaterialReqSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (row.PurchQty == null || row.PurchQty <= 0)
                errors.Add("Purchase Quantity must be greater than 0.");

            if (row.UnitPrice == null || row.UnitPrice <= 0)
                errors.Add("Unit Price must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await _logs.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = MaterialReqVMs.MaterialReqSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await _logs.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (IsIndentGeneratedFromMRA || IsIndentGeneratedFromBOM)
                return;

            if (!await ValidateLastRowAsync())
                return;

            // Get previous row (last row)
            var lastRow = MaterialReqVMs.MaterialReqSubVMs.LastOrDefault();

            var newRow = new MaterialReqSubVM
            {
                MreqId = MaterialReqVMs.MreqId,
                CustId = lastRow?.CustId,
                CustomerName = lastRow?.CustomerName,
                SelectedCustomerVM = lastRow?.SelectedCustomerVM,

                IsEditable = true
            };

            MaterialReqVMs.MaterialReqSubVMs.Add(newRow);

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await _logs.LogDeveloperError(ex, "AddRow failed.");
        }
    }


    private async Task SaveRow(MaterialReqSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            if (IsIndentGeneratedFromMRA || IsIndentGeneratedFromBOM)
                return;

            if (!MaterialReqVMs.MaterialReqSubVMs.Any(x => x.IsEditable))
            {
                var lastRow = MaterialReqVMs.MaterialReqSubVMs.LastOrDefault();

                var newRow = new MaterialReqSubVM
                {
                    MreqId = MaterialReqVMs.MreqId,
                    CustId = lastRow?.CustId,
                    CustomerName = lastRow?.CustomerName,
                    SelectedCustomerVM = lastRow?.SelectedCustomerVM,

                    IsEditable = true
                };

                MaterialReqVMs.MaterialReqSubVMs.Add(newRow);
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"SaveRow failed for MreqSubId: {item?.MreqSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(MaterialReqSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItemVM == null && item.ItemId > 0)
            {
                item.SelectedItemVM = await _mreqService.GetItemByItemIdAsync(item.ItemId);
            }

            if(item.SelectedVendorVM == null && item.VendorCode>0)
            {
                item.SelectedVendorVM = await _mreqService.GetVenderByVendorCodeAsync(item.VendorCode);
            }

            if(item.SelectedCustomerVM == null && item.CustId>0)
            {
                item.SelectedCustomerVM = await _mreqService.GetCustomerByIdAsync(item.CustId.Value);
            }


        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"EditRowAsync failed for MreqSubId: {item?.MreqSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(MaterialReqSubVM? item, MaterialReqVM? parentMaterialReq)
    {
        try
        {
            if (item == null || parentMaterialReq == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.PurchQty.HasValue || item.PurchQty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentMaterialReq.MaterialReqSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CancelEdit failed for MreqSubId: {item?.MreqSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(MaterialReqSubVM item)
    {
        try
        {
            if (MaterialReqVMs.MaterialReqSubVMs.Count == 1 && item.MreqSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if ((item.PurchQty ?? 0) != (item.BalQty ?? 0))
            {
                await _js.ToastrWarning("This row cannot be deleted because some transactions are done.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if (item.ItemId == 0)
            {
                MaterialReqVMs.MaterialReqSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!MaterialReqVMs.MaterialReqSubVMs.Any())
                    MaterialReqVMs.MaterialReqSubVMs = new List<MaterialReqSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"RemoveRow failed for MreqSubId: {item?.MreqSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in MaterialReqVMs.MaterialReqSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to reset row serial numbers.");
        }
    }

    private async Task UpdateDueDate()
    {
        try
        {
            if (DueDate == null)
                return;

            foreach (var subItem in MaterialReqVMs.MaterialReqSubVMs)
            {
                subItem.DueDate = DueDate.Value;
            }
            StateHasChanged();
        }
        catch(Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to Update DueDate.");
        }
    }

