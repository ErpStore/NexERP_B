    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.MreqSubId > 0)
            {
                await _mreqService.DeleteAndResequenceAsync(rowToDelete, MaterialReqVMs);

                MaterialReqVMs = await _mreqService.GetMreqByMreqIdAsync(MaterialReqVMs.MreqId);
            }
            else
            {
                MaterialReqVMs.MaterialReqSubVMs.Remove(rowToDelete);

                if (!MaterialReqVMs.MaterialReqSubVMs.Any())
                {
                    MaterialReqVMs.MaterialReqSubVMs.Add(new MaterialReqSubVM
                    {
                        MreqId = MaterialReqVMs.MreqId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < MaterialReqVMs.MaterialReqSubVMs.Count; i++)
                        MaterialReqVMs.MaterialReqSubVMs[i].SlNo = i + 1;
                }
            }
            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }


        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"Error confirming deletion for MreqId: {MaterialReqVMs.MreqId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

