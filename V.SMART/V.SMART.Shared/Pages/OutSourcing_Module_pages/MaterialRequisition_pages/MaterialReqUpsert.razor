    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (MaterialReqVMs.MaterialReqSubVMs == null)
            MaterialReqVMs.MaterialReqSubVMs = new List<MaterialReqSubVM>();

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .Distinct()
                .ToList();

            if (!itemIds.Any())
                return;

            var stockDict = await _mreqService.GetStockForItemsAsync(itemIds, null);

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                if (itemId == 0)
                    continue;

                int custId = item.ContainsKey("CustId") && item["CustId"] != null
                    ? Convert.ToInt32(item["CustId"])
                    : 0;

                var priceDict = await _mreqService.GetBulkLastUnitPricesAsync(new List<int> { itemId }, custId);

                int? RefPoSubId = item.ContainsKey("RefPoSubId") && item["RefPoSubId"] != null
                    ? Convert.ToInt32(item["RefPoSubId"])
                    : (int?)null;

                int? RefPoId = item.ContainsKey("RefPoId") && item["RefPoId"] != null
                    ? Convert.ToInt32(item["RefPoId"])
                    : (int?)null;

                if (MaterialReqVMs.MaterialReqSubVMs.Any(x => x.ItemId == itemId && x.RefPoSubId == RefPoSubId))
                    continue;

                decimal stockQty = stockDict.TryGetValue(itemId, out var stock) ? stock : 0;

                var balQty = item.ContainsKey("BalQty") && item["BalQty"] != null
                    ? Convert.ToDecimal(item["BalQty"])
                    : 0;

                var subVm = new MaterialReqSubVM
                {
                    RefPoId = RefPoId,
                    RefPoSubId = RefPoSubId,
                    CustId = custId,
                    CustomerName = item.ContainsKey("CustName") ? item["CustName"]?.ToString() : "",
                    RefPoNo = item.ContainsKey("PoNo") ? item["PoNo"]?.ToString() : "",
                    RefPoDate = item.ContainsKey("PoDate") && item["PoDate"] != null
                        ? Convert.ToDateTime(item["PoDate"])
                        : null,

                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    UOM = item.ContainsKey("MeasureUnit") ? item["MeasureUnit"]?.ToString() : "",
                    CategoryName = item.ContainsKey("Category") ? item["Category"]?.ToString() : "",

                    PurchQty = balQty,
                    BalQty = balQty,

                    StockQty = stockQty,

                    UnitPrice = priceDict.TryGetValue(itemId, out var price) ? price : 0,

                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                        ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                        : (int?)null,

                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",
                    IsEditable = true
                };

                MaterialReqVMs.MaterialReqSubVMs.Add(subVm);
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _js.ToastrError("Error processing selected Sales Order items.");
        }
    }

