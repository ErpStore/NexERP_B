        }

        return Task.CompletedTask;
    }


    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(MreqId.GetValueOrDefault(), "PurchReq.frx", "MReqId", MaterialReqVMs.MreqCancel, ScreenName, "Sp_Print_MaterialReq");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf in MaterialReq");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in MaterialReq.");
        }
        finally
        {
            isProcessing = false;
        }
    }
