    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        isProcessing = true;

        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            Stores = await _mreqService.GetAllStoreNameAndIdAsync();
           // UserList = await _mreqService.GetAllActiveUserNamesAsync();
            ExistingDepartments = await _mreqService.GetAllDepartment();
            DecimalPlaces = await _mreqService.GetDecimalPlacesAsync();
            StaffList = await _mreqService.GetAllStaffAsync();
            if (MreqId.HasValue)
                await LoadExistingMReq(MreqId.Value);
            else
                await InitializeNewMreq();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OnInitializedAsync failed.");
            await _js.ToastrError("Error during initialization.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingMReq(int mreqId)
    {
        try
        {
            MaterialReqVMs = await _mreqService.GetMreqByMreqIdAsync(mreqId);

            SelectedStaff = StaffList.FirstOrDefault(x => x.StaffName == MaterialReqVMs.KindAttn);

            if (MaterialReqVMs == null)
            {
                await _js.ToastrWarning("Material Requisition not found.");
                return;
            }

            Autharization = (await userAuthority.GetAllWithUserAsync()).Any(x => x.IsPR == true);

            var validSubs = MaterialReqVMs.MaterialReqSubVMs.Where(q => q.ItemId > 0).ToList();
            var attachmentTasks = validSubs.Select(async mreqSub =>
            {
                attachmentCounts[mreqSub.ItemId.Value] =
                    await _mreqService.GetCorrespondenceAttachmentsCountAsync(mreqSub.ItemId.Value, "Item");
            });
            await Task.WhenAll(attachmentTasks);

            IsIndentGeneratedFromMRA = await CheckIsIndentGeneratedFromMRA();
            IsIndentGeneratedFromBOM = await CheckIsIndentGeneratedFromBOM();

            //Important
            IsSomeItemsTransMade = await CheckIsTransMade();

        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"LoadExistingMReq failed for MreqId: {mreqId}");
            await _js.ToastrError("Failed to load existing Material Requisition.");
        }
    }

    private async Task<bool> CheckIsTransMade()
    {
        try
        {
            return await _mreqService.IsMreqTransactionsMatchedAsync(MreqId.Value, MaterialReqVMs);
        }
        catch(Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CheckIsTransMade failed for MReq No: {MaterialReqVMs.MReqNo}");
            await _js.ToastrError("Failed to CheckIsTransMade Material Requisition.");
            return false;
        }
    }

    private async Task<bool> CheckIsIndentGeneratedFromMRA()
    {
        try
        {
            if (MaterialReqVMs?.MaterialReqSubVMs == null || MaterialReqVMs.MaterialReqSubVMs.Count == 0)
                return false;

            return MaterialReqVMs.MaterialReqSubVMs
                .Any(sub => sub.RefPoSubId.HasValue && sub.RefPoSubId > 0
                         && sub.MainAssyId.HasValue && sub.MainAssyId > 0);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CheckIsIndentGeneratedFromMRA failed for MReq No: {MaterialReqVMs.MReqNo}");
            await _js.ToastrError("Failed to CheckIsIndentGeneratedFromMRA Material Requisition.");
            return false;
        }
    }

    private async Task<bool> CheckIsIndentGeneratedFromBOM()
    {
        try
        {
            if (MaterialReqVMs?.MaterialReqSubVMs == null || MaterialReqVMs.MaterialReqSubVMs.Count == 0)
                return false;

            return MaterialReqVMs.MaterialReqSubVMs
                .Any(sub => sub.RefBomId.HasValue && sub.RefBomId > 0
                         && sub.MainAssyId.HasValue && sub.MainAssyId > 0);

        }
        catch(Exception ex)
        {
            await _logs.LogDeveloperError(ex, $"CheckIsIndentGeneratedFromBOM failed for MReq No: {MaterialReqVMs.MReqNo}");
            await _js.ToastrError("Failed to Get IsIndentGeneratedFromBOM Material Requisition.");
            return false;
        }

