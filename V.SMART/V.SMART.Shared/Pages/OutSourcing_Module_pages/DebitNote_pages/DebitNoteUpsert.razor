    private async Task UpsertDebitNote()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            DebitNoteVMs.DebitNoteSubVMs.RemoveAll(x => x.ItemId!=0 && (!x.Qty.HasValue || x.Qty == 0) && (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!DebitNoteVMs.DebitNoteSubVMs.Any())
            {
                await _js.ToastrWarning("Cannot save a DebitNote without valid items.");
                return;
            }

            if (string.IsNullOrWhiteSpace(DebitNoteVMs.DebitNo))
            {
                await _js.ToastrWarning("Please enter the DebitNote number");
                return;
            }

            if (DebitNoteVMs.VendorCode==0)
            {
                await _js.ToastrWarning("Please select  Vendor");
                return;
            }

            
            // Validate each line
            foreach (var line in DebitNoteVMs.DebitNoteSubVMs)
            {
                bool isValid = await ValidateCreditNoteLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewCredit = DebitNoteVMs.DbId == 0;

            try
            {
                
                if (DebitNoteVMs.Purchase.Value)
                {
                    await _debitNoteService.UpsertDebitNoteAsync(DebitNoteVMs,screenCode,"Purchase");
                }
                else if (DebitNoteVMs.SubContract.Value)
                {
                    await _debitNoteService.UpsertDebitNoteAsync(DebitNoteVMs,screenCode,"SubContract");
                }
                
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewCredit)
                await _js.ToastrSuccess("Debit Note saved successfully.");
            else
                await _js.ToastrSuccess("Debit Note  updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/debitNoteList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertInvoic failed.");
            await _js.ToastrError("Error saving Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateCreditNoteLineAsync(DebitNoteSubVM line)
    {
        try
        {
            if (line.ItemId==0)
            {
                await _js.ToastrWarning ("One or more items are missing Item selection.");
                return false;
            }

            if (line.RejQty <= 0 && line.CrDrQty<=0)
            {
                await _js.ToastrWarning($"Item {line.ItemId}: Reject or CrDrQty Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrWarning($"Item {line.ItemId}: Unit Price must be greater than 0.");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            decimal qtyOut = 0,stkqty=0;

            int RefInvSubId = line.RefPurchInvSubId ?? line.RefSubConInvSubId ?? 0;

            if (line.DbSubId == 0)
            {
                if(RefInvSubId>0)
                {
                    var invBalQty = await GetInvBalQty(RefInvSubId);
                    if (line.Qty > invBalQty)
                    {
                        line.Qty = invBalQty;
                        line.RejQty = invBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Invoice Balance Qty ({invBalQty}).");
                        return false;
                    }
                }

            }
            else if (line.DbSubId > 0)
            {
                var reason = DebitNoteVMs.Rejection ?? false ? "Rejection" : "RateDifference";

                var original = await _debitNoteService.GetDebitNoteSubItemDetailByDbSubIdAsync(line.DbSubId,reason);

                if (original != null)
                {
                    decimal origBalQty =reason=="Rejection"?original.RejQty:original.CrDrQty;
                    decimal origQty = original.Qty ?? 0m;
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.RejQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.RejQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateInvoiceLineAsync failed.");
            await _js.ToastrError("Error validating Invoice line.");
            return false;
        }
    }

