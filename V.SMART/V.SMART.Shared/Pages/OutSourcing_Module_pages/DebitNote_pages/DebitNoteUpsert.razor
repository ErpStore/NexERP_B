    private async Task LoadExistingDebitNote(int DbId)
    {
        try
        {
            DebitNoteVMs = await _debitNoteService.GetDebitNoteByDbIdAsync(DbId);

            if (DebitNoteVMs == null)
            {
                await _js.ToastrWarning("DebitNote not found.");
                return;
            }

            SelectedVendor = await _debitNoteService.GetVendorsByIdAsync(DebitNoteVMs.VendorCode.Value);
            if (SelectedVendor != null)
                await ApplyVendorSelectionAsync(SelectedVendor);

            if (DebitNoteVMs.CurrId > 0)
                await ApplyCurrencyChange(DebitNoteVMs.CurrId);

            foreach (var savedSub in DebitNoteVMs.DebitNoteSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[savedSub.ItemId] = await _debitNoteService.GetCorrespondenceAttachmentsCountAsync(savedSub.ItemId, "Item");
            }

            DebitNoteVMs.SignedInvoiceQrCode = await _debitNoteService.GenerateQrBase64(DebitNoteVMs.SignedInvoiceQrCode);

            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing Debit Note.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingDebitNote failed for DbId: {DbId}");
        }
    }

    private bool CheckIsTransMade()
    {
        return (string.IsNullOrEmpty(DebitNoteVMs.ACKNO) && string.IsNullOrEmpty(DebitNoteVMs.IRNNo)) ? false : true;
    }

