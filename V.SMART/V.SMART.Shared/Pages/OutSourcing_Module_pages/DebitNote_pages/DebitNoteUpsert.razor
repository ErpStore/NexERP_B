                // });
            }

            await ResetSlno();
            await _calculationService.UpdateTotalsAsync(DebitNoteVMs);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for InvSubId: {item?.DbSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(DebitNoteSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItem == null && item.ItemId > 0)
            {
                item.SelectedItem = await _debitNoteService.GetItemByItemIdAsync(item.ItemId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for InvSubId: {item?.DbSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(DebitNoteSubVM? item, DebitNoteVM? parentQuote)
    {
        try
        {
            if (item == null || parentQuote == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentQuote.DebitNoteSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for CrSubId: {item?.DbId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(DebitNoteSubVM item)
    {
        try
        {
            if (DebitNoteVMs.DebitNoteSubVMs.Count == 1 && item.DbSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }else if (DebitNoteVMs.DebitNoteSubVMs.Count == 1)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if(IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if(!string.IsNullOrEmpty(DebitNoteVMs.ACKNO) && !string.IsNullOrEmpty(DebitNoteVMs.IRNNo))
            {
                await _js.ToastrWarning("This Credit Note has been done e-invoice so cannot be modified.");
                return;                
            }



            if (item.ItemId == 0)
            {
                DebitNoteVMs.DebitNoteSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!DebitNoteVMs.DebitNoteSubVMs.Any())
                    DebitNoteVMs.DebitNoteSubVMs = new List<DebitNoteSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(DebitNoteVMs);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for InvoiceSubId: {item?.DbSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
