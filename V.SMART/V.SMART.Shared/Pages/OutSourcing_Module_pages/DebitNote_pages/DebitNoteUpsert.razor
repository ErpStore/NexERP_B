        }
    }

    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                DebitNoteVMs.IsSameAsShipping = true;
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }
            DebitNoteVMs.IsSameAsShipping = false;

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltVendorCode == selectedId);
            if (selectedConsignee == null)
                return;

            DebitNoteVMs.ShipAddrsId = selectedConsignee.AltVendorCode;
            DebitNoteVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltVendorAddr1, selectedConsignee.AltVendorAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            DebitNoteVMs.ShippingGstin = selectedConsignee.GSTNo ?? string.Empty;
            DebitNoteVMs.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(DebitNoteVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

    private void ResetShippingDefaults()
    {
        DebitNoteVMs.ShipAddrsId = null;
        DebitNoteVMs.ShippingName = null;
        DebitNoteVMs.ShippingAddress = null;
        DebitNoteVMs.ShippingGstin = null;
        DebitNoteVMs.ShippingContactNo = null;
