            await LoadRightsAsync();

            if (!CanView)
            {
                isProcessing = false;
                StateHasChanged();
                _navigationManager.NavigateTo("/access-denied", true);
                return;
            }

            Currencies = await _debitNoteService.GetCurrenciesAsync();
            DecimalPlaces = await _debitNoteService.GetDecimalPlacesAsync();
            screenCode = await _debitNoteService.GetScreenCodeByScreenNameAsync(ScreenName);

            if (DbId.HasValue)
                await LoadExistingDebitNote(DbId.Value);
            else if (VendorCode > 0)
                await InitializeNewCreditNote(VendorCode);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
        }
