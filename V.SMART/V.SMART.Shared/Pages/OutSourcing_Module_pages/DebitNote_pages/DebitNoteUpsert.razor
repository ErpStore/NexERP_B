    //Cancel CreditNote
    private async Task Cancel()
    {
        try
        {
            if (DbId == 0)
            {
                await _js.ToastrWarning("Debit Note  cancel is not allowed before saving the Debit Note.");
                return;
            }

            if(DebitNoteVMs.Cancel)
            {
                var subs = await _debitNoteService.GetCreditSubDetailsByCrIdAsync(DebitNoteVMs.DbId.GetValueOrDefault());

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    await _debitNoteService.ValidateCreditNoteBalanceBeforeRevertAsync(sub);
                }
            }

             
            if (!DebitNoteVMs.Cancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Debit Note?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Debit Note?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
           
            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the DebitNote.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Debit Note Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CancelInvoice()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!DebitNoteVMs.Cancel)
            {
                DebitNoteVMs.Cancel = true;
                DebitNoteVMs.CancelReason = cancelReason;

                await _debitNoteService.UpdatedCancelStatusAndAddOrRevertQty(DebitNoteVMs,screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "DebitNote",
                    action: $"Cancelled DebitNote: {DebitNoteVMs.DebitNo}",
                    additionalInfo: $"Invoice Id: {DebitNoteVMs.DbId}"
                );

                await _js.ToastrSuccess("DebitNote cancelled successfully.");
            }
            else
            {
                DebitNoteVMs.Cancel = false;
                DebitNoteVMs.CancelReason = string.Empty;

                await _debitNoteService.UpdatedCancelStatusAndAddOrRevertQty(DebitNoteVMs,screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "DebitNote",
                    action: $"Reverted DebitNote: {DebitNoteVMs.DebitNo}",
                    additionalInfo: $"DebitNote Id: {DebitNoteVMs.DbId}"
                );

                await _js.ToastrSuccess("DebitNote has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while cancelling/reverting the DebitNote.");
            await LoggingService.LogDeveloperError(ex, $"DebitNote failed for DbId: {DebitNoteVMs.DbId}");
        }
        finally
        {
            isProcessing = false;
        }
    }


