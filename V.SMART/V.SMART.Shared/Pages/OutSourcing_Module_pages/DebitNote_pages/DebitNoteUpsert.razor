                                                   type="number" @bind="DebitNoteVMs.InsuranceCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(DebitNoteVMs)' readonly/>
                                            <ValidationMessage For="@(() => DebitNoteVMs.InsuranceCharges)" />
