    private bool IsItemAlreadySelected(int itemId, int? currentItemId)
    {
        return DebitNoteVMs.DebitNoteSubVMs?.Any(q => q.ItemId == itemId && q.ItemId != currentItemId) == true;
    }

    #endregion

    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, DebitNoteSubVM SubVM) 
    {
        try
        {
            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            int RefInvSubId = SubVM.RefPurchInvSubId ?? SubVM.RefSubConInvSubId ?? 0;

            

            decimal stkqty=0;
            string cate = DebitNoteVMs.Rejection.Value ? "Reject" : "Cr/Dr";
            // NEW quote line
            if (SubVM.DbSubId == 0)
            {
                

                if (RefInvSubId > 0)
                {
                    decimal invBalQty = 0;
                    invBalQty = await GetInvBalQty(RefInvSubId);

                    if (newQty <= invBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.DbBalQty = newQty;
                        if (DebitNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = newQty;
                        }
                        else
                        {
                            SubVM.CrDrQty = newQty;
                        }

                    }
                    else
                    {
                        SubVM.Qty = invBalQty;
                        SubVM.DbBalQty = invBalQty;
                        if (DebitNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = invBalQty;
                        }
                        else
                        {
                            SubVM.CrDrQty = invBalQty;
                        }
                        await _js.ToastrWarning($"{cate} Qty {newQty} can't be greater than  Qty ({invBalQty}).");
                        return;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.DbBalQty = newQty;

                    if (DebitNoteVMs.Rejection.Value)
                    {
                        SubVM.RejQty = newQty;
                    }
                    else
                    {
                        SubVM.CrDrQty = newQty;
                    }
                }

            }
            // EXISTING quote line
            else
            {
                var reason = DebitNoteVMs.Rejection ?? false ? "Rejection" : "RateDifference";

                var original = await _debitNoteService.GetDebitNoteSubItemDetailByDbSubIdAsync (SubVM.DbSubId,reason);

                if (original == null) return;

                var alreadyTransacted = original.Qty - original.RejQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.DbBalQty = 0;
                    SubVM.RejQty=0;
                    SubVM.CrDrQty = 0;
                    await _js.ToastrWarning($"{cate} Qty  cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (RefInvSubId > 0)
                {
                    decimal invBalQty = 0;

                    invBalQty = await GetInvBalQty(RefInvSubId);

                    var maxAllowedQty = original.Qty + invBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.DbBalQty = (maxAllowedQty - alreadyTransacted).Value;

                        if (DebitNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = SubVM.DbBalQty.Value;
                        }
                        else
                        {
                            SubVM.CrDrQty = SubVM.DbBalQty.Value;
                        }
                        await _js.ToastrWarning($"{cate} Qty cannot be greater than {maxAllowedQty}.");
                        return ;
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.DbBalQty = (newQty - alreadyTransacted).Value;
                        if (DebitNoteVMs.Rejection.Value)
                        {
                            SubVM.RejQty = SubVM.DbBalQty.Value;
                        }
                        else
                        {
                            SubVM.CrDrQty = SubVM.DbBalQty.Value;
                        }
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.DbBalQty= (newQty - alreadyTransacted).Value;
                    if (DebitNoteVMs.Rejection.Value)
                    {
                        SubVM.RejQty = SubVM.DbBalQty.Value;
                    }
                    else
                    {
                        SubVM.CrDrQty = SubVM.DbBalQty.Value;
                    }
                }


            }
            await _calculationService.UpdateTotalsAsync(DebitNoteVMs);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for InvSubId: {SubVM?.DbSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    #endregion

    private async Task<decimal> GetInvBalQty(int refInvId)
    {
        decimal invBalQty = 0;
        if (DebitNoteVMs.Purchase.Value)
        {
            invBalQty=await _debitNoteService.GetInvItemBalQtyFromDcSubId(refInvId,"Purchase");
        }
        else if (DebitNoteVMs.SubContract.Value)
        {
            invBalQty=await _debitNoteService.GetInvItemBalQtyFromDcSubId(refInvId,"SubContract");
        }
        
        return invBalQty;
