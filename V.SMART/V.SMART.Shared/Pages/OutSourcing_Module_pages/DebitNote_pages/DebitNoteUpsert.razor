    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            switch (confirmation)
            {
                case "confirmDeleteRow_Click":
                    await confirmDeleteRow_Click(true);
                    break;

                case "OpenFiles":
                    if (AttachItemSelected != null)
                        await OpenModal("Attachments");
                    break;
                case "Cancel":
                case "Revert":
                    await CancelInvoice();
                    break;

                case "EInvoice":
                    await GenerateEInvoice();
                    break;

                default:
                    await _js.ToastrWarning("Unknown confirmation action.");
                    break;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _js.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.DbSubId > 0)
            {
                if (DebitNoteVMs.Purchase.Value)
                {
                    await _debitNoteService.DeleteAndResequenceAsync(rowToDelete, DebitNoteVMs,screenCode,"Purchase");
                }
                else if (DebitNoteVMs.SubContract.Value)
                {
                    await _debitNoteService.DeleteAndResequenceAsync(rowToDelete, DebitNoteVMs,screenCode,"SubContract");
                }
                
                DebitNoteVMs.DebitNoteSubVMs = await _debitNoteService.GetDebitNoteSubByDbIdAsync (DebitNoteVMs.DbId.Value);

                await CountPendingInvs();
            }
            else
            {
                DebitNoteVMs.DebitNoteSubVMs.Remove(rowToDelete);

                if (!DebitNoteVMs.DebitNoteSubVMs.Any())
                {
                    DebitNoteVMs.DebitNoteSubVMs.Add(new DebitNoteSubVM
                    {
                        DbId = DebitNoteVMs.DbId.Value,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    await ResetSlno();
                }
            }

            await _calculationService.UpdateTotalsAsync(DebitNoteVMs);

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for InvId: {DebitNoteVMs.DbId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

