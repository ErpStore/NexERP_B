    private async Task OnLineDiscountPercentChanged(DebitNoteSubVM subitem)
    {
        try
        {
            decimal gross = 0;
            if (subitem.Qty > 0 && subitem.UnitPrice > 0)
            {
                if (DebitNoteVMs.Rejection.Value)
                {
                    gross = subitem.Qty.Value * subitem.UnitPrice.Value;
                }
                else
                {
                    gross = subitem.CrDrQty * subitem.CrDrUnitPrice;

                }

                subitem.LineDiscountAmount = (gross * subitem.LineDiscountPercent / 100m);
                DebitNoteVMs.DiscountPercent = 0;
            }
            else
            {
                subitem.LineDiscountAmount = 0;
            }
            await _calculationService.UpdateTotalsAsync(DebitNoteVMs);
            StateHasChanged();

        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing of OnLineDiscountPercentChanged in Mfg Invoice");
            await LoggingService.LogDeveloperError(ex, "Error in  OnLineDiscountPercentChanged() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

