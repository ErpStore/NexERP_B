                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.RewQty</span>
                                                            }
                                                           
                                                        </td>

                                                         <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                  <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           step="any"
                                                                           placeholder="Cr/DrQty"
                                                                           title="Enter Cr/DrQty Quantity"
                                                                           @bind="subitem.CrDrQty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" readonly="@(!DebitNoteVMs.RateDifference)" />
                                                                <ValidationMessage For="@(() => subitem.CrDrQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.CrDrQty</span>
                                                            }
                                                           
                                                        </td>
                                                         
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm"  step="any" placeholder="Price" title="Enter Cr/Dr Unit Price"
                                                                        @bind="subitem.CrDrUnitPrice" @bind:event="oninput"
                                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(DebitNoteVMs)' readonly="@(!DebitNoteVMs.RateDifference)" />
                                                                <ValidationMessage For="@(() => subitem.CrDrUnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.CrDrUnitPrice)
                                                            }
                                                        </td>

                                                        <!-- Basic Amount -->
                                                        <td>@FormatDecimal(subitem.LineBasicAmount)</td>



                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.Remarks" class="form-control form-control-sm" placeholder="Enter Remarks" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.Remarks
                                                            }
                                                        </td>

                                                        @if(DebitNoteVMs.Purchase.Value)
                                                        {
                                                             <td>@subitem.RefPurcInvNo</td>
                                                             <td>@subitem.RefPurchInvDate?.ToString("dd/MM/yyyy")</td>
                                                        }else
                                                        {
                                                             <td>@subitem.RefSubConInvNo</td>
                                                             <td>@subitem.RefSubConInvDate?.ToString("dd/MM/yyyy")</td>
                                                        }
                                                       
                                                        <!-- Cost Center -->
                                                        <td>
                                                            @if (subitem.IsEditable && (subitem.Qty == subitem.RejQty)||(subitem.Qty == subitem.CrDrQty))
                                                            {
                                                                <select class="form-select form-select-sm" 
                                                                    value="@subitem.CostId"
                                                                    @onchange="(e => OnCostCenterChanged(e, subitem))">
                                                                    <option value="">select CostCentre</option>
                                                                    @foreach (var cost in CostCenterVMs.Where(c =>
                                                                        !DebitNoteVMs.DebitNoteSubVMs.Any(r => r != subitem && r.CostId == c.Id)))
                                                                    {
                                                                        <option value="@cost.Id">@cost.ProjectNo</option>
                                                                    }
                                                                </select>
                                                                <ValidationMessage For="@(() => subitem.CostId)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.ProjectNo
                                                            }
                                                        </td>

                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                        @onclick="async () => await SaveRow(subitem)">
                                                                    <i class="bi bi-check-lg"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                        @onclick="async () => await CancelEdit(subitem, DebitNoteVMs)">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit" 
                                                                        @onclick="async () => await EditRowAsync(subitem)">
                                                                    <i class="bi bi-pencil"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete" 
                                                                        @onclick="async () => await RemoveRow(subitem)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            }
                                                            
                                                        </td>
                                                    </tr>
                                                }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="22" style="height:150px;" class="text-center align-middle text-muted fs-6 fw-semibold">
                                                            <div class="d-flex justify-content-center align-items-center" style="min-height:100px;">
                                                                <i class="bi bi-info-circle me-2 text-secondary"></i>
                                                                No items to display
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (DebitNoteVMs.DebitNoteSubVMs?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        <td colspan="5" class="text-end fw-bold">Totals:</td>
                                                        <td>@DebitNoteVMs.TotalQty</td>
                                                         <td>@DebitNoteVMs.TotalRejQty</td>
                                                        <td>Avg: @FormatDecimal(DebitNoteVMs.AvgUnitPrice)</td>
                                                        <td>@FormatDecimal(DebitNoteVMs.TotalLineGross)</td>

                                                        @if (!DebitNoteVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td></td>
                                                            <td>@FormatDecimal(DebitNoteVMs.TotalLineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@FormatDecimal(DebitNoteVMs.TotalLineDiscountAmount)</td>
                                                        }

                                                        @if (SelectedVendor?.TaxValidate == false)
                                                        {
                                                            @if(SelectedVendor?.BusiType == "Local")
                                                            {
                                                                <td></td>
                                                                <td></td>

                                                            }
                                                            else if(SelectedVendor?.BusiType == "InterState")
                                                            {
                                                                <td></td>

                                                            }

                                                        }

                                                        <td>@FormatDecimal(DebitNoteVMs.TotalLineBasicAmount)</td>
                                                        <td colspan="10"></td>
                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>
                                  
                                </div>
                            </div>
                        </div>

                          <div class="col-12 col-lg-6 mb-3">
                            
                        </div>

                        <!-- =================== Tax Details Section =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm rounded-4 border-0 p-3">

                                <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Tax & Charges
                                </h6>

                                <!-- Total Gross -->
                                <div class="row mb-2 gx-3">
                                    <label for="TotalGross" class="col-5 col-md-4 col-form-label text-dark">
                                        <small>Total Gross</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input id="TotalGross"
                                               class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               value="@FormatDecimal(DebitNoteVMs.TotalGrossAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Discount -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Discount</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="discountToggle" id="discountRs"  step="any"
                                                   @onchange="() => SetDiscountType(true)"
                                                   checked="@DebitNoteVMs.DiscAmtOrPer" disabled="true" />
                                            <label class="btn btn-outline-primary" for="discountRs">
                                                <small>@DebitNoteVMs.Symbol</small>
                                            </label>

                                            <input type="radio" class="btn-check" name="discountToggle" id="discountPercent"  step="any"
                                                   @onchange="() => SetDiscountType(false)"
                                                   checked="@(!DebitNoteVMs.DiscAmtOrPer)" disabled="true"   />
                                            <label class="btn btn-outline-primary" for="discountPercent"><small>%</small></label>
                                        </div>
                                    </div>

                                    <div class="col-3 col-md-5">
