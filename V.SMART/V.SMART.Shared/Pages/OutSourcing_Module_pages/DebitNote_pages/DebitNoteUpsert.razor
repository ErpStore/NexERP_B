                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                               value="@FormatDecimal(DebitNoteVMs.GrandTotal)"
                                               readonly />
                                        @if (DebitNoteVMs.CurrId > 1)
                                        {
                                            <div class="mt-1 text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @DebitNoteVMs.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((DebitNoteVMs.GrandTotal * DebitNoteVMs.TodayVal).ToString("0.00"))
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Amount in Words -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Amount in Words</small></label>
                                    <div class="col-7 col-md-8 pt-1">
                                        @if (DebitNoteVMs.CurrId > 1)
                                        {
                                            <small class="fw-bold text-success d-block">
                                                Converted Value in Rs: @FormatDecimal(DebitNoteVMs.GrandTotal * DebitNoteVMs.TodayVal)
                                            </small>
                                        }
                                        else
                                        {
                                            <strong>@NumberToWordsHelper.ConvertNumberToWords(DebitNoteVMs.GrandTotal)</strong>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                         <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            
                            <div class="col-6 col-md-3 mt-3">
                                <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                    <i class="bi bi-floppy2-fill me-1"></i> @(DebitNoteVMs.DbId > 0 ? "Update" : "Create")
                                </button>
                            </div>
                            
                        }
                        

                        @if(DebitNoteVMs.DbId>0 && string.IsNullOrEmpty(DebitNoteVMs.ACKNO) && string.IsNullOrEmpty(DebitNoteVMs.IRNNo))
                        {
                            <div class="col-4 col-md-3 mt-3">
                            <button type="button" class="btn  btn-success w-100 rounded-3 rounded-3" @onclick='() => ConfirmEinvoice()'>
                                <i class="bi bi-person-add me-1"></i> E-Invoice
                            </button>
                            
                            </div>
                        }

                        <div class="col-6 col-md-3 mt-3">
                            <SmartBackButton Url="@($"/debitNoteList?currentPage={currentPage}")" />
                        </div>

                        @if (CanCreate || CanEdit && DbId > 0)
                        {
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                    <i class="bi bi-printer me-1"></i>Print
                                </button>
                            </div>
                        }

                    </div>

                </EditForm>
            </div>

        </div>
    </div>
}

