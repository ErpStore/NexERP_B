                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            // Ensure at least one editable row exists for new entries
            if (!DebitNoteVMs.DebitNoteSubVMs.Any(x => x.IsEditable))
            {
                // DebitNoteVMs.CreditNoteSubVMs.Add(new CreditNoteSubVM
                // {
                //     CrId = DebitNoteVMs.CrId,
