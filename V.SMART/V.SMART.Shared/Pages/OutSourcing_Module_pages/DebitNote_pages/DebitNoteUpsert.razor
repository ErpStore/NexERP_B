                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number" @bind="DebitNoteVMs.InsurancePercent"
                                                   @bind:after="() => OnInsurancePercentChanged()" readonly />
                                            <ValidationMessage For="@(() => DebitNoteVMs.InsurancePercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(DebitNoteVMs.InsuranceCharges)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Total Taxable -->
