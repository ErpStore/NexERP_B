            }
            DebitNoteVMs.Prefix = await _debitNoteService.GetPrefixFromDb();
            DebitNoteVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            DebitNoteVMs.DebitNo = await _debitNoteService.GetDebitNoteNumberAsync(DebitNoteVMs.Suffix);
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new DebitNote.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewQuote failed for vendorCode: {vendorCode}");
        }
    }


