        {
            await LoggingService.LogDeveloperError(ex, $"SearchVendors failed for value: {value}");
            await _js.ToastrError("Failed to search Vendors. Please try again.");
            return Enumerable.Empty<VendorVM>();
        }
    }

    private async Task OnVendorChanged(VendorVM? vendor)
    {
        try
        {

            await ApplyVendorSelectionAsync(vendor);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error in OnVendorChanged: {ex}");
            await LoggingService.LogDeveloperError(ex, "Error in OnVendorChanged");
            await _js.ToastrError("Error while selecting");
            contactPersons.Clear();
            await ResetCreditNoteDefaults();
        }
    }

    private async Task ApplyVendorSelectionAsync(VendorVM? vendor)
    {
        try
        {
            SelectedVendor = vendor;
            DebitNoteVMs.VendorCode = vendor?.VendorCode ?? 0;
            DebitNoteVMs.VendorName = vendor?.VendorName;
            DebitNoteVMs.VendorAddress = vendor?.VendorAddress;
            DebitNoteVMs.VendorGstNo = vendor?.GSTNo;
            DebitNoteVMs.VendorContactNo = vendor?.ContactNo;
            DebitNoteVMs.BusiType = vendor?.BusiType;

            if (vendor == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                CostCenterVMs.Clear();
                await ResetCreditNoteDefaults();
                return;
            }

            contactPersons = await _debitNoteService.GetContactPersonsAsync(vendor.VendorCode);
            consineeAddress = await _debitNoteService.GetConsigneeAddressesAsync(vendor.VendorCode);

            var usedCostCenters = DebitNoteVMs.DebitNoteSubVMs
                .Where(x => x.CostId.HasValue && (x.RefPurchInvSubId == 0))
                .Select(x => x.CostId.Value)
                .ToHashSet();

            CostCenterVMs = await _debitNoteService.GetCostCenterDetailsByCustId(vendor.VendorCode, usedCostCenters);

            DebitNoteVMs.KindofAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPerson : string.Empty;

            // Tax logic
            if (!vendor.TaxValidate)
            {
                var lastInvoice = await _debitNoteService.GetLastdebitNoteAsync(vendor.VendorCode);
                if (lastInvoice != null)
                {
                    DebitNoteVMs.CGstRate = lastInvoice.CGstRate;
                    DebitNoteVMs.SGstRate = lastInvoice.SGstRate;
                    DebitNoteVMs.IGstRate = lastInvoice.IGstRate;
                }
                else
                {
                    if (string.Equals(vendor.BusiType, "Local", StringComparison.OrdinalIgnoreCase) && vendor.TaxValidate == false)
                    {
                        DebitNoteVMs.CGstRate = CommonConstants.GetGST(9.000m);
                        DebitNoteVMs.SGstRate = CommonConstants.GetGST(9.000m);
                        DebitNoteVMs.IGstRate = CommonConstants.GetIGST(0.000m);
                    }
                    else if (string.Equals(vendor.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && vendor.TaxValidate == false)
                    {
                        DebitNoteVMs.CGstRate = CommonConstants.GetGST(0.000m);
                        DebitNoteVMs.SGstRate = CommonConstants.GetGST(0.000m);
                        DebitNoteVMs.IGstRate = CommonConstants.GetIGST(18.000m);
                    }
                }
            }

            DebitNoteVMs.CurrId = (vendor.CurrId.HasValue && vendor.CurrId > 0) ? vendor.CurrId.Value : 1;
            await ApplyCurrencyChange(DebitNoteVMs.CurrId);


            await CountPendingInvs();

            await _calculationService.UpdateTotalsAsync(DebitNoteVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyVendorSelectionAsync failed for CustId: {vendor?.VendorCode}");
            await _js.ToastrError("Failed to apply vendor selection. Please try again.");
        }
    }

    private async Task CountPendingInvs()
    {
        if (DebitNoteVMs.Purchase.Value)
        {
            InvPendingCount = await _debitNoteService.GetPendingInvCountAsync(DebitNoteVMs.VendorCode.Value, "Purchase");
        }
        else if (DebitNoteVMs.SubContract.Value)
        {
            InvPendingCount = await _debitNoteService.GetPendingInvCountAsync(DebitNoteVMs.VendorCode.Value, "SubContract");
        }

    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
