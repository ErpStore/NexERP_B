                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"  step="any"
                                                   type="number"
                                                   @bind="DebitNoteVMs.DiscountAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(DebitNoteVMs)'
                                                   disabled="@(DebitNoteVMs.TotalLineDiscountAmount > 0)" readonly />
