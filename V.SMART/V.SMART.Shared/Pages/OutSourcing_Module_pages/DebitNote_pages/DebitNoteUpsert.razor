    private async Task ApplyCurrencyChange(int currencyId)
    {
        var selectedCurrency = await _debitNoteService.GetCurrencyByIdAsync(currencyId);
        if (selectedCurrency == null) return;

        DebitNoteVMs.CurrName = selectedCurrency.CurrName;
        DebitNoteVMs.Symbol = selectedCurrency.Symbol;
        DebitNoteVMs.CurrId = selectedCurrency.CurrId;

        if (currencyId > 1)
            DebitNoteVMs.TodayVal = await _debitNoteService.GetLatestCurrencyValueAsync(currencyId) ?? 0m;
    }

    private async Task ResetCreditNoteDefaults()
    {
        DebitNoteVMs.CGstRate = 0m;
        DebitNoteVMs.SGstRate = 0m;
        DebitNoteVMs.IGstRate = 0m;
    }

    private async Task OnShippingChange(ChangeEventArgs e)
    {
        try
        {
            DebitNoteVMs.IsSameAsShipping = (bool)e.Value;

            if (!DebitNoteVMs.IsSameAsShipping && SelectedVendor != null)
            {
                consineeAddress = await _debitNoteService.GetConsigneeAddressesAsync(SelectedVendor.VendorCode);
