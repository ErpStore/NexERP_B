                                               value="@FormatDecimal(DebitNoteVMs.TotalTaxable)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Taxes (CGST/SGST/IGST) -->
                                @if (SelectedVendor?.TaxValidate == false)
                                {
                                    <div class="mb-2">
                                        @if (SelectedVendor?.BusiType == "Local")
                                        {
                                            <!-- CGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>CGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!DebitNoteVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="DebitNoteVMs.CGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(DebitNoteVMs.CGstRate) " disabled >
                                                            <option value="0" >-- Select CGST % --</option>
