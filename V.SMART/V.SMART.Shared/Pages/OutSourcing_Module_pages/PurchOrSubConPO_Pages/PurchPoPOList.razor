    #region === Deletion Flow ===

    private async Task HandleDelete(int quoteId)
    {
        try
        {

            var (canDelete, message) = await purchasePoService.CanDeletePurchaseOrderAsync(quoteId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeletePoId = quoteId;


            ModalTitle = "Are you sure you want to delete this Purchase Order";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for EnquiryId: {quoteId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;

            var deleted = await purchasePoService.DeletePOByPOIdAsync(DeletePoId);

            if (deleted)
            {
                await _JS.ToastrSuccess("Purchase Order deleted successfully.");
                await LoadAllPo();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Purchase Order could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting EnquiryId: {DeletePoId}");
            await _JS.ToastrError("Failed to delete Purchase Order.");
        }
        finally
        {
            DeletePoId = 0;
            isProcessing = false;
        }
    }

