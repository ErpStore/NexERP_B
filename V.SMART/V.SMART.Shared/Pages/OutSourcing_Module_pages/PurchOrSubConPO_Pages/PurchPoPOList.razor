    private async Task HandleExport()
    {

        // if (string.IsNullOrEmpty(selectedStatus))
        // {
        //     await _JS.ToastrWarning("Please select Po status first?.");
        //     return;
        // }
        selectedStatus =selectedStatus==""?"All":selectedStatus;

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;

            var exportData = await purchasePoService.GetPurchasePosPendingListAsync(selectedStatus);
           
            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData,"PurchasePo","Purchase and SubContract Po's Pending List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "PurchasePoExport.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (MfgPo)");
            await _JS.ToastrError("Error while exporting MfgPo!");
        }
        finally
        {
            isProcessing = false;
        }
    }

