    private async Task ApplyVendorSelectionAsync(VendorVM? vendor)
    {
        try
        {
            SelectedVendor = vendor;
            PurchPoVMs.VendorCode = vendor?.VendorCode ?? 0;
            PurchPoVMs.VendorName = vendor?.VendorName;
            PurchPoVMs.VendorAddress = vendor?.VendorAddress;
            PurchPoVMs.VendorGSTNO = vendor?.GSTNo;
            PurchPoVMs.VendorPhoneNo = vendor?.ContactNo;

            if (vendor == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                CostCenterVMs.Clear();
                await ResetQuoteDefaults();
                return;
            }

            contactPersons = await purchPoSevice.GetContactPersonsVendorAsync(vendor.VendorCode);
            consineeAddress = await purchPoSevice.GetConsigneeAddressesVendorAsync(vendor.VendorCode);

            var usedCostCenters = PurchPoVMs.PurchPoSubVMs
                .Where(x => x.CostId.HasValue && (x.RefQuoteSubId == null || x.RefQuoteSubId == 0))
                .Select(x => x.CostId.Value)
                .ToHashSet();

            CostCenterVMs = await purchPoSevice.GetCostCenterDetailsByCustId(vendor.VendorCode, usedCostCenters);

            //PurchPoVMs.KindOfAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPerson : string.Empty;
            if (contactPersons.Count == 1)
            {
                var cp = contactPersons.First();

                PurchPoVMs.KindOfAttention = cp.ContactPerson;
                PurchPoVMs.CustContactNo = cp.ContactNo;

            }
            else
            {
                PurchPoVMs.KindOfAttention = string.Empty;
                PurchPoVMs.CustContactNo = string.Empty;

            }

            await ApplyConsigneeDetailsAsync(PurchPoVMs.ShipAddrsId);
            // Tax logic
            if (!vendor.TaxValidate)
            {
                var lastQuote = await purchPoSevice.GetLastPoAsync(vendor.VendorCode);
                if (lastQuote != null)
                {
                    PurchPoVMs.CGstRate = lastQuote.CGstRate;
                    PurchPoVMs.SGstRate = lastQuote.SGstRate;
                    PurchPoVMs.IGstRate = lastQuote.IGstRate;
                }
                else
                {
                    if (string.Equals(vendor.BusiType, "Local", StringComparison.OrdinalIgnoreCase)  && vendor.TaxValidate == false)
                    {
                        PurchPoVMs.CGstRate = CommonConstants.GetGST(9.000m);
                        PurchPoVMs.SGstRate = CommonConstants.GetGST(9.000m);
                        PurchPoVMs.IGstRate = CommonConstants.GetIGST(0.000m);
                    }
                    else if (string.Equals(vendor.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && vendor.TaxValidate == false )
                    {
                        PurchPoVMs.CGstRate = CommonConstants.GetGST(0.000m);
                        PurchPoVMs.SGstRate = CommonConstants.GetGST(0.000m);
                        PurchPoVMs.IGstRate = CommonConstants.GetIGST(18.000m);
                    }
                }
            }

            // Currency
            PurchPoVMs.CurrId = (vendor.CurrId.HasValue && vendor.CurrId > 0) ? vendor.CurrId.Value : 1;
            await ApplyCurrencyChange(PurchPoVMs.CurrId.Value);

            //Pending QuotationDetails
            quotePendingCount = await purchPoSevice.GetPendingQuoteCountAsync(vendor.VendorCode);

            // Update totals
            await _calculationService.UpdateTotalsAsync(PurchPoVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyCustomerSelectionAsync failed for CustId: {vendor?.VendorCode}");
            await _js.ToastrError("Failed to apply customer selection. Please try again.");
        }
    }


    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
            await ApplyCurrencyChange(selectedId);
    }

    private async Task ApplyCurrencyChange(int currencyId)
    {
        var selectedCurrency = await purchPoSevice.GetCurrencyByIdAsync(currencyId);
        if (selectedCurrency == null) return;

        PurchPoVMs.CurrName = selectedCurrency.CurrName;
        PurchPoVMs.Symbol = selectedCurrency.Symbol;
        PurchPoVMs.CurrId = selectedCurrency.CurrId;

        if (currencyId > 1)
            PurchPoVMs.TodayVal = await purchPoSevice.GetLatestCurrencyValueAsync(currencyId) ?? 0m;
    }

    private async Task ResetQuoteDefaults()
    {
        PurchPoVMs.CGstRate = 0m;
        PurchPoVMs.SGstRate = 0m;
        PurchPoVMs.IGstRate = 0m;
    }

    private async Task OnShippingChange(ChangeEventArgs e)
    {
        try
        {
            PurchPoVMs.IsSameAsShipping = (bool)e.Value;

            if (!PurchPoVMs.IsSameAsShipping && SelectedVendor != null)
            {
                consineeAddress = await purchPoSevice.GetConsigneeAddressesVendorAsync(SelectedVendor.VendorCode);
            }
            else
            {
                consineeAddress.Clear();
                ResetShippingDefaults();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                $"Error while toggling shipping address for CustId={SelectedVendor?.VendorCode}");
        }
    }

    private void ResetShippingDefaults()
    {
        PurchPoVMs.ShipAddrsId = null;
        PurchPoVMs.ShippingName = null;
        PurchPoVMs.ShippingAddress = null;
        PurchPoVMs.ShippingGstin = null;
        PurchPoVMs.ShippingContactNo = null;
    }

    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                PurchPoVMs.IsSameAsShipping = true;
                ResetShippingDefaults();
                StateHasChanged();
                return;
            }

            PurchPoVMs.IsSameAsShipping = false;  
            var selectedConsignee = consineeAddress
                .FirstOrDefault(c => c.AltVendorCode == selectedId);

            if (selectedConsignee == null)
                return;

            PurchPoVMs.ShipAddrsId = selectedConsignee.AltVendorCode;

            PurchPoVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltVendorAddr1, selectedConsignee.AltVendorAddr2 }
                .Where(x => !string.IsNullOrWhiteSpace(x)));

            PurchPoVMs.ShippingGstin = selectedConsignee.GSTNo ?? string.Empty;
            PurchPoVMs.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(PurchPoVMs);

            StateHasChanged();

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

    private async Task ApplyConsigneeDetailsAsync(int? consigneeId)
    {
        try
        {
            if (consigneeId == null || consigneeId == 0)
            {
                PurchPoVMs.IsSameAsShipping = true;
                ResetShippingDefaults();
                return;
            }

            PurchPoVMs.IsSameAsShipping = false;

            var consignee = consineeAddress.FirstOrDefault(c => c.AltVendorCode == consigneeId);
            if (consignee == null)
                return;

            PurchPoVMs.ShipAddrsId = consignee.AltVendorCode;
            PurchPoVMs.ShippingAddress = string.Join(" ", new[]
            {
            consignee.AltVendorAddr1,
            consignee.AltVendorAddr2
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

            PurchPoVMs.ShippingGstin = consignee.GSTNo ?? string.Empty;
            PurchPoVMs.ShippingContactNo = consignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(PurchPoVMs);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

