    public async Task OnAdvanceAmountChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal val))
        {
            if(PurchPoVMs.PoId==0)
            {
                PurchPoVMs.AdvanceAmountBal = val;
            }
            decimal oldBalance = PurchPoVMs.AdvanceAmountBal;
            PurchPoVMs.AdvanceAmount = val;
            await AdvanceCalculate();
            PurchPoVMs.AdvanceAmountBal = Math.Max(0, val - (PurchPoVMs.AdvanceAmount - oldBalance));
        }
    }

    public async Task OnAdvancePercentChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal val))
        {
            PurchPoVMs.AdvancePercent = val;
            await AdvanceCalculate();
        }
    }

    public async Task AdvanceCalculate()
    {
        await _calculationService.UpdateTotalsAsync(PurchPoVMs);

        decimal baseAmount = PurchPoVMs.AdvacewithOutTax
            ? PurchPoVMs.TotalGrossAmount
            : PurchPoVMs.GrandTotal;

        decimal newAdvance = 0m;

        decimal oldAdvance = PurchPoVMs.AdvanceAmount;  

        if(PurchPoVMs.PoId==0)
        {
            PurchPoVMs.AdvanceAmountBal = PurchPoVMs.AdvanceAmount;
        }
        decimal oldBalance = PurchPoVMs.AdvanceAmountBal;  



        if (!PurchPoVMs.AdvanceAmtOrPer)
        {
            newAdvance = Math.Round((baseAmount * PurchPoVMs.AdvancePercent) / 100m, 2);
            PurchPoVMs.AdvanceAmount = newAdvance;
        }
        else
        {

            newAdvance = PurchPoVMs.AdvanceAmount;
        }

        decimal usedAmount = oldAdvance - oldBalance;
        if (usedAmount < 0) usedAmount = 0; 


        PurchPoVMs.AdvanceAmountBal = Math.Max(0, newAdvance - usedAmount);


        PurchPoVMs.AdvanceAmount = newAdvance;

        StateHasChanged();
    }


