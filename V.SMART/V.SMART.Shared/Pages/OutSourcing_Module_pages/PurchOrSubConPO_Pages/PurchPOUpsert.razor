    private async Task OnQuoteSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (PurchPoVMs.PurchPoSubVMs == null)
            PurchPoVMs.PurchPoSubVMs = new List<PurchPoSubVM>();

        int VendorCode = PurchPoVMs.VendorCode;
        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

           var priceDict = await purchPoSevice.GetBulkLastUnitPricesAsync(itemIds, VendorCode);
           //sns
           var RolItems = await purchPoSevice.GetROlForItemsAsync(itemIds);

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefQuoteSubId = item.ContainsKey("QuoteSubId") && item["QuoteSubId"] != null
                    ? Convert.ToInt32(item["QuoteSubId"])
                    : (int?)null;

                if (PurchPoVMs.PurchPoSubVMs.Any(x => x.ItemId == itemId && x.RefQuoteSubId == RefQuoteSubId))
                    continue;

                var subVm = new PurchPoSubVM
                {
                    RefQuoteSubId = RefQuoteSubId ?? 0,
                    RefQuoteNo = item.ContainsKey("QuoteNo") ? item["QuoteNo"]?.ToString() : "",
                    RefQuoteDate = item.ContainsKey("QuoteDate") && item["QuoteDate"] != null
                        ? Convert.ToDateTime(item["QuoteDate"])
                         : (DateTime?)null,
                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    MeasureUnit= item.ContainsKey("UOM") ? item["UOM"]?.ToString() : "",
                    HSNCode = item.ContainsKey("HSNCODE") ? item["HSNCODE"]?.ToString() : "",

                    Qty = item.ContainsKey("BalQty") && item["BalQty"] != null 
                            ? Convert.ToDecimal(item["BalQty"]) 
                            : 0m,

                    BalQty = item.ContainsKey("BalQty") && item["BalQty"] != null 
                            ? Convert.ToDecimal(item["BalQty"]) 
                            : 0m,

                    ROL= RolItems.TryGetValue(itemId, out var rol)? Convert.ToDecimal(rol) : 0m,

                    UnitPrice = item.ContainsKey("UnitPrice") && item["UnitPrice"] != null 
                            ? Convert.ToDecimal(item["UnitPrice"]) 
                            : 0m,

                    // priceDict.TryGetValue(itemId, out var price) ? price : 0,
                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,
                    ProjectNo = item.ContainsKey("CostCenterName") ? item["CostCenterName"]?.ToString() : "",
                   DueDate = item.ContainsKey("DueDate") && item["DueDate"] != null
                        ? Convert.ToDateTime(item["DueDate"])
                        : DateTime.Now,

                    IsEditable = true
                };

                var existing = PurchPoVMs.PurchPoSubVMs
                .FirstOrDefault(x => x.ItemId == subVm.ItemId && x.RefQuoteSubId == subVm.RefQuoteSubId)
                 ?? PurchPoVMs.PurchPoSubVMs .FirstOrDefault(x => x.ItemId == 0 || string.IsNullOrEmpty(x.ItemName));

                if(existing != null)
                {
                    existing.RefQuoteSubId = subVm.RefQuoteSubId;
                    existing.RefQuoteNo = subVm.RefQuoteNo;
                    existing.RefQuoteDate = subVm.RefQuoteDate;
                    existing.ItemCode = subVm.ItemCode;
                    existing.ItemName = subVm.ItemName;
                    existing.MeasureUnit = subVm.MeasureUnit;
                    existing.HSNCode = subVm.HSNCode;
                    existing.Qty = subVm.Qty;
                    existing.BalQty = subVm.BalQty;
                    existing.ROL = subVm.ROL;
                    existing.UnitPrice = subVm.UnitPrice;
                    existing.CostId = subVm.CostId;
                    existing.ProjectNo = subVm.ProjectNo;
                    existing.DueDate = subVm.DueDate;
                    existing.IsEditable = subVm.IsEditable;
                    existing.ItemId= subVm.ItemId;


                }
                else
                {
                    PurchPoVMs.PurchPoSubVMs.Add(subVm);
                }
            }

            int slNo = 1;
            foreach (var row in PurchPoVMs.PurchPoSubVMs)
            {
                row.SlNo = slNo++;
            }
             await _calculationService.UpdateTotalsAsync(PurchPoVMs);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnEnquirySelectedAsync failed.");
            await _js.ToastrError("Error processing selected enquiry items.");
        }
    }

