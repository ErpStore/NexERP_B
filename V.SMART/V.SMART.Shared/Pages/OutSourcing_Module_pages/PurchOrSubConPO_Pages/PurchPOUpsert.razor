    private async Task OnProcessChanged( int? selectedId,  PurchPoSubVM subitem)
  {
      try
      {
          subitem.ProcessId = selectedId;

          if (selectedId.HasValue && selectedId.Value > 0)
          {
              var selectedProcess = ProcessFlowChartVMs
                  .FirstOrDefault(x => x.Id == selectedId.Value);

              subitem.ProcessName = selectedProcess?.ProcessName;

              if ((subitem.ItemId ?? 0) > 0 &&
                  (subitem.RCId ?? 0) > 0)
              {
                  subitem.RefRcSubId =
                      await purchPoSevice
                      .GetRcdetailsByCompIdRcsubidAsync(
                          subitem.ItemId ?? 0,
                          selectedId.Value,subitem.RCId ?? 0);
              }

              if (subitem.RefRcSubId.HasValue &&  subitem.RefRcSubId.Value > 0)
              {
                  string? pono =  await purchPoSevice  .GetPoNoAndSuffixByRcSubAsync(subitem.RefRcSubId.Value);

                  if (!string.IsNullOrEmpty(pono))
                  {
                      await _js.ToastrWarning(
                          $"Route Card and Process already exist in SubCon PO : {pono}");

                      subitem.ProcessId = null;
                      subitem.ProcessName = null;
                      subitem.RCId = null;
                      subitem.RefRcNo=null;
                      subitem.RefRcDate = null;
                      subitem.RefRcSubId = null;
                      subitem.SelectedRouteCard=null;
                     
                  }
              }
          }
          else
          {
              subitem.ProcessName = null;
              subitem.RefRcSubId = null;
          }

          await InvokeAsync(StateHasChanged);
      }
      catch (Exception ex)
      {
          Console.WriteLine(ex.Message);
      }
  }
