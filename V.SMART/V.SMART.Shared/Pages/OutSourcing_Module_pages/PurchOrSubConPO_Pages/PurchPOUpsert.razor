@page "/PurchPO/create"
@page "/PurchPO/create/{VendorCode:int}"
@page "/PurchPO/update/{PoId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.IPurchOrSubConPoService
@using V.SMART.Shared.Pages.Master_Module_pages.VendorSupplier_Pages
@using V.SMART.Shared.Repository.IRepository.IMasterRepository.IAdmins
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchPoVM
@using MudBlazor

@inherits BaseUserRightsComponent
@inject ICalculationService _calculationService
@inject IPurchPoService purchPoSevice
@inject ILoggingService LoggingService
@inject PoSelectionService PoSelection
@inject NavigationManager _navigationManager
@inject IJSRuntime _js
@inject ReportService reportService
@inject IUserAuthorityRepository userAuthority

<BsModal OnModalConfirmation="@HandleModalConfirmation"
    ButtonBootstrapStyle="@btnColor"
    ButtonText="@btnText"
    Title=@ModalTitle
    ShowReasonBox="@showCancelReasonBox"
    Reason="@cancelReason"
    OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="@ModalTitle"
    Columns="@ModalColumns"
    ColumnFields="@ModalFields"
    HiddenColumns="@ModalHiddenColumns"
    Data="@ModalData"
    IsVisible="@IsModalVisible"
    IsVisibleChanged="@((val) => IsModalVisible = val)"
    OnSelectedItems="OnModalSelectedAsync">
</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
   @if (ActiveModal == "Vendor")
    {
        <VendorUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if(ActiveModal == "Terms")
    {
        <TermsUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
            refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
    position: sticky;
    right: 0;
    background-color: #f8f9fa;
    z-index: 10;
}
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div tabindex="0" @onkeydown="HandleKeyDown">
        <div class="container-fluid px-2 px-md-5 mt-4">
            <div class="card shadow-sm border-1">

                <!-- Cancelled Watermark -->
                @if (PurchPoVMs.PoCancl)
                {
                    <div class="cancelWatermark">CANCELLED</div>
                }
                else if(PurchPoVMs.PoShortClose)
                {
                        <div class="cancelWatermark">SHORT-CLOSED</div>
                }

                <PageHeader TitleText="@(PurchPoVMs.PoId > 0 ? "Update Purchase Order" : "Create Purchase Order")"
                    TitleIcon="bi bi-tag"
                    Breadcrumbs="@PoFormBreadcrumbs" />

                <div class="card-body bg-light">
                    <EditForm Model="PurchPoVMs" OnValidSubmit="UpsertPo">
                        <ObjectGraphDataAnnotationsValidator  />
                        <ValidationSummary />

                        <div class="row g-3 mb-2 align-items-center">

                            <!-- Purchase / SubContract -->
                            <div class="col-12 col-lg-6">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-body">

                                        <div class="d-flex flex-column flex-md-row justify-content-around align-items-md-center gap-3">

                                            <!-- Purchase -->
                                            <div class="form-check form-switch d-flex align-items-center gap-2">

                                                <input class="form-check-input"
                                                    type="checkbox"
                                                    id="PurchaseOrder"
                                                    checked="@PurchPoVMs.PurchORSubCon"
                                                    @onchange="OnManufacturingToggle" />

                                                <label class="form-check-label fw-semibold @(PurchPoVMs.PurchORSubCon ? "text-success" : "text-secondary")"
                                                    for="PurchaseOrder">

                                                    <i class="bi bi-bag-check-fill me-1"></i>
                                                    Purchase

                                                </label>

                                            </div>

                                            <!-- SubContract -->
                                            <div class="form-check form-switch d-flex align-items-center gap-2">

                                                <input class="form-check-input"
                                                    type="checkbox"
                                                    id="SubContract"
                                                    checked="@(!PurchPoVMs.PurchORSubCon)"
                                                    @onchange="OnLabourToggle" />

                                                <label class="form-check-label fw-semibold @(!PurchPoVMs.PurchORSubCon ? "text-danger" : "text-secondary")"
                                                    for="SubContract">

                                                    <i class="bi bi-people-fill me-1"></i>
                                                    SubContract

                                                </label>

                                            </div>

                                        </div>

                                        <ValidationMessage For="@(() => PurchPoVMs.PurchORSubCon)" />

                                    </div>
                                </div>
                            </div>

                            @if (!PurchPoVMs.PurchPoSubVMs.Any(x => x.RefQuoteSubId > 0))
                            {
                                <!-- Open PO -->
                                <div class="col-12 col-md-6 col-lg-2">
                                    <div class="card shadow-sm border-0 h-100">
                                        <div class="card-body d-flex align-items-center justify-content-center">

                                            <div class="form-check form-switch d-flex align-items-center gap-2">

                                                <input class="form-check-input"
                                                type="checkbox"
                                                id="OpenPOSwitch"
                                                checked="@PurchPoVMs.IsOpenPO"
                                                disabled="@PurchPoVMs.PurchPoSubVMs.Any(x => !string.IsNullOrEmpty(x.ItemCode))"
                                                @onchange="OnOpenPOToggle" />

                                                <label class="form-check-label fw-semibold @(PurchPoVMs.IsOpenPO ? "text-primary" : "text-secondary")"
                                                for="OpenPOSwitch">

                                                    <i class="bi bi-folder2-open me-1"></i>
                                                    Open PO

                                                </label>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Service Bill -->
                            <div class="col-12 col-md-6 col-lg-2">
                                    <div class="card shadow-sm border-0 h-100">
                                        <div class="card-body d-flex align-items-center justify-content-center">

                                            <div class="form-check form-switch d-flex align-items-center gap-2">

                                                <input class="form-check-input"
                                                    type="checkbox"
                                                    id="ServiceBillSwitch"
                                                    checked="@(PurchPoVMs.IsServiceBill ?? false)"
                                                    disabled="@PurchPoVMs.PurchPoSubVMs.Any(x => !string.IsNullOrEmpty(x.ItemCode))"
                                                    @onchange="OnOpenServiceBillToggle" />

                                                <label class="form-check-label fw-semibold @((PurchPoVMs.IsServiceBill ?? false) ? "text-primary" : "text-secondary")"
                                                    for="ServiceBillSwitch">

                                                    <i class="bi bi-receipt me-1"></i>
                                                    Service Bill

                                                </label>

                                            </div>

                                        </div>
                                    </div>
                                </div>
     
                            <!-- Correspondence Status -->
                            <div class="col-12 col-lg-2 d-flex justify-content-end align-items-center">
                                @if (PurchPoVMs.PoId > 0 && !string.IsNullOrWhiteSpace(PurchPoVMs.PONo))
                                {
                                    <CorrespondenceStatus ReferenceType="@ScreenName"
                                                            ReferenceId="@PurchPoVMs.PoId"
                                                            ReferenceTypeName="@PurchPoVMs.PONo" />
                                }
                            </div>

                        </div>

                        <div class="row g-3 mb-2">
                            <!-- =================== Vendor Information Card =================== -->
                            <div class="col-12 col-lg-6 mb-2">
                                <div class="card h-100 shadow-sm">

                                    <!-- Header -->
                                    <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                        <span class="fw-bold fs-6">Vendor Information</span>
                                        <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Vendor")'>
                                            <i class="bi bi-person-add me-1"></i> Add Vendor
                                        </button>
                                    </div>

                                    <div class="card-body">
                                        <!-- Customer Autocomplete -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>M/S.*</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <MudAutocomplete T="VendorVM"
                                                    Value="SelectedVendor"
                                                    ValueChanged="@(async c => await OnVendorChanged(c))"
                                                    ToStringFunc="@(c => c?.VendorName ?? string.Empty)"
                                                    SearchFunc="SearchVendors"
                                                    Dense="true"
                                                    Variant="Variant.Outlined"
                                                    Placeholder="Search Customer"
                                                    Title="Search atleast 3 letters in Customer"
                                                    Class="w-100 autocomplete-sm"
                                                    MaxItems="50"
                                                    Clearable="true"
                                                    ResetValueOnEmptyText="true"
                                                    Required="true"
                                                    AvoidSubmit="true"
                                                    Disabled="@(IsSomeItemsTransMade || PurchPoVMs.PoShortClose)" />

                                            </div>
                                        </div>

                                        <!-- Address -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Address</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1" readonly>@PurchPoVMs?.VendorAddress</textarea>
                                            </div>
                                        </div>
                                        <!-- Contact Person -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Contact Person</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                    <select class="form-select form-select-sm rounded-3 w-100"
                                                            @bind="@PurchPoVMs.KindOfAttention"
                                                                @bind:after="OnContactPersonChanged">
                                                        <option disabled value="">Select Contact Person</option>
                                                        @foreach (var cp in contactPersons)
                                                        {
                                                            <option value="@cp.ContactPerson">@cp.ContactPerson</option>
                                                        }
                                                </select>
                                                <ValidationMessage For="@(() => PurchPoVMs.KindOfAttention)" />
                                            </div>
                                        </div>

                                        <!-- Shipping Address -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Shipping Address</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <div class="form-check form-switch d-flex align-items-center">
                                                    <input class="form-check-input" type="checkbox" id="SameAsShipping"
                                                            checked="@PurchPoVMs.IsSameAsShipping"
                                                            @onchange="OnShippingChange" />
                                                    <label class="form-check-label ms-2 fw-semibold"
                                                            for="SameAsShipping">Same as Shipping</label>
                                                </div>
                                            </div>
                                        </div>

                                        @if (!PurchPoVMs.IsSameAsShipping)
                                        {
                                            <!-- Shipping To -->
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Shipping To</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <select value="@PurchPoVMs.ShipAddrsId"
                                                            class="form-select form-select-sm rounded-3 w-100"
                                                            @onchange="OnConsigneeChangedAsync">
                                                        <option value="">Select Shipping Address</option>
                                                        @foreach (var consine in consineeAddress)
                                                        {
                                                            <option value="@consine.AltVendorCode">@consine.AltVendorName</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            @if (PurchPoVMs.ShipAddrsId > 0)
                                            {
                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>Address</small>
                                                    </label>
                                                    <div class="col-12 col-lg-9">
                                                        <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                                value="@PurchPoVMs.ShippingAddress" readonly />
                                                    </div>
                                                </div>

                                                <div class="mb-2 row">
                                                    <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                        <small>Contact No</small>
                                                    </label>
                                                    <div class="col-12 col-sm-9">
                                                        <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                                value="@PurchPoVMs.ShippingContactNo" readonly />
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- =================== PO Detail =================== -->
                            <div class="col-12 col-lg-6 mb-2">
                                <div class="card h-100 shadow-sm">

                                    <!-- Header -->
                                    <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                        <span class="fw-bold fs-6">Purchase Order Details</span>

                                        @if (PoId > 0 && (PurchPoVMs.PurchPoSubVMs == null || !PurchPoVMs.PurchPoSubVMs.Any(x => x.ItemCancel)) && (CanCreate || CanEdit))
                                        {
                                            <div class="d-flex gap-2 ms-auto">

                                                <!-- Cancel / Revert Button -->
                                                <button type="button"
                                                        class="btn btn-sm rounded-3 @(PurchPoVMs.PoCancl ? "btn-success" : "btn-danger")"
                                                        @onclick="() => Cancel()"
                                                        disabled="@PurchPoVMs.PoShortClose">

                                                    @if (!PurchPoVMs.PoCancl)
                                                    {
                                                        <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                                    }
                                                </button>

                                                <!-- Short Closed / Reopen Button -->
                                                <button type="button"
                                                        class="btn btn-sm rounded-3 @(PurchPoVMs.PoShortClose ? "btn-success" : "btn-warning")"
                                                        @onclick="() => AskToShortCloseAsync()"
                                                        disabled="@PurchPoVMs.PoCancl">

                                                    @if (!PurchPoVMs.PoShortClose)
                                                    {
                                                        <i class="bi bi-box-seam me-1"></i> <span>Short Closed</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Re-Open</span>
                                                    }
                                                </button>

                                            </div>
                                        }

                                    </div>

                                    <div class="card-body">

                                        <!--Incoming PO No -->
                                        <div class="row g-2 align-items-center mb-3">
                                            <div class="col-md-3 text-start">
                                                <label class="form-label text-dark mb-0"><small>PO No.</small></label>
                                            </div>
                                            <div class="col-md-9">

                                                <div class="input-group input-group-sm w-100">
                                                    <!-- Prefix -->
                                                    <input type="text"
                                                            class="form-control rounded-start"
                                                            placeholder="Prefix"
                                                            maxlength="10"
                                                            @bind="@PurchPoVMs.Prefix"
                                                            style="max-width: 100px;" />

                                                    <!-- PO / Enquiry Number -->
                                                    <input type="text"
                                                            class="form-control"
                                                            placeholder="PO / Enquiry No."
                                                            @bind="@PurchPoVMs.PONo"
                                                            style="flex: 1;" readonly />

                                                    <!-- Revision Number -->
                                                    @if ( PurchPoVMs.RevisionNo > 0)
                                                    {
                                                        <span class="input-group-text text-dark"
                                                                style="min-width: 70px; text-align: center;">
                                                            <small>@($"R{PurchPoVMs.RevisionNo}")</small>
                                                        </span>
                                                    }

                                                    <!-- Suffix -->
                                                    <span class="input-group-text rounded-end text-dark"
                                                            style="min-width: 80px; text-align: center;">
                                                        <small>@PurchPoVMs.Suffix</small>
                                                    </span>
                                                </div>

                                                <!-- Validation Messages -->
                                                <div class="mt-1">
                                                    <ValidationMessage For="@(() => PurchPoVMs.Prefix)" />
                                                    <ValidationMessage For="@(() => PurchPoVMs.PONo)" />
                                                </div>
                                                </div>

                                        </div>

                                        <!-- PO Date -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>PO Date</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <InputDate class="form-control form-control-sm rounded-3"
                                                            @bind-Value="@PurchPoVMs.PODate" />
                                                <ValidationMessage For="@(() => PurchPoVMs.PODate)" />
                                            </div>
                                        </div>

                                        @if (!PurchPoVMs.PoShortClose && !PurchPoVMs.PoCancl)
                                        {
                                            <div class="card shadow-sm mb-3">
                                                <div class="card-header py-2 bg-light">
                                                    <strong>
                                                        <i class="bi bi-link-45deg me-1"></i>
                                                        References
                                                    </strong>
                                                </div>

                                                <div class="card-body p-2">
                                                    <div class="row g-2">

                                                        <!-- PR / MR -->
                                                        <div class="col-12 col-sm-6">
                                                            <button class="btn btn-sm btn-primary w-100 h-100"
                                                                    @onclick="ShowPRNModal">
                                                                <i class="bi bi-list-ul me-1"></i>
                                                                View PR / MR Details
                                                            </button>
                                                        </div>

                                                        <!-- Quotation -->
                                                        @if (quotePendingCount > 0 && !PurchPoVMs.IsOpenPO)
                                                        {
                                                            <div class="col-12 col-sm-6">
                                                                <button class="btn btn-sm btn-primary w-100 h-100"
                                                                        @onclick="ShowQuotationDetails">
                                                                    <i class="bi bi-list-ul me-1"></i>
                                                                    View Quotation Details
                                                                </button>
                                                            </div>
                                                        }

                                                    </div>
                                                </div>


                                            </div>
                                        }

                                        <!-- Currency -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Currency</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select class="form-select form-select-sm rounded-3 w-100"
                                                        value="@PurchPoVMs.CurrId"
                                                        @onchange="OnCurrencyChanged"
                                                        disabled>
                                                    @foreach (var currency in Currencies)
                                                    {
                                                        <option value="@currency.CurrId">@currency.CurrName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        <!-- Payment Terms -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Payment Terms</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="PurchPoVMs.PayTerms"></textarea>
                                                <ValidationMessage For="@(() => PurchPoVMs.PayTerms)" />
                                            </div>
                                        </div>

                                        <!-- Delivery Terms -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Delivery Terms</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="PurchPoVMs.DeliveryTerms"></textarea>
                                                <ValidationMessage For="@(() => PurchPoVMs.DeliveryTerms)" />
                                            </div>
                                        </div>

                                        <!-- Remarks -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Remarks</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <textarea class="form-control form-control-sm rounded-3 w-100"
                                                            rows="1"
                                                            @bind="PurchPoVMs.MainRemark"></textarea>
                                                <ValidationMessage For="@(() => PurchPoVMs.MainRemark)" />
                                            </div>
                                        </div>

                                        <!-------------------------------->
                                        @if (!string.IsNullOrEmpty(PurchPoVMs.CancelReason))
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Cancel Remarks</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <textarea class="form-control form-control-sm rounded-3 w-100"
                                                    rows="1"
                                                    @bind="PurchPoVMs.CancelReason"></textarea>
                                                    <ValidationMessage For="@(() => PurchPoVMs.CancelReason)" />
                                                </div>
                                            </div>
                                        }
                                           
                                        <div class="row mt-2">
                                            <!-- Rejection & Re-track Required -->
                                            <div class="col-md-6 d-flex align-items-center">
                                                <div class="form-check">
                                                    <InputCheckbox
                                                        @bind-Value="PurchPoVMs.isRejTrackReq"
                                                        id="isRejectionReq"
                                                        class="form-check-input"
                                                        disabled="@IsSomeItemsTransMade" />

                                                    <label 
                                                        class="form-check-label text-danger fw-semibold ms-2"
                                                        for="isRejectionReq"
                                                        title="Enable this if rejection or re-tracking is required for this Purchase Order">
                                                        Rejection & Re-Track Required
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- =================== Item Details =================== -->
                            <div class="col-12">
                                <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                               
                                    <div class="card-header bg-primary-subtle text-dark">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap">

                                            <!-- Title -->
                                            <span class="fw-bold fs-6">Item Details</span>

                                            <!-- Right Controls -->
                                            <div class="d-flex flex-wrap align-items-center gap-2">

                                                <!-- Due Date + Update -->
                                                <div class="d-flex align-items-center gap-2">
                                                    <label class="mb-0 fw-semibold">Due Date:</label>
                                                    <InputDate @bind-Value="DueDate" class="form-control form-control-sm" style="width:150px;" />
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick="UpdateDueDate">
                                                        <i class="bi bi-pencil-square me-1"></i> Update
                                                    </button>
                                                </div>

                                                <!-- Discount Toggle -->
                                                <div class="d-flex align-items-center gap-2">
                                                    <label class="mb-0"><small>Discount:</small></label>
                                                    <div class="btn-group btn-group-sm rounded-pill border" role="group">
                                                        <input type="radio" class="btn-check" name="toggleDiscount" id="discountToggleRs" 
                                                                @onchange='() => SetDiscountMode(true)' 
                                                                checked="@PurchPoVMs.IsItemWiseDiscAmtOrPerReq" />
                                                        <label class="btn btn-outline-primary rounded-start-pill" for="discountToggleRs">@PurchPoVMs.Symbol</label>

                                                        <input type="radio" class="btn-check" name="toggleDiscount" id="discountTogglePercent" 
                                                                @onchange='() => SetDiscountMode(false)' 
                                                                checked="@(!PurchPoVMs.IsItemWiseDiscAmtOrPerReq)" />
                                                        <label class="btn btn-outline-primary rounded-end-pill" for="discountTogglePercent">%</label>
                                                    </div>
                                                </div>
                                                 <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button"
                                                            data-bs-toggle="dropdown">
                                                        <i class="bi bi-layout-three-columns"></i> Columns
                                                    </button>

                                                    <div class="dropdown-menu p-2  bg-light" style="max-height:300px;overflow-y:auto;min-width:250px;">
                                                            @foreach (var col in Columns.OrderBy(x => x.Title))
                                                            {
                                                                <div class="form-check">
                                                                    <input class="form-check-input"
                                                                            type="checkbox"
                                                                            checked="@col.IsVisible"
