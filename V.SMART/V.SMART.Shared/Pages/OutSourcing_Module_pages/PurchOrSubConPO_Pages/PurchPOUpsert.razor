                                                                 {
                                                                     <th style="width:110px;">Disc Amt</th>
                                                                 }
                                                             }
                                                             else
                                                             {
                                                                  @if (ShowColumn(nameof(PurchPoSubVM.LineDiscountAmount)))
                                                                 {
                                                                     <th style="width:110px;">Disc Amt</th>
                                                                 }
                                                             }

                                                             @if (SelectedVendor?.TaxValidate == false)
                                                             {
                                                                 @if(SelectedVendor?.BusiType == "Local")
                                                                 {
                                                                          @if (ShowColumn(nameof(PurchPoSubVM.LineCGSTRate)))
                                                                         {
                                                                                 <th style="width:110px;">CGST %</th>

                                                                         }
                                                                              @if (ShowColumn(nameof(PurchPoSubVM.LineSGSTRate)))
                                                                         {
                                                                                 <th style="width:110px;">SGST %</th>
                                                                         }
                                                                 }
                                                                 else if(SelectedVendor?.BusiType == "InterState")
                                                                 {
                                                                          @if (ShowColumn(nameof(PurchPoSubVM.LineIGSTRate)))
                                                                         {
                                                                                 <th style="width:110px;">IGST %</th>
                                                                         }
                                                                 }
                                                             }

                                                                  @if (ShowColumn(nameof(PurchPoSubVM.LineBasicAmount)))
                                                             {
                                                             <th style="width:130px;">Basic Amount</th>
                                                             }
          
                                                               @if (ShowColumn(nameof(PurchPoSubVM.DueDate)))
                                                            {
                                                                <th style="width:130px;"> Due Date</th>
                                                            }
                                                              @if (ShowColumn(nameof(PurchPoSubVM.Remark)))
                                                             {
                                                                 <th style="width:200px;">Remarks</th>
                                                             }

                                                             @if(PurchPoVMs.PurchPoSubVMs.Any( x=> x.RefMReqSubId.GetValueOrDefault() > 0))
                                                             {
                                                                  @if (ShowColumn(nameof(PurchPoSubVM.RefMReqNo)))
                                                                 {
                                                                     <th style="width:110px;">Indent No.</th>
                                                                 }
                                                                  @if (ShowColumn(nameof(PurchPoSubVM.RefMReqDate)))
                                                                 {
                                                                     <th style="width:110px;" >Indent Date</th>
                                                                 }
                                                             }

                                                             @if(PurchPoVMs.PurchPoSubVMs.Any( x=> x.RefQuoteSubId.GetValueOrDefault() > 0))
                                                             {
                                                                  @if (ShowColumn(nameof(PurchPoSubVM.RefQuoteNo)))
                                                                 {
                                                                     <th style="width:110px;">Ref Quote No.</th>
                                                                 }
                                                                      @if (ShowColumn(nameof(PurchPoSubVM.RefQuoteDate)))
                                                                 {
                                                                     <th style="width:110px;">Ref Quote Dt.</th>
                                                                 }
                                                             }
                                                              @if (ShowColumn(nameof(PurchPoSubVM.ProjectNo)))
                                                             {
                                                                 <th style="width:150px;">Cost-Center</th>
                                                             }

                                                            @if (!PurchPoVMs.PoCancl && PoId.GetValueOrDefault() > 0)
                                                             {
                                                                 @if (ShowColumn(nameof(PurchPoSubVM.ItemCancel)))
                                                                  {
                                                                     <th style="width:130px;">Item Cancel</th>
                                                                 }
                                                                 @if (ShowColumn(nameof(PurchPoSubVM.ItemCancelReason)))
                                                                 {
                                                                     <th style="width:190px;">Cancel Remarks</th>
                                                                 }
                                                             }
                                                             @if(!PurchPoVMs.PurchORSubCon)
                                                             {
                                                                @if (ShowColumn(nameof(PurchPoSubVM.RefRcNo)))
                                                                {
                                                                    <th style="width:200px;">Rc No.</th>
                                                                }
                                                                @if (ShowColumn(nameof(PurchPoSubVM.ProcessName)))
                                                                {
                                                                    <th style="width:150px;">Process</th>
                                                                }
                                                             }
               

                                                             @if(!PurchPoVMs.PoCancl && !PurchPoVMs.PoShortClose)
                                                             {
                    
                                                                     <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                     
                     
                                                             }
                                                         </tr>
                                                     </thead>

                                                     <tbody class="custom-size">
                                                         @foreach (var subitem in PurchPoVMs.PurchPoSubVMs)
                                                         {

                                                             <tr class="@(subitem.ItemCancel ? "table-danger" : "")" @key="subitem">
                                                                   @if (ShowColumn(nameof(PurchPoSubVM.SlNo)))
                                                                     {
                                                                         <td>@subitem.SlNo</td>
                                                                     }
                                                                    @if (ShowColumn(nameof(PurchPoSubVM.ItemCode)))
                                                                   {
                                                                     <!-- Item Code + Attachments -->
                                                                     <td>
                                                                         <div class="row g-1 align-items-center">
                                                                             <div class="col-10">
                                                                                 @if (subitem.IsEditable && subitem.CanEditItem)
                                                                                 {
                                                                                     <MudAutocomplete T="ItemVM"
                                                                                                         Value="subitem.SelectedItem"
                                                                                                         ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                                         ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                                         SearchFunc="SearchItems"
                                                                                                          Dense="true"
                                                                                                         Variant="Variant.Outlined"
                                                                                                         Placeholder="Search Item Code"
                                                                                                         Title="Search Atleast 3 Letters in Item-Code"
                                                                                                         Class="w-100 autocomplete-sm"
                                                                                                         MaxItems="50" />
                                                                                     <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                                 }
                                                                                 else
                                                                                 {
                                                                                     @subitem.ItemCode
                                                                                 }
                                                                             </div>
                                                                             <div class="col-2 text-center">
                                                                                 @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                                         && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                                 {
                                                                                     <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                                     Size="Size.Small"
                                                                                                     Color="Color.Primary"
                                                                                                     OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                                     Edge="Edge.End"
                                                                                                     Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                                 }
                                                                             </div>
                                                                         </div>
                                                                     </td>
                                                                     }
                                                           @if (ShowColumn(nameof(PurchPoSubVM.ItemName)))
                                                             {
                                                                 <td>@subitem.ItemName</td>
                                                             }
                                                               @if (ShowColumn(nameof(PurchPoSubVM.MeasureUnit)))
                                                             {
                                                                 <td>@subitem.MeasureUnit</td>
                                                             } 
                                                             @if (ShowColumn(nameof(PurchPoSubVM.HSNCode)))
                                                             {
                                                                 <td>@subitem.HSNCode</td>
                                                             }
                                                               @if (ShowColumn(nameof(PurchPoSubVM.Qty)))
                                                             {
                                                                 <!-- Qty -->
                                                                 <td>

                                                                     @if (subitem.IsEditable)
                                                                     {
                                                                             <input type="number"
                                                                                     class="form-control form-control-sm"
                                                                                     placeholder="Qty"
                                                                                     title="Enter Quantity"
                                                                                     step="any"
                                                                                     min="0"
                                                                                     @bind="subitem.Qty"
                                                                                     @bind:event="oninput"
                                                                                     @onchange="@(e => OnQtyChange(e, subitem))" 
                                                                                     readonly="@(PurchPoVMs.IsRevision && (subitem.RefMReqSubId>0 || subitem.RefQuoteSubId>0))" />
                                                                         <ValidationMessage For="@(() => subitem.Qty)"/>
                                                                     }
                                                                     else
                                                                     {
                                                                         <span>@subitem.Qty</span>
                                                                     }
                                                                 </td>
                                                              }
                                                                 <!-- Unit Price -->
                                                              @if (ShowColumn(nameof(PurchPoSubVM.UnitPrice)))
                                                             {
                                                                 <td>
                                                                     @if (subitem.IsEditable)
                                                                     {
                                                                         <input type="number" class="form-control form-control-sm" placeholder="Price" title="Enter Unit Price"
                                                                                 step="any"
                                                                                 min="0"
                                                                                 @bind="subitem.UnitPrice" @bind:event="oninput"
                                                                                 @bind:after='() => _calculationService.UpdateTotalsAsync(PurchPoVMs)' />
                                                                         <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                                     }
                                                                     else
                                                                     {
                                                                         @FormatDecimal(subitem.UnitPrice)
                                                                     }
                                                                 </td>
                                                                 }
                                                                 @if(IsItemROLenable)
                                                                {
                                                                    @if (ShowColumn(nameof(PurchPoSubVM.ROL)))
                                                                    {
                                                                                <td>@subitem.ROL</td>
                                                                    }
                                                                }
                                                             @if (ShowColumn(nameof(PurchPoSubVM.LineGross)))
                                                             {
                                                                 <!-- Line Gross -->
                                                                 <td>@FormatDecimal(subitem.LineGross)</td>
                                                             }

                                                                 <!-- Discount -->
                                                                 @if (!PurchPoVMs.IsItemWiseDiscAmtOrPerReq)
                                                                 {
                                                                    @if (ShowColumn(nameof(PurchPoSubVM.LineDiscountPercent)))
                                                                    {
                                                                            <td>
                                                                                @if (subitem.IsEditable)
                                                                                {
                                                                                    <input type="number" class="form-control form-control-sm" placeholder="Disc %" title="Enter Discount %"
                                                                                            step="any"
                                                                                            @bind="subitem.LineDiscountPercent" @bind:event="oninput"
                                                                                            @bind:after='() => OnLineDiscountPercentChanged(subitem)' />
                                                                                    <ValidationMessage For="@(() => subitem.LineDiscountPercent)" />
                                                                                }
                                                                                else
                                                                                {
                                                                                    @FormatDecimal(subitem.LineDiscountPercent)
                                                                                }
                                                                            </td>
                                                                     }
                                                              @if (ShowColumn(nameof(PurchPoSubVM.LineDiscountAmount)))
                                                             {
                                                                     <td>@FormatDecimal(subitem.LineDiscountAmount)</td>
                                                             }
                                                                 }
                                                                 else
                                                                 {
                                                              @if (ShowColumn(nameof(PurchPoSubVM.LineDiscountAmount)))
                                                             {
                                                                     <td>
                                                                         @if (subitem.IsEditable)
                                                                         {
                                                                             <input type="number" class="form-control form-control-sm" placeholder="Disc Amt" title="Enter Discount Amount"
                                                                                     step="any"
                                                                                     @bind="subitem.LineDiscountAmount" @bind:event="oninput"
                                                                                     @bind:after='() => _calculationService.UpdateTotalsAsync(PurchPoVMs)' />
                                                                             <ValidationMessage For="@(() => subitem.LineDiscountAmount)" />
                                                                         }
                                                                         else
                                                                         {
                                                                             @FormatDecimal(subitem.LineDiscountAmount)
                                                                         }
                                                                     </td>
                                                                     }
                                                                 }

                                                                 <!-- Taxes -->
                                                                 @if (SelectedVendor?.TaxValidate == false)
                                                                 {
                                                                     @if (SelectedVendor?.BusiType == "Local")
                                                                     {
                                                                          @if (ShowColumn(nameof(PurchPoSubVM.LineCGSTRate)))
                                                                         {
                                                                                     <td>
                                                                                         @if (subitem.IsEditable)
                                                                                         {
                                                                                             <select class="form-select form-select-sm" 
                                                                                                 value="@subitem.LineCGSTRate"
                                                                                                 @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                                                 <option value="" disabled selected>CGST %</option>
                                                                                                 @foreach (var rate in CommonConstants.GSTRates)
                                                                                                 {
                                                                                                     <option value="@rate">@rate</option>
                                                                                                 }
                                                                                             </select>
                                                                                             <ValidationMessage For="@(() => subitem.LineCGSTRate)" />
                                                                                         }
                                                                                         else
                                                                                         {
                                                                                             @FormatDecimal(subitem.LineCGSTRate)
                                                                                         }
                                                                                     </td>
                                                                         }
                                                                     @if (ShowColumn(nameof(PurchPoSubVM.LineSGSTRate)))
                                                                     {
                                                                                 <td>
                                                                                     @if (subitem.IsEditable)
                                                                                     {
                                                                                         <select class="form-select form-select-sm" 
                                                                                             value="@subitem.LineSGSTRate"
                                                                                             @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                                             <option value="" disabled selected>SGST %</option>
                                                                                             @foreach (var rate in CommonConstants.GSTRates)
                                                                                             {
                                                                                                 <option value="@rate">@rate</option>
                                                                                             }
                                                                                         </select>
                                                                                         <ValidationMessage For="@(() => subitem.LineSGSTRate)" />

                                                                                     }
                                                                                     else
                                                                                     {
                                                                                         @FormatDecimal(subitem.LineSGSTRate)
                                                                                     }
                                                                                 </td>
                                                                                 }
                                                                     }
                                                                    else if (SelectedVendor?.BusiType == "InterState")
                                                                    {
                                                                        @if (ShowColumn(nameof(PurchPoSubVM.LineIGSTRate)))
                                                                        {
                                                                                    <td>
                                                                                        @if (subitem.IsEditable)
                                                                                        {
                                                                                            <select class="form-select form-select-sm" @bind="subitem.LineIGSTRate" @bind:event="oninput"
                                                                                                    @bind:after='() => _calculationService.UpdateTotalsAsync(PurchPoVMs)'>
                                                                                                <option value="" disabled selected>IGST %</option>
                                                                                                @foreach (var rate in CommonConstants.IGSTRates)
                                                                                                {
                                                                                                    <option value="@rate">@rate</option>
                                                                                                }
                                                                                            </select>
                                                                                            <ValidationMessage For="@(() => subitem.LineIGSTRate)" />
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            @FormatDecimal(subitem.LineIGSTRate)
                                                                                        }
                                                                                    </td>
                                                                        }
                                                                    }
                                                                    }
                                                             @if (ShowColumn(nameof(PurchPoSubVM.LineBasicAmount)))
                                                             {
                                                                 <!-- Basic Amount -->
                                                                 <td>@FormatDecimal(subitem.LineBasicAmount)</td>
                                                             }

                                                                           @if (ShowColumn(nameof(PurchPoSubVM.DueDate)))
                                                             {
                                                                 <td>
                                                                     @if (subitem.IsEditable)
                                                                     {
                                                                         <InputDate @bind-Value="subitem.DueDate"
                                                                                     class="form-control form-control-sm" 
                                                                                     placeholder="Enter Due Date" />
                                                                         <ValidationMessage For="@(() => subitem.DueDate)" />
                                                                     }
                                                                     else
                                                                     {
                                                                         @subitem.DueDate.ToString("dd/MM/yyyy")
                                                                     }
                                                                 </td>
                                                                 }
                                                                @if (ShowColumn(nameof(PurchPoSubVM.Remark)))
                                                               {
                                                                 <!-- Remarks -->
                                                                 <td>
                                                                     @if (subitem.IsEditable)
                                                                     {
                                                                         <InputTextArea @bind-Value="subitem.Remark"
                                                                                     class="form-control form-control-sm" 
                                                                                     placeholder="Enter Remarks"
                                                                                     rows="1"/>
                                                                         <ValidationMessage For="@(() => subitem.Remark)" />
                                                                     }
                                                                     else
                                                                     {
                                                                         @subitem.Remark
                                                                     }
                                                                 </td>
                                                                 }

                                                                 @if(PurchPoVMs.PurchPoSubVMs.Any(x=> x.RefMReqSubId> 0))
                                                                 {
                                                                     @if (ShowColumn(nameof(PurchPoSubVM.RefMReqNo)))
                                                                     {
                                                                             <td>@subitem.RefMReqNo</td>
                                                                     }
                                                                                   @if (ShowColumn(nameof(PurchPoSubVM.RefMReqDate)))
                                                                     {
                                                                             <td>@subitem.RefMReqDate?.ToString("dd/MM/yyyy")</td>
                                                                     }
                                                                 }
                                                                 @if(PurchPoVMs.PurchPoSubVMs.Any(x=> x.RefQuoteSubId> 0))
                                                                 {
                                                                     @if (ShowColumn(nameof(PurchPoSubVM.RefQuoteNo)))
                                                                     {
                                                                             <td>@subitem.RefQuoteNo</td>
                                                                     }
                                                                    @if (ShowColumn(nameof(PurchPoSubVM.RefQuoteDate)))
                                                                     {
                                                                             <td>@subitem.RefQuoteDate?.ToString("dd/MM/yyyy")</td>
                                                                     }
                                                                 }
                                                             @if (ShowColumn(nameof(PurchPoSubVM.ProjectNo)))
                                                             {

                                                                 <!-- Cost Center -->
                                                                        <td>
                                                                            @if (subitem.IsEditable && (subitem.RefQuoteSubId == 0 || subitem.RefQuoteSubId == null) && subitem.Qty == subitem.BalQty)
                                                                            {
                                                                                <select class="form-select form-select-sm" 
                                                                                    value="@subitem.CostId"
                                                                                    @onchange="(e => OnCostCenterChanged(e, subitem))">
                                                                                    <option value="">select CostCentre</option>
                                                                                    @foreach (var cost in CostCenterVMs.Where(c =>
                                                                                            !PurchPoVMs.PurchPoSubVMs.Any(r => r != subitem && r.CostId == c.Id)))
                                                                                    {
                                                                                        <option value="@cost.Id">@cost.ProjectNo</option>
                                                                                    }
                                                                                </select>
                                                                                <ValidationMessage For="@(() => subitem.CostId)" />
                                                                            }
                                                                            else
                                                                            {
                                                                                @subitem.ProjectNo
                                                                            }
                                                                        </td>
                                                              }

                                                            @if (!PurchPoVMs.PoCancl && PoId.GetValueOrDefault() > 0)
                                                            {
                                                                     @if (ShowColumn(nameof(PurchPoSubVM.ItemCancel)))
                                                                    {
                                                                     <td>
                                                                         <div class="text-center align-middle">
                                                                             <div class="form-check form-switch d-flex justify-content-center mb-2">
                                                                                 <InputCheckbox 
                                                                                     @bind-Value="subitem.ItemCancel"
                                                                                     @bind-Value:event="onchange"
                                                                                     ValueChanged="@(async (value) => await OnItemCancelChanged(subitem))"
                                                                                     class="form-check-input border border-2 shadow-lg focus-ring focus-ring-primary p-2 fs-4 rounded-pill" />
                                                                             </div>
                                                                         </div>
                                                                     </td>
                                                                     }
                                                                      @if (ShowColumn(nameof(PurchPoSubVM.ItemCancelReason)))
                                                                     {

                                                                             <td>
                                                                                 @subitem.ItemCancelReason
                                                                             </td>
                                                                     }
                                                             }

                                                              @if(!PurchPoVMs.PurchORSubCon)
                                                             {
                                                               @if (ShowColumn(nameof(PurchPoSubVM.RefRcNo)))
                                                               {
                                                                 <td>
                                                                 @if (subitem.IsEditable &&
                                                                     (subitem.PoSubId == 0 || subitem.PoSubId == null) &&
                                                                     subitem.Qty == subitem.BalQty &&
                                                                     subitem.CategoryCode == 2)
                                                                 {
                                                                     <MudAutocomplete T="RouteCardVM"
                                                                                      Dense="true"
                                                                                      Variant="Variant.Outlined"
                                                                                      Margin="Margin.Dense"
                                                                                      ResetValueOnEmptyText="true"
                                                                                      CoerceText="true"
                                                                                      CoerceValue="true"
                                                                                      Clearable="true"

                                                                                      Value="subitem.SelectedRouteCard"

                                                                                      ValueChanged="@(async (RouteCardVM rc) =>
                                                                                      {
                                                                                          subitem.SelectedRouteCard = rc;

                                                                                          subitem.RCId = rc?.RCId;

                                                                                          subitem.ProcessId = null;
                                                                                          subitem.RefRcSubId = null;
                                                                                          ProcessFlowChartVMs.Clear();

                                                                                          if (rc?.RCId > 0)
                                                                                          {
                                                                                              ProcessFlowChartVMs =
                                                                                                  await purchPoSevice
                                                                                                      .GetProcessByRcIdAsync(rc.RCId);
                                                                                          }

                                                                                          StateHasChanged();
                                                                                      })"

                                                                                      SearchFunc="@(async (string value, CancellationToken token) =>
                                                                                      {
                                                                                          // Load only first time
                                                                                          if (subitem.RouteCards == null ||
                                                                                              !subitem.RouteCards.Any())
                                                                                          {
                                                                                              subitem.RouteCards =
                                                                                                  await purchPoSevice
                                                                                                      .GetRcdetailsByCompIdAsync(subitem.ItemId ?? 0);
                                                                                          }

                                                                                          if (string.IsNullOrWhiteSpace(value))
                                                                                              return subitem.RouteCards;

                                                                                          return subitem.RouteCards
                                                                                              .Where(x => x.RCNo.Contains(value,
                                                                                                  StringComparison.OrdinalIgnoreCase));
                                                                                      })"

                                                                                      ToStringFunc="@(x => x?.RCNo)"
                                                                                      Placeholder="Search Route Card" />
                                                                 }
                                                                 else
                                                                 {
                                                                     @subitem.RefRcNo
                                                                 }

                                                                 </td>
                                                               }
                                                                @if (ShowColumn(nameof(PurchPoSubVM.ProcessName)))
                                                                    {
                                                                        <td>
                                                                                    @if (subitem.IsEditable &&
                                                                                        (subitem.PoSubId == 0 || subitem.PoSubId == null) &&
                                                                                        subitem.Qty == subitem.BalQty &&
                                                                                        subitem.CategoryCode == 2)
                                                                                    {
                                                                                        <InputSelect class="@($"form-select form-select-sm {(subitem.RCId > 0 && !(subitem.ProcessId > 0) ? "border border-danger" : "")}")"
                                                                                                    TValue="int?"
                                                                                                    Value="subitem.ProcessId"
                                                                                                    ValueChanged="@(async (int? value) => await OnProcessChanged(value, subitem))"
                                                                                                    ValueExpression="@(() => subitem.ProcessId)"

                                                                                                    disabled="@(subitem.RCId == null || subitem.RCId <= 0)"
                                                                                                    required="@(subitem.RCId > 0)"
                                                                                                    title="@(subitem.RCId > 0 && !(subitem.ProcessId > 0)
                                                                                                            ? "Process is mandatory"
                                                                                                            : "")">

                                                                                            <option value="">Select Process</option>

                                                                                            @foreach (var process in ProcessFlowChartVMs)
                                                                                            {
                                                                                                <option value="@process.Id">
                                                                                                    @process.ProcessName
                                                                                                </option>
                                                                                            }

                                                                                        </InputSelect>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        @subitem.ProcessName
                                                                                    }
    
                                                                        </td>
                                                                     }
                                                                 }
                                                                 <!-- Action Buttons -->
                                                                 <td class="freeze-last-col text-end align-middle">
                                                                     @if (!PurchPoVMs.PoCancl && !PurchPoVMs.PoShortClose)
                                                                     { 
                                                                         <div class="d-inline-flex gap-1 justify-content-end w-100">
                                                                             @if (subitem.IsEditable)
                                                                             {
                                                                                 <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                                         @onclick="async () => await SaveRow(subitem)" disabled="@subitem.ItemCancel">
                                                                                     <i class="bi bi-check-lg"></i>
                                                                                 </button>
                                                                                 <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                                         @onclick="async () => await CancelEdit(subitem, PurchPoVMs)" disabled="@subitem.ItemCancel">
                                                                                     <i class="bi bi-x-lg"></i>
                                                                                 </button>
                                                                             }
                                                                             else
                                                                             {
                                                                                 <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit" disabled="@subitem.ItemCancel"
                                                                                         @onclick="async () => await EditRowAsync(subitem)">
                                                                                     <i class="bi bi-pencil"></i>
                                                                                 </button>
                                                                                 <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete" disabled="@subitem.ItemCancel"
                                                                                         @onclick="async () => await RemoveRow(subitem)">
                                                                                     <i class="bi bi-trash"></i>
                                                                                 </button>
                                                                             }
                                                                         </div>
                                                                     } 
                                                                 </td>
                                                             </tr>
                                                         }
                                                     </tbody>

                                                     <!-- Totals -->
                                                     @if (PurchPoVMs.PurchPoSubVMs?.Any() == true)
                                                     {
                  
                                                                 <tfoot class="table-warning text-dark">
                     
                                                                     <tr>

                                                                         <td colspan="@GetVisibleColumnsBeforeQty()"
                                                                             class="text-end fw-bold">
                                                                             Totals:
                                                                         </td>

                                                                         @if (ShowColumn(nameof(PurchPoSubVM.Qty)))
                                                                         {
                                                                             <td>@PurchPoVMs.TotalQty</td>
                                                                         }

                                                                         @if (ShowColumn(nameof(PurchPoSubVM.UnitPrice)))
                                                                         {
                                                                             <td>Avg: @FormatDecimal(PurchPoVMs.AvgUnitPrice)</td>
                                                                         }

                                                                         @if (IsItemROLenable && ShowColumn(nameof(PurchPoSubVM.ROL)))
                                                                         {
                                                                             <td></td>
                                                                         }

                                                                         @if (ShowColumn(nameof(PurchPoSubVM.LineGross)))
                                                                         {
                                                                             <td>@FormatDecimal(PurchPoVMs.TotalLineGross)</td>
                                                                         }

                                                                         @if (ShowColumn(nameof(PurchPoSubVM.LineDiscountPercent)))
                                                                         {
                                                                             <td></td>
                                                                         }

                                                                         @if (ShowColumn(nameof(PurchPoSubVM.LineDiscountAmount)))
                                                                         {
                                                                            <td></td>
                                                                         }

                                                                         @if (ShowColumn(nameof(PurchPoSubVM.LineCGSTRate)))
                                                                         {
                                                                             <td></td>
                                                                         }

                                                                         @if (ShowColumn(nameof(PurchPoSubVM.LineSGSTRate)))
                                                                         {
                                                                             <td></td>
                                                                         }
                                                                         @if (SelectedVendor?.BusiType == "InterState")
                                                                         {
                                                                             @if (ShowColumn(nameof(PurchPoSubVM.LineIGSTRate)))
                                                                             {
                                                                                 <td></td>
                                                                             }
                                                                         }

                                                                         @if (ShowColumn(nameof(PurchPoSubVM.LineBasicAmount)))
                                                                         {
                                                                             <td>@FormatDecimal(PurchPoVMs.TotalLineBasicAmount)</td>
                                                                         }
                                                                          <td colspan="@GetRemainingFooterColumns()"></td>


                                                                     </tr>
                                                                 </tfoot>
                   

                                                     }

                                                 </table>
                                             </div>
                                        </div>

                                        @if(!PurchPoVMs.PoCancl && !PurchPoVMs.PoShortClose)
                                        {
                                            <div class="mt-2 text-start">
                                                <button type="button" class="btn btn-success btn-sm" @onclick="AddRow">
                                                    <i class="bi bi-plus-circle me-1"></i> Add Item
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                                <!-- ===================Other Details Terms and Conditions ===================-->
                            <div class="col-12 col-lg-6 mb-3">

                                <!-- ================= Terms & Conditions Card ================= -->
                                <div class="card shadow-sm rounded-4 border-0 mb-4">
                                    <div class="card-body">
                                        <div class="row g-3">

                                            <!-- Terms Dropdown -->
                                            <div class="col-12 col-md-7">
                                                <label class="form-label fw-semibold text-dark">
                                                    <i class="bi bi-file-text me-1 text-primary"></i> Terms & Conditions
                                                </label>

                                                <select class="form-select form-select-sm rounded-3 shadow-sm"
                                                        value="@PurchPoVMs.TermsId"
                                                        @onchange="OnTermsChanged">
                                                    <option value="">-- Select Terms --</option>

                                                    @if (TermsList != null && TermsList.Any())
                                                    {
                                                        @foreach (var term in TermsList)
                                                        {
                                                            <option value="@term.Id">@term.Title</option>
                                                        }
                                                    }
                                                </select>
                                                <ValidationMessage For="@(() => PurchPoVMs.TermsId)" />
                                            </div>

                                            <!-- Create New Terms Button -->
                                            <div class="col-12 col-md-2 d-flex align-items-end">
                                                <button type="button"
                                                        class="btn btn-sm btn-success rounded-3 w-100"
                                                        @onclick='() => OpenModal("Terms")'>
                                                    <i class="bi bi-plus-circle me-1"></i> New
                                                </button>
                                            </div>

                                            <!-- Selected Terms Text -->
                                            @if (!string.IsNullOrEmpty(PurchPoVMs.Details))
                                            {
                                                <div class="col-12">
                                                    <div class="p-3 border rounded-3 bg-light shadow-sm">
                                                        <h6 class="fw-bold text-primary mb-1">Details</h6>
                                                        <p class="mb-0 text-muted" style="white-space: pre-line;">
                                                            @PurchPoVMs.Details
                                                        </p>
                                                    </div>
                                                </div>
                                            }

                                        </div>
                                    </div>
                                </div>

                                <!-- ================= Advance Paid Details Card ================= -->
                                <div class="card shadow-sm rounded-4 border-0">

                                    <!-- Card Header -->
                                    <div class="card-header bg-primary-subtle rounded-top-4">
                                        <div class="row align-items-center">

                                            <!-- Title -->
                                            <div class="col-12 col-md-6">
                                                <h6 class="fw-bold mb-0 text-dark">
                                                    <i class="bi bi-cash-stack me-1 text-success"></i> Advance Paid Details
                                                </h6>
                                            </div>

                                            <!-- Advance Without Tax -->
                                            <div class="col-12 col-md-6 d-flex justify-content-md-end mt-2 mt-md-0">
                                                <div class="form-check mb-0">
                                                    <InputCheckbox
                                                        @bind-Value="PurchPoVMs.AdvacewithOutTax"
                                                        @bind-Value:after="AdvanceCalculate"
                                                        id="AdvanceWithoutTax"
                                                        class="form-check-input"
                                                        disabled="@IsSomeItemsTransMade" />

                                                    <label
                                                        class="form-check-label text-danger fw-semibold ms-2"
                                                        for="AdvanceWithoutTax"
                                                        title="Enable this if the advance amount is without tax for this PO">
                                                        Advance Without Tax
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card Body -->
                                    <div class="card-body">
                                        <div class="row g-3">
                                            <!-- Advance Amount Section -->
                                            <div class="row mb-2 gx-2 mt-3">
                                                <label class="col-5 col-md-4 col-form-label text-dark">
                                                    <small>Advance Amount</small>
                                                </label>
                                                <!-- Toggle Buttons -->
                                                <div class="col-4 col-md-3">
                                                    <div class="btn-group btn-group-sm w-100" role="group">
                                                        <input type="radio"
                                                                class="btn-check"
                                                                name="AdvanceToggle"
                                                                id="AdvanceRs"
                                                                @onchange="() => SetAdvanceType(true)"
                                                                checked="@PurchPoVMs.AdvanceAmtOrPer" />
                                                        <label class="btn btn-outline-primary" for="AdvanceRs">
                                                            <small>@PurchPoVMs.Symbol</small>
                                                        </label>
                                                        <input type="radio"
                                                                class="btn-check"
                                                                name="AdvanceToggle"
                                                                id="AdvancePercent"
                                                                @onchange="() => SetAdvanceType(false)"
                                                                checked="@(!PurchPoVMs.AdvanceAmtOrPer)" />
                                                        <label class="btn btn-outline-primary" for="AdvancePercent">
                                                            <small>%</small>
                                                        </label>
                                                    </div>
                                                </div>

                                                <!-- Amount / Percent Input -->
                                                <div class="col-3 col-md-5">
                                                    @if (PurchPoVMs.AdvanceAmtOrPer)
                                                    {
                                                        <input class="form-control form-control-sm rounded-3 text-end"
                                                                type="number"
                                                                value="@PurchPoVMs.AdvanceAmount"
                                                                @oninput="OnAdvanceAmountChanged" />
                                                        <ValidationMessage For="@(() => PurchPoVMs.AdvanceAmount)" />
                                                    }
                                                    else
                                                    {
                                                        <input class="form-control form-control-sm rounded-3 text-end"
                                                                type="number"
                                                                value="@PurchPoVMs.AdvancePercent"
                                                                @oninput="OnAdvancePercentChanged" />
                                                        <ValidationMessage For="@(() => PurchPoVMs.AdvancePercent)" />

                                                        <small class="text-muted d-block text-end">
                                                            Amt: @PurchPoVMs.AdvanceAmount
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- =================== Tax Details Section =================== -->
                            <div class="col-12 col-lg-6">
                                <div class="card shadow-sm rounded-4 border-0 p-3">

                                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                        <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Tax & Charges
                                    </h6>

                                    <!-- Total Gross -->
                                    <div class="row mb-2 gx-3">
                                        <label for="TotalGross" class="col-5 col-md-4 col-form-label text-dark">
                                            <small>Total Gross</small>
                                        </label>
                                        <div class="col-7 col-md-8">
                                            <input id="TotalGross"
                                                    class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                                    type="number"
                                                    step="any"
                                                    value="@FormatDecimal(PurchPoVMs.TotalGrossAmount)"
                                                    readonly />
                                        </div>
                                    </div>

                                    <!-- Discount -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label text-dark"><small>Discount</small></label>
                                        <div class="col-4 col-md-3">
                                            <div class="btn-group btn-group-sm w-100" role="group">
                                                <input type="radio" class="btn-check" name="discountToggle" id="discountRs"
                                                        @onchange="() => SetDiscountType(true)"
                                                        checked="@PurchPoVMs.DiscAmtOrPer"
                                                        disabled="@(PurchPoVMs.TotalLineDiscountAmount > 0)" />
                                                <label class="btn btn-outline-primary" for="discountRs">
                                                    <small>@PurchPoVMs.Symbol</small>
                                                </label>

                                                <input type="radio" class="btn-check" name="discountToggle" id="discountPercent"
                                                        @onchange="() => SetDiscountType(false)"
                                                        checked="@(!PurchPoVMs.DiscAmtOrPer)"
                                                        disabled="@(PurchPoVMs.TotalLineDiscountAmount > 0)" />
                                                <label class="btn btn-outline-primary" for="discountPercent"><small>%</small></label>
                                            </div>
                                        </div>

                                        <div class="col-3 col-md-5">
                                            @if (PurchPoVMs.DiscAmtOrPer)
                                            {
                                                <input class="form-control form-control-sm rounded-3 text-end"
                                                        type="number"
                                                        step="any"
                                                        @bind="PurchPoVMs.DiscountAmount"
                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(PurchPoVMs)'
                                                        disabled="@(PurchPoVMs.TotalLineDiscountAmount > 0)" />
                                                <ValidationMessage For="@(() => PurchPoVMs.DiscountAmount)" />
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-sm rounded-3 text-end"
                                                        type="number"
                                                        step="any"
                                                        @bind="PurchPoVMs.DiscountPercent"
                                                        @bind:after="OnDiscountPercentChanged"
                                                        disabled="@(PurchPoVMs.TotalLineDiscountAmount > 0)" />
                                                <ValidationMessage For="@(() => PurchPoVMs.DiscountPercent)" />
                                                <small class="text-muted d-block text-end">
                                                    Amt: @FormatDecimal(PurchPoVMs.DiscountAmount)
                                                </small>
                                            }
                                        </div>
                                    </div>

                                    <!-- SubTotal -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label text-dark"><small>SubTotal</small></label>
                                        <div class="col-7 col-md-8">
                                            <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                                    type="number" 
                                                    step="any"
                                                    value="@FormatDecimal(PurchPoVMs.TotalBasicAmount)" 
                                                    readonly />
                                        </div>
                                    </div>

                                    <!-- Freight Charges -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label text-dark"><small>Freight Charges</small></label>
                                        <div class="col-7 col-md-8">
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                    type="number" step="any" @bind="PurchPoVMs.FreightCharges"
                                                    @bind:after='() => _calculationService.UpdateTotalsAsync(PurchPoVMs)' />
                                            <ValidationMessage For="@(() => PurchPoVMs.FreightCharges)" />
                                        </div>
                                    </div>

                                    <!-- P & F Charges -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label text-dark"><small>P & F Charges</small></label>
                                        <div class="col-4 col-md-3">
                                            <div class="btn-group btn-group-sm w-100" role="group">
                                                <input type="radio" class="btn-check" name="packingToggle" id="packingToggleRs"
                                                        @onchange="() => SetPAndFType(true)" checked="@PurchPoVMs.PackingAmtOrPer" />
                                                <label class="btn btn-outline-primary" for="packingToggleRs"><small>@PurchPoVMs.Symbol</small></label>

                                                <input type="radio" class="btn-check" name="packingToggle" id="packingTogglePercent"
                                                        @onchange="() => SetPAndFType(false)" checked="@(!PurchPoVMs.PackingAmtOrPer)" />
                                                <label class="btn btn-outline-primary" for="packingTogglePercent"><small>%</small></label>
                                            </div>
                                        </div>
                                        <div class="col-3 col-md-5">
                                            @if (PurchPoVMs.PackingAmtOrPer)
                                            {
                                                <input class="form-control form-control-sm rounded-3 text-end"
                                                        type="number" step="any" @bind="PurchPoVMs.PackingCharges"
                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(PurchPoVMs)' />
                                                <ValidationMessage For="@(() => PurchPoVMs.PackingCharges)" />
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-sm rounded-3 text-end"
                                                        type="number" step="any" @bind="PurchPoVMs.PackingPercent"
                                                        @bind:after="() => OnPandFPercentChanged()" />
                                                <ValidationMessage For="@(() => PurchPoVMs.PackingPercent)" />
                                                <small class="text-muted d-block text-end">Amt: @FormatDecimal(PurchPoVMs.PackingCharges)</small>
                                            }
                                        </div>
                                    </div>

                                    <!-- Insurance Charges -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label text-dark"><small>Insurance Charges</small></label>
                                        <div class="col-4 col-md-3">
                                            <div class="btn-group btn-group-sm w-100" role="group">
                                                <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceToggleRs"
                                                        @onchange="() => SetInsuranceType(true)" checked="@PurchPoVMs.InsuranceAmtOrPer" />
                                                <label class="btn btn-outline-primary" for="insuranceToggleRs"><small>@PurchPoVMs.Symbol</small></label>

                                                <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceTogglePercent"
                                                        @onchange="() => SetInsuranceType(false)" checked="@(!PurchPoVMs.InsuranceAmtOrPer)" />
                                                <label class="btn btn-outline-primary" for="insuranceTogglePercent"><small>%</small></label>
                                            </div>
                                        </div>
                                        <div class="col-3 col-md-5">
                                            @if (PurchPoVMs.InsuranceAmtOrPer)
                                            {
                                                <input class="form-control form-control-sm rounded-3 text-end"
                                                        type="number" step="any" @bind="PurchPoVMs.InsuranceCharges"
                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(PurchPoVMs)' />
                                                <ValidationMessage For="@(() => PurchPoVMs.InsuranceCharges)" />
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-sm rounded-3 text-end"
                                                        type="number" step="any" @bind="PurchPoVMs.InsurancePercent"
                                                        @bind:after="() => OnInsurancePercentChanged()" />
                                                <ValidationMessage For="@(() => PurchPoVMs.InsurancePercent)" />
                                                <small class="text-muted d-block text-end">Amt: @FormatDecimal(PurchPoVMs.InsuranceCharges)</small>
                                            }
                                        </div>
                                    </div>

                                    <!-- Total Taxable -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label text-dark"><small>Total Taxable</small></label>
                                        <div class="col-7 col-md-8">
                                            <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                                    value="@FormatDecimal(PurchPoVMs.TotalTaxable)"
                                                    step="any"
                                                    readonly />
                                        </div>
                                    </div>

                                    <!-- Taxes (CGST/SGST/IGST) -->
                                    @if (SelectedVendor?.TaxValidate == false)
                                    {
                                        <div class="mb-2">
                                            @if (SelectedVendor?.BusiType == "Local")
                                            {
                                                <!-- CGST -->
                                                <div class="row mb-2 gx-2">
                                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>CGST (%)</small></label>
                                                    <div class="col-3 col-md-4">
                                                        @if (!PurchPoVMs.HasItemWiseTax)
                                                        {
                                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                                    @bind="PurchPoVMs.CGstRate"
                                                                    @bind:after="() => OnMainTaxRateChanged(PurchPoVMs.CGstRate)">
                                                                <option value="0">-- Select CGST % --</option>
                                                                @foreach (var rate in CommonConstants.GSTRates)
                                                                {
                                                                    <option value="@((decimal)rate)">@rate</option>
                                                                }
                                                            </select>
                                                            <ValidationMessage For="@(() => PurchPoVMs.CGstRate)" />
                                                        }
                                                    </div>
                                                    <div class="col-4">
                                                        <input class="form-control form-control-sm text-end"
                                                                value="@FormatDecimal(PurchPoVMs.TotalCGSTAmount)"
                                                                readonly />
                                                    </div>
                                                </div>

                                                <!-- SGST -->
                                                <div class="row mb-2 gx-2">
                                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>SGST (%)</small></label>
                                                    <div class="col-3 col-md-4">
                                                        @if (!PurchPoVMs.HasItemWiseTax)
                                                        {
                                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                                    @bind="PurchPoVMs.SGstRate"
                                                                    @bind:after="() => OnMainTaxRateChanged(PurchPoVMs.SGstRate)">
                                                                <option value="0">-- Select SGST % --</option>
                                                                @foreach (var rate in CommonConstants.GSTRates)
                                                                {
                                                                    <option value="@((decimal)rate)">@rate</option>
                                                                }
                                                            </select>
                                                            <ValidationMessage For="@(() => PurchPoVMs.SGstRate)" />
                                                        }
                                                    </div>
                                                    <div class="col-4">
                                                        <input class="form-control form-control-sm text-end"
                                                                value="@FormatDecimal(PurchPoVMs.TotalSGSTAmount)"
                                                                readonly />
                                                    </div>
                                                </div>
                                            }
                                            else if (SelectedVendor?.BusiType == "InterState")
                                            {
                                                <!-- IGST -->
                                                <div class="row mb-2 gx-2">
                                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>IGST (%)</small></label>
                                                    <div class="col-3 col-md-4">
                                                        @if (!PurchPoVMs.HasItemWiseTax)
                                                        {
                                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                                    @bind="PurchPoVMs.IGstRate"
                                                                    @bind:after="() => _calculationService.UpdateTotalsAsync(PurchPoVMs)"
                                                                    disabled="@(SelectedVendor?.TaxValidate == true)">
                                                                <option value="0">-- Select IGST % --</option>
                                                                @foreach (var rate in CommonConstants.IGSTRates)
                                                                {
                                                                    <option value="@((decimal)rate)">@rate</option>
                                                                }
                                                            </select>
                                                            <ValidationMessage For="@(() => PurchPoVMs.IGstRate)" />
                                                        }
                                                    </div>
                                                    <div class="col-4">
                                                        <input class="form-control form-control-sm text-end"
                                                                value="@FormatDecimal(PurchPoVMs.TotalIGSTAmount)"
                                                                readonly />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- TCS Charges -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label text-dark"><small>TCS Charges</small></label>
                                        <div class="col-4 col-md-3">
                                            <div class="btn-group btn-group-sm w-100" role="group">
                                                <input type="radio" class="btn-check" name="tcsToggle" id="tcsToggleRs"
                                                        @onchange="() => SetTCSType(true)" checked="@PurchPoVMs.TCSAmtOrPer" />
                                                <label class="btn btn-outline-primary" for="tcsToggleRs"><small>@PurchPoVMs.Symbol</small></label>

                                                <input type="radio" class="btn-check" name="tcsToggle" id="tcsTogglePercent"
                                                        @onchange="() => SetTCSType(false)" checked="@(!PurchPoVMs.TCSAmtOrPer)" />
                                                <label class="btn btn-outline-primary" for="tcsTogglePercent"><small>%</small></label>
                                            </div>
                                        </div>
                                        <div class="col-3 col-md-5">
                                            @if (PurchPoVMs.TCSAmtOrPer)
                                            {
                                                <input class="form-control form-control-sm rounded-3 text-end"
                                                        type="number" step="any" @bind="PurchPoVMs.TCSAmount"
                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(PurchPoVMs)' />
                                                <ValidationMessage For="@(() => PurchPoVMs.TCSAmount)" />
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-sm rounded-3 text-end"
                                                        type="number" step="any" @bind="PurchPoVMs.TCSPercent"
                                                        @bind:after="() => OnTCSPercentChanged()" />
                                                <ValidationMessage For="@(() => PurchPoVMs.TCSPercent)" />
                                                <small class="text-muted d-block text-end">Amt: @PurchPoVMs.TCSAmount</small>
                                            }
                                        </div>
                                    </div>
                                         
                                    <!-- Other Charges -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label text-dark"><small>Other Charges</small></label>
                                        <div class="col-7 col-md-8">
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                    type="number" step="any" @bind="PurchPoVMs.OtherCharges"
                                                    @bind:after='() => _calculationService.UpdateTotalsAsync(PurchPoVMs)' />
                                            <ValidationMessage For="@(() => PurchPoVMs.OtherCharges)" />
                                        </div>
                                    </div>

                                    <!-- Round Off -->
                                    <div class="row mb-2 gx-2 align-items-center">
                                        <div class="col-5 col-md-4 d-flex align-items-center">
                                            <small class="me-2 text-dark">Round Off</small>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input"
                                                        type="checkbox"
                                                        role="switch"
                                                        id="roundOffSwitch"
                                                        @bind="PurchPoVMs.IsRoundOffEnabled"
                                                        @bind:after="() => _calculationService.UpdateTotalsAsync(PurchPoVMs)" >
                                                <label class="form-check-label" for="roundOffSwitch"></label>
                                            </div>
                                        </div>
                                        <div class="col-7 col-md-8">
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                    value="@FormatDecimal(PurchPoVMs.RoundOff)"
                                                    readonly />
                                        </div>
                                    </div>

                                    <!-- Grand Total -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label fw-bold text-dark">
                                            <small>Grand Total</small>
                                        </label>
                                        <div class="col-7 col-md-8">
                                            <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                                    value="@FormatDecimal(PurchPoVMs.GrandTotal)"
                                                    readonly />
                                            @if (PurchPoVMs.CurrId > 1)
                                            {
                                                <div class="mt-1 text-end">
                                                    <small class="text-muted d-block">
                                                        Today's value: @PurchPoVMs.TodayVal
                                                    </small>
                                                    <small class="fw-bold text-success d-block">
                                                        Converted Value in Rs: @((PurchPoVMs.GrandTotal * PurchPoVMs.TodayVal).ToString("0.00"))
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Amount in Words -->
                                    <div class="row mb-2 gx-2">
                                        <label class="col-5 col-md-4 col-form-label text-dark"><small>Amount in Words</small></label>
                                        <div class="col-7 col-md-8 pt-1">
                                            @if (PurchPoVMs.CurrId > 1)
                                            {
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @FormatDecimal(PurchPoVMs.GrandTotal * PurchPoVMs.TodayVal)
                                                </small>
                                            }
                                            else
                                            {
                                                <strong>@NumberToWordsHelper.ConvertNumberToWords(PurchPoVMs.GrandTotal)</strong>
                                            }
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="row g-3">
                                <!-- Action Buttons -->
                                @if (CanCreate || CanEdit)
                                {
                                    @if(!PurchPoVMs.PoCancl && !PurchPoVMs.PoShortClose)
                                    {
                                        <div class="col-6 col-md-3 mt-3">
                                            <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                                <i class="bi bi-floppy2-fill me-1"></i> @(PurchPoVMs.PoId > 0 ? "Update" : "Create")
                                            </button>
                                        </div>

                                        @if(CanRevisePO)
                                        {
                                            <div class="col-6 col-md-3 mt-3">
                                                <button type="button" class="btn btn-success w-100 rounded-3" 
                                                        disabled="@isProcessing" 
                                                        @onclick="Revise">
                                                    <i class="bi bi-check2-circle me-1"></i> Revise
                                                </button>
                                            </div>
                                        }
                                    }
                                }

                                <div class="col-6 col-md-3 mt-3">
                                    <SmartBackButton Url="@($"/PurchPOList?currentPage={currentPage}")" />
                                </div>

                                @if ((PoId > 0 && CanEdit && (!Autharization || PurchPoVMs.Authorized)))
                                {
                                    <div class="col-12 col-md-3">
                                        <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                            <i class="bi bi-printer me-1"></i>Print
                                        </button>
                                    </div>
                                }
                                else if (Autharization && !PurchPoVMs.Authorized)
                                {
                                     <div class="col-12 col-md-3">
                                        <button class="btn btn-danger" disabled title="Authorization required to generate PDF">
                                            <i class="bi bi-file-earmark-pdf"></i> Authorization Required
                                        </button>
                                     </div>
                                }
                            </div>

                        </div>
                   
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
} 


