    private async Task UpsertPo()
    {
        try
        {
            isProcessing = true;

            await AdvanceCalculate();

            PurchPoVMs.PurchPoSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (! PurchPoVMs.PurchPoSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a Purchase Order without valid items.");
                return;
            }
            if (PurchPoVMs.PurchPoSubVMs.Any())
            {
                foreach (var rc in PurchPoVMs.PurchPoSubVMs)
                {
                    if (rc.RefRcSubId.HasValue && rc.RefRcSubId.Value > 0)
                    { 
                        decimal rcBalQty = await purchPoSevice.GetRcBalQtyyCompIdRcsubidAsync(rc.RefRcSubId ?? 0) ?? 0;

                        if (rc.Qty > rcBalQty)
                        {
                            await _js.ToastrError(
                                $"Entered Qty ({rc.Qty}) cannot be greater than RC Balance Qty ({rcBalQty}).");

                            return;
                        }
                    }
                }
            }

            var isNewPo = PurchPoVMs.PoId == 0;

            try
            {
                await purchPoSevice.UpsertPoAsync(PurchPoVMs);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewPo)
                await _js.ToastrSuccess("Purchase Order saved successfully.");
            else
                await _js.ToastrSuccess("Purchase order updated successfully.");
            
            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/PurchPOList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertPo Purchase Order failed.");
            await _js.ToastrError("Error saving Purchase Order.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidatePOLineAsync(PurchPoSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if ( !PurchPoVMs.IsOpenPO &&  (!line.Qty.HasValue || line.Qty <= 0))
            {
                await _js.ToastrError($"Item {line.ItemCode}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            if (line.PoSubId == 0 && line.RefQuoteSubId > 0)
            {
                var QuoteBalQty = await purchPoSevice.GetQuoteItemBalQtyFromQuoteSubId(line.RefQuoteSubId.Value);
                if (line.Qty > QuoteBalQty)
                {
                    line.Qty = QuoteBalQty;
                    line.BalQty = QuoteBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed Quotation Balance Qty ({QuoteBalQty}).");
                }
            }
            if (line.PoSubId == 0 && line.RefMReqSubId > 0)
            {
                var mreqBalQty = await  purchPoSevice.GetmatReqItemBalQtyFromMreqSubId(line.RefMReqSubId.Value);
                if (line.Qty > mreqBalQty)
                {
                    line.Qty = mreqBalQty;
                    line.BalQty = mreqBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed Material Requisition Balance Qty ({mreqBalQty}).");
                }
            }

            else if (line.PoSubId > 0)
            {
                var original = await purchPoSevice.GetPoSubItemDetailByPoSubIdAsync(line.PoSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty.GetValueOrDefault();
                    decimal origQty = original.Qty.GetValueOrDefault();
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidatePOLineAsync failed.");
            await _js.ToastrError("Error Validate Manufacturing-PO line.");
            return false;
        }
    }

