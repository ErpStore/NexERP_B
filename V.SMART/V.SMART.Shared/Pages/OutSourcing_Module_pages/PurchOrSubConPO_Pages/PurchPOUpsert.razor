    private async Task Cancel()
    {
        try
        {
            if (!PoId.HasValue || PoId == 0)
            {
                await _js.ToastrError("Cancel is not allowed before saving the Purchase Order.");
                return;
            }

            if(IsSomeItemsTransMade)
            {
                await _js.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Purchase Order");
                return;
            }

            if (PurchPoVMs.PoShortClose)
            {
                await _js.ToastrError("Purchase Order is already short closed. You can't cancel it.");
                return;
            }

            if (PurchPoVMs.PurchPoSubVMs?.Any(x => x.ItemCancel) == true)
            {
                await _js.ToastrError("Some items are already cancelled. Complete Purchase Order cancellation is not allowed.");
                return;
            }

            if (PurchPoVMs.PoCancl)
            {
                var subs = await purchPoSevice.GetPoSubByPoIdAsync(PurchPoVMs.PoId); 

                foreach (var sub in subs)
                {
                    await purchPoSevice.ValidateBeforeRevertAsync(sub.PoSubId);
                }
            }

