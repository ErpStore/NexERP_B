    private async Task OnItemCancelChanged(PurchPoSubVM subitem)
    {
        try
        {
            if (subitem.PoSubId == 0)
            {
                await _js.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if (subitem.Qty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _js.ToastrError("Item cannot be cancelled — GRN transactions have been made on it.");
                return;
            }

            if (PurchPoVMs.PoCancl)
            {
                await _js.ToastrError("Purchase Order is already Cancel. You can't cancel Item.");
                return;
            }

            if(subitem.ItemCancel)
                await purchPoSevice.ValidateBeforeRevertAsync(subitem.PoSubId);

            var (CanItemCancel, message) = await purchPoSevice.CanPoGRNItemCancelCheckAsync(subitem);

            if (!CanItemCancel)
            {
                await _js.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _js.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _js.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            if(PoId.HasValue || PoId > 0 )
                await LoadExistingPo(PoId.Value);

            await _js.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling Item in Purchase Order");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in Purchase Order");
        }
        finally
        {
            isProcessing = false;
        }
    }


