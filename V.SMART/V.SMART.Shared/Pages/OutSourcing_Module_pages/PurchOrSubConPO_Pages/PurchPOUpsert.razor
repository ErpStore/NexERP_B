    private async Task CancelEdit(PurchPoSubVM? item, PurchPoVM? parentPo)
    {
        try
        {
            if (item == null || parentPo == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentPo.PurchPoSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for PoSubId: {item?.PoSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(PurchPoSubVM item)
    {
        try
        {
            if (PurchPoVMs.PurchPoSubVMs.Count == 1 && PurchPoVMs.PoId > 0)
            {
                await _js.ToastrWarning("At least one item must be present in the Purchase order.");
                return;
            }

            if (PurchPoVMs.PoCancl)
            {
                await _js.ToastrError("This Purchase order is already cancelled. Row deletion is not allowed.");
                return;
            }

            if (PurchPoVMs.PoShortClose)
            {
                await _js.ToastrError("This Purchase Order is already short closed. Row deletion is not allowed.");
                return;
            }

            if (item.ItemCancel)
            {
                await _js.ToastrError("This item is already cancelled and cannot be deleted.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction integrity.");
                return;
            }

            if (item.ItemId == 0)
            {
                PurchPoVMs.PurchPoSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!PurchPoVMs.PurchPoSubVMs.Any())
                    PurchPoVMs.PurchPoSubVMs = new List<PurchPoSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(PurchPoVMs);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for PoSubId: {item?.PoSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

