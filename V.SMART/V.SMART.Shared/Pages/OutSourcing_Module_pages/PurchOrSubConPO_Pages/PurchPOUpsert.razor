    private async Task OnQtyChange(ChangeEventArgs e, PurchPoSubVM SubVM)
    {
        try
        {
            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW quote line
            if (SubVM.PoSubId == 0)
            {
                if (SubVM.RefQuoteSubId.GetValueOrDefault() > 0)
                {
                    var quotebalQty = await purchPoSevice.GetQuoteItemBalQtyFromQuoteSubId(SubVM.RefQuoteSubId.Value);

                    if (newQty <= quotebalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = quotebalQty;
                        SubVM.BalQty = quotebalQty;
                        await _js.ToastrWarning($"Qty can't be greater than Quotation Balance Qty ({quotebalQty}).");
                    }
                }
                else if (SubVM.RefMReqSubId.GetValueOrDefault() > 0)
                {
                    var mreqBalQty = await purchPoSevice.GetmatReqItemBalQtyFromMreqSubId(SubVM.RefMReqSubId.Value);

                    if (newQty <= mreqBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = mreqBalQty;
                        SubVM.BalQty = mreqBalQty;
                        await _js.ToastrWarning($"Qty can't be greater than PR/Indent Balance Qty ({mreqBalQty}).");
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty;
                }
            }
            // EXISTING quote line
            else
            {
                var original = await purchPoSevice.GetPurchPoSubItemDetailByPoSubIdAsync(SubVM.PoSubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                // Cannot decrease below transacted quantity
                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.BalQty = 0;
                    await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefQuoteSubId > 0)
                {
                    var QuoteBalQty = await purchPoSevice.GetQuoteItemBalQtyFromQuoteSubId(SubVM.RefQuoteSubId.Value);
                    var maxAllowedQty = original.Qty + QuoteBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty - alreadyTransacted;
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
                else if (SubVM.RefMReqSubId > 0)
                {
                    var MreqBalQty = await purchPoSevice.GetmatReqItemBalQtyFromMreqSubId(SubVM.RefMReqSubId.Value);
                    var maxAllowedQty = original.Qty + MreqBalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                        SubVM.BalQty = maxAllowedQty - alreadyTransacted;
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted;
                }
            }
            await _calculationService.UpdateTotalsAsync(PurchPoVMs);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for PoSubId: {SubVM?.PoSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    private void UpdateQuantities(PurchPoSubVM subVM, decimal newQty, decimal? alreadyTransacted = null)
    {
        subVM.Qty = newQty;

        subVM.BalQty = alreadyTransacted.HasValue
            ? Math.Max(newQty - alreadyTransacted.Value, 0)
            : newQty;
    }

