@page "/purchaseSCN/details/{SCNId:int}"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.IPurchaseSCNService
@using V.SMART.Shared.Repository.IRepository.IMasterRepository.IAdmins
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchaseSCNVM

@inject IPurchaseSCNService _scnService
@inject IJSRuntime _js
@inject ILoggingService LoggingService
@inject ReportService reportService
@inherits BaseUserRightsComponent
@inject NavigationManager _navigation
@inject IUserAuthorityRepository userAuthority

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
        return;
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <!-- Company Details Section -->
            <MyCompanyDetails />

            <!-- Cancelled Watermark -->
            @if (PurchaseSCNVMs.SCNCancel)
            {
                <div class="cancelWatermark ms-20 mt-10">CANCELLED</div>
            }

            <hr class="border-2 border-primary-subtle mb-4" />
            <div class="text-center">
                <h4 class="fw-semibold mt-3">Store Credit Note Details</h4>
            </div>

            <hr class="border-2 border-primary-subtle mb-4" />

            <!-- Vendor & Document Details Section -->
            <div class="row g-3 mb-4">
                <!-- Vendor Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Vendor Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Name</strong></td><td>@(!string.IsNullOrEmpty(PurchaseSCNVMs?.VendorName) ? PurchaseSCNVMs.VendorName : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Address</strong></td><td>@(!string.IsNullOrEmpty(PurchaseSCNVMs?.VendorAddress) ? PurchaseSCNVMs.VendorAddress : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>GST No.</strong></td><td>@(!string.IsNullOrEmpty(PurchaseSCNVMs?.VendorGstNo) ? PurchaseSCNVMs.VendorGstNo : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact No.</strong></td><td>@(!string.IsNullOrEmpty(PurchaseSCNVMs?.VendorContactNo) ? PurchaseSCNVMs.VendorContactNo : "N/A")</td></tr>
                                    <tr><td class="text-secondary" style="width: 40%;"><strong>Contact Person</strong></td><td>@(!string.IsNullOrEmpty(PurchaseSCNVMs?.KindofAttention) ? PurchaseSCNVMs.KindofAttention : "N/A")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Document Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">
                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Document Details
                        </div>
                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>SCN No</strong></td>
                                        <td>@(PurchaseSCNVMs != null ? $"{PurchaseSCNVMs.SCNNo}{PurchaseSCNVMs.Suffix}" : "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>SCN Date</strong></td>
                                        <td>@(PurchaseSCNVMs?.SCNDate.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Issue Store.</strong></td>
                                        <td>@(PurchaseSCNVMs?.IssueStoreName.ToString() ?? "N/A")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Add Store.</strong></td>
                                        <td>@(PurchaseSCNVMs?.AddStoreName?.ToString() ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Remarks.</strong></td>
                                        <td>@(PurchaseSCNVMs?.MainRemarks ?? "N/A")</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DC Items Section -->
            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    Purchase GRN Items
                </div>
                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                        <thead class="custom-blue">
                            <tr>
                                <th>Sl No.</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>UOM</th>
                                <th>HSN</th>
                                <th>Accept Qty</th>
                                <th>Reject Qty</th>
                                <th>Rework Qty</th>
                                <th>Unit Price</th>
                                <th>Basic Amount</th>
                                <th>Ref Dc No</th>
                                <th>Ref Dc Date</th>
                                <th>Ref Inv No</th>
                                <th>Ref Inv Date</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody class="custom-size">
                            @if (PurchaseSCNVMs?.PurchaseSCNSubVMs != null && PurchaseSCNVMs.PurchaseSCNSubVMs.Any())
                            {
                                @foreach (var item in PurchaseSCNVMs.PurchaseSCNSubVMs)
                                {
                                    <tr>
                                        <td>@item.SlNo</td>
                                        <td>@(item.ItemCode ?? "—")</td>
                                        <td>@(item.ItemName ?? "—")</td>
                                        <td>@item.MeasureUnit</td>
                                        <td>@item.HSNCode</td>
                                        <td>@FormatDecimal(item.AcceptQty)</td>
                                        <td>@FormatDecimal(item.RejectQty)</td>
                                        <td>@FormatDecimal(item.ReworkQty)</td>
                                        <td>@FormatDecimal(item.UnitPrice)</td>
                                        <td>@FormatDecimal(item.AcceptQty * item.UnitPrice)</td>
                                        <td>@item.RefDcNo</td>
                                        <td>@item.RefDcDate </td>
                                        <td>@item.RefInvNo </td>
                                        <td>@item.RefInvDate </td>

                                        <td>@item.Remark</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Actions -->
            @if (isOtherScreen == false)
            {
                <div class="d-flex gap-2 justify-content-end">

                    <a href="@($"/purchaseSCNList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                        <i class="bi bi-arrow-bar-left me-1"></i> Back To List
                    </a>
                    <a href="@($"/purchaseSCN/update/{SCNId}")" class="btn btn-outline-primary">
                        <i class="bi bi-pencil-square"></i> Modify
                    </a>

                    @if ((!Autharization) || (Autharization && PurchaseSCNVMs.Authorized))
                    {
                        <button class="btn btn-outline-danger" @onclick="GenerateInspectionprint">
                            <i class="bi bi-check2-square"></i> Inspection Print
                        </button>

                        <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                            <i class="bi bi-printer"></i> Print
                        </button>
                    }
                    else if (Autharization && !PurchaseSCNVMs.Authorized)
                    {

                        <button class="btn btn-danger" disabled title="Authorization required to generate PDF">
                            <i class="bi bi-file-earmark-pdf"></i> Authorization Required
                        </button>

                    }


                </div>

            }

        </div>
    }
}

@code
{
    protected override string ScreenName => "Purchase SCN";
    [Parameter] public int SCNId { get; set; }
    [Parameter] public bool isOtherScreen { get; set; }
    string? pdfBase64;
    private bool isProcessing { get; set; } = true;
    private PurchaseSCNVM PurchaseSCNVMs { get; set; } = new PurchaseSCNVM();
    private VendorVM VendorVMs { get; set; } = new VendorVM();

    public bool Autharization = false;

    private List<PurchaseSCNSubVM> refGRNs = new();
    private string refGRNNosDisplay = "N/A";
    private string refGRNDatesDisplay = "N/A";
    private int Decimalplaces { get; set; } = 2;


    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private string FormatDecimal(decimal? value)
    {
        try
        {
            if (value == null) return "0";
            return Math.Round(value.Value, Decimalplaces).ToString($"N{Decimalplaces}");
        }
        catch (Exception ex)
        {
            LoggingService.LogDeveloperError(ex, "Error in FormatDecimal() in PurchaseSCN");
            _js.ToastrError("An unexpected error in FormatDecimal in PurchaseSCN.");
            return "";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await LoadDcDetails();

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Faild in OnInitializedAsync purchase SCN");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadDcDetails()
    {
        try
        {
            if (SCNId > 0)
            {
                var grn = await _scnService.GetPurchaseSCNByIdAsync(SCNId);
                if (grn != null)
                {
                    PurchaseSCNVMs = grn;
                    Autharization = (await userAuthority.GetAllWithUserAsync()).Any(x => x.IsPurchSCN == true);
                }

                Decimalplaces = await _scnService.GetDecimalPlacesAsync();

                VendorVMs = await _scnService.GetVendorByIdAsync(PurchaseSCNVMs.VendorCode.Value);

                refGRNs = await _scnService.GetDistinctRefGRNBySCNIdAsync(PurchaseSCNVMs.SCNId);

                if (refGRNs.Any())
                {
                    // Only join the existing items, no extra commas
                    refGRNNosDisplay = string.Join(", ", refGRNs.Select(e => e.RefGRNNo).Where(n => !string.IsNullOrEmpty(n)));
                    refGRNDatesDisplay = string.Join(", ", refGRNs
                        .Select(e => e.RefGRNDate.HasValue ? e.RefGRNDate.Value.ToString("dd/MM/yyyy") : null)
                        .Where(d => !string.IsNullOrEmpty(d)));
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in LoadDcDetails PurchaseSCN");
            await _js.ToastrError("An unexpected error in LoadDcDetails in PurchaseSCN.");
        }
    }



    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(SCNId, "PurchaseSCN.frx", "SCNId", PurchaseSCNVMs.SCNCancel, ScreenName, "Sp_Print_PurchaseSCN");
            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf PurchaseSCN");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in PurchaseSCN.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task GenerateInspectionprint()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(SCNId, "PurchaseInspection.frx", "SCNId", PurchaseSCNVMs.SCNCancel, "FinalInspection", "Sp_Print_PurchaseSCN");

            if (pdfBytes != null && pdfBytes.Length > 0)
            {
                pdfBase64 = Convert.ToBase64String(pdfBytes);
                await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateInspectionprint Labour GRN");
            await _js.ToastrError("An unexpected error occurred while generating the GenerateInspectionprint.");
        }
        finally
        {
            isProcessing = false;
        }
    }

}
