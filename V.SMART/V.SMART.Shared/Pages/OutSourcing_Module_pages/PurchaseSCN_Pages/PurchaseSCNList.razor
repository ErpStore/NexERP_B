@page "/purchaseSCNList"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.IPurchaseGRN_Service
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.IPurchaseSCNService
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchaseGRNVM
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchaseSCNVM

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ExcelExportService ExcelExportService
@inject IPurchaseSCNService purchaseScnService

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .quickgrid th {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Purchase SCN List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@GrnBreadcrumbs" />

            <div class="card-body p-4">

                 <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>

                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                 value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                            <option value="Short Closed">Short Closed</option>
                        </select>
                    </div>

                    @if (CanCreate)
                    {
                       <div class="col-6 col-md-2 ms-md-auto text-end">
                            <button class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                                    @onclick="AddNewScn">
                                <i class="bi bi-plus-square me-1"></i> Add New
                            </button>
                       </div>
                    }

                </div>

                @if (PurchaseSCNVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="PurchaseSCNVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Any(c => c.IsVisible))
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            case "SCNId":
                                                <PropertyColumn Title="SCN ID" Property="@(c => c.SCNId)" />
                                                break;

                                            case "SCNNo":
                                                <PropertyColumn Title="SCN No"
                                                                Property="@(c => c.SCNNo)"
                                                                Sortable="true" />
                                                break;

                                            case "SCNDate":
                                                <PropertyColumn Title="SCN Date"
                                                                Property="@(c => c.SCNDate)"
                                                                Format="dd/MM/yyyy"
                                                                Sortable="true" />
                                                break;

                                            // ===== VENDOR DETAILS =====
                                            case "VendorName":
                                                <PropertyColumn Title="Vendor Name" Property="@(c => c.VendorName)" />
                                                break;

                                            case "VendorCode":
                                                <PropertyColumn Title="Vendor Code" Property="@(c => c.VendorCode)" />
                                                break;

                                            case "VendorAddress":
                                                <PropertyColumn Title="Vendor Address" Property="@(c => c.VendorAddress)" />
                                                break;

                                            case "VendorContactNo":
                                                <PropertyColumn Title="Contact No" Property="@(c => c.VendorContactNo)" />
                                                break;

                                            case "VendorGstNo":
                                                <PropertyColumn Title="GST No" Property="@(c => c.VendorGstNo)" />
                                                break;

                                            case "KindofAttention":
                                                <PropertyColumn Title="Kind Of Attention" Property="@(c => c.KindofAttention)" />
                                                break;

                                            // ===== STORE DETAILS =====
                                            case "AddStoreName":
                                                <PropertyColumn Title="Add Store Name" Property="@(c => c.AddStoreName)" />
                                                break;

                                            case "CorrespondenceStatus":
                                                <TemplateColumn Title="Correspondence Status">
                                                    @if (UploadStatus.ContainsKey(context.SCNId) && UploadStatus[context.SCNId])
                                                    {
                                                        <span class="badge bg-success">Uploaded</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Not Uploaded</span>
                                                    }
                                                </TemplateColumn>
                                                break;


                                            case "AddStoreId":
                                                <PropertyColumn Title="Add Store ID" Property="@(c => c.AddStoreId)" />
                                                break;

                                            case "IssueStoreName":
                                                <PropertyColumn Title="Issue Store Name" Property="@(c => c.IssueStoreName)" />
                                                break;

                                            case "StoreIssId":
                                                <PropertyColumn Title="Issue Store ID" Property="@(c => c.StoreIssId)" />
                                                break;

                                            // ===== ITEM SUMMARY =====
                                            case "NoOfItems":
                                                <PropertyColumn Title="No Of Items" Property="@(c => c.NoOfItems)" />
                                                break;

                                            case "TotalQty":
                                                <PropertyColumn Title="Total Qty"
                                                                Property="@(c => c.TotalQty)"
                                                                Format="N2" />
                                                break;

                                            case "AverageUnitPrice":
                                                <PropertyColumn Title="Avg Unit Price"
                                                                Property="@(c => c.AverageUnitPrice)"
                                                                Format="N2" />
                                                break;

                                            case "MainRemarks":
                                                <PropertyColumn Title="Remarks" Property="@(c => c.MainRemarks)" />
                                                break;

                                            // ===== LEVEL STATUS =====
                                            case "LevelStatus":
                                                <TemplateColumn Title="Level Status" Context="c">
                                                    @if (c.IsLevel3)
                                                    {
                                                        <span class="badge text-bg-success rounded-pill px-3 py-1">
                                                            <i class="bi bi-3-circle me-1"></i> Level 3
                                                        </span>
                                                    }
                                                    else if (c.IsLevel2)
                                                    {
                                                        <span class="badge text-bg-info rounded-pill px-3 py-1">
                                                            <i class="bi bi-2-circle me-1"></i> Level 2
                                                        </span>
                                                    }
                                                    else if (c.IsLevel1)
                                                    {
                                                        <span class="badge text-bg-warning rounded-pill px-3 py-1">
                                                            <i class="bi bi-1-circle me-1"></i> Level 1
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-secondary rounded-pill px-3 py-1">
                                                            -
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                                // ===== LEVEL APPROVAL DETAILS =====
                                                case "Level1Sign":
                                                    <PropertyColumn Title="L1 Approved By"
                                                                    Property="@(c => c.Level1Sign)" />
                                                    break;

                                                case "Level2Sign":
                                                    <PropertyColumn Title="L2 Approved By"
                                                                    Property="@(c => c.Level2Sign)" />
                                                    break;

                                                case "Level3Sign":
                                                    <PropertyColumn Title="L3 Approved By"
                                                                    Property="@(c => c.Level3Sign)" />
                                                    break;


                                            // ===== APPROVAL STATUS =====
                                            case "ApprovalStatus":
                                                <TemplateColumn Title="Approval Status" Context="c">
                                                    @if (c.Authorized)
                                                    {
                                                        <span class="badge text-bg-success rounded-pill px-3 py-1">
                                                            <i class="bi bi-check-circle me-1"></i> Authorized
                                                        </span>
                                                    }
                                                    else if (c.IsRejected)
                                                    {
                                                        <span class="badge text-bg-danger rounded-pill px-3 py-1">
                                                            <i class="bi bi-x-octagon me-1"></i> Rejected
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-warning rounded-pill px-3 py-1">
                                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            case "ApprovedBy":
                                                <PropertyColumn Title="Approved By" Property="@(c => c.ApprovedBy)" />
                                                break;

                                            case "ApprovalDate":
                                                <PropertyColumn Title="Approval Date"
                                                                Property="@(c => c.ApprovalDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "RejectReason":
                                                <PropertyColumn Title="Reject Reason" Property="@(c => c.RejectReason)" />
                                                break;

                                            // ===== SCN STATUS =====
                                            case "Status":
                                                <TemplateColumn Title="PR Status" Context="c">
                                                @if (c.SCNCancel)
                                                {
                                                    <span class="badge text-bg-danger bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-x-circle me-1"></i> Cancelled
                                                    </span>
                                                }
                                                else if (c.ShortClose)
                                                {
                                                    <span class="badge text-bg-secondary bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-slash-circle me-1"></i> Short Closed
                                                    </span>
                                                }
                                                else if (c.SCNTally)
                                                {
                                                    <span class="badge text-bg-success bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-check-circle me-1"></i> Completed
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-warning bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                        <i class="bi bi-hourglass-split me-1"></i> Pending
                                                    </span>
                                                }
                                            </TemplateColumn>
                                            break;

                                            // ===== CANCEL =====
                                            case "CancelReason":
                                                <PropertyColumn Title="Cancel Reason" Property="@(c => c.CancelReason)" />
                                                break;

                                            case "CancelDate":
                                                <PropertyColumn Title="Cancel Date"
                                                                Property="@(c => c.CancelDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "CancelBy":
                                                <PropertyColumn Title="Cancel By" Property="@(c => c.CancelBy)" />
                                                break;

                                            // ===== AUDIT =====
                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date"
                                                                Property="@(c => c.CreatedDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date"
                                                                Property="@(c => c.ModifiedDate)"
                                                                Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }

                            }

                            <!-- Actions -->
                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"purchaseSCN/update/{c.SCNId}?currentPage={currentPage}")"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit SCN">
                                           <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"purchaseSCN/details/{c.SCNId}?currentPage={currentPage}")"
                                           class="btn btn-sm btn-outline-info"
                                           title="View SCN">
                                           <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete SCN"
                                                @onclick="() => HandleDelete(c.SCNId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="container-fluid">

                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="fw-semibold small px-1">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                                <button class="btn btn-success btn-sm d-flex align-items-center ms-5"
                                        @onclick="HandleExport">

                                    <i class="bi bi-download me-1"></i>
                                    Export SCN's

                                </button>

                            </div>

                        </div>

                    </div>

                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}


@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Purchase SCN";

    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteScnId = 0;
    private string searchText = string.Empty;
    private string selectedStatus = "";

    private int screenCode{ get; set; }

    private List<PurchaseSCNVM> PurchaseSCNVMs = new();


    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;
    // === Paging & Search ===
    private int totalItems;
   // private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // === Modal State ===
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    // Instant Search filter parameter

    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    private List<PageHeader.BreadcrumbItem> GrnBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Outsourcing" },
        new PageHeader.BreadcrumbItem { Text = "Purchase" },
        new PageHeader.BreadcrumbItem { Text = "Store Credit Note-()", IsLast = true }
    };

    private Dictionary<int, bool> UploadStatus = new();

    #endregion

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            screenCode = await purchaseScnService.GetScreenCodeByScreenNameAsync(ScreenName);
            UserName = await CurrentUserService.GetUsernameAsync();

            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }
            //Sathish
            if (currentPage < 1)
            {
                currentPage = 1;
            }
            await LoadAllSCNs();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion

    #region === Data Loading ===

    private async Task LoadAllSCNs()
    {
        try
        {
            var result = await purchaseScnService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            PurchaseSCNVMs = result.scnVMs;
            totalItems = result.TotalCount;
            foreach (var item in PurchaseSCNVMs)
            {
                UploadStatus[item.SCNId] = await purchaseScnService.IsDocumentUploaded(item.SCNId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading data in Purchase SCN List");
            await _JS.ToastrError("Failed to load Purchase SCN List.");
        }
    }

    private void AddNewScn()
    {
        var returnUrl = Uri.EscapeDataString("purchaseSCN/create/{id}");
        _navigation.NavigateTo($"/Vendor/Select?ReturnUrl={returnUrl}");
    }

    #endregion



    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "SCN ID", Field = "SCNId", IsVisible = false },
                new() { Title = "SCN No", Field = "SCNNo", IsVisible = true },
                new() { Title = "SCN Date", Field = "SCNDate", IsVisible = true },

                new() { Title = "Vendor Code", Field = "VendorCode", IsVisible = false },
                new() { Title = "Vendor Name", Field = "VendorName", IsVisible = true },
                new() { Title = "Vendor Address", Field = "VendorAddress", IsVisible = false },
                new() { Title = "GST No", Field = "VendorGstNo", IsVisible = false },
                new() { Title = "Contact No", Field = "VendorContactNo", IsVisible = false },
                new() { Title = "Kind Of Attention", Field = "KindofAttention", IsVisible = false },

                new() { Title = "Add Store ID", Field = "AddStoreId", IsVisible = false },
                new() { Title = "Add Store Name", Field = "AddStoreName", IsVisible = true },
                new() { Title = "Correspondence Status", Field = "CorrespondenceStatus", IsVisible = false },
                new() { Title = "Issue Store ID", Field = "StoreIssId", IsVisible = false },
                new() { Title = "Issue Store Name", Field = "IssueStoreName", IsVisible = true },

                new() { Title = "Remarks", Field = "MainRemarks", IsVisible = false },
                new() { Title = "No Of Items", Field = "NoOfItems", IsVisible = true },
                new() { Title = "Total Qty", Field = "TotalQty", IsVisible = false },
                new() { Title = "Avg Unit Price", Field = "AverageUnitPrice", IsVisible = false },

                new() { Title = "Level Status", Field = "LevelStatus", IsVisible = false },

                new() { Title = "L1 Approved By", Field = "Level1Sign", IsVisible = false },
                new() { Title = "L2 Approved By", Field = "Level2Sign", IsVisible = false },
                new() { Title = "L3 Approved By", Field = "Level3Sign", IsVisible = false },

                new() { Title = "Approval Status", Field = "ApprovalStatus", IsVisible = true },
                new() { Title = "Approved By", Field = "ApprovedBy", IsVisible = false },
                new() { Title = "Approval Date", Field = "ApprovalDate", IsVisible = false },

                new() { Title = "Reject Reason", Field = "RejectReason", IsVisible = false },

                new() { Title = "SCN Status", Field = "Status", IsVisible = false },
                new() { Title = "Cancel Reason", Field = "CancelReason", IsVisible = false },
                new() { Title = "Cancel Date", Field = "CancelDate", IsVisible = false },
                new() { Title = "Cancel By", Field = "CancelBy", IsVisible = false },

                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }
            };


            if (!Hidden)
            {
                // Columns.AddRange(new[]
                // {
                //     new GridColumn { Title = "Extra Column 1", Field = "Extra1", IsVisible = false },
                //     new GridColumn { Title = "Extra Column 2", Field = "Extra2", IsVisible = false },
                // });
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Purchase SCN List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Purchase SCN List HandleColumnChange() Method");
        }
    }

    #endregion


    #region PAGINATION

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllSCNs();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Purchase SCN List");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllSCNs();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Purchase SCN List");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllSCNs();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Purchase SCN List");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllSCNs();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Purchase SCN List");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllSCNs();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Purchase SCN List");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllSCNs();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Purchase SCN List page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region === Deletion Flow ===

    private async Task HandleDelete(int scnId)
    {
        try
        {
            var (canDelete, message) = await purchaseScnService.CanDeletePurchaseSCNAsync(scnId);

            if (!canDelete)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            DeleteScnId = scnId;

            ModalTitle = "Are you sure you want to delete this Purchase SCN";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for SCNId: {scnId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            if (!isConfirmed) return;

            isProcessing = true;
           
            var deleted = await purchaseScnService.DeletePurchaseSCNByIdAsync(DeleteScnId, screenCode);

            if (deleted)
            {
                await _JS.ToastrSuccess("Purchase SCN deleted successfully.");
                await LoadAllSCNs();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Quotation could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting SCNId: {DeleteScnId}");
            await _JS.ToastrError("Failed to delete Sales Quotation.");
        }
        finally
        {
            DeleteScnId = 0;
            isProcessing = false;
        }
    }

    #endregion


    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else if (confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion


    #region SEARCH FILTERS

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllSCNs();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Purchase SCN List");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion


    #region Job order Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

           if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;

            currentPage = 1;
            await LoadAllSCNs();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in Purchase SCN List");
            await _JS.ToastrError("Failed to Load Purchase SCN List filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion 
    private async Task HandleExport()
    {
        selectedStatus = selectedStatus == "" ? "All" : selectedStatus;

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var exportData = await purchaseScnService.GetPurchaseSCNsStatusListAsync(selectedStatus);


            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "PurchaseSCN", "Purchase SCN's Pending List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "PurchaseSCNExport.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (PurchaseSCN)");
            await _JS.ToastrError("Error while exporting PurchaseSCN!");
        }
        finally
        {
            isProcessing = false;
        }

        
    }


}
