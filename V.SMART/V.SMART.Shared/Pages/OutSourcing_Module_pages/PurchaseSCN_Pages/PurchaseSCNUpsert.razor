    private async Task UpsertSCN()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            PurchaseSCNVMs.PurchaseSCNSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.AcceptQty.HasValue || x.AcceptQty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!PurchaseSCNVMs.PurchaseSCNSubVMs.Any())
            {
                await _JS.ToastrWarning("Cannot save a Purchase SCN without valid items.");
                return;
            }


            // Validate each line
            foreach (var line in PurchaseSCNVMs.PurchaseSCNSubVMs)
            {
                bool isValid = await ValidateDcLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewDc = PurchaseSCNVMs.SCNId == 0;

            try
            {
                await _scnService.UpsertSCNAsync(PurchaseSCNVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewDc)
                await _JS.ToastrSuccess("Purchase SCN saved successfully.");
            else
                await _JS.ToastrSuccess("Purchase SCN updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigation.NavigateTo("/purchaseSCNList");
        }

        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertSCN failed.");
            await _JS.ToastrError("Error saving purchase SCN.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateDcLineAsync(PurchaseSCNSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _JS.ToastrWarning("One or more items are missing Item selection.");
                return false;
            }


            decimal acceptQty = line.AcceptQty ?? 0m;
            decimal rejectQty = line.RejectQty ?? 0m;
            decimal reworkQty = line.ReworkQty ?? 0m;
            decimal enteredTotal = acceptQty + rejectQty + reworkQty;

            decimal stockQty = await _scnService.GetStockQtyFromStockManager(line.ItemId.Value, PurchaseSCNVMs.StoreIssId.Value);

            if (PurchaseSCNVMs.SCNId == 0 && stockQty<=0)
            {
                await _JS.ToastrWarning($"AcceptQty+RejectQty+ReworkQty Quantity should not be greater than Stock Qty.");
                return false;
            }

            decimal totalEnteredForSameItem =PurchaseSCNVMs.PurchaseSCNSubVMs.Where(x => x.ItemId == line.ItemId)
            .Sum(x => (x.AcceptQty ?? 0) + (x.RejectQty ?? 0) + (x.ReworkQty ?? 0));

            if (enteredTotal>(totalEnteredForSameItem+stockQty))
            {
                await _JS.ToastrWarning($"Total issued quantity for Item {line.ItemCode} ({totalEnteredForSameItem}) " +
                    $"cannot exceed Available Stock ({stockQty}).");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _JS.ToastrWarning($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            if (PurchaseSCNVMs.StoreIssId == PurchaseSCNVMs.AddStoreId)
            {
                await _JS.ToastrWarning($"Add Store and Issue Store should not be the same.");
                return false;
            }

            // Qty vs PO / Already Transacted validation
            if (line.SCNSubId == 0 && line.RefGRNSubId > 0)
            {

                var grnBalQty = await _scnService.GetGRNItemBalQtyFromGRNSubId(line.RefGRNSubId.Value);

                if ((line.AcceptQty > grnBalQty))
                {
                    line.BalQty = grnBalQty;
                    line.AcceptQty = grnBalQty;
                    await _JS.ToastrWarning($"Qty cannot exceed SCN Balance Qty ({grnBalQty}).");
                    return false;
                }
            }
            else if (line.SCNSubId > 0)
            {
                var original = await _scnService.GetSCNSubItemDetailBySCNSubIdAsync(line.SCNSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty.Value;
                    decimal origQty = original.AcceptQty.GetValueOrDefault();
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.AcceptQty < alreadyTransacted)
                    {
                        line.AcceptQty = alreadyTransacted;
                        // line.AcceptQty = 0m;
                        await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.BalQty.GetValueOrDefault() - origQty;
                        line.AcceptQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidatePOLineAsync failed.");
            await _JS.ToastrError("Error Validate Purchase-SCN line.");
            return false;
        }
    }
