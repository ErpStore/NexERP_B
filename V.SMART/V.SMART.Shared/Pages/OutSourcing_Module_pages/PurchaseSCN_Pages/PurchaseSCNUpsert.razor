    private async Task Cancel()
    {
        try
        {
            if (!SCNId.HasValue || SCNId == 0)
            {
                await _JS.ToastrError("SCN cancel is not allowed before saving the Labour SCN.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrError("Some Items Transaction Are Made!.. You Can't Cancel the Complete Purchase SCN");
                return;
            }

            if (PurchaseSCNVMs.ShortClose)
            {
                await _JS.ToastrError("Purchase SCN is already short closed. You can't cancel it.");
                return;
            }

            if (PurchaseSCNVMs.PurchaseSCNSubVMs?.Any(x => x.ItemCancel) == true)
            {
                await _JS.ToastrError("Some items are already cancelled. Complete SCN cancellation is not allowed.");
                return;
            }

            if (PurchaseSCNVMs.SCNCancel)
            {
                var subs = await _scnService.GetSCNSubBySCNIdAsync(PurchaseSCNVMs.SCNId);
                foreach (var sub in subs)
                {
                    await _scnService.ValidateGRNBalanceBeforeRevertAsync(sub);
                }
            }

            if (!PurchaseSCNVMs.SCNCancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Purchse SCN?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Purchse SCN?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            PurchaseSCNVMs = await _scnService.GetPurchaseSCNByIdAsync(PurchaseSCNVMs.SCNId);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Purchse SCN.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Purchse SCN Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

