    private async Task CancelItem()
    {
        if (rowToCancel == null || isProcessing)
            return;

        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            bool isCancelling = !rowToCancel.ItemCancel;

            if (isCancelling && string.IsNullOrWhiteSpace(cancelReason))
            {
                await _JS.ToastrWarning("Cancel reason is required.");
                return;
            }

            rowToCancel.ItemCancel = isCancelling;
            rowToCancel.ItemCancelReason = isCancelling ? cancelReason : string.Empty;

            await _scnService.UpdateItemCancelAndAddorRevertAsync(rowToCancel,PurchaseSCNVMs, screenCode);

            string actionText = isCancelling ? "Cancelled" : "Reverted";

            await LoggingService.LogUserAction(
                username,
                machine,
                ip,
                screen: "",
                action: $"{actionText} SCN No: {PurchaseSCNVMs.SCNNo}, ItemCode: {rowToCancel.ItemCode}",
                additionalInfo: isCancelling
                    ? $"Reason: {cancelReason}"
                    : "Item revert operation"
            );

            if(SCNId.HasValue && SCNId>0)
                await LoadExistingSCN(SCNId.Value);

            await ResetSlno();
            await _JS.ToastrSuccess($"Item has been {actionText.ToLower()} successfully.");

            cancelReason = string.Empty;
            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            await _JS.ToastrWarning(ex.Message);

            if (SCNId.HasValue && SCNId > 0)
                await LoadExistingSCN(SCNId.Value);
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the item.");
            await LoggingService.LogDeveloperError(ex, $"Item Cancel/Revert failed for SCNId: {PurchaseSCNVMs?.SCNId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CancelSCN()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!PurchaseSCNVMs.SCNCancel)
            {
                PurchaseSCNVMs.SCNCancel = true;
                PurchaseSCNVMs.CancelDate = DateTime.Now;
                PurchaseSCNVMs.CancelReason = cancelReason;
                PurchaseSCNVMs.CancelBy = username;

                await _scnService.UpdatedCancelStatusAndAddOrRevertQty(PurchaseSCNVMs, screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Purchase SCN",
                    action: $"Cancelled SCN: {PurchaseSCNVMs.SCNNo}",
                    additionalInfo: $"SCN Id: {PurchaseSCNVMs.SCNId}"
                );

                await _JS.ToastrSuccess("Quotation cancelled successfully.");
            }
            else
            {
                PurchaseSCNVMs.SCNCancel = false;
                PurchaseSCNVMs.CancelDate = null;
                PurchaseSCNVMs.CancelReason = string.Empty;
                PurchaseSCNVMs.CancelBy = string.Empty;

                await _scnService.UpdatedCancelStatusAndAddOrRevertQty(PurchaseSCNVMs,screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Purchase SCN",
                    action: $"Reverted SCN: {PurchaseSCNVMs.SCNNo}",
                    additionalInfo: $"SCN Id: {PurchaseSCNVMs.SCNId}"
                );

                await _JS.ToastrSuccess("Purchase SCN has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            if(SCNId.HasValue && SCNId>0)
                await LoadExistingSCN(SCNId.Value);

            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"CancelSCN failed for SCNId: {PurchaseSCNVMs.SCNId}");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the CN.");
            await LoggingService.LogDeveloperError(ex, $"CancelSCN failed for SCNId: {PurchaseSCNVMs.SCNId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _JS.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.SCNSubId > 0)
            {
                await _scnService.DeleteAndResequenceAsync(rowToDelete, PurchaseSCNVMs, screenCode);

                if(SCNId.HasValue && SCNId>0)
                    await LoadExistingSCN(SCNId.Value);
            }
            else
            {
                PurchaseSCNVMs.PurchaseSCNSubVMs.Remove(rowToDelete);

                if (!PurchaseSCNVMs.PurchaseSCNSubVMs.Any())
                {
                    PurchaseSCNVMs.PurchaseSCNSubVMs.Add(new PurchaseSCNSubVM
                    {
                        SCNId = PurchaseSCNVMs.SCNId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    await ResetSlno();
                }
            }

            await _JS.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for SCNId: {PurchaseSCNVMs.SCNId}");
            await _JS.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

