    private async Task<bool> ValidateAndAdjustAsync(PurchaseSCNSubVM subVM,decimal newAccp,decimal newRej,decimal newRew,string fieldName)
    {
        if(subVM.RefGRNSubId == null || subVM.RefGRNSubId <= 0)
        {
            await _JS.ToastrWarning("Please select valid GRN Item for quantity adjustment.");
            return true;
        }

        decimal grnBalQty = await _scnService .GetGRNItemBalQtyFromGRNSubId(subVM.RefGRNSubId.Value);

        var original = subVM.SCNSubId > 0 ? await _scnService.GetSCNSubItemDetailBySCNSubIdAsync(subVM.SCNSubId) : null;

        decimal originalAccept = original?.AcceptQty ?? 0m;
        decimal originalReject = original?.RejectQty ?? 0m;
        decimal originalRework = original?.ReworkQty ?? 0m;

        decimal originalBalQty = (original?.BalQty ?? 0m) + originalReject + originalRework;

        decimal originalTotal = originalAccept + originalReject + originalRework;

        decimal maxAllowed = grnBalQty + originalTotal;

        decimal total = newAccp + newRej + newRew;

        // For existing SCN line, ensure not less than already transacted
        decimal alreadyTransacted = originalTotal - originalBalQty;

        if (subVM.SCNSubId > 0 && total < alreadyTransacted)
        {
            AdjustQty(subVM, fieldName, alreadyTransacted, newAccp, newRej, newRew);
            subVM.BalQty = 0m;

            await _JS.ToastrWarning($"Total Qty cannot be less than {alreadyTransacted} (already transacted).");
            return false;
        }

        // Ensure not exceeding max allowed
        if (total > maxAllowed)
        {
            AdjustQty(subVM, fieldName, maxAllowed, newAccp, newRej, newRew);
            RecalculateBalQty(subVM, original);
            RecalculateRejBalQty(subVM, original);

            await _JS.ToastrWarning($"{fieldName} change exceeded limit. Max allowed total is {maxAllowed}.");

            return false;
        }

        RecalculateBalQty(subVM, original);
        RecalculateRejBalQty(subVM, original);
        return true;
    }

    private void AdjustQty(PurchaseSCNSubVM subVM, string field, decimal max, decimal accp, decimal rej, decimal rew)
    {
        switch (field)
        {
            case "Accepted":
                subVM.AcceptQty = Math.Max(0m, max - (rej + rew));
                break;

            case "Rejected":
                subVM.RejectQty = Math.Max(0m, max - (accp + rew));
                break;

            case "Rework":
                subVM.ReworkQty = Math.Max(0m, max - (accp + rej));
                break;
        }
    }


    private void RecalculateBalQty(PurchaseSCNSubVM subVM, PurchaseSCNSubVM? original)
    {
        if (original != null)
        {
            decimal diff = subVM.AcceptQty.GetValueOrDefault() - original.AcceptQty.GetValueOrDefault();

            subVM.BalQty = Math.Max(0m, original.BalQty.GetValueOrDefault() + diff);
        }
        else
        {
            subVM.BalQty = subVM.AcceptQty.GetValueOrDefault();
        }
    }

    private void RecalculateRejBalQty(PurchaseSCNSubVM subVM, PurchaseSCNSubVM? original)
    {
        if (original != null)
        {
            decimal diff = subVM.RejectQty.GetValueOrDefault() - original.RejectQty.GetValueOrDefault();

            subVM.RejectBalQty = Math.Max(0m, original.RejectBalQty.GetValueOrDefault() + diff);
        }
        else
        {
            subVM.RejectBalQty = subVM.RejectQty.GetValueOrDefault();
        }
    }


