    {
        try
        {
            if (subitem.SCNSubId == 0)
            {
                await _JS.ToastrError("Kindly save the item before cancelling.");
                return;
            }

            if (subitem.AcceptQty.GetValueOrDefault() != subitem.BalQty.GetValueOrDefault())
            {
                await _JS.ToastrError("Item cannot be cancelled — Purchase SCN transactions have been made on it.");
                return;
            }

            if (PurchaseSCNVMs.SCNCancel)
            {
                await _JS.ToastrError("Purchase SCN is already Cancel. You can't cancel Item.");
                return;
            }

            if(subitem.ItemCancel)
                await _scnService.ValidateBeforeRevertAsync(subitem.SCNSubId);


            var (CanItemCancel, message) = await _scnService.CanSCNItemCancelCheckAsync(subitem);

            if (!CanItemCancel)
            {
                await _JS.ToastrWarning(message);
                return;
            }

            if (subitem.ItemId.HasValue)
            {
                if (!subitem.ItemCancel)
                {
                    ModalTitle = "Are you sure you want to Cancel this Item?";
                    btnColor = "btn-danger";
                    btnText = "Yes! Cancel";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = true;
                }
                else
                {
                    ModalTitle = "Are you sure you want to Revert this Item?";
                    btnColor = "btn-success";
                    btnText = "Yes! Revert";
                    confirmation = "ItemCancel";
                    showCancelReasonBox = false;
                }
                rowToCancel = subitem;

                await _JS.InvokeVoidAsync("ShowConfirmationModal");
            }
            else
            {
                await _JS.ToastrError("ItemCode is missing or invalid.");
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            PurchaseSCNVMs = await _scnService.GetPurchaseSCNByIdAsync(PurchaseSCNVMs.SCNId);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling Item in Purchase SCN");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Item.Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Item Cancel in Purchase SCN");
        }
        finally
        {
            isProcessing = false;
        }
    }

