    private async Task CancelEdit(PurchaseSCNSubVM? item, PurchaseSCNVM? parentDc)
    {
        try
        {
            if (item == null || parentDc == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (item.AcceptQty.GetValueOrDefault() <= 0) ||
                (item.UnitPrice <= 0);

            if (isEmptyOrInvalid)
            {
                parentDc.PurchaseSCNSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for SCNSubId: {item?.SCNSubId}");
            await _JS.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(PurchaseSCNSubVM item)
    {
        try
        {
            if (PurchaseSCNVMs.PurchaseSCNSubVMs.Count == 1 && item.SCNSubId > 0)
            {
                await _JS.ToastrWarning("At least one item must be present in the Purchase SCN.");
                return;
            }

            if (PurchaseSCNVMs.SCNCancel)
            {
                await _JS.ToastrError("This Purchase SCN is already cancelled. Row deletion is not allowed.");
                return;
            }

            if (PurchaseSCNVMs.ShortClose)
            {
                await _JS.ToastrError("This SCN is already short closed. Row deletion is not allowed.");
                return;
            }

            if (item.ItemCancel)
            {
                await _JS.ToastrError("This item is already cancelled and cannot be deleted.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction integrity.");
                return;
            }

            if (item.ItemId == 0)
            {
                PurchaseSCNVMs.PurchaseSCNSubVMs.Remove(item);
                await _JS.ToastrSuccess("New item row removed successfully.");

                if (!PurchaseSCNVMs.PurchaseSCNSubVMs.Any())
                    PurchaseSCNVMs.PurchaseSCNSubVMs = new List<PurchaseSCNSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for ScnSubId: {item?.SCNSubId}");
            await _JS.ToastrError("Failed to remove the row. Please try again.");
        }
    }

