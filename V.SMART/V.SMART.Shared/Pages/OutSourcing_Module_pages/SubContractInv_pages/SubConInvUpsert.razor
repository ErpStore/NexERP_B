                rowToCancel.ItemCancelReason = string.Empty; ;
                await subConInvService.UpdateItemCancelAndAddorRevertAsync(rowToCancel, screenCode, SubConInvVMs.InvNo, SubConInvVMs.InvDate);

                await LoggingService.LogUserAction(
                username, machine, ip,
