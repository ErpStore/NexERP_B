@page "/DcSubConIncomingInvoice/create/{VendorCode:int}"
@page "/DcSubConIncomingInvoice/update/{InvId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.IPurchase_Invoice_Service
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IOutSourcingService.ISubContractInvoiceService
@using V.SMART.Shared.Pages.Master_Module_pages.VendorSupplier_Pages
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.PurchaseInvoiceVM
@using V.SMART.Shared.ViewModels.OutSourcingViewModel.SubContractViewModel
@using MudBlazor

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ReportService reportService
@inject ISubConInvService subConInvService

@inject ICalculationService _calculationService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">

</BsModal>

<DetailsModal Title="Store Credit Note(SCN) Details"
              Columns="@SCNColumns"
              ColumnFields="@SCNFields"
              HiddenColumns="@SCNHiddenColumns"
              Data="@SCNData"
              IsVisible="@IsSCNModalVisible"
              IsVisibleChanged="@((val) => IsSCNModalVisible = val)"
              OnSelectedItems="OnSCNSelectedAsync">
</DetailsModal>


<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Vendor")
    {
        <VendorUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }

</MasterModal>


<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <!-- Cancelled Watermark -->
            @if (SubConInvVMs.InvCancel)
            {
                <div class="cancelWatermark">CANCELLED</div>
            }

            <PageHeader TitleText="@(SubConInvVMs.InvId > 0 ? "Update SubContract Invoice" : "Create SubContract Invoice")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@PurchaseInvoiceBreadcrumbs" />
            <div class="card-body bg-light">
                 <EditForm Model="SubConInvVMs" OnValidSubmit="UpsertPurchaseInvoice">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">

                        @if (SubConInvVMs.InvId > 0 && !string.IsNullOrWhiteSpace(SubConInvVMs.InvNo))
                        {
                            <CorrespondenceStatus ReferenceType="@ScreenName"
                                                    ReferenceId="@SubConInvVMs.InvId"
                                                    ReferenceTypeName="@SubConInvVMs.InvNo" />
                        }

                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Vendor Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Vendor Information</span>
                                    <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Vendor")'>
                                        <i class="bi bi-person-add me-1"></i> Add Vendor
                                    </button>
                                </div>

                                <div class="card-body">
                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <MudAutocomplete T="VendorVM"
                                                Value="SelectedVendor"
                                                ValueChanged="@(async c => await OnVendorChanged(c))"
                                                ToStringFunc="@(c => c?.VendorName ?? string.Empty)"
                                                SearchFunc="SearchVendors"
                                                Dense="true"
                                                Variant="Variant.Outlined"
                                                Placeholder="Search Vendor"
                                                Title="Search atleast 3 letters in Vendor"
                                                Class="w-100 autocomplete-sm"
                                                MaxItems="50"
                                                Clearable="true"
                                                ResetValueOnEmptyText="true"
                                                Required="true"
                                                AvoidSubmit="true" />
                                        </div>
                                    </div>

                                    <!-- Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1" readonly>@SubConInvVMs?.VendorAddress</textarea>
                                        </div>
                                    </div>

                                     <!-- GSTIN -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>GSTIN</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@SubConInvVMs?.VendorGSTNo" readonly />
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Phone No</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   value="@SubConInvVMs?.VendorContactNo" readonly />
                                        </div>
                                    </div>

                                    <!-- Shipping Address -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Shipping Address</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="form-check form-switch d-flex align-items-center">
                                                <input class="form-check-input" type="checkbox" id="SameAsShipping"
                                                       checked="@SubConInvVMs.IsSameAsShipping"
                                                       @onchange="OnShippingChange" />
                                                <label class="form-check-label ms-2 fw-semibold"
                                                       for="SameAsShipping">Same as Shipping</label>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!SubConInvVMs.IsSameAsShipping)
                                    {
                                        <!-- Shipping To -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Consignee From</small>
                                            </label>
                                            <div class="col-12 col-sm-9">
                                                <select value="@SubConInvVMs.ShipAddrsId"
                                                        class="form-select form-select-sm rounded-3 w-100"
                                                        @onchange="OnConsigneeChangedAsync">
                                                    <option value="">Select Consignee Address</option>
                                                    @foreach (var consine in consineeAddress)
                                                    {
                                                        <option value="@consine.AltVendorCode">@consine.AltVendorName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>

                                        @if (SubConInvVMs.ShipAddrsId > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Address</small>
                                                </label>
                                                <div class="col-12 col-lg-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@SubConInvVMs.ShippingAddress" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Contact No</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@SubConInvVMs.ShippingContactNo" readonly />
                                                </div>
                                            </div>

                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>GSTIN</small>
                                                </label>
                                                <div class="col-12 col-sm-9">
                                                    <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                           value="@SubConInvVMs.ShippingGSTNo" readonly />
                                                </div>
                                            </div>
                                        }
                                    }

                                     <!-- E-Way No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>E-Way No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm flex-wrap w-100">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="eway No."
                                                       @bind="SubConInvVMs.EWayNo" maxlength="12"/>
                                            </div>
                                            <ValidationMessage For="@(() => SubConInvVMs.EWayNo)" />
                                            
                                        </div>
                                    </div>

                                    <!-- eway Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>E-Way Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                        @bind-Value="@SubConInvVMs.EWayDate" />
                                            <ValidationMessage For="@(() => SubConInvVMs.EWayDate)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- =================== Purchase Invoice Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Purchase Invoice Details</span>
                                    @if (SubConInvVMs.InvId > 0 && (CanCreate || CanEdit))
                                    {
                                        <button type="button"
                                                class="btn btn-sm rounded-3 @(SubConInvVMs.InvCancel ? "btn-success" : "btn-danger")"
                                                 @onclick="Cancel" style="display:none">

                                            @if (!SubConInvVMs.InvCancel)
                                            {
                                                <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                            }
                                        </button>
                                    }
                                </div>

                                <div class="card-body">

                                    <!-- Purchase Invoice No. -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Invoice No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm flex-wrap w-100">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="Inv No."
                                                       @bind="SubConInvVMs.InvNo"/>

                                                <span class="input-group-text rounded-end">@SubConInvVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => SubConInvVMs.InvNo)" />
                                            <ValidationMessage For="@(() => SubConInvVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- Invoice Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Invoice Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                        @bind-Value="@SubConInvVMs.InvDate" />
                                            <ValidationMessage For="@(() => SubConInvVMs.InvDate)" />
                                        </div>
                                    </div>

                                    <!-- Reference SCN -->
                                    @if(scnPendingCount > 0)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. SCN</small>
                                            </label>
                                            <div class="col-12 col-sm-9 d-flex flex-wrap gap-2">
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="ShowSCNDetails">
                                                    SCN Details
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Currency -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Currency</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    value="@SubConInvVMs.CurrId"
                                                    @onchange="OnCurrencyChanged"
                                                    disabled>
                                                @foreach (var currency in Currencies)
                                                {
                                                    <option value="@currency.CurrId">@currency.CurrName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="SubConInvVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => SubConInvVMs.MainRemark)" />
                                        </div>
                                    </div>
                                    @if (SubConInvVMs.InvId>0)
                                    {
                                         <div class="accordion mb-3" id="transportAccordion">
                                        <div class="accordion-item border-0 shadow-sm rounded-3">
                                            <h2 class="accordion-header" id="headingTransport">
                                                <button class="accordion-button collapsed fw-semibold text-primary"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#collapseTransport"
                                                        aria-expanded="false"
                                                        aria-controls="collapseTransport">
                                                        TDS Details
                                                </button>
                                            </h2>
                                            <div id="collapseTransport"
                                                 class="accordion-collapse collapse"
                                                 aria-labelledby="headingTransport"
                                                 data-bs-parent="#transportAccordion">
                                                <div class="accordion-body">

                                                     <!-- Transport ID -->
                                                    <div class="mb-2 row">
                                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                            <small>TDS Amount (In ₹) </small>
                                                        </label>
                                                        <div class="col-12 col-sm-9">
                                                           <div class="d-flex align-items-center">
                                                                <input type="number" step="any"
                                                                       class="form-control form-control-sm rounded-3"
                                                                       @bind="SubConInvVMs.TDSAmount" />
                                                            </div>
                                                            <ValidationMessage For="@(() => SubConInvVMs.TDSAmount)" />
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mt-1">

                                                    <!-- Center Button Wrapper -->
                                                    <div class="flex-grow-1 d-flex justify-content-center">
                                                        <button type="button" class="btn btn-sm fw-semibold"
                                                                style="background-color:#ffca2c; color:black; border-radius:8px;" @onclick="TDS">
                                                            <span class="me-2"> <i class="bi bi-currency-rupee"></i></span>
                                                            <span class="me-2"> <i class="bi bi-dash-circle"></i> </span>
                                                            Deduct TDS
                                                        </button>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    }
                                   

                                     <!-- Is Required ActQty+rejQty+RewQty -->

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-danger">
                                            <small>Enable A/R/R Qty</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm flex-wrap w-100 align-items-center">
                                                <InputCheckbox 
                                                    @bind-Value="SubConInvVMs.IsAcptRejRewQtyRequired" 
                                                    id="isRejectionReq" 
                                                    class="form-check-input"
                                                    disabled="@IsSomeItemsTransMade"
                                                    title="Enable Accept, Rework and Reject quantity entry for this Invoice" />

                                                <span class="ms-2 text-muted">(Accept · Rework · Reject)</span>
                                            </div>

                                            <ValidationMessage For="@(() => SubConInvVMs.IsAcptRejRewQtyRequired)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">
                               
                                <div class="card-header bg-primary-subtle text-dark">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap">

                                        <!-- Title -->
                                        <span class="fw-bold fs-6">Item Details</span>

                                        <!-- Right Controls -->
                                        <div class="d-flex flex-wrap align-items-center gap-2">

                                            <!-- Discount Toggle -->
                                            <div class="d-flex align-items-center gap-2">
                                                <label class="mb-0"><small>Discount:</small></label>
                                                <div class="btn-group btn-group-sm rounded-pill border" role="group">
                                                    <input type="radio" class="btn-check" name="toggleDiscount" id="discountToggleRs" 
                                                           @onchange='() => SetDiscountMode(true)' 
                                                           checked="@SubConInvVMs.IsItemWiseDiscAmtOrPerReq" />
                                                    <label class="btn btn-outline-primary rounded-start-pill" for="discountToggleRs">@SubConInvVMs.Symbol</label>

                                                    <input type="radio" class="btn-check" name="toggleDiscount" id="discountTogglePercent" 
                                                           @onchange='() => SetDiscountMode(false)' 
                                                           checked="@(!SubConInvVMs.IsItemWiseDiscAmtOrPerReq)" />
                                                    <label class="btn btn-outline-primary rounded-end-pill" for="discountTogglePercent">%</label>
                                                </div>
                                            </div>

                                            <!-- Add Item Button -->
                                             <button type="button" class="btn btn-sm btn-success rounded-3" @onclick='() => OpenModal("Item")'>
                                                <i class="bi bi-plus-circle me-1"></i> Create New Item
                                            </button>

                                        </div>
                                    </div>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:70px;">HSN</th>
                                                    <th style="width:120px;">Qty</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:130px;">Gross Amount</th>

                                                    @if (!SubConInvVMs.IsItemWiseDiscAmtOrPerReq)
                                                    {
                                                        <th style="width:110px;">Disc %</th>
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:110px;">Disc Amt</th>
                                                    }

                                                    @if (SelectedVendor?.TaxValidate == false)
                                                    {
                                                        @if(SelectedVendor?.BusiType == "Local")
                                                        {
                                                            <th style="width:110px;">CGST %</th>
                                                            <th style="width:110px;">SGST %</th>
                                                        }
                                                        else if(SelectedVendor?.BusiType == "InterState")
                                                        {
                                                            <th style="width:110px;">IGST %</th>
                                                        }
                                                    }

                                                    <th style="width:130px;">Basic Amount</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:110px;">Ref SCN No.</th>
                                                    <th style="width:110px;">Ref SCN Dt.</th>
                                                    <th style="width:150px;">Cost-Center</th>

                                                    <th style="width:150px;">Category</th>
                                                    <th style="width:150px;">Specification</th>

                                                    
                                                     @if (SubConInvVMs?.SubConInvSubVMs?.Any(x => x?.DebititNos != null && x.DebititNos.Count > 0) == true)
                                                     {
                                                         <th style="width:150px;">DebitNote No.</th> 
                                                         <th style="width:150px;">DebitNote Date</th>
                                                     }

                                                    <th style="width:90px;" class="freeze-last-col text-center">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in SubConInvVMs.SubConInvSubVMs)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>

                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @subitem.ItemCode
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                        Size="Size.Small"
                                                                                        Color="Color.Primary"
                                                                                        OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                        Edge="Edge.End"
                                                                                        Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.MeasureUnit</td>
                                                        <td>@subitem.HsnCode</td>

                                                        <!-- Qty -->
                                                        <td>

                                                            @if (subitem.IsEditable)
                                                            {
                                                                  <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Qty"
                                                                           title="Enter Quantity"
                                                                           step="any" 
                                                                           @bind="subitem.Qty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                <ValidationMessage For="@(() => subitem.Qty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.Qty</span>
                                                            }
                                                        </td>

                                                        <!-- Unit Price -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number" class="form-control form-control-sm" step="any" placeholder="Price" title="Enter Unit Price"
                                                                        @bind="subitem.UnitPrice" @bind:event="oninput"
                                                                        @bind:after='() => _calculationService.UpdateTotalsAsync(SubConInvVMs)' />
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                @FormatDecimal(subitem.UnitPrice)
                                                            }
                                                        </td>

                                                        <!-- Line Gross -->
                                                        <td>@FormatDecimal(subitem.LineGross)</td>

                                                        <!-- Discount -->
                                                        @if (!SubConInvVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" step="any" placeholder="Disc %" title="Enter Discount %"
                                                                            @bind="subitem.LineDiscountPercent" @bind:event="oninput"
                                                                            @bind:after='() => OnLineDiscountPercentChanged(subitem)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountPercent)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountPercent)
                                                                }
                                                            </td>
                                                            <td>@FormatDecimal(subitem.LineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number" class="form-control form-control-sm" step="any" placeholder="Disc Amt" title="Enter Discount Amount"
                                                                            @bind="subitem.LineDiscountAmount" @bind:event="oninput"
                                                                            @bind:after='() => _calculationService.UpdateTotalsAsync(SubConInvVMs)' />
                                                                    <ValidationMessage For="@(() => subitem.LineDiscountAmount)" />
                                                                }
                                                                else
                                                                {
                                                                    @FormatDecimal(subitem.LineDiscountAmount)
                                                                }
                                                            </td>
                                                        }

                                                        <!-- Taxes -->
                                                        @if (SelectedVendor?.TaxValidate == false)
                                                        {
                                                            @if (SelectedVendor?.BusiType == "Local")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" 
                                                                            value="@subitem.LineCGSTRate"
                                                                            @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                            <option value="" disabled selected>CGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                        <ValidationMessage For="@(() => subitem.LineCGSTRate)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineCGSTRate)
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" 
                                                                            value="@subitem.LineSGSTRate"
                                                                            @onchange="e => OnTaxRateChanged(e, subitem)">
                                                                            <option value="" disabled selected>SGST %</option>
                                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                        <ValidationMessage For="@(() => subitem.LineSGSTRate)" />

                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineSGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                            else if (SelectedVendor?.BusiType == "InterState")
                                                            {
                                                                <td>
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <select class="form-select form-select-sm" @bind="subitem.LineIGSTRate" @bind:event="oninput"
                                                                                @bind:after='() => _calculationService.UpdateTotalsAsync(SubConInvVMs)'>
                                                                            <option value="" disabled selected>IGST %</option>
                                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                                            {
                                                                                <option value="@rate">@rate</option>
                                                                            }
                                                                        </select>
                                                                        <ValidationMessage For="@(() => subitem.LineIGSTRate)" />
                                                                    }
                                                                    else
                                                                    {
                                                                        @FormatDecimal(subitem.LineIGSTRate)
                                                                    }
                                                                </td>
                                                            }
                                                        }

                                                        <!-- Basic Amount -->
                                                        <td>@FormatDecimal(subitem.LineBasicAmount)</td>

                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputTextArea @bind-Value="subitem.Remarks"
                                                                    class="form-control form-control-sm"
                                                                    placeholder="Enter Remarks"
                                                                    rows="1" />
                                                                <ValidationMessage For="@(() => subitem.Remarks)" />

                                                            }
                                                            else
                                                            {
                                                                @subitem.Remarks
                                                            }
                                                        </td>

                                                        <!-- Ref PO -->
                                                        <td>@subitem.RefSCNNo</td>
                                                        <td>@subitem.RefSCNDate?.ToString("dd/MM/yyyy")</td>

                                                        <!-- Cost Center -->
                                                        <td>
                                                            @subitem.ProjectNo
                                                        </td>

                                                         <td>
                                                            @subitem.CategoryName
                                                        </td>
                                                         <td>
                                                            @subitem.Specification
                                                        </td>

                                                        @if (SubConInvVMs?.SubConInvSubVMs?.Any(x => x?.DebititNos != null && x.DebititNos.Count > 0) == true)
                                                        {
                                                            <td>@string.Join(", ", subitem.DebititNos)</td>
                                                            <td>
                                                                @string.Join(", ", subitem.DebititDates?.Select(d => d.ToString("dd/MM/yyyy")) ?? Enumerable.Empty<string>())
                                                            </td>
                                                        }

                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            @if (!SubConInvVMs.InvCancel)
                                                            {
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                            @onclick="async () => await SaveRow(subitem)">
                                                                        <i class="bi bi-check-lg"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                            @onclick="async () => await CancelEdit(subitem, SubConInvVMs)">
                                                                        <i class="bi bi-x-lg"></i>
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit" 
                                                                            @onclick="async () => await EditRowAsync(subitem)">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete" 
                                                                            @onclick="async () => await RemoveRow(subitem)">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                }
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            <!-- Totals -->
                                            @if (SubConInvVMs.SubConInvSubVMs?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark">
                                                    <tr>
                                                        <td colspan="5" class="text-end fw-bold">
                                                            Totals:
                                                        </td>
                                                        <td>@SubConInvVMs.TotalQty</td>
                                                        <td>Avg: @FormatDecimal(SubConInvVMs.AvgUnitPrice)</td>
                                                        <td>@FormatDecimal(SubConInvVMs.TotalLineGross)</td>

                                                        @if (!SubConInvVMs.IsItemWiseDiscAmtOrPerReq)
                                                        {
                                                            <td></td>
                                                            <td>@FormatDecimal(SubConInvVMs.TotalLineDiscountAmount)</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@FormatDecimal(SubConInvVMs.TotalLineDiscountAmount)</td>
                                                        }

                                                        @if (SelectedVendor?.TaxValidate == false)
                                                        {
                                                            @if(SelectedVendor?.BusiType == "Local")
                                                            {
                                                                <td></td>
                                                                <td></td>
                                                            }
                                                            else if(SelectedVendor?.BusiType == "InterState")
                                                            {
                                                                <td></td>
                                                            }
                                                        }

                                                        <td>@FormatDecimal(SubConInvVMs.TotalLineBasicAmount)</td>
                                                         @if(SubConInvVMs?.SubConInvSubVMs?.Any(x => x?.DebititNos != null && x.DebititNos.Count > 0) == true)
                                                         {
                                                             <td colspan="9"></td>
                                                         }else
                                                         {
                                                             <td colspan="7"></td>
                                                         }

                                                    </tr>
                                                </tfoot>
                                            }

                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ===================Other Details Terms and Conditions ===================-->
                        <div class="col-12 col-lg-6 mb-3">
                            <div class="card shadow-sm rounded-4 border-0">
                                <div class="card-body">
                                    <div class="row g-3">

                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- =================== Tax Details Section =================== -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm rounded-4 border-0 p-3">

                                <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">
                                    <i class="bi bi-receipt-cutoff me-1 text-primary"></i> Tax & Charges
                                </h6>

                                <!-- Total Gross -->
                                <div class="row mb-2 gx-3">
                                    <label for="TotalGross" class="col-5 col-md-4 col-form-label text-dark">
                                        <small>Total Gross</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input id="TotalGross"
                                               class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number"
                                               value="@FormatDecimal(SubConInvVMs.TotalGrossAmount)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Discount -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Discount</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="discountToggle" id="discountRs"
                                                   @onchange="() => SetDiscountType(true)"
                                                   checked="@SubConInvVMs.DiscAmtOrPer"
                                                   disabled="@(SubConInvVMs.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountRs">
                                                <small>@SubConInvVMs.Symbol</small>
                                            </label>

                                            <input type="radio" class="btn-check" name="discountToggle" id="discountPercent"
                                                   @onchange="() => SetDiscountType(false)"
                                                   checked="@(!SubConInvVMs.DiscAmtOrPer)"
                                                   disabled="@(SubConInvVMs.TotalLineDiscountAmount > 0)" />
                                            <label class="btn btn-outline-primary" for="discountPercent"><small>%</small></label>
                                        </div>
                                    </div>

                                    <div class="col-3 col-md-5">
                                        @if (SubConInvVMs.DiscAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   @bind="SubConInvVMs.DiscountAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(SubConInvVMs)'
                                                   disabled="@(SubConInvVMs.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => SubConInvVMs.DiscountAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number"
                                                   @bind="SubConInvVMs.DiscountPercent"
                                                   @bind:after="OnDiscountPercentChanged"
                                                   disabled="@(SubConInvVMs.TotalLineDiscountAmount > 0)" />
                                            <ValidationMessage For="@(() => SubConInvVMs.DiscountPercent)" />
                                            <small class="text-muted d-block text-end">
                                                Amt: @FormatDecimal(SubConInvVMs.DiscountAmount)
                                            </small>
                                        }
                                    </div>
                                </div>

                                <!-- SubTotal -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>SubTotal</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               type="number" 
                                               value="@FormatDecimal(SubConInvVMs.TotalBasicAmount)" 
                                               readonly />
                                    </div>
                                </div>

                                <!-- Freight Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Freight Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="SubConInvVMs.FreightCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(SubConInvVMs)' />
                                        <ValidationMessage For="@(() => SubConInvVMs.FreightCharges)" />
                                    </div>
                                </div>

                                <!-- P & F Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>P & F Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="packingToggle" id="packingToggleRs"
                                                   @onchange="() => SetPAndFType(true)" checked="@SubConInvVMs.PackingAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="packingToggleRs"><small>@SubConInvVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="packingToggle" id="packingTogglePercent"
                                                   @onchange="() => SetPAndFType(false)" checked="@(!SubConInvVMs.PackingAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="packingTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (SubConInvVMs.PackingAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="SubConInvVMs.PackingCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(SubConInvVMs)' />
                                            <ValidationMessage For="@(() => SubConInvVMs.PackingCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="SubConInvVMs.PackingPercent"
                                                   @bind:after="() => OnPandFPercentChanged()" />
                                            <ValidationMessage For="@(() => SubConInvVMs.PackingPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(SubConInvVMs.PackingCharges)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Insurance Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Insurance Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceToggleRs"
                                                   @onchange="() => SetInsuranceType(true)" checked="@SubConInvVMs.InsuranceAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="insuranceToggleRs"><small>@SubConInvVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="insuranceToggle" id="insuranceTogglePercent"
                                                   @onchange="() => SetInsuranceType(false)" checked="@(!SubConInvVMs.InsuranceAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="insuranceTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (SubConInvVMs.InsuranceAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="SubConInvVMs.InsuranceCharges"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(SubConInvVMs)' />
                                            <ValidationMessage For="@(() => SubConInvVMs.InsuranceCharges)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="SubConInvVMs.InsurancePercent"
                                                   @bind:after="() => OnInsurancePercentChanged()" />
                                            <ValidationMessage For="@(() => SubConInvVMs.InsurancePercent)" />
                                            <small class="text-muted d-block text-end">Amt: @FormatDecimal(SubConInvVMs.InsuranceCharges)</small>
                                        }
                                    </div>
                                </div>

                                <!-- Total Taxable -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Total Taxable</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end bg-warning-subtle"
                                               value="@FormatDecimal(SubConInvVMs.TotalTaxable)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Taxes (CGST/SGST/IGST) -->
                                @if (SelectedVendor?.TaxValidate == false)
                                {
                                    <div class="mb-2">
                                        @if (SelectedVendor?.BusiType == "Local")
                                        {
                                            <!-- CGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>CGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!SubConInvVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="SubConInvVMs.CGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(SubConInvVMs.CGstRate)">
                                                            <option value="0">-- Select CGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => SubConInvVMs.CGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(SubConInvVMs.TotalCGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>

                                            <!-- SGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>SGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!SubConInvVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="SubConInvVMs.SGstRate"
                                                                @bind:after="() => OnMainTaxRateChanged(SubConInvVMs.SGstRate)">
                                                            <option value="0">-- Select SGST % --</option>
                                                            @foreach (var rate in CommonConstants.GSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => SubConInvVMs.SGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(SubConInvVMs.TotalSGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                        else if (SelectedVendor?.BusiType == "InterState")
                                        {
                                            <!-- IGST -->
                                            <div class="row mb-2 gx-2">
                                                <label class="col-5 col-md-4 col-form-label text-dark"><small>IGST (%)</small></label>
                                                <div class="col-3 col-md-4">
                                                    @if (!SubConInvVMs.HasItemWiseTax)
                                                    {
                                                        <select class="form-select form-select-sm rounded-3 w-100"
                                                                @bind="SubConInvVMs.IGstRate"
                                                                @bind:after="() => _calculationService.UpdateTotalsAsync(SubConInvVMs)"
                                                                disabled="@(SelectedVendor?.TaxValidate == true)">
                                                            <option value="0">-- Select IGST % --</option>
                                                            @foreach (var rate in CommonConstants.IGSTRates)
                                                            {
                                                                <option value="@((decimal)rate)">@rate</option>
                                                            }
                                                        </select>
                                                        <ValidationMessage For="@(() => SubConInvVMs.IGstRate)" />
                                                    }
                                                </div>
                                                <div class="col-4">
                                                    <input class="form-control form-control-sm text-end"
                                                           value="@FormatDecimal(SubConInvVMs.TotalIGSTAmount)"
                                                           readonly />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- TCS Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>TCS Charges</small></label>
                                    <div class="col-4 col-md-3">
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsToggleRs"
                                                   @onchange="() => SetTCSType(true)" checked="@SubConInvVMs.TCSAmtOrPer" />
                                            <label class="btn btn-outline-primary" for="tcsToggleRs"><small>@SubConInvVMs.Symbol</small></label>

                                            <input type="radio" class="btn-check" name="tcsToggle" id="tcsTogglePercent"
                                                   @onchange="() => SetTCSType(false)" checked="@(!SubConInvVMs.TCSAmtOrPer)" />
                                            <label class="btn btn-outline-primary" for="tcsTogglePercent"><small>%</small></label>
                                        </div>
                                    </div>
                                    <div class="col-3 col-md-5">
                                        @if (SubConInvVMs.TCSAmtOrPer)
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="SubConInvVMs.TCSAmount"
                                                   @bind:after='() => _calculationService.UpdateTotalsAsync(SubConInvVMs)' />
                                            <ValidationMessage For="@(() => SubConInvVMs.TCSAmount)" />
                                        }
                                        else
                                        {
                                            <input class="form-control form-control-sm rounded-3 text-end"
                                                   type="number" @bind="SubConInvVMs.TCSPercent"
                                                   @bind:after="() => OnTCSPercentChanged()" />
                                            <ValidationMessage For="@(() => SubConInvVMs.TCSPercent)" />
                                            <small class="text-muted d-block text-end">Amt: @SubConInvVMs.TCSAmount</small>
                                        }
                                    </div>
                                </div>

                                <!-- Other Charges -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Other Charges</small></label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 text-end"
                                               type="number" @bind="SubConInvVMs.OtherCharges"
                                               @bind:after='() => _calculationService.UpdateTotalsAsync(SubConInvVMs)' />
                                        <ValidationMessage For="@(() => SubConInvVMs.OtherCharges)" />
                                    </div>
                                </div>

                                <!-- Round Off -->
                                <div class="row mb-2 gx-2 align-items-center">
                                    <div class="col-5 col-md-4 d-flex align-items-center">
                                        <small class="me-2 text-dark">Round Off</small>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="roundOffSwitch"
                                                   @bind="SubConInvVMs.IsRoundOffEnabled"
                                                   @bind:after="() => _calculationService.UpdateTotalsAsync(SubConInvVMs)" >
                                            <label class="form-check-label" for="roundOffSwitch"></label>
                                        </div>
                                    </div>
                                    <div class="col-7 col-md-8">
                                       <input class="form-control form-control-sm rounded-3 text-end"
                                               value="@FormatDecimal(SubConInvVMs.RoundOff)"
                                               readonly />
                                    </div>
                                </div>

                                <!-- Grand Total -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label fw-bold text-dark">
                                        <small>Grand Total</small>
                                    </label>
                                    <div class="col-7 col-md-8">
                                        <input class="form-control form-control-sm rounded-3 fw-bold text-primary text-end bg-warning-subtle"
                                               value="@FormatDecimal(SubConInvVMs.GrandTotal)"
                                               readonly />
                                        @if (SubConInvVMs.CurrId > 1)
                                        {
                                            <div class="mt-1 text-end">
                                                <small class="text-muted d-block">
                                                    Today's value: @SubConInvVMs.TodayVal
                                                </small>
                                                <small class="fw-bold text-success d-block">
                                                    Converted Value in Rs: @((SubConInvVMs.GrandTotal * SubConInvVMs.TodayVal).ToString("0.00"))
                                                </small>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Amount in Words -->
                                <div class="row mb-2 gx-2">
                                    <label class="col-5 col-md-4 col-form-label text-dark"><small>Amount in Words</small></label>
                                    <div class="col-7 col-md-8 pt-1">
                                        @if (SubConInvVMs.CurrId > 1)
                                        {
                                            <small class="fw-bold text-success d-block">
                                                Converted Value in Rs: @FormatDecimal(SubConInvVMs.GrandTotal * SubConInvVMs.TodayVal)
                                            </small>
                                        }
                                        else
                                        {
                                            <strong>@NumberToWordsHelper.ConvertNumberToWords(SubConInvVMs.GrandTotal)</strong>
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Action Buttons -->
                            @if (CanCreate || CanEdit)
                            {
                                @if(!SubConInvVMs.InvCancel)
                                {
                                    <div class="col-6 col-md-3 mt-3">
                                        <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                            <i class="bi bi-floppy2-fill me-1"></i> @(SubConInvVMs.InvId > 0 ? "Update" : "Create")
                                        </button>
                                    </div>
                                }
                            }

                            <div class="col-6 col-md-3 mt-3">
                                <SmartBackButton Url="/subConInvList" />
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


