    private async Task OnSCNSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (SubConInvVMs.SubConInvSubVMs == null)
            SubConInvVMs.SubConInvSubVMs = new List<SubConInvSubVM>();

        int vendorcode = SubConInvVMs.VendorCode.Value;

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            //var priceDict = await MfgPoService.GetBulkLastUnitPricesAsync(itemIds, custId);
            decimal qtyrecd = 0,rejqty=0,rewqty=0;
            foreach (var item in selectedItems)
            {
                qtyrecd = 0;rejqty=0;rewqty=0;

                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? SCNSubId = item.ContainsKey("SCNSubId") && item["SCNSubId"] != null
                    ? Convert.ToInt32(item["SCNSubId"])
                    : (int?)null;


                if (item.TryGetValue("BalQty", out var balQtyObj))
                    decimal.TryParse(balQtyObj?.ToString(), out qtyrecd);

                if (item.TryGetValue("RejectQty", out var RejQtyObj))
                    decimal.TryParse(RejQtyObj?.ToString(), out rejqty);

                if (item.TryGetValue("RewQty", out var RewQtyObj))
                    decimal.TryParse(RewQtyObj?.ToString(), out rewqty);

                if (SubConInvVMs.SubConInvSubVMs.Any(x => x.ItemId == itemId && x.RefSCNSubId == SCNSubId))
                    continue;

                var subVm = new SubConInvSubVM
                {
                    RefSCNSubId = SCNSubId,
                    RefSCNNo = item.TryGetValue("SCNNo", out var SCNNo) ? SCNNo?.ToString() : string.Empty,

                    RefSCNDate = item.TryGetValue("SCNDate", out var SCNDate) && DateTime.TryParse(SCNDate?.ToString(), out var parsedPoDate)
                        ? parsedPoDate
                        : (DateTime?)null,

                    ItemId = itemId,
                    ItemCode = item.TryGetValue("ItemCode", out var itemCode) ? itemCode?.ToString() : string.Empty,
                    ItemName = item.TryGetValue("ItemName", out var itemName) ? itemName?.ToString() : string.Empty,
                    Specification = item.TryGetValue("Specification", out var Specification) ? Specification?.ToString() : string.Empty,
                    MeasureUnit = item.TryGetValue("UOM", out var uom) ? uom?.ToString() : string.Empty,
                    HsnCode = item.TryGetValue("HSNCode", out var hsn) ? hsn?.ToString() : string.Empty,
                    CategoryName = item.TryGetValue("Category", out var Category) ? Category?.ToString() : string.Empty,

                    BalQty = (qtyrecd),
                    Qty =qtyrecd,
                    DbBalQty=qtyrecd,
                    RejectQty=SubConInvVMs.IsAcptRejRewQtyRequired ? rejqty:0,
                    ReworkQty=SubConInvVMs.IsAcptRejRewQtyRequired ? rewqty:0,
                    UnitPrice = item.TryGetValue("UnitPrice", out var unitPrice) && decimal.TryParse(unitPrice?.ToString(), out var parsedPrice)
                        ? parsedPrice
                        : 0m,

                    CostId = item.TryGetValue("CostCenterId", out var costId) && int.TryParse(costId?.ToString(), out var parsedCostId) && parsedCostId != 0
                        ? parsedCostId
                        : (int?)null,

                    ProjectNo = item.TryGetValue("ProjectNo", out var projectNo) ? projectNo?.ToString() : string.Empty,

                    IsEditable = true
                };


                SubConInvVMs.SubConInvSubVMs.Add(subVm);
            }

            int slNo = 1;
            foreach (var row in SubConInvVMs.SubConInvSubVMs)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected GRNSelected items.");
        }
    }

