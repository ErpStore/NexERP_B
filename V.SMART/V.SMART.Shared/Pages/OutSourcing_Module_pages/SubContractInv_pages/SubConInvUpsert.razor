    #region Initialization
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            Currencies = await subConInvService.GetCurrenciesAsync();
            DecimalPlaces = await subConInvService.GetDecimalPlacesAsync();
            screenCode = await subConInvService.GetScreenCodeByScreenNameAsync(ScreenName);

            if (InvId.HasValue)
            {
                await LoadExistingInvoice(InvId.Value);
            }
            else if (VendorCode > 0)
            {
                await InitializeNewGRN(VendorCode);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingInvoice(int InvId)
    {
        try
        {
            SubConInvVMs = await subConInvService.GetPurchaseInvoiceByIdAsync(InvId);
            if (SubConInvVMs == null)
            {
                await _JS.ToastrWarning("GRN not found.");
                return;
            }

            SelectedVendor = await subConInvService.GetVendorByIdAsync(SubConInvVMs.VendorCode.Value);
            if (SelectedVendor != null)
                await ApplyVendorSelectionAsync(SelectedVendor);

            foreach (var dcSub in SubConInvVMs.SubConInvSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[dcSub.ItemId.Value] =
                    await subConInvService.GetCorrespondenceAttachmentsCountAsync(dcSub.ItemId.Value, "Item");

                //AccT+RejQt+RewQty
                dcSub.Qty = SubConInvVMs.IsAcptRejRewQtyRequired ? (dcSub.Qty + dcSub.RejectQty + dcSub.ReworkQty) : dcSub.Qty;

            }

            //Check Transaction Completed flag
            IsSomeItemsTransMade = await CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load Existing PurchaseGRN.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingDc failed in PurchaseInvoice for InvId: {InvId}");
        }
    }

    private async Task<bool> CheckIsTransMade()
    {
        try
        {
            var list = SubConInvVMs?.SubConInvSubVMs;
            if (list == null || list.Count == 0)
                return false;

            decimal totalQty = 0, totalBalQty = 0;

            for (int i = 0; i < list.Count; i++)
            {
                totalQty += list[i].Qty.GetValueOrDefault();
                totalBalQty += list[i].BalQty.Value;
            }

            return totalQty != totalBalQty;

            return SubConInvVMs.GrandTotal != SubConInvVMs.Balance;

            // 2️⃣ Check main and sub cancel flags from DB
            bool InvCancel = await subConInvService.GetPurchaseInvoiceByIdIsCancelAsync(InvId.Value);

            if (!InvCancel)
                return true; // Not found → invalid

            if (InvCancel)
                return true; // Main quotation cancelled

            if (InvCancel)
                return true; // Some sub items cancelled

            // ✅ All good → can delete safely
            return false;

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "CheckIsTransMade failed.");
            return false;

        }


    }

    private async Task InitializeNewGRN(int vendorCode)
    {
        try
        {
            var vendor = await subConInvService.GetVendorByIdAsync(vendorCode);
            if (vendor != null)
                await ApplyVendorSelectionAsync(vendor);

            SubConInvVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);

        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to initialize new po.");
            await LoggingService.LogDeveloperError(ex, $"InitializeNewPo failed for VendorCode: {vendorCode}");
        }
    }
    #endregion

    #region Vendor data Handlers
    private async Task<IEnumerable<VendorVM>> SearchVendors(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 3)
            return Enumerable.Empty<VendorVM>();

        try
        {
            var results = await subConInvService.SearchVendorsAsync(value);
            return results?.Take(50) ?? Enumerable.Empty<VendorVM>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<VendorVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"In PurchaseInvoiceUpsert SearchVendors failed for value: {value}");
            await _JS.ToastrError("Failed to search Vendors in PurchaseInvoiceUpsert. Please try again.");
            return Enumerable.Empty<VendorVM>();
        }
    }

    private async Task OnVendorChanged(VendorVM? vendor)
    {
        try
        {
            await ApplyVendorSelectionAsync(vendor);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error in OnVendorChanged: {ex}");
            await LoggingService.LogDeveloperError(ex, "Error in OnVendorChanged");
            await _JS.ToastrError("Error while selecting");

        }
    }

    private async Task ApplyVendorSelectionAsync(VendorVM? vendor)
    {
        try
        {
            SelectedVendor = vendor;
            SubConInvVMs.VendorCode = vendor?.VendorCode ?? 0;
            SubConInvVMs.VendorName = vendor?.VendorName;
            SubConInvVMs.VendorAddress = vendor?.VendorAddress;
            SubConInvVMs.VendorGSTNo = vendor?.GSTNo;
            SubConInvVMs.VendorContactNo = vendor?.ContactNo;
            SubConInvVMs.IsAcptRejRewQtyRequired = vendor?.IsAllowAccRejRew ?? false;

            if (vendor == null)
            {
                contactPersons.Clear();
                consineeAddress.Clear();
                return;
            }
            contactPersons = await subConInvService.GetContactPersonsVendorAsync(vendor.VendorCode);
            consineeAddress = await subConInvService.GetConsigneeAddressesAsync(vendor.VendorCode);

            SubConInvVMs.KindOfAttention = contactPersons.Count == 1 ? contactPersons.First().ContactPerson : string.Empty;

            // Tax logic
            if (!vendor.TaxValidate)
            {
                var lastInv = await  subConInvService.GetLastInvAsync(vendor.VendorCode);

                if (lastInv != null)
                {
                    SubConInvVMs.CGstRate = lastInv.CGstRate;
                    SubConInvVMs.SGstRate = lastInv.SGstRate;
                    SubConInvVMs.IGstRate = lastInv.IGstRate;
                }
                else
                {
                    if (string.Equals(vendor.BusiType, "Local", StringComparison.OrdinalIgnoreCase)  && vendor.TaxValidate == false)
                    {
                        SubConInvVMs.CGstRate = CommonConstants.GetGST(9.000m);
                        SubConInvVMs.SGstRate = CommonConstants.GetGST(9.000m);
                        SubConInvVMs.IGstRate = CommonConstants.GetIGST(0.000m);
                    }
                    else if (string.Equals(vendor.BusiType, "InterState", StringComparison.OrdinalIgnoreCase) && vendor.TaxValidate == false )
                    {
                        SubConInvVMs.CGstRate = CommonConstants.GetGST(0.000m);
                        SubConInvVMs.SGstRate = CommonConstants.GetGST(0.000m);
                        SubConInvVMs.IGstRate = CommonConstants.GetIGST(18.000m);
                    }
                }

            }

            // Currency
            SubConInvVMs.CurrId = (vendor.CurrId.HasValue && vendor.CurrId > 0) ? vendor.CurrId.Value : 1;
            await ApplyCurrencyChange(SubConInvVMs.CurrId);

            //Pending PoDetails
            scnPendingCount = await subConInvService.GetPendingSCNCountAsync(vendor.VendorCode);

            // Update totals
            await _calculationService.UpdateTotalsAsync(SubConInvVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"ApplyVendorSelectionAsync failed for VendorCode: {vendor?.VendorCode}");
            await _JS.ToastrError("Failed to apply vendor selection. Please try again.");
        }
    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
            await ApplyCurrencyChange(selectedId);
    }

    private async Task ApplyCurrencyChange(int currencyId)
    {
        var selectedCurrency = await subConInvService.GetCurrencyByIdAsync(currencyId);
        if (selectedCurrency == null) return;

        SubConInvVMs.CurrName = selectedCurrency.CurrName;
        SubConInvVMs.Symbol = selectedCurrency.Symbol;
        SubConInvVMs.CurrId = selectedCurrency.CurrId;

        if (currencyId > 1)
            SubConInvVMs.TodayVal = await subConInvService.GetLatestCurrencyValueAsync(currencyId) ?? 0m;
    }

    private async Task ResetQuoteDefaults()
    {
        SubConInvVMs.CGstRate = 0m;
        SubConInvVMs.SGstRate = 0m;
        SubConInvVMs.IGstRate = 0m;
    }

    private async Task OnShippingChange(ChangeEventArgs e)
    {
        try
        {
            SubConInvVMs.IsSameAsShipping = (bool)e.Value;

            if (!SubConInvVMs.IsSameAsShipping && SelectedVendor != null)
            {
                consineeAddress = await subConInvService.GetConsigneeAddressesAsync(SelectedVendor.VendorCode);
            }
            else
            {
                consineeAddress.Clear();
                ResetShippingDefaults();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                $"Error while toggling shipping address for VendorCode={SelectedVendor?.VendorCode}");
        }
    }

    private void ResetShippingDefaults()
    {
        SubConInvVMs.ShipAddrsId = null;
        SubConInvVMs.ShippingName = null;
        SubConInvVMs.ShippingAddress = null;
        SubConInvVMs.ShippingGSTNo = null;
        SubConInvVMs.ShippingContactNo = null;
    }

    private async Task OnConsigneeChangedAsync(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var selectedId) || selectedId == 0)
            {
                SubConInvVMs.IsSameAsShipping = true; 
                ResetShippingDefaults();

                StateHasChanged();
                return;
            }

            SubConInvVMs.IsSameAsShipping = false; 

            var selectedConsignee = consineeAddress.FirstOrDefault(c => c.AltVendorCode == selectedId);
            if (selectedConsignee == null)
                return;

            SubConInvVMs.ShipAddrsId = selectedConsignee.AltVendorCode;
            SubConInvVMs.ShippingAddress = string.Join(" ",
                new[] { selectedConsignee.AltVendorAddr1, selectedConsignee.AltVendorAddr2 }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            SubConInvVMs.ShippingGSTNo = selectedConsignee.GSTNo ?? string.Empty;
            SubConInvVMs.ShippingContactNo = selectedConsignee.ContactNo ?? string.Empty;

            await _calculationService.UpdateTotalsAsync(SubConInvVMs);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnConsigneeChangedAsync");
        }
    }

    #endregion

    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, SubConInvSubVM SubVM)
    {
        try
        {
            // Common validation: Qty must be positive
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                await _JS.ToastrWarning("Qty must be a positive number.");
                return;
            }

            // NEW quote line
            if (SubVM.InvSubId == 0)
            {
                if (SubVM.RefSCNSubId > 0)
                {
                    var SCNBalQty = await subConInvService.GetSCNItemPerformaBalQtyFromSCNSubId(SubVM.RefSCNSubId.Value);

                    if (newQty <= SCNBalQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.DbBalQty = SubVM.Qty.Value;
                    }
                    else
                    {
                        SubVM.Qty = SCNBalQty;
                        SubVM.DbBalQty = SubVM.Qty.Value;
                        await _JS.ToastrWarning($"Qty can't be greater than SCN Balance Qty ({SCNBalQty}).");
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.DbBalQty = newQty;
                }
            }

            // EXISTING Invoice line
            else
            {
                if (SubVM.RefSCNSubId > 0)
                {
                    var performabalQty = await subConInvService.GetSCNItemPerformaBalQtyFromSCNSubId(SubVM.RefSCNSubId.Value);
                    var OrginalQty = await subConInvService.GetExistingPurchInvoiceQtyByInvSubId(SubVM.InvSubId);


                    var maxAllowedQty = performabalQty + OrginalQty;

                    if (newQty > maxAllowedQty)
                    {
                        SubVM.Qty = maxAllowedQty;
                         SubVM.DbBalQty = SubVM.Qty.Value;
                        await _JS.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                         SubVM.DbBalQty = SubVM.Qty.Value;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                     SubVM.DbBalQty = SubVM.Qty.Value;
                }
            }

            await _calculationService.UpdateTotalsAsync(SubConInvVMs);

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OnQtyChange failed for SCNSubId: {SubVM?.InvSubId}");
            await _JS.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    #endregion

    #region Row Operations

    private async Task<bool> ValidateRowAsync(SubConInvSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (row.Qty == null || row.Qty <= 0)
                errors.Add("Quantity must be greater than 0.");

            if (row.UnitPrice == null || row.UnitPrice <= 0)
                errors.Add("Unit Price must be greater than 0.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _JS.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = SubConInvVMs.SubConInvSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task SaveRow(SubConInvSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            await ResetSlno();
            await _calculationService.UpdateTotalsAsync(SubConInvVMs);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for InvSubId: {item?.InvSubId}");
            await _JS.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(SubConInvSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItem == null && item.ItemId > 0)
            {
                item.SelectedItem = await subConInvService.GetItemByItemIdAsync(item.ItemId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for InvSubId: {item?.InvSubId}");
            await _JS.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(SubConInvSubVM? item, SubConInvVM? parentPerforma)
    {
        try
        {
            if (item == null || parentPerforma == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0) ||
                (!item.UnitPrice.HasValue || item.UnitPrice.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentPerforma.SubConInvSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for PerformaSubId: {item?.InvSubId}");
            await _JS.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(SubConInvSubVM item)
    {
        try
        {
            if (SubConInvVMs.SubConInvSubVMs.Count == 1 && item.InvSubId > 0)
            {
                await _JS.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if (SubConInvVMs.InvTally || SubConInvVMs.GrandTotal!=SubConInvVMs.Balance)
            {
                await _JS.ToastrError("Deletion not allowed. Payments have already been processed for this Purchase Invoice.");
                return;

            }
            bool exist = false;
            foreach (var refId in SubConInvVMs.SubConInvSubVMs)
            {
                exist = await subConInvService.HasAnyItemOrInvoiceDebitNoteAsync(refId.InvSubId);
                if (exist)
                {
                    await _JS.ToastrWarning("Cannot remove this invoice. Debit Note already exists for this invoice or its items.");
                    return;
                }
            }

            if (item.ItemId == 0)
            {
                SubConInvVMs.SubConInvSubVMs.Remove(item);
                await _JS.ToastrSuccess("New item row removed successfully.");

                if (!SubConInvVMs.SubConInvSubVMs.Any())
                    SubConInvVMs.SubConInvSubVMs = new List<SubConInvSubVM>();

                await ResetSlno();
                await _calculationService.UpdateTotalsAsync(SubConInvVMs);
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for PerformaSubId: {item?.InvSubId}");
            await _JS.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in SubConInvVMs.SubConInvSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _JS.ToastrError("Failed to reset row serial numbers.");
        }
    }

    #endregion

    #region Modal Handlers
    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "Vendor" => "Add New Vendor",
                "Item" => "Add New Item",
                "Attachments" => "Attached Drawings",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            if (ActiveModal == "Attachments")
            {
                AttachItemSelected = null;
            }

            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type in PurchasInvoiceUpsert: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal in PurchasInvoiceUpsert. Please try again.");
        }
    }

    private async Task Cancel()
    {
        try
        {
            if (IsSomeItemsTransMade)
            {
                await _JS.ToastrWarning("Some Items Transaction Are Made!.. You Can't Cancel the Complete purchase Invoice");
                return;
            }

            // If ANY item is already cancelled → stop GRN cancel
            if (SubConInvVMs.SubConInvSubVMs.Any(s => s.ItemCancel))
            {
                await _JS.ToastrWarning("Invoice cannot be cancelled — one or more items are already cancelled.");
                return;
            }
            bool exist = false;
            foreach (var refId in SubConInvVMs.SubConInvSubVMs)
            {
                exist = await subConInvService.HasAnyItemOrInvoiceDebitNoteAsync(refId.InvSubId);
                if (exist)
                {
                    await _JS.ToastrWarning("Cannot cancel this invoice. Debit Note already exists for this invoice or its items.");
                    return;
