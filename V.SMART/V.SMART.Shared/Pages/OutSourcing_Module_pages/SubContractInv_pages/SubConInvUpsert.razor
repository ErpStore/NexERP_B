    private async Task UpsertPurchaseInvoice()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            SubConInvVMs.SubConInvSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (!x.Qty.HasValue || x.Qty == 0) &&
                (!x.UnitPrice.HasValue || x.UnitPrice == 0));

            if (!SubConInvVMs.SubConInvSubVMs.Any())
            {
                await _JS.ToastrError("Cannot save a Purchase-Invoice without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in SubConInvVMs.SubConInvSubVMs)
            {
                bool isValid = await ValidateSCNLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewInv = SubConInvVMs.InvId == 0;

            @if (isNewInv)
            {
                bool isDuplicate = await subConInvService.IsDuplicateInvoiceAsync(SubConInvVMs.InvNo, SubConInvVMs.Suffix, SubConInvVMs.InvId, SubConInvVMs.VendorCode);
                if (isDuplicate)
                {
                    await _JS.ToastrError($"Purchase invoice No '{SubConInvVMs.InvNo}' with Suffix '{SubConInvVMs.Suffix}' already exists.");
                    return;
                }
            }

            try
            {
                await subConInvService.UpsertPurchaseInvoice(SubConInvVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _JS.ToastrError(ex.Message);
                return;
            }

            if (isNewInv)
                await _JS.ToastrSuccess("SubContract Invoice saved successfully.");
            else
                await _JS.ToastrSuccess("SubContract Invoice updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigation.NavigateTo("/subConInvList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertSubContractInvoice failed.");
            await _JS.ToastrError("Error saving SubContract Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateSCNLineAsync(SubConInvSubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _JS.ToastrWarning("One or more items are missing Item selection.");
                return false;
            }

            if (!line.Qty.HasValue || line.Qty <= 0)
            {
                await _JS.ToastrWarning($"Item {line.ItemCode}: Quantity must be greater than 0.");
                return false;
            }

            if (!line.UnitPrice.HasValue || line.UnitPrice <= 0)
            {
                await _JS.ToastrWarning($"Item {line.ItemCode}: Unit Price must be greater than 0.");
                return false;
            }

            decimal cgst=0,sgst=0,igst=0,lcgst=0,lsgst=0,ligst=0;

            decimal.TryParse(SubConInvVMs.CGstRate.ToString(),out cgst);
            decimal.TryParse(SubConInvVMs.SGstRate.ToString(),out sgst);
            decimal.TryParse(SubConInvVMs.IGstRate.ToString(),out igst);

            decimal.TryParse(line.LineCGSTRate.ToString(),out lcgst);
            decimal.TryParse(line.LineSGSTRate.ToString(),out lsgst);
            decimal.TryParse(line.LineIGSTRate.ToString(),out ligst);

            bool isCGST_SGST_Zero = (cgst + lcgst) == 0 &&  (sgst + igst) == 0;

            bool isIGST_Zero =(igst + ligst) == 0;

            if (!SelectedVendor.TaxValidate && (isCGST_SGST_Zero && isIGST_Zero))
            {
                await _JS.ToastrWarning("Please verify tax rates. Item-wise CGST/SGST/IGST cannot be empty or zero.");
                return false;
            }


            // Qty vs Enquiry / Already Transacted validation
            if (line.InvSubId == 0 && line.RefSCNSubId > 0)
            {
                var SCNSubBalQty = await subConInvService.GetSCNItemInvoiceBalQtyFromSCNSubId(line.RefSCNSubId.Value);
                SCNSubBalQty = SubConInvVMs.IsAcptRejRewQtyRequired ? (SCNSubBalQty +line.RejectQty.GetValueOrDefault()+line.ReworkQty.GetValueOrDefault()) : SCNSubBalQty;
                if (line.Qty > SCNSubBalQty)
                {
                    line.Qty = SCNSubBalQty;
                    await _JS.ToastrWarning($"Qty cannot exceed Purchase SCN Balance Qty ({SCNSubBalQty}).");
                    return false;
                }
            }
            else if (line.InvSubId > 0)
            {
                var original = await subConInvService.GetInvSubItemDetailByInvSubIdAsync(line.InvSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty.GetValueOrDefault();
                    decimal origQty = original.Qty.GetValueOrDefault();
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.Qty < alreadyTransacted)
                    {
                        line.Qty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _JS.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                        return false;
                    }
                    else
                    {
                        var difference = line.Qty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateSCNLineAsync failed.");
            await _JS.ToastrError("Error Validate Purchase-SCN line.");
            return false;
        }
    }

