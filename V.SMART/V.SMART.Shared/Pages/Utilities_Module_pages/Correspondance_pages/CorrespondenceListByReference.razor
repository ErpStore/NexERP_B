@page "/correspondence/by-reference"
@using V.SMART.Shared.Data.Utilities.Correspondence

@inherits BaseUserRightsComponent

@inject NavigationManager _nav
@inject ILoggingService _logs
@inject IUnitOfWork _unitOfWork
@inject IJSRuntime _js
@inject CurrentUserService _userService
@inject IFileOpener fileOpener
@inject IFileUploadService fileUpload

<BsModal OnModalConfirmation="confirmDelete_Click"
         ButtonBootstrapStyle="btn-danger"
         ButtonText="Delete"
         Title="Are you sure you want to delete this File?">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-0">

            @if (!isModelVisible)
            {
                <!-- Card Header -->
                <div class="card-header text-white rounded-top py-3 px-4" style="background: #6b2220; font-family: Georgia;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                        <!-- Breadcrumbs -->
                        <nav aria-label="breadcrumb" class="mb-0">
                            <ol class="breadcrumb mb-0 bg-transparent p-0 align-items-center">
                                <li class="breadcrumb-item d-flex align-items-center">
                                    <i class="bi bi-house-door-fill me-1 text-warning"></i>
                                    <a href="/" class="text-white text-decoration-none fw-semibold">Home</a>
                                </li>
                                <li class="px-2 text-warning"><i class="bi bi-arrow-right"></i></li>
                                <li class="breadcrumb-item text-white fw-semibold">Utilities</li>
                                <li class="px-2 text-warning"><i class="bi bi-arrow-right"></i></li>
                                <li class="breadcrumb-item active fw-bold text-white" aria-current="page">Correspondence</li>
                            </ol>
                        </nav>

                        <!-- Title Badge -->
                        <h5 class="mb-0 fw-bold">
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                <i class="bi bi-link-45deg me-2"></i>
                                Linked Correspondence - <span class="text-info">@refType</span> /
                                ID: <span class="text-info">@refId</span> /
                                Name: <span class="text-info">@refName</span>
                            </span>
                        </h5>

                    </div>
                </div>
            }


            <!-- Card Body -->
            <div class="card-body">

                @if (isLoading)
                {
                    <div class="text-center text-muted py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-3">Loading correspondence...</p>
                    </div>
                }

                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-sm align-middle">
                        <thead class="custom-blue">
                            <tr>
                                <th style="width:130px"><i class="bi bi-file-earmark-text me-1"></i> File Name</th>
                                <th style="width:180px">Reference Type Name</th>
                                @if (refType == "Item")
                                {
                                    <th style="width:100px">Part-Weight</th>
                                    <th style="width:100px">Total-Area</th>
                                    <th style="width:100px">Length</th>
                                    <th style="width:100px">Width</th>
                                    <th style="width:300px">Process</th>
                                }

                                <th style="width:300px">Remarks</th>
                                <th style="width:130px">Uploaded On</th>
                                <th style="width:130px">Uploaded By</th>
                                <th class="text-end" style="width:80px">Action</th>
                            </tr>
                        </thead>
                        <tbody class="custom-size">
                            @if (CorrespondenceList.Any())
                            {
                                @foreach (var item in CorrespondenceList)
                                {
                                    <tr>
                                        <td>
                                            <a class="btn btn-sm btn-outline-success"
                                               @onclick="() => OpenFile(item)"
                                               title="Open File">
                                                @item.FileName
                                            </a>
                                        </td>
                                        <td>@item.ReferenceTypeName</td>
                                        @if (refType == "Item")
                                        {
                                            <td>@PartWeight</td>
                                            <td>@TotalArea</td>
                                            <td>@Length</td>
                                            <td>@Width</td>
                                            <td>@Process</td>
                                        }
                                        <td>@item.Remarks</td>
                                        <td>@item.UploadedOn?.ToString("g")</td>
                                        <td>@item.UploadedBy</td>
                                        <td style="width:80px;">
                                            <div class="d-flex justify-content-end">
                                                <div class="btn-group" role="group" aria-label="File actions">
                                                    @if (!isModelVisible)
                                                    {
                                                        @if (CanEdit)
                                                        {
                                                            <a class="btn btn-sm btn-outline-primary"
                                                               href="@($"/correspondence/update/{item.Id}")"
                                                               title="Edit this file"
                                                               aria-label="Edit File">
                                                                <i class="bi bi-pencil-square"></i>
                                                            </a>
                                                        }
                                                        @if (CanDelete)
                                                        {
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                    @onclick="() => HandleDelete(item.Id)"
                                                                    title="Delete this file"
                                                                    aria-label="Delete File">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }

                                                    }


                                                </div>
                                            </div>
                                        </td>


                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted fst-italic py-4">
                                        <i class="bi bi-info-circle me-1"></i> No correspondence found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer Buttons -->
                <div class="row mt-4 align-items-center justify-content-between">

                    @if (!isModelVisible)
                    {
                        @if (CanCreate)
                        {
                            <div class="col-12 col-md-auto mb-2 mb-md-0">
                                <a class="btn btn-success btn-sm rounded-pill w-100 w-md-auto"
                                   href="@($"/correspondence/upload?refType={refType}&refId={refId}&refName={refName}&docType={docType}")">
                                    <i class="bi bi-plus-circle me-1"></i> Upload New Correspondence
                                </a>
                            </div>
                        }
                        <div class="col-12 col-md-auto">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill w-100 w-md-auto"
                                    @onclick="NavigateBack"
                                    disabled="@isLoading">
                                <i class="bi bi-arrow-left me-1"></i> Back
                            </button>
                        </div>
                    }


                </div>

            </div>
        </div>
    </div>
}

@code {
    protected override string ScreenName => "Correspondences";

    [Parameter]
    public bool isModelVisible { get; set; } = false;

    private List<Correspondence> CorrespondenceList = new();
    private int CorresIdToDelete = 0;
    private bool isLoading = true;
    private bool isProcessing = true;

    [Parameter, SupplyParameterFromQuery]
    public string refType { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public int refId { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public string refName { get; set; }

    [Parameter, SupplyParameterFromQuery]
    public string docType { get; set; }

    public decimal PartWeight { get; set; }
    public decimal TotalArea { get; set; }
    public decimal Length { get; set; }
    public decimal Width { get; set; }
    public string Process { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _nav.NavigateTo("/access-denied");
                return;
            }

            if (!string.IsNullOrWhiteSpace(refType) && refId > 0 && !string.IsNullOrWhiteSpace(refName))
            {
                var data = await _unitOfWork.Correspondances.FindAsync(c =>
                    c.ReferenceType == refType &&
                    c.ReferenceId == refId &&
                    c.ReferenceTypeName == refName &&
                    c.DocumentType == docType);

                CorrespondenceList = data?.ToList() ?? new();

                if (refType == "Item")
                {
                    var item = await _unitOfWork.ItemRepositories.GetQueryable().FirstOrDefaultAsync(x => x.ItemId == refId);
                    if (item != null)
                    {
                        PartWeight = item.PartWeight;
                        TotalArea = item.TotalArea;
                        Length = item.Length;
                        Width = item.Width;
                        Process = item.Remarks;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error initializing Correspondence Reference List page.");
        }
        finally
        {
            isProcessing = false;
            isLoading = false;
        }
    }

    private async Task HandleDelete(int id)
    {
        try
        {
            CorresIdToDelete = id;
            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "HandleDelete() failed.");
            await _js.ToastrError("Error preparing delete operation.");
        }
    }

    private async Task confirmDelete_Click(bool isConfirmed)
    {
        await _js.InvokeVoidAsync("HideConfirmationModal");

        if (!isConfirmed || CorresIdToDelete == 0)
        {
            CorresIdToDelete = 0;
            return;
        }

        isProcessing = true;

        try
        {
            var corres = await _unitOfWork.Correspondances.GetAsync(CorresIdToDelete);

            if (corres == null)
            {
                await _js.ToastrError("Correspondence not found.");
                return;
            }

            if (!string.IsNullOrWhiteSpace(corres.FilePath))
            {
                await fileUpload.DeleteFileAsync(corres.FilePath);
            }

            var deleted = await _unitOfWork.Correspondances.DeleteAsync(CorresIdToDelete);

            if (deleted)
            {
                await _unitOfWork.SaveAsync();

                await _logs.LogUserAction(
                    await _userService.GetUsernameAsync(),
                    _userService.MachineName,
                    _userService.IpAddress,
                    "Correspondence",
                    $"Deleted: {corres.FileName}",
                    $"Filename: {corres.FileName}");

                await _js.ToastrSuccess($"'{corres.FileName}' deleted successfully.");
                CorrespondenceList.RemoveAll(x => x.Id == CorresIdToDelete);
            }
            else
            {
                await _js.ToastrError($"Failed to delete '{corres.FileName}'.");
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "confirmDelete_Click() failed.");
            await _js.ToastrError("Error occurred during deletion.");
        }
        finally
        {
            isProcessing = false;
            CorresIdToDelete = 0;
            StateHasChanged();
        }
    }

    private async Task OpenFile(Correspondence CorrespondenceList)
    {
      // await fileOpener.OpenAsync(filePath);
        if (CorrespondenceList.Image == null || CorrespondenceList.Image.Length == 0)
            return;

        ///var base64 = Convert.ToBase64String(CorrespondenceList.Image);

        await fileOpener.OpenAsync(CorrespondenceList.Image, CorrespondenceList.FileName, CorrespondenceList.FileType);

        // await _js.InvokeVoidAsync(
        //     "openFile",
        //     base64,
        //     CorrespondenceList.FileType);

       // await _js.InvokeVoidAsync("open", dataUrl, "_blank");
    }

    private void NavigateBack()
    {
        //Simple Switch Cases
        var url = refType switch
        {
            "Category" => $"category/update/{refId}",
            "Customer" => $"customer/update/{refId}",
            "Machine" => $"machine/update/{refId}",
            "Item" => $"item/update/{refId}",
            "Raw-Material" => $"rawMaterial/update/{refId}",
            "Stores" => $"store/update/{refId}",
            "Factors" => $"factor/update/{refId}",
            "Expenses" => $"expense/update/{refId}",
            "Income" => $"income/update/{refId}",
            "Banks" => $"bank/update/{refId}",
            "Currencies" => $"currency/update/{refId}",
            "Vendors" => $"vendor/update/{refId}",
            "CompanyDetails" => $"myCompany/update/{refId}",
            "CostCenter" => $"costCenter/update/{refId}",
            "Employee" => $"employee-details/update/{refId}",
            "EnquirySales" => $"enquirysales/update/{refId}",
            "Manufacturing-Quotation" => $"MfgQuote/update/{refId}",
            "Performa-Invoice" => $"PerformaInv/update/{refId}",
            "Manufacturing-PO" => $"MfgPo/update/{refId}",
            "Manufacturing-Dc" => $"MfgDc/update/{refId}",
            "Manufacturing Invoice" => $"mfgInv/update/{refId}",
            "Export Invoice" => $"expInv/update/{refId}",


            "Stock-Addition" => $"scnGen/update/{refId}",
            "Stock-Issue" => $"minIss/update/{refId}",

            "ToolCribIssue" => $"tci/update/{refId}",
            "ToolCribReturn" => $"tcr/update/{refId}",

            "Job Order" => $"jobOrder/update/{refId}",
            "Production Issue Assembly" => $"productionIssueAssy/update/{refId}",
            "Production Return Assembly" => $"productionReturnAssy/update/{refId}",
            "Production SCN Assembly" => $"productionAssyScn/update/{refId}",

            "EnquiryFeasibility" => $"enquiryFeasibility/update/{refId}",

            "Material Requisition" => $"materialRequisition/update/{refId}",
            "Enquiry Purchase" => $"enquiryPurchase/update/{refId}",
            "Purchase-Quotation" => $"PurchaseQuote/update/{refId}",
            "Purchase Order" => $"PurchPO/update/{refId}",
            "Purchase GRN" => $"purchaseGRN/update/{refId}",
            "Purchase SCN" => $"purchaseSCN/update/{refId}",
            "Purchase Invoice" => $"purchaseInvoice/update/{refId}",
            "Route Card" => $"routeCard/update/{refId}",

            "Credit Note" => $"creditNote/update/{refId}",
            "Labour-Invoice" => $"LabourInvoice/update/{refId}",
            "Labour-GRN" => $"labourGRN/update/{refId}",
            "Labour-SCN" => $"labourSCN/update/{refId}",
            "Labour-DcOutgoing" => $"labourDcOutgoing/update/{refId}",
            "Sub-Contract SCN" => $"DcSubConSCN/update/{refId}",
            "Sub-Contract Invoice" => $"DcSubConIncomingInvoice/update/{refId}",
            "Sub-Contrect GRN" => $"DcSubConIncoming/update/{refId}",
            "Sub-Contract DC-Out" => $"DcSubConOutgoing/update/{refId}",




            _ => null
        };


        if (!string.IsNullOrEmpty(url))
        {
            _nav.NavigateTo(url);
        }
    }
}
