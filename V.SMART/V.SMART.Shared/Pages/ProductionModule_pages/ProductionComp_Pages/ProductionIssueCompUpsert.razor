    private async Task OnRcSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (ProductionIssueCompVMs.ProductionIssueCompSubVMs == null)
            ProductionIssueCompVMs.ProductionIssueCompSubVMs = new List<ProductionIssueCompSubVM>();

        try
        {
            // ============================================
            // STEP 1: COLLECT ALL ITEM IDs (OUT ITEMS)
            // ============================================
            var allItemIds = selectedItems
                .Where(x => x.GetValueOrDefault("ItemIdOut") != null)
                .Select(x => Convert.ToInt32(x["ItemIdOut"]))
                .Where(x => x > 0)
                .Distinct()
                .ToList();

            // ============================================
            // STEP 2: GET BULK UNIT PRICES
            // ============================================
            var unitPriceDict = await productionIssueCompService.GetBulkLastUnitPricesAsync(
                allItemIds,
                ProductionIssueCompVMs.CustId
            );

            // ============================================
            // MAIN LOOP
            // ============================================
            foreach (var item in selectedItems)
            {
                int? rcSubId = item.GetValueOrDefault("RcSubId") != null
                    ? Convert.ToInt32(item["RcSubId"])
                    : (int?)null;

                if (!rcSubId.HasValue)
                    continue;

                // QtyPerUnit (COMMON)
                decimal qtyPerUnit = item.GetValueOrDefault("QtyPerUnit") != null
                    ? Convert.ToDecimal(item["QtyPerUnit"])
                    : 0;

                decimal stockQty = item.GetValueOrDefault("StockQty") != null
                  ? Convert.ToDecimal(item["StockQty"])
                  : 0;
                // =====================================================
                // IN ITEM
                // =====================================================
                int itemIdIn = item.GetValueOrDefault("ItemIdIn") != null
                    ? Convert.ToInt32(item["ItemIdIn"])
                    : 0;

                if (itemIdIn > 0 &&
                    !ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any(x =>
                        x.ItemId == itemIdIn &&
                        x.RcSubId == rcSubId &&
                        x.TransType == "In"))
                {
                    decimal qtyIn = item.GetValueOrDefault("QtyIn") != null
                        ? Convert.ToDecimal(item["QtyIn"])
                        : 0;

                    // Apply QtyPerUnit
                    decimal finalQtyIn = qtyPerUnit > 0 ? qtyIn * qtyPerUnit : qtyIn;

                    decimal InQty = Math.Min(finalQtyIn, stockQty);

                    ProductionIssueCompVMs.ProductionIssueCompSubVMs.Add(
                        new ProductionIssueCompSubVM
                        {
                            TransType = "In",
                            RcSubId = rcSubId.Value,

                            RcNo = item.GetValueOrDefault("RefRCNo")?.ToString() ?? "",
                            RcDate = item.GetValueOrDefault("RefRCDate") != null
                                ? Convert.ToDateTime(item["RefRCDate"])
                                : null,

                            ItemId = itemIdIn,
                            ItemCode = item.GetValueOrDefault("ItemCodeIn")?.ToString() ?? "",
                            ItemName = item.GetValueOrDefault("ItemNameIn")?.ToString() ?? "",
                            MeasureUnit = item.GetValueOrDefault("MeasureUnitIn")?.ToString() ?? "",

                            Qty = InQty,
                            BalQty = InQty,
                            QtyPerUnit = qtyPerUnit,

                            ProcessId = item.GetValueOrDefault("ProcessId") != null
                                ? Convert.ToInt32(item["ProcessId"])
                                : (int?)null,

                            ProcessName = item.GetValueOrDefault("ProcessName")?.ToString() ?? "",

                            MachineId = item.GetValueOrDefault("MachineId") != null
                                ? Convert.ToInt32(item["MachineId"])
                                : (int?)null,

                            MachineName = item.GetValueOrDefault("MachineName")?.ToString() ?? "",

                            ProcessCost = item.GetValueOrDefault("ProcessCost") != null
                                ? Convert.ToDecimal(item["ProcessCost"])
                                : 0,

                            UnitPrice = item.GetValueOrDefault("UnitPrice") != null
                                ? Convert.ToDecimal(item["UnitPrice"])
                                : 0,

                            CostId = item.GetValueOrDefault("CostCenterId") != null &&
                                     Convert.ToInt32(item["CostCenterId"]) != 0
                                ? Convert.ToInt32(item["CostCenterId"])
                                : (int?)null,

                            ProjectNo = item.GetValueOrDefault("CostCenter")?.ToString() ?? "",
                            IsEditable = true
                        });
                }

                // =====================================================
                // OUT ITEM
                // =====================================================
                int itemIdOut = item.GetValueOrDefault("ItemIdOut") != null
                    ? Convert.ToInt32(item["ItemIdOut"])
                    : 0;

                if (itemIdOut > 0 &&
                    !ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any(x =>
                        x.ItemId == itemIdOut &&
                        x.RcSubId == rcSubId &&
                        x.TransType == "Out"))
                {
                    decimal qtyOut = item.GetValueOrDefault("QtyOut") != null
                        ? Convert.ToDecimal(item["QtyOut"])
                        : 0;

                    decimal stockQty1 = item.GetValueOrDefault("StockQty") != null
                                   ? Convert.ToDecimal(item["StockQty"])
                                   : 0;

                    // Apply QtyPerUnit
                    decimal calculatedQtyOut = qtyPerUnit > 0 ? qtyOut * qtyPerUnit : qtyOut;

                    decimal issueQty = Math.Min(calculatedQtyOut, stockQty1);
                    // UNIT PRICE FROM BULK METHOD
                    decimal unitPrice = unitPriceDict.TryGetValue(itemIdOut, out var price)
                        ? price
                        : 0;


                    ProductionIssueCompVMs.ProductionIssueCompSubVMs.Add(
                        new ProductionIssueCompSubVM
                        {
                            TransType = "Out",
                            RcSubId = rcSubId.Value,

                            RcNo = item.GetValueOrDefault("RefRCNo")?.ToString() ?? "",
                            RcDate = item.GetValueOrDefault("RefRCDate") != null
                                ? Convert.ToDateTime(item["RefRCDate"])
                                : null,

                            ItemId = itemIdOut,
                            ItemCode = item.GetValueOrDefault("ItemCodeOut")?.ToString() ?? "",
                            ItemName = item.GetValueOrDefault("ItemNameOut")?.ToString() ?? "",
                            MeasureUnit = item.GetValueOrDefault("MeasureUnitOut")?.ToString() ?? "",

                            Qty = issueQty,
                            BalQty = issueQty,
                            QtyPerUnit = qtyPerUnit,

                            ProcessId = item.GetValueOrDefault("ProcessId") != null
                                ? Convert.ToInt32(item["ProcessId"])
                                : (int?)null,

                            ProcessName = item.GetValueOrDefault("ProcessName")?.ToString() ?? "",

                            MachineId = item.GetValueOrDefault("MachineId") != null
                                ? Convert.ToInt32(item["MachineId"])
                                : (int?)null,

                            MachineName = item.GetValueOrDefault("MachineName")?.ToString() ?? "",

                            UnitPrice = unitPrice,
                            StockQty = stockQty,

                            CostId = item.GetValueOrDefault("CostCenterId") != null &&
                                     Convert.ToInt32(item["CostCenterId"]) != 0
                                ? Convert.ToInt32(item["CostCenterId"])
                                : (int?)null,

                            ProjectNo = item.GetValueOrDefault("CostCenter")?.ToString() ?? "",
                            IsEditable = true
                        });

                    //IsBOM True 
                    //vivek 19/052026
                    var bomData = await productionIssueCompService.GetBOMAssemblyItems(itemIdOut, Convert.ToInt32(item["ProcessId"]), ProductionIssueCompVMs.StoreIssId.Value);
                    if (bomData != null && bomData.Any())
                    {
                        IsBOM = true;
                        foreach (var bomitem in bomData)
                        {
                            decimal calbomQty = (bomitem.UtilQty) > 0 ? (qtyOut * (bomitem.UtilQty)): qtyOut;

                            decimal issuebomQty = Math.Min(calbomQty, bomitem.BomStockQty);

                            ProductionIssueCompVMs.ProductionIssueCompSubVMs.Add(
                            new ProductionIssueCompSubVM
                            {
                                TransType = "Out",
                                //RcSubId = rcSubId.Value,

                                RcNo = item.GetValueOrDefault("RefRCNo")?.ToString() ?? "",
                                RcDate = item.GetValueOrDefault("RefRCDate") != null
                                    ? Convert.ToDateTime(item["RefRCDate"])
                                    : null,

                                ItemId = bomitem.ItemId,
                                ItemCode = bomitem.PartItemCode ?? "",
                                ItemName = bomitem.PartItemName ?? "",
                                MeasureUnit = bomitem.UOM ?? "",

                                Qty = issuebomQty,
                                BalQty = issuebomQty,
                                QtyPerUnit = bomitem.UtilQty,

                                ProcessId = item.GetValueOrDefault("ProcessId") != null
                                    ? Convert.ToInt32(item["ProcessId"])
                                    : (int?)null,

                                ProcessName = item.GetValueOrDefault("ProcessName")?.ToString() ?? "",

                                MachineId = item.GetValueOrDefault("MachineId") != null
                                    ? Convert.ToInt32(item["MachineId"])
                                    : (int?)null,

                                MachineName = item.GetValueOrDefault("MachineName")?.ToString() ?? "",

                                UnitPrice = unitPrice,
                                StockQty = bomitem.BomStockQty,

                                CostId = item.GetValueOrDefault("CostCenterId") != null &&
                                        Convert.ToInt32(item["CostCenterId"]) != 0
                                    ? Convert.ToInt32(item["CostCenterId"])
                                    : (int?)null,

                                ProjectNo = item.GetValueOrDefault("CostCenter")?.ToString() ?? "",
                                IsEditable = true
                            });
                        }
                    }else
                    {
                        IsBOM = false;
                    }
                    ///////////////////////////////////////////

                }
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "OnRcSelectedAsync failed in Production Issue Assembly.");
            await _JS.ToastrError("Error processing selected items in Production Issue.");
        }
    }
