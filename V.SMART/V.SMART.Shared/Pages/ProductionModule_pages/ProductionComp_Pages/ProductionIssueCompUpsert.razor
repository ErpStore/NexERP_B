    #region Cancel And Short-Close

    private async Task Cancel()
    {
        try
        {
            if (IssueId.GetValueOrDefault() == 0)
            {
                await _JS.ToastrError("Save the Subcontract DC Outgoing first.");
                return;
            }
            bool trans = await productionIssueCompService.IsProductionTransactionsMatchedwilecancelAsync(ProductionIssueCompVMs.IssueId,ProductionIssueCompVMs);

            if (trans)
            {
                await _JS.ToastrWarning("Some Items Transaction Are Made!.. You Can't Cancel the Complete Subcontract DC");
                return;
            }


            if (ProductionIssueCompVMs.ShortClose)
            {
                await _JS.ToastrError("Delivery Challan is already short closed. You can't cancel it.");
                return;
            }

            // If ANY item is already cancelled → stop GRN cancel
            if (ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any(s => s.ItemCancel))
            {
                await _JS.ToastrWarning("DC cannot be cancelled — one or more items are already cancelled.");
                return;
            }

            if(ProductionIssueCompVMs.Cancel)
            {
                var subs = await productionIssueCompService.GetProductionComSubDetailsByIssueIdAsync(ProductionIssueCompVMs.IssueId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    if(sub.TransType =="In")
                    {
                        if(sub.RefPoSubId.GetValueOrDefault() > 0  && !IsLabourGRNLink)
                        {
                            await productionIssueCompService.ValidatePoBalanceBeforeRevertAsync(sub);
                        }
                        if(sub.RcSubId.GetValueOrDefault() > 0)
                        {
                            await productionIssueCompService.ValidateRcBalanceBeforeRevertAsync(sub);
                        }
                        if(sub.RefGRNSubId.GetValueOrDefault()>0 && IsLabourGRNLink)
                        {
                            await productionIssueCompService.ValidateLabGrnBalanceBeforeRevertAsync(sub);
                        }
                    }
                }
            }

            if (!ProductionIssueCompVMs.Cancel)
            {
                ModalTitle = "Are you sure you want to Cancel this Delivery Challan?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this Delivery Challan?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            ProductionIssueCompVMs = await productionIssueCompService.GetProductionByIssueIdAsync(IssueId.Value);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while processing the Subcontract Delivery Challan .Cancel method");
            await LoggingService.LogDeveloperError(ex, "Error in Subcontract Delivery Challan Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task AskToShortCloseAsync(ProductionIssueCompVM subConDcOutVMs)
    {
        try
        {
            if (subConDcOutVMs == null)
            {
                await _JS.ToastrError("Invalid Delivery Challan selected.");
                return;
            }

            if (!IssueId.HasValue || IssueId == 0)
            {
                await _JS.ToastrError("Delivery challan Short Close is not allowed before saving the Delivery Challan.");
                return;
            }

            if (subConDcOutVMs.IssueTally)
            {
                await _JS.ToastrWarning("This Delivery Challan is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (subConDcOutVMs.Cancel)
            {
                await _JS.ToastrWarning("This Delivery Challan is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!subConDcOutVMs.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Delivery Challan?";
                btnText = "Short Close";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Delivery Challan?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while AskToShortCloseAsync Delivery Challan.");
            await LoggingService.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

