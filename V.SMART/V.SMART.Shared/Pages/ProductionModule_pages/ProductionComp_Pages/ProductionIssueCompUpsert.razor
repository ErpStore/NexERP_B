    private async Task<bool> CheckIsTransMade()
    {
        try
        {
            var list = ProductionIssueCompVMs?.ProductionIssueCompSubVMs;
            if (list == null || list.Count == 0)
                return false;

            decimal totalQty = 0, totalBalQty = 0;

            for (int i = 0; i < list.Count; i++)
            {
                totalQty += list[i].Qty ?? 0;
                totalBalQty += list[i].BalQty ?? 0;
            }

            return totalQty != totalBalQty;

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "CheckIsTransMade failed.");
            return false;
        }
    }



