    private async Task OnItemChanged(ProductionIssueCompSubVM subitem, ItemVM? item)
    {
        try
        {
            if (item != null)
            {
                subitem.SelectedItem = item;
                subitem.ItemId = item.ItemId;
                subitem.ItemCode = item.ItemCode;
                subitem.ItemName = item.ItemName;
                subitem.MeasureUnit = item.MeasureUnit;
                subitem.CategoryCode = item.CategoryCode??0;
                subitem.Category = item.CategoryName;

                // 1️⃣ Last Unit Price
                if (subitem.ItemId.HasValue)
                {
                    var rates = await productionIssueCompService
                        .GetBulkLastUnitPricesAsync(
                            new List<int> { subitem.ItemId.Value },
                            ProductionIssueCompVMs?.CustId);

                    if (rates.TryGetValue(subitem.ItemId.Value, out var rate))
                    {
                        subitem.UnitPrice = rate;
                    }
                    else
                    {
                        subitem.UnitPrice = 0;
                    }
                }

                // 2️⃣ Stock Qty (IMPORTANT)
                if (subitem.ItemId.HasValue)
                {
                    subitem.StockQty = await productionIssueCompService.GetStockForItemsAsync(subitem.ItemId.Value,ProductionIssueCompVMs.StoreIssId.Value);
                }

                // 3️⃣ Attachments
                if (subitem.ItemId > 0)
                {
                    var count = await productionIssueCompService
                        .GetCorrespondenceAttachmentsCountAsync(
                            subitem.ItemId.Value, "Item");

                    attachmentCounts[subitem.ItemId.Value] = count;
                }
                // Manual + In Row + Assembly
                if (subitem.TransType == "In" && ProductionIssueCompVMs.IsManual)
                {
                    await LoadBomChildren(subitem);
                }
            }
            else
            {
                // Reset on deselect
                subitem.SelectedItem = null;
                subitem.ItemId = null;
                subitem.ItemCode = null;
                subitem.ItemName = null;
                subitem.MeasureUnit = null;
                subitem.UnitPrice = 0;
                subitem.StockQty = 0;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                $"OnItemChanged failed for ItemId: {item?.ItemId}");

            await _JS.ToastrError(
                "Failed to apply item selection. Please try again.");
        }
    }

    private async Task LoadBomChildren(ProductionIssueCompSubVM parent)
    {
        if (parent == null)
            return;

        // Remove old child rows
        ProductionIssueCompVMs.ProductionIssueCompSubVMs.RemoveAll(x =>
            x.GroupId == parent.GroupId &&
            x.TransType == "Out");

        if (ProductionIssueCompVMs.IsOutItemSameAsInItem)
        {
            await AddSameItemChildAsync(parent);
        }
        // ================= ASSEMBLY / SUB-ASSEMBLY =================
        else if (string.Equals(parent.Category, "ASSEMBLY", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(parent.Category, "SUB-ASSEMBLY", StringComparison.OrdinalIgnoreCase))
        {
            var assemblyItems = await productionIssueCompService.GetAssemblyItemsAsync(parent.ItemId ?? 0);

            if (assemblyItems != null)
            {
                foreach (var assembly in assemblyItems)
                {
                    if (!assembly.ItemId.HasValue)
                        continue;

                    decimal stock = await productionIssueCompService.GetStockForItemsAsync(
                        assembly.ItemId.Value,
                        ProductionIssueCompVMs.StoreIssId ?? 0);

                    var rates = await productionIssueCompService.GetBulkLastUnitPricesAsync(
                        new List<int> { assembly.ItemId.Value },
                        ProductionIssueCompVMs?.CustId);

                    decimal unitRate = rates.TryGetValue(assembly.ItemId.Value, out var rate)
                        ? rate
                        : 0;

                    decimal qty = Math.Round(
                        assembly.UtilQty.GetValueOrDefault() * (parent.Qty ?? 0),
                        QTY_DECIMAL);

                    ProductionIssueCompVMs.ProductionIssueCompSubVMs.Add(
                        new ProductionIssueCompSubVM
                        {
                            TransType = "Out",
                            SelectedItem = await productionIssueCompService
                                .GetItemByItemIdAsync(assembly.ItemId.Value),

                            ItemId = assembly.ItemId,
                            ItemCode = assembly.PartItemCode,
                            ItemName = assembly.PartItemName,
                            MeasureUnit = assembly.UOM,

                            Qty = qty,
                            BalQty = qty,

                            StockQty = stock,
                            UnitPrice = unitRate,
                            IsEditable = false
                        });
                }
            }
        }
        // ================= COMPONENT =================
        else if (string.Equals(parent.Category, "COMPONENT", StringComparison.OrdinalIgnoreCase))
        {
            var compRM = await productionIssueCompService.GetDefaultRawMaterialItemAsync(parent.ItemId ?? 0);

            if (compRM?.RMId != null)
            {
                decimal stock = await productionIssueCompService.GetStockForItemsAsync(
                    compRM.RMId.Value,
                    ProductionIssueCompVMs.StoreIssId ?? 0);

                var rates = await productionIssueCompService.GetBulkLastUnitPricesAsync(
                    new List<int> { compRM.RMId.Value },
                    ProductionIssueCompVMs?.CustId);

                decimal unitRate = rates.TryGetValue(compRM.RMId.Value, out var rate)
                    ? rate
                    : 0;

                decimal qty = Math.Round(
                    compRM.Weight * (parent.Qty ?? 0),
                    QTY_DECIMAL);

                ProductionIssueCompVMs.ProductionIssueCompSubVMs.Add(
                    new ProductionIssueCompSubVM
                    {
                        TransType = "Out",
                        SelectedItem = await productionIssueCompService
                            .GetItemByItemIdAsync(compRM.RMId.Value),

                        ItemId = compRM.RMId.Value,
                        ItemCode = compRM.RMCode,
                        ItemName = compRM.RMName,
                        MeasureUnit = compRM.MeasureUnit,

                        Qty = qty,
                        BalQty = qty,

                        StockQty = stock,
                        UnitPrice = unitRate,
                        IsEditable = false
                    });
            }
        }

        await ResetSlno();
        StateHasChanged();

    }
    private async Task RecalculateBomQty(ProductionIssueCompSubVM parent)
    {
        if (parent == null || !parent.ItemId.HasValue)
            return;

        bool isAssembly =
            string.Equals(parent.Category, "ASSEMBLY", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(parent.Category, "SUB-ASSEMBLY", StringComparison.OrdinalIgnoreCase);

        bool isComponent =
            string.Equals(parent.Category, "COMPONENT", StringComparison.OrdinalIgnoreCase);

        if (!isAssembly && !isComponent)
            return;

        var children = ProductionIssueCompVMs
            .ProductionIssueCompSubVMs
            .Where(x =>
                x.GroupId == parent.GroupId &&
                x.TransType == "Out")
            .ToList();

        // ASSEMBLY / SUB-ASSEMBLY
        if (isAssembly)
        {
            var bom = await productionIssueCompService
                .GetAssemblyItemsAsync(parent.ItemId.Value);

            if (bom == null)
                return;

            foreach (var child in children)
            {
                var bomRow = bom.FirstOrDefault(x => x.ItemId == child.ItemId);

                if (bomRow != null)
                {
                    child.Qty = Math.Round(
                        bomRow.UtilQty.GetValueOrDefault() *
                        parent.Qty.GetValueOrDefault(),
                        QTY_DECIMAL);

                    child.BalQty = child.Qty;
                }
            }
        }
        // COMPONENT
        else if (isComponent)
        {
            var compRM = await productionIssueCompService
                .GetDefaultRawMaterialItemAsync(parent.ItemId.Value);

            if (compRM?.RMId == null)
                return;

            var child = children.FirstOrDefault(x => x.ItemId == compRM.RMId);

            if (child != null)
            {
                child.Qty = Math.Round(
                    compRM.Weight *
                    parent.Qty.GetValueOrDefault(),
                    QTY_DECIMAL);

                child.BalQty = child.Qty;
            }
        }

        StateHasChanged();
    }
