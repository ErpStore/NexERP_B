    private async Task CancelDc()
    {
        try
        {
            isProcessing = true;

            var username = await _userService.GetUsernameAsync();
            var machine = _userService.MachineName;
            var ip = _userService.IpAddress;

            if (!ProductionIssueCompVMs.Cancel)
            {
                ProductionIssueCompVMs.Cancel = true;
                ProductionIssueCompVMs.CancelReason = cancelReason;
                ProductionIssueCompVMs.CancelDate = DateTime.Now;
                ProductionIssueCompVMs.CancelBy = username;

                await productionIssueCompService.UpdatedCancelStatusAndAddOrRevertQty(ProductionIssueCompVMs, screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Production Delivery Challan",
                    action: $"Cancelled DC No: {ProductionIssueCompVMs.IssueNo}",
                    additionalInfo: $"Dc Id: {ProductionIssueCompVMs.IssueId}"
                );

                await _JS.ToastrSuccess("Delivery Challan cancelled successfully.");
            }
            else
            {
                ProductionIssueCompVMs.Cancel = false;
                ProductionIssueCompVMs.CancelReason = string.Empty;
                ProductionIssueCompVMs.CancelDate = null;
                ProductionIssueCompVMs.CancelBy = string.Empty;

                await productionIssueCompService.UpdatedCancelStatusAndAddOrRevertQty(ProductionIssueCompVMs, screenCode);

                await LoggingService.LogUserAction(
                    UserName: username,
                    Machine: machine,
                    IP_Address: ip,
                    screen: "Subcontract Delivery Challan",
                    action: $"Cancelled DC No: {ProductionIssueCompVMs.IssueNo}",
                    additionalInfo: $"Dc Id: {ProductionIssueCompVMs.IssueId}"
                );

                await _JS.ToastrSuccess("Delivery Challan has been reverted successfully.");
            }

            StateHasChanged();
        }
        catch (InvalidOperationException ex)
        {
            ProductionIssueCompVMs = await productionIssueCompService.GetProductionByIssueIdAsync(ProductionIssueCompVMs.IssueId);
            await _JS.ToastrWarning(ex.Message);
            await LoggingService.LogDeveloperError(ex, $"CancelDc failed for DcId: {ProductionIssueCompVMs.IssueId}");
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("An error occurred while cancelling/reverting the Subcontract DC.");
            await LoggingService.LogDeveloperError(ex, $"Cancel Subcontract DC failed for DcId: {ProductionIssueCompVMs.IssueId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

