                await _JS.ToastrWarning("This row cannot be deleted because some transactions are done.");
                return;
            }

            bool isBOM = await productionIssueCompService.IsBOMAsync(item.RcSubId.GetValueOrDefault(), item.ProcessId.GetValueOrDefault());

            if (isBOM && item.RcSubId.GetValueOrDefault()>0)
            {
                await _JS.ToastrWarning("Deletion not allowed.This item is linked to BOM and has existing transaction history.");
                return;
            }


