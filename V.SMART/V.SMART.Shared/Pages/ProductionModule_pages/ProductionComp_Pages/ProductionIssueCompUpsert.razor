    #region OnSameItemChanged

    private async Task OnSameItemChanged(ChangeEventArgs e)
    {
        bool isChecked = Convert.ToBoolean(e.Value);

        if (isChecked && ProductionIssueCompVMs.IsWithoutPoDc)
        {
            ProductionIssueCompVMs.IsOutItemSameAsInItem = false;

            await _JS.ToastrWarning("'Out Item Same as In Item' cannot be used when 'Without PO DcOut' is enabled.");
            return;
        }

        ProductionIssueCompVMs.IsOutItemSameAsInItem = isChecked;
    }

