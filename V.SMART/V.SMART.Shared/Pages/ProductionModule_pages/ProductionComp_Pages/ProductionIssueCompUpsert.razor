    #region Upsert Production Issue Component

    private async Task UpsertProductionIssueComp()
    {
        try
        {
            isProcessing = true;

            ProductionIssueCompVMs.ProductionIssueCompSubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                x.Qty.GetValueOrDefault() == 0);


            if (ProductionIssueCompVMs.IsOutItemSameAsInItem)
            {
                var inRows = ProductionIssueCompVMs.ProductionIssueCompSubVMs
                    .Where(x => x.TransType == "In")
                    .ToList();

                foreach (var inRow in inRows)
                {
                    var outRow = ProductionIssueCompVMs.ProductionIssueCompSubVMs
                        .FirstOrDefault(x =>
                            x.TransType == "Out" &&
                            x.SlNo == inRow.SlNo + 1);

                    if (outRow != null)
                    {
                        // Keep Out row synchronized with In row
                        outRow.ItemId = inRow.ItemId;
                        outRow.Qty = inRow.Qty;
                        outRow.UnitPrice = inRow.UnitPrice;
                        outRow.BalQty = inRow.Qty;
                        outRow.RefPoSubId = inRow.RefPoSubId;
                    }
                }
            }


            if (!await ValidateRepeatedItemStock())
                return;

            if (!ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any())
            {
                await _JS.ToastrError("Cannot save Production Issue without valid items.");
                return;
            }

            bool hasIn = ProductionIssueCompVMs.ProductionIssueCompSubVMs
                .Any(x => x.TransType?.Equals("In", StringComparison.OrdinalIgnoreCase) == true);

            bool hasOut = ProductionIssueCompVMs.ProductionIssueCompSubVMs
                .Any(x => x.TransType?.Equals("Out", StringComparison.OrdinalIgnoreCase) == true);

            if (!hasIn || !hasOut)
            {
                await _JS.ToastrError("At least one IN item and one OUT item are required.");
                return;
            }

            if (ProductionIssueCompVMs.StoreIssId == null)
            {
                await _JS.ToastrError("Store selection is required.");
                return;
            }

            if (string.IsNullOrWhiteSpace(ProductionIssueCompVMs.IssueToWhom))
            {
                await _JS.ToastrError("Issue To Whom is required.");
                return;
            }

            foreach (var line in ProductionIssueCompVMs.ProductionIssueCompSubVMs)
            {
                bool isValid = await ValidateRowAsync(line);
                if (!isValid) return;
            }

            bool isNew = ProductionIssueCompVMs.IssueId == 0;

            await productionIssueCompService.UpsertProdIssueComp(ProductionIssueCompVMs, screenCode);

            await _JS.ToastrSuccess( isNew ? "Production Issue Component saved successfully." : "Production Issue Component updated successfully.");

            // Discard popup Clear
            await _JS.InvokeVoidAsync("NavigationGuard.clear");

            _navigation.NavigateTo("/productionCompIssueList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Upsert Production Issue Component failed.");
            await _JS.ToastrError("Error saving Production Issue Component.");
        }
        finally
        {
            isProcessing = false;
        }
    }


