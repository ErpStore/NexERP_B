    #region Display SlNo From In Items

    private int GetDisplaySlNo(ProductionIssueCompSubVM item)
    {
        if (!ProductionIssueCompVMs.IsOutItemSameAsInItem)
            return item.SlNo;

        var list = ProductionIssueCompVMs.ProductionIssueCompSubVMs
                    .Where(x => x.TransType == "In")
                    .ToList();

        var index = list.IndexOf(item);

        return index >= 0 ? index + 1 : 0;
    }
    #endregion
    #region Calculate GroupId For IN and OUT items

    private void RecalculateGroupIds()
    {
        try
        {
            var list = ProductionIssueCompVMs?.ProductionIssueCompSubVMs
                ?.OrderBy(x => x.SlNo)
                .ToList();

            if (list == null || !list.Any())
                return;

            int groupId = 1;
            bool hasOutInCurrentGroup = false;

            foreach (var row in list)
            {
                if (row.TransType == "In")
                {
                    // Start new group only after previous group had an OUT
                    if (hasOutInCurrentGroup)
                    {
                        groupId++;
                        hasOutInCurrentGroup = false;
                    }

                    row.GroupId = groupId;
                }
                else // Out
                {
                    row.GroupId = groupId;
                    hasOutInCurrentGroup = true;
                }
            }
        }
        catch (Exception ex)
        {
            LoggingService.LogDeveloperError(ex, "RecalculateGroupIds() failed.");
        }
    }

    #endregion


    private async Task AddToGroup(ProductionIssueCompSubVM item)
    {
        try
        {
            if (item == null)
            {
                await _JS.ToastrWarning("Invalid row selected.");
                return;
            }

            var list = ProductionIssueCompVMs?.ProductionIssueCompSubVMs;

            if (list == null || !list.Any())
            {
                await _JS.ToastrWarning("No rows available.");
                return;
            }

            if (ProductionIssueCompVMs.IsOutItemSameAsInItem)
            {
                await _JS.ToastrWarning("Out Item Same As In Item enabled. Cannot add group row.");
                return;
            }

            int insertIndex = list.IndexOf(item);

            if (insertIndex < 0)
                insertIndex = list.Count - 1;

            var newRow = new ProductionIssueCompSubVM
            {
                TransType = "Out",
                IsEditable = true,
                RefPoSubId = item.RefPoSubId

            };

            list.Insert(insertIndex + 1, newRow);



            await ResetSlno();
            // Recalculate GroupIds based on Out/In logic
            RecalculateGroupIds();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"AddToGroup() failed. ItemId: {item?.ItemId}");
            await _JS.ToastrError("Error processing AddToGroup().");
        }
    }
