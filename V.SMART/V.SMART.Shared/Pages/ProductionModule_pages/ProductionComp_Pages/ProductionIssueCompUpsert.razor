@page "/ProductionIssueComp/create"
@page "/ProductionIssueComp/update/{IssueId:int}"

@using V.SMART.Shared.Pages.Master_Module_pages.VendorSupplier_Pages
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.AccountsViewModel
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.MfgAndlabourViewModel.LabourSCN_VM
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProuctionCompViewModel
@using MudBlazor

@inherits BaseUserRightsComponent
@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject IProductionIssueCompService productionIssueCompService
@inject ILabourDcOutgoingService _dcService
@inject ReportService reportService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="PO Details"
              Columns="@PoColumns"
              ColumnFields="@PoFields"
              HiddenColumns="@PoHiddenColumns"
              Data="@PoData"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="OnPoSelectedAsync">
</DetailsModal>

<DetailsModal Title="@("Labour GRN Details")"
              Columns="@( ModelColumns)"
              ColumnFields="@(ModelFields)"
              HiddenColumns="@(ModelHiddenColumns)"
              Data="@(ModelData)"
              IsVisible="@IsCustDCModalVisible"
              IsVisibleChanged="@((val) => IsCustDCModalVisible = val)"
              OnSelectedItems="@(OnCutomerGRNDCSelectedAsync)">
</DetailsModal>

<DetailsModal Title="Route Card Details"
              Columns="@RcColumns"
              ColumnFields="@RcFields"
              HiddenColumns="@RcHiddenColumns"
              Data="@RcData"
              IsVisible="@IsRcModalVisible"
              IsVisibleChanged="@((val) => IsRcModalVisible = val)"
              OnSelectedItems="OnRcSelectedAsync">



    <HeaderContent>


        <div class="d-flex justify-content-end gap-2 mb-2">

            <label class="d-flex align-items-center cursor-pointer px-2 py-1
                          rounded-pill
                          @(SelectedOption == "Stock" ? "bg-primary text-white" : "bg-light text-dark")"
                   style="font-size: 0.75rem;">
                <input type="radio" class="d-none" name="itemType" id="onlyStock" value="Stock"
                       checked="@(SelectedOption == "Stock")"
                       @onchange="OnStockFilterChanged" />
                <i class="bi bi-box-seam fs-6 me-1"></i>
                Load only Stock exists Items
            </label>

            <label class="d-flex align-items-center cursor-pointer px-2 py-1
                          rounded-pill
                          @(SelectedOption == "All" ? "bg-success text-white" : "bg-light text-dark")"
                   style="font-size: 0.75rem;">
                <input type="radio" class="d-none" name="itemType" id="allItems" value="All"
                       checked="@(SelectedOption == "All")"
                       @onchange="OnStockFilterChanged" />
                <i class="bi bi-list-ul fs-6 me-1"></i>
                Load All Items related Assembly
            </label>

        </div>
    </HeaderContent>
</DetailsModal>


<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    @if (ActiveModal == "Vendor")
    {
        <VendorUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Item")
    {
        <ItemUpsert isModelVisible=true OnClose="CloseModal" />
    }
    else if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@(ProductionIssueCompVMs.IssueId > 0 ? "Update Material Issue" : "Create Material Issue")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@MaterialBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="ProductionIssueCompVMs" OnValidSubmit="UpsertProductionIssueComp">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Correspondence Status -->
                        @if (ProductionIssueCompVMs.IssueId > 0 && !string.IsNullOrWhiteSpace(ProductionIssueCompVMs.IssueNo))
                        {
                            <CorrespondenceStatus ReferenceType=@ScreenName
                                                  ReferenceId="@ProductionIssueCompVMs.IssueId"
                                                  ReferenceTypeName="@ProductionIssueCompVMs.IssueNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">
                        <!-- =================== Vendor & DC Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">



                                <div class="card-header equal-card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <!-- Title -->
                                    <span class="fw-bold fs-6 mb-0">Customer Information</span>
                                    <!-- Right Section -->
                                    <div class="d-flex align-items-center gap-3">

                                        <!-- Checkbox -->
                                        @if (!ProductionIssueCompVMs.IsWithoutPoDc)
                                        {
                                            <div class="form-check d-flex align-items-center mb-0">
                                                <input class="form-check-input me-2 mt-0"
                                                       type="checkbox"
                                                       id="chkSameItem"
                                                       style="border:2px solid #6c757d;"
                                                       checked="@ProductionIssueCompVMs.IsOutItemSameAsInItem"
                                                       @onchange="OnSameItemChanged"
                                                       disabled="@(ProductionIssueCompVMs.IssueId > 0 || (ProductionIssueCompVMs.ProductionIssueCompSubVMs?.Any(x => (x.ItemId ?? 0) > 0) ?? false))">

                                                <label class="form-check-label small mb-0" for="chkSameItem">
                                                    Out Item Same as In Item
                                                </label>
                                            </div>
                                        }

                                        <button type="button" class="btn btn-sm btn-success rounded-3"
                                                @onclick='() => OpenModal("Customer")'>
                                            <i class="bi bi-person-add me-1"></i> Add Customer
                                        </button>

                                    </div>
                                </div>


                                <div class="card-body">

                       
                                        <!-- Customer Autocomplete -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>M/S.*</small>
                                            </label>

                                            @if (!IssueId.HasValue || IssueId == 0)
                                            {
                                                <div class="col-12 col-sm-9">
                                                    <MudAutocomplete T="CustomerVM"
                                                    Value="SelectedCustomer"
                                                    ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                    ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                    SearchFunc="SearchCustomers"
                                                    Dense="true"
                                                    Variant="Variant.Outlined"
                                                    Placeholder="Search Customer"
                                                    Title="Search at least 3 letters in Customer"
                                                    Class="w-100 autocomplete-sm"
                                                    MaxItems="50"
                                                    Clearable="true"
                                                    ResetValueOnEmptyText="true" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-12 col-sm-9">
                                                    <input type="text"
                                                    class="form-control form-control-sm rounded-3"
                                                    @bind="ProductionIssueCompVMs.CustName"
                                                    readonly />
                                                </div>
                                            }
                                        </div>
                                    

                                    @if (!ProductionIssueCompVMs.IsManual && !IsLabourGRNLink)
                                    {
                                        <!-- PO Details -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. PO</small>
                                            </label>
                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                @onclick="ShowPoDetails">
                                                    <i class="bi bi-list-ul me-1"></i> PO Details
                                                </button>
                                            </div>
                                        </div>


                                        <!-- Job No -->
                                        @if (rcPendingCount > 0)
                                        {
                                            <div class="mb-2 row">
                                                <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                    <small>Route Card</small>
                                                </label>
                                                <div class="col-12 col-sm-9 position-relative">
                                                    <button type="button"
                                                    class="btn btn-sm btn-warning w-100 d-flex align-items-center justify-content-center"
                                                    @onclick="ShowRcDetails">
                                                        <i class="bi bi-list-ul me-1"></i> Route Card Details
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }

                                    @if (IsLabourGRNLink)
                                    {

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Reference.</small>
                                            </label>

                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                @onclick="ShowCustomerDcDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Labour GRN Details
                                                </button>
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>


                        <!-- =================== Dc Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                              
                                  <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                     <span class="fw-bold fs-6">Material Issue Details</span>

                                    <div class="d-flex gap-2">

                                        <button type="button" class="btn btn-sm @(ProductionIssueCompVMs.IsManual ? "btn-success" : "btn-primary")"
                                                @onclick="ToggleManual" disabled="@(ProductionIssueCompVMs.IssueId>0)">
                                            <i class="bi bi-pencil-square me-1"></i>
                                            @(ProductionIssueCompVMs.IsManual ? "Manual ON" : "Manual") 
                                        </button>
                                        @if (ProductionIssueCompVMs.IssueId > 0)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm rounded-3 @(ProductionIssueCompVMs.Cancel ? "btn-success" : "btn-danger")"
                                                    @onclick="Cancel">

                                                @if (!ProductionIssueCompVMs.Cancel)
                                                {
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    <span>Cancel</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Revert</span>
                                                }
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm rounded-3 @(ProductionIssueCompVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                    @onclick="() => AskToShortCloseAsync(ProductionIssueCompVMs)"
                                                    disabled="@ProductionIssueCompVMs.Cancel">

                                                @if (!ProductionIssueCompVMs.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Close</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>
                                        }

                                    </div>

                                </div>


                                <div class="card-body">

                                    <!-- Issue No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issue No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm flex-wrap w-100">
                                                <input type="text"
                                                       class="form-control form-control-sm"
                                                       placeholder="Issue No."
                                                       @bind="ProductionIssueCompVMs.IssueNo" />
                                                <span class="input-group-text rounded-end">@ProductionIssueCompVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => ProductionIssueCompVMs.IssueNo)" />
                                            <ValidationMessage For="@(() => ProductionIssueCompVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- Issue Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issue Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@ProductionIssueCompVMs.IssueDate" />
                                            <ValidationMessage For="@(() => ProductionIssueCompVMs.IssueDate)" />
                                        </div>
                                    </div>

                                    <!-- Issue From Store -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issue From Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select @bind="ProductionIssueCompVMs.StoreIssId"
                                                    class="form-select form-select-sm rounded-3 w-100"
                                                    id="SubConDcOut">
                                                <option value="0">--Select Store--</option>
                                                @foreach (var storeid in stores)
                                                {
                                                    <option value="@storeid.StoreId">@storeid.StoreName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => ProductionIssueCompVMs.StoreIssId)" />
                                        </div>
                                    </div>

                                    <!-- Issue To Whom -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issued To Whom </small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   placeholder="Issue to whom."
                                                   @bind="ProductionIssueCompVMs.IssueToWhom" />
                                            <ValidationMessage For="@(() => ProductionIssueCompVMs.IssueToWhom)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      placeholder="Remarks"
                                                      @bind="ProductionIssueCompVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => ProductionIssueCompVMs.MainRemark)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>


                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1"
                                 style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0"
                                               style="table-layout: fixed; min-width: 1900px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:80px;">Group</th>
                                                    <th style="width:80px;">Trans Type</th>
                                                    <th style="width:200px;">Item-Code</th>
                                                    <th style="width:140px;">Item Name</th>
                                                    <th style="width:200px;">UOM</th>
                                                    <th style="width:170px;">Qty</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:120px;">Bal Qty</th>
                                                    <th style="width:130px;">Stock Qty</th>

                                                    <th style="width:130px;">Batch No</th>
                                                    <th style="width:130px;">Heat No</th>

                                                    @if(ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any(x => x.RefPoSubId > 0))
                                                    {
                                                        <th style="width:130px;">Ref. PO No</th>
                                                        <th style="width:130px;">Ref. PO Dt.</th>
                                                    }
                                                    @if (ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any(x => x.RefGRNSubId > 0))
                                                    {
                                                        <th style="width:130px;">Lab. GRN No</th>
                                                        <th style="width:130px;">Lab. GRN Dt.</th>
                                                    }

                                                    @if(ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any(x => x.RcSubId > 0))
                                                    {
                                                        <th style="width:130px;">RC No.</th>
                                                        <th style="width:130px;">RC Dt.</th>
                                                        <th style="width:130px;">Process</th>
                                                        <th style="width:130px;">Machine Name</th>
                                                    }

                                                    <th style="width:200px;">Remarks</th>

                                                    <th style="width:120px;">Cost Center</th>
                                                    @if (!ProductionIssueCompVMs.Cancel && !ProductionIssueCompVMs.ShortClose)
                                                    {
                                                        <th style="width:130px;" class="freeze-last-col text-end">Action</th>
                                                    }
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @if (ProductionIssueCompVMs.ProductionIssueCompSubVMs?.Any() == true)
                                                {
                                                    @foreach (var subitem in ProductionIssueCompVMs.ProductionIssueCompSubVMs)
                                                    {

                                                        if (subitem.TransType == "Out" && ProductionIssueCompVMs.IsOutItemSameAsInItem && !ProductionIssueCompVMs.IsWithoutPoDc)
                                                        {
                                                            continue;
                                                        }

                                                        <tr @key="subitem"
                                                            class="@(StockErrorSlNos.Contains(subitem.SlNo) ? "table-danger" : "")">


                                                            @if (!ProductionIssueCompVMs.IsOutItemSameAsInItem)
                                                            {
                                                                <td>@subitem.SlNo</td>
                                                            }
                                                            else
                                                            {
                                                                <td>@GetDisplaySlNo(subitem)</td>
                                                            }
                                                             <td>@subitem.GroupId</td>
                                                            @if (subitem.RcSubId.GetValueOrDefault() == 0 && !IsBOM)
                                                            {
                                                                <td style="width:120px;">
                                                                    <select class="form-select form-select-sm"
                                                                            @bind="subitem.TransType"
                                                                            disabled="@(!subitem.IsEditable && (!IssueId.HasValue || IssueId == 0) )">
                                                                        <option value="In">In</option>
                                                                        <option value="Out">Out</option>
                                                                    </select>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td style="width:120px;">
                                                                    @subitem.TransType
                                                                </td>
                                                            }

                                                            <td>
                                                                <div class="row g-1 align-items-center">
                                                                    <div class="col-10">
                                                                        @if (subitem.IsEditable
                                                                            &&( (subitem.RefPoSubId == null
                                                                            && subitem.RcSubId == null) || subitem.TransType=="Out") && !IsBOM
                                                                            && subitem.Qty == subitem.BalQty)
                                                                        {

                                                                            @* <MudAutocomplete T="ItemVM"
                                                                                             Value="subitem.SelectedItem"
                                                                                             ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                             ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                             SearchFunc="@(ProductionIssueCompVMs.IsManual
                                                                                                                  ? SearchAssemblyItems
                                                                                                  : SearchItems)"
                                                                             Dense="true"
                                                                             Variant="Variant.Outlined"
                                                                             Placeholder="Search Item Code" /> *@
                                                                            <MudAutocomplete T="ItemVM"
                                                                                             Value="subitem.SelectedItem"
                                                                                             ValueChanged="@(async item => await OnItemChanged(subitem, item))"
                                                                                             ToStringFunc="@(item => item?.ItemCode ?? string.Empty)"
                                                                                             SearchFunc="SearchItems"
                                                                                             Dense="true"
                                                                                             Variant="Variant.Outlined"
                                                                                             Placeholder="Search Item Code"
                                                                                             Title="Search at least 3 letters in Item Code"
                                                                                             Class="w-100 autocomplete-sm"
                                                                                             MaxItems="50" />

                                                                            <ValidationMessage For="@(() => subitem.ItemId)" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>@subitem.ItemCode</span>
                                                                        }
                                                                    </div>

                                                                    <div class="col-2 text-center">
                                                                        @if (subitem.ItemId is > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count)
                                                                            && count > 0)
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                           Size="Size.Small"
                                                                                           Color="Color.Primary"
                                                                                           Edge="Edge.End"
                                                                                           Title="@($"This Item has {count} attachment(s). Click to view.")"
                                                                                           OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))" />
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </td>

                                                            <td>@subitem.ItemName</td>
                                                            <td>@subitem.MeasureUnit</td>
                                                            
                                                            <td>
                                                                @* @if (subitem.IsEditable && CanEditQty(subitem)) *@
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Qty"
                                                                           title="Enter Quantity"
                                                                           step="any"
                                                                           @bind="subitem.Qty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                    <ValidationMessage For="@(() => subitem.Qty)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.Qty
                                                                }
                                                            </td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Unit Price"
                                                                           title="Enter Unit Price"
                                                                           step="any"
                                                                           @bind="subitem.UnitPrice" />
                                                                    <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.UnitPrice
                                                                }
                                                            </td>

                                                            <td>@subitem.BalQty</td>

                                                            <td class="text-danger fw-bold">@subitem.StockQty</td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputText @bind-Value="subitem.BatchNo"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="BatchNo" />
                                                                    <ValidationMessage For="@(() => subitem.BatchNo)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.BatchNo
                                                                }
                                                            </td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputText @bind-Value="subitem.HeatNo"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="HeatNo" />
                                                                    <ValidationMessage For="@(() => subitem.HeatNo)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.HeatNo
                                                                }
                                                            </td>

                                                            @if(ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any(x => x.RefPoSubId > 0))
                                                            {
                                                                <td>
                                                                    @subitem.RefPoNo
                                                                </td>
                                                                <td>
                                                                    @subitem.RefPoDate
                                                                </td>
                                                            }
                                                            @if (ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any(x => x.RefGRNSubId > 0))
                                                            {
                                                                <td>
                                                                    @subitem.RefGRNNo
                                                                </td>
                                                                <td>
                                                                    @subitem.RefGRNDate
                                                                </td>
                                                            }
                                                            @if(ProductionIssueCompVMs.ProductionIssueCompSubVMs.Any(x => x.RcSubId > 0))
                                                            {
                                                                <td>
                                                                    @subitem.RcNo
                                                                </td>

                                                                <td>
                                                                    @subitem.RcDate
                                                                </td>

                                                                <td>
                                                                    @subitem.ProcessName
                                                                </td>

                                                                <td>
                                                                    @if (subitem.IsEditable)
