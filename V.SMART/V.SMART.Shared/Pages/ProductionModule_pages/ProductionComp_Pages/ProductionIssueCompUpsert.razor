    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (ProductionIssueCompVMs.ProductionIssueCompSubVMs == null)
            ProductionIssueCompVMs.ProductionIssueCompSubVMs = new List<ProductionIssueCompSubVM>();

        try
        {
            foreach (var item in selectedItems)
            {
                if (!item.ContainsKey("ItemId") || item["ItemId"] == null)
                    continue;

                int itemId = Convert.ToInt32(item["ItemId"]);
                int poSubId = item.ContainsKey("PoSubId") && item["PoSubId"] != null
                                ? Convert.ToInt32(item["PoSubId"])
                                : 0;
                decimal qty = item.TryGetValue("BalQty", out var bq) &&
                              decimal.TryParse(bq?.ToString(), out var q)
                    ? q
                    : 0m;

                string categoryName = item.TryGetValue("CategoryName", out var cn)
                    ? cn?.ToString() ?? ""
                    : "";

                // 🔒 Prevent duplicate PO Sub selection
                if (ProductionIssueCompVMs.ProductionIssueCompSubVMs
                    .Any(x => x.ItemId == itemId && x.RefPoSubId == poSubId))
                    continue;



                var subVm = new ProductionIssueCompSubVM
                {
                    // Transaction
                    TransType = item.ContainsKey("TransType") ? item["TransType"]?.ToString() ?? "In" : "In",

                    // Item
                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : null,
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : null,
                    MeasureUnit = item.ContainsKey("UOM") ? item["UOM"]?.ToString() : null,

                    // Qty
                    Qty = item.ContainsKey("Qty") && item["Qty"] != null
                            ? Convert.ToDecimal(item["Qty"])
                            : 0m,

                    BalQty = item.ContainsKey("BalQty") && item["BalQty"] != null
                            ? Convert.ToDecimal(item["BalQty"])
                            : 0m,

                    UnitPrice = item.ContainsKey("UnitPrice") && item["UnitPrice"] != null
                            ? Convert.ToDecimal(item["UnitPrice"])
                            : 0m,

                    // PO References
                    RefPoSubId = poSubId,
                    RefPoNo = item.ContainsKey("PoNo") ? item["PoNo"]?.ToString() : null,
                    RefPoDate = item.ContainsKey("PoDate") && item["PoDate"] != null
                            ? Convert.ToDateTime(item["PoDate"])
                            : null,

                    StockQty = item.ContainsKey("StockQty") && item["StockQty"] != null
                            ? Convert.ToDecimal(item["StockQty"])
                            : 0m,

                    // Cost / Project
                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? Convert.ToInt32(item["CostCenterId"])
                            : (int?)null,

                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : null,

                    // Remarks
                    Remark = item.ContainsKey("Remark") ? item["Remark"]?.ToString() : null,


                    IsEditable = true
                };

                ProductionIssueCompVMs.ProductionIssueCompSubVMs.Add(subVm);

                if (ProductionIssueCompVMs.IsOutItemSameAsInItem)
                {
                    await AddSameItemChildAsync(subVm);
                }
                // ================= ASSEMBLY / SUB-ASSEMBLY =================
                else if (categoryName == "ASSEMBLY" || categoryName == "SUB-ASSEMBLY")
                {
                    var assemblyItems = await productionIssueCompService.GetAssemblyItemsAsync(itemId);

                    foreach (var assembly in assemblyItems)
                    {
                        if (!assembly.ItemId.HasValue) continue;

                        decimal stock = await productionIssueCompService.GetStockForItemsAsync(
                            assembly.ItemId.Value,
                            ProductionIssueCompVMs.StoreIssId ?? 0);

                        var rates = await productionIssueCompService.GetBulkLastUnitPricesAsync(
                            new List<int> { assembly.ItemId.Value },
                            ProductionIssueCompVMs?.CustId);

                        decimal unitRate = rates.TryGetValue(assembly.ItemId.Value, out var rate)
                            ? rate
                            : 0;

                        ProductionIssueCompVMs.ProductionIssueCompSubVMs.Add(new ProductionIssueCompSubVM
                        {
                            TransType = "Out",

                            SelectedItem = await productionIssueCompService
                                .GetItemByItemIdAsync(assembly.ItemId.Value),

                            ItemId = assembly.ItemId,
                            ItemCode = assembly.PartItemCode,
                            ItemName = assembly.PartItemName,
                            MeasureUnit = assembly.UOM,

                            Qty = Math.Round(assembly.UtilQty.GetValueOrDefault() * qty, QTY_DECIMAL),
                            BalQty = Math.Round(assembly.UtilQty.GetValueOrDefault() * qty, QTY_DECIMAL),

                            StockQty = stock,
                            UnitPrice = unitRate,

                            IsEditable = false
                        });
                    }
                }

                // ================= COMPONENT =================
                else if (categoryName == "COMPONENT")
                {
                    var compRM = await productionIssueCompService.GetDefaultRawMaterialItemAsync(itemId);

                    if (compRM != null && compRM.RMId.HasValue)
                    {
                        decimal stock = await productionIssueCompService.GetStockForItemsAsync(
                            compRM.RMId.Value,
                            ProductionIssueCompVMs.StoreIssId ?? 0);

                        var rates = await productionIssueCompService.GetBulkLastUnitPricesAsync(
                            new List<int> { compRM.RMId.Value },
                            ProductionIssueCompVMs?.CustId);

                        decimal unitRate = rates.TryGetValue(compRM.RMId.Value, out var rate)
                            ? rate
                            : 0;

                        ProductionIssueCompVMs.ProductionIssueCompSubVMs.Add(new ProductionIssueCompSubVM
                        {
                            TransType = "Out",

                            SelectedItem = await productionIssueCompService
                                .GetItemByItemIdAsync(compRM.RMId.Value),

                            ItemId = compRM.RMId.Value,
                            ItemCode = compRM.RMCode,
                            ItemName = compRM.RMName,
                            MeasureUnit = compRM.MeasureUnit,

                            Qty = Math.Round(compRM.Weight * qty, QTY_DECIMAL),
                            BalQty = Math.Round(compRM.Weight * qty, QTY_DECIMAL),

                            StockQty = stock,
                            UnitPrice = unitRate,

                            IsEditable = false
                        });
                    }
                }
            }

            // ===== Reset Serial Numbers =====
            await ResetSlno();
            RecalculateGroupIds();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _JS.ToastrError("Error processing selected PO items.");
        }
    }
    private async Task AddSameItemChildAsync(ProductionIssueCompSubVM parentVm)
    {
        var item = await productionIssueCompService.GetItemByItemIdAsync(parentVm.ItemId ?? 0);

        ProductionIssueCompVMs.ProductionIssueCompSubVMs.Add(new ProductionIssueCompSubVM
        {
            SelectedItem = item,

            RefPoSubId = parentVm.RefPoSubId,
            RefPoNo = parentVm.RefPoNo,
            RefPoDate = parentVm.RefPoDate,
            TransType = "Out",

            ItemId = parentVm.ItemId,
            ItemCode = parentVm.ItemCode,
            ItemName = parentVm.ItemName,

            MeasureUnit = parentVm.MeasureUnit,
            StockQty=parentVm.StockQty,
            Category = parentVm.Category,
            CategoryCode=parentVm.CategoryCode,
            Qty = parentVm.Qty,
            BalQty = parentVm.Qty,
            UnitPrice = parentVm.UnitPrice,
            CostId = parentVm.CostId,
            ProjectNo = parentVm.ProjectNo,

            IsEditable = true
        });
    }

