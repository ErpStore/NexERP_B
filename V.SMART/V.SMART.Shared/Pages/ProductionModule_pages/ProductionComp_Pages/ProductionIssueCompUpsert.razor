    private async Task<bool> ValidateRepeatedItemStock()
    {
        StockErrorSlNos.Clear();

        var outItems = ProductionIssueCompVMs.ProductionIssueCompSubVMs
            .Where(x =>
                x.TransType == "Out" &&
                x.ItemId.HasValue &&
                x.Qty.HasValue &&
                x.Qty.Value > 0)
            .GroupBy(x => x.ItemId!.Value)
            .Select(g => new
            {
                ItemId = g.Key,
                TotalQty = g.Sum(x => x.Qty ?? 0),
                StockQty = g.First().StockQty ?? 0,
                SlNos = g.Select(x => x.SlNo).ToList()
            })
            .ToList();

        foreach (var item in outItems)
        {
            decimal effectiveStock = item.StockQty;

            var editedRows = ProductionIssueCompVMs.ProductionIssueCompSubVMs
                .Where(x =>
                    x.ItemId == item.ItemId &&
                    x.IssueSubId > 0)
                .ToList();

            if (editedRows.Any())
            {
                decimal previouslyIssuedQtyTotal = 0;

                foreach (var row in editedRows)
                {
                    var original =
                        await productionIssueCompService
                            .GetProductionIssueSubItemDetailByIssueSubIdAsync(row.IssueSubId);

                    if (original != null)
                    {
                        previouslyIssuedQtyTotal += original.Qty.GetValueOrDefault();
                    }
                }

                effectiveStock = item.StockQty + previouslyIssuedQtyTotal;
            }

            if (item.TotalQty > effectiveStock)
            {
                foreach (var slNo in item.SlNos)
                    StockErrorSlNos.Add(slNo);

                var slText = string.Join(", ", item.SlNos.OrderBy(x => x));

                await _JS.ToastrWarning(
                    $"Stock exceeded at row(s): {slText}. " +
                    $"Issued: {item.TotalQty}, Available: {effectiveStock}"
                );

                StateHasChanged();
                return false;
            }
        }

        StateHasChanged();
        return true;
    }





