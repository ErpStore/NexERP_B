            if (ProductionIssueCompVMs.ProductionIssueCompSubVMs.Count == 1 && item.IssueSubId > 0)
            {
                await _JS.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if(IsSomeItemsTransMade)
