    private async Task LoadExistingProductionIssue(int issueId)
    {
        try
        {
            MachineList = await productionIssueCompService.GetAllActiveMachinesAsync();

            ProductionIssueCompVMs = await productionIssueCompService.GetProductionByIssueIdAsync(issueId);

            if (ProductionIssueCompVMs == null)
            {
                await _JS.ToastrWarning("Production Issue Component not found.");
                return;
            }

            foreach (var prodSub in ProductionIssueCompVMs.ProductionIssueCompSubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[prodSub.ItemId.Value] =
                    await productionIssueCompService.GetCorrespondenceAttachmentsCountAsync(prodSub.ItemId.Value, "Item");

            }

            IsSomeItemsTransMade = await CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _JS.ToastrError("Failed to load existing production Issue Component.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingProductionIssue failed for IssueId: {issueId}");
        }
    }

    private async Task InitializeNewMaterialIssue()
