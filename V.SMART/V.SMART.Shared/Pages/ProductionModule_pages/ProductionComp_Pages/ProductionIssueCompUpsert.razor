            ProductionIssueCompVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            ProductionIssueCompVMs.IssueNo = await productionIssueCompService.GetMaterialIssueNumberAsync(ProductionIssueCompVMs.Suffix);

            var MapStoreForMaterialIssue = await productionIssueCompService.GetMappedStoreForFormAsync("PMIssueForm");

            if (MapStoreForMaterialIssue.StoreId > 0)
            {
