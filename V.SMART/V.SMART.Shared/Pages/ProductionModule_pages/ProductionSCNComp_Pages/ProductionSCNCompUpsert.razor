    #region Row Operations

    private async Task<bool> ValidateRowAsync(ProductionSCNCompSubVM row)
    {
        try
        {
            var errors = new List<string>();

            if (row.ItemId == null)
                errors.Add("Please select an Item.");

            if (errors.Any())
            {
                var message = string.Join("<br>", errors);
                await _js.ToastrInfo(message);
                return false;
            }

            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating row.");
            await LoggingService.LogDeveloperError(ex, "ValidateRowAsync failed.");
            return false;
        }
    }

    private async Task<bool> ValidateLastRowAsync()
    {
        try
        {
            var lastRow = ProductionSCNCompVMs.ProductionSCNCompSubVMs.LastOrDefault();
            if (lastRow == null) return true;

            if (!await ValidateRowAsync(lastRow)) return false;

            lastRow.IsEditable = false;
            return true;
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error validating last row.");
            await LoggingService.LogDeveloperError(ex, "ValidateLastRowAsync failed.");
            return false;
        }
    }

    private async Task AddRow()
    {
        try
        {
            if (!await ValidateLastRowAsync()) return;

            ProductionSCNCompVMs.ProductionSCNCompSubVMs.Add(new ProductionSCNCompSubVM
            {
                SCNId = ProductionSCNCompVMs.SCNId,
                IsEditable = true
            });

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Error adding new row.");
            await LoggingService.LogDeveloperError(ex, "AddRow failed.");
        }
    }

    private async Task SaveRow(ProductionSCNCompSubVM item)
    {
        try
        {
            if (!await ValidateRowAsync(item))
            {
                item.IsEditable = true;
                return;
            }

            item.IsEditable = false;

            // Ensure at least one editable row exists for new entries
            if (!ProductionSCNCompVMs.ProductionSCNCompSubVMs.Any(x => x.IsEditable))
            {
                ProductionSCNCompVMs.ProductionSCNCompSubVMs.Add(new ProductionSCNCompSubVM
                {
                    SCNId = ProductionSCNCompVMs.SCNId,
                    IsEditable = true
                });
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"SaveRow failed for ScnSubId: {item?.SCNSubId}");
            await _js.ToastrError("Failed to save the row. Please try again.");
        }
    }

    private async Task EditRowAsync(ProductionSCNCompSubVM item)
    {
        try
        {
            item.IsEditable = true;

            if (item.SelectedItem == null && item.ItemId > 0)
            {
                item.SelectedItem = await productionSCNService.GetItemByItemIdAsync(item.ItemId);
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"EditRowAsync failed for SCNSubId: {item?.SCNSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(ProductionSCNCompSubVM? item, ProductionSCNCompVM? parentSCN)
    {
        try
        {
            if (item == null || parentSCN == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0);

            if (isEmptyOrInvalid)
            {
                parentSCN.ProductionSCNCompSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CancelEdit failed for SCNSubId: {item?.SCNSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(ProductionSCNCompSubVM item)
    {
        try
        {
            if (ProductionSCNCompVMs.ProductionSCNCompSubVMs.Count == 1 && item.SCNSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if(IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if (item.ItemId == 0)
            {
                ProductionSCNCompVMs.ProductionSCNCompSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!ProductionSCNCompVMs.ProductionSCNCompSubVMs.Any())
                    ProductionSCNCompVMs.ProductionSCNCompSubVMs = new List<ProductionSCNCompSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"RemoveRow failed for SCNSubId: {item?.SCNSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
    {
        try
        {
            int counter = 1;
            foreach (var sub in ProductionSCNCompVMs.ProductionSCNCompSubVMs)
            {
                sub.SlNo = counter++;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ResetSlno failed.");
            await _js.ToastrError("Failed to reset row serial numbers.");
        }
    }

