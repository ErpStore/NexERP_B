    #region Qty Handlers

    private async Task<decimal> GetIssueQtyAsync(ProductionSCNCompSubVM subVM)
    {
        if (subVM.RefReturnSubId is null or 0)
            return 0;

        return await productionSCNService.GetProdReturnItemBalQtyFromReturnSubId(subVM.RefReturnSubId.Value);
    }

    private async Task OnAccpQtyChange(decimal? newValue, ProductionSCNCompSubVM subVM)
    {
        try
        {
            var accp = newValue.GetValueOrDefault();
            if (accp < 0)
            {
                subVM.AccQty = 0;
                await _js.ToastrWarning("Accepted Qty must be positive.");
                return;
            }

            var rej = subVM.RejQty.GetValueOrDefault();
            var rew = subVM.RewQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, "Accepted"))
            {
                subVM.AccQty = accp;
                subVM.BalQty = subVM.BalQty;
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnAccpQtyChange failed");
            await _js.ToastrError("Failed to update Accepted Qty.");
        }
    }

    private async Task AdjustQty(ProductionSCNCompSubVM subVM, string field, decimal max, decimal accp, decimal rej, decimal rew)
    {
        switch (field)
        {
            case "Accepted":
                subVM.AccQty = max - (rej + rew);
                break;

            case "Rejected":
                subVM.RejQty = max - (accp + rew);

                break;

            case "Rework":
                subVM.RewQty = max - (accp + rej);

                break;
        }

    }


    private async Task<bool> ValidateAndAdjustAsync(ProductionSCNCompSubVM subVM, decimal newAccp, decimal newRej, decimal newRew, string fieldName)
    {
        var grnBalQty = await productionSCNService
            .GetProdReturnItemBalQtyFromReturnSubId(subVM.RefReturnSubId!.Value);

        var original = subVM.SCNSubId > 0
            ? await productionSCNService.GetSCNCompItemDetailByScnSubIdAsync(subVM.SCNSubId)
            : null;

        decimal origAccp = original?.AccQty ?? 0;
        decimal origRej = original?.RejQty ?? 0;
        decimal origRew = original?.RewQty ?? 0;
        decimal origBal = original?.BalQty ?? 0;
        decimal origSCnBal = original?.SCNBalQty ?? 0;

        decimal originalTotal = origAccp + origRej + origRew;
        decimal maxAllowed = grnBalQty + originalTotal;
        decimal total = newAccp + newRej + newRew;
        decimal totalRejRew = newRej + newRew;


        decimal originalRejRewTotal = origRej + origRew;

        decimal alreadyTransacted = 0;
        decimal alreadyTransactedSCN = 0;

        if (original != null)
        {
            alreadyTransacted = originalTotal - (origBal + origRej + origRew);
            alreadyTransactedSCN = originalRejRewTotal - origSCnBal;
        }
        else
        {
            alreadyTransacted = 0;
        }

        if (subVM.SCNSubId > 0 && total < alreadyTransacted)
        {
            alreadyTransacted = alreadyTransacted + origRej + origRew;

            await AdjustQty(subVM, fieldName, alreadyTransacted, newAccp, newRej, newRew);
            subVM.BalQty = 0m;

            if (originalRejRewTotal < alreadyTransactedSCN)
            {
                subVM.SCNBalQty = 0m;
            }

            await _js.ToastrWarning(
                $"Total Qty cannot be less than {alreadyTransacted} (already transacted).");
            return false;
        }
        if (subVM.SCNSubId > 0 && totalRejRew < alreadyTransactedSCN)
        {
            alreadyTransactedSCN = originalTotal - alreadyTransactedSCN;

            await AdjustQty(subVM, fieldName, alreadyTransactedSCN, newAccp, newRej, newRew);
            subVM.SCNBalQty = 0m;

            await _js.ToastrWarning(
                $"Total Qty cannot be less than {alreadyTransacted} (already transacted).");
            return false;
        }

        if (total > maxAllowed)
        {
            await AdjustQty(subVM, fieldName, maxAllowed, newAccp, newRej, newRew);

            if (original != null)
            {
                var diff = subVM.AccQty.GetValueOrDefault() - origAccp;
                subVM.BalQty = Math.Max(0m, origBal + diff);

                var Diffrej = (subVM.RejQty.GetValueOrDefault() + subVM.RewQty.GetValueOrDefault()) - originalRejRewTotal;
                subVM.SCNBalQty = Math.Max(0m, alreadyTransactedSCN + Diffrej);


            }
            else
            {
                subVM.BalQty = subVM.AccQty;
                subVM.SCNBalQty =
                   subVM.RejQty.GetValueOrDefault()
                  + subVM.RewQty.GetValueOrDefault();

            }

            await _js.ToastrWarning($"{fieldName} change exceeded limit. Max allowed total is {maxAllowed}.");
            return false;
        }

        if (original != null)
        {
            var diff = subVM.AccQty.GetValueOrDefault() - origAccp;

            subVM.BalQty = Math.Max(0m, origBal + diff);

            var Diffrej = (subVM.RejQty.GetValueOrDefault() + subVM.RewQty.GetValueOrDefault()) - originalRejRewTotal;
            subVM.SCNBalQty = Math.Max(0m, alreadyTransactedSCN + Diffrej);

        }
        else
        {
            subVM.BalQty = subVM.AccQty;
            subVM.SCNBalQty = subVM.RejQty.GetValueOrDefault() + subVM.RewQty.GetValueOrDefault();
        }

        return true;
    }



    private async Task OnRejQtyChange(decimal? newValue, ProductionSCNCompSubVM subVM)
    {
        try
        {
            var rej = newValue.GetValueOrDefault();
            if (rej < 0)
            {
                subVM.RejQty = 0;
                await _js.ToastrWarning("Rejected Qty must be positive.");
                return;
            }

            var accp = subVM.AccQty.GetValueOrDefault();
            var rew = subVM.RewQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, "Rejected"))
                subVM.RejQty = rej;

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnRejQtyChange failed");
            await _js.ToastrError("Failed to update Rejection Qty.");
        }
    }

    private async Task OnRewQtyChange(decimal? newValue, ProductionSCNCompSubVM subVM)
    {
        try
        {
            var rew = newValue.GetValueOrDefault();
            if (rew < 0)
            {
                subVM.RewQty = 0;

                await _js.ToastrWarning("Rework Qty must be positive.");
                return;
            }

            var accp = subVM.AccQty.GetValueOrDefault();
            var rej = subVM.RejQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, "Rework"))
                subVM.RewQty = rew;

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnRewQtyChange failed");
            await _js.ToastrError("Failed to update Rework Qty.");
        }
    }


