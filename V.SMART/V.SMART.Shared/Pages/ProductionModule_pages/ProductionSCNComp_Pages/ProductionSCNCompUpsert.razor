    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(SCNId.GetValueOrDefault(), "ProdCompSCN.frx", "SCNId", false, ScreenName, "Sp_Print_ProdCompSCN");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        { 
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Production SCN Component details");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Production SCN Component details.");
        }
        finally
        {
            isProcessing = false;
        }
    }

