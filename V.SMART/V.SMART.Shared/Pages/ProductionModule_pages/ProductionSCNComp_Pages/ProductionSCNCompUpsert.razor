    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.SCNSubId > 0)
            {
                await productionSCNService.DeleteAndResequenceAsync(rowToDelete, ProductionSCNCompVMs, screenCode);

                ProductionSCNCompVMs.ProductionSCNCompSubVMs = await productionSCNService.GetProdSCNSubBySCNIdAsync(ProductionSCNCompVMs.SCNId);
            }
            else
            {
                ProductionSCNCompVMs.ProductionSCNCompSubVMs.Remove(rowToDelete);

                if (!ProductionSCNCompVMs.ProductionSCNCompSubVMs.Any())
                {
                    ProductionSCNCompVMs.ProductionSCNCompSubVMs.Add(new ProductionSCNCompSubVM
                    {
                        SCNId = ProductionSCNCompVMs.SCNId,
                        IsEditable = true,
                        SlNo = 1
                    });
                }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < ProductionSCNCompVMs.ProductionSCNCompSubVMs.Count; i++)
                        ProductionSCNCompVMs.ProductionSCNCompSubVMs[i].SlNo = i + 1;
                }
            }

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error confirming deletion for SCNId: {ProductionSCNCompVMs.SCNId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
            StateHasChanged();
        }
    }

