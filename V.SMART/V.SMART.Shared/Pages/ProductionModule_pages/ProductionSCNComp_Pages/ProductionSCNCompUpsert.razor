    private async Task OnProductionReturnSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (ProductionSCNCompVMs.ProductionSCNCompSubVMs == null)
            ProductionSCNCompVMs.ProductionSCNCompSubVMs = new List<ProductionSCNCompSubVM>();

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .Distinct()
                .ToList();

            int storeId = ProductionSCNCompVMs.IssueStoreId ?? 0;

            var storeStock = await _unitOfWork.StockAdds.GetQueryable()
                .Where(s => s.StoreId == storeId && itemIds.Contains(s.ItemId))
                .GroupBy(s => s.ItemId)
                .Select(g => new
                {
                    ItemId = g.Key,
                    StockQty = g.Sum(x => x.BalQty)
                })
                .ToDictionaryAsync(x => x.ItemId, x => x.StockQty);


            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefReturnSubId = item.ContainsKey("RefReturnSubId") && item["RefReturnSubId"] != null
                    ? Convert.ToInt32(item["RefReturnSubId"])
                    : (int?)null;

                int? RefPoSubId = item.ContainsKey("POSubId") && item["POSubId"] != null
                    ? Convert.ToInt32(item["POSubId"])
                    : (int?)null;

                int? RefRcSubId = item.ContainsKey("RCSubId") && item["RCSubId"] != null
                    ? Convert.ToInt32(item["RCSubId"])
                    : (int?)null;

                if (ProductionSCNCompVMs.ProductionSCNCompSubVMs
                    .Any(x => x.ItemId == itemId && x.RefReturnSubId == RefReturnSubId))
                    continue;

                decimal stockQty = storeStock.ContainsKey(itemId)
                    ? storeStock[itemId]
                    : 0;

                decimal returnBalQty = item.ContainsKey("BalQty") && item["BalQty"] != null
                    ? Convert.ToDecimal(item["BalQty"])
                    : 0;

                decimal allowedQty = Math.Min(stockQty, returnBalQty);

                var subVm = new ProductionSCNCompSubVM
                {
                    RefReturnSubId = RefReturnSubId,
                    RefReturnNo = item.ContainsKey("ReturnNo") ? item["ReturnNo"]?.ToString() : "",
                    RefReturnDate = item.ContainsKey("ReturnDate") && item["ReturnDate"] != null
                        ? Convert.ToDateTime(item["ReturnDate"])
                        : null,

                    RcSubId = RefRcSubId,
                    RcNo = item.ContainsKey("RCNo") ? item["RCNo"]?.ToString() : "",
                    RcDate = item.ContainsKey("RCDt") && item["RCDt"] != null
                        ? Convert.ToDateTime(item["RCDt"])
                        : null,
                  
                    Process = item.ContainsKey("Process") ? item["Process"]?.ToString() : "",

                    PoSubId = RefPoSubId,
                    PoNo = item.ContainsKey("PONo") ? item["PONo"]?.ToString() : "",
                    PoDate = item.ContainsKey("PODt") && item["PODt"] != null
                        ? Convert.ToDateTime(item["PODt"])
                        : null,

                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("MeasureUnit") ? item["MeasureUnit"]?.ToString() : "",

                    // IMPORTANT CHANGE HERE
                    AccQty = allowedQty,
                    BalQty = allowedQty,
                    QtyReceived = allowedQty,
                    UnitPrice = item.ContainsKey("UnitPrice") ? Convert.ToDecimal(item["UnitPrice"]) : 0,

                    StockQty = stockQty,

                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                        ? (Convert.ToInt32(item["CostCenterId"]) == 0 ? (int?)null : Convert.ToInt32(item["CostCenterId"]))
                        : (int?)null,

                    ProjectNo = item.ContainsKey("ProjectNo") ? item["ProjectNo"]?.ToString() : "",

                    IsEditable = true
                };

                ProductionSCNCompVMs.ProductionSCNCompSubVMs.Add(subVm);
            }

            int slNo = 1;
            foreach (var row in ProductionSCNCompVMs.ProductionSCNCompSubVMs)
            {
                row.SlNo = slNo++;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnProductionReturnSelectedAsync failed.");
            await _js.ToastrError("Error processing selected items.");
        }
    }
    private void OnRejectionChanged(ProductionSCNCompSubVM subitem)
    {
        var selected = RejectionMasterVMs
            .FirstOrDefault(x => x.RejectionId == subitem.RejectionId);

        if (selected != null)
        {
            subitem.RejReason = selected.RejectionDescription;
        }
    }
