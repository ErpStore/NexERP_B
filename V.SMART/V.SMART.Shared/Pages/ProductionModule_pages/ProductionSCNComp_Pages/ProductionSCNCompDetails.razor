@page "/productionCompScn/details/{SCNId:int}"
@using V.SMART.Shared.Services.ReportViewer

@inherits BaseUserRightsComponent

@inject ReportService reportService
@inject IProductionSCNCompService productionSCNService
@inject IJSRuntime js
@inject ILoggingService logs

@inject NavigationManager _navigationManager


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

        <MyCompanyDetails />

        <hr class="border-2 border-primary-subtle mb-4" />
        <div class="text-center">
            <h4 class="fw-semibold mt-3">Production Component SCN Details</h4>
        </div>

        <hr class="border-2 border-primary-subtle mb-4" />



        <!-- Document Details -->
        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">

                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Document Details
                    </div>

                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>

                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>SCN No.</strong></td>
                                    <td>
                                        @((ProductionSCNCompVMs != null) ? $"{ProductionSCNCompVMs.SCNNo}{ProductionSCNCompVMs.Suffix}" : "")
                                    </td>
                                </tr>

                                <tr>
                                    <td class="text-secondary"><strong>SCN Dt.</strong></td>
                                    <td>@(ProductionSCNCompVMs?.SCNDate)</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

            <!-- Production Issue Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">

                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Production GRN Details
                    </div>

                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>

                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Issue from store</strong></td>
                                    <td>@(ProductionSCNCompVMs != null ? $"{ProductionSCNCompVMs.IssueStoreName}" : "")</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Added To store</strong></td>
                                    <td>@(ProductionSCNCompVMs != null ? $"{ProductionSCNCompVMs.AddStoreName}" : "")</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary"><strong>Remarks</strong></td>
                                    <td>@($"{ProductionSCNCompVMs?.MainRemark}")</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

        <!--  Items -->
        <div class="card border-1 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                Production Issue Items
            </div>

            <div class="table-responsive" style="overflow-x:auto;">
                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                    <thead class="custom-blue">
                        <tr>
                            <th>Sl No.</th>
                            <th>Return No.</th>
                            <th>Return Dt.</th>
                            <th>Item Code</th>
                            <th>Description</th>
                            <th>UOM</th>

                            <th>Accpt Qty</th>
                            <th>Rej Qty</th>
                            <th>Rew Qty</th>
                            <th>Unit Price</th>

                            <th>Cost Center</th>
                        </tr>
                    </thead>

                    <tbody class="custom-size">

                        @if (ProductionSCNCompVMs?.ProductionSCNCompSubVMs != null && ProductionSCNCompVMs.ProductionSCNCompSubVMs.Any())
                        {
                            @foreach (var item in ProductionSCNCompVMs.ProductionSCNCompSubVMs)
                            {
                                <tr>
                                    <td>@item.SlNo</td>
                                    <td>@(item.RefReturnNo ?? "—")</td>
                                    <td>@(item.RefReturnDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td>@(item.ItemCode ?? "—")</td>
                                    <td>@(item.ItemName ?? "—")</td>
                                    <td>@item.MeasureUnit</td>

                                    <td>@($"{item.AccQty:0.###}")</td>
                                    <td>@($"{item.RejQty:0.###}")</td>
                                    <td>@($"{item.RewQty:0.###}")</td>
                                    <td>@($"{item.UnitPrice:0.###}")</td>

                                    <td>@item.ProjectNo</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" class="text-center text-muted">No items found</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2 justify-content-end">
            <a href="@($"/productionCompSCNList?currentPage={currentPage}")" class="btn btn-secondary rounded-3" disabled="@isProcessing">
                <i class="bi bi-arrow-bar-left me-1"></i> Back To List
            </a>

            <a href="@($"/productionCompScn/update/{SCNId}")" class="btn btn-outline-primary">
                <i class="bi bi-pencil-square"></i> Modify
            </a>

            <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                <i class="bi bi-printer"></i> Print
            </button>
        </div>
    </div>

}


@code
{
    protected override string ScreenName => "Production SCN Component";
    [Parameter] public int? SCNId { get; set; }

    private string? pdfBase64;

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private bool isProcessing { get; set; } = true;

    private ProductionSCNCompVM ProductionSCNCompVMs { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            await LoadAllProductionCompReturns();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in Production SCN Component Details OnInitializedAsync");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task LoadAllProductionCompReturns()
    {
        try
        {
            if (SCNId <= 0)
                return;

            var result = await productionSCNService.GetProductionSCNByScnIdAsync(SCNId.GetValueOrDefault());

            if (result == null)
            {
                await js.ToastrWarning("Production SCN Component not found.");
                return;
            }

            // FIXED: Load into VM correctly
            ProductionSCNCompVMs = result;


        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error loading Production SCN Component by SCNId");
            await js.ToastrError("Failed to load Production SCN Component details.");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(SCNId.GetValueOrDefault(), "ProdCompSCN.frx", "SCNId", false, ScreenName, "Sp_Print_ProdCompSCN");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Production SCN Component details");
            await js.ToastrError("An unexpected error occurred while generating the PDF in Production SCN Component details.");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
