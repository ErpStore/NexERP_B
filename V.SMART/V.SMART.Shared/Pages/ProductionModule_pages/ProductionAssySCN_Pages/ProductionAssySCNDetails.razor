@page "/productionSCNAssy/details/{SCNId:int}"
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionSCNAssyViewModel

@inherits BaseUserRightsComponent

@inject ReportService reportService

@inject IProductionSCNAssyservice prodSCNAssyService
@inject IJSRuntime js
@inject ILoggingService logs
@inject NavigationManager _nav

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <!-- Company Details Section -->
            <MyCompanyDetails />


            <hr class="border-2 border-primary-subtle mb-4" />
            <div class="text-center">
                <h4 class="fw-semibold mt-3">SCN Details</h4>
            </div>

            <hr class="border-2 border-primary-subtle mb-4" />

            <!-- Document Details -->
            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">

                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Document Details
                        </div>

                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>SCN No.</strong></td>
                                        <td>
                                            @($"{ProductionSCNAssyVMs?.SCNNo}{ProductionSCNAssyVMs?.Suffix}")
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>SCN Date</strong></td>
                                        <td>@(ProductionSCNAssyVMs?.SCNDate)</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Ref GRN No.</strong></td>
                                        <td>@refGrnNoDisplay</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Ref GRN Dt.</strong></td>
                                        <td>@refGrnDateDisplay</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

                <!-- Production Return Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">

                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Production SCN Details
                        </div>

                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Issue to Store</strong></td>
                                        <td>@ProductionSCNAssyVMs?.IssueStoreName</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Add to Store</strong></td>
                                        <td>@ProductionSCNAssyVMs?.AddStoreName</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Remarks</strong></td>
                                        <td>@ProductionSCNAssyVMs?.MainRemark</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Items -->
            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    Production Return Items
                </div>

                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                        <thead class="custom-blue">
                            <tr>
                                <th>Sl No.</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>UOM</th>
                                <th>Accecpt Qty</th>
                                <th>Reject Qty</th>
                                <th>Reject Reason</th>
                                <th>Rework Qty</th>
                                <th>Rework Reason</th>
                                <th>Unit Price</th>
                                <th>Balance Qty</th>
                                <th>Cost Center</th>
                            </tr>
                        </thead>

                        <tbody class="custom-size">

                            @if (ProductionSCNAssyVMs?.ProductionSCNAssySubVMs != null &&
                                                ProductionSCNAssyVMs.ProductionSCNAssySubVMs.Any())
                            {
                                @foreach (var item in ProductionSCNAssyVMs.ProductionSCNAssySubVMs)
                                {
                                    <tr>
                                        <td>@item.SlNo</td>
                                        <td>@item.ItemCode</td>
                                        <td>@item.ItemName</td>
                                        <td>@item.MeasureUnit</td>
                                        <td>@($"{item.AccQty:0.###}")</td>
                                        <td>@($"{item.RejQty:0.###}")</td>
                                        <td>@item.RejReason</td>
                                        <td>@($"{item.RewQty:0.###}")</td>
                                        <td>@item.RejReason</td>
                                        <td>@($"{item.UnitPrice:0.###}")</td>
                                        <td>@($"{item.BalQty:0.###}")</td>
                                        <td>@item.ProjectNo</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 justify-content-end">
                <a href="@($"/productionAssySCNList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                    <i class="bi bi-arrow-bar-left me-1"></i> Back To List
                </a>

                <a href="@($"/productionAssyScn/update/{SCNId}")" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Modify
                </a>

                <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>

        </div>
    }
}


@code {

    protected override string ScreenName => "Production SCN Assembly";

    [Parameter] public int SCNId { get; set; }

    private string? pdfBase64;

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private bool isProcessing { get; set; } = true;
    private ProductionSCNAssyVM ProductionSCNAssyVMs { get; set; } = new();

    private List<ProductionSCNAssySubVM> refGRNNo = new();
    private string refGrnNoDisplay = "N/A";
    private string refGrnDateDisplay = "N/A";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _nav.NavigateTo("/access-denied");
                return;
            }

            await LoadAllProductionAssySCNs();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in Production Return Assembly Details OnInitializedAsync");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadAllProductionAssySCNs()
    {
        try
        {
            if (SCNId <= 0)
                return;

            var result = await prodSCNAssyService.GetProductionSCNByScnIdAsync(SCNId);

            if (result == null)
            {
                await js.ToastrWarning("Production SCN Assembly not found.");
                return;
            }

            ProductionSCNAssyVMs = result;

            // Load Job Order references
            refGRNNo = await prodSCNAssyService.GetDistinctRefGRNNOsbySCNIdAsync(SCNId);

            if (refGrnNoDisplay.Any())
            {
                refGrnNoDisplay = string.Join(", ",
                    refGRNNo.Select(e => e.RefReturnNo).Where(n => !string.IsNullOrWhiteSpace(n)));

                refGrnDateDisplay = string.Join(", ",
                    refGRNNo.Select(e =>
                        e.RefReturnDate.HasValue
                            ? e.RefReturnDate.Value.ToString("dd/MM/yyyy")
                            : null)
                    .Where(d => !string.IsNullOrWhiteSpace(d)));
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error loading Production SCN Assembly by ReturnId");
            await js.ToastrError("Failed to load Production SCN Assembly details.");
        }
    }


    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(SCNId, "ProdAssySCN.frx", "SCNId", false, ScreenName, "Sp_Print_ProdAssySCN");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf ProdAssy SCN");
            await js.ToastrError("An unexpected error occurred while generating the PDF in ProdAssy SCN");
        }
        finally
        {
            isProcessing = false;
        }
    }


}
