            else
            {
                ProductionSCNAssyVMs.ProductionSCNAssySubVMs.Remove(rowToDelete);

                if (!ProductionSCNAssyVMs.ProductionSCNAssySubVMs.Any())
                {
                    ProductionSCNAssyVMs.ProductionSCNAssySubVMs.Add(new ProductionSCNAssySubVM
                    {
                        SCNId = ProductionSCNAssyVMs.SCNId,
                        IsEditable = true,
                        SlNo = 1
