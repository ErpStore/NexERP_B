@page "/productionAssyScn/create"
@page "/productionAssyScn/update/{SCNId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IProductionService
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionSCNAssyViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IProductionSCNAssyservice productionAssySCNService
@inject ILoggingService LoggingService
@inject ReportService reportService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js


<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="Production Assy Return Details"
              Columns="@ProdReturnColumns"
              ColumnFields="@ProdReturnFields"
              HiddenColumns="@ProdReturnHiddenColumns"
              Data="@ProdReturnData"
              IsVisible="@IsProdreturnModalVisible"
              IsVisibleChanged="@((val) => IsProdreturnModalVisible = val)"
              OnSelectedItems="OnProductionReturnSelectedAsync">
</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">

    @if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
  position: sticky;
  right: 0;
  background-color: #f8f9fa;
  z-index: 10;
}
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@(ProductionSCNAssyVMs.SCNId > 0 ? "Update Production SCN" : "Create Production SCN")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@scnBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="ProductionSCNAssyVMs" OnValidSubmit="UpsertProdSCN">
                    <ObjectGraphDataAnnotationsValidator  />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Manufacturing / Labour Toggle -->
                        <div class="col-12 col-md-6">
                            
                        </div>

                        <!-- Correspondence Status -->
                        <div class="col-12 col-md-6 d-flex justify-content-end align-items-center">
                            @if (ProductionSCNAssyVMs.SCNId > 0 && !string.IsNullOrWhiteSpace(ProductionSCNAssyVMs.SCNNo))
                            {
                                <CorrespondenceStatus 
                                    ReferenceType="Production SCN Assembly"
                                    ReferenceId="@ProductionSCNAssyVMs.SCNId"
                                    ReferenceTypeName="@ProductionSCNAssyVMs.SCNNo" />
                            }
                        </div>
                    </div>

                    <div class="row g-3 mb-2">

                        <!-- =================== Production SCN Details =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Production SCN Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- SCN No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>SCN No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                            placeholder="SCN No."
                                                            maxlength="30"
                                                            @bind-Value="@ProductionSCNAssyVMs.SCNNo" 
                                                            readonly />

                                                <span class="input-group-text rounded-3">@ProductionSCNAssyVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => ProductionSCNAssyVMs.SCNNo)" />
                                            <ValidationMessage For="@(() => ProductionSCNAssyVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- SCN Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>SCN Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                        @bind-Value="@ProductionSCNAssyVMs.SCNDate" />
                                            <ValidationMessage For="@(() => ProductionSCNAssyVMs.SCNDate)" />
                                        </div>
                                    </div>

                                     <!-- Reference -->
                                    @if (prodReturnPendingCount > 0)
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. Return GRN</small>
                                            </label>
                                            <div class="col-12 col-sm-9 d-flex flex-wrap gap-2">
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="ShowProductionReturnDetails">
                                                    Return GRN Details
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Store Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- Store -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issue To Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    id="storeIssId"
                                                    @bind="ProductionSCNAssyVMs.IssueStoreId" disabled>
                                                <option value="0">--Select Store--</option>
                                                @foreach (var storeid in IssueStores)
                                                {
                                                    <option value="@storeid.StoreId">@storeid.StoreName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => ProductionSCNAssyVMs.IssueStoreId)" />
                                        </div>
                                    </div>

                                    <!-- Add Stores -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Add To Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    @bind="ProductionSCNAssyVMs.AddStoreId">
                                                @foreach (var store in AddStores)
                                                {
                                                    <option value="@store.StoreId">@store.StoreName</option>
                                                }
                                            </select>
                                            <ValidationMessage For="@(() => ProductionSCNAssyVMs.AddStoreId)" />
                                        </div>
                                    </div>
                                    
                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                        rows="1"
                                                        @bind="ProductionSCNAssyVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => ProductionSCNAssyVMs.MainRemark)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1900px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:120px;">AccQty</th>
                                                    <th style="width:120px;">RejQty</th>

                                                    @if (IsRejectionSelection)
                                                    {
                                                        <th style="width:200px;">RejectionCode</th>
                                                    }
                                                    <th style="width:120px;">Rej. Reason</th>
                                                    <th style="width:120px;">RewQty</th>
                                                    <th style="width:120px;">Rew. Reason</th>
                                                    <th style="width:120px;">Unit Price</th>

                                                    <th style="width:120px;">StockQty</th>

                                                    <th style="width:120px;">Ins No.</th>
                                                    <th style="width:120px;">NCR No.</th>

                                                    <th style="width:110px;">Ref Return No.</th>
                                                    <th style="width:110px;">Ref Return Date</th>

                                                    <th style="width:150px;">Cost-Center</th>

                                                    <th style="width:200px;">Remarks</th>

                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @foreach (var subitem in ProductionSCNAssyVMs.ProductionSCNAssySubVMs)
                                                {
                                                    <tr @key="subitem">
                                                        <td>@subitem.SlNo</td>



                                                        <!-- Item Code + Attachments -->
                                                        <td>
                                                            <div class="row g-1 align-items-center">
                                                                <div class="col-10">
                                                                    @subitem.ItemCode
                                                                </div>
                                                                <div class="col-2 text-center">
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                        Size="Size.Small"
                                                                                        Color="Color.Primary"
                                                                                        OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                        Edge="Edge.End"
                                                                                        Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>@subitem.ItemName</td>
                                                        <td>@subitem.MeasureUnit</td>

                                                        <!-- Acc Qty -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm text-end"
                                                                       placeholder="Acc Qty"
                                                                       min="0"
                                                                       step="any"
                                                                       @bind="subitem.AccQty"
                                                                       @bind:event="oninput"
                                                                       @bind:after="async () => await OnAccpQtyChange(subitem.AccQty, subitem)" />
                                                                <ValidationMessage For="@(() => subitem.AccQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.AccQty</span>
                                                            }
                                                        </td>

                                                        <!-- Rej Qty -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm text-end"
                                                                       placeholder="Rej Qty"
                                                                       min="0"
                                                                       step="any"
                                                                       @bind="subitem.RejQty"
                                                                       @bind:event="oninput"
                                                                       @bind:after="async () => await OnRejQtyChange(subitem.RejQty, subitem)" />
                                                                <ValidationMessage For="@(() => subitem.RejQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.RejQty</span>
                                                            }
                                                        </td>
                                                        @if (IsRejectionSelection)
                                                        {
                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <select class="form-select"
                                                                            @bind="subitem.RejectionId"
                                                                            @bind:after="() => OnRejectionChanged(subitem)">

                                                                        <option value="">-- Select Rejection --</option>

                                                                        @foreach (var rejection in RejectionMasterVMs)
                                                                        {
                                                                            <option value="@rejection.RejectionId">
                                                                                @rejection.RejectionCode
                                                                            </option>
                                                                        }
                                                                    </select>
                                                                }
                                                                else
                                                                {
                                                                    @(RejectionMasterVMs.FirstOrDefault(x => x.RejectionId == subitem.RejectionId)
                                                                                                                        ?.RejectionCode ?? "")
                                                                                                        }
                                                            </td>


                                                        }
                                                         <!-- Rej Reason -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputTextArea rows="1" @bind-Value="subitem.RejReason" class="form-control form-control-sm" placeholder="Rej. Reason" />
                                                                <ValidationMessage For="@(() => subitem.RejReason)" />

                                                            }
                                                            else
                                                            {
                                                                @subitem.RejReason
                                                            }
                                                        </td>

                                                        <!-- Rew Qty -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm text-end"
                                                                       placeholder="Rew Qty"
                                                                       min="0"
                                                                       step="any"
                                                                       @bind="subitem.RewQty"
                                                                       @bind:event="oninput"
                                                                       @bind:after="async () => await OnRewQtyChange(subitem.RewQty, subitem)" />
                                                                <ValidationMessage For="@(() => subitem.RewQty)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.RewQty</span>
                                                            }
                                                        </td>

                                                         <!-- Re-work Reason -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputTextArea rows="1" @bind-Value="subitem.RewReason" class="form-control form-control-sm" placeholder="Rework Reason" />
                                                                <ValidationMessage For="@(() => subitem.RewReason)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.RewReason
                                                            }
                                                        </td>

                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <input type="number"
                                                                       class="form-control form-control-sm text-end"
                                                                       placeholder="Unit Price"
                                                                       min="0"
                                                                       step="any"
                                                                       @bind="subitem.UnitPrice"/>
                                                                <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                            }
                                                            else
                                                            {
                                                                <span>@subitem.UnitPrice</span>
                                                            }
                                                        </td>

                                                         <!-- Stock Qty -->
                                                        <td class="fw-bold text-danger">
                                                            @subitem.StockQty
                                                        </td>
                                                         <!-- Inspection No. -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.InsNo" class="form-control form-control-sm" placeholder="Ins No." />
                                                                <ValidationMessage For="@(() => subitem.InsNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.InsNo
                                                            }
                                                        </td>
                                                         <!-- NCR No. -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputText @bind-Value="subitem.NCRNo" class="form-control form-control-sm" placeholder="NCR No." />
                                                                <ValidationMessage For="@(() => subitem.NCRNo)" />
                                                            }
                                                            else
                                                            {
                                                                @subitem.NCRNo
                                                            }
                                                        </td>

                                                        
                                                        <!-- Ref Return  -->
                                                        <td>@subitem.RefReturnNo</td>
                                                        <td>@subitem.RefReturnDate?.ToString("dd/MM/yyyy")</td>

                                                        <!-- Cost Center -->
                                                        <td>
                                                            @subitem.ProjectNo
                                                        </td>
    
                                                        <!-- Remarks -->
                                                        <td>
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <InputTextArea rows="1" @bind-Value="subitem.Remark" class="form-control form-control-sm" placeholder="Enter Remarks" />
                                                                <ValidationMessage For="@(() => subitem.Remark)" />

                                                            }
                                                            else
                                                            {
                                                                @subitem.Remark
                                                            }
                                                        </td>

                                                        <!-- Action Buttons -->
                                                        <td class="freeze-last-col text-end">
                                                            @if (subitem.IsEditable)
                                                            {
                                                                <button type="button" class="btn btn-success btn-icon btn-sm" title="Save" 
                                                                        @onclick="async () => await SaveRow(subitem)">
                                                                    <i class="bi bi-check-lg"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel" 
                                                                        @onclick="async () => await CancelEdit(subitem, ProductionSCNAssyVMs)">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit" 
                                                                        @onclick="async () => await EditRowAsync(subitem)">
                                                                    <i class="bi bi-pencil"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete" 
                                                                        @onclick="async () => await RemoveRow(subitem)">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            <div class="col-6 col-md-3 mt-3">
                                <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                    <i class="bi bi-floppy2-fill me-1"></i> @(ProductionSCNAssyVMs.SCNId > 0 ? "Update" : "Create")
                                </button>
                            </div>
                        }

                        <div class="col-6 col-md-3 mt-3">
                            <SmartBackButton Url="@($"/productionAssySCNList?currentPage={currentPage}")" />
                        </div>

                        @if (CanCreate || CanEdit && SCNId > 0)
                        {
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                    <i class="bi bi-printer me-1"></i>Print
                                </button>
                            </div>
                        }
                    </div>
                   
                </EditForm>
            </div>
        </div>
    </div>
} 


@code {

    #region Parameters & Properties

    protected override string ScreenName => "Production SCN Assembly";

    [Parameter] public int? SCNId { get; set; }

    private int screenCode { get; set; }

    private bool isProcessing = true;
    private ProductionSCNAssyVM ProductionSCNAssyVMs { get; set; } = new();
    private ProductionSCNAssySubVM? rowToDelete;
    private List<Store> IssueStores = new();
    private List<Store> AddStores = new();

    private int prodReturnPendingCount = 0;

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private string? pdfBase64;

    private bool IsSomeItemsTransMade { get; set; } = false;

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private bool IsProdreturnModalVisible = false;
    private List<Dictionary<string, object>>? ProdReturnData;
    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private List<string> ProdReturnColumns = new() { "RefReturnSubId","ReturnNo", "ReturnDate","ItemId", "ItemCode", "ItemName","MeasureUnit", "Qty","Unit Price","BalQty.","CostCenterId","ProjectNo" };
    private List<string> ProdReturnFields = new() { "RefReturnSubId","ReturnNo","ReturnDate","ItemId" ,"ItemCode", "ItemName","MeasureUnit", "Qty","UnitPrice", "BalQty","CostCenterId" ,"ProjectNo"};
    private List<string> ProdReturnHiddenColumns = new() { "RefReturnSubId", "ItemId", "CostCenterId" };


    private List<PageHeader.BreadcrumbItem> scnBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Production" },
        new PageHeader.BreadcrumbItem { Text = "Assembly" },
        new PageHeader.BreadcrumbItem { Text = "Store Credit Note (SCN)", IsLast = true }
    };


    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private bool IsRejectionSelection { get; set; } = false;

    private List<RejectionMasterVM> RejectionMasterVMs = new();

    #endregion


    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            screenCode = await productionAssySCNService.GetScreenCodeByScreenNameAsync(ScreenName);

            //////////////////vs//////////////////vs
            //IssueStores = await productionAssySCNService.GetAllIssueStoresAsync();
            ////////////////////////////////////////////////
            
            AddStores = await productionAssySCNService.GetAllAddStoresAsync();
            prodReturnPendingCount= await productionAssySCNService.GetReturnPendingCountAsync();

            IsRejectionSelection = await productionAssySCNService.GetRejectionSelectionEnableAsync();
            RejectionMasterVMs = await productionAssySCNService.GetAllRejectionReasonAsync();

            if (SCNId.HasValue)
            {
                await LoadExistingProdSCN(SCNId.Value);
            }
            else
            {
                await InitializeNewProdScn();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingProdSCN(int scnId)
    {
        try
        {
            ProductionSCNAssyVMs = await productionAssySCNService.GetProductionSCNByScnIdAsync(scnId);
            if (ProductionSCNAssyVMs == null)
            {
                await _js.ToastrWarning("Production SCN not found.");
                return;
            }

            foreach (var sub in ProductionSCNAssyVMs.ProductionSCNAssySubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[sub.ItemId.Value] =
                    await productionAssySCNService.GetCorrespondenceAttachmentsCountAsync(sub.ItemId.Value, "Item");
            }

            IsSomeItemsTransMade = await productionAssySCNService.CheckIfTransactionsMadeAsync(
                                ProductionSCNAssyVMs.ProductionSCNAssySubVMs
                                    .Where(s => s.ItemId.HasValue)
                                    .Select(s => s.ItemId!.Value)
                                    .ToList(),
                                ProductionSCNAssyVMs.AddStoreId ?? 0,
                                screenCode,
                                ProductionSCNAssyVMs.ProductionSCNAssySubVMs
                                    .Select(s => s.SCNSubId)
                                    .ToList());

            //////////////////vs
            var MapStoreForProdIssue = await productionAssySCNService.GetMappedStoreForFormAsync("PMReturnAssyForm");
            if (MapStoreForProdIssue.StoreId > 0)
            {
                //////////////////vs//////////////////vs
                IssueStores.Clear();

                IssueStores.Add(new Store
                {
                    StoreId = MapStoreForProdIssue.StoreId,
                    StoreName = MapStoreForProdIssue.StoreName
                });
                ///////////////////////////////////////////
                ProductionSCNAssyVMs.IssueStoreId = MapStoreForProdIssue.StoreId;
                ProductionSCNAssyVMs.IssueStoreName = MapStoreForProdIssue.StoreName;
            }
            else
            {
                ProductionSCNAssyVMs.IssueStoreId = null;
                ProductionSCNAssyVMs.IssueStoreName = null;
            }
            /////////////////////////////////////////
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing Production SCN.");
            await LoggingService.LogDeveloperError(ex, $"LoadExistingProductionSCN failed for scnId: {scnId}");
        }
    }

    

    private async Task InitializeNewProdScn()
    {
        try
        {
