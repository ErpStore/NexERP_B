    #region Store Handlers

    private async Task OnStoreChanged(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var newStoreId))
                return;

            ProductionSCNAssyVMs.IssueStoreId = newStoreId;

            if (newStoreId == 0)
            {
                await _js.ToastrWarning("Please select a valid Store. Store is required.");

                if (ProductionSCNAssyVMs.ProductionSCNAssySubVMs != null)
                {
                    foreach (var sub in ProductionSCNAssyVMs.ProductionSCNAssySubVMs)
                        sub.StockQty = 0;
                }

                StateHasChanged();
                return;
            }

            if (ProductionSCNAssyVMs.ProductionSCNAssySubVMs != null && ProductionSCNAssyVMs.ProductionSCNAssySubVMs.Any())
            {
                var itemIds = ProductionSCNAssyVMs.ProductionSCNAssySubVMs
                    .Where(s => s.ItemId.HasValue)
                    .Select(s => s.ItemId!.Value)
                    .Distinct()
                    .ToList();

                if (itemIds.Count == 0)
                {
                    await _js.ToastrInfo("No items found to update stock for this store.");
                    return;
                }

                var stockDict = await productionAssySCNService.GetStockForItemsAsync(itemIds, newStoreId);

                foreach (var sub in ProductionSCNAssyVMs.ProductionSCNAssySubVMs)
                {
                    if (sub.ItemId.HasValue && stockDict.TryGetValue(sub.ItemId.Value, out var qty))
                        sub.StockQty = qty;
                    else
                        sub.StockQty = 0;
                }

                await _js.ToastrSuccess("Stock quantities updated based on selected store.");
            }
            else
            {
                await _js.ToastrInfo("No sub-items available to update stock.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error occurred in OnStoreChanged while updating stock quantities.");
            await _js.ToastrError("An unexpected error occurred while updating stock. Please try again.");
        }
    }

