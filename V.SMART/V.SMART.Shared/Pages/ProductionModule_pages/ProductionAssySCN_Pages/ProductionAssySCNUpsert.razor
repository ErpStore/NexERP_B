    #region Production Assembly SCN Operations

    private async Task UpsertProdSCN()
    {
        try
        {
            isProcessing = true;

            // Remove empty/invalid rows
            ProductionSCNAssyVMs.ProductionSCNAssySubVMs.RemoveAll(x =>
                !x.ItemId.HasValue || x.ItemId == 0);

            if (!ProductionSCNAssyVMs.ProductionSCNAssySubVMs.Any())
            {
                await _js.ToastrError("Cannot save a Production SCN without valid items.");
                return;
            }

            // Validate each line
            foreach (var line in ProductionSCNAssyVMs.ProductionSCNAssySubVMs)
            {
                bool isValid = await ValidateProdSCNLineAsync(line);
                if (!isValid) return;
            }

            // Save
            var isNewProdSCN = ProductionSCNAssyVMs.SCNId == 0;

            try
            {
                await productionAssySCNService.UpsertproductionSCNAsync(ProductionSCNAssyVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewProdSCN)
                await _js.ToastrSuccess("Production SCN saved successfully.");
            else
                await _js.ToastrSuccess("Production SCN updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/productionAssySCNList");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "UpsertProdSCN failed.");
            await _js.ToastrError("Error saving quotation.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateProdSCNLineAsync(ProductionSCNAssySubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            // Qty vs Enquiry / Already Transacted validation
            if (line.SCNSubId == 0 && line.RefReturnSubId > 0)
            {
                var returnBalQty = await productionAssySCNService.GetProdReturnItemBalQtyFromReturnSubId(line.RefReturnSubId.Value);
                if (line.AccQty + line.RejQty +line.RewQty > returnBalQty)
                {
                    line.AccQty = returnBalQty;
                    line.RejQty = 0;
                    line.RewQty = 0;
                    line.BalQty = returnBalQty;
                    await _js.ToastrWarning($"Qty cannot exceed Production Return Balance Qty ({returnBalQty}).");
                }
            }
            else if (line.SCNSubId > 0)
            {
                var original = await productionAssySCNService.GetProdScnSubItemDetailByScnSubIdAsync(line.SCNSubId);
                if (original != null)
                {
                    decimal origBalQty = original.BalQty ?? 0m;
                    decimal origQty = original.AccQty ?? 0m;
                    var alreadyTransacted = origQty - origBalQty;

                    if (line.AccQty < alreadyTransacted)
                    {
                        line.AccQty = alreadyTransacted;
                        line.BalQty = 0m;
                        await _js.ToastrWarning($"AccQty cannot be less than {alreadyTransacted} (already transacted).");
                    }
                    else
                    {
                        var difference = line.AccQty.GetValueOrDefault() - origQty;
                        line.BalQty = Math.Max(0m, origBalQty + difference);
                    }
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "ValidateQuoteLineAsync failed.");
            await _js.ToastrError("Error validating quotation line.");
            return false;
        }
    }

