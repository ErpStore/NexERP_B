                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < ProductionSCNAssyVMs.ProductionSCNAssySubVMs.Count; i++)
                        ProductionSCNAssyVMs.ProductionSCNAssySubVMs[i].SlNo = i + 1;
