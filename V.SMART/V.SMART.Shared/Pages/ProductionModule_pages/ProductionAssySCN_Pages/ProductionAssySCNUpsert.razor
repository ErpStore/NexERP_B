    private async Task<decimal> GetIssueQtyAsync(ProductionSCNAssySubVM subVM)
    {
        if (subVM.RefReturnSubId is null or 0)
            return 0;

        return await productionAssySCNService.GetProdReturnItemBalQtyFromReturnSubId(subVM.RefReturnSubId.Value);
    }

    private async Task<bool> ValidateAndAdjustAsync(
                        ProductionSCNAssySubVM subVM,
                        decimal newAccp,
                        decimal newRej,
                        decimal newRew,
                        decimal stockQty,
                        string fieldName)
    {
        // 1. Issue qty balance
        var issueQty = await GetIssueQtyAsync(subVM);

        // 2. Load original saved qty (for update case)
        var original = await productionAssySCNService
            .GetSCNAssyItemDetailByScnSubIdAsync(subVM.SCNSubId);

        decimal originalAccp = original?.AccQty ?? 0;
        decimal originalRej = original?.RejQty ?? 0;
        decimal originalRew = original?.RewQty ?? 0;

        decimal originalTotal = originalAccp + originalRej + originalRew;

        // 3. Load current stock for item and store
        var currentStock = stockQty;

        // For update → stock must consider previously allocated qty
        decimal effectiveStock = currentStock + originalTotal;

        // 4. Maximum allowed qty
        decimal maxAllowedBasedOnIssue = issueQty + originalTotal;
        decimal finalMaxAllowed = Math.Min(maxAllowedBasedOnIssue, effectiveStock);

        // 5. User entered qty
        decimal enteredTotal = newAccp + newRej + newRew;

        // 6. Validate
        if (enteredTotal > finalMaxAllowed)
        {
            await _js.ToastrWarning(
                $"{fieldName} change exceeded limit. Max allowed total is {finalMaxAllowed}. Auto-adjusted.");

            // Adjust only the field user changed
            if (fieldName == "Accepted")
                subVM.AccQty = finalMaxAllowed - (newRej + newRew);

            else if (fieldName == "Rejected")
                subVM.RejQty = finalMaxAllowed - (newAccp + newRew);

            else if (fieldName == "Rework")
                subVM.RewQty = finalMaxAllowed - (newAccp + newRej);

            return false;
        }

        return true;
    }



    private async Task OnAccpQtyChange(decimal? newValue, ProductionSCNAssySubVM subVM)
    {
        try
        {
            var accp = newValue.GetValueOrDefault();
            if (accp < 0)
            {
                subVM.AccQty = 0;
                await _js.ToastrWarning("Accepted Qty must be positive.");
                return;
            }

            var rej = subVM.RejQty.GetValueOrDefault();
            var rew = subVM.RewQty.GetValueOrDefault();

            var stock = subVM.StockQty.GetValueOrDefault();

            if (await ValidateAndAdjustAsync(subVM, accp, rej, rew, stock ,"Accepted"))
                subVM.AccQty = accp;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "OnAccpQtyChange failed");
            await _js.ToastrError("Failed to update Accepted Qty.");
        }
    }

