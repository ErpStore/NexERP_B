@page "/productionReturnComp/details/{ReturnId:int}"
@using V.SMART.Shared.Services.ReportViewer

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IProductionReturnCompService prodReturnCompService
@inject ILoggingService logs
@inject IJSRuntime _js

@inject ReportService reportService

@inject NavigationManager _navigationManager


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

        <MyCompanyDetails />

        <hr class="border-2 border-primary-subtle mb-4" />
        <div class="text-center">
            <h4 class="fw-semibold mt-3">Production Component GRN Details</h4>
        </div>

        <hr class="border-2 border-primary-subtle mb-4" />



        <!-- Document Details -->
        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">

                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Document Details
                    </div>

                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>

                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Return No.</strong></td>
                                    <td>
                                        @((ProductionReturnCompVMs != null) ? $"{ProductionReturnCompVMs.ReturnNo}{ProductionReturnCompVMs.Suffix}" : "")
                                    </td>
                                </tr>

                                <tr>
                                    <td class="text-secondary"><strong>Return Dt.</strong></td>
                                    <td>@(ProductionReturnCompVMs?.ReturnDate)</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

            <!-- Production Issue Details -->
            <div class="col-md-6">
                <div class="card border-1 shadow-sm rounded-3 h-100">

                    <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                        Production GRN Details
                    </div>

                    <div class="card-body p-2 small">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>

                                <tr>
                                    <td class="text-secondary" style="width: 40%;"><strong>Added To store</strong></td>
                                    <td>@(ProductionReturnCompVMs != null ? $"{ProductionReturnCompVMs.AddStoreName}" : "")</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary"><strong>Return to Whom</strong></td>
                                    <td>@(ProductionReturnCompVMs?.ReturnBy)</td>
                                </tr>

                                <tr>
                                    <td class="text-secondary"><strong>Remarks</strong></td>
                                    <td>@($"{ProductionReturnCompVMs?.MainRemark}")</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

        <!--  Items -->
        <div class="card border-1 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                Production Issue Items
            </div>

            <div class="table-responsive" style="overflow-x:auto;">
                <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                    <thead class="custom-blue">
                        <tr>
                            <th>Sl No.</th>
                            <th>Trans Type</th>
                            <th>Item Code</th>
                            <th>Description</th>
                            <th>UOM</th>
                            <th>Process</th>
                            <th>Return Qty</th>
                            <th>Unit Price</th>

                            <th>Balance Qty</th>

                            <th>Cost Center</th>
                        </tr>
                    </thead>

                    <tbody class="custom-size">

                        @if (ProductionReturnCompVMs?.ProductionReturnCompSubVMs != null && ProductionReturnCompVMs.ProductionReturnCompSubVMs.Any())
                        {
                            @foreach (var item in ProductionReturnCompVMs.ProductionReturnCompSubVMs)
                            {
                                <tr>
                                    <td>@item.SlNo</td>
                                    <td>@(item.TransType ?? "—")</td>
                                    <td>@(item.ItemCode ?? "—")</td>
                                    <td>@(item.ItemName ?? "—")</td>
                                    <td>@item.MeasureUnit</td>
                                    <td>@(item.ProcessName ?? "—")</td>
                                    <td>@($"{item.Qty:0.###}")</td>
                                    <td>@($"{item.UnitPrice:0.###}")</td>

                                    <td>@($"{item.BalQty:0.###}")</td>

                                    <td>@item.ProjectNo</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" class="text-center text-muted">No items found</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-2 justify-content-end">
            <a href="@($"/productionCompReturnList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                <i class="bi bi-arrow-bar-left me-1"></i> Back To List
            </a>

            <a href="@($"/productionReturnComp/update/{ReturnId}")" class="btn btn-outline-primary">
                <i class="bi bi-pencil-square"></i> Modify
            </a>

            <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                <i class="bi bi-printer"></i> Print
            </button>
        </div>
    </div>

}


@code
{

    protected override string ScreenName => "Production Return Component";
    private int screenCode { get; set; }

    [Parameter]
    public int? ReturnId { get; set; }

    private bool isProcessing = true;

     //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private string? pdfBase64;

    private ProductionReturnCompVM ProductionReturnCompVMs { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }
            await LoadAllProductionCompReturns();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in Production Return Component Details OnInitializedAsync");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadAllProductionCompReturns()
    {
        try
        {
            if (ReturnId <= 0)
                return;

            var result = await prodReturnCompService.GetProductionByReturnIdAsync(ReturnId.GetValueOrDefault());

            if (result == null)
            {
                await _js.ToastrWarning("Production Return Component not found.");
                return;
            }

            // FIXED: Load into VM correctly
            ProductionReturnCompVMs = result;


        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error loading Production Return Component by ReturnId");
            await _js.ToastrError("Failed to load Production Return Component details.");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(ReturnId.GetValueOrDefault(), "ProdCompGRN.frx", "ReturnId", false, ScreenName, "Sp_Print_ProductionCompGRN");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Production Return Component details");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Production Return Component details");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
