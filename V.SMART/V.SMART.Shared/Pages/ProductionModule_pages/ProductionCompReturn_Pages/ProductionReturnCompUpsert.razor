    }

    private async Task EditRowAsync(ProductionReturnCompSubVM item)
    {
        try
        {
            item.IsEditable = true;
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"EditRowAsync failed for ReturnSubId: {item?.ReturnSubId}");
            await _js.ToastrError("Failed to edit the row. Please try again.");
        }
    }

    private async Task CancelEdit(ProductionReturnCompSubVM? item, ProductionReturnCompVM? parentProdReturnComp)
    {
        try
        {
            if (item == null || parentProdReturnComp == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.Qty.HasValue || item.Qty.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentProdReturnComp.ProductionReturnCompSubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"CancelEdit failed for ReturnSubId: {item?.ReturnSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(ProductionReturnCompSubVM item)
    {
        try
        {
            if (ProductionReturnCompVMs.ProductionReturnCompSubVMs.Count == 1 && item.ReturnSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if (item.RefRcSubId.HasValue)
            {

                var result = await prodReturnCompService.ValidateDeleteAsync(item.RefRcSubId.Value, item.ItemId.Value,
                                    item.Qty.GetValueOrDefault(), ProductionReturnCompVMs.AddStoreId.Value);

                if (!result.IsValid)
                {
                    await _js.ToastrSuccess($"{result.Message}");
                    return;
                }
            }

            //important if Stock Add Need to check the same ScreenCode An the Correct Ref. item StockExists
            var (addQty, balQty) = await prodReturnCompService.GetQtyBalQtyByStockAddAsync(
                            screenCode,
                            ProductionReturnCompVMs.AddStoreId.Value,
                            item.ItemId.Value,
                            item.ReturnSubId);

            if (addQty != balQty)
            {
                await _js.ToastrWarning($"cannot delete item '{item.ItemCode}'. Stock already used.");
                return;
            }

            if (item.ItemId == 0)
            {
                ProductionReturnCompVMs.ProductionReturnCompSubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!ProductionReturnCompVMs.ProductionReturnCompSubVMs.Any())
                    ProductionReturnCompVMs.ProductionReturnCompSubVMs = new List<ProductionReturnCompSubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"RemoveRow failed for ReturnSubId: {item?.ReturnSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

    private async Task ResetSlno()
