    #region Quantity Handlers


    private async Task OnQtyChange(ChangeEventArgs e, ProductionReturnCompSubVM SubVM)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.Qty = 0;
                SubVM.BalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            if (SubVM.ReturnSubId == 0)
            {
                if (SubVM.RefRcSubId > 0)
                {
                    var PossibleQty = SubVM.PossibleQty;

                    if (newQty <= PossibleQty)
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.Qty = PossibleQty;
                        SubVM.BalQty = PossibleQty;
                        await _js.ToastrWarning($"Qty can't be greater than Possible Route Card Qty ({PossibleQty}).");
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty;
                }
            }
            else
            {
                var original = await prodReturnCompService.GetProdReturnSubItemDetailByReturnSubIdAsync(SubVM.ReturnSubId);
                if (original == null) return;

                var alreadyTransacted = original.Qty - original.BalQty;

                if (newQty < alreadyTransacted)
                {
                    SubVM.Qty = alreadyTransacted;
                    SubVM.BalQty = 0;
                    await _js.ToastrWarning($"Qty Returned cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefRcSubId > 0)
                {
                    var PossibleQty = SubVM.PossibleQty;
                    var maxAllowedQty = original.Qty + PossibleQty.GetValueOrDefault();

                    if (newQty > maxAllowedQty.GetValueOrDefault())
                    {
                        SubVM.Qty = maxAllowedQty.GetValueOrDefault();
                        SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.Qty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
                else
                {
                    SubVM.Qty = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted;
                }
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"OnQtyChange failed for ReturnSubId: {SubVM?.ReturnSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

