            var dcSubIds = selectedItems
                .Where(x => x.ContainsKey("IssueSubId") && x["IssueSubId"] != null)
                .Select(x => Convert.ToInt32(x["IssueSubId"]))
                .Distinct()
                .ToList();

            // =============================
            // STEP 2: Fetch ALL issued data once
            // =============================
            var allDcIds = await prodReturnCompService.GetIssueIdsByIssueSubIdsAsync(dcSubIds);

            var issuedData = allDcIds.Any()
                ? await prodReturnCompService.GetproductionGrnSubVMsByIssueIdsAsync(allDcIds)
                : new List<ProductionReturnCompSubVM>();

            var issuedLookup = issuedData
                .GroupBy(x => x.ItemId)
                .ToDictionary(g => g.Key,
                    g => Math.Truncate(g.Sum(x => x.BalQty ?? 0m) * 100) / 100m);

            // =============================
            // STEP 3: Loop items
            // =============================
            foreach (var item in selectedItems)
            {
                int itemId = item.TryGetValue("ItemId", out var itemVal) && itemVal != null ? Convert.ToInt32(itemVal) : 0;
                if (itemId == 0) continue;

                int dcSubId = item.TryGetValue("IssueSubId", out var dcSubVal) && dcSubVal != null ? Convert.ToInt32(dcSubVal) : 0;

                int? poSubId = item.TryGetValue("RefPoSubId", out var dcSubVal1) && dcSubVal1 != null ? Convert.ToInt32(dcSubVal1) : null;

                decimal balQty = item.TryGetValue("BalQty", out var balVal) && balVal != null ? Convert.ToDecimal(balVal) : 0m;

                int categoryCode = item.TryGetValue("CategoryCode", out var catVal) && catVal != null ? Convert.ToInt32(catVal) : 0;
                string categoryName = item.TryGetValue("CategoryName", out var catNameVal) ? catNameVal?.ToString() ?? "" : "";

                // duplicate
                if (ProductionReturnCompVMs.ProductionReturnCompSubVMs
                    .Any(x => x.ItemId == itemId && x.RefIssueSubId == dcSubId))
                    continue;

                decimal possibleQty = 0;

                // =============================
                // CALCULATION
                // =============================
                if (!ProductionReturnCompVMs.IsManual)
                {
                    bool isSameItem = false;

                    if (poSubId.HasValue)
                        isSameItem = await prodReturnCompService.CheckIsSameAsOutItemByPoSubId(poSubId.Value);

                    // ✅ CASE 1: SAME ITEM (RUNNING BALANCE ✅)
                    if (isSameItem)
                    {
                        if (issuedLookup.TryGetValue(itemId, out decimal availableQty))
                        {
                            decimal allocatedQty = Math.Min(availableQty, balQty);

                            possibleQty = allocatedQty;

                            //  Reduce ONLY in scnBalance
                            issuedLookup[itemId] = availableQty - allocatedQty;
                        }
                        else
                        {
                            possibleQty = 0;
                        }
                    }
                    else if (categoryName == "ASSEMBLY" || categoryName == "SUB-ASSEMBLY")
                    {
                        var bomData = await prodReturnCompService.GetAssemblyItemsAsync(itemId);

                        decimal? min = null;

                        foreach (var bom in bomData)
                        {
                            decimal issuedQty = issuedLookup.TryGetValue(bom.ItemId, out var val) ? val : 0;

                            if (bom.UtilQty > 0)
                            {
                                decimal calc = issuedQty / bom.UtilQty.GetValueOrDefault();
                                min = min == null ? calc : Math.Min(min.Value, calc);
                            }
                        }

                        possibleQty = Math.Min(min ?? 0, balQty);
                    }
                    else if (categoryName == "COMPONENT")
                    {
                        var rmItems = await prodReturnCompService.GetRawMaterialItemsAsync(itemId);

                        decimal? min = null;

                        foreach (var rm in rmItems)
                        {
                            decimal issuedQty = issuedLookup.TryGetValue(rm.ItemId, out var val) ? val : 0;

                            if (rm.Weight > 0)
                            {
                                decimal calc = issuedQty / rm.Weight;
                                min = min == null ? calc : Math.Min(min.Value, calc);
                            }
                        }

                        possibleQty = Math.Min(min ?? 0, balQty);
                    }
                }
                else
                {
                    possibleQty = balQty;
                }

                // =============================
                // DATE PARSE
                // =============================
                DateTime? dcDate = null;

                if (item.TryGetValue("IssueDate", out var dateVal) && dateVal != null)
                {
                    DateTime.TryParseExact(
                        dateVal.ToString(),
                        "dd/MM/yyyy",
                        CultureInfo.InvariantCulture,
                        DateTimeStyles.None,
                        out DateTime parsed);

                    dcDate = parsed;
                }

                // =============================
                // CREATE IN ITEM
                // =============================
                var subVm = new ProductionReturnCompSubVM
                {
                    TransType = item.TryGetValue("TransType", out var tVal) ? tVal?.ToString() ?? "In" : "In",

                    ItemId = itemId,
                    ItemCode = item.TryGetValue("ItemCode", out var codeVal) ? codeVal?.ToString() : null,
                    ItemName = item.TryGetValue("ItemName", out var nameVal) ? nameVal?.ToString() : null,
                    MeasureUnit = item.TryGetValue("MeasureUnit", out var uomVal) ? uomVal?.ToString() : null,

                    CategoryCode = categoryCode,

                    Qty = Round2(possibleQty),
                    BalQty = Round2(balQty),
                    PossibleQty = Round2(possibleQty),

                    UnitPrice = item.TryGetValue("UnitPrice", out var priceVal) && priceVal != null
                                    ? Convert.ToDecimal(priceVal)
                                    : 0m,

                    RefIssueSubId = dcSubId,
                    RefIssueNo = item.TryGetValue("IssueNo", out var dcNoVal) ? dcNoVal?.ToString() : null,
                    RefIssueDate = dcDate,
                    RefPoSubId = poSubId,
                    CostId = item.TryGetValue("CostCenterId", out var costVal) && costVal != null
                                    ? Convert.ToInt32(costVal)
                                    : (int?)null,

                    ProjectNo = item.TryGetValue("ProjectNo", out var projVal) ? projVal?.ToString() : null,
                    Remark = item.TryGetValue("Remark", out var remVal) ? remVal?.ToString() : null,

                    IsEditable = true
                };

                ProductionReturnCompVMs.ProductionReturnCompSubVMs.Add(subVm);
            }

            // =============================
            // MANUAL MODE OUT ITEMS
            // =============================
            if (ProductionReturnCompVMs.IsManual && issuedData.Any())
            {
                foreach (var outItem in issuedData)
                {
                    if (ProductionReturnCompVMs.ProductionReturnCompSubVMs
                        .Any(x => x.ItemId == outItem.ItemId && x.RefIssueSubId == outItem.RefIssueSubId))
                        continue;

                    ProductionReturnCompVMs.ProductionReturnCompSubVMs.Add(new ProductionReturnCompSubVM
                    {
                        TransType = "Out",

                        RefIssueSubId = outItem.RefIssueSubId,

                        ItemId = outItem.ItemId,
                        ItemCode = outItem.ItemCode,
                        ItemName = outItem.ItemName,
                        MeasureUnit = outItem.MeasureUnit,

                        Qty = outItem.Qty,
                        PossibleQty = outItem.BalQty,
                        UnitPrice = outItem.UnitPrice,

                        RefIssueNo = outItem.RefIssueNo,
                        RefIssueDate = outItem.RefIssueDate,

                        ProjectNo = outItem.ProjectNo,
                        Remark = outItem.Remark,

                        IsEditable = true
                    });
                }
            }

            await ResetSlno();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "OnDCSelectedAsync failed.");
            await _js.ToastrError("Error processing selected DC items.");
        }
    }
     #region Cancel And Shortclose

    private async Task Cancel()
    {
        try
        {
            if (!ReturnId.HasValue || ReturnId == 0)
            {
                await _js.ToastrError("Sobcontract GRN cancel is not allowed before saving the Sobcontract GRN.");
                return;
            }
            if (IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("Some Items Transaction Are Made!.. You Can't Cancel the Complete Sobcontract GRN");
                return;
            }


            if (ProductionReturnCompVMs.ShortClose)
            {
                await _js.ToastrError("Quotation is already short closed. You can't cancel it.");
                return;
            }
          
            if(ProductionReturnCompVMs.Cancel)
            {

                var subs = await prodReturnCompService.GetProductionReturnByReturnidAsync(ProductionReturnCompVMs.ReturnId);

                if (subs == null || subs.Count == 0)
                    return;

                foreach (var sub in subs)
                {
                    if(sub.TransType =="In")
                    {
                        await prodReturnCompService.ValidateProductionIssueBalanceBeforeRevertAsync(sub,ProductionReturnCompVMs);
                    }
                }
            }

            if (!ProductionReturnCompVMs.Cancel)
            {
                ModalTitle = "Are you sure you want to Cancel this GRN?";
                btnColor = "btn-danger";
                btnText = "Yes! Cancel";
                confirmation = "Cancel";
                showCancelReasonBox = true;
            }
            else
            {
                ModalTitle = "Are you sure you want to Revert this GRN?";
                btnColor = "btn-success";
                btnText = "Yes! Revert";
                confirmation = "Revert";
                showCancelReasonBox = false;
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (InvalidOperationException ex)
        {
            ProductionReturnCompVMs= await prodReturnCompService.GetProductionByReturnIdAsync(ReturnId.Value);
            await _js.ToastrWarning(ex.Message);
            await logs.LogDeveloperError(ex, $"Qty miss-match While cancelling");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while processing the Subcontract GRN.Cancel method");
            await logs.LogDeveloperError(ex, "Error in Subcontract GRN  Cancel() method");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task AskToShortCloseAsync(ProductionReturnCompVM ProductionReturnCompVMs)
    {
        try
        {
            if (ProductionReturnCompVMs == null)
            {
                await _js.ToastrError("Invalid Subcontract GRN  selected.");
                return;
            }

            if (!ReturnId.HasValue || ReturnId == 0)
            {
                await _js.ToastrError("Subontract GRN Short Close is not allowed before saving the Subcontract GRN.");
                return;
            }

            if (ProductionReturnCompVMs.ReturnTally)
            {
                await _js.ToastrWarning("This Labour GRN is already completed. Short-close or reopen action is not allowed.");
                return;
            }

            if (ProductionReturnCompVMs.Cancel)
            {
                await _js.ToastrWarning("This Labour GRN is already cancelled. Short-close or reopen action is not allowed.");
                return;
            }

            if (!ProductionReturnCompVMs.ShortClose)
            {
                ModalTitle = "Are you sure you want to Short-Close this Subcontract GRN?";
                btnText = "Short Close";
                btnColor = "btn-danger";
                confirmation = "ShortClose";
                showCancelReasonBox = false;
            }
            else
            {
                showCancelReasonBox = false;
                ModalTitle = "Do you want to ReOpen this Subcontract GRN?";
                btnText = "Open";
                btnColor = "btn-success";
                confirmation = "ShortClose";
            }

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await _js.ToastrError("An error occurred while AskToShortCloseAsync Subcontract GRN.");
            await logs.LogDeveloperError(ex, "Error in AskToShortCloseAsync()");
        }
        finally
        {
            isProcessing = false;
        }
    }

     private async Task OnStartTimeChanged(ChangeEventArgs e, ProductionReturnCompSubVM subitem)
 {
     if (!TimeOnly.TryParse(e.Value?.ToString(), out var startTime))
         return;

     var shift = Shifts.FirstOrDefault(x => x.ShiftId == ProductionReturnCompVMs.ShiftId);
     if (shift == null)
     {
         await _js.ToastrWarning("Shift details not found. Please select a valid shift.");
         return;
     }

     // Validate start time inside shift
     bool validStart = shift.ShiftStartTime < shift.ShiftEndTime
         ? startTime >= shift.ShiftStartTime && startTime <= shift.ShiftEndTime
         : startTime >= shift.ShiftStartTime || startTime <= shift.ShiftEndTime;

     if (!validStart)
     {
         subitem.StartTime = null;
         await _js.ToastrWarning($"Start Time must be within the shift hours: {shift.ShiftStartTime} - {shift.ShiftEndTime}");   
         return;
     }

     subitem.StartTime = startTime;
 }


 private async Task OnEndTimeChanged(ChangeEventArgs e, ProductionReturnCompSubVM subitem)
 {
     if (!TimeOnly.TryParse(e.Value?.ToString(), out var endTime))
         return;

     if (subitem.StartTime == null)
     {
         await _js.ToastrWarning("Please set the Start Time before setting the End Time.");
         return;
     }

     var shift = Shifts.FirstOrDefault(x => x.ShiftId == ProductionReturnCompVMs.ShiftId);
     if (shift == null)
     {
         await _js.ToastrWarning("Shift details not found. Please select a valid shift.");
         return;
     }

     if (endTime < subitem.StartTime)
     {
         await _js.ToastrWarning("End Time cannot be earlier than Start Time.");
         return;
     }

     bool validEnd = shift.ShiftStartTime < shift.ShiftEndTime
         ? endTime <= shift.ShiftEndTime
         : endTime <= shift.ShiftEndTime || endTime >= shift.ShiftStartTime;

     if (!validEnd)
     {
         await _js.ToastrWarning($"End Time must be within the shift hours: {shift.ShiftStartTime} - {shift.ShiftEndTime}");
         return;
     }

     subitem.EndTime = endTime;

     if (subitem.StartTime.HasValue && subitem.EndTime.HasValue)
     {
         var duration = subitem.EndTime.Value - subitem.StartTime.Value;

         subitem.PlatedTime = TimeOnly.FromTimeSpan(duration);
     }
 }

