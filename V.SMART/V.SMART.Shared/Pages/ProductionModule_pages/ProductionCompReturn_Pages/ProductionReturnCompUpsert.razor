@page "/productionReturnComp/create"
@page "/productionReturnComp/update/{ReturnId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IProductionService
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.GeneralViewModel
@using V.SMART.Shared.ViewModels.PlanningViewModel.JobOrderViewModel
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionIssueWOAssyVM
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionReturnAssyViewModel
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProuctionCompViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IProductionReturnCompService prodReturnCompService
@inject ILoggingService logs
@inject IJSRuntime _js

@inject ReportService reportService
@inject NavigationManager _navigationManager

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<!--Do Detail Model-->
<DetailsModal Title="Dc Details"
              Columns="@DcColumns"
              ColumnFields="@DcFields"
              HiddenColumns="@DcHiddenColumns"
              Data="@DcData"
              IsVisible="@IsDcModalVisible"
              IsVisibleChanged="@((val) => IsDcModalVisible = val)"
              OnSelectedItems="OnDCSelectedAsync">
</DetailsModal>

<!--Po Detail Model-->
<DetailsModal Title="PO Details"
              Columns="@PoColumns"
              ColumnFields="@PoFields"
              HiddenColumns="@PoHiddenColumns"
              Data="@PoData"
              IsVisible="@IsPoModalVisible"
              IsVisibleChanged="@((val) => IsPoModalVisible = val)"
              OnSelectedItems="OnPoSelectedAsync">
</DetailsModal>

<DetailsModal Title="Route Card Details"
              Columns="@RcColumns"
              ColumnFields="@RcFields"
              HiddenColumns="@RcHiddenColumns"
              Data="@RcData"
              IsVisible="@IsRcModalVisible"
              IsVisibleChanged="@((val) => IsRcModalVisible = val)"
              OnSelectedItems="OnRcSelectedAsync">
</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@(ProductionReturnCompVMs.ReturnId > 0 ? "Update Production Return Component" : "Create Production Return Component")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@returnGRNBreadcrumbs" />
            
            <div class="card-body bg-light">
                <EditForm Model="ProductionReturnCompVMs" OnValidSubmit="UpsertProdReturnComp">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <!-- Correspondence Status -->
                    <div class="row g-3 mb-2 align-items-center">
                        @if (ProductionReturnCompVMs.ReturnId > 0 && !string.IsNullOrWhiteSpace(ProductionReturnCompVMs.ReturnNo))
                        {
                            <CorrespondenceStatus ReferenceType="Production Return Assembly"
                                                  ReferenceId="@ProductionReturnCompVMs.ReturnId"
                                                  ReferenceTypeName="@ProductionReturnCompVMs.ReturnNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">

                        <!-- =================== Document Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Document Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- Customer Autocomplete -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>M/S.*</small>
                                        </label>

                                        @if (!ReturnId.HasValue || ReturnId == 0)
                                        {
                                            <div class="col-12 col-sm-9">
                                                <MudAutocomplete T="CustomerVM"
                                                    Value="ProductionReturnCompVMs.SelectedCustomer"
                                                    ValueChanged="@(async c => await OnCustomerChanged(c))"
                                                    ToStringFunc="@(c => c?.CustName ?? string.Empty)"
                                                    SearchFunc="SearchCustomers"
                                                    Dense="true"
                                                    Variant="Variant.Outlined"
                                                    Placeholder="Search Customer"
                                                    Title="Search at least 3 letters in Customer"
                                                    Class="w-100 autocomplete-sm"
                                                    MaxItems="50"
                                                    Clearable="true"
                                                    ResetValueOnEmptyText="true" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-12 col-sm-9">
                                                <input type="text"
                                                        class="form-control form-control-sm rounded-3"
                                                        @bind="ProductionReturnCompVMs.CustName"
                                                        readonly />
                                            </div>
                                        }
                                    </div>
                                    @if (PoWiseDcOut && !ProductionReturnCompVMs.IsWithoutPoDc)
                                    {
                                        <div class="row g-2">

                                            <!-- LEFT : PO LIST -->
                                            <div class="col-6">
                                                <div class="d-flex align-items-center gap-2 mb-1">

                                                    <!-- Search -->
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           style="flex:1;"
                                                           placeholder="@(ProductionReturnCompVMs.IsWithoutPoDc ? "Search Ref Dc No." : "Search PO No.")"
                                                           @bind="SearchTextPo"
                                                           @bind:event="oninput" />

                                                    <!-- Select All -->
                                                    <div class="form-check m-0">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@IsAllPoSelected"
                                                               @onchange="ToggleAllPO" />
                                                        <label class="form-check-label small fw-semibold">
                                                            All
                                                        </label>
                                                    </div>

                                                </div>

                                                <div class="border rounded-3 p-2 po-scroll" style="height: 90px; overflow-y: auto;">
                                                    @if (ProductionReturnCompVMs.IsWithoutPoDc)
                                                    {
                                                        @foreach (var dc in FilteredDc)
                                                        {
                                                            <div class="form-check border-bottom py-1 @(dc.IsSelected ? "bg-light" : "")"
                                                                 @key="dc.IssueId">
                                                                <input type="checkbox"
                                                                       class="form-check-input"
                                                                       id="@dc.IssueId"
                                                                       checked="@dc.IsSelected"
                                                                       @onchange="e => OnDCCheckedChanged(dc, (bool)e.Value)" />
                                                                <label class="form-check-label ms-1 small fw-semibold"
                                                                       for="po_@dc.IssueId">
                                                                    @dc.IssueNo
                                                                </label>
                                                            </div>
                                                        }

                                                    }
                                                    else
                                                    {

                                                        @foreach (var po in FilteredPos)
                                                        {
                                                            <div class="form-check border-bottom py-1 @(po.IsSelected ? "bg-light" : "")"
                                                                 @key="po.PoId">
                                                                <input type="checkbox"
                                                                       class="form-check-input"
                                                                       id="po_@po.PoId"
                                                                       checked="@po.IsSelected"
                                                                       @onchange="e => OnPoCheckedChanged(po, (bool)e.Value)" />
                                                                <label class="form-check-label ms-1 small fw-semibold"
                                                                       for="po_@po.PoId">
                                                                    @po.PONo
                                                                </label>
                                                            </div>
                                                        }

                                                    }

                                                </div>
                                            </div>

                                            <!-- RIGHT : SCN LIST -->
                                            <div class="col-6">
                                                <div class="d-flex align-items-center gap-2 mb-1">

                                                    <!-- Search -->
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           style="flex:1;"
                                                           placeholder="Search GRN No..."
                                                           @bind="SearchTextDc"
                                                           @bind:event="oninput" />

                                                    <!-- Select All -->
                                                    <div class="form-check m-0">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@IsAllGRNSelected"
                                                               @onchange="ToggleAllGRN" />
                                                        <label class="form-check-label small fw-semibold ms-1">
                                                            All
                                                        </label>
                                                    </div>

                                                </div>


                                                <div class="border rounded-3 p-2 po-scroll" style="height: 90px; overflow-y: auto;">
                                                    @if (DcOuts.Count > 0)
                                                    {
                                                        @foreach (var scn in FilteredDc)
                                                        {
                                                            <div class="form-check border-bottom py-1 @(scn.IsSelected ? "bg-light" : "")"
                                                                 @key="scn.IssueId">
                                                                <input type="checkbox"
                                                                       class="form-check-input"
                                                                       id="scn_@scn.IssueId"
                                                                       @bind="scn.IsSelected" />
                                                                <label class="form-check-label ms-1 small fw-semibold"
                                                                       for="scn_@scn.IssueId">
                                                                    @scn.IssueNo
                                                                </label>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="text-muted small text-center py-3">
                                                            No Dc Outgoing available
                                                        </div>
                                                    }
                                                </div>

                                                <div class="text-end mt-2">
                                                    <button type="button"
                                                            class="btn btn-sm btn-primary"
                                                            disabled="@(!DcOuts.Any(p => p.IsSelected))"
                                                            @onclick="Loadpos">
                                                        @(!ProductionReturnCompVMs.IsWithoutPoDc ? "Load POs" : "Load GRN")
                                                    </button>
                                                </div>
                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. DC</small>
                                            </label>
                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowDcDetails">
                                                    <i class="bi bi-list-ul me-1"></i> DC Details
                                                </button>
                                            </div>
                                        </div>
                                        <!-- PO Details -->
                                        @* <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Ref. PO</small>
                                            </label>
                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowPoDetails">
                                                    <i class="bi bi-list-ul me-1"></i> PO Details
                                                </button>
                                            </div>
                                        </div> *@
                                    }

                                    @if (jobOrderPendingCount >0)
                                    {

                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Route Card</small>
                                            </label>
                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-warning w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowRcDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Route Card Details
                                                </button>
                                            </div>
                                        </div>
                                        

                                        <div class="mb-3 row">
                                            <label class="col-12 col-sm-3 col-form-label fw-semibold text-dark pt-2">
                                                <small>Options</small>
                                            </label>

                                            <div class="col-12 col-sm-9 d-flex align-items-center gap-4">

                                                <!-- Rejection Switch -->
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           role="switch"
                                                           id="rejSwitch"
                                                           checked="@ProductionReturnCompVMs.Rejection"
                                                           @onchange="OnRejectionChanged"
                                                           disabled="@IsBothDisabled">
                                                    <label class="form-check-label fw-medium 
                                                            @(ProductionReturnCompVMs.Rejection ? "text-danger fw-bold" : "text-dark")"
                                                            for="rejSwitch">
                                                            Rejection
                                                    </label>
                                                </div>

                                                <!-- Return Switch -->
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           role="switch"
                                                           id="returnSwitch"
                                                           checked="@ProductionReturnCompVMs.Return"
                                                           @onchange="OnReturnChanged"
                                                           disabled="@IsBothDisabled">

                                                    <label class="form-check-label fw-medium
                                                        @(ProductionReturnCompVMs.Return ? "text-success fw-bold" : "text-dark")"
                                                           for="returnSwitch">
                                                        Return
                                                    </label>
                                                </div>

                                            </div>
                                        </div>
                                    }

                                       @if(IsProductionlog)
   {
       <!--For Sharadha Customization-->
       <!-- Shift -->
       <div class="mb-2 row">
           <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
               <small>Shift</small>
           </label>
           <div class="col-12 col-sm-9">
               <select class="form-select form-select-sm rounded-3 w-100" @bind="ProductionReturnCompVMs.ShiftId">
                   @* disabled="@(ProductionReturnCompVMs.Rejection)"> *@
                   <option value="">-- Select Shift --</option>
                   @foreach (var shift in Shifts)
                   {
                       <option value="@shift.ShiftId">@shift.ShiftName</option>
                   }
               </select>

           </div>
       </div>

       <!--Process-->
       <div class="mb-2 row">
           <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
               <small>Process</small>
           </label>
           <div class="col-12 col-sm-9">
               <select class="form-select form-select-sm rounded-3 w-100" @bind="ProductionReturnCompVMs.ProcessId">
                   @* disabled="@(ProductionReturnCompVMs.Rejection)"> *@
                   <option value="">-- Select Process --</option>
                   @foreach (var process in ProcessList)
                   {
                       <option value="@process.ProcessId"
                               selected="@(process.ProcessId == ProductionReturnCompVMs.ProcessId)">
                           @process.ProcessName
                       </option>
                   }
               </select>

           </div>
       </div>
   }
                                </div>
                            </div>
                        </div>


                        <!-- =================== Production Material Issue Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                   <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Production Return Details</span>
                                    @if (ProductionReturnCompVMs.ReturnId > 0)
                                    {
                                        <div class="d-flex gap-2">
                                            <button type="button"
                                                    class="btn btn-sm rounded-3 @(ProductionReturnCompVMs.Cancel ? "btn-success" : "btn-danger")"
                                                    @onclick="Cancel">

                                                @if (!ProductionReturnCompVMs.Cancel)
                                                {
                                                    <i class="bi bi-x-circle me-1"></i> <span>Cancel</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> <span>Revert</span>
                                                }
                                            </button>
                                            <!-- Short Close / Re-Open -->
                                            <button type="button"
                                                class="btn btn-sm rounded-3 @(ProductionReturnCompVMs.ShortClose ? "btn-success" : "btn-warning")"
                                                @onclick="() => AskToShortCloseAsync(ProductionReturnCompVMs)"
                                                disabled="@ProductionReturnCompVMs.Cancel">

                                                @if (!ProductionReturnCompVMs.ShortClose)
                                                {
                                                    <i class="bi bi-box-seam me-1"></i>
                                                    <span>Short Close</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    <span>Re-Open</span>
                                                }
                                            </button>
                                        </div>
                                    }


                                </div>


                                <div class="card-body">

                                <div class="row g-2 mb-2 align-items-stretch">

                                    <!-- No Inspection -->
                                    <div class="col-12 col-sm-4">
                                        <div class="card shadow-sm border-2
                                             @(ProductionReturnCompVMs.IsNoInspection
                                                                                              ? "border-success bg-success-subtle selected-card"
                                                                                              : "border-light")
                                                                                                               @(ProductionReturnCompVMs.ReturnId > 0 ? "disabled-card" : "")"
                                                                                                               style="cursor:@(ProductionReturnCompVMs.ReturnId > 0 ? "not-allowed" : "pointer"); height:60px;"
                                                                                                               @onclick="ProductionReturnCompVMs.ReturnId > 0 ? null : (() => ToggleNoInspection(true))">

                                            <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                <i class="bi
                                                    @(ProductionReturnCompVMs.IsNoInspection
                                                                                                           ? "bi-check-circle-fill text-success"
                                                                                                           : "bi-circle text-muted") me-2"></i>

                                                <span class="fw-semibold
                                                    @(ProductionReturnCompVMs.IsNoInspection
                                                                                                              ? "text-success"
                                                                                                              : "text-dark")">
                                                                                                                          No Inspection
                                                                                                                      </span>
                                                                                                                  </div>
                                                                                                              </div>
                                                                                                          </div>

                                    <!-- Manual Selection -->
                                    <div class="col-12 col-sm-4">
                                        <div class="card shadow-sm border-2
                                             @(ProductionReturnCompVMs.IsManual
                                                                                              ? "border-success bg-success-subtle selected-card"
                                                                                              : "border-light")
                                                                                                               @(ProductionReturnCompVMs.ReturnId > 0 ? "disabled-card" : "")"
                                                                                                               style="cursor:@(ProductionReturnCompVMs.ReturnId > 0 || ProductionReturnCompVMs.Return ? "not-allowed" : "pointer"); height:60px;"
                                                                                                               @onclick="ProductionReturnCompVMs.ReturnId > 0 || ProductionReturnCompVMs.Return ? null : (() => ToggleManualSelection(true))">

                                            <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                <i class="bi
                                                    @(ProductionReturnCompVMs.IsManual
                                                                                                           ? "bi-check-circle-fill text-success"
                                                                                                           : "bi-circle text-muted") me-2"></i>

                                                <span class="fw-semibold
                                                    @(ProductionReturnCompVMs.IsManual
                                                                                                              ? "text-success"
                                                                                                              : "text-dark")">
                                                    Manual Selection
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    @if (PoWiseDcOut)
                                        {
                                            <!-- Without PO -->
                                            <div class="col-12 col-sm-4">
                                                <div class="card shadow-sm border-2
                                                    @(ProductionReturnCompVMs.IsWithoutPoDc
                                                                                                     ? "border-warning bg-warning-subtle selected-card"
                                                                                                     : "border-light")
                                                                                                                     @(ProductionReturnCompVMs.ReturnId > 0 ? "disabled-card" : "")"
                                                                                                                      style="cursor:@(ProductionReturnCompVMs.ReturnId > 0 ? "not-allowed" : "pointer"); height:60px;"
                                                                                                                      @onclick="ProductionReturnCompVMs.ReturnId > 0 ? null : (() => ToggleIsWithoutPoDc(true))">

                                                    <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                        <i class="bi
                                                        @(ProductionReturnCompVMs.IsWithoutPoDc
                                                                                                               ? "bi-check-circle-fill text-warning"
                                                                                                               : "bi-circle text-muted") me-2"></i>

                                                        <span class="fw-semibold
                                                        @(ProductionReturnCompVMs.IsWithoutPoDc
                                                                                                                  ? "text-warning"
                                                                                                                  : "text-dark")">
                                                    Without PO
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                                                        }

                                    </div>
                                    @* <div class="row g-2 mb-2 align-items-stretch">
                                        <!-- No Inspection -->
                                        <div class="col-12 col-sm-6">
                                            <div class="card shadow-sm border-2 @(ProductionReturnCompVMs.IsNoInspection ? "border-success bg-success-subtle" : "border-light")"
                                                 style="cursor:pointer; height:60px;"
                                                 @onclick="() => ToggleNoInspection(true)">
                                                <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                    <i class="bi bi-check-circle-fill text-dark me-2"></i>
                                                    <span class="fw-semibold text-dark">
                                                        No Inspection
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> *@
                                    
                                    <!-- Material Return No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Material Return No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                           placeholder="Material Return No."
                                                           maxlength="30"
                                                           @bind-Value="@ProductionReturnCompVMs.ReturnNo"
                                                           readonly />

                                                <span class="input-group-text rounded-3">@ProductionReturnCompVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => ProductionReturnCompVMs.ReturnNo)" />
                                            <ValidationMessage For="@(() => ProductionReturnCompVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- Material Return Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Material Return Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@ProductionReturnCompVMs.ReturnDate" />
                                            <ValidationMessage For="@(() => ProductionReturnCompVMs.ReturnDate)" />
                                        </div>
                                    </div>

                                    <!-- Stores -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Add To Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    disabled>
                                                    @* disabled="@(ProductionReturnCompVMs.Rejection)"> *@
                                                @foreach (var store in Stores)
                                                {
                                                    <option value="@store.StoreId"
                                                            selected="@(store.StoreId == ProductionReturnCompVMs.AddStoreId)">
                                                        @store.StoreName
                                                    </option>
                                                }
                                            </select>

                                        </div>
                                    </div>

                                      <!-- Issue To Whom -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Return To </small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   @bind="ProductionReturnCompVMs.ReturnBy"/>
                                            <ValidationMessage For="@(() => ProductionReturnCompVMs.ReturnBy)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="ProductionReturnCompVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => ProductionReturnCompVMs.MainRemark)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>


                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1"
                                 style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0"
                                               style="table-layout: fixed; min-width: 1700px;">

