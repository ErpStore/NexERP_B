    private async Task UpsertProdReturnComp()
    {
        try
        {
            isProcessing = true;

            ProductionReturnCompVMs.ProductionReturnCompSubVMs.RemoveAll(x => !x.ItemId.HasValue || !x.Qty.HasValue || x.Qty == 0);

            if (!ProductionReturnCompVMs.ProductionReturnCompSubVMs.Any())
            {
                await _js.ToastrError("Cannot save a Job Order without valid items.");
                return;
            }

            foreach (var line in ProductionReturnCompVMs.ProductionReturnCompSubVMs)
            {
                bool isValid = await ValidateProdReturnSubAsync(line, ProductionReturnCompVMs);
                if (!isValid) return;
            }

            // Save
            var isNewProdIsssue = ProductionReturnCompVMs.ReturnId == 0;

            try
            {
                await prodReturnCompService.UpsertProductionReturnAsync(ProductionReturnCompVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewProdIsssue)
                await _js.ToastrSuccess("Production Return Component saved successfully.");
            else
                await _js.ToastrSuccess("Production Return Component updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/productionCompReturnList");
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "UpsertProdReturnComp failed.");
            await _js.ToastrError("Error saving Production Return Component.");
        }
        finally
        {
            isProcessing = false;
        }
    }

