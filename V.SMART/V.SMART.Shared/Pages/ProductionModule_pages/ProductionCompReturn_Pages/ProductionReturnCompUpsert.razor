    private async Task LoadExistingProductionReturnComp(int returnId)
    {
        try
        {
            ProductionReturnCompVMs =
                await prodReturnCompService.GetProductionByReturnIdAsync(returnId);

            if (ProductionReturnCompVMs == null)
            {
                await _js.ToastrWarning("Production Return Component not found.");
                return;
            }


            if (ProductionReturnCompVMs.CustId.HasValue)
            {

            SelectedCustomer = await prodReturnCompService.GetCustomerByIdAsync(ProductionReturnCompVMs.CustId.Value);
            if (SelectedCustomer != null)
                await ApplyCustomerSelectionAsync(SelectedCustomer);

            }

            bool isReturnOrRejection =
                ProductionReturnCompVMs.Return || ProductionReturnCompVMs.Rejection;

            foreach (var sub in ProductionReturnCompVMs.ProductionReturnCompSubVMs)
            {
                decimal balQty = sub.BalQty ?? 0m;
                decimal possibleQty = balQty;

                // =====================================================
                // CASE 1: NORMAL FLOW (NOT Return / Rejection)
                // =====================================================
                if (!isReturnOrRejection && sub.RefPoSubId.HasValue && sub.RefPoSubId > 0)
                {
                    var issueIds =
                        await prodReturnCompService.GetIssueIdsByPoSubIdAsync(sub.RefPoSubId.Value);

                    var issuedData = issueIds.Any()
                        ? await prodReturnCompService.GetIssuedQtyByIssueIdsAsync(issueIds)
                        : new List<ProductionIssueCompSubVM>();

                    var issuedLookup = issuedData
                        .Where(x => x.ItemId.HasValue)
                        .ToDictionary(x => x.ItemId!.Value, x => x.BalQty ?? 0m);

                    // Assembly / Sub-Assembly
                    if (sub.CategoryCode == 3 || sub.CategoryCode == 7)
                    {
                        var bomData = await _unitOfWork.AssmblyDefs
                            .GetQueryable()
                            .Where(x => x.AssmblyID == sub.ItemId)
                            .Select(x => new { x.ItemId, x.UtilQty })
                            .ToListAsync();

                        decimal? minPossible = null;

                        foreach (var bom in bomData)
                        {
                            issuedLookup.TryGetValue(bom.ItemId, out var issuedQty);

                            if (bom.UtilQty > 0)
                            {
                                var possible = issuedQty / bom.UtilQty;
                                minPossible = minPossible == null
                                    ? possible
                                    : Math.Min(minPossible.Value, possible);
                            }
                        }

                        possibleQty = Math.Min(minPossible ?? 0m, balQty);
                    }
                    // 🔹 Component
                    else if (sub.ItemId.HasValue)
                    {
                        issuedLookup.TryGetValue(sub.ItemId.Value, out var issuedQty);
                        possibleQty = Math.Min(issuedQty, balQty);
                    }
                }

                // =====================================================
                //  CASE 2: RETURN / REJECTION (RC-based)
                // =====================================================
                else if (!isReturnOrRejection && sub.RefRcSubId.HasValue && sub.RefRcSubId > 0)
                {
                    var issueIds =
                        await prodReturnCompService.GetIssueIdsByRcSubIdAsync(sub.RefRcSubId.Value);

                    if (issueIds.Any())
                    {
                        var issuedData =
                            await prodReturnCompService.GetIssuedQtyByIssueIdsAsync(issueIds);

                        var rcData =
                            await prodReturnCompService.GetRcDetailsByRcSubIdAsync(sub.RefRcSubId.Value);

                        if (rcData != null)
                        {
                            decimal utility =
                                rcData.SeqNo == 1
                                    ? rcData.RouteCard?.RMWeight ?? 1m
                                    : 1m;

                            possibleQty = Math.Min(
                                issuedData.Sum(x => x.BalQty ?? 0m) * utility,
                                balQty
                            );
                        }
                    }
                }

                // =====================================================
                //  CASE 3: DIRECT ISSUE RETURN (IssueSub based)
                // =====================================================
                else if (isReturnOrRejection && sub.RefIssueSubId.HasValue && sub.RefIssueSubId > 0)
                {
                    var issueBalQty =
                        await prodReturnCompService.GetIssueBalQtyByIssueSubId(sub.RefIssueSubId.Value);

                    possibleQty = issueBalQty.GetValueOrDefault();
                }

                // =====================================================
                //  FINAL SAFETY
                // =====================================================
                if (possibleQty < 0)
                    possibleQty = 0;

                sub.PossibleQty = Math.Round(possibleQty, 3);
                //sub.Qty = Math.Min(sub.Qty ?? sub.PossibleQty.Value, sub.PossibleQty.Value);
            }

            // 🔹 Attachment count
            foreach (var prodSub in ProductionReturnCompVMs.ProductionReturnCompSubVMs.Where(x => x.ItemId.HasValue))
            {
                attachmentCounts[prodSub.ItemId.Value] =
                    await prodReturnCompService
                        .GetCorrespondenceAttachmentsCountAsync(prodSub.ItemId.Value, "Item");
            }

            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing Production Return Component.");
            await logs.LogDeveloperError(ex,
                $"LoadExistingProductionReturn failed for ReturnId: {returnId}"
            );
        }
    }




    private bool CheckIsTransMade()
    {
        var list = ProductionReturnCompVMs?.ProductionReturnCompSubVMs;
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalQty += list[i].Qty.GetValueOrDefault();
            totalBalQty += list[i].BalQty.GetValueOrDefault();
        }

        return totalQty != totalBalQty;
    }

    private async Task InitializeNewProductionReturnComp()
    {
        try
        {
            if (ProductionReturnCompVMs == null)
                ProductionReturnCompVMs = new ProductionReturnCompVM();

            ProductionReturnCompVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            ProductionReturnCompVMs.ReturnNo = await prodReturnCompService.GetProductionReturnNumberAsync(ProductionReturnCompVMs.Suffix);

            var MapStoreForProdReturn = await prodReturnCompService.GetMappedStoreForFormAsync("PMReturnForm");
            if (MapStoreForProdReturn.StoreId > 0)
            {
                //////////////////vs//////////////////vs
                Stores.Clear();
                Stores.Add(new Store
                {
                    StoreId = MapStoreForProdReturn.StoreId,
                    StoreName = MapStoreForProdReturn.StoreName
                });
                ////////////////////////////////////////

                ProductionReturnCompVMs.AddStoreId = MapStoreForProdReturn.StoreId;
                ProductionReturnCompVMs.AddStoreName = MapStoreForProdReturn.StoreName;
            }
            else
            {
                ProductionReturnCompVMs.AddStoreId = null;
                ProductionReturnCompVMs.AddStoreName = null;
            }
            if (CustId.HasValue)
            {
                SelectedCustomer = await prodReturnCompService.GetCustomerByIdAsync(CustId.Value);
                if (SelectedCustomer != null)
                {
                    await ApplyCustomerSelectionAsync(SelectedCustomer);
                }
            }



        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new Production Return Number.");
            await logs.LogDeveloperError(ex, "InitializeNewProductionReturnAssy failed");
        }
    }

