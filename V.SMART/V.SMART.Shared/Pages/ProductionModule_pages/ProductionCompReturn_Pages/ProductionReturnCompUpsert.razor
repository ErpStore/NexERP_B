    #region Rejection And Return Toggle

    private bool IsBothDisabled =>
        ProductionReturnCompVMs.ProductionReturnCompSubVMs
            ?.Any(x => !string.IsNullOrEmpty(x.ItemCode)) == true;


    private async Task OnRejectionChanged(ChangeEventArgs args)
    {
        if (IsBothDisabled)
            return;

        ProductionReturnCompVMs.Rejection = !ProductionReturnCompVMs.Rejection;

        if (ProductionReturnCompVMs.Rejection)
