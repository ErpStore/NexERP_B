    private async Task OnPoSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (ProductionReturnCompVMs.ProductionReturnCompSubVMs == null)
            ProductionReturnCompVMs.ProductionReturnCompSubVMs = new List<ProductionReturnCompSubVM>();

        int custid = ProductionReturnCompVMs.CustId.Value;

        if (ProductionReturnCompVMs.AddStoreId == 0)
        {
            await _js.ToastrWarning("Please select Production Store");
            return;
        }
        int storeissueid = ProductionReturnCompVMs.AddStoreId.Value;
        var selectedDcIds = DcOuts.Where(p => p.IsSelected).Select(p => p.IssueId).ToList();

        try
        {

            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            if (!ProductionReturnCompVMs.Return)
            {

                foreach (var item in selectedItems)
                {
                    if (!item.ContainsKey("ItemId") || item["ItemId"] == null)
                        continue;

                    int itemId = Convert.ToInt32(item["ItemId"]);
                    int poSubId = item.ContainsKey("PoSubId") && item["PoSubId"] != null ? Convert.ToInt32(item["PoSubId"]) : 0;
                    decimal balQty = item.ContainsKey("BalQty") && item["BalQty"] != null ? Convert.ToDecimal(item["BalQty"]) : 0m;

                    int CategoryCode = item.ContainsKey("CategoryCode") && item["CategoryCode"] != null ? Convert.ToInt32(item["CategoryCode"]) : 0;
                    string categoryName = item.ContainsKey("Category") ? item["Category"]?.ToString() ?? "" : "";

                    if (ProductionReturnCompVMs.ProductionReturnCompSubVMs
                        .Any(x => x.ItemId == itemId && x.RefPoSubId == poSubId))
                        continue;

                    var issueIds = await prodReturnCompService.GetIssueIdsByPoSubIdAsync(poSubId);

                    var issuedData = issueIds.Any() ? await prodReturnCompService.GetIssuedQtyByIssueIdsAsync(issueIds) : new List<ProductionIssueCompSubVM>();

                    var issuedLookup = issuedData.ToDictionary(x => x.ItemId, x => x.BalQty);

                    decimal possibleQty = 0;

                    selectedDCids = selectedDcIds;


                    if (!ProductionReturnCompVMs.IsManual)
                    {
                        if (categoryName == "ASSEMBLY" || categoryName == "SUB-ASSEMBLY")
                        {
                            var bomData = await _unitOfWork.AssmblyDefs.GetQueryable()
                                .Where(x => x.AssmblyID == itemId)
                                .Select(x => new
                                {
                                    x.ItemId,
                                    x.UtilQty
                                })
                                .ToListAsync();

                            decimal? minPossible = null;

                            foreach (var bom in bomData)
                            {
                                issuedLookup.TryGetValue(bom.ItemId, out decimal? issuedQty);

                                if (bom.UtilQty > 0)
                                {
                                    var possible = issuedQty / bom.UtilQty;
                                    if (minPossible == null || possible < minPossible)
                                        minPossible = possible;
                                }
                            }

                            possibleQty = Math.Min(minPossible ?? 0, balQty);
                        }
                        else if (categoryName == "COMPONENT")
                        {
                            var compMasterQuery = _unitOfWork.CompMasters
                                .GetQueryable()
                                .Where(x => x.CompItemId == itemId);

                            var compMasterData = await compMasterQuery
                                .Where(x => x.IsDefaultRM)
                                .Select(x => new
                                {
                                    x.RMId,
                                    x.Weight
                                })
                                .ToListAsync();

                            if (!compMasterData.Any())
                            {
                                compMasterData = await compMasterQuery
                                    .OrderByDescending(x => x.Id)
                                    .Take(1)
                                    .Select(x => new
                                    {
                                        x.RMId,
                                        x.Weight
                                    })
                                    .ToListAsync();
                            }

                            if (!compMasterData.Any())
                            {
                                possibleQty = 0;
                            }
                            else
                            {
                                decimal? minPossible = null;

                                foreach (var comp in compMasterData)
                                {
                                    issuedLookup.TryGetValue(comp.RMId, out decimal? issuedQty);

                                    if (comp.Weight > 0)
                                    {
                                        var possible = (issuedQty ?? 0) / comp.Weight;

                                        if (minPossible == null || possible < minPossible)
                                            minPossible = possible;
                                    }
                                }

                                possibleQty = Math.Min(minPossible ?? 0, balQty);
                            }
                        }
                    }
                    else
                    {
                        possibleQty = balQty;

                    }
                    var subVm = new ProductionReturnCompSubVM
                        {
                            TransType = item.ContainsKey("TransType")
                                            ? item["TransType"]?.ToString() ?? "In"
                                            : "In",

                            ItemId = itemId,
                            ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : null,
                            ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : null,
                            MeasureUnit = item.ContainsKey("UOM") ? item["UOM"]?.ToString() : null,
                            CategoryCode = CategoryCode,

                            Qty = possibleQty,
                            BalQty = balQty,
                            PossibleQty = possibleQty,
                            UnitPrice = item.ContainsKey("UnitPrice") && item["UnitPrice"] != null
                                            ? Convert.ToDecimal(item["UnitPrice"])
                                            : 0m,

                            RefPoSubId = poSubId,
                            RefPoNo = item.ContainsKey("PoNo") ? item["PoNo"]?.ToString() : null,
                            RefPoDate = item.ContainsKey("PoDate") && item["PoDate"] != null
                                            ? Convert.ToDateTime(item["PoDate"])
                                            : null,

                            CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                                            ? Convert.ToInt32(item["CostCenterId"])
                                            : (int?)null,

                            ProjectNo = item.ContainsKey("ProjectNo")
                                            ? item["ProjectNo"]?.ToString()
                                            : null,

                            Remark = item.ContainsKey("Remark")
                                            ? item["Remark"]?.ToString()
                                            : null,

                            IsEditable = true
                        };

                    ProductionReturnCompVMs.ProductionReturnCompSubVMs.Add(subVm);
                }
            }
            else
            {
                selectedDCids = selectedDcIds;
            }


            var receivedDatas = selectedDCids.Any() ? await prodReturnCompService.GetProductionCompQtyByIssueIdsAsync(selectedDCids) : new List<ProductionIssueCompSubVM>();///selectedSCNIds.Any() ? await prodReturnCompService.GetDcIdsByDcSubIdsAsync(selectedSCNIds) : new List<SubConGRNSubVM>();


            var itemIdss = receivedDatas
                        .Where(x => x.ItemId.HasValue)
                            .Select(x => x.ItemId.Value)
                            .Distinct()
                            .ToList();

            // If  Manual
            if (ProductionReturnCompVMs.IsManual)
            {
                if (receivedDatas != null && receivedDatas.Any())
                {

                    List<ProductionIssueCompSubVM> receivedData;
                    receivedData = await prodReturnCompService.GetProductionIssueQtyByDcIdsAsync(selectedDcIds);

                    var receivedLookup = receivedData
                        .GroupBy(x => x.ItemId)
                        .ToDictionary(g => g.Key, g => g.Sum(x => x.BalQty ?? 0));


                    foreach (var item in selectedItems)
                    {
                        int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                            ? Convert.ToInt32(item["ItemId"])
                            : 0;

                        int? poSubId = item.ContainsKey("PoSubId") && item["PoSubId"] != null
                            ? Convert.ToInt32(item["PoSubId"])
                            : (int?)null;

                        int? categoryCode = item.ContainsKey("CategoryCode") && item["CategoryCode"] != null
                            ? Convert.ToInt32(item["CategoryCode"])
                            : (int?)null;


                        int? RefRcSubId = item.ContainsKey("RefRcSubId") && item["RefRcSubId"] != null
                         ? Convert.ToInt32(item["RefRcSubId"])
                         : (int?)null;

                        List<int> allowedItemIds = new();

                        if (!ProductionReturnCompVMs.Return && RefRcSubId == null)
                        {
                            if (categoryCode == 3 || categoryCode == 7)
                            {
                                var bomData = await prodReturnCompService.GetAssemblyItemsAsync(itemId);

                                if (bomData.Any())
                                    allowedItemIds = bomData.Select(x => x.ItemId.Value).ToList();
                            }
                            else if (categoryCode == 2)
                            {
                                var compData = await prodReturnCompService.GetRawMaterialItemsAsync(itemId);

                                if (compData.Any())
                                    allowedItemIds = compData.Select(x => x.ItemId).ToList();

                            }
                        }
                        else
                        {
                            allowedItemIds.Add(itemId);
                        }

                        var filteredReceived = !allowedItemIds.Any()
                            ? receivedDatas.ToList()
                            : receivedDatas
                                .Where(r => r.ItemId.HasValue && allowedItemIds.Contains(r.ItemId.Value))
                                .ToList();


                        // var filteredReceived = receivedDatas
                        //     .Where(r => r.ItemId.HasValue && allowedItemIds.Contains(r.ItemId.Value))
                        //     .ToList();


                        foreach (var outItem in filteredReceived)
                        {

                            if (ProductionReturnCompVMs.ProductionReturnCompSubVMs
                                .Any(x => x.ItemId == outItem.ItemId && x.RefIssueSubId == outItem.IssueSubId))
                                continue;

                            var outVm = new ProductionReturnCompSubVM
                            {
                                RefIssueSubId = outItem.IssueSubId,
                                ItemId = outItem.ItemId ?? 0,
                                ItemCode = outItem.ItemCode,
                                ItemName = outItem.ItemName,
                                MeasureUnit = outItem.MeasureUnit,

                                UnitPrice = outItem.UnitPrice??0,

                                ProjectNo = outItem.ProjectNo,
                                RefPoSubId = outItem.RefPoSubId,
                                IsEditable = false
                            };

                            if (!ProductionReturnCompVMs.Return)
                            {
                                outVm.TransType = "Out";
                            }
                            else
                            {
                                outVm.TransType = "In";
                            }

                            outVm.BalQty = outItem.BalQty ?? 0;
                            outVm.Qty = outItem.BalQty;
                            outVm.PossibleQty = outItem.BalQty;


                            ProductionReturnCompVMs.ProductionReturnCompSubVMs.Add(outVm);
                        }
                    }
                }

            }

            await ResetSlno();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "OnPoSelectedAsync failed.");
            await _js.ToastrError("Error processing selected PO items.");
        }
    }

