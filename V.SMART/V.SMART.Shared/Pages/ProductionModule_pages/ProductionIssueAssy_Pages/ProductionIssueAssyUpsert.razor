    private async Task OnJobOrderSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        if (ProductionIssueAssyVMs.ProductionIssueAssySubVMs == null)
            ProductionIssueAssyVMs.ProductionIssueAssySubVMs = new List<ProductionIssueAssySubVM>();

        try
        {
            var itemIds = selectedItems
                .Where(i => i.ContainsKey("ItemId") && i["ItemId"] != null)
                .Select(i => Convert.ToInt32(i["ItemId"]))
                .ToList();

            var JobOrderNos = selectedItems.Where(i => i.ContainsKey("RefJobId"))
              .Select(i => Convert.ToInt32(i["RefJobId"])).Distinct().ToList();

            var priceDict = await prodIssueAssyService.GetBulkLastUnitPricesAsync(itemIds);

            foreach (var item in selectedItems)
            {
                int itemId = item.ContainsKey("ItemId") && item["ItemId"] != null
                    ? Convert.ToInt32(item["ItemId"])
                    : 0;

                int? RefJobSubId = item.ContainsKey("RefJobSubId") && item["RefJobSubId"] != null
                    ? Convert.ToInt32(item["RefJobSubId"])
                    : (int?)null;

                // Skip if already exists
                if (ProductionIssueAssyVMs.ProductionIssueAssySubVMs
                    .Any(x => x.ItemId == itemId && x.RefJobOrderSubId == RefJobSubId))
                    continue;

                var subVm = new ProductionIssueAssySubVM
                {
                    RefJobId = item.ContainsKey("RefJobId") && item["RefJobId"] != null
                        ? Convert.ToInt32(item["RefJobId"])
                        : 0,

                    RefJobOrderSubId = RefJobSubId.Value,

                    JobOrderNo = item.ContainsKey("RefJobNo") ? item["RefJobNo"]?.ToString() : "",
                    JobOrderDate = item.ContainsKey("RefJobDate") && item["RefJobDate"] != null
                        ? Convert.ToDateTime(item["RefJobDate"])
                        : null,

                    AssyId = item.ContainsKey("Assy/SubAssyId") && item["Assy/SubAssyId"] != null
                        ? Convert.ToInt32(item["Assy/SubAssyId"])
                        : 0,

                    AssyItemCode = item.ContainsKey("Assy/SubAssyCode")
                        ? item["Assy/SubAssyCode"]?.ToString()
                        : "",

                    ItemId = itemId,
                    ItemCode = item.ContainsKey("ItemCode") ? item["ItemCode"]?.ToString() : "",
                    ItemName = item.ContainsKey("ItemName") ? item["ItemName"]?.ToString() : "",
                    MeasureUnit = item.ContainsKey("MeasureUnit") ? item["MeasureUnit"]?.ToString() : "",

                    IssueQty = item.ContainsKey("ReqQty") && item["ReqQty"] != null
                        ? Convert.ToDecimal(item["ReqQty"])
                        : 0,

                    BalQty = item.ContainsKey("ReqQty") && item["ReqQty"] != null
                        ? Convert.ToDecimal(item["ReqQty"])
                        : 0,

                    UnitPrice = priceDict.TryGetValue(itemId, out var price) ? price : 0,

                    StockQty = item.ContainsKey("StockQty") && item["StockQty"] != null
                        ? Convert.ToDecimal(item["StockQty"])
                        : 0,

                    CostId = item.ContainsKey("CostCenterId") && item["CostCenterId"] != null
                            ? (Convert.ToInt32(item["CostCenterId"]) == 0
                                 ? (int?)null
                                 : Convert.ToInt32(item["CostCenterId"]))
                            : (int?)null,

                    ProjectNo = item.ContainsKey("CostCenter") ? item["CostCenter"]?.ToString() : "",

                    IsEditable = true
                };

                ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Add(subVm);
            }

            // Assign serial numbers
            int slNo = 1;
            foreach (var row in ProductionIssueAssyVMs.ProductionIssueAssySubVMs)
            {
                row.SlNo = slNo++;
            }

            staffVMs = await prodIssueAssyService.GetStaffDetailsByJobOrderIdAsync(JobOrderNos);

            ProductionIssueAssyVMs.IssueToWhom =
                       staffVMs?
                      .FirstOrDefault(s => !string.IsNullOrWhiteSpace(s.StaffName))
                      ?.StaffName;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "OnJobOrderSelectedAsync failed in Production Issue Assembly.");
            await _js.ToastrError("Error processing selected items in Production Issue.");
        }

    }

