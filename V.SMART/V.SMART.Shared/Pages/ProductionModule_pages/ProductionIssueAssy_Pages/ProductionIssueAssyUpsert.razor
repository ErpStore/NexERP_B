    #region Quantity Change Handler

    private async Task OnIssueQtyChanged(ChangeEventArgs e, ProductionIssueAssySubVM SubVM)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.IssueQty = 0;
                SubVM.BalQty = 0;
                await _js.ToastrWarning("IssueQty must be a positive number.");
                return;
            }

            var stockQty = SubVM.StockQty;

            if (stockQty <= 0 && SubVM.IssueSubId == 0)
            {
                SubVM.IssueQty = 0;
                SubVM.BalQty = 0;
                await _js.ToastrError("No stock available for this item.");
                return;
            }

            if (SubVM.IssueSubId == 0)
            {
                if (SubVM.RefJobOrderSubId > 0)
                {
                    var JobItemBalQty = await prodIssueAssyService
                        .GetJobOrderItemBalQtyFromJobSubId(SubVM.RefJobOrderSubId);

                    var allowedQty = Math.Min(JobItemBalQty, stockQty.GetValueOrDefault());

                    if (newQty <= allowedQty)
                    {
                        SubVM.IssueQty = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.IssueQty = allowedQty;
                        SubVM.BalQty = allowedQty;

                        await _js.ToastrWarning(
                            $"Issue Qty cannot exceed JobOrder Qty ({JobItemBalQty}) OR Stock Qty ({stockQty})."
                        );
                    }
                }
                else
                {
                    if (newQty > stockQty)
                    {
                        SubVM.IssueQty = stockQty;
                        SubVM.BalQty = stockQty;
                        await _js.ToastrWarning($"Issue Qty cannot exceed Stock Qty ({stockQty}).");
                    }
                    else
                    {
                        SubVM.IssueQty = newQty;
                        SubVM.BalQty = newQty;
                    }
                }
            }
            else
            {
                var original = await prodIssueAssyService
                    .GetProductionIssueSubItemDetailByIssueSubIdAsync(SubVM.IssueSubId);
                if (original == null) return;

                var alreadyTransacted = original.IssueQty - original.BalQty;

                var effectiveStock = (stockQty.GetValueOrDefault() + original.IssueQty);

                if (newQty < alreadyTransacted)
                {
                    SubVM.IssueQty = alreadyTransacted;
                    SubVM.BalQty = 0;
                    await _js.ToastrWarning(
                        $"Qty cannot be less than {alreadyTransacted} (already transacted)."
                    );
                    return;
                }

                if (SubVM.RefJobOrderSubId > 0)
                {
                    var JobItemBalQty = await prodIssueAssyService
                        .GetJobOrderItemBalQtyFromJobSubId(SubVM.RefJobOrderSubId);

                    var maxAllowedQty = original.IssueQty + JobItemBalQty;

                    var allowedQty = Math.Min(maxAllowedQty.GetValueOrDefault(), effectiveStock.GetValueOrDefault());

                    if (newQty > allowedQty)
                    {
                        SubVM.IssueQty = allowedQty;
                        SubVM.BalQty = allowedQty - alreadyTransacted;

                        await _js.ToastrWarning(
                            $"Issue Qty cannot exceed JobOrder Allowed Qty ({maxAllowedQty}) OR Available Stock ({effectiveStock})."
                        );
                    }
                    else
                    {
                        SubVM.IssueQty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
                else
                {
                    var allowedQty = effectiveStock;

                    if (newQty > allowedQty)
                    {
                        SubVM.IssueQty = allowedQty;
                        SubVM.BalQty = allowedQty - alreadyTransacted;

                        await _js.ToastrWarning(
                            $"Issue Qty cannot exceed Stock Qty ({effectiveStock})."
                        );
                    }
                    else
                    {
                        SubVM.IssueQty = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"OnQtyChange failed for IssueSubId: {SubVM?.IssueSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

