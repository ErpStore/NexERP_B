    #region Production Issue Assembly Operations

    private async Task UpsertProdIssueAssy()
    {
        try
        {

            isProcessing = true;

            ProductionIssueAssyVMs.ProductionIssueAssySubVMs.RemoveAll(x =>
                !x.ItemId.HasValue &&
                (x.IssueQty.GetValueOrDefault() == 0));

            if (!ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Any())
            {
                await _js.ToastrError("Cannot save a Production Issue Assembly without valid items.");
                return;
            }

            if (ProductionIssueAssyVMs.StoreIssId == null)
            {
                await _js.ToastrError("Store selection is required.");
                return;
            }

            if (string.IsNullOrWhiteSpace(ProductionIssueAssyVMs.IssueToWhom))
            {
                await _js.ToastrError("Issue To Whom is required.");
                return;
            }

            foreach (var line in ProductionIssueAssyVMs.ProductionIssueAssySubVMs)
            {
                bool isValid = await ValidateProdIssueSubAsync(line);
                if (!isValid)
                    return;
            }

            // Set processing only after all validations pass
            isProcessing = true;

            var isNewTCIssue = ProductionIssueAssyVMs.IssueId == 0;

            await prodIssueAssyService.UpsertProdIssueAssy(ProductionIssueAssyVMs, screenCode,IsMonthwiseNumber);

            await _js.ToastrSuccess(isNewTCIssue
                ? "Production Issue Assembly saved successfully."
                : "Production Issue Assembly updated successfully.");

            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/productionIssueList");
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Upsert Production Issue Assembly failed.");
            await _js.ToastrError("Error saving Production Issue Assembly.");
        }
        finally
        {
            // Always reset processing
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateProdIssueSubAsync(ProductionIssueAssySubVM line)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.IssueQty.HasValue || line.IssueQty <= 0)
            {
                await _js.ToastrError($"Item {line.ItemCode}: Issue Quantity must be greater than 0.");
                return false;
            }

            decimal issueQty = line.IssueQty.GetValueOrDefault();
            decimal stockQty = await prodIssueAssyService
                        .GetStockForItemAsync(line.ItemId.Value , ProductionIssueAssyVMs.StoreIssId.GetValueOrDefault());

            if (line.IssueSubId == 0)
            {
                if (issueQty > stockQty)
                {
                    await _js.ToastrError($" SLNO. {line.SlNo}, of Item-Code {line.ItemCode}: Issue Qty ({issueQty}) cannot exceed Stock Qty ({stockQty})."
                    );
                    return false;
                }

                if (line.RefJobOrderSubId > 0)
                {
                    var jobBalQty = await prodIssueAssyService
                        .GetJobOrderItemBalQtyFromJobSubId(line.RefJobOrderSubId);

                    if (issueQty > jobBalQty)
                    {
                        await _js.ToastrError(
                            $"Item {line.ItemCode}: Issue Qty ({issueQty}) cannot exceed Job Order Balance Qty ({jobBalQty})."
                        );
                        return false;
                    }
                }

                return true;
            }

            var original = await prodIssueAssyService
                .GetProductionIssueSubItemDetailByIssueSubIdAsync(line.IssueSubId);

            if (original == null)
                return true; 

            decimal origQty = original.IssueQty ?? 0;
            decimal origBal = original.BalQty ?? 0;
            decimal alreadyTransacted = origQty - origBal;

            // CANNOT BE LESS THAN ALREADY TRANSACTED
            if (issueQty < alreadyTransacted)
            {
                await _js.ToastrError(
                    $"Item {line.ItemCode}: Issue Qty cannot be less than already transacted ({alreadyTransacted})."
                );
                return false;
            }

            // EFFECTIVE STOCK = STOCK + ORIGINAL_QTY
            decimal effectiveStock = stockQty + origQty;

            if (issueQty > effectiveStock)
            {
                await _js.ToastrError(
                    $"Item {line.ItemCode}: Issue Qty ({issueQty}) cannot exceed Available Stock ({effectiveStock})."
                );
                return false;
            }

            // JOB ORDER VALIDATION FOR EXISTING LINE
            if (line.RefJobOrderSubId > 0)
            {
                var jobBalQty = await prodIssueAssyService
                    .GetJobOrderItemBalQtyFromJobSubId(line.RefJobOrderSubId);

                decimal maxJobOrderAllowed = origQty + jobBalQty;

                if (issueQty > maxJobOrderAllowed)
                {
                    await _js.ToastrError(
                        $"Item {line.ItemCode}: Issue Qty ({issueQty}) cannot exceed Job Order Allowed Qty ({maxJobOrderAllowed})."
                    );
                    return false;
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "ValidateProdIssueSubAsync failed.");
            await _js.ToastrError("Error validating Production Issue line.");
            return false;
        }
    }

    #endregion
    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(IssueId.GetValueOrDefault(), "ProdMtlIssNoteAssy.frx", "IssueId", false, ScreenName, "Sp_Print_ProductionIssueAss");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Production Issue Assy");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in Production Issue Assy.");
        }
        finally
        {
            isProcessing = false;
        }
    }

