    private async Task confirmDeleteRow_Click(bool isConfirmed)
    {
        try
        {
            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed || rowToDelete == null)
            {
                await _js.ToastrInfo("Action was not confirmed.");
                return;
            }

            var deletedItemCode = rowToDelete.ItemCode;

            if (rowToDelete.IssueSubId > 0)
            {
                await prodIssueAssyService.DeleteAndResequenceAsync(rowToDelete, ProductionIssueAssyVMs,screenCode);

                ProductionIssueAssyVMs.ProductionIssueAssySubVMs = await prodIssueAssyService.GetProductionIssueSubByIssueIdAsync(ProductionIssueAssyVMs.IssueId);
            }
            else
            {
                ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Remove(rowToDelete);

                if (!ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Any())
                {
                    ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Add(new ProductionIssueAssySubVM
                    {
                        IssueId = ProductionIssueAssyVMs.IssueId,
                        IsEditable = true,
                        SlNo = 1
                    });
            }
                else
                {
                    // Resequence remaining rows
                    for (int i = 0; i < ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Count; i++)
                        ProductionIssueAssyVMs.ProductionIssueAssySubVMs[i].SlNo = i + 1;
                }
            }

            await _js.ToastrSuccess($"{deletedItemCode} deleted successfully.");
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"Error confirming deletion for IssueId: {ProductionIssueAssyVMs.IssueId}");
            await _js.ToastrError("An error occurred during deletion. Please try again.");
        }
        finally
        {
            rowToDelete = null;
        }
    }

