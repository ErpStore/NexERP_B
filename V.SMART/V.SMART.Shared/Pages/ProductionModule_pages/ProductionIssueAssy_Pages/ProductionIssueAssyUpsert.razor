    private async Task CancelEdit(ProductionIssueAssySubVM? item, ProductionIssueAssyVM? parentProdIssueAssy)
    {
        try
        {
            if (item == null || parentProdIssueAssy == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.IssueQty.HasValue || item.IssueQty.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentProdIssueAssy.ProductionIssueAssySubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"CancelEdit failed for IssueSubId: {item?.IssueSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(ProductionIssueAssySubVM item)
    {
        try
        {
            if (ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Count == 1 && item.IssueSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if(IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            if (item.IssueQty.GetValueOrDefault() != item.BalQty)
            {
                await _js.ToastrWarning("This row cannot be deleted because some transactions are done.");
                return;
            }

            if (item.ItemId == 0)
            {
                ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Remove(item);

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"RemoveRow failed for IssueSubId: {item?.IssueSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

