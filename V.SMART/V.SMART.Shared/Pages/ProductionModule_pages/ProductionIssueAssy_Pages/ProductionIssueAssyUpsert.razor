    private async Task OnStoreChanged(ChangeEventArgs e)
    {
        try
        {
            if (!int.TryParse(e.Value?.ToString(), out var newStoreId))
                return;

            ProductionIssueAssyVMs.StoreIssId = newStoreId;

            if (newStoreId == 0)
            {
                await _js.ToastrWarning("Please select a valid Store. Store is required.");

                if (ProductionIssueAssyVMs.ProductionIssueAssySubVMs != null)
                {
                    foreach (var sub in ProductionIssueAssyVMs.ProductionIssueAssySubVMs)
                        sub.StockQty = 0;
                }
                StateHasChanged();
                return;
            }

            if (ProductionIssueAssyVMs.ProductionIssueAssySubVMs != null && ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Any())
            {
                var itemIds = ProductionIssueAssyVMs.ProductionIssueAssySubVMs
                    .Where(s => s.ItemId.HasValue)
                    .Select(s => s.ItemId!.Value)
                    .Distinct()
                    .ToList();

                if (itemIds.Count == 0)
                {
                    await _js.ToastrInfo("No items found to update stock for this store.");
                    return;
                }

                var stockDict = await prodIssueAssyService.GetStockForItemsAsync(itemIds, newStoreId);

                foreach (var sub in ProductionIssueAssyVMs.ProductionIssueAssySubVMs)
                {
                    if (sub.ItemId.HasValue && stockDict.TryGetValue(sub.ItemId.Value, out var qty))
                        sub.StockQty = qty;
                    else
                        sub.StockQty = 0;
                }

                await _js.ToastrSuccess("Stock quantities updated based on selected store.");
            }
            else
            {
                await _js.ToastrInfo("No sub-items available to update stock.");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error occurred in OnStoreChanged while updating stock quantities.");
            await _js.ToastrError("An unexpected error occurred while updating stock. Please try again.");
        }
    }

