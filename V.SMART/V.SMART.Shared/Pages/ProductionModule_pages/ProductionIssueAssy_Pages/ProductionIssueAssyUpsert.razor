@page "/productionIssueAssy/create"
@page "/productionIssueAssy/update/{IssueId:int}"


@using MudBlazor
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.MasterViewModel.HumanResourceViewModel

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IProductionIssueAssyService prodIssueAssyService
@inject ILoggingService logs
@inject ReportService reportService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>


<DetailsModal Title="Job Order Details"
              Columns="@JobOrderColumns"
              ColumnFields="@JobOrderFields"
              HiddenColumns="@JobOrderHiddenColumns"
              Data="@JobOrderData"
              IsVisible="@IsJobOrderModalVisible"
              IsVisibleChanged="@((val) => IsJobOrderModalVisible = val)"
              OnSelectedItems="OnJobOrderSelectedAsync">


    <HeaderContent>
        <div class="d-flex justify-content-end gap-2 mb-2">

            <label class="d-flex align-items-center cursor-pointer px-2 py-1
                          rounded-pill
                          @(SelectedOption == "Stock" ? "bg-primary text-white" : "bg-light text-dark")"
                   style="font-size: 0.75rem;">
                <input type="radio" class="d-none" name="itemType" id="onlyStock" value="Stock"
                       checked="@(SelectedOption == "Stock")"
                       @onchange="OnStockFilterChanged" />
                <i class="bi bi-box-seam fs-6 me-1"></i>
                Load only Stock exists Items
            </label>

            <label class="d-flex align-items-center cursor-pointer px-2 py-1
                          rounded-pill
                          @(SelectedOption == "All" ? "bg-success text-white" : "bg-light text-dark")"
                   style="font-size: 0.75rem;">
                <input type="radio" class="d-none" name="itemType" id="allItems" value="All"
                       checked="@(SelectedOption == "All")"
                       @onchange="OnStockFilterChanged" />
                <i class="bi bi-list-ul fs-6 me-1"></i>
                Load All Items related Assembly
            </label>

        </div>
    </HeaderContent>

</DetailsModal>

<!-- Shared Modal -->

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
  position: sticky;
  right: 0;
  background-color: #f8f9fa;
  z-index: 10;
}
</style>


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@(ProductionIssueAssyVMs.IssueId > 0 ? "Update Production Issue Assembly" : "Create Production Issue Assembly")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@materialIssueBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="ProductionIssueAssyVMs" OnValidSubmit="UpsertProdIssueAssy">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />


                    <!-- Correspondence Status -->
                    <div class="row g-3 mb-2 align-items-center">

                        @if (ProductionIssueAssyVMs.IssueId > 0 && !string.IsNullOrWhiteSpace(ProductionIssueAssyVMs.IssueNo))
                        {
                            <CorrespondenceStatus ReferenceType="Production Issue Assembly"
                                                  ReferenceId="@ProductionIssueAssyVMs.IssueId"
                                                  ReferenceTypeName="@ProductionIssueAssyVMs.IssueNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">

                        <!-- =================== Production Issue Details Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Document Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- Material issue No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Material Issue No.</small>
                                        </label>
                                        @if (IsMonthwiseNumber)
                                        {
                                            <div class="col-12 col-sm-9">

                                                <div class="row g-2 align-items-center">

                                                    <div class="col-2">
                                                        <InputText class="form-control form-control-sm text-center"
                                                                   @bind-Value="ProductionIssueAssyVMs.DepartmentCode"
                                                                   placeholder="Dept"
                                                                   readonly />
                                                    </div>


                                                    <div class="col-2">
                                                        <InputText class="form-control form-control-sm text-center"
                                                                   @bind-Value="ProductionIssueAssyVMs.MonthCode"
                                                                   placeholder="MM"
                                                                   readonly />
                                                    </div>


                                                    <div class="col-4">
                                                        <InputText class="form-control form-control-sm text-center fw-bold"
                                                                   @bind-Value="ProductionIssueAssyVMs.IssueNo"
                                                                   readonly />
                                                    </div>


                                                    <div class="col-4">
                                                        <InputText class="form-control form-control-sm text-center"
                                                                   @bind-Value="ProductionIssueAssyVMs.Suffix"
                                                                   placeholder="FY"
                                                                   readonly />
                                                    </div>

                                                </div>

                                                <ValidationMessage For="@(() => ProductionIssueAssyVMs.IssueNo)" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-12 col-sm-9">
                                                <div class="input-group input-group-sm w-100 rounded-3">
                                                    <InputText class="form-control form-control-sm rounded-3"
                                                               placeholder="Material Issue No."
                                                               maxlength="30"
                                                               @bind-Value="@ProductionIssueAssyVMs.IssueNo"
                                                               readonly />

                                                    <span class="input-group-text rounded-3">@ProductionIssueAssyVMs.Suffix</span>
                                                </div>
                                                <ValidationMessage For="@(() => ProductionIssueAssyVMs.IssueNo)" />
                                                <ValidationMessage For="@(() => ProductionIssueAssyVMs.Suffix)" />
                                            </div>

                                        }

                                    </div>

                                    <!-- Material issue Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Material Issue Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@ProductionIssueAssyVMs.IssueDate" />
                                            <ValidationMessage For="@(() => ProductionIssueAssyVMs.IssueDate)" />
                                        </div>
                                    </div>

                                    @if (jobOrderPendingCount > 0)
                                    {
                                        <!-- Job No -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Job Orders</small>
                                            </label>
                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowJobOrderDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Job Order Details
                                                </button>
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>


                        <!-- =================== Production Material Issue Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Production Issue Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- Stores -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issue From Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    id="storeId"
                                                    value="@ProductionIssueAssyVMs.StoreIssId"
                                                    @onchange="OnStoreChanged">
                                                <option value="0">--Select Store--</option>
                                                @foreach (var storeid in Stores)
                                                {
                                                    <option value="@storeid.StoreId">@storeid.StoreName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Issue To Whom -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Issued To Whom </small>
                                        </label>
                                         <div class="col-12 col-sm-9">

                                         @if (staffVMs.Any())
                                         {
                                             if (staffVMs.Count == 1)
                                             {
                                                 <input type="text"
                                                        class="form-control form-control-sm rounded-3 w-100"
                                                        @bind="ProductionIssueAssyVMs.IssueToWhom"
                                                         />
                                             }
                                             else
                                             {
                                                 <select class="form-select form-select-sm"
                                                         @bind="ProductionIssueAssyVMs.IssueToWhom">
                                                     <option value="">-- Select Staff --</option>
                                                     @foreach (var s in staffVMs)
                                                     {
                                                         <option value="@s.StaffName">@s.StaffName</option>
                                                     }
                                                 </select>
                                             }
                                         }
                                         else
                                         {
                                            <div class="col-12 col-sm-9">
                                                <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                       @bind="ProductionIssueAssyVMs.IssueToWhom" />
                                                <ValidationMessage For="@(() => ProductionIssueAssyVMs.IssueToWhom)" />
                                            </div>
                                         }
                                    </div>
                                   </div>
                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="ProductionIssueAssyVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => ProductionIssueAssyVMs.MainRemark)" />
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>


                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1"
                                 style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0"
                                               style="table-layout: fixed; min-width: 1700px;">
                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:120px;">Job No.</th>
                                                    <th style="width:110px;">Job Date</th>
                                                    <th style="width:140px;">Assy/SubAssy</th>
                                                    <th style="width:200px;">Item Code</th>
                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:120px;">Issue Qty</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:120px;">Bal Qty</th>
                                                    <th style="width:130px;">Stock Qty</th>
                                                    <th style="width:130px;">Batch No</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:120px;">Cost Center</th>
                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @if (ProductionIssueAssyVMs.ProductionIssueAssySubVMs?.Any() == true)
                                                {
                                                    @foreach (var subitem in ProductionIssueAssyVMs.ProductionIssueAssySubVMs)
                                                    {
                                                        <tr @key="subitem">
                                                            <td>@subitem.SlNo</td>
                                                            <td>@subitem.JobOrderNo</td>
                                                            <td>@subitem.JobOrderDate</td>
                                                            <td>@subitem.AssyItemCode</td>
                                                            <td>
                                                                <div class="row g-1 align-items-center">
                                                                    <div class="col-10">@subitem.ItemCode</div>
                                                                    <div class="col-2 text-center">
                                                                        @if (subitem.ItemId is not null && subitem.ItemId > 0
                                                                            && attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                        {
                                                                            <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                           Size="Size.Small"
                                                                                           Color="Color.Primary"
                                                                                           OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                           Edge="Edge.End"
                                                                                           Title=@($"This Item has {count} attachment(s). Click to view.") />
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </td>

                                                            <td>@subitem.ItemName</td>
                                                            <td>@subitem.MeasureUnit</td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Issue Qty"
                                                                           title="Enter Issue Quantity"
                                                                           step="any"
                                                                           @bind="subitem.IssueQty"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnIssueQtyChanged(e, subitem))" />
                                                                    <ValidationMessage For="@(() => subitem.IssueQty)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.IssueQty
                                                                }
                                                            </td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Unit Price"
                                                                           title="Enter Unit Price"
                                                                           step="any"
                                                                           @bind="subitem.UnitPrice" />
                                                                    <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.UnitPrice
                                                                }
                                                            </td>

                                                            <td>@subitem.BalQty</td>

                                                            <td class="text-danger fw-bold">@subitem.StockQty</td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputText @bind-Value="subitem.BatchNo"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="BatchNo" />
                                                                    <ValidationMessage For="@(() => subitem.BatchNo)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.BatchNo
                                                                }
                                                            </td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputText @bind-Value="subitem.Remark"
                                                                               class="form-control form-control-sm"
                                                                               placeholder="Enter Remarks" />
                                                                    <ValidationMessage For="@(() => subitem.Remark)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.Remark
                                                                }
                                                            </td>

                                                            <td>@subitem.ProjectNo</td>

                                                            <td class="freeze-last-col text-end">
                                                                <div class="d-flex justify-content-end gap-1">
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                                @onclick="async () => await SaveRow(subitem)">
                                                                            <i class="bi bi-check-lg"></i>
                                                                        </button>
                                                                        <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                                @onclick="async () => await CancelEdit(subitem, ProductionIssueAssyVMs)">
                                                                            <i class="bi bi-x-lg"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                                @onclick="async () => await EditRowAsync(subitem)">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>
                                                                        <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                                @onclick="async () => await RemoveRow(subitem)">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="11" style="height:150px;" class="text-center align-middle text-muted fs-6 fw-semibold">
                                                            <div class="d-flex justify-content-center align-items-center" style="min-height:100px;">
                                                                <i class="bi bi-info-circle me-2 text-secondary"></i>
                                                                No items to display
                                                            </div>
                                                        </td>
                                                    </tr>

                                                }
                                            </tbody>

                                            @if (ProductionIssueAssyVMs.ProductionIssueAssySubVMs?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark fw-bold">
                                                    <tr>
                                                        <td colspan="7" class="text-end">Totals:</td>
                                                        <td>@ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Sum(x => x.IssueQty)</td>
                                                        <td> Avg:@ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Average(x => x.UnitPrice)</td>
                                                        <td>@ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Sum(x => x.BalQty)</td>
                                                        <td>@ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Sum(x => x.StockQty)</td>
                                                        <td colspan="4"></td>
                                                    </tr>
                                                </tfoot>
                                            }
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            <div class="col-6 col-md-3 mt-3">
                                <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                    <i class="bi bi-floppy2-fill me-1"></i> @(ProductionIssueAssyVMs.IssueId > 0 ? "Update" : "Create")
                                </button>
                            </div>
                        }

                        <div class="col-6 col-md-3 mt-3">
                            <SmartBackButton Url="@($"/productionIssueList?currentPage={currentPage}")" />
                        </div>

                        @if (CanCreate || CanEdit && IssueId > 0)
                        {
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                    <i class="bi bi-printer me-1"></i>Print
                                </button>
                            </div>
                        }

                    </div>

                </EditForm>
            </div>
        </div>
    </div>
}


@code {

    #region Parameters & Properties

    protected override string ScreenName => "Production Issue WO Assembly";

    [Parameter] public int? IssueId { get; set; }

    private bool isProcessing = true;
    private ProductionIssueAssyVM ProductionIssueAssyVMs { get; set; } = new();
    private List<Store> Stores = new();

    private ProductionIssueAssySubVM? rowToDelete;

    private int jobOrderPendingCount = 0;
    private int screenCode { get; set; }

    private bool IsSomeItemsTransMade { get; set; } = false;

    private string SelectedOption = "Stock";

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private string? pdfBase64;

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();
    private List<StaffVM> staffVMs = new();

    private List<PageHeader.BreadcrumbItem> materialIssueBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Production" },
        new PageHeader.BreadcrumbItem { Text = "Assembly" },
        new PageHeader.BreadcrumbItem { Text = "Material Issue", IsLast = true }
    };

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    //Detail Modal
    private bool IsJobOrderModalVisible = false;
    private List<Dictionary<string, object>> JobOrderData = new();
    private List<Dictionary<string, object>> AllJobOrderData = new();

    private List<string> JobOrderColumns = new() { "RefJobId","RefJobSubId", "Ref Job No", "Ref Job Date", "Assy/SubAssyId", "Assy/SubAssy Code",
    "Assy/SubAssy Name", "Assy/SubAssyUom", "JobOrderQty" ,"Item Code", "Item Name", "MeasureUnit","Req. Qty","Stock Qty", "CostCenterId", "Cost Center"};

    private List<string> JobOrderFields = new() { "RefJobId","RefJobSubId", "RefJobNo", "RefJobDate", "Assy/SubAssyId", "Assy/SubAssyCode",
    "Assy/SubAssyName", "Assy/SubAssyUom", "JobOrderQty","ItemCode", "ItemName", "MeasureUnit", "ReqQty", "StockQty","CostCenterId","CostCenter" };

    private List<string> JobOrderHiddenColumns = new() { "RefJobId", "RefJobSubId", "Assy/SubAssyId", "Assy/SubAssy Name", 
    "Assy/SubAssyUom", "Item Name", "MeasureUnit","CostCenterId" };

    #endregion
    private bool IsMonthwiseNumber { get; set; } = false;

    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;

            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            screenCode = await prodIssueAssyService.GetScreenCodeByScreenNameAsync(ScreenName);
            Stores = await prodIssueAssyService.GetAllActiveStoresAsync();

            jobOrderPendingCount = await prodIssueAssyService.GetPendingJobOrdersCountAsync();
            IsMonthwiseNumber = await prodIssueAssyService.IsMonthwiseNumberGenerationEnabledAsync();

            if (IssueId.HasValue)
            {
                await LoadExistingProductionIssue(IssueId.Value);
            }
            else
            {
                await InitializeNewProductionIssueAssy();
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingProductionIssue(int issueId)
    {
        try
        {
            ProductionIssueAssyVMs = await prodIssueAssyService.GetProductionByIssueIdAsync(issueId);
            if (ProductionIssueAssyVMs == null)
            {
                await _js.ToastrWarning("Production Issue Assembly not found.");
                return;
            }

            foreach (var prodSub in ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Where(q => q.ItemId > 0))
            {
                attachmentCounts[prodSub.ItemId.Value] = await prodIssueAssyService.GetCorrespondenceAttachmentsCountAsync(prodSub.ItemId.Value, "Item");
            }

            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing production Issue Assembly.");
            await logs.LogDeveloperError(ex, $"LoadExistingProductionIssue failed for IssueId: {issueId}");
        }
    }

    private bool CheckIsTransMade()
    {
        var list = ProductionIssueAssyVMs?.ProductionIssueAssySubVMs;
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalQty += list[i].IssueQty.GetValueOrDefault();
            totalBalQty += list[i].BalQty.GetValueOrDefault();
        }

        return totalQty != totalBalQty;
    }

    private async Task InitializeNewProductionIssueAssy()
    {
        try
        {
            if (ProductionIssueAssyVMs == null)
                ProductionIssueAssyVMs = new ProductionIssueAssyVM();

            ProductionIssueAssyVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
          
            //ProductionIssueAssyVMs.IssueNo = await prodIssueAssyService.GetProductionIssueNumberAsync(ProductionIssueAssyVMs.Suffix);
            if (IsMonthwiseNumber)
            {
                ProductionIssueAssyVMs.DepartmentCode = await prodIssueAssyService.GetDerpartmentCodeByCurrentuserAsync();
