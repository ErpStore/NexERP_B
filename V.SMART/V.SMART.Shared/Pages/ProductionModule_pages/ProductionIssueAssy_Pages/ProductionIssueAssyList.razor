@page "/productionIssueList"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IProductionService
@using V.SMART.Shared.Pages.InstantSearch_Pages
@using V.SMART.Shared.ViewModels.InventoryViewModel.ToolCribViewModels
@using V.SMART.Shared.ViewModels.PlanningViewModel.JobOrderViewModel
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionIssueWOAssyVM
@using System.Text.Json

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation

@inject IProductionIssueAssyService productionIssueAssyService

@inject ExcelExportService ExcelExportService


<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "InstantSearch")
    {
        <InstantSearch 
            isModelVisible="true" 
            Screen="@ScreenName" 
            Filters="SearchFilters"
            OnClose="CloseModal"
            OnSearch="ApplySearchFilters" />
    }
</MasterModal>


<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Material Issue Assembly List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@materialIssueBreadcrumbs" />

            <div class="card-body p-4">

                <div class="row g-2 g-md-3 mb-3">
                    <!-- Column Settings -->
                    <div class="col-6 col-md-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible=int.MaxValue
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 shadow-sm"
                                 @onclick='() => OpenModal("InstantSearch")'>
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>

                    <div class="col-6 col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm"
                                @onclick="RefreshPage">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>


                    <div class="col-6 col-md-2 text-end">
                        <select class="form-select form-select-sm shadow-sm w-100"
                                value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10" selected>10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <select class="form-select form-select-sm shadow-sm"
                                 value="@selectedStatus"
                                @onchange="OnStatusChanged"
                                title="Select item status">

                            <option value="">All</option>
                            <option value="Completed">Completed</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </div>


                    @if (CanCreate)
                    {
                       <div class="col-12 col-md-2 ms-md-auto text-end">
                            <a href="productionIssueAssy/create"
                               class="btn btn-success btn-sm shadow-sm d-block d-md-inline-block w-100 w-md-auto"
                               title="Create New">
                                <i class="bi-box-seam"></i> Add New
                            </a>
                       </div>
                    }

                </div>

                @if (ProductionIssueAssyVMs.Any())
                {
                    <div class="table-responsive">

                        <QuickGrid Items="ProductionIssueAssyVMs.AsQueryable()"
                                   Class="quickgrid table table-bordered text-wrap">

                            @if (Columns.Count(c => c.IsVisible) >= 1)
                            {
                                @foreach (var col in Columns.Where(c => c.IsVisible))
                                {
                                    <div>
                                        @switch (col.Field)
                                        {
                                            case "IssueId":
                                                <PropertyColumn Title="Issue ID" Property="@(c => c.IssueId)" />
                                                break;

                                            case "IssueNo":
                                               // <PropertyColumn Title="Issue No" Property="@(c => c.IssueNo + c.Suffix)" Sortable="true" />
                                                <PropertyColumn Title="Issue No"
                                                                Property="@(c =>
                                                                                        !string.IsNullOrEmpty(c.DepartmentCode) && !string.IsNullOrEmpty(c.MonthCode)
                                                                                        ? $"{c.DepartmentCode}/{c.MonthCode}/{c.IssueNo}{c.Suffix}"
                                                                                        : $"{c.IssueNo}{c.Suffix}")"
                                        Sortable="true" />
                                                break;

                                            case "IssueDate":
                                                <PropertyColumn Title="Issue Date" Property="@(c => c.IssueDate)" Format="dd/MM/yyyy" Sortable="true" />
                                                break;

                                            case "Status":
                                                <TemplateColumn Title="Status" Context="c">
                                                    @if (c.IssueTally == true)
                                                    {
                                                        <span class="badge text-bg-success bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-check-circle me-1"></i> Complete
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-warning bg-gradient shadow-sm px-3 py-1 rounded-pill">
                                                            <i class="bi bi-hourglass-split me-1"></i> Pending
                                                        </span>
                                                    }
                                                </TemplateColumn>
                                                break;

                                            case "IssueToWhom":
                                                <PropertyColumn Title="Issued To Whom" Property="@(c => c.IssueToWhom)" Sortable="true" />
                                                break;

                                            case "StoreIssName":
                                                <PropertyColumn Title="Store Name" Property="@(c => c.StoreIssName)" />
                                                break;

                                            case "NoOfItems":
                                                <PropertyColumn Title="No. of Items" Property="@(c => c.NoOfItems)" />
                                                break;

                                            case "MainRemark":
                                                <PropertyColumn Title="Main Remarks" Property="@(c => c.MainRemark)" />
                                                break;

                                            case "CreatedBy":
                                                <PropertyColumn Title="Created By" Property="@(c => c.CreatedBy)" />
                                                break;

                                            case "CreatedDate":
                                                <PropertyColumn Title="Created Date" Property="@(c => c.CreatedDate)" Format="dd/MM/yyyy" />
                                                break;

                                            case "ModifiedBy":
                                                <PropertyColumn Title="Modified By" Property="@(c => c.ModifiedBy)" />
                                                break;

                                            case "ModifiedDate":
                                                <PropertyColumn Title="Modified Date" Property="@(c => c.ModifiedDate)" Format="dd/MM/yyyy" />
                                                break;
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <PropertyColumn Title="Issue No" Property="@(c => c.IssueNo)" />
                                <PropertyColumn Title="Suffix" Property="@(c => c.Suffix)" />
                                <PropertyColumn Title="Issue Date" Property="@(c => c.IssueDate)" Format="dd/MM/yyyy" />
                                <PropertyColumn Title="Issued To Whom" Property="@(c => c.IssueToWhom)" />
                                <PropertyColumn Title="No. of Items" Property="@(c => c.NoOfItems)" />
                                <PropertyColumn Title="Main Remarks" Property="@(c => c.MainRemark)" />
                            }


                            <TemplateColumn Title="Actions" Context="c">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (CanEdit)
                                    {
                                        <a href="@($"productionIssueAssy/update/{c.IssueId}?currentPage={currentPage}")"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    }
                                    @if (CanView)
                                    {
                                        <a href="@($"productionIssueAssy/details/{c.IssueId}?currentPage={currentPage}")"
                                            class="btn btn-sm btn-outline-info"
                                            title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete"
                                                @onclick="() => HandleDelete(c.IssueId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </TemplateColumn>

                        </QuickGrid>
                    </div>

                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="container-fluid">

                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-skip-backward-fill"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">
                                    <i class="bi bi-arrow-left-circle"></i>
                                </button>

                                <span class="fw-semibold small px-1">
                                    Page @currentPage of @totalPages
                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">
                                    <i class="bi bi-skip-forward-fill"></i>
                                </button>

                                <button class="btn btn-success btn-sm d-flex align-items-center ms-5"
                                        @onclick="HandleExport">

                                    <i class="bi bi-download me-1"></i>
                                    Export Production's

                                </button>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <p class="text-center">No Item available.</p>
                }

            </div>
        </div>
    </div>
}

@code {

    #region === Screen Configuration ===

    protected override string ScreenName => "Production Issue WO Assembly";
    private bool isProcessing = true;
    private bool preferencesLoaded = false;
    private string? UserName;
    private int DeleteIssueId = 0;
    private string selectedStatus = "";

    private int screenCode{ get; set; }

    private List<ProductionIssueAssyVM> ProductionIssueAssyVMs = new();

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;
    // === Paging & Search ===
    private int totalItems;
    //private int currentPage = 1;
    private int pageSize { get; set; } = 10;

    private int totalPages => (int)Math.Ceiling((double)totalItems / pageSize);

    public List<GridColumn> Columns { get; set; }

    // Instant Search filter parameter
    [Parameter,SupplyParameterFromQuery] public string? Filter { get; set; }
    private Dictionary<string, object>? SearchFilters { get; set; } = new();

    #endregion


    #region === Modal State ===

    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    #endregion

    private List<PageHeader.BreadcrumbItem> materialIssueBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Production" },
        new PageHeader.BreadcrumbItem { Text = "Assembly" },
        new PageHeader.BreadcrumbItem { Text = "Material Issue", IsLast = true }
    };

    #region === initilization ===

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns(IsHidden);

            screenCode = await productionIssueAssyService.GetScreenCodeByScreenNameAsync(ScreenName);
            UserName = await CurrentUserService.GetUsernameAsync();

            //InstantSearch
            //Important : Deserialize Filter parameter from query string if exists
            if (!string.IsNullOrEmpty(Filter))
            {
                SearchFilters = JsonSerializer.Deserialize<Dictionary<string, object>>(Filter);
            }
            //Sathish
            if (currentPage < 1)
            {
                currentPage = 1;
            }
            await LoadAllProuctionAssyIssues();
            await LoadColumnPreferences(UserName);

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnInitializedAsync()");
        }
        finally
        {
            isProcessing = false;
            preferencesLoaded = true;
        }
    }

    #endregion


    #region ===  Columns ===

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "Issue ID", Field = "IssueId", IsVisible = false },
                new() { Title = "Issue No", Field = "IssueNo", IsVisible = true },
                new() { Title = "Issue Date", Field = "IssueDate", IsVisible = true },

                new() { Title = "Issued To Whom", Field = "IssueToWhom", IsVisible = true },
                new() { Title = "Category Name", Field = "CategoryName", IsVisible = true },
                new() { Title = "Store Name", Field = "StoreIssName", IsVisible = true },
                new() { Title = "Returnable", Field = "IsReturn", IsVisible = true },
                new() { Title = "No. of Items", Field = "NoOfItems", IsVisible = true },
                new() { Title = "Main Remarks", Field = "MainRemark", IsVisible = true },
                new() { Title = "Status", Field = "Status", IsVisible = false },

                new() { Title = "Created By", Field = "CreatedBy", IsVisible = false },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = false },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false },
            };

            if (!Hidden)
            {

            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for JobOrderList");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }

    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the ItemList HandleColumnChange() Method");
        }
    }

    #endregion


    #region === Data Loading ===

    private async Task LoadAllProuctionAssyIssues()
    {
        try
        {
            var result = await productionIssueAssyService.SearchWithDynamicFilterAsync(
                pageNumber: currentPage,
                pageSize: pageSize,
                filters: SearchFilters
            );

            ProductionIssueAssyVMs = result.issueAssyVMs;
            totalItems = result.TotalCount;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading Production Return Assembly");
        }
    }

    #endregion

    #region == PAGINATION ==

    private async Task FirstPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != 1)
            {
                currentPage = 1;
                await LoadAllProuctionAssyIssues();
            }
        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Error navigating to first page in Production Assembly Issue");
            await _JS.ToastrError("Failed to navigate to first page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task PreviousPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage > 1)
            {
                currentPage--;
                await LoadAllProuctionAssyIssues();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to previous page in Production Assembly Issue");
            await _JS.ToastrError("Failed to navigate to previous page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task NextPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage < totalPages)
            {
                currentPage++;
                await LoadAllProuctionAssyIssues();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to next page in Production Assembly Issue");
            await _JS.ToastrError("Failed to navigate to next page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LastPage()
    {
        try
        {
            isProcessing = true;
            if (currentPage != totalPages)
            {
                currentPage = totalPages;
                await LoadAllProuctionAssyIssues();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error navigating to last page in Production Assembly Issue");
            await _JS.ToastrError("Failed to navigate to last page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;
            pageSize = int.Parse(e.Value?.ToString() ?? "10");
            currentPage = 1;
            await LoadAllProuctionAssyIssues();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error changing page size in Production Assembly Issue");
            await _JS.ToastrError("Failed to change page size.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RefreshPage()
    {
        try
        {
            isProcessing = true;
            SearchFilters = new Dictionary<string, object>();
            await LoadAllProuctionAssyIssues();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error refreshing Production Assembly Issue page");
            await _JS.ToastrError("Failed to refresh page.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion




    #region Production Material Issue Status Changes

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        try
        {
            isProcessing = true;

            SearchFilters = new();
            selectedStatus = e.Value?.ToString() ?? "";

            if (string.IsNullOrWhiteSpace(selectedStatus))
                SearchFilters.Remove("Status");
            else
                SearchFilters["Status"] = selectedStatus;


            currentPage = 1;
            await LoadAllProuctionAssyIssues();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error OnStatusChanged in Production Assembly Issue");
            await _JS.ToastrError("Failed to Load Production Assembly Issue filters.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    #endregion 

    #region === Deletion Flow ===

    private async Task HandleDelete(int issueId)
    {
        try
        {
            bool hasProdReturnTransMade = await productionIssueAssyService.HasAnyProdReturnAssyTransactionMadeAsync(issueId);
            if (hasProdReturnTransMade)
            {
                await _JS.ToastrWarning("Cannot delete this Production as a Production Return Assy transaction exists.");
                return;
            }

            ModalTitle = "Are you sure you want to delete this Production Assembly?";
            btnColor = "btn-danger";
            btnText = "Yes, Delete";
            confirmation = "Delete";
            showCancelReasonBox = false;

            DeleteIssueId = issueId;
            await _JS.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error initiating delete for IssueId: {issueId}");
            await _JS.ToastrError("Failed to initiate delete operation.");
        }
    }

    private async Task ConfirmDelete_Click(bool isConfirmed)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed) return;

            var deleted = await productionIssueAssyService.DeleteProdAssyIssueByIssueIdAsync(DeleteIssueId, screenCode);
            if (deleted)
            {
                await _JS.ToastrSuccess("Production Issue Assembly deleted successfully.");
                await LoadAllProuctionAssyIssues();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                await _JS.ToastrWarning("Tool Crib Issue could not be deleted. It may not exist or has dependencies.");
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Error deleting IssueId: {DeleteIssueId}");
            await _JS.ToastrError("Failed to delete Production issue Assy.");
        }
        finally
        {
            isProcessing = false;
            DeleteIssueId = 0;
        }
    }

    #endregion

    #region === Modal Management ===

    private async Task HandleModalConfirmation(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirmed)
                return;

            if (confirmation == "Delete")
                await ConfirmDelete_Click(isConfirmed);
            else if (confirmation=="Export")
            {
                await ExportToExcel(isConfirmed);
            }
            else
                await _JS.ToastrWarning("Unknown confirmation action.");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"HandleModalConfirmation failed for action: {confirmation}");
            await _JS.ToastrError("An error occurred while processing your action. Please try again.");
        }
    }

    private async Task OpenModal(string type)
    {
        try
        {
            ActiveModal = type;
            MasterModalTitle = type switch
            {
                "InstantSearch" => "Instant Search",
                _ => "Modal"
            };
            isModalVisible = true;

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"OpenModal failed for type: {type}");
            await _JS.ToastrError("Failed to open modal. Please try again.");
        }
    }

    private async Task CloseModal()
    {
        try
        {
            isModalVisible = false;
            ActiveModal = "";
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"CloseModal failed for type: {ActiveModal}");
            await _JS.ToastrError("Failed to close modal. Please try again.");
        }
    }

    #endregion

    #region SEARCH FILTER

    private async Task ApplySearchFilters(Dictionary<string, object> filters)
    {
        try
        {
            isProcessing = true;
            SearchFilters = filters;
            currentPage = 1;
            await LoadAllProuctionAssyIssues();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error applying search filters in Production Assembly Issue");
            await _JS.ToastrError("Failed to apply search filters.");
        }
        finally
        {
            isProcessing = false;
        }

    }

    #endregion

    private async Task HandleExport()
    {
        selectedStatus = selectedStatus == "" ? "All" : selectedStatus;

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;


            var exportData = await productionIssueAssyService.GetProductionIssueAssyStatusListAsync(selectedStatus);

            if (exportData == null || !exportData.Any())
                return;

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "Production Issue Assembly", "Production Issue Assembly's Status List");

            var base64 = Convert.ToBase64String(bytes);
            await _JS.DownloadExcelAsync(base64, "ProductionIssueAssy.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in ExportToExcel (Production Issue Assembly's)");
            await _JS.ToastrError("Error while exporting Production Issue Assembly!");
        }
        finally
        {
            isProcessing = false;
        }
    }
}
