@page "/productionIssueAssy/details/{IssueId:int}"

@using V.SMART.Shared.Services.ReportViewer

@inherits BaseUserRightsComponent

@inject IProductionIssueAssyService prodIssueAssyService
@inject IJSRuntime js
@inject ILoggingService logs
@inject NavigationManager _nav

@inject ReportService reportService


@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{

    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <MyCompanyDetails />

            <hr class="border-2 border-primary-subtle mb-4" />
            <div class="text-center">
                <h4 class="fw-semibold mt-3">Material Issue Details</h4>
            </div>

            <hr class="border-2 border-primary-subtle mb-4" />

            <!-- Document Details -->
            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">

                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Document Details
                        </div>

                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Material Issue No.</strong></td>
                                        @* <td>
                                            @((ProductionIssueAssyVMs != null) ? $"{ProductionIssueAssyVMs.IssueNo}{ProductionIssueAssyVMs.Suffix}" : "")
                                        </td> *@
                                        @(ProductionIssueAssyVMs != null
                                                                        ? (!string.IsNullOrEmpty(ProductionIssueAssyVMs.DepartmentCode)
                                                                        && !string.IsNullOrEmpty(ProductionIssueAssyVMs.MonthCode)
                                                                        ? $"{ProductionIssueAssyVMs.DepartmentCode}/{ProductionIssueAssyVMs.MonthCode}/{ProductionIssueAssyVMs.IssueNo}{ProductionIssueAssyVMs.Suffix}"
                                                                        : $"{ProductionIssueAssyVMs.IssueNo}{ProductionIssueAssyVMs.Suffix}")
                                                                        : "")
                                        <td>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td class="text-secondary"><strong>Material Issue Dt.</strong></td>
                                        <td>@(ProductionIssueAssyVMs?.IssueDate)</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Job Order No.</strong></td>
                                        <td>@refJobNosDisplay</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Ref Job Order Dt.</strong></td>
                                        <td>@refJobDateDisplay</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

                <!-- Production Issue Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">

                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Production Issue Details
                        </div>

                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Issue From store</strong></td>
                                        <td>@(ProductionIssueAssyVMs != null ? $"{ProductionIssueAssyVMs.StoreIssName}" : "")</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Issue to Whom</strong></td>
                                        <td>@(ProductionIssueAssyVMs?.IssueToWhom)</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Remarks</strong></td>
                                        <td>@($"{ProductionIssueAssyVMs?.MainRemark}")</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

            </div>

            <!--  Items -->
            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    Production Issue Items
                </div>

                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                        <thead class="custom-blue">
                            <tr>
                                <th>Sl No.</th>
                                <th>Assembly/SubAssembly</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>UOM</th>
                                <th>IssueQty</th>
                                <th>Unit Price</th>
                                <th>Stock Qty</th>
                                <th>Balance Qty</th>
                                <th>Batch No.</th>
                                <th>Cost Center</th>
                            </tr>
                        </thead>

                        <tbody class="custom-size">

                            @if (ProductionIssueAssyVMs?.ProductionIssueAssySubVMs != null && ProductionIssueAssyVMs.ProductionIssueAssySubVMs.Any())
                            {
                                @foreach (var item in ProductionIssueAssyVMs.ProductionIssueAssySubVMs)
                                {
                                    <tr>
                                        <td>@item.SlNo</td>
                                        <td>@(item.AssyItemCode ?? "—")</td>
                                        <td>@(item.ItemCode ?? "—")</td>
                                        <td>@(item.ItemName ?? "—")</td>
                                        <td>@item.MeasureUnit</td>
                                        <td>@($"{item.IssueQty:0.###}")</td>
                                        <td>@($"{item.UnitPrice:0.###}")</td>
                                        <td>@($"{item.StockQty:0.###}")</td>
                                        <td>@($"{item.BalQty:0.###}")</td>
                                        <td>@item.BatchNo</td>
                                        <td>@item.ProjectNo</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 justify-content-end">
                <a href="@($"/productionIssueList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                    <i class="bi bi-arrow-bar-left me-1"></i> Back To List
                </a>

                <a href="@($"/productionIssueAssy/update/{IssueId}")" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Modify
                </a>

                <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>

        </div>
    }
}

@code {

    protected override string ScreenName => "Production Issue WO Assembly";

    [Parameter] public int IssueId { get; set; }

    private string? pdfBase64;

    private bool isProcessing { get; set; } = true;
    private ProductionIssueAssyVM ProductionIssueAssyVMs { get; set; } = new();

    private List<ProductionIssueAssySubVM> refJobNumbers = new();
    private string refJobNosDisplay = "N/A";
    private string refJobDateDisplay = "N/A";

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _nav.NavigateTo("/access-denied");
                return;
            }

            await LoadAllProuctionAssyIssues();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in Production Assembly Issue Details OnInitializedAsync");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadAllProuctionAssyIssues()
    {
        try
        {
            if (IssueId <= 0)
                return;

            var ProductionIssueAssy = await prodIssueAssyService.GetProductionByIssueIdAsync(IssueId);

            if (ProductionIssueAssy == null)
            {
                await js.ToastrWarning("Production Issue Assembly not found.");
                return;
            }

            ProductionIssueAssyVMs = ProductionIssueAssy;

            refJobNumbers = await prodIssueAssyService.GetDistinctRefJobNoByIssueIdAsync(IssueId);

            if (refJobNumbers.Any())
            {
                // Only join the existing items, no extra commas
                refJobNosDisplay = string.Join(", ", refJobNumbers.Select(e => e.JobOrderNo).Where(n => !string.IsNullOrEmpty(n)));
                refJobDateDisplay = string.Join(", ", refJobNumbers
                    .Select(e => e.JobOrderDate.HasValue ? e.JobOrderDate.Value.ToString("dd/MM/yyyy") : null)
                    .Where(d => !string.IsNullOrEmpty(d)));
            }

        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error loading Production Issue Assembly by IssueId");
            await js.ToastrError("Failed to load Production Issue Assembly details.");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(IssueId, "ProdMtlIssNoteAssy.frx", "IssueId", false, ScreenName, "Sp_Print_ProductionIssueAss");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf Performa Invoice");
            await js.ToastrError("An unexpected error occurred while generating the PDF in Performa Invoice.");
        }
        finally
        {
            isProcessing = false;
        }
    }


}
