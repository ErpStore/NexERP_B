    private void OnShiftChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int shiftId))
            return;

        var shift = shifts.FirstOrDefault(x => x.ShiftId == shiftId);
        if (shift == null)
            return;

        ProductionLogVMs.ShiftId = shift.ShiftId;
        ProductionLogVMs.ShiftName = shift.ShiftName;

        // Reset times when shift changes
        ProductionLogVMs.StartTime = null;
        ProductionLogVMs.EndTime = null;
        ProductionLogVMs.TargetQtyForTotalHours = 0;
    }


    private void OnStartTimeChanged(ChangeEventArgs e)
    {
        if (!TimeOnly.TryParse(e.Value?.ToString(), out var startTime))
            return;

        var shift = shifts.FirstOrDefault(x => x.ShiftId == ProductionLogVMs.ShiftId);
        if (shift == null)
            return;

        // Validate start time inside shift
        bool validStart = shift.ShiftStartTime < shift.ShiftEndTime
            ? startTime >= shift.ShiftStartTime && startTime <= shift.ShiftEndTime
            : startTime >= shift.ShiftStartTime || startTime <= shift.ShiftEndTime;

        if (!validStart)
        {
            ProductionLogVMs.StartTime = null;
            return;
        }

        ProductionLogVMs.StartTime = startTime;
    }


    private async Task OnEndTimeChanged(ChangeEventArgs e)
    {
        if (!TimeOnly.TryParse(e.Value?.ToString(), out var endTime))
            return;

        if (ProductionLogVMs.StartTime == null)
            return;

        var shift = shifts.FirstOrDefault(x => x.ShiftId == ProductionLogVMs.ShiftId);
        if (shift == null)
            return;

        if (endTime < ProductionLogVMs.StartTime)
            return;

        bool validEnd = shift.ShiftStartTime < shift.ShiftEndTime
            ? endTime <= shift.ShiftEndTime
            : endTime <= shift.ShiftEndTime || endTime >= shift.ShiftStartTime;

        if (!validEnd)
            return;

        ProductionLogVMs.EndTime = endTime;

        // Recalculate production metrics
        await CalculateProductionPerformance();
    }


