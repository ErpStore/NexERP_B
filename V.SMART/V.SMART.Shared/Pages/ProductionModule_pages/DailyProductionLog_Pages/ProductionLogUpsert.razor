    #region RcChanged

    private async Task OnRcChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int rcId))
            return;

        try
        {

            ResetRcProcessFields();

            ProductionLogVMs.RCId = rcId;
            ProductionLogVMs.RCNo = routeCardVMs.FirstOrDefault(r => r.RCId == rcId)?.RCNo;

            // =====================================================
            // LOAD NEXT VALID PROCESS HIERARCHY
            // =====================================================
            processes = await productionLogService.LoadNextHierarchyAsync(rcId);

            if (processes == null || processes.Count == 0)
            {
                await _js.ToastrWarning("No pending process available for this Route Card.");
                return;
            }
            else if (processes == null || processes.Count == 1)
            {
                var firstProcess = processes.First();

                ProductionLogVMs.ProcessId = firstProcess.ProcessId;

                //08072026---------------------------------------------
                isReworkProcess = await productionLogService.GetIsReworkProcessAsync(ProductionLogVMs.RCId.Value, firstProcess.ProcessId);
                ///-----------------------------------------------------

                await LoadRcProcessDataAsync(rcId, firstProcess.ProcessId, isReworkProcess);
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(
                ex,
                $"Error in OnRcChanged | RCId: {rcId}");

            await _js.ToastrError("Failed to load Route Card process data.");
        }
    }


    private async Task ResetRcProcessFields()
    {
