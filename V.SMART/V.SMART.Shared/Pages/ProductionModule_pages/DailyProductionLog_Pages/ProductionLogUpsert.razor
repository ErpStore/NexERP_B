        ProductionLogVMs.ProcessName = null;

        ProductionLogVMs.ItemIdIn = null;
        ProductionLogVMs.ItemIdOut = null;
        ProductionLogVMs.ItemInCode = null;
        ProductionLogVMs.ItemOutCode = null;

        ProductionLogVMs.InputQty = 0;
        ProductionLogVMs.QtyOut = 0;

        ProductionLogVMs.AccQty = 0;
        ProductionLogVMs.RejQty = 0;
        ProductionLogVMs.RewQty = 0;
        ProductionLogVMs.ReturnQty = 0;

        ProductionLogVMs.CycleTime = null;
        ProductionLogVMs.SettingTime = null;

        ProductionLogVMs.TargetQtyForTotalHours = 0;
        ProductionLogVMs.ExpectedQty = 0;
        ProductionLogVMs.Possible = 0;

        ProductionLogVMs.EfficiencyPercent = 0;
        ProductionLogVMs.BonusEfficiencyPercent = 0;

        ProductionLogVMs.RMStock = 0;

        ProductionLogVMs.ProductionLogSubVMs?.Clear();
    }




    private async Task OnProcessChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int processId))
            return;

        if (ProductionLogVMs.RCId == null)
        {
            await _js.ToastrWarning("Please select Route Card first.");
            return;
        }

        try
        {
            // =====================================================
            // RESET PROCESS-SPECIFIC FIELDS ONLY
            // =====================================================

            await ResetProcessOnlyFields();

            ProductionLogVMs.ProcessId = processId;


            //08072026-----------------------
            isReworkProcess = await productionLogService.GetIsReworkProcessAsync(ProductionLogVMs.RCId.Value, processId);
            //--------------------------------

            await LoadRcProcessDataAsync(ProductionLogVMs.RCId.Value, processId, isReworkProcess);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"Error in OnProcessChanged | RCId: {ProductionLogVMs.RCId}, ProcessId: {processId}");
            await _js.ToastrError("Failed to load process data.");
        }
    }


    private async Task LoadRcProcessDataAsync(int rcId, int processId, bool isReworkProcess)
    {
        // =============================
        // CHECK EXISTING PRODUCTION LOG
        // =============================
        var existingLog = await productionLogService.GetActiveProductionLogAsync(rcId, processId, screenCode);

        if (existingLog != null)
        {
            ProductionLogVMs = existingLog;
            return;
        }

        // =============================
        // LOAD STORE MAPPING
        // =============================
        var issueStore = await productionLogService.GetMappedStoreForFormAsync("ProdLogIssueForm");

        var returnStore = await productionLogService.GetMappedStoreForFormAsync("ProdLogReturnForm");

        ProductionLogVMs.IssueStoreId = isReworkProcess ? 7 : (issueStore.StoreId > 0 ? issueStore.StoreId : null);
        ProductionLogVMs.IssueStoreName = isReworkProcess ? "REWORK STORE" : issueStore.StoreName;

        ProductionLogVMs.AddStoreId = returnStore.StoreId > 0 ? returnStore.StoreId : null;
        ProductionLogVMs.AddStoreName = returnStore.StoreName;

        // =============================
        // LOAD RC PROCESS DATA
        // =============================
        var rcData = await productionLogService.GetRCProcessDetailsByRcIdAndProcessId(rcId, processId, ProductionLogVMs.IssueStoreId.Value, screenCode);

        if (rcData == null)
            return;

        if (rcData.IsBOM)
        {
            await _js.ToastrWarning("This process is allocated as BOM. Please perform this operation in Production Component, not in Daily Production Log.");
            await ResetProcessOnlyFields();
            return;
        }

        // =============================
        // BASIC MAPPING
        // =============================
        ProductionLogVMs.ProcessId = rcData.ProcessId;
        ProductionLogVMs.ProcessName = rcData.ProcessName;
        ProductionLogVMs.RCProcessId = rcData.RCProcessId;

        ProductionLogVMs.ProcessCost = rcData.ProcessCost;
        ProductionLogVMs.RCQty = rcData.RCQty;

        ProductionLogVMs.MachineId = rcData.MachineId;
        ProductionLogVMs.MachineName = rcData.MachineName;

        ProductionLogVMs.Operator = rcData.Operator;

        ProductionLogVMs.CustId = rcData.CustId;
        ProductionLogVMs.CustomerName = rcData.CustomerName;

        ProductionLogVMs.ItemIdIn = rcData.ItemIdIn;
        ProductionLogVMs.ItemInCode = rcData.ItemInCode;

        ProductionLogVMs.ItemIdOut = rcData.ItemIdOut;
        ProductionLogVMs.ItemOutCode = rcData.ItemOutCode;

        //Important: Max Allowed Qty is based on RC Qty
        ProductionLogVMs.MaxAllowedQty = rcData.InputQty;

        ProductionLogVMs.InputQty = rcData.InputQty;
        ProductionLogVMs.QtyOut = rcData.QtyOut;
        ProductionLogVMs.QtyOutPerUnit = rcData.QtyOutPerUnit;

        //Stock
        ProductionLogVMs.RMStock = rcData.RMStock;

        ProductionLogVMs.CycleTime = rcData.CycleTime;
        ProductionLogVMs.SettingTime = rcData.SettingTime;

        ProductionLogVMs.AccQty = rcData.AccQty;
        ProductionLogVMs.RejQty = rcData.RejQty;
        ProductionLogVMs.RewQty = rcData.RewQty;
        ProductionLogVMs.ReturnQty = rcData.ReturnQty;

        ProductionLogVMs.CostId = rcData.CostId;
        ProductionLogVMs.CostCenterName = rcData.CostCenterName;

        //QC
        ProductionLogVMs.IsQcRequired = rcData.IsQcRequired;


        // =============================
        // VALIDATE & AUTO-ADJUST QTY
        // =============================
        await ValidateAndAdjustQtyAsync(ProductionLogVMs);

        // =============================
        // AUTO SHIFT + TIME
        // =============================
        await AutoSelectShiftAndTime();

        // =============================
        // POSSIBLE QTY
        // =============================
        ProductionLogVMs.Possible = CalculatePossibleQty(
        ProductionLogVMs.StartTime,     // This is not a Shift-Starting Time Actual Prduction Start time is taking Here
        ProductionLogVMs.ShiftEndTime,
        ProductionLogVMs.CycleTime,
        ProductionLogVMs.SettingTime);

        // =============================
        // FINAL CALCULATION
        // =============================
        await CalculateProductionPerformance();
    }

    public static decimal CalculatePossibleQty(TimeOnly? shiftStart, TimeOnly? shiftEnd, TimeSpan? cycleTime, TimeSpan? settingTime)
    {
        if (shiftStart == null ||
            shiftEnd == null ||
            cycleTime == null ||
            cycleTime.Value.TotalMinutes <= 0)
            return 0;

        double totalMinutes =
            ProductionTimeHelper.GetTotalMinutes(
                shiftStart.Value,
                shiftEnd.Value);

        double effectiveMinutes =
            totalMinutes - (settingTime?.TotalMinutes ?? 0);

        if (effectiveMinutes <= 0)
            return 0;

        return Math.Floor(
            (decimal)(effectiveMinutes / cycleTime.Value.TotalMinutes));
    }


    public static class ProductionTimeHelper
    {
        public static double GetTotalMinutes(TimeOnly start, TimeOnly end)
        {
            var startSpan = start.ToTimeSpan();
            var endSpan = end.ToTimeSpan();

            // Handle night shift crossing midnight
            if (endSpan < startSpan)
                endSpan = endSpan.Add(TimeSpan.FromDays(1));

            return (endSpan - startSpan).TotalMinutes;
        }
    }


    private async Task AutoSelectShiftAndTime()
    {
        var now = TimeOnly.FromDateTime(DateTime.Now);
        shifts = await productionLogService.GetAllShiftAsync();

        foreach (var shift in shifts)
        {
            bool isNightShift = shift.ShiftStartTime > shift.ShiftEndTime;

            bool isInShift = isNightShift
                ? (now >= shift.ShiftStartTime || now <= shift.ShiftEndTime)
                : (now >= shift.ShiftStartTime && now <= shift.ShiftEndTime);

            if (!isInShift)
                continue;

            ProductionLogVMs.ShiftId = shift.ShiftId;
            ProductionLogVMs.ShiftName = shift.ShiftName;

            ProductionLogVMs.StartTime = now;
            ProductionLogVMs.ShiftStartTime = now;
            ProductionLogVMs.ShiftEndTime = shift.ShiftEndTime;

            // ============================
            // END TIME CALCULATION
            // ============================
            double cycleMinutes = ProductionLogVMs.CycleTime?.TotalMinutes ?? 0;
            double settingMinutes = ProductionLogVMs.SettingTime?.TotalMinutes ?? 0;
            decimal qty = ProductionLogVMs.RCQty;

            double requiredMinutes = (double)qty * cycleMinutes + settingMinutes;

            var calculatedEnd = now.AddMinutes(requiredMinutes);

            // Clamp to shift end
            ProductionLogVMs.EndTime = IsTimeWithinShift(calculatedEnd, shift) ? calculatedEnd : shift.ShiftEndTime;
            break;
        }
    }

    private async Task OnEndTimeChanged(TimeOnly endTime)
    {
        ProductionLogVMs.EndTime = endTime;
        await CalculateProductionPerformance();
    }

    private bool IsTimeWithinShift(TimeOnly time, ShiftAllocation shift)
    {
        bool isNightShift = shift.ShiftStartTime > shift.ShiftEndTime;

        return isNightShift ? (time >= shift.ShiftStartTime || time <= shift.ShiftEndTime) : (time >= shift.ShiftStartTime && time <= shift.ShiftEndTime);
    }


    private async Task CalculateProductionPerformance()
    {
        try
        {
            // ============================
            // BASIC VALIDATION
            // ============================
            if (ProductionLogVMs.StartTime == null ||
                ProductionLogVMs.EndTime == null ||
                ProductionLogVMs.CycleTime == null ||
                ProductionLogVMs.CycleTime.Value.TotalMinutes <= 0)
                return;

            ProductionLogVMs.SettingTime ??= TimeSpan.Zero;

            // ============================
            // TOTAL SHIFT MINUTES
            // ============================
            double totalShiftMinutes =
                ProductionTimeHelper.GetTotalMinutes(
                    ProductionLogVMs.StartTime.Value,
                    ProductionLogVMs.EndTime.Value);

            if (totalShiftMinutes <= 0)
                return;

            double cycleMinutes = ProductionLogVMs.CycleTime.Value.TotalMinutes;
            double settingMinutes = ProductionLogVMs.SettingTime.Value.TotalMinutes;

            // ============================
            // IDEAL AVAILABLE TIME
            // ============================
            double idealMinutes =
                Math.Max(0, totalShiftMinutes - settingMinutes);

            // ============================
            // TARGET QTY (NO STOPPAGES)
            // ============================
            ProductionLogVMs.TargetQtyForTotalHours =
                Math.Floor((decimal)(idealMinutes / cycleMinutes));

            // ============================
            // STOPPAGE LOSS
            // ============================
            double totalLossMinutes = 0;
            double bonusEfficiency = 0;

            foreach (var s in ProductionLogVMs.ProductionLogSubVMs)
            {
                double stoppage = s.StopageTime.GetValueOrDefault();
                double efficiency = s.EfficienctyPerc.GetValueOrDefault();

                if (stoppage <= 0 || efficiency <= 0)
                    continue;

                double lossMinutes = stoppage * (efficiency / 100.0);
                totalLossMinutes += lossMinutes;

                bonusEfficiency +=
                    (stoppage / idealMinutes) * efficiency;
            }

            totalLossMinutes =
                Math.Min(totalLossMinutes, idealMinutes);

            // ============================
            // EFFECTIVE WORKING TIME
            // ============================
            double effectiveMinutes =
                idealMinutes - totalLossMinutes;

            ProductionLogVMs.EffectiveWorkingMinutes =
                Math.Round((decimal)effectiveMinutes, 2);

            // ============================
            // EXPECTED QTY
            // ============================
            ProductionLogVMs.ExpectedQty =
                Math.Floor((decimal)(effectiveMinutes / cycleMinutes));

            // ============================
            // NET PRODUCED QTY
            // ============================
            decimal netQty =
                Math.Max(0,
                    ProductionLogVMs.AccQty - ProductionLogVMs.RejQty);

            // ============================
            // WORK EFFICIENCY %
            // ============================
            ProductionLogVMs.EfficiencyPercent =
                ProductionLogVMs.ExpectedQty <= 0
                    ? 0
                    : Math.Round(
                        (netQty / ProductionLogVMs.ExpectedQty) * 100, 2);

            // ============================
            // BONUS EFFICIENCY %
            // ============================
            ProductionLogVMs.BonusEfficiencyPercent =
                Math.Round((decimal)bonusEfficiency, 2);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"Error in CalculateProductionPerformance | LogNo: {ProductionLogVMs?.LogNo}");
            await _js.ToastrError("Error calculating production performance.");
        }
    }

    #endregion


    #region Input Qty Changed

    private async Task OnQtyChange(ChangeEventArgs e, ProductionLogVM vm)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var inputQty))
                return;

            vm.InputQty = inputQty;

            await ValidateAndAdjustQtyAsync(vm);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"OnQtyChange failed for LogNo: {ProductionLogVMs?.LogNo}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    private async Task ValidateAndAdjustQtyAsync(ProductionLogVM vm)
    {
        decimal inputQty = vm.InputQty;
        decimal maxAllowedQty = vm.MaxAllowedQty;
        decimal qtyPerUnit = vm.QtyOutPerUnit;
        decimal rmStockQty = vm.RMStock;

        // =============================
        // RM STOCK ZERO CHECK
        // =============================
        if (rmStockQty <= 0 && qtyPerUnit > 0)
        {
            vm.InputQty = 0;
            vm.QtyOut = 0;

            await _js.ToastrWarning("Material stock does not exist.");
            return;
        }

        // =============================
        // RC QTY VALIDATION
        // =============================
        if (inputQty > maxAllowedQty)
        {
            inputQty = maxAllowedQty;
            await _js.ToastrWarning($"Input Qty cannot be greater than Max Allowed Qty ({maxAllowedQty})."
            );
        }
        else if (inputQty < 0)
        {
            inputQty = 0;
            await _js.ToastrWarning("Input Qty cannot be negative.");
        }

        // =============================
        // QTY OUT CALCULATION
        // =============================
        decimal qtyOut = inputQty * qtyPerUnit;

        // =============================
        // RM STOCK VALIDATION
        // =============================
        if (qtyOut > rmStockQty && qtyPerUnit > 0)
        {
            decimal allowedInputQty =
                Math.Floor(rmStockQty / qtyPerUnit);

            inputQty = allowedInputQty;
            qtyOut = allowedInputQty * qtyPerUnit;

            await _js.ToastrWarning($"Insufficient RM Stock. Input Qty auto-adjusted to {allowedInputQty}.");
        }

        vm.InputQty = inputQty;
        vm.QtyOut = qtyOut;
    }



    #endregion

    #region Accecpt / Reject / Rework Qty Changes

    private async Task OnResultQtyChanged(ChangeEventArgs e, ProductionLogVM vM)
    {
        try
        {
            if (vM == null)
                return;

            var inputQty = vM.InputQty;
            bool adjusted = false;

            // =========================
            // NORMALIZE NEGATIVES
            // =========================
            if (vM.AccQty < 0) { vM.AccQty = 0; adjusted = true; }
            if (vM.RejQty < 0) { vM.RejQty = 0; adjusted = true; }
            if (vM.RewQty < 0) { vM.RewQty = 0; adjusted = true; }

            // =========================
            // INDIVIDUAL LIMIT
            // =========================
            if (vM.AccQty > inputQty) { vM.AccQty = inputQty; adjusted = true; }
            if (vM.RejQty > inputQty) { vM.RejQty = inputQty; adjusted = true; }
            if (vM.RewQty > inputQty) { vM.RewQty = inputQty; adjusted = true; }

            // =========================
            // TOTAL LIMIT
            // =========================
            var total = vM.AccQty + vM.RejQty + vM.RewQty;

            if (total > inputQty)
            {
                var excess = total - inputQty;
                adjusted = true;

                // Priority: Rework → Reject → Accept
                if (vM.RewQty >= excess)
                    vM.RewQty -= excess;
                else if (vM.RejQty >= excess)
                    vM.RejQty -= excess;
                else
                    vM.AccQty -= excess;
            }

            // =========================
            // AUTO RETURN QTY
            // =========================
            vM.ReturnQty = inputQty - (vM.AccQty + vM.RejQty + vM.RewQty);
            if (vM.ReturnQty < 0)
            {
                vM.ReturnQty = 0;
                adjusted = true;
            }

            // =========================
            // TOASTER (ONLY IF ADJUSTED)
            // =========================
            if (adjusted)
            {
                await _js.ToastrInfo("Accepted + Rejected + Rework quantity cannot exceed Input quantity. Values were auto-adjusted.");
            }

            //07072026
            if (vM.RewQty > 0)
            {
                await ReworkProcess();
            }
            //---------------------------

            //Production Performance calculation
            await CalculateProductionPerformance();

        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error while validating Production Result Quantities");
            await _js.ToastrError("Something went wrong while calculating quantities. Please try again.");
        }
    }

