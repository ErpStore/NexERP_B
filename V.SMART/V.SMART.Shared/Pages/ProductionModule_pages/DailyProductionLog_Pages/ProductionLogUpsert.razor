@page "/productionLog/create"
@page "/productionLog/create/{IsProduction:bool}"
@page "/productionLog/update/{LogId:int}"
@page "/productionLog/update/{LogId:int}/{IsProduction:bool}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IProductionService
@using V.SMART.Shared.Data.Planning.ComponentRouteCard
@using V.SMART.Shared.Data.Production.DailyProductionLog
@using V.SMART.Shared.ViewModels.PlanningViewModel.RouteCardViewModel
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionLogViewModel
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionSCNAssyViewModel
@using MudBlazor

@inherits BaseUserRightsComponent
@implements IAsyncDisposable

@inject ICalculationService _calculationService
@inject IProductionLogService productionLogService
@inject ILoggingService logs

@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">

    @if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }

    @if (ActiveModal == "ProductionStopage")
    {
        <div class="table-responsive" style="overflow-x:auto;">
            <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 800px;">
                <thead class="custom-blue">
                    <tr>
                        <th style="width:160px;">Stop Type</th>
                        <th style="width:120px;">Efficiency (%)</th>
                        <th class="d-none" style="width:300px;">Definition</th>
                        <th style="width:150px;">Time Spent (Minutes)</th>
                        <th style="width:120px;">Action</th>
                    </tr>
                </thead>

                <tbody class="custom-size">
                    @foreach (var row in ProductionLogVMs.ProductionLogSubVMs)
                    {
                        <tr>
                            <td>
                                <select class="form-select form-select-sm"
                                        @bind="row.LogSettingId"
                                        @bind:event="onchange"
                                        @bind:after="() => UpdateStopageRow(row)">

                                    <option value="">-- Select Stop Type --</option>

                                    @foreach (var s in productionLogSettings)
                                    {
                                        <option value="@s.Id">@s.ProdStopType</option>
                                    }
                                </select>
                            </td>

                            <td>
                                <input class="form-control form-control-sm"
                                       type="number"
                                       @bind="row.EfficienctyPerc" readonly />
                            </td>

                            <td class="d-none">
                                <InputTextArea class="form-control form-control-sm"
                                               @bind-Value="row.Defination"
                                               readonly>
                                </InputTextArea>
                            </td>

                            <td>

                                <input class="form-control form-control-sm"
                                       type="number"
                                       @bind="row.StopageTime"
                                       @bind:event="oninput"
                                       @onchange="@(e => OnStoppageTimeChanges(e, row))" />
                            </td>
                            <td>
                                <button class="btn btn-sm btn-danger"
                                        @onclick="@(() => RemoveStopageRow(row))">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <button class="btn btn-sm btn-primary" @onclick="AddStopageRow">
                Add Stopage
            </button>
        </div>

    }

</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>



@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">


            @if (!IsProduction)
            {
                <PageHeader TitleText="@(ProductionLogVMs.LogId > 0 ? "Start Production Log" : "End Production Log")"
                            TitleIcon="bi bi-tag"
                            Breadcrumbs="@dailyLogBreadcrumbs" />
            }


            <div class="card-body bg-light">
                <EditForm Model="ProductionLogVMs" OnValidSubmit="UpsertProdLog">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3 mb-2 align-items-center">
                        <!-- Manufacturing / Labour Toggle -->
                        <div class="col-12 col-md-6">
                        </div>

                        <!-- Correspondence Status -->
                        <div class="col-12 col-md-6 d-flex justify-content-end align-items-center">
                            @if (ProductionLogVMs.LogId > 0 && !string.IsNullOrWhiteSpace(ProductionLogVMs.LogNo))
                            {
                                <CorrespondenceStatus ReferenceType="Production SCN Assembly"
                                                      ReferenceId="@Convert.ToInt32(ProductionLogVMs.LogId)"
                                                      ReferenceTypeName="@ProductionLogVMs.LogNo" />
                            }
                        </div>
                    </div>

                    <div class="row g-3 mb-2">

                        <!-- =================== Production SCN Details =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Route Card Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- RC No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Route Card No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">

                                            @if (!LogId.HasValue || LogId == 0)
                                            {
                                                <!-- New -->
                                                <select class="form-select form-select-sm rounded-3 w-100"
                                                        value="@ProductionLogVMs.RCId"
                                                        @onchange="OnRcChanged">
                                                    <option value="">-- Select Route Card --</option>
                                                    @foreach (var rc in routeCardVMs)
                                                    {
                                                        <option value="@rc.RCId">@rc.RCNo</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <!-- Edit/View -->
                                                <input type="text"
                                                       class="form-control form-control-sm rounded-3"
                                                       value="@ProductionLogVMs.RCNo"
                                                       readonly />
                                            }

                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Process</small>
                                        </label>
                                        <div class="col-12 col-sm-9">

                                            @if (!LogId.HasValue || LogId == 0)
                                            {
                                                <select class="form-select form-select-sm rounded-3 w-100"
                                                        value="@ProductionLogVMs.ProcessId"
                                                        @onchange=OnProcessChanged>
                                                    <option value="">-- Select Process --</option>
                                                    @foreach (var p in processes)
                                                    {
                                                        <option value="@p.ProcessId">@p.ProcessName</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <input type="text"
                                                       class="form-control form-control-sm rounded-3"
                                                       value="@ProductionLogVMs.ProcessName"
                                                       readonly />
                                            }

                                        </div>
                                    </div>


                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>RouteCard Qty</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <input type="number" class="form-control form-control-sm rounded-3 w-100"
                                                       step="any" value="@ProductionLogVMs.RCQty" disabled />
                                            </div>
                                        </div>
                                    </div>




                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Customer</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                       value="@ProductionLogVMs.CustomerName" readonly />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Machine</small>
                                        </label>

                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100">
                                                <select class="form-select form-select-sm"
                                                        value="@ProductionLogVMs.MachineId"
                                                        @onchange="e => OnMachineChanged(e, ProductionLogVMs)">
                                                    <option value="">-- Select Machine --</option>

                                                    @foreach (var machine in MachineList)
                                                    {
                                                        <option value="@machine.MachineId">
                                                            @machine.MachineName
                                                        </option>
                                                    }
                                                </select>

                                                <button type="button"
                                                        class="btn btn-primary btn-sm rounded-end-3"
                                                        @onclick="ShowMachineStatus">
                                                    Machine Status
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Operator Name <span class="text-danger">*</span></small>
                                        </label>

                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm"
                                                    value="@ProductionLogVMs.Operator"
                                                    @onchange="e => OnUserChanged(e, ProductionLogVMs)"
                                                    required>
                                                <option value="">-- Select Operator --</option>

                                                @foreach (var user in Users)
                                                {
                                                    <option value="@user">@user</option>
                                                }
                                            </select>

                                            <ValidationMessage For="@(() => ProductionLogVMs.Operator)" />
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- Production Log Details -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">
                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Production Log Details</span>
                                </div>

                                <div class="card-body">
                                    <!-- Log No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark"><small>Log No.</small></label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                           placeholder="Log No."
                                                           maxlength="30"
                                                           @bind-Value="ProductionLogVMs.LogNo"
                                                           readonly />
                                                <span class="input-group-text rounded-3">@ProductionLogVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => ProductionLogVMs.LogNo)" />
                                            <ValidationMessage For="@(() => ProductionLogVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- Log Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark"><small>Log Date</small></label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="ProductionLogVMs.LogDate" />
                                            <ValidationMessage For="@(() => ProductionLogVMs.LogDate)" />
                                        </div>
                                    </div>

                                    <!-- Shift -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark"><small>Select Shift</small></label>
                                        <div class="col-12 col-sm-9">
                                            @if (LogId == 0)
                                            {
                                                <select class="form-select form-select-sm rounded-3 w-100"
                                                        value="@ProductionLogVMs.ShiftId"
                                                        @onchange="OnShiftChanged">
                                                    <option value="">--Select shift--</option>
                                                    @foreach (var shift in shifts)
                                                    {
                                                        <option value="@shift.ShiftId">@shift.ShiftName</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control form-control-sm rounded-3"
                                                       value="@ProductionLogVMs.ShiftName" readonly />
                                            }
                                        </div>
                                    </div>

                                    <!-- Start / End Time -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark"><small>Start Time</small></label>
                                        <div class="col-12 col-sm-3">
                                            <input type="time"
                                                   class="form-control form-control-sm rounded-3"
                                                   value="@ProductionLogVMs.StartTime?.ToString("HH:mm")"
                                                   @onchange="OnStartTimeChanged" />
                                            <ValidationMessage For="@(() => ProductionLogVMs.StartTime)" />
                                        </div>

                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark"><small>End Time</small></label>
                                        <div class="col-12 col-sm-3">
                                            <input type="time"
                                                   class="form-control form-control-sm rounded-3"
                                                   value="@ProductionLogVMs.EndTime?.ToString("HH:mm")"
                                                   @onchange="OnEndTimeChanged" />
                                            <ValidationMessage For="@(() => ProductionLogVMs.EndTime)" />
                                        </div>
                                    </div>

                                    <!-- Total Time Display -->
                                    <div class="mb-2 row justify-content-center">
                                        <div class="col-12 text-center">
                                            <label class="fw-bold text-dark fs-6">
                                                Total Time :
                                                <span class="text-primary ms-1">
                                                    @ProductionLogVMs.TotalTime.ToString(@"hh\:mm")
                                                </span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Production Details -->
                        <div class="col-12 mb-2">
                            <div class="card h-100 shadow-sm">
                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Production Details</span>
                                    <button type="button" class="btn btn-danger btn-sm ms-auto"
                                            @onclick='() => OpenModal("ProductionStopage")'>
                                        Production Stopage
                                    </button>
                                </div>

                                <div class="card-body">
                                    <div class="row g-3">

                                        <!-- Shift Timings Message -->
                                        <div class="col-12">
                                            <div class="alert alert-success py-2 text-center fw-semibold">
                                                In Your Shift Timings from :
                                                <strong>@ProductionLogVMs.ShiftStartTime?.ToString("HH:mm:ss")</strong>
                                                to
                                                <strong>@ProductionLogVMs.ShiftEndTime?.ToString("HH:mm:ss")</strong>
                                                <br />
                                                Possible Production Quantity :
                                                <strong>@ProductionLogVMs.Possible</strong>
                                            </div>
                                        </div>

                                        <!-- Item Issued -->
                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Item Code - Iss.</label>
                                            <input class="form-control form-control-sm" value="@ProductionLogVMs.ItemOutCode" disabled />
                                        </div>

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Qty Iss.</label>
                                            <input class="form-control form-control-sm"
                                                   value="@ProductionLogVMs.QtyOut.ToString("0.###")"
                                                   disabled />
                                        </div>

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Issue Store</label>
                                            @*     <InputSelect class="form-select form-select-sm" @bind-Value="ProductionLogVMs.IssueStoreId">
                                                <option value="">-- Select --</option>
                                                @foreach (var s in IssueStores)
                                                {
                                                    <option value="@s.StoreId">@s.StoreName</option>
                                                }
                                            </InputSelect> *@

                                            <InputSelect class="form-select form-select-sm"
                                                         @bind-Value="ProductionLogVMs.IssueStoreId"
                                                         @bind-Value:after="OnIssueStorechange">
                                                <option value="">-- Select --</option>
                                                @foreach (var s in IssueStores)
                                                {
                                                    <option value="@s.StoreId">@s.StoreName</option>
                                                }
                                            </InputSelect>

                                        </div>

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">RM/Component Stock Qty</label>
                                            <input class="form-control form-control-sm fw-bold text-danger bg-light border-danger"
                                                   value="@ProductionLogVMs.RMStock"
                                                   step="any"
                                                   disabled />
                                        </div>

                                        <!-- Item Produced -->
                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Item Code - In</label>
                                            <input class="form-control form-control-sm" value="@ProductionLogVMs.ItemInCode" disabled />
                                        </div>

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Input Qty</label>
                                            <input type="number"
                                                   class="form-control form-control-sm"
                                                   placeholder="Qty"
                                                   title="Enter Input Quantity"
                                                   @bind="ProductionLogVMs.InputQty"
                                                   @bind:event="oninput"
                                                   @onchange="@(e => OnQtyChange(e, ProductionLogVMs))"
                                                   min="0"
                                                   max="@ProductionLogVMs.MaxAllowedQty"
                                                   step="any"
                                                   readonly="@(ProductionLogVMs.LogId > 0)" />
                                            <ValidationMessage For="@(() => ProductionLogVMs.InputQty)" />
                                        </div>


                                        <!-- Stores / Cost / Process -->
                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Return Store</label>
                                            <InputSelect class="form-select form-select-sm" @bind-Value="ProductionLogVMs.AddStoreId">
                                                <option value="">-- Select --</option>
                                                @foreach (var s in AddStores)
                                                {
                                                    <option value="@s.StoreId">@s.StoreName</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">CostCentre No.</label>
                                            <input class="form-control form-control-sm" value="@ProductionLogVMs.CostCenterName" readonly />
                                        </div>

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Process</label>
                                            <input class="form-control form-control-sm" value="@ProductionLogVMs.ProcessName" readonly />
                                        </div>

                                        <!-- Cycle / Setting / Idle -->
                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Cycle Time</label>
                                            <input class="form-control form-control-sm" value="@ProductionLogVMs.CycleTime?.ToString(@"hh\:mm\:ss")" disabled />
                                        </div>

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Setting Time</label>
                                            <input class="form-control form-control-sm" value="@ProductionLogVMs.SettingTime?.ToString(@"hh\:mm\:ss")" disabled />
                                        </div>

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">M/C Idle Time (Min)</label>
                                            <input class="form-control form-control-sm bg-light" value="@ProductionLogVMs.MachineIdleTime" disabled />
                                        </div>

                                        <div class="col-12"><hr class="my-2" /></div>


                                        <!-- Efficiency / Target -->
                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Expected Qty</label>
                                            <input class="form-control form-control-sm text-danger fw-bold"
                                                   @bind="ProductionLogVMs.ExpectedQty"
                                                   disabled />
                                        </div>

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Target Qty (Total)</label>
                                            <input class="form-control form-control-sm text-success fw-bold"
                                                   @bind="ProductionLogVMs.TargetQtyForTotalHours"
                                                   disabled />
                                        </div>


                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Efficiency %</label>
                                            <input class="form-control form-control-sm fw-bold"
                                                   @bind="ProductionLogVMs.EfficiencyPercent" readonly />
                                        </div>


                                        <!-- Bonus -->

                                        <div class="col-sm-3">
                                            <label class="form-label small fw-semibold">Bonus Efficiency %</label>
                                            <input type="text" class="form-control form-control-sm bg-success-subtle" @bind="ProductionLogVMs.BonusEfficiencyPercent" readonly />
                                        </div>

                                        @if (ProductionLogVMs.LogId > 0)
                                        {
                                            <div class="col-12">
                                                <hr class="my-2" />
                                            </div>

                                            <!-- Accepted / Rejected / Rework / Return -->
                                            <div class="row mb-2 align-items-center">
                                                <label class="col-md-2 col-form-label small fw-semibold">
                                                    Accepted Qty
                                                </label>
                                                <div class="col-md-2">
                                                    <input type="number"
                                                           class="form-control form-control-sm fw-bold text-success" step="any"
                                                           @bind="ProductionLogVMs.AccQty"
                                                           @bind:event="oninput"
                                                           @onchange="@(e => OnResultQtyChanged(e, ProductionLogVMs))" />
                                                </div>

                                                <label class="col-md-2 col-form-label small fw-semibold">
                                                    Ins No.
                                                </label>
                                                <div class="col-md-2">
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           @bind-value="ProductionLogVMs.InspectNo" readonly />
                                                </div>
                                            </div>

                                            <div class="row mb-2 align-items-center">
                                                <label class="col-md-2 col-form-label small fw-semibold">
                                                    Rejected Qty
                                                </label>

                                                <div class="col-md-2">
                                                    <input type="number"
                                                           class="form-control form-control-sm fw-bold text-danger" step="any"
                                                           @bind="ProductionLogVMs.RejQty"
                                                           @bind:event="oninput"
                                                           @onchange="@(e => OnResultQtyChanged(e, ProductionLogVMs))" />

                                                </div>

                                                <label class="col-md-2 col-form-label small fw-semibold">
                                                    Rejected Reason
                                                </label>

                                                <div class="col-md-2">
                                                    <InputTextArea class="form-control form-control-sm fw-bold"
                                                                   rows="1"
                                                                   @bind-Value="ProductionLogVMs.RejReason" />
                                                </div>
                                            </div>

                                            <div class="row mb-2 align-items-center">
                                                <label class="col-md-2 col-form-label small fw-semibold">
                                                    Rework Qty
                                                </label>

                                                <div class="col-md-2">
                                                    <input type="number"
                                                           class="form-control form-control-sm fw-bold text-warning" step="any"
                                                           @bind="ProductionLogVMs.RewQty"
                                                           @bind:event="oninput"
                                                           @onchange="@(e => OnResultQtyChanged(e, ProductionLogVMs))" />

                                                </div>

                                                <label class="col-md-2 col-form-label small fw-semibold">
                                                    Rework Process
                                                </label>

                                                <div class="col-md-2">

                                                    @*07062026  <input type="text"
                                                        class="form-control form-control-sm fw-bold"
                                                        @bind="ProductionLogVMs.RewProcessName" /> *@


                                                    <select class="form-control form-control-sm"
                                                            @bind="ProductionLogVMs.RewProcessId"
                                                            @bind:after="OnRewProcessChanged"
                                                            disabled="@(ProductionLogVMs.RewQty <= 0)">

                                                        <option value="0">--Select Process--</option>

                                                        @foreach (var process in Process)
                                                        {
                                                            <option value="@process.ProcessId">
                                                                @process.Process.ProcessName
                                                            </option>
                                                        }
                                                    </select>

                                                </div>

                                                <label class="col-md-2 col-form-label small fw-semibold">
                                                    Rework Reason
                                                </label>

                                                <div class="col-md-2">
                                                    <InputTextArea class="form-control form-control-sm fw-bold"
                                                                   rows="1"
                                                                   @bind-Value="ProductionLogVMs.RewReason" />
                                                </div>
                                            </div>

                                            <div class="row mb-2 align-items-center">
                                                <label class="col-md-2 col-form-label small fw-semibold">
                                                    Return Qty
