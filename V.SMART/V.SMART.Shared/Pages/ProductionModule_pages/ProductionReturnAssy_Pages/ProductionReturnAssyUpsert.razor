    #region Production Issue Assembly Operations

    private async Task UpsertProdReturnAssy()
    {
        try
        {
            isProcessing = true;

            ProductionReturnAssyVMs.ProductionReturnAssySubVMs.RemoveAll(x =>
                !x.ItemId.HasValue ||
                !x.QtyReturned.HasValue || x.QtyReturned == 0
            );

            if (!ProductionReturnAssyVMs.ProductionReturnAssySubVMs.Any())
            {
                await _js.ToastrError("Cannot save a Job Order without valid items.");
                return;
            }

            foreach (var line in ProductionReturnAssyVMs.ProductionReturnAssySubVMs)
            {
                bool isValid = await ValidateProdIssueSubAsync(line, ProductionReturnAssyVMs);
                if (!isValid) return;
            }

            // Save
            var isNewProdIsssue = ProductionReturnAssyVMs.ReturnId == 0;

            try
            {
                await prodReturnAssyService.UpsertProductionReturnAsync(ProductionReturnAssyVMs, screenCode);
            }
            catch (Exception ex)
            {
                await _js.ToastrError(ex.Message);
                return;
            }

            if (isNewProdIsssue)
                await _js.ToastrSuccess("Production Return Assembly saved successfully.");
            else
                await _js.ToastrSuccess("Production Return Assembly updated successfully.");
            
            // Discard popup Clear
            await _js.InvokeVoidAsync("NavigationGuard.clear");

            _navigationManager.NavigateTo("/productionReturnAssyList");
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "UpsertProdReturnAssy failed.");
            await _js.ToastrError("Error saving Production Return Assembly.");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<bool> ValidateProdIssueSubAsync(ProductionReturnAssySubVM line, ProductionReturnAssyVM productionReturnAssyVM)
    {
        try
        {
            if (!line.ItemId.HasValue)
            {
                await _js.ToastrError("One or more items are missing Item selection.");
                return false;
            }

            if (!line.QtyReturned.HasValue || line.QtyReturned <= 0)
            {
                await _js.ToastrError($"Item {line.ItemId}: Return Quantity must be greater than 0.");
                return false;
            }


            if (!productionReturnAssyVM.Rejection && !productionReturnAssyVM.Return)
            {
                if (line.ReturnSubId == 0 && line.RefJobOrderId > 0)
                {
                    var jobBalQty = await prodReturnAssyService.GetJobOrderBalQtyFromJobId(line.RefJobOrderId.GetValueOrDefault());
                    if (line.QtyReturned > jobBalQty)
                    {
                        line.QtyReturned = jobBalQty;
                        line.BalQty = jobBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Job Order Balance Qty ({jobBalQty}).");
                        return false;
                    }
                }
                else if (line.ReturnSubId > 0)
                {
                    var original = await prodReturnAssyService.GetProductionReturnSubItemDetailByReturnSubIdAsync(line.ReturnSubId);
                    if (original != null)
                    {
                        decimal origBalQty = original.BalQty ?? 0m;
                        decimal origQty = original.QtyReturned ?? 0m;
                        var alreadyTransacted = origQty - origBalQty;

                        if (line.QtyReturned < alreadyTransacted)
                        {
                            line.QtyReturned = alreadyTransacted;
                            line.BalQty = 0m;
                            await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                            return false;
                        }
                        else
                        {
                            var difference = line.QtyReturned.GetValueOrDefault() - origQty;
                            line.BalQty = Math.Max(0m, origBalQty + difference);
                        }
                    }
                }
            }
            else
            {
                if (line.ReturnSubId == 0 && line.RefIssueSubId > 0)
                {
                    var issueAssyItemBalQty = await prodReturnAssyService.GetIssueBalQtyByIssueSubId(line.RefIssueSubId.GetValueOrDefault());
                    if (line.QtyReturned > issueAssyItemBalQty)
                    {
                        line.QtyReturned = issueAssyItemBalQty;
                        line.BalQty = issueAssyItemBalQty;
                        await _js.ToastrWarning($"Qty cannot exceed Production Issue item Balance Qty ({issueAssyItemBalQty}).");
                        return false;
                    }
                }
                else if (line.ReturnSubId > 0)
                {
                    var original = await prodReturnAssyService.GetProductionReturnSubItemDetailByReturnSubIdAsync(line.ReturnSubId);
                    if (original != null)
                    {
                        decimal origBalQty = original.BalQty ?? 0m;
                        decimal origQty = original.QtyReturned ?? 0m;
                        var alreadyTransacted = origQty - origBalQty;

                        if (line.QtyReturned < alreadyTransacted)
                        {
                            line.QtyReturned = alreadyTransacted;
                            line.BalQty = 0m;
                            await _js.ToastrWarning($"Qty cannot be less than {alreadyTransacted} (already transacted).");
                            return false;
                        }
                        else
                        {
                            var difference = line.QtyReturned.GetValueOrDefault() - origQty;
                            line.BalQty = Math.Max(0m, origBalQty + difference);
                        }
                    }
                }
            }


            return true;
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "ValidateProdIssueSubAsync failed.");
            await _js.ToastrError("Error Validate Production Issue line.");
            return false;
        }
    }

