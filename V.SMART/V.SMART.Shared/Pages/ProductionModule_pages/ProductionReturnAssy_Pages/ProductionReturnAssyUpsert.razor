    private async Task CancelEdit(ProductionReturnAssySubVM? item, ProductionReturnAssyVM? parentProdReturnAssy)
    {
        try
        {
            if (item == null || parentProdReturnAssy == null)
                return;

            bool isEmptyOrInvalid =
                (item.ItemId <= 0) ||
                (!item.QtyReturned.HasValue || item.QtyReturned.Value <= 0);

            if (isEmptyOrInvalid)
            {
                parentProdReturnAssy.ProductionReturnAssySubVMs.Remove(item);
                await ResetSlno();
            }
            else
            {
                item.IsEditable = false;
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"CancelEdit failed for ReturnSubId: {item?.ReturnSubId}");
            await _js.ToastrError("Failed to cancel edit. Please try again.");
        }
    }

    private async Task RemoveRow(ProductionReturnAssySubVM item)
    {
        try
        {
            if (ProductionReturnAssyVMs.ProductionReturnAssySubVMs.Count == 1 && item.ReturnSubId > 0)
            {
                await _js.ToastrWarning("At least 1 row item is required.");
                return;
            }

            if (IsSomeItemsTransMade)
            {
                await _js.ToastrWarning("One or more items have associated transactions. Row deletion is not allowed to maintain transaction history.");
                return;
            }

            var result = await prodReturnAssyService.ValidateDeleteAsync(item.RefJobOrderId.Value, item.ItemId.Value, 
                                item.QtyReturned.GetValueOrDefault(), ProductionReturnAssyVMs.AddStoreId.Value);

            if (!result.IsValid)
            {
                await _js.ToastrSuccess($"{result.Message}");
                return;
            }

            //important if Stock Add Need to check the same ScreenCode An the Correct Ref. item StockExists
            var (addQty, balQty) = await prodReturnAssyService.GetQtyBalQtyByStockAddAsync(
                            screenCode,
                            ProductionReturnAssyVMs.AddStoreId.Value,
                            item.ItemId.Value,
                            item.ReturnSubId);

            if (addQty != balQty)
            {
                await _js.ToastrWarning($"cannot delete item '{item.ItemCode}'. Stock already used.");
                return;
            }

            if (item.ItemId == 0)
            {
                ProductionReturnAssyVMs.ProductionReturnAssySubVMs.Remove(item);
                await _js.ToastrSuccess("New item row removed successfully.");

                if (!ProductionReturnAssyVMs.ProductionReturnAssySubVMs.Any())
                    ProductionReturnAssyVMs.ProductionReturnAssySubVMs = new List<ProductionReturnAssySubVM>();

                await ResetSlno();
                StateHasChanged();
                return;
            }

            rowToDelete = item;
            ModalTitle = "Are you sure you want to delete this row?";
            btnColor = "btn-danger";
            btnText = "Yes! Delete";
            confirmation = "confirmDeleteRow_Click";
            showCancelReasonBox = false;

            await _js.InvokeVoidAsync("ShowConfirmationModal");
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"RemoveRow failed for ReturnSubId: {item?.ReturnSubId}");
            await _js.ToastrError("Failed to remove the row. Please try again.");
        }
    }

