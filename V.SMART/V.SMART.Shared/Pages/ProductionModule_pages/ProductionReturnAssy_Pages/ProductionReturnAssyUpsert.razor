@page "/productionReturnAssy/create"
@page "/productionReturnAssy/update/{ReturnId:int}"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IProductionService
@using V.SMART.Shared.Services.ReportViewer
@using V.SMART.Shared.ViewModels.PlanningViewModel.JobOrderViewModel
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionIssueWOAssyVM
@using V.SMART.Shared.ViewModels.ProductionViewModel.ProductionReturnAssyViewModel
@using MudBlazor

@inherits BaseUserRightsComponent

@inject ICalculationService _calculationService
@inject IProductionReturnAssyService prodReturnAssyService
@inject ILoggingService logs
@inject ReportService reportService
@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<BsModal OnModalConfirmation="HandleModalConfirmation"
         Title="@ModalTitle"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         ShowReasonBox="@showCancelReasonBox"
         Reason="@cancelReason"
         OnReasonChanged="(value) => cancelReason = value">
</BsModal>

<DetailsModal Title="Job Order Details"
              Columns="@JobOrderColumns"
              ColumnFields="@JobOrderFields"
              HiddenColumns="@JobOrderHiddenColumns"
              Data="@JobOrderData"
              IsVisible="@IsJobOrderModalVisible"
              IsVisibleChanged="@((val) => IsJobOrderModalVisible = val)"
              OnSelectedItems="OnJobOrderSelectedAsync">
</DetailsModal>

<!-- Shared Modal -->
<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="800px" OnClose="CloseModal">
    @if (ActiveModal == "Attachments")
    {
        <CorrespondenceListByReference refType="Item" refId="@AttachItemSelected.ItemId"
                                       refName="@AttachItemSelected.ItemCode" docType="Drawing" isModelVisible="true" />
    }
</MasterModal>

<style>
    .freeze-last-col {
        position: sticky;
        right: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="@(ProductionReturnAssyVMs.ReturnId > 0 ? "Update Production Return Assembly" : "Create Production Return Assembly")"
                        TitleIcon="bi bi-tag"
                        Breadcrumbs="@returnGRNBreadcrumbs" />

            <div class="card-body bg-light">
                <EditForm Model="ProductionReturnAssyVMs" OnValidSubmit="UpsertProdReturnAssy">
                    <ObjectGraphDataAnnotationsValidator />
                    <ValidationSummary />

                    <!-- Correspondence Status -->
                    <div class="row g-3 mb-2 align-items-center">

                        @if (ProductionReturnAssyVMs.ReturnId > 0 && !string.IsNullOrWhiteSpace(ProductionReturnAssyVMs.ReturnNo))
                        {
                            <CorrespondenceStatus ReferenceType="Production Return Assembly"
                                                  ReferenceId="@ProductionReturnAssyVMs.ReturnId"
                                                  ReferenceTypeName="@ProductionReturnAssyVMs.ReturnNo" />
                        }
                    </div>

                    <div class="row g-3 mb-2">

                        <!-- =================== Document Information Card =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Document Details</span>
                                </div>

                                <div class="card-body">

                                    <!-- Material Return No -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Material Return No.</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <div class="input-group input-group-sm w-100 rounded-3">
                                                <InputText class="form-control form-control-sm rounded-3"
                                                           placeholder="Material Return No."
                                                           maxlength="30"
                                                           @bind-Value="@ProductionReturnAssyVMs.ReturnNo"
                                                           readonly />

                                                <span class="input-group-text rounded-3">@ProductionReturnAssyVMs.Suffix</span>
                                            </div>
                                            <ValidationMessage For="@(() => ProductionReturnAssyVMs.ReturnNo)" />
                                            <ValidationMessage For="@(() => ProductionReturnAssyVMs.Suffix)" />
                                        </div>
                                    </div>

                                    <!-- Material Return Date -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Material Return Date</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <InputDate class="form-control form-control-sm rounded-3"
                                                       @bind-Value="@ProductionReturnAssyVMs.ReturnDate" />
                                            <ValidationMessage For="@(() => ProductionReturnAssyVMs.ReturnDate)" />
                                        </div>
                                    </div>

                                    @if (jobOrderPendingCount >0)
                                    {
                                        <!-- Job No -->
                                        <div class="mb-2 row">
                                            <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                                <small>Job Orders</small>
                                            </label>
                                            <div class="col-12 col-sm-9 position-relative">
                                                <button type="button"
                                                        class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center"
                                                        @onclick="ShowJobOrderDetails">
                                                    <i class="bi bi-list-ul me-1"></i> Job Order Details
                                                </button>
                                            </div>
                                        </div>

                                        <div class="mb-3 row">
                                            <label class="col-12 col-sm-3 col-form-label fw-semibold text-dark pt-2">
                                                <small>Options</small>
                                            </label>

                                            <div class="col-12 col-sm-9 d-flex align-items-center gap-4">

                                                <!-- Rejection Switch -->
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           role="switch"
                                                           id="rejSwitch"
                                                           checked="@ProductionReturnAssyVMs.Rejection"
                                                           @onchange="OnRejectionChanged"
                                                           disabled="@IsBothDisabled">

                                                    <label class="form-check-label fw-medium
                                                        @(ProductionReturnAssyVMs.Rejection ? "text-danger fw-bold" : "text-dark")"
                                                           for="rejSwitch">
                                                        Rejection
                                                    </label>
                                                </div>

                                                <!-- Return Switch -->
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           role="switch"
                                                           id="returnSwitch"
                                                           checked="@ProductionReturnAssyVMs.Return"
                                                           @onchange="OnReturnChanged"
                                                           disabled="@IsBothDisabled">

                                                    <label class="form-check-label fw-medium
                                                        @(ProductionReturnAssyVMs.Return ? "text-success fw-bold" : "text-dark")"
                                                           for="returnSwitch">
                                                        Return
                                                    </label>
                                                </div>

                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>


                        <!-- =================== Production Material Issue Detail =================== -->
                        <div class="col-12 col-lg-6 mb-2">
                            <div class="card h-100 shadow-sm">

                                <!-- Header -->
                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Production Return Details</span>
                                </div>

                                <div class="card-body">

                                    <div class="row g-2 mb-2 align-items-stretch">

                                        <!-- No Inspection -->
                                        <div class="col-12 col-sm-6">
                                            <div class="card shadow-sm border-2 @(ProductionReturnAssyVMs.IsNoInspection ? "border-success bg-success-subtle" : "border-light")"
                                                 style="cursor:pointer; height:60px;"
                                                 @onclick="() => ToggleNoInspection(true)">
                                                <div class="card-body d-flex align-items-center justify-content-center py-2 px-2">
                                                    <i class="bi bi-check-circle-fill text-dark me-2"></i>
                                                    <span class="fw-semibold text-dark">
                                                        No Inspection
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                    

                                    <!-- Stores -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Add To Store</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <select class="form-select form-select-sm rounded-3 w-100"
                                                    disabled>
                                                    @* disabled="@(ProductionReturnAssyVMs.Rejection)"> *@
                                                @foreach (var store in Stores)
                                                {
                                                    <option value="@store.StoreId"
                                                            selected="@(store.StoreId == ProductionReturnAssyVMs.AddStoreId)">
                                                        @store.StoreName
                                                    </option>
                                                }
                                            </select>

                                        </div>
                                    </div>

                                      <!-- Issue To Whom -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Return To </small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <input type="text" class="form-control form-control-sm rounded-3 w-100"
                                                   @bind="ProductionReturnAssyVMs.ReturnBy"/>
                                            <ValidationMessage For="@(() => ProductionReturnAssyVMs.ReturnBy)" />
                                        </div>
                                    </div>

                                    <!-- Remarks -->
                                    <div class="mb-2 row">
                                        <label class="col-12 col-sm-3 col-form-label pt-1 text-dark">
                                            <small>Remarks</small>
                                        </label>
                                        <div class="col-12 col-sm-9">
                                            <textarea class="form-control form-control-sm rounded-3 w-100"
                                                      rows="1"
                                                      @bind="ProductionReturnAssyVMs.MainRemark"></textarea>
                                            <ValidationMessage For="@(() => ProductionReturnAssyVMs.MainRemark)" />
                                        </div>
                                    </div>


                                </div>
                            </div>
                        </div>


                        <!-- =================== Item Details =================== -->
                        <div class="col-12">
                            <div class="card shadow-sm border-1"
                                 style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                                <div class="card-header d-flex justify-content-between align-items-center bg-primary-subtle text-dark">
                                    <span class="fw-bold fs-6">Item Details</span>
                                </div>

                                <div class="card-body p-2">
                                    <div class="table-responsive" style="overflow-x:auto;">
                                        <table class="table table-bordered table-sm align-middle text-center mb-0"
                                               style="table-layout: fixed; min-width: 1700px;">

                                            <thead class="custom-blue">
                                                <tr>
                                                    <th style="width:50px;">Sl.No</th>
                                                    <th style="width:100px;">Job Order</th>
                                                    <th style="width:100px;">Job Date</th>

                                                    @if(!ProductionReturnAssyVMs.Return && !ProductionReturnAssyVMs.Rejection)
                                                    {
                                                        <th style="width:200px;">Assy/SubAssy</th>
                                                    }
                                                    else
                                                    {
                                                        <th style="width:200px;">Item-Code</th>
                                                    }

                                                    <th style="width:170px;">Item Name</th>
                                                    <th style="width:60px;">UOM</th>
                                                    <th style="width:120px;">Return Qty</th>
                                                    <th style="width:120px;">Unit Price</th>
                                                    <th style="width:120px;">Possible Qty</th>
                                                    <th style="width:200px;">Remarks</th>
                                                    <th style="width:120px;">Cost Center</th>
                                                    <th style="width:90px;" class="freeze-last-col text-end">Action</th>
                                                </tr>
                                            </thead>

                                            <tbody class="custom-size">
                                                @if (ProductionReturnAssyVMs?.ProductionReturnAssySubVMs?.Any() == true)
                                                {
                                                    @foreach (var subitem in ProductionReturnAssyVMs.ProductionReturnAssySubVMs)
                                                    {
                                                        <tr @key="subitem">
                                                            <td>@subitem.SlNo</td>

                                                            <td>@subitem.RefJobOrderNo</td>
                                                            <td>@subitem.RefJobOrderDate</td>

                                                            <td>
                                                                <div class="d-flex justify-content-between align-items-center">
                                                                    <span>@subitem.ItemCode</span>
                                                                    @if (subitem.ItemId is not null && subitem.ItemId > 0 &&
                                                                                                                            attachmentCounts.TryGetValue(subitem.ItemId.Value, out var count) && count > 0)
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                                                                       Size="Size.Small"
                                                                                       Color="Color.Primary"
                                                                                       OnClick="@(async () => await OpenAttachmentButton(subitem.ItemId.Value, count))"
                                                                                       Title="@($"This item has {count} attachment(s). Click to view.")" />
                                                                    }
                                                                </div>
                                                            </td>

                                                            <td>@subitem.ItemName</td>
                                                            <td>@subitem.MeasureUnit</td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Qty Returned"
                                                                           title="Enter Quantity"
                                                                           step="any"
                                                                           @bind="subitem.QtyReturned"
                                                                           @bind:event="oninput"
                                                                           @onchange="@(e => OnQtyChange(e, subitem))" />
                                                                    <ValidationMessage For="@(() => subitem.QtyReturned)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.QtyReturned
                                                                }
                                                            </td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <input type="number"
                                                                           class="form-control form-control-sm"
                                                                           placeholder="Unit Price"
                                                                           title="Enter Unit Price"
                                                                           step="any"
                                                                           @bind="subitem.UnitPrice" />
                                                                    <ValidationMessage For="@(() => subitem.UnitPrice)" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.UnitPrice
                                                                }
                                                            </td>

                                                            <td>@subitem.PossibleQty</td>

                                                            <td>
                                                                @if (subitem.IsEditable)
                                                                {
                                                                    <InputText @bind-Value="subitem.Remark"
                                                                               class="form-control form-control-sm text-center"
                                                                               placeholder="Enter remarks" />
                                                                }
                                                                else
                                                                {
                                                                    @subitem.Remark
                                                                }
                                                            </td>

                                                            <td>@subitem.ProjectNo</td>

                                                            <td class="freeze-last-col text-end">
                                                                <div class="d-flex justify-content-end gap-1">
                                                                    @if (subitem.IsEditable)
                                                                    {
                                                                        <button type="button" class="btn btn-success btn-icon btn-sm" title="Save"
                                                                                @onclick="async () => await SaveRow(subitem)">
                                                                            <i class="bi bi-check-lg"></i>
                                                                        </button>
                                                                        <button type="button" class="btn btn-secondary btn-icon btn-sm" title="Cancel"
                                                                                @onclick="async () => await CancelEdit(subitem, ProductionReturnAssyVMs)">
                                                                            <i class="bi bi-x-lg"></i>
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button type="button" class="btn btn-primary btn-icon btn-sm" title="Edit"
                                                                                @onclick="async () => await EditRowAsync(subitem)">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>
                                                                        <button type="button" class="btn btn-danger btn-icon btn-sm" title="Delete"
                                                                                @onclick="async () => await RemoveRow(subitem)">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="10" class="text-center text-muted fw-semibold" style="height:150px;">
                                                            <div class="d-flex justify-content-center align-items-center" style="min-height:100px;">
                                                                <i class="bi bi-info-circle me-2 text-secondary"></i>
                                                                No items to display
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>

                                            @if (ProductionReturnAssyVMs?.ProductionReturnAssySubVMs?.Any() == true)
                                            {
                                                <tfoot class="table-warning text-dark fw-bold">
                                                    <tr>
                                                        <td colspan="6" class="text-end">Totals:</td>
                                                        <td>@ProductionReturnAssyVMs.ProductionReturnAssySubVMs.Sum(x => x.QtyReturned)</td>
                                                        <td>Avg:@ProductionReturnAssyVMs.ProductionReturnAssySubVMs.Average(x => x.UnitPrice)</td>
                                                        <td>@ProductionReturnAssyVMs.ProductionReturnAssySubVMs.Sum(x => x.PossibleQty)</td>
                                                        <td colspan="3"></td>
                                                    </tr>
                                                </tfoot>
                                            }
                                        </table>
                                    </div>
                                </div>


                            </div>
                        </div>

                        <!--Action Buttons -->
                        @if (CanCreate || CanEdit)
                        {
                            <div class="col-6 col-md-3 mt-3">
                                <button type="submit" class="btn btn-primary w-100 rounded-3" disabled="@isProcessing">
                                    <i class="bi bi-floppy2-fill me-1"></i> @(ProductionReturnAssyVMs.ReturnId > 0 ? "Update" : "Create")
                                </button>
                            </div>
                        }

                        <div class="col-6 col-md-3 mt-3">
                            <SmartBackButton Url="@($"/productionReturnAssyList?currentPage={currentPage}")" />
                        </div>

                        @if (CanCreate || CanEdit && ReturnId > 0)
                        {
                            <div class="col-12 col-md-3">
                                <button type="button" class="btn btn-info w-100 h-100" @onclick="GenerateAndOpenPdf">
                                    <i class="bi bi-printer me-1"></i>Print
                                </button>
                            </div>
                        }
                    </div>

                </EditForm>
            </div>
        </div>
    </div>
}


@code {

    #region Parameters & Properties

    protected override string ScreenName => "Production Return GRN Assembly";
    private int screenCode { get; set; }

    [Parameter] public int? ReturnId { get; set; }

    private bool isProcessing = true;
    private ProductionReturnAssyVM ProductionReturnAssyVMs { get; set; } = new();

    private List<Store> Stores = new();

    private ProductionReturnAssySubVM? rowToDelete;

    private bool IsSomeItemsTransMade { get; set; } = false;
    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;

    private string? pdfBase64;

    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private ItemVM? AttachItemSelected = null;
    private Dictionary<int, int> attachmentCounts = new();

    private List<PageHeader.BreadcrumbItem> returnGRNBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Production" },
        new PageHeader.BreadcrumbItem { Text = "Assembly" },
        new PageHeader.BreadcrumbItem { Text = "Return GRN", IsLast = true }
    };

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    //Detail Modal
    private int jobOrderPendingCount = 0;

    private bool IsJobOrderModalVisible = false;
    private List<Dictionary<string, object>>? JobOrderData;
    private List<string> JobOrderColumns = new();
    private List<string> JobOrderFields = new();
    private List<string> JobOrderHiddenColumns = new();

    #endregion

    #region  Toggle Inspection

    private void ToggleNoInspection(bool NoInspection)
    {
        if (NoInspection)
        {
            if (ProductionReturnAssyVMs.IsNoInspection)
            {
                ProductionReturnAssyVMs.IsNoInspection = false;
            }
            else
            {
                ProductionReturnAssyVMs.IsNoInspection = true;
            }
        }
        else
        {
            ProductionReturnAssyVMs.IsNoInspection = false;
        }
    }
    #endregion


    #region Initialization

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;

            await LoadRightsAsync();
            if (!CanView)
            {
                _navigationManager.NavigateTo("/access-denied");
                return;
            }

            screenCode = await prodReturnAssyService.GetScreenCodeByScreenNameAsync(ScreenName);
            ProductionReturnAssyVMs.ProductionReturnAssyTrackVMs = await prodReturnAssyService.GetAllExistingJobOrderAsync();
            Stores = await prodReturnAssyService.GetAllActiveStoresAsync();
            jobOrderPendingCount = await prodReturnAssyService.GetPendingJobOrdersCountAsync();

            if (ReturnId.HasValue)
            {
                await LoadExistingProductionReturn(ReturnId.Value);
            }
            else
            {
                await InitializeNewProductionReturnAssy();
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "OnInitializedAsync failed.");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task LoadExistingProductionReturn(int returnId)
    {
        try
        {
            ProductionReturnAssyVMs = await prodReturnAssyService.GetProductionByReturnIdAsync(returnId);

            if (ProductionReturnAssyVMs == null)
            {
                await _js.ToastrWarning("Production Return Assembly not found.");
                return;
            }

            if (!ProductionReturnAssyVMs.Return && !ProductionReturnAssyVMs.Rejection)
            {
                foreach (var savedSub in ProductionReturnAssyVMs.ProductionReturnAssySubVMs)
                {
                    if (savedSub.RefJobOrderId == null || savedSub.RefJobOrderId == 0)
                        continue;

                    int jobId = savedSub.RefJobOrderId.Value;

                    var latestJobData = await prodReturnAssyService.GetJobOrderDetailsByIdAsync(jobId);

                    if (latestJobData == null)
                        continue;

                    var latestSub = latestJobData.ProductionReturnAssySubVMs.FirstOrDefault();
                    if (latestSub == null)
                        continue;

                    savedSub.PossibleQty = Math.Round(latestSub.PossibleQty.GetValueOrDefault(), 3);
                }
            }
            else
            {
                foreach (var savedSub in ProductionReturnAssyVMs.ProductionReturnAssySubVMs)
                {
                    if (savedSub.RefIssueSubId == null || savedSub.RefIssueSubId == 0)
                        continue;

                    var IssueBalQty = await prodReturnAssyService.GetIssueBalQtyByIssueSubId(savedSub.RefIssueSubId.Value);

                    savedSub.PossibleQty = Math.Round(IssueBalQty, 3);
                }

            }

            foreach (var prodSub in ProductionReturnAssyVMs.ProductionReturnAssySubVMs
                         .Where(q => q.ItemId.HasValue && q.ItemId > 0))
            {
                attachmentCounts[prodSub.ItemId.Value] =
                    await prodReturnAssyService.GetCorrespondenceAttachmentsCountAsync(prodSub.ItemId.Value, "Item");
            }

            IsSomeItemsTransMade = CheckIsTransMade();
        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to load existing production Return Assembly.");
            await logs.LogDeveloperError(ex, $"LoadExistingProductionReturn failed for ReturnId: {returnId}");
        }
    }


    private bool CheckIsTransMade()
    {
        var list = ProductionReturnAssyVMs?.ProductionReturnAssySubVMs;
        if (list == null || list.Count == 0)
            return false;

        decimal totalQty = 0, totalBalQty = 0;

        for (int i = 0; i < list.Count; i++)
        {
            totalQty += list[i].QtyReturned.GetValueOrDefault();
            totalBalQty += list[i].BalQty.GetValueOrDefault();
        }

        return totalQty != totalBalQty;
    }

    private async Task InitializeNewProductionReturnAssy()
    {
        try
        {
            if (ProductionReturnAssyVMs == null)
                ProductionReturnAssyVMs = new ProductionReturnAssyVM();

            ProductionReturnAssyVMs.Suffix = FinancialYearHelper.GetFinancialYearSuffix(DateTime.Now);
            ProductionReturnAssyVMs.ReturnNo = await prodReturnAssyService.GetProductionReturnNumberAsync(ProductionReturnAssyVMs.Suffix);

            var MapStoreForProdReturn = await prodReturnAssyService.GetMappedStoreForFormAsync("PMReturnAssyForm");

            if (MapStoreForProdReturn.StoreId > 0)
            {
                ProductionReturnAssyVMs.AddStoreId = MapStoreForProdReturn.StoreId;
                ProductionReturnAssyVMs.AddStoreName = MapStoreForProdReturn.StoreName;
            }
            else
            {
                ProductionReturnAssyVMs.AddStoreId = null;
                ProductionReturnAssyVMs.AddStoreName = null;
            }

        }
        catch (Exception ex)
        {
            await _js.ToastrError("Failed to initialize new Production Return Number.");
            await logs.LogDeveloperError(ex, "InitializeNewProductionReturnAssy failed");
        }
    }

    #endregion

    #region Rejection And Return Toggle

    private bool IsBothDisabled =>
        ProductionReturnAssyVMs.ProductionReturnAssySubVMs
            ?.Any(x => !string.IsNullOrEmpty(x.ItemCode)) == true;


    private async Task OnRejectionChanged(ChangeEventArgs args)
    {
        if (IsBothDisabled)
            return;

