    private async Task OnJobOrderSelectedAsync(List<Dictionary<string, object>> selectedItems)
    {
        try
        {
            if (selectedItems == null || selectedItems.Count == 0)
            {
                await _js.ToastrWarning("No items selected.");
                return;
            }

            if (ProductionReturnAssyVMs.AddStoreId.GetValueOrDefault() == 0)
            {
                await _js.ToastrWarning("Please select 'Issue From Store' before loading Job Orders.");
                return;
            }

            ProductionReturnAssyVMs.ProductionReturnAssySubVMs ??= new List<ProductionReturnAssySubVM>();

            bool isReturnOrRejection = ProductionReturnAssyVMs.Return || ProductionReturnAssyVMs.Rejection;

            // field selector
            string itemIdField = isReturnOrRejection ? "ItemId" : "Assy/SubAssyId";

            // collect itemIds
            var itemIds = selectedItems
                .Where(x => x.ContainsKey(itemIdField) && x[itemIdField] != null)
                .Select(x => Convert.ToInt32(x[itemIdField]))
                .Distinct()
                .ToList();

            var unitPriceMap = await prodReturnAssyService.GetBulkLastUnitPricesAsync(itemIds);

            foreach (var item in selectedItems)
            {
                // Load nullable ItemId
                int? itemId = item.TryGetValue(itemIdField, out var iid)
                                ? Convert.ToInt32(iid)
                                : (int?)null;

                // Load nullable JobId
                int? jobId = item.TryGetValue("RefJobId", out var j)
                                ? Convert.ToInt32(j)
                                : (int?)null;

                // Load nullable IssueSubId
                int? refIssueSubId = item.TryGetValue("RefIssueSubId", out var issid)
                                        ? Convert.ToInt32(issid)
                                        : (int?)null;

                // Duplicate check
                bool exists = ProductionReturnAssyVMs.ProductionReturnAssySubVMs
                    .Any(x =>
                        (isReturnOrRejection && x.RefIssueSubId == refIssueSubId) ||
                        (!isReturnOrRejection && x.RefJobOrderId == jobId && x.ItemId == itemId)
                    );

                if (exists)
                    continue;

                // load qty
                decimal qty = 0;
                if (isReturnOrRejection)
                    qty = item.TryGetValue("IssueBalQty", out var bal) ? Convert.ToDecimal(bal) : 0;
                else
                    qty = item.TryGetValue("PossibleQty", out var bal2) ? Convert.ToDecimal(bal2) : 0;

                // nullable Unit Price
                unitPriceMap.TryGetValue(itemId ?? 0, out decimal unitPrice);
                decimal UnitPrice = unitPrice == 0 ? 0 : unitPrice;

                // Cost Center
                int? costId = item.TryGetValue("CostCenterId", out var cid)
                                ? (Convert.ToInt32(cid) == 0 ? (int?)null : Convert.ToInt32(cid))
                                : null;

                var subVm = new ProductionReturnAssySubVM
                {
                    RefJobOrderId = jobId,

                    RefIssueSubId = isReturnOrRejection ? refIssueSubId : null,

                    RefJobOrderNo = item.TryGetValue("RefJobNo", out var jno) ? jno?.ToString() : "",
                    RefJobOrderDate = item.TryGetValue("RefJobDate", out var jdate) && jdate != null
                                      ? Convert.ToDateTime(jdate)
                                      : (DateTime?)null,

                    ItemId = itemId,
                    ItemCode = item.TryGetValue(isReturnOrRejection ? "ItemCode" : "Assy/SubAssyCode", out var icode)
                                ? icode?.ToString()
                                : "",

                    ItemName = item.TryGetValue("ItemName", out var iname) ? iname?.ToString() : "",
                    MeasureUnit = item.TryGetValue("MeasureUnit", out var mu) ? mu?.ToString() : "",

                    QtyReturned = qty,
                    PossibleQty = qty,
                    BalQty = qty,

                    UnitPrice = UnitPrice,

                    CostId = costId,
                    ProjectNo = item.TryGetValue("CostCenter", out var pno) ? pno?.ToString() : "",

                    IsEditable = true
                };

                ProductionReturnAssyVMs.ProductionReturnAssySubVMs.Add(subVm);
            }

            await ResetSlno();

            await _js.ToastrSuccess("Selected job orders loaded successfully.");
        }
        catch
        {
            await _js.ToastrError("Error while loading selected job orders.");
        }

        StateHasChanged();
    }


   



