    #region Quantity Handlers

    private async Task OnQtyChange(ChangeEventArgs e, ProductionReturnAssySubVM SubVM)
    {
        try
        {
            if (!decimal.TryParse(e.Value?.ToString(), out var newQty) || newQty <= 0)
            {
                SubVM.QtyReturned = 0;
                SubVM.BalQty = 0;
                await _js.ToastrWarning("Qty must be a positive number.");
                return;
            }

            if (SubVM.ReturnSubId == 0)
            {
                if (SubVM.RefJobOrderId > 0)
                {
                    var PossibleQty = SubVM.PossibleQty;

                    if (newQty <= PossibleQty)
                    {
                        SubVM.QtyReturned = newQty;
                        SubVM.BalQty = newQty;
                    }
                    else
                    {
                        SubVM.QtyReturned = PossibleQty;
                        SubVM.BalQty = PossibleQty;
                        await _js.ToastrWarning($"Qty can't be greater than Possible Job Order Qty ({PossibleQty}).");
                    }
                }
                else
                {
                    SubVM.QtyReturned = newQty;
                    SubVM.BalQty = newQty;
                }
            }
            else
            {
                var original = await prodReturnAssyService.GetProdReturnSubItemDetailByReturnSubIdAsync(SubVM.ReturnSubId);
                if (original == null) return;

                var alreadyTransacted = original.QtyReturned - original.BalQty;

                if (newQty < alreadyTransacted)
                {
                    SubVM.QtyReturned = alreadyTransacted;
                    SubVM.BalQty = 0;
                    await _js.ToastrWarning($"Qty Returned cannot be less than {alreadyTransacted} (already transacted).");
                    return;
                }

                if (SubVM.RefJobOrderId > 0)
                {
                    var PossibleQty = SubVM.PossibleQty;
                    var maxAllowedQty = original.QtyReturned + PossibleQty.GetValueOrDefault();

                    if (newQty > maxAllowedQty.GetValueOrDefault())
                    {
                        SubVM.QtyReturned = maxAllowedQty.GetValueOrDefault();
                        SubVM.BalQty = maxAllowedQty.GetValueOrDefault() - alreadyTransacted.GetValueOrDefault();
                        await _js.ToastrWarning($"Qty cannot be greater than {maxAllowedQty}.");
                    }
                    else
                    {
                        SubVM.QtyReturned = newQty;
                        SubVM.BalQty = newQty - alreadyTransacted;
                    }
                }
                else
                {
                    SubVM.QtyReturned = newQty;
                    SubVM.BalQty = newQty - alreadyTransacted;
                }
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, $"OnQtyChange failed for ReturnSubId: {SubVM?.ReturnSubId}");
            await _js.ToastrError("Failed to update quantity. Please try again.");
        }
    }

    #endregion
    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(ReturnId.GetValueOrDefault(), "ProdAssyGRN.frx", "ReturnId", false, ScreenName, "Sp_Print_ProdAssyGRN");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await _js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await _js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await _js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf ProdAssy GRN");
            await _js.ToastrError("An unexpected error occurred while generating the PDF in ProdAssy GRN.");
        }
        finally
        {
            isProcessing = false;
        }
    }
}