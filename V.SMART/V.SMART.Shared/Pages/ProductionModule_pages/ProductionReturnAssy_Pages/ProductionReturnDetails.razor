@page "/productionReturnAssy/details/{ReturnId:int}"
@using V.SMART.Shared.Services.ReportViewer

@inherits BaseUserRightsComponent

@inject ReportService reportService

@inject IProductionReturnAssyService prodReturnAssyService
@inject IJSRuntime js
@inject ILoggingService logs
@inject NavigationManager _nav

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else
{
    @if (!CanView)
    {
        <RedirectToLogin />
    }
    else
    {
        <div class="container border rounded-3 shadow-lg bg-body my-5 mx-auto p-5" style="max-width: 1000px;">

            <MyCompanyDetails />

            <hr class="border-2 border-primary-subtle mb-4" />
            <div class="text-center">
                <h4 class="fw-semibold mt-3">GRN Details</h4>
            </div>

            <hr class="border-2 border-primary-subtle mb-4" />

            <!-- Document Details -->
            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">

                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Document Details
                        </div>

                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Return No.</strong></td>
                                        <td>
                                            @($"{ProductionReturnAssyVMs?.ReturnNo}{ProductionReturnAssyVMs?.Suffix}")
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Return Date</strong></td>
                                        <td>@(ProductionReturnAssyVMs?.ReturnDate)</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Ref Job Order No.</strong></td>
                                        <td>@refJobNosDisplay</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Ref Job Order Dt.</strong></td>
                                        <td>@refJobDateDisplay</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

                <!-- Production Return Details -->
                <div class="col-md-6">
                    <div class="card border-1 shadow-sm rounded-3 h-100">

                        <div class="card-header bg-primary-subtle text-primary-emphasis fw-semibold p-2 small">
                            Production Return Details
                        </div>

                        <div class="card-body p-2 small">
                            <table class="table table-sm table-borderless mb-0">
                                <tbody>

                                    <tr>
                                        <td class="text-secondary" style="width: 40%;"><strong>Return to Store</strong></td>
                                        <td>@ProductionReturnAssyVMs?.AddStoreName</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Return By</strong></td>
                                        <td>@ProductionReturnAssyVMs?.ReturnBy</td>
                                    </tr>

                                    <tr>
                                        <td class="text-secondary"><strong>Remarks</strong></td>
                                        <td>@ProductionReturnAssyVMs?.MainRemark</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Items -->
            <div class="card border-1 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold p-2">
                    Production Return Items
                </div>

                <div class="table-responsive" style="overflow-x:auto;">
                    <table class="table table-bordered table-sm align-middle text-center mb-0" style="table-layout: fixed; min-width: 1700px;">
                        <thead class="custom-blue">
                            <tr>
                                <th>Sl No.</th>
                                <th>Item Code</th>
                                <th>Description</th>
                                <th>UOM</th>
                                <th>Return Qty</th>
                                <th>Unit Price</th>
                                <th>Balance Qty</th>
                                <th>Cost Center</th>
                            </tr>
                        </thead>

                        <tbody class="custom-size">

                            @if (ProductionReturnAssyVMs?.ProductionReturnAssySubVMs != null &&
                                                ProductionReturnAssyVMs.ProductionReturnAssySubVMs.Any())
                            {
                                @foreach (var item in ProductionReturnAssyVMs.ProductionReturnAssySubVMs)
                                {
                                    <tr>
                                        <td>@item.SlNo</td>
                                        <td>@item.ItemCode</td>
                                        <td>@item.ItemName</td>
                                        <td>@item.MeasureUnit</td>
                                        <td>@($"{item.QtyReturned:0.###}")</td>
                                        <td>@($"{item.UnitPrice:0.###}")</td>
                                        <td>@($"{item.BalQty:0.###}")</td>
                                        <td>@item.ProjectNo</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="13" class="text-center text-muted">No items found</td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 justify-content-end">
                <a href="@($"/productionReturnAssyList?currentPage={currentPage}")" class="btn btn-secondary  rounded-3" disabled="@isProcessing">
                    <i class="bi bi-arrow-bar-left me-1"></i> Back To List
                </a>

                <a href="@($"/productionReturnAssy/update/{ReturnId}")" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Modify
                </a>

                <button class="btn btn-outline-success" @onclick="GenerateAndOpenPdf">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>

        </div>
    }
}

@code {

    protected override string ScreenName => "Production Return GRN Assembly";

    [Parameter] public int ReturnId { get; set; }

    private string? pdfBase64;

    private bool isProcessing { get; set; } = true;
    private ProductionReturnAssyVM ProductionReturnAssyVMs { get; set; } = new();

    private List<ProductionReturnAssySubVM> refJobNumbers = new();
    private string refJobNosDisplay = "N/A";
    private string refJobDateDisplay = "N/A";

    //Sathish
    [SupplyParameterFromQuery]
    public int currentPage { get; set; } = 1;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _nav.NavigateTo("/access-denied");
                return;
            }
            await LoadAllProductionAssyReturns();
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in Production Return Assembly Details OnInitializedAsync");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task LoadAllProductionAssyReturns()
    {
        try
        {
            if (ReturnId <= 0)
                return;

            var result = await prodReturnAssyService.GetProductionByReturnIdAsync(ReturnId);

            if (result == null)
            {
                await js.ToastrWarning("Production Return Assembly not found.");
                return;
            }

            // FIXED: Load into VM correctly
            ProductionReturnAssyVMs = result;

            // Load Job Order references
            refJobNumbers = await prodReturnAssyService.GetDistinctRefJobNoByReturnIdAsync(ReturnId);

            if (refJobNumbers.Any())
            {
                refJobNosDisplay = string.Join(", ",
                    refJobNumbers.Select(e => e.RefJobOrderNo).Where(n => !string.IsNullOrWhiteSpace(n)));

                refJobDateDisplay = string.Join(", ",
                    refJobNumbers.Select(e =>
                        e.RefJobOrderDate.HasValue
                            ? e.RefJobOrderDate.Value.ToString("dd/MM/yyyy")
                            : null)
                    .Where(d => !string.IsNullOrWhiteSpace(d)));
            }
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error loading Production Return Assembly by ReturnId");
            await js.ToastrError("Failed to load Production Return Assembly details.");
        }
    }

    private async Task GenerateAndOpenPdf()
    {
        try
        {
            isProcessing = true;
            pdfBase64 = null;

            var pdfBytes = await reportService.Generate_Report(ReturnId, "ProdAssyGRN.frx", "ReturnId", false, ScreenName, "Sp_Print_ProdAssyGRN");

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await js.ToastrError("PDF generation failed.");
                return;
            }

            pdfBase64 = Convert.ToBase64String(pdfBytes);
            await js.InvokeVoidAsync("openPdfFromBase64", pdfBase64);
        }
        catch (InvalidOperationException ex)
        {
            await js.ToastrError(ex.Message);
        }
        catch (Exception ex)
        {
            await logs.LogDeveloperError(ex, "Error in GenerateAndOpenPdf ProdAssy GRN");
            await js.ToastrError("An unexpected error occurred while generating the PDF in ProdAssy GRN");
        }
        finally
        {
            isProcessing = false;
        }
    }



}
