@page "/reports-home"
@inject NavigationManager Nav
@inject ThemeStateService ThemeStateService

<PageTitle>Reports — ERP Suite</PageTitle>

<div class="erp-wrapper @(isDark ? "dark" : "light")">

    <div class="erp-orb erp-orb-1"></div>
    <div class="erp-orb erp-orb-2"></div>
    <div class="erp-orb erp-orb-3"></div>

    <nav class="erp-breadcrumb mb-4">
        <a class="erp-bc-link" @onclick='() => Nav.NavigateTo("/")'><i class="bi bi-house-fill me-1"></i>Home</a>
        <span class="erp-bc-sep"><i class="bi bi-chevron-right"></i></span>
        <span class="erp-bc-active">Reports</span>
    </nav>

    <div class="erp-page-header mb-4">
        <div class="erp-page-header-left">
            <div class="erp-page-icon erp-icon-blue"><i class="bi bi-bar-chart-fill"></i></div>
            <div>
                <h1 class="erp-page-title">Reports</h1>
                <p class="erp-page-sub mb-0">Sales track, labour track and DC inward/outward reports</p>
            </div>
        </div>
    </div>

    <div class="row g-3">

        <div class="col-12"><div class="erp-group-divider"><span>Issue Summary Reports</span></div></div>

        @foreach (var item in _issuesummary)
        {
            var href = item.Href; var label = item.Label;
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="erp-link-card" @onclick='() => Nav.NavigateTo("/" + href)'>
                    <div class="erp-link-dot dot-cyan"></div>
                    <div class="erp-link-body">
                        <div class="erp-link-title">@label</div>
                        <div class="erp-link-path">/@href</div>
                    </div>
                    <i class="bi bi-arrow-right-short erp-link-arr"></i>
                </div>
            </div>
        }
        <div class="col-12"><div class="erp-group-divider"><span>Account Reports</span></div></div>

        @foreach (var item in _accounts)
        {
            var href = item.Href; var label = item.Label;
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="erp-link-card" @onclick='() => Nav.NavigateTo("/" + href)'>
                    <div class="erp-link-dot dot-blue"></div>
                    <div class="erp-link-body">
                        <div class="erp-link-title">@label</div>
                        <div class="erp-link-path">/@href</div>
                    </div>
                    <i class="bi bi-arrow-right-short erp-link-arr"></i>
                </div>
            </div>
        }

        <div class="col-12"><div class="erp-group-divider"><span>Track Reports</span></div></div>

        @foreach (var item in _track)
        {
            var href = item.Href; var label = item.Label;
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="erp-link-card" @onclick='() => Nav.NavigateTo("/" + href)'>
                    <div class="erp-link-dot dot-blue"></div>
                    <div class="erp-link-body">
                        <div class="erp-link-title">@label</div>
                        <div class="erp-link-path">/@href</div>
                    </div>
                    <i class="bi bi-arrow-right-short erp-link-arr"></i>
                </div>
            </div>
        }

        <div class="col-12"><div class="erp-group-divider"><span>Analysis Reports</span></div></div>

        @foreach (var item in _analysis)
        {
            var href = item.Href; var label = item.Label;
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="erp-link-card" @onclick='() => Nav.NavigateTo("/" + href)'>
                    <div class="erp-link-dot dot-purple"></div>
                    <div class="erp-link-body">
                        <div class="erp-link-title">@label</div>
                        <div class="erp-link-path">/@href</div>
                    </div>
                    <i class="bi bi-arrow-right-short erp-link-arr"></i>
                </div>
            </div>
        }

        <div class="col-12"><div class="erp-group-divider"><span>Rating Reports</span></div></div>

        @foreach (var item in _ratings)
        {
            var href = item.Href; var label = item.Label;
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="erp-link-card" @onclick='() => Nav.NavigateTo("/" + href)'>
                    <div class="erp-link-dot dot-purple"></div>
                    <div class="erp-link-body">
                        <div class="erp-link-title">@label</div>
                        <div class="erp-link-path">/@href</div>
                    </div>
                    <i class="bi bi-arrow-right-short erp-link-arr"></i>
                </div>
            </div>
        }

        <div class="col-12"><div class="erp-group-divider"><span>Pending Reports</span></div></div>

        @foreach (var item in _pendings)
        {
            var href = item.Href; var label = item.Label;
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="erp-link-card" @onclick='() => Nav.NavigateTo("/" + href)'>
                    <div class="erp-link-dot dot-purple"></div>
                    <div class="erp-link-body">
                        <div class="erp-link-title">@label</div>
                        <div class="erp-link-path">/@href</div>
                    </div>
                    <i class="bi bi-arrow-right-short erp-link-arr"></i>
                </div>
            </div>
        }

        <div class="col-12"><div class="erp-group-divider"><span>History Reports</span></div></div>

        @foreach (var item in _history)
        {
            var href = item.Href; var label = item.Label;
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="erp-link-card" @onclick='() => Nav.NavigateTo("/" + href)'>
                    <div class="erp-link-dot dot-cyan"></div>
                    <div class="erp-link-body">
                        <div class="erp-link-title">@label</div>
                        <div class="erp-link-path">/@href</div>
                    </div>
                    <i class="bi bi-arrow-right-short erp-link-arr"></i>
                </div>
            </div>
        }

        <div class="col-12"><div class="erp-group-divider"><span>Utilities</span></div></div>

        @foreach (var item in _utilities)
        {
            var href = item.Href; var label = item.Label;
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="erp-link-card" @onclick='() => Nav.NavigateTo("/" + href)'>
                    <div class="erp-link-dot dot-cyan"></div>
                    <div class="erp-link-body">
                        <div class="erp-link-title">@label</div>
                        <div class="erp-link-path">/@href</div>
                    </div>
                    <i class="bi bi-arrow-right-short erp-link-arr"></i>
                </div>
            </div>
        }
       

    </div>
</div>

@code {
    private bool isDark;

    protected override void OnInitialized()
    {
        isDark = ThemeStateService.IsDarkMode;
        ThemeStateService.OnChange += ThemeChanged;
    }

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ThemeStateService.OnChange -= ThemeChanged;

    private readonly (string Href, string Label)[] _issuesummary = {
        ("ToolCribReport",    "ToolCrib Issue Summary"),

    };

    private readonly (string Href, string Label)[] _accounts = {
        ("confirmationaccounts",    "Confirmation Of Accounts"),
        ("PaidBills",  "Bills Paid List"),
        ("Profit_LossAccounts", "Profit And Loss Statements"),
        ("taxDetailsList", "Tax Details"),
        ("tdsSummaryReport", "TDS Summary"),
        ("hsnCodeSummaryReport", "HSN Code Summary"),
        ("creditdebitSummaryReport", "CreditDebit Summary Report"),
        ("summarygraphs", "Summary & Graphs"),
        ("GSTITC", "GSTITC_04"),

    };

    private readonly (string Href, string Label)[] _track = {
        ("SalesTrack",      "Sales Track"),
        ("labourTrack",     "Labour Track"),
        ("dc-inout-report", "Tally DC Inwards & Outwards"),
        ("po-tally",        "View Po Track"),
        ("Purchase-Sales_Track",        "Purchase Sales Track"),
        ("joborderAnalysis",            "Joborder Track"),

    };

    private readonly (string Href, string Label)[] _analysis = {
        ("StockLedger",    "Stock Ledger"),
        ("StockAnalysis",  "Stock Analysis"),
        ("Rejection",      "Rejection Analysis"),
        ("RouteCardAnalysis","RouteCard Analysis"),

        
        
    };

    private readonly (string Href, string Label)[] _ratings = {
        ("Ratings",    "Rating"),
        ("prpoRating",    "PR PO Rating"),
       
    };

    private readonly (string Href, string Label)[] _pendings = {
        ("SalesPoPending",    "PO Pending List"),
        ("Pending_Bills",  "Bills Pending List"),
        ("PendingStatements", "Pending Statements"),
        ("labourpending", "Labour Pending Summary"),
        ("ProductionPending", "Production Pending Summary"),
    };

    private readonly (string Href, string Label)[] _history = {
        ("Daybook",    "Day Book"),
        ("ItemWiseReport",    "Item Usage Tracking"),
        ("ItemModificationReport", "Item Modification"),
    };

    private readonly (string Href, string Label)[] _utilities = {
        ("correspondenceList", "Correspondence"),
        ("instantSearch",      "Instant Search"),
    };
}
