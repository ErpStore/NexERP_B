@page "/production-home"
@inject NavigationManager Nav
@inject ThemeStateService ThemeStateService

<PageTitle>Production — ERP Suite</PageTitle>

<div class="erp-wrapper @(isDark ? "dark" : "light")">

    <!-- Ambient Orbs -->
    <div class="erp-orb erp-orb-1"></div>
    <div class="erp-orb erp-orb-2"></div>
    <div class="erp-orb erp-orb-3"></div>

    <!-- Breadcrumb -->
    <nav class="erp-breadcrumb mb-4">

        <a class="erp-bc-link" @onclick='() => Nav.NavigateTo("/")'>
            <i class="bi bi-house-fill me-1"></i>Home
        </a>

        <span class="erp-bc-sep">
            <i class="bi bi-chevron-right"></i>
        </span>

        <span class="erp-bc-active">
            Production
        </span>

    </nav>

    <!-- Hero -->
    <div class="erp-page-header mb-4">
        <div class="erp-page-header-left">

            <div class="erp-page-icon erp-icon-red">
                <i class="bi bi-gear-wide-connected"></i>
            </div>

            <div>
                <h1 class="erp-page-title">
                    Production / Shop Floor
                </h1>

                <p class="erp-page-sub mb-0">
                    Assembly · Component · Material Issue · Production Tracking
                </p>
            </div>

        </div>
    </div>

    <!-- ASSEMBLY -->
    <div class="row g-4 mb-4">

        <div class="col-12">
            <div class="erp-group-divider">
                <span>Assembly</span>
            </div>
        </div>

        @foreach (var item in _assembly)
        {
            <div class="col-12 col-sm-6 col-xl-4">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <!-- TOP RIGHT BUTTON -->
                    <button class="erp-card-top-btn"
                            @onclick:stopPropagation="true"
                            @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        Add

                    </button>

                    <!-- ICON -->
                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <!-- TITLE -->
                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <!-- DESCRIPTION -->
                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <!-- ARROW -->
                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

    <!-- COMPONENT -->
    <div class="row g-4 mb-4">

        <div class="col-12">
            <div class="erp-group-divider">
                <span>Component</span>
            </div>
        </div>

        @foreach (var item in _component)
        {
            <div class="col-12 col-sm-6 col-xl-4">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <button class="erp-card-top-btn"
                            @onclick:stopPropagation="true"
                            @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        Add

                    </button>

                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

    <!-- LOGS -->
    <div class="row g-4">

        <div class="col-12">
            <div class="erp-group-divider">
                <span>Logs</span>
            </div>
        </div>

        @foreach (var item in _logs)
        {
            <div class="col-12 col-sm-6 col-xl-4">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <button class="erp-card-top-btn"
                            @onclick:stopPropagation="true"
                            @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        Add

                    </button>

                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

</div>

@code {

    private bool isDark;

    protected override void OnInitialized()
    {
        isDark = ThemeStateService.IsDarkMode;
        ThemeStateService.OnChange += ThemeChanged;
    }

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeStateService.OnChange -= ThemeChanged;
    }

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _assembly =
    {
        (
            "productionIssueList",
            "productionIssueAssy/create",
            "Jobcard Material Issue",
            "Issue materials for assembly job cards",
            "bi bi-box-arrow-up-right",
            "ic-red"
        ),

        (
            "productionReturnAssyList",
            "productionReturnAssy/create",
            "Goods Received Note",
            "Track assembly production receipts",
            "bi bi-box-seam-fill",
            "ic-cyan"
        ),

        (
            "productionAssySCNList",
            "productionAssyScn/create",
            "Store Credit Note",
            "Manage assembly return credit notes",
            "bi bi-journal-check",
            "ic-purple"
        ),
    };

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _component =
    {
        (
            "productionCompIssueList",
            "ProductionIssueComp/create",
            "Product Material Issue",
            "Issue materials for component production",
            "bi bi-tools",
            "ic-orange"
        ),

        (
            "productionCompReturnList",
            "productionReturnComp/create",
            "Goods Received Note",
            "Track component production inward entries",
            "bi bi-box-fill",
            "ic-green"
        ),

        (
            "productionCompSCNList",
            "productionCompScn/create",
            "Store Credit Note",
            "Maintain component production credits",
            "bi bi-file-earmark-minus-fill",
            "ic-pink"
        ),
    };

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _logs =
    {
        (
            "productionLogList",
            "productionLog/create",
            "Daily Production Log",
            "Monitor and record day-to-day production activity",
            "bi bi-clipboard-data-fill",
            "ic-teal"
        ),
    };
}