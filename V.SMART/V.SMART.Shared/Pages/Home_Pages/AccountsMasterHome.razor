@page "/account-master"
@inject NavigationManager Nav
@inject ThemeStateService ThemeStateService

<PageTitle>Account Master — ERP Suite</PageTitle>

<div class="erp-wrapper @(isDark ? "dark" : "light")">

    <!-- Ambient Orbs -->
    <div class="erp-orb erp-orb-1"></div>
    <div class="erp-orb erp-orb-2"></div>
    <div class="erp-orb erp-orb-3"></div>

    <!-- Breadcrumb -->
    <nav class="erp-breadcrumb mb-4">

        <a class="erp-bc-link"
           @onclick='() => Nav.NavigateTo("/")'>

            <i class="bi bi-house-fill me-1"></i>
            Home

        </a>

        <span class="erp-bc-sep">
            <i class="bi bi-chevron-right"></i>
        </span>

        <span class="erp-bc-active">
            Account Master
        </span>

    </nav>

    <!-- Hero -->
    <div class="erp-page-header mb-4">

        <div class="erp-page-header-left">

            <div class="erp-page-icon erp-icon-green">
                <i class="bi bi-bank2"></i>
            </div>

            <div>

                <h1 class="erp-page-title">
                    Account Master
                </h1>

                <p class="erp-page-sub mb-0">
                    Financial setup · Banking · Currency · Cost centre management
                </p>

            </div>

        </div>

    </div>

    <!-- Cards -->
    <div class="row g-4">

        @foreach (var item in _links)
        {
            <div class="col-12 col-sm-6 col-xl-3">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <!-- ADD BUTTON -->
                    @if (!string.IsNullOrWhiteSpace(item.ButtonHref))
                    {
                        <button class="erp-card-top-btn"
                                @onclick:stopPropagation="true"
                                @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>

                            <i class="bi bi-plus-circle-fill me-1"></i>
                            Add

                        </button>
                    }

                    <!-- ICON -->
                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <!-- TITLE -->
                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <!-- DESCRIPTION -->
                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <!-- ARROW -->
                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

</div>

@code {

    private bool isDark;

    protected override void OnInitialized()
    {
        isDark = ThemeStateService.IsDarkMode;
        ThemeStateService.OnChange += ThemeChanged;
    }

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeStateService.OnChange -= ThemeChanged;
    }

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _links =
    {
        (
            "expense",
            "expense/create",
            "Expense Master",
            "Manage company expense categories and accounts",
            "bi bi-wallet2",
            "ic-red"
        ),

        (
            "income",
            "income/create",
            "Income Master",
            "Configure income accounts and revenue setup",
            "bi bi-cash-coin",
            "ic-green"
        ),

        (
            "bank",
            "",
            "Bank Detail Master",
            "Manage company bank accounts and details",
            "bi bi-bank",
            "ic-cyan"
        ),

        (
            "currency",
            "currency/create",
            "Currency Master",
            "Maintain supported currencies and exchange info",
            "bi bi-currency-exchange",
            "ic-indigo"
        ),

        (
            "currency_today",
            "",
            "Currency Today",
            "Manage daily currency exchange values",
            "bi bi-graph-up-arrow",
            "ic-purple"
        ),

        (
            "project-type-master",
            "",
            "Project Type",
            "Configure project categories and classifications",
            "bi bi-kanban-fill",
            "ic-orange"
        ),

        (
            "costcenter",
            "costCenter/create",
            "Cost Centre",
            "Manage cost centres and financial allocation",
            "bi bi-diagram-3-fill",
            "ic-pink"
        )
    };
}