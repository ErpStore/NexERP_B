@page "/inventory-master"
@inject NavigationManager Nav
@inject ThemeStateService ThemeStateService

<PageTitle>Inventory Master — ERP Suite</PageTitle>

<div class="erp-wrapper @(isDark ? "dark" : "light")">

    <!-- Ambient Orbs -->
    <div class="erp-orb erp-orb-1"></div>
    <div class="erp-orb erp-orb-2"></div>
    <div class="erp-orb erp-orb-3"></div>

    <!-- Breadcrumb -->
    <nav class="erp-breadcrumb mb-4">

        <a class="erp-bc-link"
           @onclick='() => Nav.NavigateTo("/")'>

            <i class="bi bi-house-fill me-1"></i>
            Home

        </a>

        <span class="erp-bc-sep">
            <i class="bi bi-chevron-right"></i>
        </span>

        <span class="erp-bc-active">
            Inventory Master
        </span>

    </nav>

    <!-- Hero -->
    <div class="erp-page-header mb-4">

        <div class="erp-page-header-left">

            <div class="erp-page-icon erp-icon-cyan">
                <i class="bi bi-box-seam-fill"></i>
            </div>

            <div>
                <h1 class="erp-page-title">
                    Inventory Master
                </h1>

                <p class="erp-page-sub mb-0">
                    Inventory setup · Material management · Cost estimation
                </p>
            </div>

        </div>

    </div>

    <!-- Cards -->
    <div class="row g-4">

        @foreach (var item in _links)
        {
            <div class="col-12 col-sm-6 col-xl-3">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <!-- ADD BUTTON -->
                    @if (!string.IsNullOrWhiteSpace(item.ButtonHref))
                    {
                        <button class="erp-card-top-btn"
                                @onclick:stopPropagation="true"
                                @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>

                            <i class="bi bi-plus-circle-fill me-1"></i>
                            Add

                        </button>
                    }

                    <!-- ICON -->
                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <!-- TITLE -->
                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <!-- DESCRIPTION -->
                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <!-- ARROW -->
                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

</div>

@code {

    private bool isDark;

    protected override void OnInitialized()
    {
        isDark = ThemeStateService.IsDarkMode;
        ThemeStateService.OnChange += ThemeChanged;
    }

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeStateService.OnChange -= ThemeChanged;
    }

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _links =
    {
        (
            "category",
            "category/create",
            "Category Master",
            "Manage product and material categories",
            "bi bi-grid-fill",
            "ic-indigo"
        ),

        (
            "uom",
            "",
            "Measurement Unit",
            "Define unit of measurement configurations",
            "bi bi-rulers",
            "ic-cyan"
        ),

        (
            "stores",
            "store/create",
            "Stores Master",
            "Manage warehouse and storage locations",
            "bi bi-shop",
            "ic-green"
        ),

        (
            "store-map",
            "",
            "Store Mapping",
            "Configure item to store mapping",
            "bi bi-diagram-3-fill",
            "ic-purple"
        ),

        (
            "hsnMaster",
            "hsn/create",
            "HSN / SAC Master",
            "Maintain taxation and HSN/SAC codes",
            "bi bi-receipt-cutoff",
            "ic-orange"
        ),

        (
            "rawMaterialList",
            "rawMaterial/create",
            "Material Master",
            "Manage raw materials and stock items",
            "bi bi-box2-fill",
            "ic-cyan"
        ),

        (
            "itemList",
            "item/create",
            "Item Master",
            "Create and maintain finished goods items",
            "bi bi-bag-fill",
            "ic-pink"
        ),

        (
            "bomList",
            "bom/create",
            "BOM Master",
            "Bill of materials and production structure",
            "bi bi-bezier2",
            "ic-indigo"
        ),

        (
            "processList",
            "process/create",
            "Process Master",
            "Production workflow and routing setup",
            "bi bi-gear-wide-connected",
            "ic-red"
        ),

        (
            "factorlist",
            "factor/create",
            "Factors Master",
            "Manage costing and process factors",
            "bi bi-sliders",
            "ic-green"
        ),

        (
            "groupingList",
            "grouping/create",
            "Grouping Master",
            "Configure inventory and item grouping",
            "bi bi-collection-fill",
            "ic-purple"
        ),

        (
            "ItemRate_Updation",
            "",
            "Item Price Update",
            "Update item pricing and cost revisions",
            "bi bi-currency-rupee",
            "ic-orange"
        ),

        
    };
}