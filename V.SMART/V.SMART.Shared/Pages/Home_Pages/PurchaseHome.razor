@page "/purchase-home"
@inject NavigationManager Nav
@inject ThemeStateService ThemeStateService

<PageTitle>Out Sourcing — ERP Suite</PageTitle>

<div class="erp-wrapper @(isDark ? "dark" : "light")">

    <!-- Ambient Orbs -->
    <div class="erp-orb erp-orb-1"></div>
    <div class="erp-orb erp-orb-2"></div>
    <div class="erp-orb erp-orb-3"></div>

    <!-- Breadcrumb -->
    <nav class="erp-breadcrumb mb-4">

        <a class="erp-bc-link" @onclick='() => Nav.NavigateTo("/")'>
            <i class="bi bi-house-fill me-1"></i>Home
        </a>

        <span class="erp-bc-sep">
            <i class="bi bi-chevron-right"></i>
        </span>

        <span class="erp-bc-active">
            Out Sourcing
        </span>

    </nav>

    <!-- Hero -->
    <div class="erp-page-header mb-4">
        <div class="erp-page-header-left">

            <div class="erp-page-icon erp-icon-amber">
                <i class="bi bi-bag-check-fill"></i>
            </div>

            <div>
                <h1 class="erp-page-title">
                    Out Sourcing
                </h1>

                <p class="erp-page-sub mb-0">
                    Purchase · Procurement · Vendor · Sub Contract Management
                </p>
            </div>

        </div>
    </div>

    <!-- PROCUREMENT -->
    <div class="row g-4 mb-4">

        <div class="col-12">
            <div class="erp-group-divider">
                <span>Procurement</span>
            </div>
        </div>

        @foreach (var item in _procurement)
        {
            <div class="col-12 col-sm-6 col-xl-3">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <!-- TOP RIGHT BUTTON -->
                    <button class="erp-card-top-btn"
                            @onclick:stopPropagation="true"
                            @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        Add

                    </button>

                    <!-- ICON -->
                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <!-- TITLE -->
                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <!-- DESCRIPTION -->
                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <!-- ARROW -->
                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

    <!-- PURCHASE -->
    <div class="row g-4 mb-4">

        <div class="col-12">
            <div class="erp-group-divider">
                <span>Purchase</span>
            </div>
        </div>

        @foreach (var item in _purchase)
        {
            <div class="col-12 col-sm-6 col-xl-3">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <button class="erp-card-top-btn"
                            @onclick:stopPropagation="true"
                            @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        Add

                    </button>

                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

    <!-- SUB CONTRACT -->
    <div class="row g-4">

        <div class="col-12">
            <div class="erp-group-divider">
                <span>Sub Contract</span>
            </div>
        </div>

        @foreach (var item in _subcon)
        {
            <div class="col-12 col-sm-6 col-xl-3">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <button class="erp-card-top-btn"
                            @onclick:stopPropagation="true"
                            @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        Add

                    </button>

                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

</div>

@code {

    private bool isDark;

    protected override void OnInitialized()
    {
        isDark = ThemeStateService.IsDarkMode;
        ThemeStateService.OnChange += ThemeChanged;
    }

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeStateService.OnChange -= ThemeChanged;
    }

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _procurement =
    {
        (
            "materialRequisitionList",
            "materialRequisition/create",
            "Material Requisition",
            "Create and track material indent requests",
            "bi bi-card-checklist",
            "ic-amber"
        ),

        (
            "EnquiryPurchase",
            "enquiryPurchase/create",
            "Purchase Enquiry",
            "Manage supplier and purchase enquiries",
            "bi bi-chat-left-dots-fill",
            "ic-cyan"
        ),

        (
            "purchaseQuoteList",
            "PurchaseQuote/create",
            "Vendor Quotation",
            "Handle supplier quotations and pricing",
            "bi bi-receipt-cutoff",
            "ic-purple"
        ),

        (
            "rate-comparison",
            "",
            "Price Comparison",
            "Compare vendor rates and quotations",
            "bi bi-bar-chart-fill",
            "ic-green"
        ),

        (
            "PurchPOList",
            "PurchPO/create",
            "Purchase Order",
            "Generate and manage purchase orders",
            "bi bi-bag-check-fill",
            "ic-indigo"
        ),

        (
            "debitNoteList",
            "debitNote/create",
            "Debit Note",
            "Manage supplier debit adjustments",
            "bi bi-cash-coin",
            "ic-red"
        ),
    };

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _purchase =
    {
        (
            "purchaseGRNList",
            "purchaseGRN/create",
            "Goods Received Note",
            "Track incoming purchased goods",
            "bi bi-box-seam-fill",
            "ic-cyan"
        ),

        (
            "purchaseSCNList",
            "purchaseSCN/create",
            "Store Credit Note",
            "Manage purchase return credit notes",
            "bi bi-journal-check",
            "ic-pink"
        ),

        (
            "purchaseInvoiceList",
            "purchaseInvoice/create",
            "Tax Invoice",
            "Create and process purchase invoices",
            "bi bi-file-earmark-text-fill",
            "ic-green"
        ),
    };

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _subcon =
    {
        (
            "subConDcOutList",
            "DcSubConOutgoing/create",
            "Delivery Challan",
            "Manage subcontract outward challans",
            "bi bi-truck",
            "ic-purple"
        ),

        (
            "subConGrnList",
            "DcSubConIncoming/create",
            "Goods Received Note",
            "Track subcontract inward receipts",
            "bi bi-box-arrow-in-down",
            "ic-cyan"
        ),

        (
            "subConScnList",
            "DcSubConSCN/create",
            "Store Credit Note",
            "Maintain subcontract store credits",
            "bi bi-journal-medical",
            "ic-pink"
        ),

        (
            "subConInvList",
            "DcSubConIncomingInvoice/create",
            "Tax Invoice",
            "Handle subcontractor invoice processing",
            "bi bi-file-earmark-ruled-fill",
            "ic-indigo"
        ),
    };
}