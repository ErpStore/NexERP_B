@page "/inventory-home"
@inject NavigationManager Nav
@inject ThemeStateService ThemeStateService

<PageTitle>Inventory — ERP Suite</PageTitle>

<div class="erp-wrapper @(isDark ? "dark" : "light")">

    <!-- Ambient Orbs -->
    <div class="erp-orb erp-orb-1"></div>
    <div class="erp-orb erp-orb-2"></div>
    <div class="erp-orb erp-orb-3"></div>

    <!-- Breadcrumb -->
    <nav class="erp-breadcrumb mb-4">

        <a class="erp-bc-link" @onclick='() => Nav.NavigateTo("/")'>
            <i class="bi bi-house-fill me-1"></i>Home
        </a>

        <span class="erp-bc-sep">
            <i class="bi bi-chevron-right"></i>
        </span>

        <span class="erp-bc-active">
            Inventory / Stock
        </span>

    </nav>

    <!-- Hero -->
    <div class="erp-page-header mb-4">
        <div class="erp-page-header-left">

            <div class="erp-page-icon erp-icon-teal">
                <i class="bi bi-box-seam-fill"></i>
            </div>

            <div>
                <h1 class="erp-page-title">
                    Inventory / Stock
                </h1>

                <p class="erp-page-sub mb-0">
                    Stock Position · Transfers · Issue Notes · Inter Store Movement
                </p>
            </div>

        </div>
    </div>

    <!-- INVENTORY MODULES -->
    <div class="row g-4">

        <div class="col-12">
            <div class="erp-group-divider">
                <span>Inventory Operations</span>
            </div>
        </div>

        @foreach (var item in _links)
        {
            <div class="col-12 col-sm-6 col-xl-3">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <!-- ADD BUTTON -->
                    @if (!string.IsNullOrWhiteSpace(item.ButtonHref))
                    {
                        <button class="erp-card-top-btn"
                                @onclick:stopPropagation="true"
                                @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>

                            <i class="bi bi-plus-circle-fill me-1"></i>
                            Add

                        </button>
                    }

                    <!-- ICON -->
                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <!-- TITLE -->
                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <!-- DESCRIPTION -->
                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <!-- ARROW -->
                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

</div>

@code {

    private bool isDark;

    protected override void OnInitialized()
    {
        isDark = ThemeStateService.IsDarkMode;
        ThemeStateService.OnChange += ThemeChanged;
    }

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeStateService.OnChange -= ThemeChanged;
    }

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _links =
    {
        (
            "stockPosition",
            "",
            "Stock Position",
            "View internal stock availability and balances",
            "bi bi-boxes",
            "ic-teal"
        ),

        (
            "stockPositionInternalExternal",
            "",
            "Stock Position with WIP",
            "Track inventory including work-in-progress stock",
            "bi bi-layers-half",
            "ic-cyan"
        ),

        (
            "scnGenList",
            "scnGen/create",
            "Stock Transfer Note",
            "Generate and manage stock transfer notes",
            "bi bi-arrow-left-right",
            "ic-indigo"
        ),

        (
            "minIssList",
            "minIss/create",
            "Consumable Issue Note",
            "Issue consumable materials to departments",
            "bi bi-box-arrow-up-right",
            "ic-orange"
        ),

        (
            "tcIssueList",
            "tci/create",
            "Tool Crib Issue Note",
            "Manage tool crib material issue entries",
            "bi bi-tools",
            "ic-purple"
        ),

        (
            "tcReturnList",
            "tcr/create",
            "Tool Crib Return Note",
            "Track returned tools and consumables",
            "bi bi-arrow-return-left",
            "ic-pink"
        ),

        (
            "storeIntertransList",
            "storeInterTrans/create",
            "Inter Store Transfer",
            "Transfer stock between internal stores",
            "bi bi-diagram-3-fill",
            "ic-green"
        ),

        (
            "bomPRScn",
            "bomPRScn",
            "BOM to Indent / STN",
            "Generate indent or transfer from BOM requirements",
            "bi bi-list-check",
            "ic-red"
        ),
    };
}