@page "/accounts-home"
@inject NavigationManager Nav
@inject ThemeStateService ThemeStateService

<PageTitle>Cash Flow — ERP Suite</PageTitle>

<div class="erp-wrapper @(isDark ? "dark" : "light")">

    <!-- Ambient Orbs -->
    <div class="erp-orb erp-orb-1"></div>
    <div class="erp-orb erp-orb-2"></div>
    <div class="erp-orb erp-orb-3"></div>

    <!-- Breadcrumb -->
    <nav class="erp-breadcrumb mb-4">

        <a class="erp-bc-link" @onclick='() => Nav.NavigateTo("/")'>
            <i class="bi bi-house-fill me-1"></i>Home
        </a>

        <span class="erp-bc-sep">
            <i class="bi bi-chevron-right"></i>
        </span>

        <span class="erp-bc-active">
            Cash Flow / Accounts
        </span>

    </nav>

    <!-- Hero -->
    <div class="erp-page-header mb-4">
        <div class="erp-page-header-left">

            <div class="erp-page-icon erp-icon-green">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div>
                <h1 class="erp-page-title">
                    Cash Flow / Accounts
                </h1>

                <p class="erp-page-sub mb-0">
                    Payments · Receipts · Advances · Banking & Financial Transactions
                </p>
            </div>

        </div>
    </div>

    <!-- ACCOUNTS MODULES -->
    <div class="row g-4">

        <div class="col-12">
            <div class="erp-group-divider">
                <span>Accounts Operations</span>
            </div>
        </div>

        @foreach (var item in _links)
        {
            <div class="col-12 col-sm-6 col-xl-4">

                <div class="erp-module-card position-relative"
                     @onclick='() => Nav.NavigateTo("/" + item.CardHref)'>

                    <!-- TOP RIGHT BUTTON -->
                    @if (!string.IsNullOrWhiteSpace(item.ButtonHref))
                    {
                        <button class="erp-card-top-btn"
                                @onclick:stopPropagation="true"
                                @onclick='() => Nav.NavigateTo("/" + item.ButtonHref)'>

                            <i class="bi bi-plus-circle-fill me-1"></i>
                            Add
                        </button>
                    }

                    <!-- ICON -->
                    <div class="erp-module-icon @item.Color">
                        <i class="@item.Icon"></i>
                    </div>

                    <div class="erp-module-shine"></div>

                    <!-- TITLE -->
                    <h5 class="erp-module-title">
                        @item.Label
                    </h5>

                    <!-- DESCRIPTION -->
                    <p class="erp-module-desc">
                        @item.Desc
                    </p>

                    <!-- ARROW -->
                    <div class="erp-module-arrow">
                        <i class="bi bi-arrow-right-short"></i>
                    </div>

                </div>

            </div>
        }

    </div>

</div>

@code {

    private bool isDark;

    protected override void OnInitialized()
    {
        isDark = ThemeStateService.IsDarkMode;
        ThemeStateService.OnChange += ThemeChanged;
    }

    private void ThemeChanged()
    {
        isDark = ThemeStateService.IsDarkMode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeStateService.OnChange -= ThemeChanged;
    }

    private readonly (
        string CardHref,
        string ButtonHref,
        string Label,
        string Desc,
        string Icon,
        string Color
    )[] _links =
    {
        (
            "PaymentList",
            "Payments/Create",
            "Payments",
            "Manage supplier and operational payment entries",
            "bi bi-cash-coin",
            "ic-green"
        ),

        (
            "ReceiptList",
            "Receipts/Create",
            "Receipts",
            "Track incoming customer and account receipts",
            "bi bi-wallet2",
            "ic-cyan"
        ),

        (
            "AdvanceAdjustmentList",
            "AdvanceAdjustment/Create",
            "Advance Adjustment",
            "Adjust and reconcile advance payments",
            "bi bi-arrow-left-right",
            "ic-purple"
        ),

        (
            "serviceBills",
            "serviceBills",
            "Service Bills",
            "Manage service invoices and billing records",
            "bi bi-receipt-cutoff",
            "ic-orange"
        ),

        (
            "Fundtransactions",
            "",
            "Bank Transactions",
            "Monitor banking and fund transfer activities",
            "bi bi-bank2",
            "ic-indigo"
        ),
    };
}