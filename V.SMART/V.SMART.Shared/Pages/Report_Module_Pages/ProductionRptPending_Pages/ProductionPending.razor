                partyType = SelectedAssemblyType;
            }

            PendingStatementsList =
                await ProductionPendingService.GetPendingStatements(
                    DetailsView,
                    partyType,
                    FromDate,
                    ToDate);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
    private async Task OnAssemblyTypeChanged(string value)
    {
        SelectedAssemblyType = value;

        await InitializeColumns(true);

        PendingStatementsList =
            await ProductionPendingService
            .GetPendingStatements(
                 DetailsView,
                SelectedAssemblyType,
                FromDate,
                ToDate);

        StateHasChanged();
    }

    private async Task OnComponentTypeChanged(string value)
    {
        SelectedComponentType = value;

        await InitializeColumns(true);

        PendingStatementsList =
            await ProductionPendingService
            .GetPendingStatements(
                 DetailsView,
                SelectedComponentType,
                FromDate,
                ToDate);

        StateHasChanged();
    }

    private int TotalPendingCount =>
    SelectedType == "Job Order"
        ? PendingStatementsList.Select(x => x.JobNo).Distinct().Count()

    : SelectedType == "Production Component" &&
      SelectedComponentType == "Production Component Issue"
        ? PendingStatementsList.Select(x => x.IssueNo).Distinct().Count()

    : SelectedType == "Production Assembly" &&
      SelectedAssemblyType == "Production Assembly Issue"
        ? PendingStatementsList.Select(x => x.IssueNo).Distinct().Count()

    : 0;
   

