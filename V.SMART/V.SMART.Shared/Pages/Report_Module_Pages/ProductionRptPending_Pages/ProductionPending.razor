    private IEnumerable<ProductionPendingVM> productionPendingVMs
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText))
                return PendingStatementsList;

            searchText = searchText.Trim();

            return PendingStatementsList.Where(x =>

                (x.CustName ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||

                (x.ItemCode ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||

                (x.ItemName ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||

                (x.PONo ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||

                (x.JobNo ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||

                (x.IssueNo ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||

                (x.SCNNo ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||
                 (x.ReturnNo ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||
                (x.RefPoNo ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||
                (x.RefGrnNo ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||
                (x.RefPoNo ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||
                (x.RefRcNo ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||

                (x.AssyItemCode ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

                ||

                (x.AssyItemName ?? string.Empty)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)

            ).ToList();
        }
