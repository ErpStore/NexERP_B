    .hero-section {
        background: linear-gradient(135deg, #4c1d95, #7c3aed, #0f766e);
        padding: 30px 35px;
        border-radius: 24px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        overflow: hidden;
        position: relative;
        box-shadow: 0 18px 40px rgba(109, 40, 217, 0.25);
    }

        .hero-section::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
            top: -120px;
            right: -80px;
        }

        .hero-section h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 800;
            font-family: Georgia, serif;
            letter-spacing: 0.5px;
        }

        .hero-section p {
            margin-top: 8px;
            opacity: 0.92;
            font-size: 15px;
        }

    .header-badge {
        background: rgba(255,255,255,0.15);
        padding: 12px 20px;
        border-radius: 40px;
        font-weight: 600;
        border: 1px solid rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
        z-index: 2;
    }


    /* FILTER CARD */

    .filter-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 20px;
        border: 1px solid var(--border);
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
        margin-bottom: 20px;
    }

    .filter-heading {
        color: var(--primary);
        font-weight: 700;
        margin-bottom: 12px;
    }

    /* FORM CONTROLS */

    .form-control,
    .form-select {
        border-radius: 12px;
        border: 1px solid #dbe3ee;
        min-height: 45px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 .2rem rgba(37,99,235,.15);
        }

    /* RADIO BUTTONS */

    .radio-item {
        background: #f8fafc;
        padding: 10px 18px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        transition: .3s;
        cursor: pointer;
    }

        .radio-item:hover {
            background: #eff6ff;
            border-color: #2563eb;
        }

    /* TABLE HEADER */

    .table-header {
        background: white;
        padding: 15px;
        border-radius: 15px;
        border: 1px solid var(--border);
        margin-bottom: 15px;
    }

        .table-header h6 {
            color: var(--dark);
            font-weight: 700;
        }

    /* SEARCH ICON */

    .input-group-text {
        background: var(--primary);
        color: white;
        border: none;
    }

    /* DETAIL CHECKBOX */

    .custom-checkbox {
        transform: scale(1.2);
        cursor: pointer;
    }

    .form-check-label {
        font-weight: 600;
        color: var(--dark);
    }

    /* EXPORT BUTTON */

    .custom-print-btn {
        background: linear-gradient(135deg,#10b981,#059669);
        color: white;
        border: none;
        border-radius: 15px;
        padding: 10px 20px;
        font-weight: 600;
        transition: .3s;
    }

        .custom-print-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16,185,129,.25);
        }

    /* TABLE */

    .custom-table {
        border-radius: 15px;
        overflow: hidden;
        background: white;
    }

        .custom-table thead th {
            background: linear-gradient(135deg,#1e40af,#2563eb);
            color: white;
            font-weight: 600;
            text-align: center;
            vertical-align: middle;
            border: none;
            white-space: nowrap;
        }

        .custom-table tbody td {
            vertical-align: middle;
            border-color: #edf2f7;
        }

        .custom-table tbody tr:nth-child(even) {
            background: #f8fafc;
        }

        .custom-table tbody tr:hover {
            background: #dbeafe;
            transition: .2s;
        }

    /* SUMMARY CARD */

    .summary-card {
        background: linear-gradient(135deg,#ffffff,#f8fafc);
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,.05);
    }

    .summary-icon {
        width: 60px;
        height: 60px;
        margin: auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#2563eb,#60a5fa);
        color: white;
        font-size: 24px;
    }

    .summary-title {
        margin-top: 15px;
        color: #64748b;
        font-weight: 600;
    }

    .summary-value {
        margin-top: 8px;
        font-size: 30px;
        font-weight: 700;
        color: #2563eb;
    }

    /* NO RECORD */

    .text-center.p-4 {
        background: white;
        border-radius: 15px;
        color: #64748b;
        font-weight: 600;
    }
</style>


