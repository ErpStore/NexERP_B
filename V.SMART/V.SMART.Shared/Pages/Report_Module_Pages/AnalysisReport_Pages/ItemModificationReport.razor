                                @if (reportType == "Deleted" || reportType == "All")
                                {
                                    <th>Delete By</th>
                                    <th>Delete Date</th>
                                }

                            </tr>

                        </thead>

                        <tbody>

                            @if (FilteredReportList.Any())
                            {
                                int slNo = 1;

                                @foreach (var item in FilteredReportList)
                                {
                                    <tr>
                                        @if (IsColumnVisible("SlNo"))
                                        {
                                            <td>@slNo</td>
                                        }

                                        @if (IsColumnVisible("ItemCode"))
                                        {
                                            <td>@item.ItemCode</td>
                                        }

                                        @if (IsColumnVisible("ItemName"))
                                        {
                                            <td>@item.ItemName</td>
                                        }

                                        @if (IsColumnVisible("CategoryName"))
                                        {
                                            <td>@item.CategoryName</td>
                                        }

                                        @if (IsColumnVisible("MeasureUnit"))
                                        {
                                            <td>@item.MeasureUnit</td>
                                        }

                                        @if (IsColumnVisible("HSNCode"))
                                        {
                                            <td>@item.HSNCode</td>
                                        }

                                        @if (IsColumnVisible("SACCode"))
                                        {
                                            <td>@item.SACCode</td>
                                        }

                                        @if (IsColumnVisible("Rate"))
                                        {
                                            <td class="text-end">@item.Rate</td>
                                        }

                                        @if (IsColumnVisible("ROL"))
                                        {
                                            <td class="text-end">@item.ROL</td>
                                        }

                                        @if (IsColumnVisible("MOL"))
