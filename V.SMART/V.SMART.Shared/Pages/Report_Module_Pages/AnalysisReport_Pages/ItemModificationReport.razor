@inject NavigationManager _navigation
@inject ILoggingService LoggingService
@inject IJSRuntime _js
@inject IJSRuntime _JS
@inject ExcelExportService ExcelExportService

@inject IItemModificationReportServices reportService
@inject IJSRuntime JS
@inject IExcelTemplateService excelTemplateService
@inherits BaseUserRightsComponent

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{

    <div class="container-fluid px-2 px-md-4 mt-4">

        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Item Modification Report"
                        TitleIcon="bi bi-pencil-square"
                        Breadcrumbs="@PoBreadcrumbs" />

            <div class="card-body p-4">


                <div class="row g-3 align-items-end mb-4">

                    <!-- From Date -->
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label fw-bold">From Date</label>
                        <InputDate @bind-Value="fromDate"
                                   @bind-Value:after="LoadReport"
                                   class="form-control" />
                    </div>

                    <!-- To Date -->
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                        <label class="form-label fw-bold">To Date</label>
                        <InputDate @bind-Value="toDate"
                                   @bind-Value:after="OnDateChanged"
                                   class="form-control" />
                    </div>

                    <!-- Report Type -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label fw-bold">Report Type</label>

                        <InputRadioGroup @bind-Value="reportType"
                                         @bind-Value:after="OnReportTypeChanged">

                            <div class="d-flex flex-wrap gap-2">

                                <div class="form-check">
                                    <InputRadio TValue="string"
                                                Value="@("Created")"
                                                class="form-check-input" />
                                    <label class="form-check-label">Created</label>
                                </div>

                                <div class="form-check">
                                    <InputRadio TValue="string"
                                                Value="@("Modified")"
                                                class="form-check-input" />
                                    <label class="form-check-label">Modified</label>
                                </div>

                                <div class="form-check">
                                    <InputRadio TValue="string"
                                                Value="@("Deleted")"
                                                class="form-check-input" />
                                    <label class="form-check-label">Deleted</label>
                                </div>

                                <div class="form-check">
                                    <InputRadio TValue="string"
                                                Value="@("All")"
                                                class="form-check-input" />
                                    <label class="form-check-label">All</label>
                                </div>

                            </div>

                        </InputRadioGroup>
                    </div>

                    <!-- Item -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label fw-bold">Item</label>

                        <InputSelect @bind-Value="selectedItemCode"
                                     @bind-Value:after="LoadReport"
                                     class="form-select">

                            <option value="">-- All Items --</option>

                            @foreach (var item in itemList)
                            {
                                <option value="@item.ItemCode">
                                    @item.ItemCode - @item.ItemName
                                </option>
                            }

                        </InputSelect>
                    </div>

                    <!-- Search -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <label class="form-label fw-bold">Search</label>

                        <input type="text"
                               class="form-control"
                               placeholder="Search..."
                               @bind="searchText"
                               @bind:event="oninput" />
                    </div>

                    <!-- Column Menu -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <ColumnMenu Columns="Columns"
                                    ScreenName="@ScreenName"
                                    UserId="@UserName"
                                    MaxVisible="int.MaxValue"
                                    OnChanged="HandleColumnChange" />
                    </div>

                    <!-- Print Button -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
                        <button class="btn btn-outline-primary w-100"
                                @onclick="@(async () => await ExportToExcel(true))"
                                title="Print Report">
                            <i class="bi bi-printer me-1"></i> Print
                        </button>
                    </div>

                </div>

                <div class="table-responsive border rounded" style="max-height:600px; overflow-x:auto; overflow-y:auto;">

                    <table class="table table-bordered table-sm mb-0 align-middle" style="min-width:1900px; white-space:nowrap;">

