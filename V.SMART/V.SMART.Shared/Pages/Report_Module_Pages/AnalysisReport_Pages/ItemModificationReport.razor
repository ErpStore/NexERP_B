@code
{
    protected override string ScreenName => "Item Modification";
    private DateTime fromDate = DateTime.Today.AddDays(-30);
    private DateTime toDate = DateTime.Today;

    private bool isProcessing = true;

    private string reportType = "Created";

    private string searchText = string.Empty;

    private string selectedItemCode = "";

    private List<ItemModificationReportVM> itemList = new();
    public List<GridColumn> Columns { get; set; } = new();
    private string UserName { get; set; } = "";

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = "";
    private string btnColor = string.Empty;



    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            await InitializeColumns();

            await LoadReport();

        }
        catch (Exception ex)
        {

            throw;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnReportTypeChanged()
    {


        await LoadReport();
    }

    private async Task OnDateChanged()
    {


        await LoadReport();
    }

    private Task HandleColumnChange(List<GridColumn> updated)
    {
        Columns = updated;
        return Task.CompletedTask;
    }

    private bool IsColumnVisible(string field)
    {
        return Columns.Any(x => x.Field == field && x.IsVisible);
    }

    private List<PageHeader.BreadcrumbItem> PoBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem{Text = "Report"},
        new PageHeader.BreadcrumbItem { Text = "Analysis Report" },
        new PageHeader.BreadcrumbItem{Text = "Item Modification Report", IsLast = true}
    };

    private List<ItemModificationReportVM> reportList = new();

    private async Task LoadReport()
    {
        var data = await reportService.GetReport(fromDate, toDate, reportType);

        itemList = data.GroupBy(x => new { x.ItemCode, x.ItemName })
            .Select(g => g.First()).OrderBy(x => x.ItemName).ToList();

        if (!string.IsNullOrWhiteSpace(selectedItemCode))
        {
            data = data.Where(x => x.ItemCode == selectedItemCode).ToList();
        }

        reportList = data;

        await InvokeAsync(StateHasChanged);
    }

    private async Task InitializeColumns()
    {
        try
        {
            Columns = new List<GridColumn>
            {
                new() { Title = "Sl No", Field = "SlNo", IsVisible = true },
                new() { Title = "Item Code / Part No.", Field = "ItemCode", IsVisible = true },
                new() { Title = "Item Name / Description", Field = "ItemName", IsVisible = true },
                new() { Title = "Specification", Field = "Specification", IsVisible = true },
                new() { Title = "Drawing No", Field = "DrawingNo", IsVisible = false },
                new() { Title = "Barcode", Field = "Barcode", IsVisible = false },
                new() { Title = "QRCode", Field = "QRCode", IsVisible = false },

                // Item Type
                new() { Title = "Item Type (BtoT / Mfg)", Field = "BtOtorMfg", IsVisible = true },

                // Category
                new() { Title = "Category Code", Field = "CategoryCode", IsVisible = true },
                new() { Title = "Category Name", Field = "CategoryName", IsVisible = true },
                new() { Title = "Hide", Field = "Hide", IsVisible = false },

                // Units
                new() { Title = "Measure Unit", Field = "MeasureUnit", IsVisible = true },
                new() { Title = "Purchase Unit", Field = "PurchaseUnit", IsVisible = false },
                new() { Title = "Unit Convert", Field = "UnitConvert", IsVisible = false },

                // Inventory Details
                new() { Title = "Rack No", Field = "RackNo", IsVisible = false },
                new() { Title = "ROL", Field = "ROL", IsVisible = false },
                new() { Title = "MOL", Field = "MOL", IsVisible = false },
                new() { Title = "Lead Time", Field = "LeadTime", IsVisible = false },
                new() { Title = "Part Weight", Field = "PartWeight", IsVisible = true },
                new() { Title = "Bin Location", Field = "BinLocation", IsVisible = false },
                new() { Title = "Consider as RM", Field = "ConsiderAsRm", IsVisible = false },

                // Physical Properties
                new() { Title = "Make", Field = "Make", IsVisible = false },
                new() { Title = "Raw Material Name", Field = "RawMaterialName", IsVisible = false },
                new() { Title = "Shape", Field = "Shape", IsVisible = false },
                new() { Title = "Density", Field = "Density", IsVisible = false },
                new() { Title = "Length", Field = "Length", IsVisible = false },
                new() { Title = "Width", Field = "Width", IsVisible = false },
                new() { Title = "Height", Field = "Height", IsVisible = false },
                new() { Title = "Thickness", Field = "Thickness", IsVisible = false },
                new() { Title = "Wall Thickness", Field = "WallThickness", IsVisible = false },
                new() { Title = "Outer Dia", Field = "OuterDia", IsVisible = false },
                new() { Title = "Inner Dia", Field = "InnerDia", IsVisible = false },
                new() { Title = "Weight", Field = "Weight", IsVisible = false },
                new() { Title = "Batch No", Field = "BatchNo", IsVisible = false },

                new() { Title = "Assigned Customer", Field = "AssignedCustomerName", IsVisible = false },
                // Rates
                new() { Title = "Rate", Field = "Rate", IsVisible = true },
                new() { Title = "Alternate Rate", Field = "AltRate", IsVisible = false },

                // Tax
                new() { Title = "HSN Code", Field = "HSNCode", IsVisible = true },
                new() { Title = "SAC Code", Field = "SACCode", IsVisible = true },
                new() { Title = "CGST %", Field = "CGST", IsVisible = false },
                new() { Title = "SGST %", Field = "SGST", IsVisible = false },
                new() { Title = "IGST %", Field = "IGST", IsVisible = false },

                // Revision
                new() { Title = "Rev", Field = "Rev", IsVisible = false },

                // Audit Fields
                new() { Title = "Created By", Field = "CreatedBy", IsVisible = true },
                new() { Title = "Created Date", Field = "CreatedDate", IsVisible = true },
                new() { Title = "Modified By", Field = "ModifiedBy", IsVisible = false },
                new() { Title = "Modified Date", Field = "ModifiedDate", IsVisible = false }

            };
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error initializing columns in ItemList");
            await _js.ToastrError("Failed to initialize columns.");
        }
    }

    private IEnumerable<ItemModificationReportVM> FilteredReportList => string.IsNullOrWhiteSpace(searchText)
        ? reportList
        : reportList.Where(x =>

            (x.ItemCode?.Contains(searchText,
                StringComparison.OrdinalIgnoreCase) ?? false)

            ||

            (x.ItemName?.Contains(searchText,
                StringComparison.OrdinalIgnoreCase) ?? false)

            ||

            (x.Rate?.ToString().Contains(searchText) ?? false)

            ||

            (x.CreatedBy?.Contains(searchText,
                StringComparison.OrdinalIgnoreCase) ?? false)

            ||

            (x.ModifiedBy?.Contains(searchText,
                StringComparison.OrdinalIgnoreCase) ?? false)

            ||

            (x.DeletedBy?.Contains(searchText,
                StringComparison.OrdinalIgnoreCase) ?? false)

            ||

            (x.CategoryName?.Contains(searchText,
                StringComparison.OrdinalIgnoreCase) ?? false)

            ||

            (x.HSNCode?.Contains(searchText,
                StringComparison.OrdinalIgnoreCase) ?? false)

            ||

            (x.SACCode?.Contains(searchText,
                StringComparison.OrdinalIgnoreCase) ?? false)

        );

    private async Task HandleExport()
    {


        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }

    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;

            // await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirm)
                return;

            if (reportList == null || !reportList.Any())
            {
                await _JS.ToastrWarning("No records available to export.");
                return;
            }

            var visibleColumns = Columns
                .Where(c => c.IsVisible)
                .Select(c => c.Field)
                .ToList();

            int slNo = 1;

            List<Dictionary<string, object>> exportData = new();

            foreach (var x in FilteredReportList)
            {
                var row = new Dictionary<string, object>();

                if (visibleColumns.Contains("SlNo"))
                    row["Sl No"] = slNo++;

                if (visibleColumns.Contains("ItemCode"))
                    row["Item Code"] = x.ItemCode ?? "";

                if (visibleColumns.Contains("ItemName"))
                    row["Item Name"] = x.ItemName ?? "";

                if (visibleColumns.Contains("CategoryName"))
                    row["Category"] = x.CategoryName ?? "";

                if (visibleColumns.Contains("MeasureUnit"))
                    row["UOM"] = x.MeasureUnit ?? "";

                if (visibleColumns.Contains("HSNCode"))
                    row["HSN Code"] = x.HSNCode ?? "";

                if (visibleColumns.Contains("SACCode"))
                    row["SAC Code"] = x.SACCode ?? "";

                if (visibleColumns.Contains("Rate"))
                    row["Rate"] = x.Rate?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("ROL"))
                    row["ROL"] = x.ROL?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("MOL"))
                    row["MOL"] = x.MOL?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("Specification"))
                    row["Specification"] = x.Specification ?? "";

                if (visibleColumns.Contains("CGST"))
                    row["CGST %"] = x.CGST?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("SGST"))
                    row["SGST %"] = x.SGST?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("IGST"))
                    row["IGST %"] = x.IGST?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("Remarks"))
                    row["Remarks"] = x.Remarks ?? "";

                if (visibleColumns.Contains("DrawingNo"))
                    row["Drawing No"] = x.DrawingNo ?? "";

                if (visibleColumns.Contains("LeadTime"))
                    row["Lead Time"] = x.LeadTime;

                if (visibleColumns.Contains("RackNo"))
                    row["Rack No"] = x.RackNo ?? "";

                if (visibleColumns.Contains("PartWeight"))
                    row["Part Weight"] = x.PartWeight?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("TotalArea"))
                    row["Total Area"] = x.TotalArea?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("Make"))
                    row["Make"] = x.Make ?? "";

                if (visibleColumns.Contains("RmId"))
                    row["RM ID"] = x.RmId;

                if (visibleColumns.Contains("Shape"))
                    row["Shape"] = x.Shape ?? "";

                if (visibleColumns.Contains("Density"))
                    row["Density"] = x.Density?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("Length"))
                    row["Length"] = x.Length?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("Width"))
                    row["Width"] = x.Width?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("Height"))
                    row["Height"] = x.Height?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("Thickness"))
                    row["Thickness"] = x.Thickness?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("WallThickness"))
                    row["Wall Thickness"] = x.WallThickness?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("OuterDia"))
                    row["Outer Dia"] = x.OuterDia?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("InnerDia"))
                    row["Inner Dia"] = x.InnerDia?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("Weight"))
                    row["Weight"] = x.Weight?.ToString("0.000") ?? "0.000";

                if (visibleColumns.Contains("BatchNo"))
                    row["Batch No"] = x.BatchNo ?? "";

                if (reportType == "Created" || reportType == "All")
                {
                    row["Created By"] = x.CreatedBy ?? "";
                    row["Created Date"] = x.CreatedDate?.ToString("dd/MM/yyyy") ?? "";
                }

                if (reportType == "Modified" || reportType == "All")
                {
                    row["Modified By"] = x.ModifiedBy ?? "";
                    row["Modified Date"] = x.ModifiedDate?.ToString("dd/MM/yyyy") ?? "";
                }

                if (reportType == "Deleted" || reportType == "All")
                {
                    row["Deleted By"] = x.DeletedBy ?? "";
                    row["Deleted Date"] = x.ActionDate?.ToString("dd/MM/yyyy") ?? "";
                }

                exportData.Add(row);
            }

            var bytes = await ExcelExportService.ExportPendingListToExcel(
                exportData,
                "ItemModificationReport",
                "Item Modification Report");

            var base64 = Convert.ToBase64String(bytes);

            await _JS.DownloadExcelAsync(base64, "ItemModificationReport.xlsx");
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in Item Modification Report Export");

            await _JS.ToastrError("Error while exporting Item Modification Report!");
        }
        finally
        {
            isProcessing = false;
        }
    }
}