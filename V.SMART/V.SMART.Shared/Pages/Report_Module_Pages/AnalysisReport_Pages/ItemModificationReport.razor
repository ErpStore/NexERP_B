                                        }

                                        @if (IsColumnVisible("CGST"))
                                        {
                                            <td class="text-end">@item.CGST</td>
                                        }

                                        @if (IsColumnVisible("SGST"))
                                        {
                                            <td class="text-end">@item.SGST</td>
                                        }

                                        @if (IsColumnVisible("IGST"))
                                        {
                                            <td class="text-end">@item.IGST</td>
                                        }

                                        @if (IsColumnVisible("Remarks"))
                                        {
                                            <td>@item.Remarks</td>
                                        }

                                        @if (IsColumnVisible("DrawingNo"))
                                        {
