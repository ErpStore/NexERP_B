    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;

            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirm)
                return;


            byte[] bytes;

            List<Dictionary<string, object>> exportSummary = new();

            if (Topic == "Summary")
            {
                if (Filtered_RC_Analysis_Data == null || !Filtered_RC_Analysis_Data.Any())
                    return;

                exportSummary = GetExportData(PagedData.ToList());
                bytes = await ExcelExportService.ExportPendingListToExcel(exportSummary, "RouteCard_Analysis_Summary", "RouteCard_Analysis_Summary List");
            }

            else if (Topic == "Details")
            {
                if (RC_Analysis_Details == null || !RC_Analysis_Details.Any())
                    return;

                var exportDetails = GetExportData_Details(RC_Analysis_Details.ToList());

                bytes = await ExcelExportService.ExportPendingListToExcel(exportDetails, "RouteCard_Analysis_Details", "RouteCard_Analysis_Details List of RC No. - " + @SelectedRCNo + "");
            }
            else
            {
                return;
            }

            var base64 = Convert.ToBase64String(bytes);

            if (Topic == "Summary")
                await _js.DownloadExcelAsync(base64,"RouteCard_Analysis_Summary.xlsx");
            else if (Topic == "Details")
                await _js.DownloadExcelAsync(base64, "RouteCard_Analysis_Details.xlsx");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex,"Error in RouteCard_Analysis_Excel Export");
            await _js.ToastrError("Error while exporting RouteCard_Analysis!");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private List<Dictionary<string, object>> GetExportData_Details<T>(List<T> data)
    {
        var result = new List<Dictionary<string, object>>();

        foreach (var row in data)
        {
            var dict = new Dictionary<string, object>();

            if (row is RouteCardAnalysisDetailsVM detail)
            {
                dict["Sl No"] = detail.SlNo;
                dict["Sequence No."] = detail.SeqNo;
                dict["Process Name"] = detail.ProcessName;
                dict["Trans Type"] = detail.TransType;
                dict["Total Qty"] = detail.TotalQty;
                dict["Issued Qty"] = detail.IssuedQty;
                dict["Accepted Qty"] = detail.AccQty;
                dict["Rejected Qty"] = detail.RejQty;
                dict["Rework Qty"] = detail.RewQty;
                dict["Issue No."] = detail.IssueNo;
                dict["GRN No."] = detail.GRNNo;
                dict["SCN No."] = detail.SCNNo;

                dict["Status"] = detail.ProcessStatus switch
                {
                    0 => "Pending",
                    1 => "In Progress",
                    2 => "Partial",
                    3 => "Completed",
                    _ => ""
                };
            }


            result.Add(dict);
        }


        return result;
    }

    private List<Dictionary<string, object>> GetExportData<T>(List<T> data)
    {
        return data
        .Select(row =>
        {
            var dict = new Dictionary<string, object>();

            
                foreach (var col in Columns.Where(x => x.IsVisible))
                {
                    var prop = typeof(T).GetProperty(col.Field);

                    if (prop != null)
                    {
                        dict[col.Title] = prop.GetValue(row);
                    }
                }

            return dict;
        })
        .ToList();
    }

    //pooja
    private List<Dictionary<string, object>> GetSummaryExportData(List<RouteCardAnalysisVM> data)
    {
        var exportData = new List<Dictionary<string, object>>();
        long slno = 1;

        foreach (var x in data)
        {
            var dict = new Dictionary<string, object>();

            foreach (var col in Columns.Where(c => c.IsVisible))
            {
                switch (col.Field)
                {
                    case "SlNo":
                        dict["SlNo"] = slno++;
                        break;

                    case "IsManual":
                        dict["IsManual"] = x.IsManual;
                        break;

                    case "MfgOrLab":
                        dict["MfgOrLab"] = x.MfgOrLab;
                        break;

                    case "Customer":
                        dict["Customer"] = x.Customer;
                        break;

                    case "PONo":
                        dict["PONo"] = x.PONo;
                        break;

                    case "PODate":
                        dict["PODate"] = x.PODate;
                        break;

                    case "RCNo":
                        dict["RCNo"] = x.RCNo;
                        break;

                    case "RCDate":
                        dict["RCDate"] = x.RCDate;
                        break;

                    case "Assembly":
                        dict["Assembly"] = x.Assembly;
                        break;

                    case "Component":
                        dict["Component"] = x.Component;
                        break;

                    case "RCQty":
                        dict["RCQty"] = x.RCQty;
                        break;

                    case "RM":
                        dict["RM"] = x.RM;
                        break;

                    case "RMQty":
                        dict["RMQty"] = x.RMQty;
                        break;

                    case "RCStatus":
                        dict["Status"] = x.RCStatus switch
                        {
                            0 => "Pending",
                            1 => "In Progress",
                            2 => "Completed",
                            3 => "Cancelled",
                            _ => ""
                        };
                        break;

                    case "DCNo":
                        dict["DCNo"] = x.DCNo;
                        break;

                    case "DCDate":
                        dict["DCDate"] = x.DCDate;
                        break;

                    case "InvNo":
                        dict["InvNo"] = x.InvNo;
                        break;

                    case "InvDate":
                        dict["InvDate"] = x.InvDate;
                        break;
                }
            }

            exportData.Add(dict);
        }

        return exportData;
    }

    
