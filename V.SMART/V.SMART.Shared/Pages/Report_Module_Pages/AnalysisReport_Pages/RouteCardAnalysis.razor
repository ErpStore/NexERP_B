    private async Task LoadFilters()
    {
        var query = RC_Analysis_Data.AsQueryable();


        // CUSTOMER LIST

        customers = query
            .Where(x => !x.IsManual)
            .GroupBy(x => x.CustId)
            .Select(x => new RouteCardVM
            {
                CustId = x.Key,
                CustName = x.First().Customer
            })
            .ToList();


        if (query.Any(x => x.IsManual))
        {
            customers.Add(new RouteCardVM
            {
                CustId = -1,
                CustName = "Manual"
            });
        }



        // CUSTOMER FILTER

        if (selectedCustomerId == -1)
        {
            query = query.Where(x => x.IsManual);
        }
        else if (selectedCustomerId > 0)
        {
            query = query.Where(x =>
                x.CustId == selectedCustomerId);
        }



        // ROUTECARDS

        routeCards = query
            .GroupBy(x => x.RCId)
            .Select(x => new RouteCardVM
            {
                RCId = x.Key,
                RCNo = x.First().RCNo
            })
            .ToList();



        // DISPLAY DATA

        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        var query = RC_Analysis_Data.AsQueryable();


        if (selectedCustomerId == -1)
            query = query.Where(x => x.IsManual);

        else if (selectedCustomerId > 0)
            query = query.Where(x => x.CustId == selectedCustomerId);



        if (selectedRouteCardId > 0)
            query = query.Where(x => x.RCId == selectedRouteCardId);



        if (selectedStatus != -1)
            query = query.Where(x => x.RCStatus == selectedStatus);

        Filtered_RC_Analysis_Data = query.ToList();

        currentPage = 1;
    }



