@code {

    #region FILTERS
    private bool isProcessing = true;

    protected override string ScreenName => "Route Card Analysis";

    public List<GridColumn> Columns { get; set; }

    private DateTime fromDate = DateTime.Today.AddMonths(-1);

    private DateTime toDate = DateTime.Today;

    private int selectedCustomerId = 0;

    private int selectedRouteCardId = 0;

    private int selectedStatus = -1;

    private string? UserName;
    #endregion

    #region DATA

    //private List<CustomerVM> customers = new();
    private List<RouteCardVM> customers = new();

    public List<RouteCardVM> routeCards { get; set; } = new();

    public List<StatusVM> statuses { get; set; } = new();

    public List<RouteCardAnalysisVM> RC_Analysis_Data { get; set; } = new();

    public List<RouteCardAnalysisVM> Filtered_RC_Analysis_Data { get; set; } = new();

    public List<RouteCardAnalysisDetailsVM> RC_Analysis_Details{ get; set; } = new();

    private string customerSearch { get; set; } = string.Empty;

    private string RCSearch { get; set; } = string.Empty;

    private int? expandedId = 0;

    private string? SelectedRCNo;

    int _pageSize = 5;

    int pageSize
    {
        get => _pageSize;

        set
        {
            _pageSize = value;

            currentPage = 1;
        }
    }

    int currentPage = 1;

    int totalPages
    {
        get
        {
            
            if (Filtered_RC_Analysis_Data == null || Filtered_RC_Analysis_Data.Count == 0)
                return 1;

            return (int)Math.Ceiling(
                (double)Filtered_RC_Analysis_Data.Count / pageSize);
        }
    }

    private IEnumerable<RouteCardAnalysisVM> PagedData =>
    Filtered_RC_Analysis_Data
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private int startRecord =>
    Filtered_RC_Analysis_Data.Count == 0
        ? 0
        : ((currentPage - 1) * pageSize) + 1;

    private int endRecord =>
        Math.Min(currentPage * pageSize,
                 Filtered_RC_Analysis_Data.Count);

    private List<PageHeader.BreadcrumbItem> RCAnalysisBreadcrumbs { get; set; } = new()
        {
        new PageHeader.BreadcrumbItem { Text = "Reports" },
        new PageHeader.BreadcrumbItem { Text = "Analysis Reports" },
        new PageHeader.BreadcrumbItem { Text = "Route Card Analysis", IsLast = true }
        };
    #endregion

    #region Print
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = "";
    private string btnColor = string.Empty;
    private string Topic = "";
    #endregion

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            
            UserName = await _userService.GetUsernameAsync();
            await InitializeColumns(IsHidden);
            await LoadFilters();
            await LoadColumnPreferences(UserName);

        }
        catch (Exception ex)
        {
