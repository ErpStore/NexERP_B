@page "/RouteCardAnalysis"
@using Microsoft.Data.SqlClient
@using V.SMART.Shared.BusinessLayer.BusinessService
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.IAnalysisReportService
@using V.SMART.Shared.Data.Planning.ComponentRouteCard
@using V.SMART.Shared.ViewModels.InventoryViewModel.StockAddVM
@using MudBlazor
@using V.SMART.Shared.ViewModels.ReportViewModel.AnalysisReportViewModel
@using System.Dynamic

@inherits BaseUserRightsComponent

@inject ILoggingService _logs
@inject CurrentUserService _userService
@inject IJSRuntime _js
@inject IRouteCardAnalysisService _rcanalysis
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService
@inject IColumnPreferenceService PreferenceService
@inject ApplicationDbContext _context
@inject ExcelExportService ExcelExportService

<BsModal OnModalConfirmation="confirmation_Click"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title="@ModalTitle">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4" @onclick="CloseDropdowns">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Route Card Analysis"
                        TitleIcon="bi bi-list-check"
                        Breadcrumbs="@RCAnalysisBreadcrumbs" />

            <PageTitle>Route Card Analysis</PageTitle>

            <div class="container-fluid mt-3">

            <!-- HEADER -->
            <div class="card shadow-sm mb-3">

                <div class="card-body">

                    <!-- FILTERS -->
                        <div class="row g-3 align-items-end">

                        <div class="col-md-3">
                            <label>From Date</label>
                                <InputDate class="form-control" @bind-Value="fromDate" @bind-Value:after="OnDateChanged" />

                        </div>

                        <div class="col-md-3">
                            <label>To Date</label>
                                <InputDate class="form-control" @bind-Value="toDate" @bind-Value:after="OnDateChanged" />
                        </div>

                

                        <div class="col-md-4 position-relative">

                            <label>Customer</label>

                                <input class="form-control"
                                       placeholder="Search Customer..."
                                       value="@customerSearch"
                                       @oninput="OnCustomerSearch"
                                       @onclick="ShowCustomerList"
                                       @onclick:stopPropagation="true" />


                            @if (showCustomerList)
                            {
                                <div class="dropdown-menu show w-100"
                                         @onclick:stopPropagation="true"
                                        style="max-height:250px; overflow-y:auto;">
                                        
                                    <div class="dropdown-item"
                                            @onclick="() => SelectCustomer(0)">
                                        All
                                    </div>


                                    @foreach (var cust in FilteredCustomers)
                                    {
                                        <div class="dropdown-item"
                                                @onclick="() => SelectCustomer(cust.CustId)">

                                            @cust.CustName

                                        </div>
                                    }

                                </div>
                            }

                        </div>

                        <div class="col-md-2 position-relative">

                            <label>Route Card No</label>

                            <input class="form-control"
                                    placeholder="Search Route Card..."
                                    @bind="RCSearch"
                                    @bind:event="oninput"
                                    @onclick="ShowRCList" @onclick:stopPropagation="true" />


                            @if (showRCList)
                            {
                                <div class="dropdown-menu show w-100"
                                         @onclick:stopPropagation="true"
                                        style="max-height:250px; overflow-y:auto;">

                                    <div class="dropdown-item"
                                            @onclick="() => SelectRouteCard(0)">
                                        All
                                    </div>


                                    @foreach (var rc in FilteredRC)
                                    {
                                        <div class="dropdown-item"
                                                @onclick="() => SelectRouteCard(rc.RCId)">

                                            @rc.RCNo

                                        </div>
                                    }

                                </div>
                            }

                        </div>

                        <div class="col-md-2">
                            <label>Status</label>
                                <InputSelect class="form-select" @bind-Value="selectedStatus" @bind-Value:after="ApplyFilters">
                                    <option value="-1">All</option>
                                    <option value="0">Pending</option>
                                    <option value="1">In Progress</option>
                                    <option value="2">Completed</option>
                                    <option value="3">Cancelled</option> 
                                    
                                    @foreach (var status in statuses)
                                    {
                                        <option value="@status.StatusId">
                                            @status.StatusName
                                        </option>
                                    }
                            </InputSelect>
                        </div>

                    </div>

                </div>
            </div>

            <!-- SUMMARY GRID -->
            @if (Filtered_RC_Analysis_Data.Any())
            {
            <div class = "col-12">
                <div class="card shadow-sm">

                    <!-- HEADER -->

                            @* <div class="card-header route-summary-header"> *@
                            <div class="card-header d-flex flex-column gap-3">
                                <h5 class="mb-0">
                                    Route Card Summary
                                </h5>


                                @* <div class="summary-controls"> *@
                                @* <div class="d-flex align-items-center flex-wrap gap-3">
                                    <ColumnMenu Columns="Columns"
                                                ScreenName="@ScreenName"
                                                UserId="@UserName"
                                                MaxVisible="int.MaxValue"
                                                OnChanged="HandleColumnChange" />

                                    

                                    <div class="d-flex align-items-center gap-2">
                                        <button class="btn btn-success"
                                                @onclick="HandleExportRCSummary">
                                            <i class="bi bi-printer"></i>
                                            Print Summary
                                        </button>

                                        <span>Show</span>

                                        <select class="form-select form-select-sm"
                                                style="width:70px;"
                                                @bind="pageSize">

                                            <option value="5">5</option>
                                            <option value="10">10</option>
                                            <option value="50">50</option>
                                            <option value="100">100</option>
                                            <option value="500">500</option>

                                        </select>

                                        <span>entries</span>

                                    </div>

                                </div> *@
                                <div class="d-flex align-items-center gap-3 w-100">

                                    <ColumnMenu Columns="Columns"
                                                ScreenName="@ScreenName"
                                                UserId="@UserName"
                                                MaxVisible="int.MaxValue"
                                                OnChanged="HandleColumnChange" />


                                    <div class="d-flex align-items-center gap-2 ms-auto">

                                        <button class="btn btn-success"
                                                @onclick="HandleExportRCSummary">

                                            <i class="bi bi-printer"></i>
                                            Print Summary

                                        </button>


                                        <span>Show</span>


                                        <select class="form-select form-select-sm"
                                                style="width:70px;"
                                                @bind="pageSize">

                                            <option value="5">5</option>
                                            <option value="10">10</option>
                                            <option value="50">50</option>
                                            <option value="100">100</option>
                                            <option value="500">500</option>

                                        </select>


                                        <span>entries</span>

                                    </div>

                                </div>

                            </div>

                    <!-- BODY -->

                    <div class="card-body p-0">

                        <!-- SCROLLABLE TABLE -->

                        <div class="table-responsive"
                             style="max-height:500px; overflow-y:auto; overflow-x:auto;">

                            @* <table class="table table-bordered table-sm align-middle text-center mb-0"
                                   style="min-width:1500px; font-size:12px;"> *@
                               <table class="table table-bordered table-sm text-center mb-0"
                                      style="min-width:1500px;font-size:12px;white-space:nowrap;vertical-align:middle;">

                                <!-- HEADER -->

                                 <thead class="custom-blue">
                                

                                    <tr>

                                        @foreach (var col in Columns.Where(x => x.IsVisible))
                                        {
                                            @* <th>
                                                @col.Title
                                            </th> *@
                                            <th style="background:#f8f9fa;position:sticky;top:0;z-index:2;white-space:nowrap;vertical-align:middle;">
                                                @col.Title
                                            </th>
                                        }

                                         @* <th class="sticky-action text-center" width="120">
                                            Action
                                        </th> *@
                                        <th class="text-center"width="120"style="position:sticky;right:0;top:0;z-index:20;background:#0d6efd;color:white;white-space:nowrap;">
                                        Action
                                        </th>

                                    </tr>

                                </thead>

                                <!-- BODY -->
                                      
                                <tbody>

                                    @if (Filtered_RC_Analysis_Data == null || Filtered_RC_Analysis_Data.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="@((Columns.Count(x => x.IsVisible)) + 1)"
                                                class="text-center py-3">

                                                No Data Found

                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var rc in PagedData.Select((item, index) => new { item, index }))
                                        {
                                            <tr>

                                                @foreach (var col in Columns.Where(x => x.IsVisible))
                                                {

                                                    switch (col.Field)
                                                    {

                                                        case "SlNo":
                                                            <td>@(rc.index + 1)</td>
                                                            break;


                                                        case "RCId":
                                                            <td>@rc.item.RCId</td>
                                                            break;


                                                        case "IsManual":
                                                            <td>@rc.item.IsManual</td>
                                                            break;


                                                        case "MfgOrLab":
                                                            <td>@rc.item.MfgOrLab</td>
                                                            break;


                                                        case "Customer":
                                                            <td>@rc.item.Customer</td>
                                                            break;


                                                        case "PONo":
                                                            <td>@rc.item.PONo</td>
                                                            break;


                                                        case "PODate":
                                                            <td>@rc.item.PODate</td>
                                                            break;


                                                        case "RCNo":
                                                            <td>@rc.item.RCNo</td>
                                                            break;


                                                        case "RCDate":
                                                            <td>@rc.item.RCDate</td>
                                                            break;


                                                        case "Assembly":
                                                            <td>@rc.item.Assembly</td>
                                                            break;


                                                        case "Component":
                                                            <td>@rc.item.Component</td>
                                                            break;


                                                        case "RCQty":
                                                            <td>@rc.item.RCQty</td>
                                                            break;


                                                        case "RM":
                                                            <td>@rc.item.RM</td>
                                                            break;


                                                        case "RMQty":
                                                            <td>@rc.item.RMQty</td>
                                                            break;


                                                        case "RCStatus":

                                                            <td>

                                                                @switch (rc.item.RCStatus)
                                                                {
                                                                    case 0:
                                                                        <span class="badge text-bg-warning">
                                                                            Pending
                                                                        </span>
                                                                        break;

                                                                    case 1:
                                                                        <span class="badge text-bg-primary">
                                                                            In Progress
                                                                        </span>
                                                                        break;

                                                                    case 2:
                                                                        <span class="badge text-bg-success">
                                                                            Completed
                                                                        </span>
                                                                        break;

                                                                    case 3:
                                                                        <span class="badge text-bg-danger">
                                                                            Cancelled
                                                                        </span>
                                                                        break;
                                                                }

                                                            </td>

                                                            break;


                                                        case "DCNo":
                                                            <td>@rc.item.DCNo</td>
                                                            break;


                                                        case "DCDate":
                                                            <td>@rc.item.DCDate</td>
                                                            break;


                                                        case "InvNo":
                                                            <td>@rc.item.InvNo</td>
                                                            break;


                                                        case "InvDate":
                                                            <td>@rc.item.InvDate</td>
                                                            break;
                                                    }

                                                }


                                                <!-- Fixed Action Column -->

                                                @* <td class="sticky-action text-center"> *@
                                                        <td class="text-center"
                                                            style="position:sticky;right:0;background:white;z-index:5;">
                                                    <button class="btn btn-sm btn-primary"
                                                            @onclick="() => ToggleDetails(rc.item.RCId, rc.item.RCNo)">

                                                        @(expandedId == rc.item.RCId ? "Hide Details" : "View Details")

                                                    </button>

                                                </td>


                                            </tr>
                                        }
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <!-- PAGINATION -->
                    <div class="pagination-fixed bg-white shadow-sm py-2 border-top">

                        <div class="d-flex align-items-center justify-content-between px-3 flex-wrap gap-2">

                            <!-- LEFT -->

                            <div class="fw-semibold text-muted">

                                Showing @startRecord to @endRecord
                                        of @Filtered_RC_Analysis_Data.Count entries

                            </div>

                            <!-- RIGHT -->

                            @* <div class="d-flex align-items-center gap-2"> *@
                                    <div class="d-flex align-items-center gap-2 ms-auto">
                                <button class="btn btn-outline-primary btn-sm"
                                        title="First Page"
                                        @onclick="FirstPage"
                                        disabled="@(currentPage == 1)">

                                    <i class="bi bi-skip-backward-fill"></i>

                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        title="Previous Page"
                                        @onclick="PreviousPage"
                                        disabled="@(currentPage == 1)">

                                    <i class="bi bi-arrow-left-circle"></i>

                                </button>

                                <span class="px-2 fw-semibold">

                                    Page @currentPage of @totalPages

                                </span>

                                <button class="btn btn-outline-primary btn-sm"
                                        title="Next Page"
                                        @onclick="NextPage"
                                        disabled="@(currentPage >= totalPages)">

                                    <i class="bi bi-arrow-right-circle"></i>

                                </button>

                                <button class="btn btn-outline-primary btn-sm"
                                        title="Last Page"
                                        @onclick="LastPage"
                                        disabled="@(currentPage >= totalPages)">

                                    <i class="bi bi-skip-forward-fill"></i>

                                </button>

                            </div>

                        </div>

                    </div>

                 </div>
             </div>

               
             }
            

                @if (RC_Analysis_Details.Any() && expandedId != null)
                {
                    <div class="col-12 mb-2">
                        <div class="route-details-card mt-3">

