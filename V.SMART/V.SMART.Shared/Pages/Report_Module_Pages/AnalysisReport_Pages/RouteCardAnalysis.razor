    private async Task SelectCustomer(int? custId)
    {
        selectedCustomerId = custId ?? 0;


        if (selectedCustomerId == -1)
        {
            customerSearch = "Manual";
        }
        else
        {
            var custName = customers
                .Where(x => x.CustId == selectedCustomerId)
                .Select(x => x.CustName)
                .FirstOrDefault();


            if (string.IsNullOrEmpty(custName))
            {
                custName = RC_Analysis_Data
                    .Where(x => x.CustId == selectedCustomerId)
                    .Select(x => x.Customer)
                    .FirstOrDefault();
            }


            customerSearch = custName ?? "All";
        }


        showCustomerList = false;


        // remove route card filter
        selectedRouteCardId = 0;


        await OnCustomerChanged();

        StateHasChanged();
    }


    private void ShowRCList()
    {
        showRCList = true;
    }

    private async Task SelectRouteCard(int rcId)
    {
        selectedRouteCardId = rcId;

        var rc = RC_Analysis_Data
            .FirstOrDefault(x => x.RCId == rcId);

        RCSearch = rc?.RCNo ?? "All";


        if (rc != null)
        {
            if (rc.IsManual)
            {
                selectedCustomerId = -1;
                customerSearch = "Manual";
            }
            else
            {
                selectedCustomerId = rc.CustId ?? 0;


                var custName = customers
                    .Where(x => x.CustId == selectedCustomerId)
                    .Select(x => x.CustName)
                    .FirstOrDefault();


                if (string.IsNullOrEmpty(custName))
                {
                    custName = RC_Analysis_Data
                        .Where(x => x.CustId == selectedCustomerId)
                        .Select(x => x.Customer)
                        .FirstOrDefault();
                }


                customerSearch = custName ?? "All";
            }
        }
        else
        {
            selectedCustomerId = 0;
            customerSearch = "All";
        }


        showRCList = false;

        await ApplyFilters();

        StateHasChanged();
    }

