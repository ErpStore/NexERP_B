                                    <i class="bi bi-card-list me-2"></i>
                                    Route Card Details - @SelectedRCNo
                                </div>

                                

                                <div class="d-flex gap-2 flex-wrap">

                                    @* <span class="summary-badge process"> *@
                                    <span class="px-3 py-2 rounded"
                                          style="background:#dbeafe;color:#1d4ed8;font-size:13px;font-weight:600;">
                                        Total Process: @RC_Analysis_Details.Count()
                                    </span>

                                    @* <span class="summary-badge completed"> *@
                                    <span class="px-3 py-2 rounded"
                                          style="background:#dcfce7;color:#15803d;font-size:13px;font-weight:600;">
                                        Completed:
                                        @RC_Analysis_Details.Count(x => x.ProcessStatus == 3)
                                    </span>

                                    @* <span class="summary-badge pending"> *@
                                    <span class="px-3 py-2 rounded"
                                          style="background:#ffedd5;color:#ea580c;font-size:13px;font-weight:600;">
                                        Pending:
                                        @RC_Analysis_Details.Count(x => x.ProcessStatus != 3)
                                    </span>

                                </div>

                            </div>

                            <div class="table-responsive">

                                <table class="table table-bordered table-sm align-middle mb-0">

                                    <thead class="custom-blue">

                                        <tr>
                                            <th>SlNo</th>
                                            <th>Sequence No.</th>
                                            <th>Process Name</th>
                                            <th>Trans Type</th>
                                            <th>Total Qty</th>
                                            <th>Issued Qty</th>
                                            <th>Acc Qty</th>
                                            <th>Rej Qty</th>
                                            <th>Rew Qty</th>
                                            <th>Issue No.</th>
                                            <th>GRN No.</th>
                                            <th>SCN No.</th>
                                            <th>Status</th>
                                        </tr>


                                    </thead>

                                    <tbody>

                                        @foreach (var process in RC_Analysis_Details)
                                        {
                                            <tr>

                                                <td>@process.SlNo</td>

                                                <td>@process.SeqNo</td>

                                                <td>@process.ProcessName</td>

                                                <td>@process.TransType</td>

                                                <td>@process.TotalQty</td>

                                                <td>@process.IssuedQty</td>

                                                <td>@process.AccQty</td>

                                                <td>@process.RejQty</td>

                                                <td>@process.RewQty</td>

                                                <td>@process.IssueNo</td>

                                                <td>@process.GRNNo</td>

                                                <td>@process.SCNNo</td>


                                                <td>
                                                    @switch (process.ProcessStatus)
                                                    {
                                                        case 0:
                                                            <span class="badge text-bg-warning px-3 py-1">
                                                                <i class="bi bi-clock-fill"></i> Pending
                                                            </span>
                                                            break;

                                                        case 1:
                                                            <span class="badge text-bg-primary px-3 py-1">
                                                                <i class="bi bi-hourglass-split"></i> In Progress
                                                            </span>
                                                            break;

                                                        case 2:
                                                            <span class="badge text-bg-info px-3 py-1">
                                                                <i class="bi bi-arrow-repeat"></i> Partial
                                                            </span>
                                                            break;

                                                        default:
                                                            <span class="badge text-bg-success px-3 py-1">
                                                                <i class="bi bi-check-circle-fill"></i> Completed
                                                            </span>
                                                            break;
                                                    }
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                            @* <div class="details-footer"> *@
                            <div class="d-flex justify-content-end align-items-center gap-3 p-3"
                                 style="border-top:1px solid #d6e4ff;background:#f8fbff;margin-top:0;">

                                <button class="btn btn-success"
                                        @onclick="HandleExportRCDetails">
                                    <i class="bi bi-printer"></i>
                                    Print Details
                                </button>

                                <button class="btn btn-danger"
                                        @onclick="() => expandedId = null">
                                    Close Details
                                </button>

                            </div>

                        </div>

                    </div>
                }
                
