                                <select class="form-select"
                                        value="SelectedItemCode"
                                        @onchange="OnItemChanged">

                                    <option value="">Select Item</option>

                                    @if (ItemList != null && ItemList.Any())
                                    {
                                        @foreach (var item in ItemList)
