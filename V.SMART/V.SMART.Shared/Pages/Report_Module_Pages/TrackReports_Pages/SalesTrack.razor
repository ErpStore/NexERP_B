                            (x.QtDate.HasValue && x.QtDate.Value >= FromDate.Value) ||
                            (x.RouteCardDate.HasValue && x.RouteCardDate.Value >= FromDate.Value) ||
                            (x.JobOrderDate.HasValue && x.JobOrderDate.Value >= FromDate.Value) ||
                            (x.InvoiceDate.HasValue && x.InvoiceDate.Value >= FromDate.Value)
                        )
                    )
                    &&
                    (
                        !ToDate.HasValue ||
                        (
                            (x.PODate.HasValue && x.PODate.Value <= ToDate.Value) ||
                            (x.DcDate.HasValue && x.DcDate.Value <= ToDate.Value) ||
                            (x.MreqDate.HasValue && x.MreqDate.Value <= ToDate.Value) ||
                            (x.EnqDate.HasValue && x.EnqDate.Value <= ToDate.Value) ||
                            (x.QtDate.HasValue && x.QtDate.Value <= ToDate.Value) ||
                            (x.RouteCardDate.HasValue && x.RouteCardDate.Value <= ToDate.Value) ||
                            (x.JobOrderDate.HasValue && x.JobOrderDate.Value <= ToDate.Value) ||
                            (x.InvoiceDate.HasValue && x.InvoiceDate.Value <= ToDate.Value)
                        )
                    )
                )
                .ToList();

            CurrentMode = GridMode.Item;
        }

        StateHasChanged();
    }



    private int GetIdByType(SalesTrackVM doc)
    {
        return SelectedDocType switch
        {
            "PO" => doc.PoId ?? 0,
            "DC" => doc.DcId ?? 0,
            "MaterialReq" => doc.MreqId ?? 0,
            "Invoice" => doc.InvId ?? 0,
            "Enquiry" => doc.EnquiryId ?? 0,
            "Quotation" => doc.QuoteId ?? 0,
            "RouteCard" => doc.RCId ?? 0,
            "JobOrder" => doc.JobId ?? 0,
            _ => doc.PoId ?? 0
        };
    }

    private IEnumerable<SalesTrackVM> FilteredPoPendingVMs
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText) || searchText.Length < 3)
                return SalesTrackVMs;

            return SalesTrackVMs.Where(x =>
                (x.CustName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.Itemcode ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.ItemName ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.EnqNo ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.QtNo ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.PONo ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.JobOrderNo ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.RouteCardNo ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.MReqNo ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.DcNo ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.InvNo ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase)
            );
        }
    }

