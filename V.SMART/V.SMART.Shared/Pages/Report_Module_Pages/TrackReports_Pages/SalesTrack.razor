    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }



            await InitializeColumns(IsHidden);

            UserName = await CurrentUserService.GetUsernameAsync();




            allDocs = await SalesTrackReportService.ExportDataAsync(FromDate, ToDate, SelectedCustomerId);
           
           

            // Ensure SalesTrackVMs has data before filtering
            SalesTrackVMs = allDocs?.ToList() ?? new List<SalesTrackVM>();

            // Load customer list only for customers having
            // PO / DC / Invoice / Enquiry / Quotation / MaterialReq / RC / Job
            var allList = SalesTrackVMs
                .Where(x =>
                    x.CustId != null &&
                    (
                        x.PoId != null ||
                        x.DcId != null ||
                        x.InvId != null ||
                        x.EnquiryId != null ||
                        x.QuoteId != null ||
                        x.MreqId != null ||
                        x.RCId != null ||
                        x.JobId != null
                    ))
                .GroupBy(x => x.CustId)
                .Select(g => new CustomerVM
                {
                    CustId = g.Key ?? 0,
                    CustName = g.First().CustName
                })
                .OrderBy(x => x.CustName)
                .Take(50)
                .ToList();

            // Always insert "All" option at top
            allList.Insert(0, AllCustomer);

            CustomerList = allList;

           


            totalInvoiceValue = await SalesTrackReportService
            .GetTotalInvoiceValue(FromDate, ToDate, SelectedCustomerId);

            PoList = SalesTrackReportService.GetPendingPo(allDocs, SelectedDocType);





        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in PoReport Init");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }





    private async Task OnCustomerChanged(CustomerVM? customer)
    {

        SelectedCustomer = customer;


        bool IsInRange(DateTime? date) =>
        (!FromDate.HasValue || (date.HasValue && date.Value.Date >= FromDate.Value.Date)) &&
        (!ToDate.HasValue || (date.HasValue && date.Value.Date <= ToDate.Value.Date));

        // Reset if "All" or null
        if (SelectedCustomer == null || SelectedCustomer.CustId == 0)
        {
            var allFiltered = allDocs
                   .Where(x =>
                         IsInRange(x.PODate) ||
                         IsInRange(x.DcDate) ||
                         IsInRange(x.EnqDate) ||
                         IsInRange(x.QtDate) ||
                         IsInRange(x.RouteCardDate) ||
                         IsInRange(x.MreqDate) ||
                         IsInRange(x.JobOrderDate) ||
                         IsInRange(x.InvoiceDate)

                   )
                   .ToList();

            SalesTrackVMs = allFiltered;
            FilteredList = allFiltered;

            // Get single customer id (example: first customer)
            SelectedCustomerId = SalesTrackVMs
                .Select(x => x.CustId)
                .FirstOrDefault();

            totalInvoiceValue = await SalesTrackReportService
           .GetTotalInvoiceValue(FromDate, ToDate, SelectedCustomerId);




            // ✅ Update doc types for all customers
            AvailableDocTypes = SalesTrackReportService.GetCustomerDocTypes(allFiltered);

            CurrentMode = GridMode.Customer;

            StateHasChanged(); // refresh UI
        }
        else
        {
            var filterCustomer = allDocs
           .Where(x => x.CustId == SelectedCustomer.CustId &&
            (
            IsInRange(x.PODate) ||
            IsInRange(x.DcDate) ||
            IsInRange(x.EnqDate) ||
            IsInRange(x.QtDate) ||
            IsInRange(x.RouteCardDate) ||
            IsInRange(x.MreqDate) ||
            IsInRange(x.JobOrderDate) ||
            IsInRange(x.InvoiceDate)
            ))
           .ToList();

            // ✅ Load grid data
            SalesTrackVMs = filterCustomer;

            // Get single customer id (example: first customer)
            SelectedCustomerId = SalesTrackVMs
                .Select(x => x.CustId)
                .FirstOrDefault();

            totalInvoiceValue = await SalesTrackReportService
           .GetTotalInvoiceValue(FromDate, ToDate, SelectedCustomerId);

            // ✅ Store for next filters
            FilteredList = filterCustomer.ToList();

            // Doc types
            AvailableDocTypes = SalesTrackReportService.GetCustomerDocTypes(filterCustomer, FromDate, ToDate);

            CurrentMode = GridMode.Customer;

            StateHasChanged(); // 🔥 REQUIRED
        }
    }


    
    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        try
        {
            bool IsInRange(DateTime? date) =>
                (!FromDate.HasValue || (date.HasValue && date.Value.Date >= FromDate.Value.Date)) &&
                (!ToDate.HasValue || (date.HasValue && date.Value.Date <= ToDate.Value.Date));

            // Base filter → only customers having records within date range
            var filteredDocs = allDocs?
                .Where(x =>
                    IsInRange(x.PODate) ||
                    IsInRange(x.DcDate) ||
                    IsInRange(x.EnqDate) ||
                    IsInRange(x.QtDate) ||
                    IsInRange(x.RouteCardDate) ||
                    IsInRange(x.MreqDate) ||
                    IsInRange(x.JobOrderDate) ||
                    IsInRange(x.InvoiceDate))
                .ToList() ?? new List<SalesTrackVM>();


            // If clicked without typing → load all customers within date range
            if (string.IsNullOrWhiteSpace(value))
            {
                var allList = filteredDocs
                    .Where(x =>
                        x.CustId != null &&
                        (
                            x.EnquiryId != null ||
                            x.QuoteId != null ||
                            x.PoId != null ||
                            x.MreqId != null ||
                            x.RCId != null ||
                            x.JobId != null ||
                            x.DcId != null ||
                            x.InvId != null
                        ))
                    .GroupBy(x => x.CustId)
                    .Select(g => new CustomerVM
                    {
                        CustId = g.Key ?? 0,
                        CustName = g.First().CustName
                    })
                    .OrderBy(x => x.CustName)
                    .Take(50)
                    .ToList();

                // Always insert All at top
                allList.Insert(0, AllCustomer);

                return allList;
            }

            // Search while typing
            var results = await SalesTrackReportService.SearchCustomersAsync(value);

            var list = results?
                .Where(c => filteredDocs.Any(x =>
                    x.CustId == c.CustId &&
                    (
                        x.EnquiryId != null ||
                        x.QuoteId != null ||
                        x.PoId != null ||
                        x.MreqId != null ||
                        x.RCId != null ||
                        x.JobId != null ||
                        x.DcId != null ||
                        x.InvId != null
                    )))
                .OrderBy(x => x.CustName)
                .Take(50)
                .ToList() ?? new List<CustomerVM>();

            // Always insert All at top
            list.Insert(0, AllCustomer);

            return list;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, $"Customer search failed: {value}");
            await _JS.ToastrError("Customer search failed");

            return Enumerable.Empty<CustomerVM>();
        }
    }

    private async Task OnDocTypeChanged(ChangeEventArgs e)
    {
        try
        {
            SelectedDocType = e.Value?.ToString();

            // Reset dependent selections
            SelectedPoId = null;
            SelectedItemCode = null;
            ItemList = new List<SalesTrackVM>();

            // Current source → customer filtered data first
            var source = FilteredList?.Any() == true
                ? FilteredList
                : allDocs;

            bool IsInRange(DateTime? date) =>
                (!FromDate.HasValue || (date.HasValue && date.Value.Date >= FromDate.Value.Date)) &&
                (!ToDate.HasValue || (date.HasValue && date.Value.Date <= ToDate.Value.Date));

            // Reset when DocType is empty
            if (string.IsNullOrWhiteSpace(SelectedDocType))
            {
                var allFiltered = source
                    .Where(x =>
                        IsInRange(x.PODate) ||
                        IsInRange(x.DcDate) ||
                        IsInRange(x.EnqDate) ||
                        IsInRange(x.QtDate) ||
                        IsInRange(x.RouteCardDate) ||
                        IsInRange(x.MreqDate) ||
                        IsInRange(x.JobOrderDate) ||
                        IsInRange(x.InvoiceDate))
                    .ToList();

                SalesTrackVMs = allFiltered;
                FilteredList = allFiltered;

                CurrentMode = GridMode.Customer;
                StateHasChanged();
                return;
            }

            // Filter by selected document type + corresponding date field
            SalesTrackVMs = SelectedDocType switch
            {
                "PO" => source
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.PONo) &&
                        IsInRange(x.PODate))
                    .OrderBy(x => x.PONo)
                    .ToList(),

                "DC" => source
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.DcNo) &&
                        IsInRange(x.DcDate))
                    .OrderBy(x => x.DcNo)
                    .ToList(),

                "Enquiry" => source
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.EnqNo) &&
                        IsInRange(x.EnqDate))
                    .OrderBy(x => x.EnqNo)
                    .ToList(),

                "Quotation" => source
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.QtNo) &&
                        IsInRange(x.QtDate))
                    .OrderBy(x => x.QtNo)
                    .ToList(),

                "Route Card" => source
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.RouteCardNo) &&
                        IsInRange(x.RouteCardDate))
                    .OrderBy(x => x.RouteCardNo)
                    .ToList(),

                "Material Req" => source
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.MReqNo) &&
                        IsInRange(x.MreqDate))
                    .OrderBy(x => x.MReqNo)
                    .ToList(),

                "Job Order" => source
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.JobOrderNo) &&
                        IsInRange(x.JobOrderDate))
                    .OrderBy(x => x.JobOrderNo)
                    .ToList(),

                "Invoice" => source
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.InvNo) &&
                        IsInRange(x.InvoiceDate))
                    .OrderBy(x => x.InvNo)
                    .ToList(),

                _ => source.ToList()
            };

            // Maintain same flow
            FilteredList = SalesTrackVMs.ToList();

            CurrentMode = GridMode.Customer;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnDocTypeChanged");
            await _JS.ToastrError("Failed to process document type.");
        }
    }



    private void OnPoChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int value) && FilteredList != null)
        {
            SelectedPoId = value;
            CurrentMode = GridMode.Po;

            // ✅ Dynamic filtering based on docType
            SalesTrackVMs = SelectedDocType switch
            {
                "Enquiry" => FilteredList.Where(x => x.EnquiryId == value).ToList(),
                "Quotation" => FilteredList.Where(x => x.QuoteId == value).ToList(),
                "PO" => FilteredList.Where(x => x.PoId == value).ToList(),
                "MaterialReq" => FilteredList.Where(x => x.MreqId == value).ToList(),
                "DC" => FilteredList.Where(x => x.DcId == value).ToList(),
                "Invoice" => FilteredList.Where(x => x.InvId == value).ToList(),
                "RouteCard" => FilteredList.Where(x => x.RCId == value).ToList(),
                "JobOrder" => FilteredList.Where(x => x.JobId == value).ToList(),
                _ => new List<SalesTrackVM>()
            };

            // Load items
            ItemList = SalesTrackReportService.GetItemsByPoId(FilteredList, SelectedDocType, value);

            SelectedItemCode = null;
        }
        else
        {
            SelectedPoId = null;
            SelectedItemCode = null;
            SalesTrackVMs = FilteredList?.ToList();
            CurrentMode = GridMode.Customer;
        }

        StateHasChanged();
    }





    private void OnItemChanged(ChangeEventArgs e)
    {
        SelectedItemCode = e.Value?.ToString();
        var source = SalesTrackVMs ?? new List<SalesTrackVM>();

        if (!string.IsNullOrEmpty(SelectedItemCode))
        {
            CurrentMode = GridMode.Item;

            SalesTrackVMs = SalesTrackReportService
                .GetItemsByItemCode(FilteredList, SelectedItemCode);
        }
        else
        {
            // PoPendingVMs = FilteredList.ToList();
            SalesTrackVMs = ApplyFilters(source);
        }

        StateHasChanged(); // 🔥 REQUIRED
    }

       

    private List<SalesTrackVM> ApplyFilters(List<SalesTrackVM> source)
    {
        return source
            .Where(x =>
                (string.IsNullOrEmpty(SelectedDocType) || MatchDocType(x)) &&
               (string.IsNullOrEmpty(SelectedPo) || GetDocNo(x) == SelectedPo) &&
                (string.IsNullOrEmpty(SelectedItemCode) || x.Itemcode == SelectedItemCode)
            )
            .ToList();
    }

    private string GetDocNo(SalesTrackVM x)
    {
        return SelectedDocType switch
        {
            "Enquiry" => x.EnqNo,
            "Quotation" => x.QtNo,
            "PO" => x.PONo,
            "MaterialReq" => x.MReqNo,
            "JobOrder" => x.JobOrderNo,
            "RouteCard" => x.RouteCardNo,
            "DC" => x.DcNo,
            "Invoice" => x.InvNo,
            _ => null
        };
    }
    private bool MatchDocType(SalesTrackVM x)
    {
        return SelectedDocType switch
        {
            "Enquiry" => !string.IsNullOrEmpty(x.EnqNo),
            "Quotation" => !string.IsNullOrEmpty(x.QtNo),
            "PO" => !string.IsNullOrEmpty(x.PONo),
            "MaterialReq" => !string.IsNullOrEmpty(x.MReqNo),
            "JobOrder" => !string.IsNullOrEmpty(x.JobOrderNo),
            "RouteCard" => !string.IsNullOrEmpty(x.RouteCardNo),
            "DC" => !string.IsNullOrEmpty(x.DcNo),
            "Invoice" => !string.IsNullOrEmpty(x.InvNo),
            _ => true
        };
