    private async Task LoadAllData()
    {
        try
        {
            isProcessing = true;

            // Today's date
         //   ToDate = DateTime.Today;

            // One month back from today
          //  FromDate = DateTime.Today.AddMonths(-1);




            // AllData = await PopendingService.ExportDataAsync();
           // AllData = await PopendingService.ExportDataAsync((DateTime?)null, (DateTime?)null, (int?)null);
            allDocs = await SalesTrackReportService.ExportDataAsync(FromDate, ToDate, SelectedCustomerId);
            SalesTrackVMs = allDocs.ToList();
            PendingList = allDocs.ToList();

            // Set the grid mode to full (or Customer, depending on UI)
            CurrentMode = GridMode.Full;

           
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading PO Pending");
            await _JS.ToastrError("Failed to load data.");
        }
        finally
        {
            isProcessing = false;
        }
    }





