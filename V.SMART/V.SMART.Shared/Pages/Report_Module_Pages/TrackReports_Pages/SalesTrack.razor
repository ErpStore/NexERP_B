                                <input class="form-check-input custom-checkbox"
                                       type="checkbox"
                                       id="detailViewCheck"
                                       @bind="IsDetailView"
                                       @onclick="OnDetailViewChanged" />

                                <label class="form-check-label ms-2"
                                       for="detailViewCheck">
                                    Detail View
                                </label>
                            </div>
                        </div>

                        <style>
                            .custom-checkbox {
                                width: 18px;
                                height: 18px;
                                cursor: pointer;
                                accent-color: blue; /* ✅ Checkbox color blue */
                            }
                        </style>


                       

