                                            @* <option value="">Select Item</option> *@
                                            <option value="@item.Itemcode">@item.Itemcode</option>
                                        }
                                    }
                                   @*  else
                                    {
                                        <option value="">Select Item</option>                                        
                                    } *@

                                </select>
