    private async Task<IEnumerable<LabourTrackSummaryVM>> SearchItems(string value, CancellationToken token)
    {
        try
        {
            CurrentMode = GridMode.Item;

            // Base source → only records having PO / DC / GRN / SCN / Invoice
            var source = ItemList ?? new List<LabourTrackSummaryVM>();

            // Click without typing → load items based on PO/DC/GRN/SCN/Invoice only
            if (string.IsNullOrWhiteSpace(value))
            {
                return source
                    .Where(x =>
                        !string.IsNullOrWhiteSpace(x.ItemCode) &&
                        (
                            x.PoId != null ||   // PO
                            x.DCId != null ||   // DC
                            x.GRNId != null ||  // GRN
                            x.SCNId != null ||  // SCN
                            x.InvId != null     // Invoice
                        ))
                    .GroupBy(x => x.ItemCode)
                    .Select(g => new LabourTrackSummaryVM
                    {
                        ItemId = g.First().ItemId,
                        ItemCode = g.First().ItemCode,
                        ItemName = g.First().ItemName
                    })
                    .OrderBy(x => x.ItemCode)
                    .Take(50)
                    .ToList();
            }

            // Search while typing
            var results = await labourTrackReportService.SearchItemsAsync(value);

            return results?
                .Where(c => source.Any(x =>
                    x.ItemCode == c.ItemCode &&
                    (
                        x.PoId != null ||
                        x.DCId != null ||
                        x.GRNId != null ||
                        x.SCNId != null ||
                        x.InvId != null
                    )))
                .GroupBy(x => x.ItemCode)
                .Select(g => new LabourTrackSummaryVM
                {
                    ItemId = g.First().ItemId,
                    ItemCode = g.First().ItemCode,
                    ItemName = g.First().ItemName
                })
                .OrderBy(x => x.ItemCode)
                .Take(50)
                .ToList()
                ?? Enumerable.Empty<LabourTrackSummaryVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                $"Item search failed: {value}"
            );

            return Enumerable.Empty<LabourTrackSummaryVM>();
        }
    }


     
