                            <option value="">-- Select Number --</option>

                            @if (FilteredList?.Any() == true)
                            {
                                @foreach (var doc in FilteredList
                                                        .Where(x => !string.IsNullOrEmpty(GetNumberByType(x)))
                                                        .GroupBy(x => GetNumberByType(x))
                                                        .Select(g => g.First()))
                                {
                                    <option value="@GetIdByType(doc)">
                                        @GetNumberByType(doc)
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    


 



                    

                    <div class="col-md-2">
