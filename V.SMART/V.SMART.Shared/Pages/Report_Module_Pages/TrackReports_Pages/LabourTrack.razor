    private async Task OnCustomerChanged(CustomerVM? customer)
    {
        try
        {
            SelectedCustomer = customer;

            DocumentNumbers.Clear();
            SelectedDocNo = null;
            SelectedItem = null;

            // ✅ Common Date Filter
            bool IsInRange(DateTime? date) =>
                (!FromDate.HasValue || (date.HasValue && date.Value.Date >= FromDate.Value.Date)) &&
                (!ToDate.HasValue || (date.HasValue && date.Value.Date <= ToDate.Value.Date));

            // ✅ Reset (All customers)
            if (SelectedCustomer == null || SelectedCustomer.CustId == 0)
             {
            //     LabourTrackSummaryVMs = AllData.ToList();

                var allFiltered = AllData
                    .Where(x =>
                        IsInRange(x.PODate) ||
                        IsInRange(x.DCDate) ||
                        IsInRange(x.GRNDate) ||
                        IsInRange(x.SCNDate) ||
                        IsInRange(x.InvDate)
                    )
                    .ToList();

                LabourTrackSummaryVMs = allFiltered;
                FilteredList = allFiltered;
                //FilteredList = AllData.ToList();

                AvailableDocTypes = labourTrackReportService
                    .GetCustomerDocTypes(AllData, FromDate, ToDate);

                CurrentMode = GridMode.Customer;
                StateHasChanged();
                return;
            }
            
            // Get single customer id (example: first customer)
            SelectedCustomerId = LabourTrackSummaryVMs
                .Select(x => x.CustId)
                .FirstOrDefault();

            totalInvoiceValue = await labourTrackReportService
           .GetTotalInvoiceValue(FromDate, ToDate,SelectedCustomerId);

            // // ✅ Filter locally (NO API CALL)
            // var data = AllData
            //     .Where(x => x.CustId == SelectedCustomer.CustId)
            //     .ToList();



            var filterCustomer = AllData
           .Where(x => x.CustId == SelectedCustomer.CustId &&
            (
            IsInRange(x.PODate) ||
            IsInRange(x.DCDate) ||
            IsInRange(x.GRNDate) ||
            IsInRange(x.SCNDate) ||
            IsInRange(x.InvDate) 
            ))
           .ToList();

            LabourTrackSummaryVMs = filterCustomer;
            FilteredList = filterCustomer;

            // ✅ DocTypes from filtered data
            AvailableDocTypes = labourTrackReportService
                .GetCustomerDocTypes(filterCustomer, FromDate, ToDate);

            CurrentMode = GridMode.Customer;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnCustomerChanged");
            await _JS.ToastrError("Failed to load data for selected customer.");
        }
    }
