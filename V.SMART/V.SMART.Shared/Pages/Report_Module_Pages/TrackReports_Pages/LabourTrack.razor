    private async Task OnItemChanged(LabourTrackSummaryVM? item)
    {
        try
        {
            SelectedItem = item;
            SelectedItemCode = item?.ItemCode;

            // Source comes from PO mode data
            var source = LabourTrackSummaryVMs ?? new List<LabourTrackSummaryVM>();

            // First click on Item dropdown (without selecting item)
            // → load only records having PO / DC / GRN / SCN / Invoice
            if (item == null || string.IsNullOrWhiteSpace(SelectedItemCode))
            {
                CurrentMode = GridMode.Item;

                LabourTrackSummaryVMs = source
                    .Where(x =>
                        x.PoId != null ||   // PO
                        x.DCId != null ||   // DC
                        x.GRNId != null ||  // GRN
                        x.SCNId != null ||  // SCN
                        x.InvId != null     // Invoice
                    )
                    .ToList();

                StateHasChanged();
                return;
            }

            // After selecting specific item
            // → filter by ItemCode + PO/DC/GRN/SCN/Invoice
            CurrentMode = GridMode.Item;

            LabourTrackSummaryVMs = source
                .Where(x =>
                    x.ItemCode == SelectedItemCode &&
                    (
                        x.PoId != null ||
                        x.DCId != null ||
                        x.GRNId != null ||
                        x.SCNId != null ||
                        x.InvId != null
                    ))
                .ToList();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "Error in OnItemChanged"
            );

            await _JS.ToastrError("Failed to filter items.");
        }
    }

    private List<LabourTrackSummaryVM> ApplyFilters(List<LabourTrackSummaryVM> source)
    {
        return source
            .Where(x =>
                (string.IsNullOrEmpty(SelectedDocType) || MatchDocType(x)) &&
                (string.IsNullOrEmpty(SelectedDocNo) || GetDocNo(x) == SelectedDocNo) &&
                (string.IsNullOrEmpty(SelectedItemCode) || x.ItemCode == SelectedItemCode)
            )
            .ToList();
    }

    private string GetDocNo(LabourTrackSummaryVM x)
    {
        return SelectedDocType switch
        {
            "Labour DC" => x.DCNo,
            "Labour GRN" => x.GRNNo,
            "Labour SCN" => x.SCNNo,
            "Labour PO" => x.PONo,
            "Labour Invoice" => x.InvNo,
            _ => null
        };
    }
    private bool MatchDocType(LabourTrackSummaryVM x)
    {
        return SelectedDocType switch
        {
            "Labour DC" => !string.IsNullOrEmpty(x.DCNo),
            "Labour GRN" => !string.IsNullOrEmpty(x.GRNNo),
            "Labour SCN" => !string.IsNullOrEmpty(x.SCNNo),
            "Labour PO" => !string.IsNullOrEmpty(x.PONo),
            "Labour Invoice" => !string.IsNullOrEmpty(x.InvNo),
            _ => true
        };
    }

