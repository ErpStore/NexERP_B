    private async Task OnDocTypeChanged(ChangeEventArgs e)
    {
        try
        {
            SelectedDocType = e.Value?.ToString();

            SelectedDocNo = null;
            SelectedItem = null;

            // Source data should be current filtered list (customer-based)
            var source = FilteredList?.Any() == true
                ? FilteredList
                : TempLabourTrackSummaryVMs;

            // Reset if empty
            if (string.IsNullOrEmpty(SelectedDocType))
            {
                LabourTrackSummaryVMs = source.ToList();
                DocumentNumbers.Clear();
                StateHasChanged();
                return;
            }

            // Filter by DocType + corresponding Date field
            LabourTrackSummaryVMs = SelectedDocType switch
            {
                "Labour PO" => source
                    .Where(x =>
                        !string.IsNullOrEmpty(x.PONo) &&
                        (!FromDate.HasValue || x.PODate >= FromDate.Value) &&
                        (!ToDate.HasValue || x.PODate <= ToDate.Value))
                    .ToList(),

                "Labour DC" => source
                    .Where(x =>
                        !string.IsNullOrEmpty(x.DCNo) &&
                        (!FromDate.HasValue || x.DCDate >= FromDate.Value) &&
                        (!ToDate.HasValue || x.DCDate <= ToDate.Value))
                    .ToList(),

                "Labour GRN" => source
                    .Where(x =>
                        !string.IsNullOrEmpty(x.GRNNo) &&
                        (!FromDate.HasValue || x.GRNDate >= FromDate.Value) &&
                        (!ToDate.HasValue || x.GRNDate <= ToDate.Value))
                    .ToList(),

                "Labour SCN" => source
                    .Where(x =>
                        !string.IsNullOrEmpty(x.SCNNo) &&
                        (!FromDate.HasValue || x.SCNDate >= FromDate.Value) &&
                        (!ToDate.HasValue || x.SCNDate <= ToDate.Value))
                    .ToList(),

                "Labour Invoice" => source
                    .Where(x =>
                        !string.IsNullOrEmpty(x.InvNo) &&
                        (!FromDate.HasValue || x.InvDate >= FromDate.Value) &&
                        (!ToDate.HasValue || x.InvDate <= ToDate.Value))
                    .ToList(),

                _ => source.ToList()
            };

            // Load document numbers from filtered data
            DocumentNumbers = await labourTrackReportService
                .GetDocumentNumbersAsync(
                    LabourTrackSummaryVMs,
                    SelectedDocType,
                    FromDate,
                    ToDate);

            CurrentMode = GridMode.Customer;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnDocTypeChanged");
            await _JS.ToastrError("Failed to process document type.");
        }
    }


