@page "/labourTrack"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.ITrackReportService
@using V.SMART.Shared.ViewModels.ReportViewModel.TrakReportsViewModel.LabourTrackViewModel

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject ILabourTrackReportService labourTrackReportService
@inject IExcelTemplateService excelTemplateService



@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="Sales Quotation List"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@LabTrackBreadcrumbs" />






            <!-- FILTER SECTION -->
            <div class="bg-white rounded-3 shadow-sm p-3 p-md-4">


                <!-- ================= Export Section ================= -->
                <div class="card border mb-4">
                    @* <div class="card-header bg-light"> *@
                    <div class="card-header" style="background-color:#f5e6d3;">
                        <strong>Export Details</strong>
                    </div>

                    <div class="card-body">
                        <div class="row g-3 align-items-end">

                            <div class="col-md-3">
                                <label class="form-label">From Date</label>
                                <input type="date" class="form-control" @bind="FromDate" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">To Date</label>
                                <input type="date" class="form-control" @bind="ToDate" />
                            </div>

                        

                            <div class="col-md-3">
                                <button class="btn btn-success w-75"
                                        style="background-color: #4da3ff; color: white;"
                                        @onclick="ExportRCData">
                                    <i class="bi bi-download me-1"></i>
                                    Load SalesTrack Data
                                </button>
                            </div>


                        


                        </div>
                    </div>
                </div>




                <div class="row g-3 align-items-end">

                    <div class="card-header d-flex justify-content-between align-items-center" style="background-color:#f5e6d3;">
                         <strong>Filter By Customer</strong>


                        <div class="col-md-1"></div> <!-- SPACE -->

                        <div class="col-md-2 d-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input custom-checkbox"
                                       type="checkbox"
                                       id="detailViewCheck"
                                       @bind="IsDetailView"
                                       @onclick="OnDetailViewChanged" />

                                <label class="form-check-label ms-2"
                                       for="detailViewCheck">
                                    Detail View
                                </label>
                            </div>
                        </div>

                        <style>
                            .custom-checkbox {
                                width: 18px;
                                height: 18px;
                                cursor: pointer;
                                accent-color: blue; /* ✅ Checkbox color blue */
                            }
                        </style>



                        <div class="d-flex align-items-center gap-2">
                            <span class="input-group-text">
                                <i class="bi bi-search"></i>
                            </span>

                            <InputText type="text"
                                       class="form-control"
                                       style="max-width: 1000px; border: 1px solid #0d6efd; outline: none;"
                                       placeholder="Min 3 letters..."
                                       @bind-Value="searchText"
                                       @oninput="e => searchText = e.Value?.ToString()"
                                       onfocus="this.style.boxShadow='0 0 0 0.2rem rgba(13,110,253,.25)'"
                                       onblur="this.style.boxShadow='none'" />
                        </div>


                        <!-- Column Settings -->
                        <div class="col-6 col-md-2">
                            <ColumnMenu Columns="Columns"
                                        ScreenName="@ScreenName"
                                        UserId="@UserName"
                                        MaxVisible=int.MaxValue
                                        OnChanged="HandleColumnChange" />
                        </div>

                    </div>
                    

                    <!-- Customer -->
                    <div class="col-md-2">
                        <label class="mb-1">
                            <i class="bi bi-person"></i> Customer
                        </label>

                        <MudBlazor.MudAutocomplete T="CustomerVM"
                                                   Value="SelectedCustomer"
                                                   ValueChanged="OnCustomerChanged"
                                                   ToStringFunc="@( (CustomerVM c) => c?.CustName ?? string.Empty )"
                                                   SearchFunc="SearchCustomers"
                                                   Variant="MudBlazor.Variant.Outlined"
                                                   Dense="true"
                                                   Clearable="true"
                                                   Class="w-100 small-autocomplete" />
                    </div>

                    <style>
                        .small-autocomplete .mud-input-root {
                            height: 100px;
                        }

                        .small-autocomplete input {
                            padding: 10px 12px !important;
                            font-size: 14px;
                        }
                    </style>



                    <div class="col-md-2">
                        @*  <label class="form-label">Document Type</label> *@
                        <label><i class="bi bi-file-earmark-text"></i> Document Type</label>
                        <select class="form-select" style=" style="height: 50px;" @onchange="OnDocTypeChanged">



                            <option value="">-- Select Document Type --</option>
                            @if (SelectedCustomerId == null & AvailableDocTypes == null)
                            {
                                <!-- Show all document types when no customer is selected -->
                                <option value="Enquiry">Enquiry</option>
                                <option value="Quotation">Quotation</option>
                                <option value="PO">PO</option>
                                <option value="MaterialReq">MaterialReq</option>
                                <option value="JobOrder">Job Order</option>
                                <option value="RouteCard">Route Card</option>
                                <option value="DC">DC</option>
                                <option value="Invoice">Invoice</option>
                            }

                        
                                      @if (AvailableDocTypes != null && AvailableDocTypes.Any())
                                      {
                                       @foreach (var docType in AvailableDocTypes)
                                      {
                                       <option value="@docType">@docType</option>
                                      }
                            }
                        </select>
                    </div>



                    <div class="col-md-2">
                        <label><i class="bi bi-hash"></i> Select Number</label>

