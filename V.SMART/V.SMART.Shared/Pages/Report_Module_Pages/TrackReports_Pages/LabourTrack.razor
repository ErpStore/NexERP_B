    private async Task<IEnumerable<CustomerVM>> SearchCustomers(string value, CancellationToken token)
    {
        try
        {
            bool IsInRange(DateTime? date) =>
                (!FromDate.HasValue || (date.HasValue && date.Value.Date >= FromDate.Value.Date)) &&
                (!ToDate.HasValue || (date.HasValue && date.Value.Date <= ToDate.Value.Date));

            // Filter only records within selected date range
            var filteredData = AllData?
                .Where(x =>
                    IsInRange(x.PODate) ||
                    IsInRange(x.DCDate) ||
                    IsInRange(x.GRNDate) ||
                    IsInRange(x.SCNDate) ||
                    IsInRange(x.InvDate))
                .ToList()
                ?? new List<LabourTrackSummaryVM>();

            List<CustomerVM> list;

            // Click without typing → show only customers having PO / DC / GRN / SCN / Invoice
            if (string.IsNullOrWhiteSpace(value))
            {
                list = filteredData
                    .Where(x =>
                        x.CustId != null &&
                        (
                            x.PoId != null ||
                            x.DCId != null ||
                            x.GRNId != null ||
                            x.SCNId != null ||
                            x.InvId != null
                        ))
                    .GroupBy(x => x.CustId)
                    .Select(g => new CustomerVM
                    {
                        CustId = g.Key ?? 0,
                        CustName = g.First().CustName
                    })
                    .OrderBy(x => x.CustName)
                    .Take(50)
                    .ToList();
            }
            else
            {
                // Search while typing
                var results = await labourTrackReportService.SearchCustomersAsync(value);

                list = results?
                    .Where(c => filteredData.Any(x =>
                        x.CustId == c.CustId &&
                        (
                            x.PoId != null ||
                            x.DCId != null ||
                            x.GRNId != null ||
                            x.SCNId != null ||
                            x.InvId != null
                        )))
                    .GroupBy(x => x.CustId)
                    .Select(g => new CustomerVM
                    {
                        CustId = g.First().CustId,
                        CustName = g.First().CustName
                    })
                    .OrderBy(x => x.CustName)
                    .Take(50)
                    .ToList()
                    ?? new List<CustomerVM>();
            }

            // Always insert "All" at top
            list.Insert(0, AllCustomer);

            return list;
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                $"Customer search failed: {value}"
            );

            await _JS.ToastrError("Customer search failed");

            return Enumerable.Empty<CustomerVM>();
        }
    }


