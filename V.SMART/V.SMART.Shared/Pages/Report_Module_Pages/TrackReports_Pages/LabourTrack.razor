                    x.DcQty,
                    x.DCBQty,
                    x.DCStatus,

                    x.InvNo,
                    x.InvDate,
                    x.Invqty,
                    x.InvBQty,
                    x.InvStatus
                }).ToList();
            }

            // ✅ PO MODE
            else if (CurrentMode == GridMode.Po)
            {
                headers = new[]
                {
                    "Customer Name","Item Code","Item Description","Category Code",
                    "PO No","PO Date","PO Qty","PO BQty","PO Status",
                    "GRN No","GRN Date","Ref DcNo","GRN Qty","GRN BQty","GRN Status",
                    "SCN No","SCN Date","SCN Qty","SCN BQty","SCN Status",
                    "DC No","DC Date","DC Qty","DC BQty","DC Status",
                    "Invoice No","Invoice Date","Invoice Qty","Invoice BQty","Invoice Status"
                };

                exportData = LabourTrackSummaryVMs.Select(x => new
                {
                    x.CustName,
                    x.ItemCode,
                    x.ItemName,
                    x.CategoryCode,

                    x.PONo,
                    x.PODate,
                    x.PoQty,
                    x.PoBalQty,
                    x.POStatus,

                    x.GRNNo,
                    x.GRNDate,
                    x.RefDcNo,
                    x.GrnQty,
                    x.GrnBqty,
                    x.GRNStatus,

                    x.SCNNo,
                    x.SCNDate,
                    x.ScnQty,
                    x.ScnBqty,
                    x.SCNStatus,

                    x.DCNo,
                    x.DCDate,
                    x.DcQty,
                    x.DCBQty,
                    x.DCStatus,

                    x.InvNo,
                    x.InvDate,
                    x.Invqty,
                    x.InvBQty,
                    x.InvStatus
                }).ToList();
            }

            // ✅ ITEM MODE
            else
            {
                headers = new[]
                {
                    "Customer Name","Item Code","Item Description","Category Code",
                    "PO No","PO Date","PO Qty","PO BQty","PO Status",
                    "GRN No","GRN Date","Ref DcNo","GRN Qty","GRN BQty","GRN Status",
                    "SCN No","SCN Date","SCN Qty","SCN BQty","SCN Status",
                    "DC No","DC Date","DC Qty","DC BQty","DC Status",
                    "Invoice No","Invoice Date","Invoice Qty","Invoice BQty","Invoice Status"
                };

                exportData = LabourTrackSummaryVMs.Select(x => new
                {
                    x.CustName,
                    x.ItemCode,
                    x.ItemName,
                    x.CategoryCode,

                    x.PONo,
                    x.PODate,
                    x.PoQty,
                    x.PoBalQty,
                    x.POStatus,

                    x.GRNNo,
                    x.GRNDate,
                    x.RefDcNo,
                    x.GrnQty,
                    x.GrnBqty,
                    x.GRNStatus,

                    x.SCNNo,
                    x.SCNDate,
                    x.ScnQty,
                    x.ScnBqty,
                    x.SCNStatus,

                    x.DCNo,
                    x.DCDate,
                    x.DcQty,
                    x.DCBQty,
                    x.DCStatus,

                    x.InvNo,
                    x.InvDate,
                    x.Invqty,
                    x.InvBQty,
                    x.InvStatus
                }).ToList();
            }
            // ✅ Generate Excel
            var fileBytes = await excelTemplateService.CreateTemplateAsync(
                sheetName: "Labour Track",
                headers: headers,
                sampleData: exportData
            );

            var base64 = Convert.ToBase64String(fileBytes);

            await _JS.InvokeVoidAsync(
                "downloadExcelFile",
                base64,
                "LabourTrack.xlsx"
            );

            await _JS.ToastrSuccess("Pending Track exported successfully.");
        }
        catch (Exception ex)
        {
           // await _logs.LogDeveloperError(ex, "OnPrintPendingTrack failed.");
            await _JS.ToastrError("Failed to export pending Track.");
        }
        finally
        {
            isProcessing = false;
        }
     }


}