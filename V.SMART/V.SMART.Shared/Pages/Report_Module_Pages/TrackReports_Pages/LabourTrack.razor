    private async Task OnDocNoChanged(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value?.ToString(), out int value) && FilteredList != null)
            {
                SelectedItemCode = null;
                SelectedPoId = value;
                CurrentMode = GridMode.Po;

                // ✅ Dynamic filtering based on docType
                LabourTrackSummaryVMs = SelectedDocType switch
                {
                    "Labour PO" => FilteredList.Where(x => x.PoId == value).ToList(),
                    "Labour GRN" => FilteredList.Where(x => x.GRNId == value).ToList(),
                    "Labour SCN" => FilteredList.Where(x => x.SCNId == value).ToList(),
                    "Labour DC" => FilteredList.Where(x => x.DCId == value).ToList(),
                    "Labour Invoice" => FilteredList.Where(x => x.InvId == value).ToList(),
                    _ => new List<LabourTrackSummaryVM>()
                };
               
                CurrentMode = GridMode.Po;

                ItemList = LabourTrackSummaryVMs
                     .Where(x => x.ItemId != null)
                     .GroupBy(x => x.ItemId)
                     .Select(g => g.First())
                    .ToList();

            }

            else
            {
                // SelectedItemCode = null;
                // LabourTrackSummaryVMs = LabourTrackSummaryVMs?.ToList();
                // StateHasChanged();
                SelectedPoId = null;
                SelectedItemCode = null;

                var source = FilteredList ?? TempLabourTrackSummaryVMs;

                // ✅ Reload previous grid (DocType-based filter)
                LabourTrackSummaryVMs = source
                    .Where(x =>
                        (string.IsNullOrEmpty(SelectedDocType) || MatchDocType(x))
                    )
                    .ToList();

                // ✅ Rebuild Item list
                ItemList = LabourTrackSummaryVMs
                    .Where(x => x.ItemId != null)
                    .GroupBy(x => x.ItemId)
                    .Select(g => g.First())
                    .ToList();

                CurrentMode = GridMode.Customer;

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in OnDocNoChanged");
            await _JS.ToastrError("Failed to filter document number.");
        }
    }

