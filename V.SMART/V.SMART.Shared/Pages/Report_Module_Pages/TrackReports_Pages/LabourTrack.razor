                        <style>
                            .grid-wrapper {
                                width: 100%;
                                max-width: 100%;
                                max-height: 650px;
                                overflow: auto;
                                position: relative;
                                border: 1px solid #dcdcdc;
                                border-radius: 8px;
                                background: #ffffff;
                                scroll-behavior: smooth;
                                outline: none;
                            }

                                /* Keyboard focus for navigation */
                                .grid-wrapper:focus {
                                    border-color: #0d6efd;
                                    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
                                }

                            /* Main grid container */
                            .custom-grid {
                                min-width: 2400px; /* Adjust based on total columns */
                                width: max-content;
                                white-space: nowrap;
                            }

                                .custom-grid table {
                                    width: max-content;
                                    min-width: 100%;
                                    border-collapse: collapse;
                                    table-layout: auto;
                                }

                                /* ===============================
                                       Sticky Header
                                    =============================== */

                                .custom-grid thead th {
                                    position: sticky;
                                    top: 0;
                                    z-index: 30;
                                    background: #ffffff;
                                    border-bottom: 1px solid #dee2e6;
                                    padding: 12px 16px;
                                    font-size: 14px;
                                    font-weight: 600;
                                    text-align: left;
                                    white-space: nowrap;
                                }

                                    /* ===============================
                                       Sticky First Column
                                    =============================== */

                                    .custom-grid thead th:first-child,
                                    .custom-grid tbody td:first-child {
                                        position: sticky;
                                        left: 0;
                                        z-index: 25;
                                        background: #ffffff;
                                        border-right: 1px solid #dee2e6;
                                    }

                                    .custom-grid thead th:first-child {
                                        z-index: 35;
                                    }

                                /* ===============================
                                       Table Cells
                                    =============================== */

                                .custom-grid tbody td {
                                    padding: 10px 16px;
                                    font-size: 14px;
                                    color: #212529;
                                    border-bottom: 1px solid #f1f3f5;
                                    white-space: nowrap;
                                    vertical-align: middle;
                                }

                                /* Row hover */
                                .custom-grid tbody tr:hover {
                                    background-color: #f8f9fa;
                                }

                                /* Zebra rows (optional enterprise style) */
                                .custom-grid tbody tr:nth-child(even) {
                                    background-color: #fcfcfc;
                                }

                            /* ===============================
                                       Scrollbar Styling
                                    =============================== */

                            .grid-wrapper::-webkit-scrollbar {
                                width: 10px;
                                height: 10px;
                            }

                            .grid-wrapper::-webkit-scrollbar-track {
                                background: #f1f1f1;
                                border-radius: 10px;
                            }

                            .grid-wrapper::-webkit-scrollbar-thumb {
                                background: #bdbdbd;
                                border-radius: 10px;
                            }

                                .grid-wrapper::-webkit-scrollbar-thumb:hover {
                                    background: #8d8d8d;
                                }

                            /* ===============================
                                       Optional Scroll Shadow Effect
                                    =============================== */

                            .grid-wrapper::after {
                                content: "";
                                position: sticky;
                                right: 0;
                                top: 0;
                                width: 12px;
                                height: 100%;
                                pointer-events: none;
                            }
                       
                        </style>

