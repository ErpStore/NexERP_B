@page "/Purchase-Sales_Track"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.ITrackReportService
@using V.SMART.Shared.ViewModels.ReportViewModel.TrakReportsViewModel.PurchaseSalesTrackViewModel



@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService
@inject IPurchaseSalesTrackReportServices _purchaseSales
@inject ExcelExportService ExcelExportService
@inject IColumnPreferenceService PreferenceService


<BsModal OnModalConfirmation="confirmation_Click"
         ButtonBootstrapStyle="@(confirmation != "Export" ? "btn-danger" : btnColor)"
         ButtonText="@(confirmation != "Export" ? "Delete" : btnText)"
         Title="@(confirmation != "Export"
         ? "Are you sure you want to delete this Purchase Sales Track?"
         : ModalTitle)">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4"  >
        <div class="card shadow-sm border-1" style="z-index:3;">
            <PageHeader TitleText="Purchase Sales Track Report "
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@PurchaseSalesTrackReport" />

            <div class="card-body  bg-light">

                <!-- Date Section -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">From Date</label>
                        <input type="date" class="form-control shadow-sm" @bind="FromDate" @bind:after="OnDateChanged" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">To Date</label>
                        <input type="date" class="form-control shadow-sm" @bind="ToDate" @bind:after="OnDateChanged" />
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="row align-items-center">
                            <label class="form-label fw-semibold">
                                <small>Item List</small>
                            </label>

                            <select class="form-select" @onchange="OnItemChanged">
                                    <option value="0">-- Select Item --</option>

                                    @if (itemnames != null && itemnames.Any())
                                    {
                                        @foreach (var item in itemnames)
                                        {
                                            <option value="@item">
                                                @item
                                            </option>
                                        }
                                    }
                                </select>
                            
                        </div>
                    </div>
                </div>

                @if(PurchaseSaleslist.Any())
                {
                    <div class="col-12 mt-3 mb-2">

                        <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                            <div class="card-header bg-primary-subtle text-dark">

                                <div class="row g-3 align-items-center mb-3">

                                    <!-- Title -->
                                    <div class="col-12 col-lg-3">
                                        <span class="fw-bold fs-6">
                                            Purchase Sales Track Details
                                        </span>
                                    </div>

                                    <div class="col-12 col-lg-3 ">
                                        <div class="dropdown position-relative" style="z-index:1;">
                                            <ColumnMenu Columns="@PurchaseSalesTrackColumns"
                                                        ScreenName="@ScreenName"
                                                        UserId="@UserName"
                                                        MaxVisible="@int.MaxValue"
                                                        OnChanged="HandleColumnChange" />
                                        </div>
                                    </div>

                                   

                                    <!-- Search -->
                                    <div class="col-12 col-lg-3">
                                        <div class="input-group w-100">
                                            <span class="input-group-text bg-white">
                                                <i class="bi bi-search text-muted"></i>
                                            </span>

                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="Search here..."
                                                   value="@searchText"
                                                   @oninput="OnInputChanged" />
                                        </div>
                                    </div>

                                    <!-- Print -->
                                    <div class="col-12 col-lg-3">
                                        <button class="btn btn-outline-primary w-100 text-nowrap"
                                                @onclick="HandleExport"
                                                title="Export Report to Excel">
                                            <i class="bi bi-printer me-1"></i> Print
                                        </button>
                                    </div>

                                </div>

                            </div>

                            <div class="card-body p-2">

                               
                                <div class="table-responsive border rounded" style="max-height:600px; overflow-x:auto; overflow-y:auto;">

                                    <table class="table table-bordered table-sm mb-0 align-middle" style="min-width:1900px; white-space:nowrap;">

                                        <thead class="custom-blue text-center align-middle sticky-top" style="z-index:0;">

                                            <tr>
                                                
                                                    @foreach (var col in PurchaseSalesTrackColumns.Where(x => x.IsVisible))
                                                    {
                                                    <th style="min-width:@col.Width; class="text-center">
                                                            @col.Title
                                                        </th>
                                                    }

                                                


                                            </tr>

                                        </thead>
                                        <tbody class="custom-size">


                                            @foreach (var row in FilteredPurchaseSalesTrack)
                                            {
                                                
                                                <tr>

                                                     @foreach (var col in PurchaseSalesTrackColumns.Where(x => x.IsVisible))
                                                    {
                                                    string bgColor = "";

                                                    if (new[]
                                                    {
                                                                            "SlNo","VendorName","PONo","PODate",
                                                                            "GRNNO","GRNDate","ItemCode","ItemName","UOM","HSNCode","POQty",
                                                                            "AccQty","RejQty","Unit_Price","Purch_Discount","BalQty",
                                                                            }.Contains(col.Field))
                                                    {
                                                        bgColor = "#fffde7"; // Light Yellow
                                                    }
                                                    else if (new[]
                                                    {
                                                                            "CustName","MfgPONo","MfgpoDate","MfgPoQty",
                                                                            "DcNo","DCQty","DcDate","Invno","InvDate","Qty","Sales_price","Discount"
                                                                            }.Contains(col.Field))
                                                    {
                                                        bgColor = "#e8f5e9"; // Light Green
                                                    }

                                                    <td class="@col.Align" style="background-color:@bgColor;">

                                                            @switch (col.Field)
                                                            {
                                                                case "SlNo":
                                                                    @row.SlNo
                                                                        break;

                                                                case "VendorName":
                                                                    @row.VendorName
                                                                        break;

                                                                case "PONo":
                                                                    @row.PONo
                                                                        break;

                                                                case "PODate":
                                                                    @row.PODate
                                                                    break;

                                                                case "GRNNO":
                                                                    @row.GRNNO
                                                                        break;

                                                                case "GRNDate":
                                                                    @row.GRNDate
                                                                    break;

                                                                case "ItemCode":
                                                                    @row.ItemCode
                                                                    break;

                                                                case "ItemName":
                                                                    @row.ItemName
                                                                    break;

                                                                case "UOM":
                                                                    @row.UOM
                                                                    break;

                                                                case "HSNCode":
                                                                    @row.HSNCode
                                                                    break;

                                                                case "POQty":
                                                                    @row.POQty
                                                                    break;

                                                                case "AccQty":
                                                                    @row.AccQty
                                                                    break;

                                                                case "RejQty":
                                                                    @row.RejQty
                                                                    break;

                                                                case "Unit_Price":
                                                                    @row.Unit_Price
                                                                    break;

                                                                case "Purch_Discount":
                                                                    @row.Purch_Discount
                                                                    break;

                                                                case "BalQty":
                                                                    @row.BalQty
                                                                        break;

                                                                case "CustName":
                                                                    @row.CustName
                                                                        break;

                                                                case "MfgPONo":
                                                                    @row.MfgPONo
                                                                        break;

                                                                case "MfgpoDate":
                                                                    @row.MfgpoDate
                                                                    break;

                                                             
                                                                case "DcNo":
                                                                    @row.DcNo
                                                                        break;

                                                                case "DcDate":
                                                                    @row.DcDate
                                                                    break;

                                                                case "DCQty":
                                                                    @row.DCQty
                                                                        break;


                                                                case "Invno":
                                                                    @row.Invno
                                                                        break;

                                                                case "InvDate":
                                                                    @row.InvDate
                                                                    break;
                                                                    
                                                                case "Qty":
                                                                    @row.Qty
                                                                    break;

                                                                case "Sales_price":
                                                                    @row.Sales_price
                                                                    break;

                                                                case "Discount":
                                                                    @row.Discount
                                                                    break;

                                                               @*  case "PurchaseAmount":
                                                                    @row.PurchaseAmount
                                                                    break;

                                                                case "SalesAmount":
                                                                    @row.SalesAmount
                                                                    break; *@

                                                                case "Profit":
                                                                    @row.Profit
                                                                    break;


                                                                    
                                                            }

                                                        </td>
                                                    }

                                                
                                                </tr>
                                             }

                                            


                                        </tbody>


                                    </table>

                                </div>

                            </div>

                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mt-3">
                        No records found.
                    </div>
                }

                                 
            </div>
        </div>
    </div>
    
}

@code {
    #region === Screen Configuration ===
    private bool isProcessing = true;
    protected override string ScreenName => "Purchase Sales Track";


    private bool preferencesLoaded = false;

    private DateTime FromDate = DateTime.Today.AddDays(-7);
    private DateTime ToDate = DateTime.Today;
    public List<CustomerVM> Customers { get; set; } = new ();
    public List<VendorVM> Suppliers { get; set; } = new();
    public List<ItemVM> Items { get; set; } = new();


    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = "";
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }
    public List<GridColumn> PurchaseSalesTrackColumns { get; set; } = new();
    public List<PurchaseSalesTrackVM> PurchaseSaleslist { get; set; } = new();
    public List<string> itemnames = new List<string>();
    private string? UserName;
    private string searchText = string.Empty;
    private string SelectedItemCode = string.Empty;

    private List<PageHeader.BreadcrumbItem> PurchaseSalesTrackReport = new()
        {
            new PageHeader.BreadcrumbItem { Text = "Reports" },
            new PageHeader.BreadcrumbItem { Text = "Track Reports" },
            new PageHeader.BreadcrumbItem { Text = "Purchase Sales Track Report", IsLast = true }
        };

    #endregion

    IEnumerable<PurchaseSalesTrackVM> FilteredPurchaseSalesTrack =>
      (PurchaseSaleslist?
      .Where(s =>
        (string.IsNullOrEmpty(SelectedItemCode) ||
         s.ItemCode == SelectedItemCode)

        &&

        (
            string.IsNullOrWhiteSpace(searchText) ||

            (!string.IsNullOrEmpty(s.ItemCode) &&
             s.ItemCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.ItemName) &&
             s.ItemName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.VendorName) &&
             s.VendorName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.PONo) &&
             s.PONo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.GRNNO) &&
             s.GRNNO.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.CustName) &&
             s.CustName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.MfgPONo) &&
             s.MfgPONo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.DcNo) &&
             s.DcNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.Invno) &&
             s.Invno.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (s.POQty.HasValue &&
             s.POQty.Value.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (s.BalQty.HasValue &&
             s.BalQty.Value.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (s.DCQty.HasValue &&
             s.DCQty.Value.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (s.Qty.HasValue &&
             s.Qty.Value.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase))
        )
    )
    .Select((x, index) =>
    {
        x.SlNo = index + 1;
        return x;
    }))
?? Enumerable.Empty<PurchaseSalesTrackVM>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }


            await InitializeColumns(IsHidden);
            UserName = await CurrentUserService.GetUsernameAsync();
            await LoadColumnPreferences(UserName);
            await OnDateChanged();

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in Purchase Sales Track OnInitializedAsync");
        }
        finally
        {
            isProcessing = false;
        }
    }
    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            PurchaseSalesTrackColumns = new List<GridColumn>
            {
                    new() { Title="Sl No.", Field="SlNo", Width="60px", IsVisible = true },

                    new() { Title="Vendor", Field="VendorName", Width="220px", Align="text-center", IsVisible = true },

                    new() { Title="Purch PONo.", Field="PONo", Width="120px",Align="text-center", IsVisible = true },

                    new() { Title="PO date", Field="PODate", Width="120px",Align="text-center", IsVisible = true },

                    new() { Title="GRNNO", Field="GRNNO", Width="80px", Align="text-center", IsVisible = true },

                    new() { Title="GRNDate", Field="GRNDate", Width="80px", Align="text-center", IsVisible = true },

                     new() { Title="Item Code", Field="ItemCode", Width="120px" ,Align="text-start", IsVisible = true},

                    new() { Title="Item Name", Field="ItemName", Width="130px", Align="text-start", IsVisible = true },

                    new() { Title="UOM", Field="UOM", Width="100px", Align="text-start", IsVisible = true },

                    new() { Title="HSNCode", Field="HSNCode", Width="100px", Align="text-start", IsVisible = true },

                    new() { Title="POQty", Field="POQty", Width="80px" ,Align="text-center", IsVisible = true},


                    new() { Title="Acc Qty", Field="AccQty", Width="80px", Align="text-center", IsVisible = true },

                    new() { Title="Rej Qty", Field="RejQty", Width="80px", Align="text-center", IsVisible = true },


                    new() { Title="Unit Price", Field="Unit_Price", Width="80px", Align="text-center", IsVisible = true },

                    new() { Title=" Disc. Amt", Field="Purch_Discount", Width="80px", Align="text-center", IsVisible = true },

                    new() { Title="Bal Qty", Field="BalQty", Width="80px", Align="text-center", IsVisible = true },

                    new() { Title="Customer", Field="CustName", Width="120px", Align="text-center", IsVisible = true },

                    new() { Title="Mfg PONo.", Field="MfgPONo", Width="100px",  Align="text-center",IsVisible = true },

                    new() { Title="MfgpoDate", Field="MfgpoDate", Width="100px",  Align="text-center",IsVisible = true },


                    new() { Title="DC No.", Field="DcNo", Width="100px" ,Align="text-center",IsVisible = true },

                    new() { Title="DcDate", Field="DcDate", Width="100px" ,Align="text-center",IsVisible = true },

                    new() { Title="DCQty", Field="DCQty", Width="100px" ,Align="text-center",IsVisible = true  },

                    new() { Title="Invoice No.", Field="Invno", Width="100px"  ,Align="text-center",IsVisible = true  },

                    new() { Title="Invoice Date", Field="InvDate", Width="100px"  ,Align="text-center",IsVisible = true  },

                    new() { Title="Invoice Qty", Field="Qty", Width="80px", Align="text-center"  ,IsVisible = true  },

                    new() { Title="UnitPrice", Field="Sales_price", Width="80px", Align="text-center"  ,IsVisible = true  },

                    new() { Title="Discount Amt", Field="Discount", Width="80px", Align="text-center"  ,IsVisible = true  },

                    // new() { Title="PurchaseAmount", Field="PurchaseAmount", Width="80px", Align="text-center"  ,IsVisible = false  },

                    // new() { Title="SalesAmount", Field="SalesAmount", Width="80px", Align="text-center"  ,IsVisible = false  },

                    new() { Title="Profit", Field="Profit", Width="80px", Align="text-center"  ,IsVisible = true  },


            };  

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Export Purchase Sales Track confirmation_Click() method");
            await _JS.ToastrError("An error occurred while handling the Purchase Sales Track  confirmation_Click() method");
        }
    }


    private async Task confirmation_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (isConfirmed && confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
                confirmation = "";
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Export Purchase Sales Track Data confirmation_Click() method");
            await _JS.ToastrError("An error occurred while handling the Purchase Sales Track confirmation_Click() method");
        }
    }
    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;

            List<Dictionary<string, object>> exportData = new();


            if (FilteredPurchaseSalesTrack != null
                    && FilteredPurchaseSalesTrack.Any())
            {
                exportData = GetExportData(
                FilteredPurchaseSalesTrack.ToList());
            }



            if (!exportData.Any())
                return;

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "Purchase_Sales_Track", "Purchase_Sales_Track Report");

            var base64 = Convert.ToBase64String(bytes);

            await _JS.DownloadExcelAsync(base64, "Purchase_Sales_Track.xlsx");

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in Purchase_Sales_Track");
            await _JS.ToastrError("Error while exporting Purchase_Sales_Track!");
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task OnDateChanged()
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            PurchaseSaleslist = await _purchaseSales.GetPurchaseSalesTrack(FromDate, ToDate);

            itemnames = PurchaseSaleslist?
                            .Where(x => !string.IsNullOrWhiteSpace(x.ItemCode))
                            .Select(x => x.ItemCode)
                            .Distinct()
                            .ToList()
                            ?? new List<string>();

        }
        catch (Exception ex)
        {

            throw;
        }
        finally
        {
            isProcessing = false;
        }
    }
    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {

            PurchaseSalesTrackColumns = updated;
            await LoadColumnPreferences(UserName);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Purchase Sales Track HandleColumnChange() Method");
        }
    }
    private async Task HandleExport()
    {


        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }
    private async Task OnInputChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(searchText))
            return;

        if (PurchaseSaleslist is null || !PurchaseSaleslist.Any() )
        {
            await _JS.ToastrWarning("No data available to search.");
            return;
        }

    }
    private List<Dictionary<string, object>> GetExportData<T>(List<T> data)
    {
        return data
        .Select(row =>
        {
            var dict = new Dictionary<string, object>();


            foreach (var col in PurchaseSalesTrackColumns.Where(x => x.IsVisible))
            {
                var prop = typeof(T).GetProperty(col.Field);

                if (prop != null)
                {
                    dict[col.Title] = prop.GetValue(row);
                }
            }



            return dict;
        })
        .ToList();
    }
    private async Task OnItemChanged(ChangeEventArgs e)
    {
        try
        {
            SelectedItemCode = e.Value?.ToString();
            if (SelectedItemCode.Equals("0")) SelectedItemCode = "";

            StateHasChanged();
        }
        catch (Exception ex)
        {

        }
    }
    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in PurchaseSalesTrackColumns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error loading column preferences for Customer List");
            await _JS.ToastrError("Failed to load column preferences.");
        }
    }
}
