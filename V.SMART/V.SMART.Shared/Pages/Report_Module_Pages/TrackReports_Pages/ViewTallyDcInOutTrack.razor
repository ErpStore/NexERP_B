    public async Task LoadParties()
    {
        try
        {
            Items.Clear();
            if (Topic == "Sales")
            {
                Customers = await _tallyTrack.GetCustomersByDate(FromDate, ToDate);
                if (Customers == null || !Customers.Any())
                {
                    await _JS.ToastrWarning($"No Data view between {FromDate} and {ToDate}");
                    return;
                }
                await LoadCustomerColumnPreferences(UserName);

            }
            else if (Topic == "SubContract")
            {
                Suppliers = await _tallyTrack.GetSupplierByDate(FromDate, ToDate);

                if (Suppliers == null || !Suppliers.Any())
                {
                    await _JS.ToastrWarning($"No Data view between {FromDate} and {ToDate}");
                    return;
                }
                await LoadSupplierColumnPreferences(UserName);
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadParties in View Tally DC In_Out Track");
            await _JS.ToastrError($"{ex.Message} ,Failed to LoadParties in View Tally DC In_Out Track");
        }
        finally
        {
            isProcessing = false;
        }
    }

