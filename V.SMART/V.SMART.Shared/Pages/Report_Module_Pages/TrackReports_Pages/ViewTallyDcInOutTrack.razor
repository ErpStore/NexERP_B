                    new() { Title="Invoice Qty", Field="Qty", Width="120px", Align="text-end" },

                    new() { Title="Process", Field="Process", Width="120px" },

                    new() { Title="Invoice Delay (Days)", Field="Duedays", Width="120px" , IsVisible = false}
                };
            }
            else if (Topic == "SubContract")
            {
                SupplierColumns = new List<GridColumn>
                {
                    new() { Title="Sl No.", Field="SlNo", Width="60px", IsVisible = true },

                    new() { Title="Supplier", Field="Supplier", Width="220px", Align="text-start", IsVisible = true },

                    new() { Title="Dc No.", Field="DcNo", Width="120px", IsVisible = true },

