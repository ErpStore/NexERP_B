                    new() { Title="SCN No.", Field="SCNNo", Width="120px" },

                    new() { Title="SCN Date", Field="SCNDate", Width="120px" },

                    new() { Title="WOP Qty", Field="WOPQty", Width="100px", Align="text-end" },

                    new() { Title="Rej Qty", Field="RejQty", Width="100px", Align="text-end" },

                    new() { Title="Rew Qty", Field="RewQty", Width="100px", Align="text-end" },

                    new() { Title="PO No.", Field="PONo", Width="120px" },

                    new() { Title="PO Date", Field="PODate", Width="120px" },

                    new() { Title="Line No.", Field="LineNo", Width="120px" },

                    new() { Title="DC Out No.", Field="DcNoOut", Width="120px" },

                    new() { Title="DC Date", Field="DcDate", Width="120px" },

                    new() { Title="Qty Out", Field="Qty_Out", Width="100px", Align="text-end" },


                    // new() { Title="Item Code_Out", Field="ItemCode_Out", Width="150px", Align="text-start", IsVisible = true },

                    // new() { Title="Item Name_Out", Field="ItemName_Out", Width="250px", Align="text-start", IsVisible = true },

                    // new() { Title="UOM_Out", Field="MeasureUnit_Out", Width="80px", IsVisible = true },

