                                                    }
                                                }


                                            </tr>

                                        </thead>
                                        <tbody class="custom-size">

                                            @if (Topic == "Sales")
                                            {
                                                i = 1;

                                                @foreach (var row in FilteredTallyInOutCustomerData)
