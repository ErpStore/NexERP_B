                                                                    case "GRNNo":
                                                                        @row.GRNNo
                                                                        break;

                                                                    case "GRNDate":
                                                                        @row.GRNDate
                                                                        break;

                                                                    case "RefDcNo":
                                                                        @row.RefDcNo
                                                                        break;

                                                                    case "RefDcDate":
                                                                        @row.RefDcDate
