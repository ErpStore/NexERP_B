                                                                    @*            case "ItemCode_Out":
                                                                        @row.ItemCode_Out
                                                                        break;

                                                                    case "ItemName_Out":
                                                                        @row.ItemName_Out
                                                                        break;

                                                                    case "MeasureUnit_Out":
                                                                        @row.MeasureUnit_Out
                                                                        break;

                                                                    case "HSNCode_Out":
                                                                        @row.HSNCode_Out
                                                                        break; *@

                                                                    case "InvoiceNo":
                                                                        @row.InvoiceNo
                                                                        break;

                                                                    case "InvDate":
                                                                        @row.InvDate
                                                                        break;

                                                                    case "Qty":
                                                                        @row.Qty
                                                                        break;
                                                                    case "Process":
                                                                        @row.Process
                                                                        break;

                                                                    @* Sathish *@
                                                                    case "Duedays":
                                                                        @row.Duedays
                                                                        break;
                                                                 }

                                                            </td>
                                                        }

                                                    </tr>
                                                    i++;
                                                }

                                            }
                                            else if (Topic == "SubContract")
                                            {
                                                i = 1;
                                                @foreach (var row in FilteredTallyInOutSupplierData)
                                                {
                                                    <tr>

                                                        @foreach (var col in SupplierColumns.Where(x => x.IsVisible))
                                                        {
                                                            <td class="@col.Align">

                                                                @switch (col.Field)
                                                                {
                                                                    case "SlNo":
