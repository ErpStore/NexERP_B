                        <div class="card shadow-sm border-0 h-100">

                            <div class="card-header fw-semibold p-2 small d-flex align-items-center gap-2 text-white " style="background:#2c6fdb;">
                                <i class="bi bi-diagram-3"></i>
                                Topic
                            </div>


                            <div class="card-body py-2">
                                <InputRadioGroup TValue="string"
