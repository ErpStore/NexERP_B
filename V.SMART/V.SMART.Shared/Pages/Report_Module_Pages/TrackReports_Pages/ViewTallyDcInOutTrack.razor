    private async Task OnInputChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(searchText))
            return;

        if (CustomerViewTallyInOut is null || !CustomerViewTallyInOut.Any() && Topic == "Sales")
        {
            await _JS.ToastrWarning("No data available to search.");
            return;
        }
        else if (SupplierViewTallyInOut is null || !SupplierViewTallyInOut.Any() && Topic == "SubContract")
        {
            await _JS.ToastrWarning("No data available to search.");
            return;
        }
    }

