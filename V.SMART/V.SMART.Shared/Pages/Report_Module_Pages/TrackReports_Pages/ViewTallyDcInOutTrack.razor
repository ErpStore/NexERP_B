                                                                        break;

                                                                    case "DcNo":
                                                                        @row.DcNo
                                                                        break;

                                                                    case "DcDate":
                                                                        @row.DcDate
                                                                        break;
                                                                    case "TransType":
                                                                        @row.TransType
                                                                        break;

                                                                    case "ItemCodeOut":
                                                                        @row.ItemCodeOut
                                                                        break;

                                                                    case "ItemName":
                                                                        @row.ItemName
                                                                        break;

                                                                    case "MeasureUnit":
                                                                        @row.MeasureUnit
                                                                        break;

                                                                    case "HSNCode":
                                                                        @row.HSNCode
                                                                        break;

                                                                    case "QtyOut":
                                                                        @row.QtyOut
                                                                        break;

                                                                    case "BalQty":
                                                                        @row.BalQty
                                                                        break;

                                                                    case "GRNNo":
                                                                        @row.GRNNo
                                                                        break;

                                                                    case "GRNDate":
                                                                        @row.GRNDate
                                                                        break;

                                                                    case "RefDcNo":
                                                                        @row.RefDcNo
                                                                        break;

                                                                    case "RefDcDate":
                                                                        @row.RefDcDate
                                                                        break;

                                                                    case "QtyIn":
                                                                        @row.QtyIn
                                                                        break;

                                                                    case "SCNNo":
                                                                        @row.SCNNo
                                                                        break;

                                                                    case "SCNDate":
                                                                        @row.SCNDate
                                                                        break;

                                                                    case "WOPQty":
                                                                        @row.WOPQty
                                                                        break;

                                                                    case "RejQty":
                                                                        @row.RejQty
                                                                        break;

                                                                    case "RewQty":
