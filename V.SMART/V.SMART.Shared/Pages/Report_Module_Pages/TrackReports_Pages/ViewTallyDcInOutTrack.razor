    private async Task HandleExport()
    {


        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }
    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;

            List<Dictionary<string, object>> exportData = new();

            if (Topic == "Sales")
            {
                if (FilteredTallyInOutCustomerData != null
                    && FilteredTallyInOutCustomerData.Any())
                {
                    exportData = GetExportData(
                        FilteredTallyInOutCustomerData.ToList());
                }
            }
            else if (Topic == "SubContract")
            {
                if (FilteredTallyInOutSupplierData != null
                    && FilteredTallyInOutSupplierData.Any())
                {
                    exportData = GetExportData(
                        FilteredTallyInOutSupplierData.ToList());
                }
            }

            if (!exportData.Any())
                return;

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "ViewDcTally_In_Out", "ViewDcTally_In_Out List");

            var base64 = Convert.ToBase64String(bytes);

            await _JS.DownloadExcelAsync(base64, "ViewDcTally_In_Out.xlsx");

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in LabourDc_In_Out (Dc's)");
            await _JS.ToastrError("Error while exporting LabourDc_In_Out!");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task confirmation_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (isConfirmed && confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
                confirmation = "";
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Export TallyDC In_Out Data confirmation_Click() method");
            await _JS.ToastrError("An error occurred while handling the TallyDC In_Out Data  confirmation_Click() method");
        }
    }

    private List<Dictionary<string, object>> GetExportData<T>(List<T> data)
    {
        return data
        .Select(row =>
        {
            var dict = new Dictionary<string, object>();

            if (Topic == "Sales")
            {
                foreach (var col in CustomerColumns.Where(x => x.IsVisible))
                {
                    var prop = typeof(T).GetProperty(col.Field);

                    if (prop != null)
                    {
                        dict[col.Title] = prop.GetValue(row);
                    }
                }
            }
            else if (Topic == "SubContract")
            {
                foreach (var col in SupplierColumns.Where(x => x.IsVisible))
                {
                    var prop = typeof(T).GetProperty(col.Field);

                    if (prop != null)
                    {
                        dict[col.Title] = prop.GetValue(row);
                    }
                }
            }

            return dict;
        })
        .ToList();
    }

