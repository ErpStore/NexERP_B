                                                        @foreach (var col in CustomerColumns.Where(x => x.IsVisible))
                                                        {
                                                            <td class="@col.Align">

                                                                @switch (col.Field)
                                                                {
                                                                    case "SlNo":
                                                                        <text>@i</text>
                                                                        break;

                                                                    case "Customer":
