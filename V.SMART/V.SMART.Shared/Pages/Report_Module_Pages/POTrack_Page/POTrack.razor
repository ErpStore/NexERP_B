    private async Task OnDateChanged()
    {
        try
        {
            isProcessing = true;

            await LoadParties();

            AllCustomerPos = await _tallyTrack.GetInwordPOTrack(FromDate, ToDate);

            AllVendorPos = await _tallyTrack.GePurchasePOTrack(FromDate, ToDate);

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "Po track report in OnDateChanged");
            await _JS.ToastrError($"{ex.Message} ,Failed to Po track report in View  View PO Track");
        }
        finally
        {
            isProcessing = false;
        }
    }
    public async Task LoadParties()
    {
        try
        {

            if (Topic == "Sales")
            {
                Customers = await _tallyTrack.GetCustomersByDate(FromDate, ToDate);
                if (Customers == null || !Customers.Any())
                {
                    await _JS.ToastrWarning($"No Data view between {FromDate} and {ToDate}");
                    return;
                }
                await LoadCustomerColumnPreferences(UserName);

            }
            else if (Topic == "SubContract")
            {
                Suppliers = await _tallyTrack.GetSupplierByDate(FromDate, ToDate);

                if (Suppliers == null || !Suppliers.Any())
                {
                    await _JS.ToastrWarning($"No Data view between {FromDate} and {ToDate}");
                    return;
                }
                await LoadSupplierColumnPreferences(UserName);
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "LoadParties in View PO Track");
            await _JS.ToastrError($"{ex.Message} ,Failed to LoadParties in View  View PO Track");
        }
        finally
        {
            isProcessing = false;
        }
    }
    public async Task SelectCustomer(CustomerVM customer)
    {
        try
        {
            isProcessing = true;
            await InvokeAsync(StateHasChanged);

            if (customer != null)
            {
                CustomerViewFiltered.Clear();
                SelectedCustomer = customer;
                SelectedCustId = customer.CustId;

                CustomerViewFiltered = AllCustomerPos
                .Where(x =>
                    (SelectedCustId == 0 || x.CustId == SelectedCustId) &&
                    x.PODate >= FromDate &&
                    x.PODate <= ToDate)
                .ToList();

                long slNo = 1;
                foreach (var item in CustomerViewFiltered)
                {
                    item.SlNo = slNo++;
                }
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "SelectCustomer");
            await _JS.ToastrError($"{ex.Message}Failed to LoadAll SelectCustomer Data");

        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }

    }
    public async Task SelectSupplier(VendorVM vendor)
    {
        try
        {
            isProcessing = true;
            await InvokeAsync(StateHasChanged);

            if (vendor != null)
            {
                VendorViewFiltered.Clear();
                SelectedSupplier = vendor;
                SelectedSupplierCode = vendor.VendorCode;

                VendorViewFiltered = AllVendorPos
                .Where(x =>
                    (SelectedSupplierCode == 0 || x.VendorCode == SelectedSupplierCode) &&
                    x.PODate >= FromDate &&
                    x.PODate <= ToDate)
                .ToList();

                long slNo = 1;
                foreach (var item in VendorViewFiltered)
                {
                    item.SlNo = slNo++;
                }
            }

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "SelectCustomer");
            await _JS.ToastrError($"{ex.Message}Failed to LoadAll SelectCustomer Data");

        }
        finally
        {
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }

    }

