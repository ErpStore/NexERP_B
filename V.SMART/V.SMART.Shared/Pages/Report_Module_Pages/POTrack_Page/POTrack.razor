@page "/po-tally"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.IPOTrack_Service
@using V.SMART.Shared.ViewModels.ReportViewModel.POTrackVM


@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject IPOTrackService _tallyTrack

@inject ExcelExportService ExcelExportService

<BsModal OnModalConfirmation="confirmation_Click"
         ButtonBootstrapStyle="@(confirmation != "Export" ? "btn-danger" : btnColor)"
         ButtonText="@(confirmation != "Export" ? "Delete" : btnText)"
         Title="@(confirmation != "Export"
                 ? "Are you sure you want to delete this Labour Dc In_Out?"
                 : ModalTitle)">
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="View PO Track Report"
                        TitleIcon="bi bi-receipt-cutoff"
                        Breadcrumbs="@POTrackBreadcrumbs" />

            <div class="card-body  bg-light">

                <!-- Date Section -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">From Date</label>
                        <input type="date" class="form-control shadow-sm" @bind="FromDate" @bind:after="OnDateChanged" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">To Date</label>
                        <input type="date" class="form-control shadow-sm" @bind="ToDate" @bind:after="OnDateChanged" />
                    </div>
                </div>

                <div class="row row g-3">

                    <div class="col-12 col-md-4">

                        <div class="card shadow-sm border-0 h-100">

                            <div class="card-header fw-semibold p-2 small d-flex align-items-center gap-2 text-white " style="background:#2c6fdb;">
                                <i class="bi bi-diagram-3"></i>
                                Topic
                            </div>


                            <div class="card-body py-2">
                                <InputRadioGroup TValue="string"
                                                 Value="Topic"
                                                 ValueChanged="OnTopicChanged"
                                                 ValueExpression="() => Topic">

                                    <div class="d-flex flex-column flex-md-row gap-3">

                                        <div class="form-check">
                                            <InputRadio TValue="string"
                                                        Value="@("Sales")"
                                                        class="form-check-input border border-2 border-dark" />
                                            <label class="form-check-label">
                                                Sales
                                            </label>
                                        </div>

                                        <div class="form-check">
                                            <InputRadio TValue="string"
                                                        Value="@("SubContract")"
                                                        class="form-check-input border border-2 border-dark" />
                                            <label class="form-check-label">
                                                Out_Sourcing
                                            </label>
                                        </div>

                                    </div>

                                </InputRadioGroup>
                            </div>

                        </div>
                    </div>

                    <div class="col-12 col-md-4">

                        <div class="card shadow-sm border-0 h-100">

                            <!-- Header -->
                            <div class="card-header text-white fw-semibold small d-flex align-items-center border-0"
                                 style="background-color: #0a535d;">
                                <i class="bi bi-people me-2 text-light fs-6"></i>
                                Select Party
                            </div>

                            <!-- Body -->
                            <div class="card-body py-2 d-flex flex-column" style="height:200px;">

                                @if (Topic == "Sales")
                                {
                                    <!-- Search -->
                                    <input class="form-control form-control-sm mb-2"
                                           placeholder="Search Customer..."
                                           @oninput="OnCustomerSearchChange"
                                           value="@customerSearch" />

                                    <!-- Scroll Area -->
                                    <div class="list-group flex-grow-1 overflow-auto">

                                        <!-- ALL -->
                                        <button type="button" class="list-group-item list-group-item-action small
                                                        @(SelectedCustomer?.CustId == 0 ? "bg-info bg-opacity-25 border-info" : "")"
                                                @onclick="() => SelectCustomer(AllCustomer)">
                                            ALL
                                        </button>

                                        <!-- Customers -->
                                        @foreach (var customer in FilteredCustomers)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action small
                                                                @(SelectedCustomer?.CustId == customer.CustId ? "bg-info bg-opacity-25 border-info" : "")"
                                                    @onclick="() => SelectCustomer(customer)">

                                                @customer.CustName

                                            </button>
                                        }

                                    </div>
                                }
                                else if (Topic == "SubContract")
                                {
                                    <!-- Search -->
                                    <input class="form-control form-control-sm mb-2"
                                           placeholder="Search Supplier..."
                                           @oninput="OnSupplierSearchChange"
                                           value="@vendorSearch" />

                                    <!-- Scroll Area -->
                                    <div class="list-group flex-grow-1 overflow-auto">

                                        <!-- ALL -->
                                        <button type="button"
                                                class="list-group-item list-group-item-action small
                                                        @(SelectedSupplier?.VendorCode == 0 ? "bg-info bg-opacity-25 border-info" : "")"
                                                @onclick="() => SelectSupplier(AllVendor)">
                                            ALL
                                        </button>

                                        <!-- Suppliers -->
                                        @foreach (var supplier in FilteredSuppliers)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action small
                                                                @(SelectedSupplier?.VendorCode == supplier.VendorCode ? "bg-info bg-opacity-25 border-info" : "")"
                                                    @onclick="() => SelectSupplier(supplier)">

                                                @supplier.VendorName

                                            </button>
                                        }

                                    </div>
                                }

                            </div>

                        </div>
                    </div>

                </div>

                @if ((CustomerViewFiltered != null && CustomerViewFiltered.Any()) || (VendorViewFiltered != null && VendorViewFiltered.Any()))
                {
                    <div class="col-12 mt-3 mb-2">

                        <div class="card shadow-sm border-1" style="background: linear-gradient(135deg, #f9f9f9, #ffffff); border: 1px solid #e0e6ed;">

                            <div class="card-header bg-primary-subtle text-dark">

                                <div class="row g-3 align-items-center mb-1">

                                    <!-- Title -->
                                    <div class="col-12 col-lg-2">
                                        <span class="fw-bold fs-6">
                                            Tally Dc Item Details
                                        </span>
                                    </div>

                                    <div class="col-12 col-lg-2">
                                        <div class="dropdown position-relative" style="z-index:1055;">
                                            <ColumnMenu Columns="@(Topic != "SubContract" ? CustomerColumns : SupplierColumns)"
                                                        ScreenName="@ScreenName"
                                                        UserId="@UserName"
                                                        MaxVisible="@int.MaxValue"
                                                        OnChanged="HandleColumnChange" />
                                        </div>
                                    </div>

                                    <!-- Print -->
                                    <div class="col-12 col-lg-2 gap-3">
                                        <button class="btn btn-outline-primary w-100 text-nowrap"
                                                @onclick="HandleExport"
                                                title="Export Report to Excel">
                                            <i class="bi bi-printer me-1"></i> Print
                                        </button>
                                    </div>

                                    <!-- Search -->
                                    <div class="col-12 col-lg-3">
                                        <div class="input-group w-100">
                                            <span class="input-group-text bg-white">
                                                <i class="bi bi-search text-muted"></i>
                                            </span>

                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="Search here..."
                                                   value="@searchText"
                                                   @oninput="OnInputChanged" />
                                        </div>
                                    </div>

                                </div>

                            </div>

                            <div class="card-body p-0">

                                @*  <div class="table-responsive" style="overflow-x:auto;"> *@
                                <div class="table-responsive border rounded" style="max-height:600px; overflow-x:auto; overflow-y:auto;">

                                    <table class="table table-bordered table-sm mb-0 align-middle" style="min-width:1900px; white-space:nowrap;">

                                        <thead class="custom-blue text-center align-middle sticky-top">

                                            <tr>
                                                @if (Topic == "Sales")
                                                {
                                                    @foreach (var col in CustomerColumns.Where(x => x.IsVisible))
                                                    {
                                                        <th style="min-width:@col.Width;">
                                                            @col.Title
                                                        </th>
                                                    }

                                                }
                                                else if (Topic == "SubContract")
                                                {
                                                    @foreach (var col in SupplierColumns.Where(x => x.IsVisible))
                                                    {
                                                        <th style="min-width:@col.Width;">
                                                            @col.Title
                                                        </th>
                                                    }
                                                }


                                            </tr>

                                        </thead>
                                        <tbody class="custom-size">

                                            @if (Topic == "Sales")
                                            {
                                                i = 1;

                                                @foreach (var row in FilteredPoTrackCustomerData)
                                                {
                                                    <tr class="@(row.Type == "Labour" ? "table-warning" : "table-light")">

                                                        @foreach (var col in CustomerColumns.Where(x => x.IsVisible))
                                                        {
                                                            <td class="@col.Align">

                                                                @switch (col.Field)
                                                                {
                                                                    case "SlNo":
                                                                        <text>@i</text>
                                                                        break;

                                                                    case "Customer":
                                                                        @row.Customer
                                                                        break;
                                                                    case "Type":
                                                                        @row.Type
                                                                        break;

                                                                    case "PoNo":
                                                                        @row.PoNo
                                                                        break;

                                                                    case "PODate":
                                                                        @(row.PODate?.ToString("dd/MM/yyyy"))
                                                                        break;
                                                                    case "LineNo":
                                                                        @row.LineNo
                                                                        break;

                                                                    case "PoCancel":
                                                                        @row.PoCancel
                                                                        break;

                                                                    case "ItemCode":
                                                                        @row.ItemCode
                                                                        break;

                                                                    case "ItemName":
                                                                        @row.ItemName
                                                                        break;
                                                                    case "Specification":
                                                                        @row.Specification
                                                                        break;

                                                                    case "UOM":
                                                                        @row.UOM
                                                                        break;

                                                                    case "HSNCode":
                                                                        @row.HSNCode
                                                                        break;

                                                                    case "Qty":
                                                                        @row.Qty
                                                                        break;

                                                                    case "BalQty":
                                                                        @row.BalQty
                                                                        break;

                                                                    case "UnitPrice":
                                                                        @row.UnitPrice
                                                                        break;

                                                                    case "ItemCancel":
                                                                        @row.ItemCancel
                                                                        break;

                                                                    case "GRNNo":
                                                                        @row.GRNNo
                                                                        break;

                                                                    case "GRNDate":
                                                                        @(row.GRNDate?.ToString("dd/MM/yyyy"))
                                                                        break;

                                                                    case "RefDcNo":
                                                                        @row.RefDcNo
                                                                        break;

                                                                    case "RefDcDate":
                                                                        @(row.RefDcDate?.ToString("dd/MM/yyyy"))
                                                                        break;

                                                                    case "GRNQty":
                                                                        @row.GRNQty
                                                                        break;

                                                                    case "GRNBalQty":
                                                                        @row.GRNBalQty
                                                                        break;

                                                                    case "DcNo":
                                                                        @row.DcNo
                                                                        break;

                                                                    case "DcDate":
                                                                        @(row.DcDate?.ToString("dd/MM/yyyy"))
                                                                        break;

                                                                    case "DcQty":
                                                                        @row.DcQty
                                                                        break;

                                                                    case "DcBalQty":
                                                                        @row.DcBalQty
                                                                        break;

                                                                    case "InvNo":
                                                                        @row.InvNo
                                                                        break;

                                                                    case "InvDate":
                                                                        @(row.InvDate?.ToString("dd/MM/yyyy"))
                                                                        break;

                                                                    case "InvQty":
                                                                        @row.InvQty
                                                                        break;

                                                                    case "RcNo":
                                                                        @row.RcNo
                                                                        break;

                                                                    case "RcDate":
                                                                        @(row.RcDate?.ToString("dd/MM/yyyy"))
                                                                        break;

                                                                }

                                                            </td>
                                                        }

                                                    </tr>
                                                    i++;
                                                }

                                            }
                                            else if (Topic == "SubContract")
                                            {
                                                i = 1;

                                                @foreach (var row in FilteredPoTrackVendorData)
                                                {
                                                    <tr class="@(row.Type == "Purchase" ? "table-warning" : "table-light")">

                                                        @foreach (var col in SupplierColumns.Where(x => x.IsVisible))
                                                        {
                                                            <td class="@col.Align">

                                                                @switch (col.Field)
                                                                {
                                                                    case "SlNo":
                                                                        <text>@i</text>
                                                                        break;

                                                                    case "Supplier":
                                                                        @row.Supplier
                                                                        break;

                                                                    case "Type":
                                                                        @row.Type
                                                                        break;

                                                                    case "PoNo":
                                                                        @row.PoNo
                                                                        break;

                                                                    case "PODate":
                                                                        @(row.PODate?.ToString("dd/MM/yyyy"));
                                                                        break;

                                                                    case "PoCancel":
                                                                        @row.PoCancel
                                                                        break;

                                                                    case "ItemCode":
                                                                        @row.ItemCode
                                                                        break;

                                                                    case "ItemName":
                                                                        @row.ItemName
                                                                        break;

                                                                    case "MeasureUnit":
                                                                        @row.UOM
                                                                        break;

                                                                    case "HSNCode":
                                                                        @row.HSNCode
                                                                        break;
                                                                    case "ItemCancel":
                                                                        @row.ItemCancel
                                                                        break;

                                                                    case "Qty":
                                                                        @row.Qty
                                                                        break;

                                                                    case "BalQty":
                                                                        @row.BalQty
                                                                        break;

                                                                    case "DcNo":
                                                                        @row.DcNo
                                                                        break;

                                                                    case "DcDate":
                                                                        @(row.DcDate?.ToString("dd/MM/yyyy"));
                                                                        break;

                                                                    case "DcQty":
                                                                        @row.DcQty
                                                                        break;

                                                                    case "DcBalQty":
                                                                        @row.DcBalQty
                                                                        break;

                                                                    case "GRNNo":
                                                                        @row.GRNNo
                                                                        break;

                                                                    case "GRNDate":
                                                                        @(row.GRNDate?.ToString("dd/MM/yyyy"));
                                                                        break;

                                                                    case "RefDcNo":
                                                                        @row.RefDcNo
                                                                        break;

                                                                    case "RefDcDate":
                                                                        @(row.RefDcDate?.ToString("dd/MM/yyyy"));
                                                                        break;

                                                                    case "GRNQty":
                                                                        @row.GRNQty
                                                                        break;

                                                                    case "GRNBalQty":
                                                                        @row.GRNBalQty
                                                                        break;

                                                                    case "SCNNo":
                                                                        @row.SCNNo
                                                                        break;

                                                                    case "SCNDate":
                                                                        @(row.SCNDate?.ToString("dd/MM/yyyy"));
                                                                        break;

                                                                    case "AcceptQty":
                                                                        @row.AcceptQty
                                                                        break;

                                                                    case "RejectQty":
                                                                        @row.RejectQty
                                                                        break;

                                                                    case "ReworkQty":
                                                                        @row.ReworkQty
                                                                        break;

                                                                    case "InvNo":
                                                                        @row.InvNo
                                                                        break;

                                                                    case "InvDate":
                                                                        @(row.InvDate?.ToString("dd/MM/yyyy"));
                                                                        break;

                                                                    case "InvQty":
                                                                        @row.InvQty
                                                                        break;
                                                                }

                                                            </td>
                                                        }

                                                    </tr>
                                                    i++;
                                                }
                                            }


                                        </tbody>


                                    </table>

                                </div>

                            </div>

                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mt-3">
                        No records found.
                    </div>
                }



            </div>
        </div>
    </div>


}


@code
{
    protected override string ScreenName => "View Po Track";

    private string Topic = "Sales";
    private string searchText = string.Empty;

    private bool isProcessing = true;
    private string? UserName;
    private DateTime FromDate = DateTime.Today.AddDays(-30);
    private DateTime ToDate = DateTime.Today.AddDays(1);

    private int SelectedCustId { get; set; }
    private int SelectedSupplierCode { get; set; }
    private int SelectedItemId { get; set; }

    int i = 0;

    public List<CustomerVM> Customers { get; set; } = new();
    public List<VendorVM> Suppliers { get; set; } = new();

    private CustomerVM? SelectedCustomer { get; set; }
    private VendorVM? SelectedSupplier { get; set; }

    public List<GridColumn> CustomerColumns { get; set; } = new();
    public List<GridColumn> SupplierColumns { get; set; } = new();

    private string customerSearch { get; set; } = string.Empty;
    private string vendorSearch { get; set; } = string.Empty;

    private CustomerVM AllCustomer = new CustomerVM { CustId = 0, CustName = "ALL" };
    private VendorVM AllVendor = new VendorVM { VendorCode = 0, VendorName = "ALL" };

    public List<InwardPOTrack> AllCustomerPos { get; set; } = new();
    public List<PurchasePOTrack> AllVendorPos { get; set; } = new();

    public List<InwardPOTrack> CustomerViewFiltered { get; set; } = new();
    public List<PurchasePOTrack> VendorViewFiltered { get; set; } = new();

    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = "";
    private string btnColor = string.Empty;
    private bool showCancelReasonBox = false;
    public string? cancelReason { get; set; }

    private List<PageHeader.BreadcrumbItem> POTrackBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Reports" },
        new PageHeader.BreadcrumbItem { Text = "Track Reports" },
        new PageHeader.BreadcrumbItem { Text = "PO Track", IsLast = true }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            await OnTopicChanged("Sales");
            await InitializeColumns(IsHidden);

            AllCustomerPos = await _tallyTrack.GetInwordPOTrack(FromDate, ToDate);

            AllVendorPos = await _tallyTrack.GePurchasePOTrack(FromDate, ToDate);

            UserName = await CurrentUserService.GetUsernameAsync();
            await LoadCustomerColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex, "Error in View DC In_Out Tally Track OnInitializedAsync");
        }
        finally
        {
            isProcessing = false;
        }
    }

    IEnumerable<CustomerVM> FilteredCustomers => Customers.Where(s => string.IsNullOrWhiteSpace(customerSearch) || s.CustName.Contains(customerSearch, StringComparison.OrdinalIgnoreCase));

    IEnumerable<VendorVM> FilteredSuppliers => Suppliers.Where(s => string.IsNullOrWhiteSpace(vendorSearch) || s.VendorName.Contains(vendorSearch, StringComparison.OrdinalIgnoreCase));

    IEnumerable<InwardPOTrack> FilteredPoTrackCustomerData =>
        CustomerViewFiltered?.Where(s =>
            string.IsNullOrWhiteSpace(searchText) ||

            (!string.IsNullOrEmpty(s.ItemCode) &&
             s.ItemCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.ItemName) &&
             s.ItemName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.HSNCode) &&
             s.HSNCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.UOM) &&
             s.UOM.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.Customer) &&
             s.Customer.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

             (!string.IsNullOrEmpty(s.Type) &&
             s.Type.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.GRNNo) &&
             s.GRNNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (s.GRNDate?.ToString("dd/MM/yyyy")
                .Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||

            (!string.IsNullOrEmpty(s.RefDcNo) &&
             s.RefDcNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (s.RefDcDate?.ToString("dd/MM/yyyy")
                .Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||

            (!string.IsNullOrEmpty(s.DcNo) &&
             s.DcNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (s.DcDate?.ToString("dd/MM/yyyy")
                .Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||

            (!string.IsNullOrEmpty(s.PoNo) &&
             s.PoNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (!string.IsNullOrEmpty(s.InvNo) &&
             s.InvNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

            (s.InvDate?.ToString("dd/MM/yyyy")
                .Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||

            (s.RcDate?.ToString("dd/MM/yyyy")
                .Contains(searchText, StringComparison.OrdinalIgnoreCase) == true)

        ) ?? Enumerable.Empty<InwardPOTrack>();

    IEnumerable<PurchasePOTrack> FilteredPoTrackVendorData =>
      VendorViewFiltered?.Where(s =>
          string.IsNullOrWhiteSpace(searchText) ||

          (!string.IsNullOrEmpty(s.ItemCode) &&
           s.ItemCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (!string.IsNullOrEmpty(s.ItemName) &&
           s.ItemName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (!string.IsNullOrEmpty(s.HSNCode) &&
           s.HSNCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (!string.IsNullOrEmpty(s.UOM) &&
           s.UOM.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (!string.IsNullOrEmpty(s.Supplier) &&
           s.Supplier.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (!string.IsNullOrEmpty(s.Type) &&
           s.Type.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (!string.IsNullOrEmpty(s.GRNNo) &&
           s.GRNNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (s.GRNDate?.ToString("dd/MM/yyyy")
              .Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||

          (!string.IsNullOrEmpty(s.RefDcNo) &&
           s.RefDcNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (s.RefDcDate?.ToString("dd/MM/yyyy")
              .Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||

          (!string.IsNullOrEmpty(s.DcNo) &&
           s.DcNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (s.DcDate?.ToString("dd/MM/yyyy")
              .Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||

          (!string.IsNullOrEmpty(s.PoNo) &&
           s.PoNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (!string.IsNullOrEmpty(s.InvNo) &&
           s.InvNo.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||

          (s.InvDate?.ToString("dd/MM/yyyy")
              .Contains(searchText, StringComparison.OrdinalIgnoreCase) == true)

      ) ?? Enumerable.Empty<PurchasePOTrack>();

    public async Task InitializeColumns(bool Hidden)
    {
        try
        {
            if (Topic == "Sales")
            {
                CustomerColumns = new List<GridColumn>
                {
                    new() { Title = "Sl No.",        Field = "SlNo",       Width = "80px",  IsVisible = true },
                    new() { Title = "Customer",      Field = "Customer",   Width = "200px", IsVisible = true },
                    new() { Title = "Type",          Field = "Type",       Width = "120px", IsVisible = true },
                    new() { Title = "PO No.",         Field = "PoNo",       Width = "150px", IsVisible = true },
                    new() { Title = "PO Date",       Field = "PODate",     Width = "120px", IsVisible = true },
                    new() { Title = "Line No.",       Field = "LineNo",     Width = "80px",  IsVisible = true },
                    new() { Title = "PO Cancel",     Field = "PoCancel",   Width = "100px", IsVisible = true },

                    new() { Title = "Item Code",     Field = "ItemCode",   Width = "150px", IsVisible = true },
                    new() { Title = "Item Name",     Field = "ItemName",   Width = "250px", IsVisible = true },
                    new() { Title = "Specification", Field = "Specification", Width = "250px", IsVisible = true },
                    new() { Title = "UOM",           Field = "UOM",        Width = "80px",  IsVisible = true },
                    new() { Title = "HSN Code",      Field = "HSNCode",    Width = "120px", IsVisible = true },

                    new() { Title = "Qty",           Field = "Qty",        Width = "100px", IsVisible = true },
                    new() { Title = "Balance Qty",   Field = "BalQty",     Width = "100px", IsVisible = true },
                    new() { Title = "Unit Price",   Field = "UnitPrice",     Width = "100px", IsVisible = true },
                    new() { Title = "Item Cancel",   Field = "ItemCancel", Width = "100px", IsVisible = true },

