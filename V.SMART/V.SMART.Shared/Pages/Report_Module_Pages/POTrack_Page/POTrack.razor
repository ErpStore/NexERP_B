    private async Task HandleExport()
    {

        ModalTitle = "Are you sure you want to export data to Excel?";
        btnColor = "btn-success";
        btnText = "Yes";
        confirmation = "Export";
        await _JS.InvokeVoidAsync("ShowConfirmationModal");
    }
    private async Task ExportToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;
            await _JS.InvokeVoidAsync("HideConfirmationModal");
            if (!isConfirm) return;

            List<Dictionary<string, object>> exportData = new();

            if (Topic == "Sales")
            {
                if (CustomerViewFiltered != null
                    && CustomerViewFiltered.Any())
                {
                    exportData = GetExportData(
                        CustomerViewFiltered.ToList());
                }
            }
            else if (Topic == "SubContract")
            {
                if (VendorViewFiltered != null && VendorViewFiltered.Any())
                {
                    exportData = GetExportData(VendorViewFiltered.ToList());
                }
            }

            if (!exportData.Any())
                return;

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "AllPo Track", "AllPoTrack List");

            var base64 = Convert.ToBase64String(bytes);

            await _JS.DownloadExcelAsync(base64, "AllPoTrack.xlsx");

        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(ex,
                "Error in AllPoTrack (Po's)");
            await _JS.ToastrError("Error while exporting AllPoTrack!");
        }
        finally
        {
            isProcessing = false;
        }
    }


    private async Task confirmation_Click(bool isConfirmed)
    {
        try
        {
            await _JS.InvokeVoidAsync("HideConfirmationModal");

            if (isConfirmed && confirmation == "Export")
            {
                await ExportToExcel(isConfirmed);
                confirmation = "";
            }

        }
        catch (Exception ex)
        {

            await LoggingService.LogDeveloperError(ex, "An error occurred while handling the Export Po Track  Data confirmation_Click() method");
            await _JS.ToastrError("An error occurred while handling the Po Track  Data  confirmation_Click() method");
        }
    }

    private List<Dictionary<string, object>> GetExportData<T>(List<T> data)
    {
        return data
        .Select(row =>
        {
            var dict = new Dictionary<string, object>();

            if (Topic == "Sales")
            {
                foreach (var col in CustomerColumns.Where(x => x.IsVisible))
                {
                    var prop = typeof(T).GetProperty(col.Field);

                    if (prop != null)
                    {
                        dict[col.Title] = prop.GetValue(row);
                    }
                }
            }
            else if (Topic == "SubContract")
            {
                foreach (var col in SupplierColumns.Where(x => x.IsVisible))
                {
                    var prop = typeof(T).GetProperty(col.Field);

                    if (prop != null)
                    {
                        dict[col.Title] = prop.GetValue(row);
                    }
                }
            }

            return dict;
        })
        .ToList();
    }
