    private void ApplyDetailView()
    {
        if (TaxDetailsList == null)
            return;

        FilteredData = IsDetailView
            ? TaxDetailsList.ToList()
            : TaxDetailsList
                .GroupBy(x => new
                {
                    InvNo = x.InvNo?.Trim(),
                    Topic = x.InvType?.Trim()
                })
                .Select(g => g.First())
                .ToList();

        int slNo = 1;

        foreach (var item in FilteredData)
        {
            item.SlNo = slNo++;
        }
    }

    private async Task OnDetailViewChanged()
    {
        ApplyDetailView();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenAttachmentButton(string InvNo, int count)
    {
        try
        {
            if (String.IsNullOrEmpty(InvNo))
            {
                await _js.ToastrWarning("Please select Invoice");
                return;
            }

            if (count == 0)
            {
                await _js.ToastrWarning("No attachments found.");
                return;
            }

            AttachItemSelected = TaxDetailsList.FirstOrDefault(i => i.InvNo == InvNo);

            if (AttachItemSelected == null)
            {
                await _js.ToastrError("Invoice not found.");
                return;
            }

            MasterModalTitle = $"Attachments - {AttachItemSelected.InvNo}";

            invoiceNo = AttachItemSelected.InvNo;

            invoiceNo = invoiceNo.Split('/')[0];

            isModalVisible = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OpenAttachmentButton");
            await _js.ToastrError("Error while opening attachments.");
        }
    }
