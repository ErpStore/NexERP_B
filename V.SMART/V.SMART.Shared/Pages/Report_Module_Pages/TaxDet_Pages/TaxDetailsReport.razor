    private async Task OnTopicClick(string topic)
    {
        SelectedTopic = topic;

        TaxDetailsList = new();

        CustomerList = new();
        VendorList = new();

        FilteredData = new();

        FilteredCustomers = new();
        FilteredVendors = new();

        SelectedPartyId = 0;

        if (FromDate == null || ToDate == null)
        {
            await _js.ToastrWarning("Please select From Date and To Date");
            return;
        }

        if (FromDate > ToDate)
        {
            await _js.ToastrWarning("From Date cannot be greater than To Date");
            return;
        }

        if (SelectedTopic == "Sales")
        {
            CustomerList = await customerService.GetCustomerListAsync(
                SelectedTopic,
                FromDate.Value,
                ToDate.Value);

            FilteredCustomers = CustomerList.ToList();
        }
        else if (SelectedTopic == "Exports")
        {
            CustomerList = await customerService.GetCustomerListAsync(
                SelectedTopic,
                FromDate.Value,
                ToDate.Value);

            FilteredCustomers = CustomerList.ToList();
        }
        else if (SelectedTopic == "Purchase")
        {
            VendorList = await vendorService.GetVendorListAsync(
                SelectedTopic,
                FromDate.Value,
                ToDate.Value);

            FilteredVendors = VendorList.ToList();
        }

        StateHasChanged();
    }



    private async Task OnPartyChanged(ChangeEventArgs e)
    {
        try
        {
            if (e.Value == null)
                return;

            // START LOADING
            IsLoading = true;
            StateHasChanged();
            // DATE VALIDATION
            if (FromDate == null || ToDate == null)
            {
                await _js.ToastrError("Please select From Date and To Date");
                return;
            }

            if (FromDate > ToDate)
            {
                await _js.ToastrError("From Date cannot be greater than To Date");
                return;
            }

            TaxDetailsList = new();
            var selectedValue = e.Value.ToString();
            // ================= ALL =================
            if (selectedValue == "ALL")
            {
                TaxDetailsList = await taxDetailsService.GetTaxDetailsReportAsync(null, null, SelectedTopic, FromDate, ToDate);
                int allIndex = 1;
                foreach (var item in TaxDetailsList)
                {
                    item.SlNo = allIndex++;
                }
                // STOP LOADING
                IsLoading = false;
                StateHasChanged();
                return;
            }
            // ================= PURCHASE =================
            if (SelectedTopic == "Purchase")
            {
                SelectedVendorCode = Convert.ToInt32(selectedValue);

                TaxDetailsList = await taxDetailsService.GetTaxDetailsReportAsync(null, SelectedVendorCode, SelectedTopic, FromDate, ToDate);
            }
            // ================= SALES / EXPORT =================
            else
            {
                SelectedPartyId =
                    Convert.ToInt32(selectedValue);

                TaxDetailsList = await taxDetailsService.GetTaxDetailsReportAsync(SelectedPartyId, null, SelectedTopic, FromDate, ToDate);
            }
            int i = 1;
            foreach (var item in TaxDetailsList)
            {
                item.SlNo = i++;
            }
            // IMPORTANT
            FilteredData = TaxDetailsList;

            // STOP LOADING
            IsLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in OnPartyChanged");
        }
    }


