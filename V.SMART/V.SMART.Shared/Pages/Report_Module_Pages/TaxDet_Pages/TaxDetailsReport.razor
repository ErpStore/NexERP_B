    private void OnPartySearchChange(ChangeEventArgs e)
    {
        partySearch = e.Value?.ToString() ?? "";

        // ================= PURCHASE =================

        if (SelectedTopic == "Purchase")
        {
            FilteredVendors = VendorList
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.VendorName) &&
                    x.VendorName.Contains(
                        partySearch,
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        // ================= SALES / EXPORT =================

        else
        {
            FilteredCustomers = CustomerList
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.CustName) &&
                    x.CustName.Contains(
                        partySearch,
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task SelectParty(string selectedText)
    {
        try
        {
            partySearch = selectedText;

            IsLoading = true;

            TaxDetailsList = new();

            // ================= ALL =================

            if (selectedText == "ALL")
            {
                IsAllSelected = true;
                SelectedPartyId = 0;
                SelectedVendorCode = 0;
                TaxDetailsList = await taxDetailsService.GetTaxDetailsReportAsync(null,null,SelectedTopic,FromDate,ToDate);
            }

            // ================= PURCHASE =================

            else if (SelectedTopic == "Purchase")
            {
                IsAllSelected = false;
                var vendor = VendorList
                    .FirstOrDefault(x =>
                        x.VendorName == selectedText);

                if (vendor != null)
                {
                    SelectedVendorCode = vendor.VendorCode;

                    TaxDetailsList = await taxDetailsService.GetTaxDetailsReportAsync(null,SelectedVendorCode,SelectedTopic,FromDate,ToDate);
                }
            }

            // ================= SALES / EXPORT =================

            else
            {
                IsAllSelected = false;
                var customer = CustomerList
                    .FirstOrDefault(x =>
                        x.CustName == selectedText);

                if (customer != null)
                {
                    SelectedPartyId = customer.CustId;

                    TaxDetailsList = await taxDetailsService.GetTaxDetailsReportAsync(SelectedPartyId,null,SelectedTopic,FromDate,ToDate);
                }
            }
            if (TaxDetailsList != null)
            {
                foreach (var item in TaxDetailsList)
                {
                    if (item.InvId != null)
                    {
                        attachmentCounts[item.InvId??0] = await taxDetailsService.GetCorrespondenceAttachmentsCountAsync(item.InvId??0, "Labour-Invoice");
                    }
                }
            }

            ApplyDetailView();


            IsLoading = false;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            IsLoading = false;

            await _logs.LogDeveloperError(ex, "Error in SelectParty");
        }
    }



