@page "/taxDetailsList"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.ITaxDetailsReportService
@using V.SMART.Shared.ViewModels.ReportViewModel.TaxDetailsReportViewModel

@inherits BaseUserRightsComponent

@inject ILoggingService _logs
@inject CurrentUserService _userService
@inject IJSRuntime _js
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService
@inject ICustomerService customerService
@inject IVendorService vendorService
@inject ITaxDetailsService taxDetailsService
@inject ExcelExportService ExcelExportService
@inject IColumnPreferenceService PreferenceService
@inject CurrentUserService CurrentUserService

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle>
</BsModal>

<MasterModal IsVisible="isModalVisible" Title="@MasterModalTitle" MaxWidth="1200px" OnClose="CloseModal">
    <CorrespondenceListByReference refType="Labour-Invoice" refId="@(AttachItemSelected.InvId ?? 0)"
                                   refName="@invoiceNo" docType="Correspondence" isModelVisible="true" />
</MasterModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="TaxDetails Report"
                        TitleIcon="bi bi-list-check"
                        Breadcrumbs="@TaxDetailsBreadcrumbs" />

            <div class="card-body bg-light">
                <div class="card shadow-sm border-0 h-100">

                    <div class="card border-0 shadow-sm rounded-3 mb-1">


                        <!-- BODY -->
                        <div class="card-body p-3 bg-light">

                            <div class="row g-3">

                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <label class="mb-0">From Date</label>
                                    <InputDate @bind-Value="FromDate"
                                               @bind-Value:after="DateChanged"
                                               class="form-control form-control-sm w-auto" />

                                    <label class="mb-0 ms-3">To Date</label>
                                    <InputDate @bind-Value="ToDate"
                                               @bind-Value:after="DateChanged"
                                               class="form-control form-control-sm w-auto" />
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row g-3 mt-1">

                        <!-- TOPIC CARD -->
                        <div class="col-12 col-md-4">

                            <div class="card border-0 shadow rounded-3 h-100 overflow-hidden">

                                <!-- HEADER -->
                                <div class="card-header border-0 text-white py-2 px-2"
                                     style="background: linear-gradient(135deg, #0a535d, #117a8b);">

                                    <div class="d-flex align-items-center">
                                        
                                        <div>
                                            <div class="fw-bold">
                                                <i class="bi bi-book-half text-white"></i> Topic
                                            </div>

                                           
                                        </div>
                                    </div>
                                </div>

                                <!-- BODY -->
                                <div class="card-body p-2 bg-light" style="height:280px;">
                                    
                                    <div class="d-grid gap-2">

                                        <!-- SALES -->
                                        <button type="button"
                                                class="btn text-start rounded-4 border fw-semibold py-2 px-2 shadow-sm
                                                    @(SelectedTopic == "Sales" ? "btn-primary text-white" : "btn-light")"
                                            @onclick='() => OnTopicClick("Sales")'>

                                            <div class="d-flex justify-content-between align-items-center">

                                                <div>
                                                    <div class="fw-bold">
                                                        Sales
                                                    </div>

                                                    <small class="opacity-75">
                                                        Domestic sales transactions
                                                    </small>
                                                </div>

                                                <span class="badge bg-white text-primary rounded-pill px-2">
                                                    01
                                                </span>
                                            </div>
                                        </button>

                                        <!-- EXPORTS -->
                                        <button type="button"
                                                class="btn text-start rounded-4 border fw-semibold py-2 px-2 shadow-sm
                                                         @(SelectedTopic == "Exports" ? "btn-primary text-white" : "btn-light")"
                                                @onclick='() => OnTopicClick("Exports")'>

                                            <div class="d-flex justify-content-between align-items-center">

                                                <div>
                                                    <div class="fw-bold">
                                                        Exports
                                                    </div>

                                                    <small class="opacity-75">
                                                        International export reports
                                                    </small>
                                                </div>

                                                <span class="badge bg-white text-primary rounded-pill px-2">
                                                    02
                                                </span>
                                            </div>
                                        </button>

                                        <!-- OUTSOURCING -->
                                        <button type="button"
                                                class="btn text-start rounded-4 border fw-semibold py-2 px-2 shadow-sm
                                                    @(SelectedTopic == "Purchase" ? "btn-primary text-white" : "btn-light")"
                                                @onclick='() => OnTopicClick("Purchase")'>

                                            <div class="d-flex justify-content-between align-items-center">

                                                <div>
                                                    <div class="fw-bold">
                                                        OutSourcing
                                                    </div>

                                                    <small class="opacity-75">
                                                        Purchase & outsourcing details
                                                    </small>
                                                </div>

                                                <span class="badge bg-white text-primary rounded-pill px-2">
                                                    03
                                                </span>
                                            </div>
                                        </button>

                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- PARTY NAME -->
                        <div class="col-12 col-md-4">

                          
                            <div class="card border-0 shadow rounded-3 h-100 overflow-hidden">
                                <div class="card shadow border-0 rounded-3">
                                    <!-- HEADER -->
                                   
                                    <div class="card-header border-0 text-white py-2 px-2"
                                         style="background-color:#b57281;">

                                        <i class="bi bi-grid-fill me-2 text-light fs-6"></i>

                                        Select Party Name

                                    </div>


                                    <div class="card-body p-2 d-flex flex-column" style="height:280px;">

                                        <!-- SEARCH -->
                                        <input class="form-control form-control-sm"
                                               placeholder="Search Party..."
                                               value="@partySearch"
                                               @oninput="OnPartySearchChange" />

                                        <!-- PARTY LIST -->
                                        @* <div class="border rounded shadow-sm bg-white mt-1  overflow-auto"> *@
                                        <div class="border rounded shadow-sm bg-white mt-3 p-2 flex-grow-1 overflow-auto">

                                            <!-- DROPDOWN LIST -->
                                            
                                                <!-- ALL OPTION -->
                                                <div class="dropdown-item cursor-pointer
                                                         @(IsAllSelected ? "text-white fw-bold" : "")"
                                                 style="@(IsAllSelected ? "background-color:#815355;" : "")"
                                                     @onclick='() => SelectParty("ALL")'>

                                                    All
                                                </div>

                                                @if (SelectedTopic == "Sales")
                                                {
                                                    @foreach (var item in FilteredCustomers)
                                                    {
                                                        <div class="dropdown-item cursor-pointer
                                                             @(SelectedPartyId == item.CustId ? "text-white fw-bold" : "")"
                                                             style="@(SelectedPartyId == item.CustId ? "background-color:#815355;" : "")"
                                                             @onclick='() => SelectParty(item.CustName)'>

                                                            @item.CustName
                                                        </div>
                                                    }
                                                }
                                                else if (SelectedTopic == "Exports")
                                                {
                                                    @foreach (var item in FilteredCustomers)
                                                    {
                                                    <div class="dropdown-item cursor-pointer 
                                                             @(SelectedPartyId == item.CustId ? "text-white fw-bold" : "")"
                                                             style="@(SelectedPartyId == item.CustId ? "background-color:#815355;" : "")"
                                                             @onclick='() => SelectParty(item.CustName)'>

                                                            @item.CustName
                                                        </div>
                                                    }
                                                }

                                                else if (SelectedTopic == "Purchase")
                                                {
                                                    @foreach (var item in FilteredVendors)
                                                    {
                                                    <div class="dropdown-item cursor-pointer 
                                                         @(SelectedVendorCode == item.VendorCode ? "text-white fw-bold" : "")"
                                                         style="@(SelectedPartyId == item.VendorCode ? "background-color:#815355;" : "")"
                                                             @onclick='() => SelectParty(item.VendorName)'>

                                                            @item.VendorName
                                                        </div>
                                                    }
                                                }
                                           @*  </div> *@

                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>

                        <!-- ITEMS -->
                        <div class="col-12 col-md-4">

                            <div class="card shadow-sm border-0 h-100">

                                <!-- CARD -->
                                <div class="card shadow border-0 rounded-3">

                                    <!-- HEADER -->
                                    <div class="card-header text-white py-2" style="background-color:#4d4d4d;">
                                        <div class="fw-bold">
                                            <i class="bi bi-card-list text-white"></i> Tax Summary
                                        </div>
                                    </div>

                                    <!-- CARD BODY -->
                                    <div class="card-body p-2"style="height:280px;">

                                        <!-- DETAIL VIEW -->
                                        <div class="d-flex justify-content-between align-items-center
                                                       border rounded-3 p-3 mb-4 bg-light">
                                            <div>
                                                <div class="fw-semibold">
                                                    Detail View
                                                </div>

                                                <small class="text-muted">
                                                    Show detailed records
                                                </small>
                                            </div>

                                            <div class="form-check form-switch m-0 ">
                                                <InputCheckbox class="form-check-input"
                                                               @bind-Value="IsDetailView" style="border: 1px solid #000;"
                                                               @bind-Value:after="OnDetailViewChanged" />
                                            </div>
                                        </div>

                                        <!-- TOTAL BASIC -->
                                        <div class="border rounded-3 p-3 mb-3 bg-light shadow-sm">

                                            <div class="d-flex justify-content-between align-items-center">

                                                <label class="text-muted fw-semibold mb-0">
                                                    @(IsDetailView ? "Line Basic Amount" : "Total Basic Amount")
                                                </label>

                                                <div class="fs-4 fw-bold text-primary">
                                                    ₹ @BasicAmount.ToString("N2")
                                                </div>
                                            </div>
                                        </div>

                                        <!-- GRAND TOTAL -->
                                        <div class="border rounded-3 p-3 mb-3 bg-success bg-opacity-10 shadow-sm">

                                            <div class="d-flex justify-content-between align-items-center">
                                                <label class="text-muted fw-semibold mb-0">
                                                    Grand Total
                                                </label>

                                                <div class="fs-3 fw-bold text-success">
                                                    ₹ @GrandTotal.ToString("N2")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (IsLoading)
                {
                    <div class="d-flex justify-content-center align-items-center py-5">
                        <div class="spinner-grow text-primary"></div>

                        <span class="ms-3 fw-semibold">
                            Fetching invoice records...
                        </span>
                    </div>
                }
                else if (FilteredTaxDetailsData != null && FilteredTaxDetailsData.Any())
                {
                    <div class="col-12 mt-3 mb-2">

                        <div class="card shadow-sm border-0 rounded-4 overflow-hidden"
                             style="background: linear-gradient(180deg,#ffffff,#f8fbff); border:1px solid #e9eef5;">

                            <!-- HEADER -->
                            <div class="card-header border-0 py-3 px-4"
                                 style="background: linear-gradient(135deg, #eefcff, #d9f7ff);
                                          border-bottom:1px solid #c6eff7;">

                                <div class="row g-3 align-items-center">

                                    <!-- TITLE -->
                                    <div class="col-12 col-xl-3">

                                        <div class="d-flex align-items-center">

                                            @* <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3">
                                                <i class="bi bi-receipt-cutoff text-primary fs-5"></i>
                                            </div>
 *@
                                            <div>

                                                <div class="fw-bold text-dark fs-6">
                                                    Invoice Item Details
                                                </div>

                                                <small class="text-muted">
                                                    Invoice tax & item summary records
                                                </small>

                                            </div>

                                        </div>

                                    </div>

                                    <!-- SEARCH -->
                                    <div class="col-12 col-xl-3">

                                        <div class="input-group shadow-sm rounded-3 overflow-hidden border">

                                            <span class="input-group-text bg-white border-0">
                                                <i class="bi bi-search text-muted"></i>
                                            </span>

                                            <input type="text"
                                                   class="form-control border-start-0"
                                                   placeholder="Search InvoiceNo.,Customer,Vendor,ItemCode,HSNCode..."
                                                   @bind="searchText"
                                                   @bind:event="oninput" />

                                        </div>

                                    </div>


                                    <!-- COLUMN MENU -->
                                    <div class="col-12 col-xl-3">
                                        <div class="dropdown w-100">
                                            <button class="btn btn-outline-primary rounded-3 w-100 fw-semibold shadow-sm dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown">
                                                <i class="bi bi-layout-three-columns me-2"></i>
                                                Manage Columns
                                            </button>

                                            <ul class="dropdown-menu p-3 shadow border-0 rounded-4" style="max-height:400px; overflow:auto; min-width:260px;">

                                                @foreach (var col in Columns.Where(c => !c.IsDetailColumn || IsDetailView))
                                                {
                                                    <li class="mb-2">

                                                        <div class="form-check">

                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   checked="@col.IsVisible"
                                                                   @onchange="async e =>
                                                                   {
                                                                       await OnColumnChanged(col, e.Value);
                                                                   }" />

                                                            <label class="form-check-label small fw-semibold">
                                                                @col.Title
                                                            </label>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>

                                    <!-- PRINT -->
                                    <div class="col-12 col-xl-3">

                                        <button class="btn btn-success rounded-3 shadow-sm fw-semibold w-100"
                                                id="btnPrint"
                                                @onclick="Print">

                                            <i class="bi bi-file-earmark-excel-fill me-2"></i>
                                            Print

                                        </button>

                                    </div>

                                </div>

                            </div>

                            <!-- TABLE -->
                            <div class="card-body p-2">

                                <div class="table-responsive border  overflow-auto" style="max-height:650px;">

                                    <table class="table table-hover table-bordered align-middle text-center mb-0" style="min-width:1900px; white-space:nowrap;">

                                        <thead class="custom-blue position-sticky top-0 z-3">
                                            <tr>

                                                @if (IsColumnVisible("SlNo"))
                                                {
                                                    <th>SlNo</th>
                                                }

                                                @if (IsColumnVisible("CustName"))
                                                {
                                                    <th>Customer</th>
                                                }

                                                @if (IsColumnVisible("GSTNo"))
                                                {
                                                    <th>GST No</th>
                                                }

                                                @if (IsColumnVisible("InvType"))
                                                {
                                                    <th>Type</th>
                                                }

                                                @if (IsColumnVisible("InvNo"))
                                                {
                                                    <th>Invoice No</th>
                                                }

                                                @if (IsColumnVisible("InvDate"))
                                                {
                                                    <th>Invoice Date</th>
                                                }

                                                @if (IsColumnVisible("Process"))
                                                {
                                                    <th>Process</th>
                                                }

                                                @if (IsColumnVisible("CGstRate"))
                                                {
                                                    <th>CGST %</th>
                                                }

                                                @if (IsColumnVisible("SGstRate"))
                                                {
                                                    <th>SGST %</th>
                                                }

                                                @if (IsColumnVisible("TotalCGSTAmount"))
                                                {
                                                    <th>CGST Amount</th>
                                                }

                                                @if (IsColumnVisible("TotalSGSTAmount"))
                                                {
                                                    <th>SGST Amount</th>
                                                }

                                                @if (IsColumnVisible("IGstRate"))
                                                {
                                                    <th>IGST %</th>
                                                }

                                                @if (IsColumnVisible("TotalIGSTAmount"))
                                                {
                                                    <th>IGST Amount</th>
                                                }

                                                @if (IsColumnVisible("DiscountPercent"))
                                                {
                                                    <th>Discount %</th>
                                                }

                                                @if (IsColumnVisible("DiscountAmount"))
                                                {
                                                    <th>Discount Amount</th>
                                                }

                                                @if (IsColumnVisible("TotalBasicAmount"))
                                                {
                                                    <th>@(IsDetailView ? "Line BasicAmount" : "Basic Amount")</th>
                                                }

                                                @if (IsColumnVisible("GrandTotal"))
                                                {
                                                    <th>Grand Total</th>
                                                }

                                                @if (IsColumnVisible("ACKNO"))
                                                {
                                                    <th>ACK No</th>
                                                }

                                                @if (IsColumnVisible("IRNNo"))
                                                {
                                                    <th>IRN No</th>
                                                }
                                                
                                                
                                                @if (IsDetailView && IsColumnVisible("RefDCNo"))
                                                {
                                                    <th>DC No</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("RefDcDate"))
                                                {
                                                    <th>DC Date</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("PONo"))
                                                {
                                                    <th>PO No</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("PODate"))
                                                {
                                                    <th>PO Date</th>
                                                }
                                                @if (IsDetailView && IsColumnVisible("LineNo"))
                                                {
                                                    <th>Line No.</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("ItemCode"))
                                                {
                                                    <th>Item Code</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("ItemName"))
                                                {
                                                    <th>Item Name</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("Specification"))
                                                {
                                                    <th>Specification</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("MeasureUnit"))
                                                {
                                                    <th>UOM</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("HSNCode"))
                                                {
                                                    <th>HSN</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("Qty"))
                                                {
                                                    <th>Qty</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("UnitPrice"))
                                                {
                                                    <th>Unit Price</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("LineDiscountPercent"))
                                                {
                                                    <th>Discount %</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("LineDiscountAmount"))
                                                {
                                                    <th>Discount Amount</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("LineCGSTRate"))
                                                {
                                                    <th>CGST Rate</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("LineSGSTRate"))
                                                {
                                                    <th>SGST Rate</th>
                                                }

                                                @if (IsDetailView && IsColumnVisible("LineIGSTRate"))
                                                {
                                                    <th>IGST Rate</th>
                                                }
                                                
                                            </tr>

                                        </thead>

                                        <tbody>
                                            @foreach (var item in FilteredTaxDetailsData)
                                            {
                                                <tr>
                                                    @if (IsColumnVisible("SlNo"))
                                                    {
                                                        <td>@item.SlNo</td>
                                                    }
                                                    @if (IsColumnVisible("CustName"))
                                                    {
                                                        <td>@item.CustName</td>
                                                    }
                                                    @if (IsColumnVisible("GSTNo"))
                                                    {
                                                        <td>@item.GSTNo</td>
                                                    }
                                                    @if (IsColumnVisible("InvType"))
                                                    {

                                                        <td>
                                                            <span class="badge px-3 py-2 text-white"
                                                                  style="@(item.InvType == "Sales"
                                                                ? "background:linear-gradient(135deg,#4F46E5,#5e435d);"
                                                                : item.InvType == "LABOUR"
                                                                ? "background:linear-gradient(135deg,#F59E0B,#FBBF24); color:#9491e2;"
                                                                : item.InvType == "EXPORT"
                                                                ? "background:linear-gradient(135deg,#10B981,#6d90b9);"
                                                                : item.InvType == "PURCHASE"
                                                                ? "background:linear-gradient(135deg,#06B6D4,#22D3EE); color:#87a3a3;"
                                                                : item.InvType == "SUBCONTRACT"
                                                                ? "background:linear-gradient(135deg,#EF4444,#5c73b9);"
                                                                : "background:linear-gradient(135deg,#6B7280,#9CA3AF);")">

                                                @item.InvType

                                                            </span>
                                                        </td>
                                                                                }
                                                    @if (IsColumnVisible("InvNo"))
                                                    {
                                                        <td>
                                                            @item.InvNo
                                                            <!-- Attachment Icon -->
                                                            @if (attachmentCounts.TryGetValue(item.InvId ?? 0, out var count) && count > 0 && item.InvType=="LABOUR")
                                                            {
                                                                <button class="btn btn-link p-0 ms-1"
                                                                        title="@($"This Invoice has {count} attachment(s). Click to view.")"
                                                                        @onclick="() => OpenAttachmentButton(item.InvNo, count)">
                                                                    <i class="bi bi-paperclip" style="font-size:15px;"></i>
                                                                </button>
                                                            }
                                                            </td>
                                                    }
                                                    @if (IsColumnVisible("InvDate"))
                                                    {
                                                        <td>@item.InvDate?.ToString("dd/MM/yyyy")</td>
                                                    }
                                                    @if (IsColumnVisible("Process"))
                                                    {
                                                        <td>@item.Process</td>
                                                    }
                                                    @if (IsColumnVisible("CGstRate"))
                                                    {
                                                        <td>@item.CGstRate</td>
                                                    }
                                                    @if (IsColumnVisible("SGstRate"))
                                                    {
                                                        <td>@item.SGstRate</td>
                                                    }
                                                    @if (IsColumnVisible("TotalCGSTAmount"))
                                                    {
                                                        <td>@item.TotalCGSTAmount</td>
                                                    }
                                                    @if (IsColumnVisible("TotalSGSTAmount"))
                                                    {
                                                        <td>@item.TotalSGSTAmount</td>
                                                    }
                                                    @if (IsColumnVisible("IGstRate"))
                                                    {
                                                        <td>@item.IGstRate</td>
                                                    }
                                                    @if (IsColumnVisible("TotalIGSTAmount"))
                                                    {
                                                        <td>@item.TotalIGSTAmount</td>
                                                    }
                                                    @if (IsColumnVisible("DiscountPercent"))
                                                    {
                                                        <td>@item.DiscountPercent</td>
                                                    }
                                                    @if (IsColumnVisible("DiscountAmount"))
                                                    {
                                                        <td>@item.DiscountAmount</td>
                                                    }
                                                    @if (IsColumnVisible("TotalBasicAmount"))
                                                    {
                                                        <td>@(IsDetailView ? item.LineBasicAmount : @item.TotalBasicAmount)</td>
                                                    }
                                                    @if (IsColumnVisible("GrandTotal"))
                                                    {
                                                        <td>@(IsDetailView ? (TaxDetailsList
                                                                .Where(x => x.InvNo == item.InvNo && x.InvType==item.InvType)
                                                                .FirstOrDefault() == item ? item.GrandTotal ?? 0 : 0) : item.GrandTotal ?? 0)
                                                        </td>
                                                    }
                                                    @if (IsColumnVisible("ACKNO"))
                                                    {
                                                        <td>@item.ACKNO</td>
                                                    }
                                                    @if (IsColumnVisible("IRNNo"))
                                                    {
                                                        <td>@item.IRNNo</td>
                                                    }
                                                    
                                                    @if (IsDetailView && IsColumnVisible("RefDCNo"))
                                                    {
                                                        <td>@item.RefDCNo</td>
                                                    }
                                                    @if (IsDetailView && IsColumnVisible("RefDcDate"))
                                                    {
                                                        <td>@item.RefDcDate?.ToString("dd/MM/yyyy")</td>
                                                    }
                                                    @if (IsDetailView && IsColumnVisible("PONo"))
                                                    {
                                                        <td>@item.PONo</td>
                                                    }
                                                    @if (IsDetailView && IsColumnVisible("PODate"))
                                                    {
                                                        <td>@item.PODate?.ToString("dd/MM/yyyy")</td>
                                                    }
                                                    @if (IsDetailView && IsColumnVisible("LineNo"))
                                                    {
                                                        <td>@item.LineNo</td>
                                                    }
                                                    @if (IsDetailView && IsColumnVisible("ItemCode"))
                                                    {
                                                        <td>@item.ItemCode</td>
                                                    }
                                                    @if (IsDetailView && IsColumnVisible("ItemName"))
                                                    {
                                                        <td>@item.ItemName</td>
                                                    }
                                                    @if (IsDetailView && IsColumnVisible("Specification"))
                                                    {
                                                        <td>@item.Specification</td>
                                                    }
                                                    @if (IsDetailView && IsColumnVisible("MeasureUnit"))
