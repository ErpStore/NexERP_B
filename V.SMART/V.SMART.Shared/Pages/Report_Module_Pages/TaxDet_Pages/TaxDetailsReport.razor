    private async Task ExportTaxDetailDataToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;

            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirm)
                return;

            if (FilteredTaxDetailsData == null || !FilteredTaxDetailsData.Any())
            {
                await _js.ToastrWarning("No data available");
                return;
            }

            int i = 1;

            foreach (var item in FilteredTaxDetailsData)
            {
                item.SlNo = i++;
            }

            List<Dictionary<string, object>> exportData = new();

            foreach (var item in FilteredTaxDetailsData)
            {
                Dictionary<string, object> row = new();

                // =========================
                // MAIN COLUMNS
                // =========================

                if (IsColumnVisible("SlNo"))
                    row.Add("Sl No", item.SlNo);

                if (IsColumnVisible("CustName"))
                    row.Add("Customer", item.CustName);

                if (IsColumnVisible("GSTNo"))
                    row.Add("GST No", item.GSTNo);

                if (IsColumnVisible("InvType"))
                    row.Add("Type", item.InvType);

                if (IsColumnVisible("InvNo"))
                    row.Add("Invoice No", item.InvNo);

                if (IsColumnVisible("InvDate"))
                    row.Add("Invoice Date", item.InvDate?.ToString("dd/MM/yyyy"));

                if (IsColumnVisible("CGstRate"))
                    row.Add("CGST %", item.CGstRate);

                if (IsColumnVisible("SGstRate"))
                    row.Add("SGST %", item.SGstRate);

                if (IsColumnVisible("TotalCGSTAmount"))
                    row.Add("CGST Amount", item.TotalCGSTAmount);

                if (IsColumnVisible("TotalSGSTAmount"))
                    row.Add("SGST Amount", item.TotalSGSTAmount);

                if (IsColumnVisible("IGstRate"))
                    row.Add("IGST %", item.IGstRate);

                if (IsColumnVisible("TotalIGSTAmount"))
                    row.Add("IGST Amount", item.TotalIGSTAmount);

                if (IsColumnVisible("DiscountPercent"))
                    row.Add("Discount %", item.DiscountPercent);

                if (IsColumnVisible("DiscountAmount"))
                    row.Add("Discount Amount", item.DiscountAmount);

                // if (IsColumnVisible("TotalBasicAmount"))
                //     row.Add("Basic Amount", item.TotalBasicAmount);
                if (IsColumnVisible("TotalBasicAmount"))
                    row.Add(
                        IsDetailView ? "Line Basic Amount" : "Basic Amount",
                        IsDetailView ? item.LineBasicAmount : item.TotalBasicAmount
                    );

                if (IsColumnVisible("GrandTotal"))
                    row.Add("Grand Total", item.GrandTotal);

                if (IsColumnVisible("ACKNO"))
                    row.Add("ACK No", item.ACKNO);

                if (IsColumnVisible("IRNNo"))
                    row.Add("IRN No", item.IRNNo);

                if (IsColumnVisible("Process"))
                    row.Add("Process", item.Process);

                // DETAIL VIEW COLUMNS
                if (IsDetailView && IsColumnVisible("RefDCNo"))
                    row.Add("DC No", item.RefDCNo);

                if (IsDetailView && IsColumnVisible("RefDcDate"))
                    row.Add("DC Date", item.RefDcDate?.ToString("dd/MM/yyyy"));

                if (IsDetailView && IsColumnVisible("PONo"))
                    row.Add("PO No", item.PONo);

                if (IsDetailView && IsColumnVisible("PODate"))
                    row.Add("PO Date", item.PODate?.ToString("dd/MM/yyyy"));

                if (IsDetailView && IsColumnVisible("LineNo"))
                    row.Add("Line No.", item.LineNo);

                if (IsDetailView && IsColumnVisible("ItemCode"))
                    row.Add("Item Code", item.ItemCode);

                if (IsDetailView && IsColumnVisible("ItemName"))
                    row.Add("Item Name", item.ItemName);

                if (IsDetailView && IsColumnVisible("Specification"))
                    row.Add("Specification", item.Specification);

                if (IsDetailView && IsColumnVisible("MeasureUnit"))
                    row.Add("UOM", item.MeasureUnit);

                if (IsDetailView && IsColumnVisible("HSNCode"))
                    row.Add("HSN", item.HSNCode);

                if (IsDetailView && IsColumnVisible("Qty"))
                    row.Add("Qty", item.Qty);

                if (IsDetailView && IsColumnVisible("UnitPrice"))
                    row.Add("Unit Price", item.UnitPrice);

                if (IsDetailView && IsColumnVisible("LineDiscountPercent"))
                    row.Add("Line Discount %",
                        item.LineDiscountPercent);

                if (IsDetailView && IsColumnVisible("LineDiscountAmount"))
                    row.Add("Line Discount Amount", item.LineDiscountAmount);

                if (IsDetailView && IsColumnVisible("LineCGSTRate"))
                    row.Add("Line CGST Rate", item.LineCGSTRate);

                if (IsDetailView && IsColumnVisible("LineSGSTRate"))
                    row.Add("Line SGST Rate", item.LineSGSTRate);

                if (IsDetailView && IsColumnVisible("LineIGSTRate"))
                    row.Add("Line IGST Rate", item.LineIGSTRate);



                exportData.Add(row);
            }

            if (!exportData.Any())
            {
                await _js.ToastrWarning("No data found for export");

                return;
            }

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "TaxDetails", "Tax Details List");
            var base64 = Convert.ToBase64String(bytes);
            await _js.DownloadExcelAsync(base64, "TaxDetails.xlsx");
            await _js.ToastrSuccess("Excel exported successfully");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ExportTaxDetailDataToExcel");
            await _js.ToastrError("Error while exporting Tax Details!");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task<byte[]> CreateTemplateAsync(string sheetName, string[] headers, IEnumerable<object> data)
    {
        try
        {
            using var workbook = new XLWorkbook();

            var worksheet = workbook.Worksheets.Add(sheetName);

            // HEADER
            for (int col = 0; col < headers.Length; col++)
            {
                var cell = worksheet.Cell(1, col + 1);

                cell.Value = headers[col];

                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.Yellow;
            }

            int rowIndex = 2;

            foreach (var obj in data)
            {
                for (int col = 0; col < headers.Length; col++)
                {
                    var header = headers[col];

                    object? value = null;

                    // PROPERTY MATCH
                    var prop = obj.GetType().GetProperty(header);

                    if (prop != null)
                    {
                        value = prop.GetValue(obj);
                    }

                    worksheet.Cell(rowIndex, col + 1).Value =
                        value?.ToString() ?? "";
                }

                rowIndex++;
            }

            worksheet.Columns().AdjustToContents();

            using var stream = new MemoryStream();

            workbook.SaveAs(stream);

            return stream.ToArray();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "CreateTemplateAsync");

            await _js.ToastrError("Excel creation failed");

            return Array.Empty<byte>();
        }
    }

