                item.SlNo = i++;
            }

            List<Dictionary<string, object>> exportData = new();

            foreach (var item in FilteredCreditDebitSumData)
            {
                Dictionary<string, object> row = new();

                // =========================
                // MAIN COLUMNS
                // =========================

                if (IsColumnVisible("SlNo"))
                    row.Add("Sl No.", item.SlNo);

                if (IsColumnVisible("Customer"))
                    row.Add("Customer", item.Customer);

                if (IsColumnVisible("Type"))
                    row.Add("Type", item.Type);

                if (IsColumnVisible("InvoiceNo"))
                    row.Add("Invoice No.", item.InvoiceNo);

                if (IsColumnVisible("InvoiceDate"))
                    row.Add("Invoice Date", item.InvoiceDate?.ToString("dd/MM/yyyy"));

                if (IsColumnVisible("TotalBasicAmount"))
                    row.Add("Total Basic Amount", item.TotalBasicAmount);

                if (IsColumnVisible("DiscountPercent"))
                    row.Add("Discount %", item.DiscountPercent);

                if (IsColumnVisible("DiscountAmount"))
                    row.Add("Discount Amount", item.DiscountAmount);

                if (IsColumnVisible("TotalGrossAmount"))
                    row.Add("Total Gross Amount", item.TotalGrossAmount);

                if (IsColumnVisible("FreightCharges"))
                    row.Add("Freight Charges", item.FreightCharges);

                if (IsColumnVisible("PackingPercent"))
                    row.Add("Packing %", item.PackingPercent);

                if (IsColumnVisible("PackingCharges"))
                    row.Add("Packing Charges", item.PackingCharges);

                if (IsColumnVisible("InsurancePercent"))
                    row.Add("Insurance %", item.InsurancePercent);

                if (IsColumnVisible("InsuranceCharges"))
                    row.Add("Insurance Charges", item.InsuranceCharges);

                if (IsColumnVisible("TotalTaxable"))
                    row.Add("Total Taxable", item.TotalTaxable);

                if (IsColumnVisible("CGstRate"))
                    row.Add("CGST Rate", item.CGstRate);

                if (IsColumnVisible("TotalCGSTAmount"))
                    row.Add("CGST Amount", item.TotalCGSTAmount);

                if (IsColumnVisible("SGstRate"))
                    row.Add("SGST Rate", item.SGstRate);

                if (IsColumnVisible("TotalSGSTAmount"))
                    row.Add("SGST Amount", item.TotalSGSTAmount);

                if (IsColumnVisible("IGstRate"))
                    row.Add("IGST Rate", item.IGstRate);

                if (IsColumnVisible("TotalIGSTAmount"))
                    row.Add("IGST Amount", item.TotalIGSTAmount);

                if (IsColumnVisible("TCSPercent"))
                    row.Add("TCS %", item.TCSPercent);

                if (IsColumnVisible("TCSAmount"))
                    row.Add("TCS Amount", item.TCSAmount);

                if (IsColumnVisible("OtherCharges"))
                    row.Add("Other Charges", item.OtherCharges);

                if (IsColumnVisible("GrandTotal"))
                    row.Add("Grand Total", item.GrandTotal);

                if (IsColumnVisible("CreditAmt"))
                    row.Add("Credit/Debit Amount", item.CreditAmt);

                if (IsColumnVisible("MainRemark"))
                    row.Add("Remark", item.MainRemark);
                exportData.Add(row);
            }

            if (!exportData.Any())
            {
                await _js.ToastrWarning("No data found for export");

                return;
            }

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "CreditDebitSummary", "CreditDebit Summary List");
            var base64 = Convert.ToBase64String(bytes);
            await _js.DownloadExcelAsync(base64, "CreditDebitSummary.xlsx");
            await _js.ToastrSuccess("Excel exported successfully");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ExportCreditDebitSummaryDataToExcel");
            await _js.ToastrError("Error while exporting CreditDebit Summary Report!");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task<byte[]> CreateTemplateAsync(string sheetName, string[] headers, IEnumerable<object> data)
    {
        try
        {
            using var workbook = new XLWorkbook();

            var worksheet = workbook.Worksheets.Add(sheetName);

            // HEADER
            for (int col = 0; col < headers.Length; col++)
            {
                var cell = worksheet.Cell(1, col + 1);

                cell.Value = headers[col];

                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.Yellow;
            }

            int rowIndex = 2;

            foreach (var obj in data)
            {
                for (int col = 0; col < headers.Length; col++)
                {
                    var header = headers[col];

                    object? value = null;

                    // PROPERTY MATCH
                    var prop = obj.GetType().GetProperty(header);

                    if (prop != null)
                    {
                        value = prop.GetValue(obj);
                    }

                    worksheet.Cell(rowIndex, col + 1).Value =
                        value?.ToString() ?? "";
                }

                rowIndex++;
            }

            worksheet.Columns().AdjustToContents();

            using var stream = new MemoryStream();

            workbook.SaveAs(stream);

            return stream.ToArray();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "CreateTemplateAsync");

            await _js.ToastrError("Excel creation failed");

            return Array.Empty<byte>();
        }
    }
