                                <div class="card border-0 shadow-sm rounded-4 h-100">

                                    <div class="card-header py-2 text-white fw-semibold"
                                        
                                        style="background:linear-gradient(135deg,#2563eb,#4f46e5);">
                                        <i class="bi bi-calendar-range-fill me-2"></i>
                                        Date Range
                                    </div>

                                    <div class="card-body shadow-sm p-4">

                                        <label class="small fw-semibold">From Date</label>

                                        <InputDate @bind-Value="FromDate" class="form-control shadow-sm mb-4 py-2 rounded-3" />
                                        <label class="small fw-semibold">To Date</label>

                                        <InputDate @bind-Value="ToDate" class="form-control shadow-sm mb-4 py-2 rounded-3" />

                                    </div>

                                </div>

                            </div>


                            <!-- REPORT TYPE -->
                                <div class="col-lg-9 col-md-8">

                                <div class="card border-0 shadow-sm rounded-4 h-100">

                                    <div class="card-header py-2 text-white fw-semibold"
                                        
                                        style="background:linear-gradient(135deg,#7c3aed,#c026d3);">
                                        <i class="bi bi-sliders me-2"></i>
                                        Report Configuration
                                    </div>

                                    <div class="card-body p-3">
                                            <!-- Report Type -->
 
                                        <div class="row g-4 align-items-start">
                                            <div class="col-lg-4">
                                                <label class="small fw-bold mb-2">Report Type</label>

                                                <div class="d-grid gap-3">

                                                    <!-- SALES -->
                                                    <input type="radio"
                                                           class="btn-check"
                                                           name="reportType"
                                                           id="sales"
                                                           checked="@(SelectedReportType == "Sales")"
                                                           @onchange='async e => await ChangeReportType("Sales")' />

                                                    <label class="report-card sales-card" for="sales">
                                                        <span>
                                                            <i class="bi bi-graph-up-arrow me-2"></i>
                                                            Sales
                                                        </span>

                                                        <span>
                                                            @if (SelectedReportType == "Sales")
                                                            {
                                                                <i class="bi bi-check-circle-fill fs-5 text-white"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-circle fs-5 text-white"></i>
                                                            }
                                                        </span>
                                                    </label>

                                                    <!-- PURCHASE -->
                                                    <input type="radio"
                                                           class="btn-check"
                                                           name="reportType"
                                                           id="purchase"
                                                           checked="@(SelectedReportType == "Purchase")"
                                                           @onchange='async e => await ChangeReportType("Purchase")' />

                                                    <label class="report-card purchase-card" for="purchase">
                                                        <span>
                                                            <i class="bi bi-cart-check me-2"></i>
                                                            Purchase
                                                        </span>

                                                        <span>
                                                            @if (SelectedReportType == "Purchase")
                                                            {
                                                                <i class="bi bi-check-circle-fill fs-5 text-white"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-circle fs-5 text-white"></i>
                                                            }
                                                        </span>
                                                    </label>

                                                </div>
                                            </div>

                                            <!-- Party Name -->
                                      
                                            <div class="col-lg-8">

                                                <label class="small fw-bold">Party Name</label>

                                                <input class="form-control rounded-pill shadow-sm border-0"
                                                        placeholder="Search Party Name..."
                                                        value="@partySearch"
                                                        @oninput="OnPartySearchChange" />
                                        
                                                <div class="bg-white rounded-4 shadow-sm mt-3 p-3 border"
                                                     style="height:200px;
                                                        width:100%;
                                                        overflow-y:auto;
                                                        overflow-x:auto;
                                                        white-space:nowrap;">

                                                    <!-- ALL -->
                                                    <div class="dropdown-item cursor-pointer
                                                         @(SelectedParty == "ALL" ? "text-white fw-bold" : "")"
                                                         style="@(SelectedParty == "ALL" ? "background-color:#815355;" : "")"
                                                         @onclick='() => SelectParty("ALL")'>
                                                        ALL
                                                    </div>

                                                    @foreach (var item in FilteredItems)
                                                    {
                                                        <div class="dropdown-item cursor-pointer
                                                             @(SelectedParty == item.Customer ? "text-white fw-bold" : "")"
                                                             style="@(SelectedParty == item.Customer ? "background-color:#815355;" : "")"
                                                             @onclick='() => SelectParty(item.Customer)'>

                                                            @item.Customer

                                                        </div>
                                                    }

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SelectedParty) || IsAllSelected)
                    {
