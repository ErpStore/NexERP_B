                                                        </div>
                                                    </div>

                                                    <!-- COLUMN MENU -->
                                                    <div class="col-12 col-md-auto">
                                                        <div class="dropdown w-100">
                                                            <button class="btn btn-light text-dark shadow-sm rounded-pill px-4 w-100"
                                                                    type="button"
                                                                    data-bs-toggle="dropdown">
                                                                <i class="bi bi-layout-three-columns me-1"></i>
