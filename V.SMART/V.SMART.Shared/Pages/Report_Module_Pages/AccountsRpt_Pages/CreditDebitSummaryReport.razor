                                                                          "Sales" => "rounded-pill px-3 py-2 bg-success",
                                                                          "Labour" => "rounded-pill px-3 py-2 bg-warning text-dark",
                                                                          "Purchase" => "rounded-pill px-3 py-2 bg-primary",
                                                                          "SubContract" => "rounded-pill px-3 py-2 bg-danger",
                                                                          _ => "bg-secondary"
                                                                      })">
