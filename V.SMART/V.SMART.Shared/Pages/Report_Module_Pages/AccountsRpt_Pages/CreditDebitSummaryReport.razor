@page "/creditdebitSummaryReport"
@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.ITaxDetailsReportService
@using V.SMART.Shared.ViewModels.ReportViewModel.AccountsReportViewModel


@inherits BaseUserRightsComponent

@inject ILoggingService _logs
@inject CurrentUserService _userService
@inject IJSRuntime _js
@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService
@inject ICustomerService customerService
@inject IVendorService vendorService
@inject ExcelExportService ExcelExportService
@inject IColumnPreferenceService PreferenceService
@inject CurrentUserService CurrentUserService
@inject ICreditDebitSummaryService creditDebitSummaryService

<style>
    .table-heading th {
        background-color: #C8ACD6 !important;
        color: black !important;
    }

    .form-control:focus {
        box-shadow: 0 0 0 .25rem rgba(99,102,241,.15);
    }

    .table tbody tr {
        transition: .25s;
    }

        .table tbody tr:hover {
            background: #eef2ff;
            transform: scale(1.002);
        }

    .table td,
    .table th {
        vertical-align: middle;
        white-space: nowrap;
    }

    .table {
        border-radius: 15px;
        overflow: hidden;
    }

    .report-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        border-radius: 16px;
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: all .25s ease;
        box-shadow: 0 4px 12px rgba(0,0,0,.10);
    }

        .report-card:hover {
            transform: translateY(-2px);
        }

    .sales-card {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
    }

    .purchase-card {
        background: linear-gradient(135deg,#16a34a,#15803d);
    }
</style>

<BsModal OnModalConfirmation="@HandleModalConfirmation"
         ButtonBootstrapStyle="@btnColor"
         ButtonText="@btnText"
         Title=@ModalTitle>
</BsModal>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-5 mt-4">
        @* <div class="card shadow-sm border-1"> *@
        <div class="card shadow-sm border-1">

            <PageHeader TitleText="CreditDebitNote Summary Report"
                        TitleIcon="bi bi-list-check"
                        Breadcrumbs="@CreditDebitSummaryBreadcrumbs" />

            @* <div class="card-body bg-light"> *@
            <div class="card-body" style="background:linear-gradient(180deg,#f8fafc,#eef2ff);">
                <div class="card shadow-sm border-0 h-100">

                    <div class="card border-0 shadow-sm rounded-4 mb-3">
                        <div class="row g-3 mb-3">

                            <!-- DATE RANGE -->
                            @* <div class="col-md-3"> *@
