                    || (!string.IsNullOrWhiteSpace(s.Customer) &&
                        s.Customer.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                    || (!string.IsNullOrWhiteSpace(s.Type) &&
                        s.Type.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                .ToList();

            for (int i = 0; i < filtered.Count; i++)
            {
                filtered[i].SlNo = i + 1;
            }

            return filtered;
        }
