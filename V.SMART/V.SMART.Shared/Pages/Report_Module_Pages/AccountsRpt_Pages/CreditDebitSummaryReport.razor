                                                        }
                                                       
                                                        @if (IsColumnVisible("IGstRate"))
                                                        {
                                                            <td class="text-end">@item.IGstRate?.ToString("N2")</td>
                                                        }
                                                        
                                                        @if (IsColumnVisible("TotalIGSTAmount"))
                                                        {
                                                            <td class="text-end">@item.TotalIGSTAmount?.ToString("N2")</td>
