                                                        <th style="min-width:170px;" class="text-end">
                                                            Packing Charges
                                                        </th>
                                                    }

                                                    @if (IsColumnVisible("InsurancePercent"))
                                                    {
                                                        <th style="min-width:150px;" class="text-end">
                                                            Insurance %
                                                        </th>
                                                    }

                                                    @if (IsColumnVisible("InsuranceCharges"))
                                                    {
                                                        <th style="min-width:180px;" class="text-end">
                                                            Insurance Charges
                                                        </th>
                                                    }

                                                    @if (IsColumnVisible("TotalTaxable"))
