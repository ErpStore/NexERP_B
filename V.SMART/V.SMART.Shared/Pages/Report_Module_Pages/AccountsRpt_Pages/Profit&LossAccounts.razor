@page "/Profit_LossAccounts"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.ITrackReportService
@using V.SMART.Shared.ViewModels.ReportViewModel.TrakReportsViewModel.LabourTrackViewModel


@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject IProfit_LossAccountService Profit_LossAccountService
@inject IExcelTemplateService excelTemplateService


<style>

    :root {
        --primary: #4f46e5;
        --secondary: #2563eb;
        --success: #0891b2;
        --bg: #f5f7fb;
        --card: #fff;
        --border: #e5e7eb;
    }

    body {
        background: var(--bg);
        font-family: 'Segoe UI',sans-serif;
    }

    .pending-bills-page {
        padding: 20px;
    }


    /* HERO */
/* 
    .hero-section {
        background: linear-gradient( 135deg, #312e81, #2563eb, #60a5fa);
        padding: 10px;
        border-radius: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
        margin-bottom: 15px;
        box-shadow: 0 12px 30px rgba(0,0,0,.12);
    } */

    .hero-section {
        background: linear-gradient(135deg, #0f766e, #0d9488, #14b8a6);
        padding: 10px;
        border-radius: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
        margin-bottom: 15px;
        box-shadow: 0 10px 25px rgba(13, 148, 136, 0.20);
    }

    .hero-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .hero-icon {
        width: 30px;
        height: 30px;
        background: rgba(255,255,255,.15);
        border-radius: 50%;
        display: flex;
        align-items: top;
        justify-content: center;
        font-size: 20px;
    }

    .hero-section h5 {
        margin: 0;
        font-size: 20px;
        font-weight: 500;
        font-family: Georgia;
    }

    .hero-section p {
        margin-top: 4px;
        font-size: 12px;
        opacity: .95;
    }

    .header-badge {
        background: white;
        color: #4f46e5;
        padding: 14px 26px;
        border-radius: 14px;
        font-weight: 600;
    }



    /* FILTERS */

    .filter-card {
        margin-bottom: 15px;
    }

    .filter-row {
        display: flex;
        gap: 20px;
        align-items: end;
        flex-wrap: wrap;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
    }

        .filter-item label {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .filter-item input {
            width: 320px;
            padding: 14px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: white;
        }

    .btn-view {
        border: none;
        padding: 14px 40px;
        background: linear-gradient( 135deg, #6366f1, #4f46e5);
        color: white;
        border-radius: 12px;
        font-weight: 600;
        min-width: 100px;
    }
    .btn-view:hover {
    background: white;
    color: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,.15);
    }
    .btn-export {
        border: none;
        padding: 14px 40px;
        background: linear-gradient( 135deg, #0891b2, #0f766e);
        color: white;
        border-radius: 12px;
        font-weight: 600;
        min-width: 170px;
    }

   .btn-export:hover {
    background: white;
    color: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,.15);
    }

    /* TABLE CARD */

    .table-card {
        background: white;
        border-radius: 24px;
        padding: 10px;
        box-shadow: 0 8px 25px rgba(0,0,0,.06);
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #4f46e5;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 15px;
        font-family: Georgia;
    }


    /* TABLE */

    .table-modern {
        width: 100%;
        border-collapse: collapse;
        overflow: hidden;
        border-radius: 10px;
    }

        .table-modern thead th {
            /* background: linear-gradient(135deg, #0f766e, #14b8a6); */
            background: linear-gradient(135deg, #2f5d9f, #4a90e2);
            padding: 10px;
            color: white;
            font-size: 14px;
        }

        .table-modern td {
            padding: 10px;
            border-bottom: 1px solid #edf2f7;
            font-size: 12px;
        }

        .table-modern tbody tr:hover {
            background: #f8fafc;
        }

        .table-modern td:nth-child(2),
        .table-modern td:nth-child(4) {
            text-align: right;
            font-weight: 700;
        }

    .no-data {
        padding: 30px;
        background: #fff7ed;
        text-align: center;
        border-radius: 12px;
        font-weight: 600;
    }

    /* Credit Particulars */

    .table-modern tbody td:nth-child(1) {
        color: #059669;
        font-weight: 600;
    }


    /* Credit Amount */

    .table-modern tbody td:nth-child(2) {
        color: #047857;
        font-weight: 700;
        background: #fef2f2;
    }


   
    /* Debit Particulars */

    .table-modern tbody td:nth-child(3) {
        color: #dc2626;
        font-weight: 600;
    }


   
    /* Debit Amount */

    .table-modern tbody td:nth-child(4) {
      
        color: #b91c1c;
        font-weight: 700;
        background: #ecfdf5;
    }


    /* Alternate rows */

    .vertical-chart {
        display: flex;
        align-items: flex-end;
        gap: 20px;
        height: 340px;
        overflow: auto;
        padding: 20px;
    }

    .bar-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 70px;
    }

    .vbar {
        width: 45px;
        background: linear-gradient( 180deg, #4f46e5, #2563eb);
        border-radius: 10px 10px 0 0;
    }

    .bar-value {
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .bar-month {
        margin-top: 10px;
        font-weight: 600;
    }

    .pie-wrapper {
        display: flex;
        justify-content: center;
        padding: 20px;
    }

    .pie-chart {
        width: 220px;
        height: 220px;
        border-radius: 50%;
    }

    .legend-row {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
    }

    .blue-box {
        width: 18px;
        height: 18px;
        background: #3b82f6;
        border-radius: 4px;
    }

    .red-box {
        width: 18px;
        height: 18px;
        background: #ef4444;
        border-radius: 4px;
    }
    /* MOBILE */

    @@media(max-width:992px) {

        .hero-section {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .filter-row {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-item input {
            width: 100%;
        }
    }

</style>



@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing"
                       Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{

    <div class="container-fluid px-2 px-md-5 mt-4">

        <div class="card shadow-sm">

            <PageHeader TitleText="Profit & Loss Accounts"
                        TitleIcon="bi bi-cash-stack"
                        Breadcrumbs="@ProfitLossBreadcrumbs" />

            <div class="pending-bills-page">


                <!-- HERO -->

                <div class="hero-section">

                    <div class="hero-left">

                        <div class="hero-icon">

                            <i class="bi bi-graph-up-arrow"></i>

                        </div>

                        <div>

                             <h5>
                                Profit & Loss Accounts
                            </h5>

                            <p>
                                Track all profit & expense details
                            </p>

                        </div>

                    </div>

                   

                    <div>

                        <button class="btn-view"  @onclick="LoadDetails">
                            <i class="bi bi-list-ul me-2"></i>  Details View
                        </button>

                    </div>

                </div>


                <!-- FILTER -->

                <div class="filter-card">

                    <div class="filter-row">

                        <div class="filter-item">

                            <label> From Date </label>

                            <input type="date"  @bind="FromDate" />

                        </div>


                        <div class="filter-item">

                            <label> To Date </label>

                            <input type="date" @bind="ToDate" />

                        </div>


                        <div>

                            <button class="btn-view" @onclick="ViewData">
                                <i class="bi bi-eye me-2"></i> View
                            </button>

                        </div>


                        <div>

                            <button class="btn-export" @onclick="OnPrintPendingTrack">
                                <i class="bi bi-file-earmark-excel me-2"></i>
                                Export Excel
                            </button>

                         

                        </div>

                    </div>

                </div>


                <!-- TABLE -->
            @if (ShowSummary)
            {

                <div class="table-card">  
                    
                    <div class="section-title">
                        <i class="bi bi-pie-chart"></i>
                        Profit & Loss Report

                    </div>

                    @if (Profit_LossAccountsVMs.Any())
                    {

                        <table class="table-modern">

                            <thead>

                                <tr>

                                    <th>Particulars (Cr)</th>

                                    <th>Amount</th>

                                    <th>Particulars (Dr)</th>

                                    <th>Amount</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Profit_LossAccountsVMs)
                                {

                                    <tr>

                                        <td>@item.ParticularsLeft</td>

                                        <td>@item.AmountLeft.ToString("N2")</td>

                                        <td>@item.ParticularsRight</td>

                                        <td>@item.AmountRight.ToString("N2")</td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    }

                    else
                    {

                        <div class="no-data">

                            No Records Found

                        </div>

                    }

                </div>
            }
            @if (ShowSummary)
            {
                <div class="table-card">

                    <div class="section-title">

                        <i class="bi bi-wallet2"></i>

                        Receipt vs Payment Report

                    </div>

                    <table class="table-modern">

                        <thead>

                            <tr>

                                <th>Receipt</th>

                                <th>Amount</th>

                                <th>Payment</th>

                                <th>Amount</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in ReceiptPaymentReport)
                            {
                                <tr>

                                    <td>@item.ParticularsLeft</td>

                                    <td>@item.AmountLeft.ToString("N2")</td>

                                    <td>@item.ParticularsRight</td>

                                    <td>@item.AmountRight.ToString("N2")</td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            @if (ShowDetails)
            {
                <div class="table-card">

                    <div class="section-title">

                        <i class="bi bi-pie-chart"></i>

                        Details Profit & Loss Report

                    </div>

                        @if (DetailProfitLossReport.Any())
                        {

                            <div class="table-card">

                                <table class="table-modern">

                                    <thead>

                                        <tr>

                                            <th>Income Side</th>

                                            <th>Amount</th>

                                            <th>Expense Side</th>

                                            <th>Amount</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var item in DetailProfitLossReport)
                                        {

                                            <tr>

                                                <td>@item.ParticularsLeft</td>

                                                <td>@item.AmountLeft.ToString("N2")</td>

                                                <td>@item.ParticularsRight</td>

                                                <td>@item.AmountRight.ToString("N2")</td>

                                            </tr>

                                        }

                                    </tbody>

                                </table>

                            </div>

                        }

                </div>
            }
               

                 <div class="row">

                    <!-- BAR CHART -->

                    <div class="col-md-8">

                        <div class="chart-card">

                            <div class="section-title">

                                <i class="bi bi-bar-chart-fill"></i>

                                Monthly Net Profit

                            </div>

                            <div class="vertical-chart">

                                @{

                                    decimal maxValue =
                                    MonthlyData.Any()
                                    ? MonthlyData.Max(x => x.NetProfit)
                                    : 1;

                                }

                                @foreach (var item in MonthlyData)
                                {

                                    var height =
                                    maxValue == 0
                                    ? 0
                                    : (item.NetProfit / maxValue) * 260;

                                    <div class="bar-column">

                                        <div class="bar-value">

                                            ₹@item.NetProfit.ToString("N0")

                                        </div>

                                        <div class="vbar"
                                             style="height:@($"{height}px")">
                                        </div>

                                        <div class="bar-month">

                                            @item.MonthName.Substring(0, 3)

                                        </div>

                                    </div>

                                }


                            </div>

                        </div>

                    </div>



                    <!-- PIE CHART -->

                    <div class="col-md-4">

                        <div class="chart-card">

                            <div class="section-title">

                                <i class="bi bi-pie-chart-fill"></i>

                                Profit Split

                            </div>

                            @{

                                decimal income =
                                Profit_LossAccountsVMs
                                .Where(x => x.ParticularsLeft != "Total")
                                .Sum(x => x.AmountLeft);

                                decimal expense =
                                Profit_LossAccountsVMs
                                .Where(x => x.ParticularsRight != "")
                                .Sum(x => x.AmountRight);

                                decimal total =
                                income + expense;

                                decimal profitPercent =
                                total == 0 ? 0 :
                                (income / total) * 100;

                            }

                            <div class="pie-wrapper">

                                <div class="pie-chart"
                                     style="
                        background:
                        conic-gradient(
                        #3b82f6 0%
                        @(profitPercent)%,

                        #ef4444
                        @(profitPercent)% 100%
                        );">
                                </div>

                            </div>

                            <div class="legend-row">

                                <div class="legend-item">

                                    <span class="blue-box">

                                    </span>

                                    Income

                                </div>

                                <div class="legend-item">

                                    <span class="red-box">

                                    </span>

                                    Expense

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


            </div>

        </div>

    </div>

}



@code {

    protected override string ScreenName => "Profit & Loss Accounts";

    public DateTime FromDate { get; set; }

    public DateTime ToDate { get; set; }

    private bool isProcessing = false;
    private List<ProfitLossMonthlyVM> MonthlyData = new();

    private string? UserName;

    private List<Profit_LossAccountsVM>Profit_LossAccountsVMs = new();

    public List<Profit_LossAccountsVM> AllData { get; set; } = new();

    private List<Profit_LossAccountsVM> ReceiptPaymentReport = new();

    private List<Profit_LossAccountsVM>DetailProfitLossReport = new();

    private bool ShowSummary = true;

    private bool ShowDetails = false;
  
    

    protected override async Task OnInitializedAsync()
    {

        try
        {

            isProcessing = true;

            await LoadRightsAsync();

            if (!CanView)
            {

                _navigation.NavigateTo("/access-denied");

                return;

            }

            UserName = await CurrentUserService.GetUsernameAsync();

            FromDate =DateTime.Today.AddMonths(-1);

            ToDate = DateTime.Today;

            await ViewData();

        }

        finally
        {

            isProcessing = false;

        }

    }

    private List<PageHeader.BreadcrumbItem>
      ProfitLossBreadcrumbs = new()
      {

        new(){Text="Reports"},

        new(){Text="Accounts"},

        new(){

        Text="Profit & Loss Accounts",

        IsLast=true

        }

    };



    private async Task ViewData()
    {

        isProcessing = true;

        try
        {
            ShowSummary = true;

            ShowDetails = false;

            Profit_LossAccountsVMs = await Profit_LossAccountService.GetProfitLossAsync( FromDate,  ToDate);

            AllData = Profit_LossAccountsVMs.ToList();


            // // PROFIT LOSS REPORT
            // Profit_LossAccountsVMs =
            // AllData
            // .Where(x =>
            //     x.ParticularsLeft != "Receipt" &&
            //     x.ParticularsLeft != "Receipt Balance")
            // .ToList();


            Profit_LossAccountsVMs = 
            AllData
            .Where(x =>
                    x.ParticularsLeft != "Receipt"  &&
                    x.ParticularsLeft != "Profit" &&
                   !x.ParticularsLeft.StartsWith("Sales -") &&
                   !x.ParticularsLeft.StartsWith("Labour -") &&
                   !x.ParticularsRight.StartsWith("ServiceBill In -") &&
                   !x.ParticularsRight.StartsWith("Purchase -") &&  
                   !x.ParticularsRight.StartsWith("Sub Contract -")&&
                   !x.ParticularsRight.StartsWith("ServiceBill Out -") &&
                   x.ParticularsLeft != "Total Income-" &&
                   x.ParticularsLeft != "Net Profit-")
                    .ToList();



            // RECEIPT PAYMENT REPORT
            ReceiptPaymentReport =
            AllData
            .Where(x =>
                x.ParticularsLeft == "Receipt" ||
                x.ParticularsLeft == "Profit")
            .ToList();

            await LoadChart();

        }

        finally
        {

            isProcessing = false;

        }

    }

    private async Task LoadChart()
    {
        MonthlyData = await Profit_LossAccountService.GetMonthlyProfitAsync(FromDate, ToDate);
        StateHasChanged();
    }

    private async Task LoadDetails()
    {
        ShowSummary = false;

        ShowDetails = true;

        DetailProfitLossReport =
                   AllData
                  .Where(x =>

       x.ParticularsLeft.StartsWith("Sales -")

       ||

       x.ParticularsLeft.StartsWith("Labour -")

       ||

        x.ParticularsLeft.StartsWith("ServiceBill In -")

       ||

       x.ParticularsRight.StartsWith("Purchase -")

       ||

       x.ParticularsRight.StartsWith("Sub Contract -")

       ||

        x.ParticularsLeft.StartsWith("ServiceBill Out -")

       ||

       (
           x.ParticularsLeft == "Total Income-"

           &&

           x.ParticularsRight == "Total Expense-"
       )

       ||

       x.ParticularsLeft == "Net Profit-"

   )
   .ToList();


   
    }



    private async Task OnPrintPendingTrack()
    {

        if (!Profit_LossAccountsVMs.Any())
        {

            await _JS.InvokeVoidAsync(

            "alert",

            "No data available");

            return;

        }

        string[] headers ={

                            "Particulars Left",

                            "Amount Left",

                            "Particulars Right",

                            "Amount Right"

                            };

        var exportData = Profit_LossAccountsVMs
                        .Select(x => new
                        {

                            x.ParticularsLeft,

                            x.AmountLeft,

                            x.ParticularsRight,

                            x.AmountRight

                        }).ToList();

        var fileBytes =
       await excelTemplateService.CreateTemplateAsync(
       "ProfitLossAccounts",
       headers,
       exportData);

        var base64 =
        Convert.ToBase64String(fileBytes);

        await _JS.InvokeVoidAsync(
            "downloadExcelFile",
            base64,
            "ProfitLossAccounts.xlsx");
    }

}
