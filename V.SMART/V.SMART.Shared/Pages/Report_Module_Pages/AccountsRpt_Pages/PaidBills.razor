@page "/PaidBills"

@using V.SMART.Shared.BusinessLayer.BusinessService.IBusinessService.IReportService.ITrackReportService
@using V.SMART.Shared.ViewModels.ReportViewModel.TrakReportsViewModel.LabourTrackViewModel

@inherits BaseUserRightsComponent

@inject ILoggingService LoggingService
@inject CurrentUserService CurrentUserService
@inject IJSRuntime _JS
@inject IColumnPreferenceService PreferenceService
@inject NavigationManager _navigation
@inject IPaidBillsService paidBillsService
@inject IExcelTemplateService excelTemplateService

<style>

    :root {
        --primary: #6d28d9;
        --primary-dark: #4c1d95;
        --secondary: #0f766e;
        --gold: #f59e0b;
        --success: #059669;
        --danger: #dc2626;
        --bg: #f8fafc;
        --border: #e2e8f0;
        --text: #1e293b;
        --text-light: #64748b;
    }

    body {
        background: linear-gradient(to bottom right, #f8fafc, #eef2ff);
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .paid-bills-page {
        padding: 24px;
    }

    /* HERO SECTION */

    .hero-section {
        background: linear-gradient(135deg, #4c1d95, #7c3aed, #0f766e);
        padding: 30px 35px;
        border-radius: 24px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        overflow: hidden;
        position: relative;
        box-shadow: 0 18px 40px rgba(109, 40, 217, 0.25);
    }

        .hero-section::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
            top: -120px;
            right: -80px;
        }

        .hero-section h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 800;
            font-family: Georgia, serif;
            letter-spacing: 0.5px;
        }

        .hero-section p {
            margin-top: 8px;
            opacity: 0.92;
            font-size: 15px;
        }

    .header-badge {
        background: rgba(255,255,255,0.15);
        padding: 12px 20px;
        border-radius: 40px;
        font-weight: 600;
        border: 1px solid rgba(255,255,255,0.2);
        backdrop-filter: blur(10px);
        z-index: 2;
    }

    /* FILTER CARD */

    .filter-card {
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(12px);
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 28px;
        border: 1px solid rgba(255,255,255,0.5);
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.06);
    }

    .filter-item label {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 700;
        color: var(--primary-dark);
    }

    .filter-item input,
    .filter-item select {
        width: 100%;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: white;
        font-size: 14px;
        transition: all 0.25s ease;
    }

        .filter-item input:focus,
        .filter-item select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(109, 40, 217, 0.12);
        }

    /* TABLE CARD */

    .table-card {
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(12px);
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 10px 40px rgba(15, 23, 42, 0.07);
    }

    .table-header {
        margin-bottom: 22px;
    }

        .table-header h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 800;
            color: var(--text);
        }

    /* BUTTON */

    .custom-print-btn {
        background: linear-gradient(135deg, #7c3aed, #4c1d95);
        color: white;
        border: none;
        border-radius: 14px;
        padding: 12px 22px;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.3s ease;
        box-shadow: 0 10px 24px rgba(109, 40, 217, 0.25);
    }

        .custom-print-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(109, 40, 217, 0.35);
        }

    /* TABLE */

    .table-wrapper {
        overflow-x: auto;
        border-radius: 18px;
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        min-width: 1400px;
    }

    thead {
        position: sticky;
        top: 0;
        z-index: 5;
    }

    th {
        background: linear-gradient(to right, #ede9fe, #f5f3ff);
        color: #5b21b6;
        padding: 18px;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        border-bottom: 2px solid #ddd6fe;
        white-space: nowrap;
    }

    td {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f5f9;
        background: white;
        font-size: 14px;
        color: #334155;
        white-space: nowrap;
    }

    tbody tr {
        transition: all 0.25s ease;
    }

        tbody tr:hover {
            background: #faf5ff;
            transform: scale(1.001);
        }

    .invoice-amount {
        font-weight: 700;
        color: #1e293b;
    }

    .paid-amount {
        font-weight: 800;
        color: var(--success);
    }

    .empty-data {
        text-align: center;
        padding: 45px;
        font-size: 16px;
        color: var(--text-light);
    }

    /* SCROLL */

    .table-wrapper::-webkit-scrollbar {
        height: 10px;
    }

    .table-wrapper::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 20px;
    }

    /* RESPONSIVE */

    @@media(max-width:992px) {

        .hero-section {
            flex-direction: column;
            align-items: flex-start;
            gap: 18px;
        }

            .hero-section h1 {
                font-size: 26px;
            }

        .table-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
        }
    }

    @@media(max-width:768px) {

        .paid-bills-page {
            padding: 12px;
        }

        .filter-card,
        .table-card {
            padding: 18px;
        }

        th,
        td {
            padding: 14px;
            font-size: 13px;
        }
    }

    /* PRINT */

    @@media print {

        body * {
            visibility: hidden;
        }

        .table-card,
        .table-card * {
            visibility: visible;
        }

        .table-card {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            box-shadow: none;
        }

        .filter-card,
        .hero-section,
        button {
            display: none !important;
        }
    }

</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
    return;
}
else
{
    <div class="container-fluid px-2 px-md-4 mt-4">

        <div class="card shadow-sm border-0 rounded-4">

            <PageHeader TitleText="Paid Bills List"
                        TitleIcon="bi bi-cash-stack"
                        Breadcrumbs="@PaidBillsBreadcrumbs" />

            <div class="paid-bills-page">

                <!-- HERO -->

                <div class="hero-section">

                    <div>
                        <h1>Paid Bills </h1>
                        <p>
                            Track all paid invoices with smart filtering and reporting
                        </p>
                    </div>

                    <div class="header-badge">
                        <i class="bi bi-lightning-charge-fill me-2"></i>
                        Live Tracking
                    </div>

                </div>

                <!-- FILTER -->

                <div class="filter-card">

                    <div class="row g-3 align-items-end">

                        <div class="col-md-2">

                            <div class="filter-item">

                                <label>From Date</label>

                                <input type="date"
                                       class="form-control"
                                       @bind="FromDate" />

                            </div>

                        </div>

                        <div class="col-md-2">

                            <div class="filter-item">

                                <label>To Date</label>

                                <input type="date"
                                       class="form-control"
                                       @bind="ToDate" />

                            </div>

                        </div>

                        <div class="col-md-2">

                            <div class="filter-item">

                                <label>Bill Type</label>

                                <select class="form-select"
                                        value="@SelectedBillType"
                                        @onchange="OnBillTypeChanged">

                                    <option value="">Select Bill Type</option>

                                    <option value="Sales">Sales</option>
                                    <option value="Purchase">Purchase</option>
                                    <option value="Subcontract">Subcontract</option>
                                    <option value="Labour">Labour</option>
                                    <option value="Service Bill In">Service Bill In</option>
                                    <option value="Service Bill Out">Service Bill Out</option>

                                </select>

                            </div>

                        </div>

                        <div class="col-md-3">

                            <div class="filter-item">

                                <label>Paid Customer</label>

                                <select class="form-select"
                                        @onchange="OnCustomerChanged">

                                    <option value="">Select Customer</option>

                                    @if (PaidCustomers != null && PaidCustomers.Any())
                                    {
                                        @foreach (var customer in PaidCustomers)
                                        {
                                            <option value="@customer.CustId">
                                                @customer.CustomerName
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>

                        <div class="col-md-3">

                            <div class="filter-item">

                                <label>Paid Invoice</label>

                                <select class="form-select"
                                        @onchange="OnBillsChanged">

                                    <option value="">Select Invoice</option>

                                    @if (PaidInvoices != null && PaidInvoices.Any())
                                    {
                                        @foreach (var invoice in PaidInvoices)
                                        {
                                            <option value="@invoice.InvId">
                                                @invoice.DocumentInvNo
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- TABLE -->

                <div class="table-card">

                    <div class="table-header d-flex justify-content-between align-items-center">

                        <h2>
                            <i class="bi bi-receipt-cutoff me-2"></i>
                            Paid Bills List
                        </h2>

                        <button class="custom-print-btn"
                                @onclick="OnPrintPendingTrack">

                            <i class="bi bi-download me-2"></i>
                            Export Excel

                        </button>

                    </div>

                    <div class="table-responsive border rounded" style="max-height:600px; overflow-x:auto; overflow-y:auto;">

                        <table class="table table-bordered table-sm mb-0 align-middle" style="min-width:1000px; white-space:nowrap;">

                            <thead class="text-center align-middle sticky-top">

                                <tr>

                                    <th>Customer Name</th>
                                    <th>PaymentType</th>
                                    <th>Payment & Adj No</th>
                                    <th>Trans Date</th>
                                    <th>Invoice No</th>
                                    <th>Invoice Date</th>
                                    <th>Invoice Amount</th>
                                    <th>Paid Received</th>
                                    <th>Bank Name</th>
                                    <th>Cheque No</th>
                                    <th>Cheque Date</th>
                                    <th>Remark</th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (PaidBillsVMs != null && PaidBillsVMs.Any())
                                {
                                    @foreach (var item in PaidBillsVMs)
                                    {
                                        <tr>

                                            <td>@item.CustomerName</td>

                                            <td>@item.PaymentTypeName</td>

                                            <td>@item.DocumentNo</td>

                                            <td>@item.DocumentDate</td>

                                            <td>@item.DocumentInvNo</td>

                                            <td>@item.DocumentInvDate</td>

                                            <td class="invoice-amount">
                                                ₹ @item.GrandTotal
                                            </td>

                                            <td class="paid-amount">
                                                ₹ @item.AdjustAmount
                                            </td>

                                            <td>@item.BankName</td>

                                            <td>@item.ChequeNo</td>

                                            <td>@item.ChequeDate</td>

                                            <td>@item.Description</td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="11"
                                            class="empty-data">

                                            No paid bills found

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>
}

@code {

    protected override string ScreenName => "Bill Paid List";

    public DateTime? FromDate { get; set; }

    public DateTime? ToDate { get; set; }

    public string SelectedBillType { get; set; }

    private List<PaidBillsVM> PaidBillsVMs = new();

    private List<PaidBillsVM> PaidCustomers { get; set; } = new();

    public List<PaidBillsVM> PaidInvoices { get; set; } = new();

    public List<PaidBillsVM> AllData { get; set; } = new();

    private bool isProcessing = true;

    private string? UserName;

    private int? SelectedCustomerId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;

            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }

            UserName = await CurrentUserService.GetUsernameAsync();

            // Today's Date
            ToDate = DateTime.Today;

            // One month back from today
            FromDate = DateTime.Today.AddMonths(-1);

            var data = await paidBillsService.GetPaidBills(
                SelectedBillType,
                FromDate,
                ToDate
            );

            AllData = data?.ToList() ?? new List<PaidBillsVM>();
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "Error occurred while loading Paid Bills"
            );
        }
        finally
        {
            isProcessing = false;
        }
    }

    private List<PageHeader.BreadcrumbItem> PaidBillsBreadcrumbs = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Reports" },
        new PageHeader.BreadcrumbItem { Text = "Accounts" },
        new PageHeader.BreadcrumbItem { Text = "Paid Bills", IsLast = true }
    };

    private async Task OnBillTypeChanged(ChangeEventArgs e)
    {
        SelectedBillType = e.Value?.ToString() ?? "";

        if (!string.IsNullOrEmpty(SelectedBillType))
        {
            AllData = await paidBillsService.GetPaidBills(
                SelectedBillType,
                FromDate,
                ToDate
            );

            PaidBillsVMs = AllData;

            await LoadPendingCustomers(SelectedBillType);
        }
        else
        {
            PaidCustomers.Clear();

            SelectedCustomerId = null;

            PaidBillsVMs.Clear();

            AllData.Clear();
        }
    }

    private async Task LoadPendingCustomers(string SelectedBillType)
    {
        try
        {
            PaidCustomers = PaidBillsVMs
                .GroupBy(i => new
                {
                    i.CustId,
                    i.CustomerName
                })
                .Select(g => new PaidBillsVM
                {
                    CustId = g.Key.CustId,
                    CustomerName = g.Key.CustomerName
                })
                .OrderBy(x => x.CustomerName)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int custId))
            SelectedCustomerId = custId;
        else
            SelectedCustomerId = null;

        if (SelectedCustomerId.HasValue)
        {
            PaidBillsVMs = AllData
                .Where(i => i.CustId == SelectedCustomerId.Value)
                .ToList();

            PaidInvoices = PaidBillsVMs
                .GroupBy(x => new
                {
                    x.InvId,
                    x.DocumentInvNo
                })
                .Select(g => new PaidBillsVM
                {
                    InvId = g.Key.InvId,
                    DocumentInvNo = g.Key.DocumentInvNo
                })
                .ToList();
        }
        else
        {
            PaidBillsVMs = AllData.ToList();

            PaidInvoices = new List<PaidBillsVM>();
        }
    }

    private async Task OnBillsChanged(ChangeEventArgs e)
    {
        var selectedInvoiceId = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(selectedInvoiceId))
        {
            if (SelectedCustomerId.HasValue)
            {
                PaidBillsVMs = AllData
                    .Where(x => x.CustId == SelectedCustomerId.Value)
                    .ToList();
            }
            else
            {
                PaidBillsVMs = AllData;
            }

            return;
        }

        if (int.TryParse(selectedInvoiceId, out int invoiceId))
        {
            PaidBillsVMs = AllData
                .Where(x => x.InvId == invoiceId)
                .ToList();
        }
    }

    private async Task OnPrintPendingTrack()
    {
        try
        {
            if (PaidBillsVMs == null || !PaidBillsVMs.Any())
            {
                await _JS.InvokeVoidAsync(
                    "alert",
                    "No paid bills found to export."
                );

                return;
            }

            string[] headers =
            {
                "Customer Name",
                "Payment & Adj No",
                "Trans Date",
                "Invoice No",
                "Invoice Date",
                "Invoice Amount",
                "Paid Received",
                "Bank Name",
                "Cheque No",
                "Cheque Date",
                "Remark"
            };

            var exportData = PaidBillsVMs
                .Select(x => new
                {
                    x.CustomerName,
                    x.DocumentNo,
                    x.DocumentDate,
                    x.DocumentInvNo,
                    x.DocumentInvDate,
                    x.GrandTotal,
                    x.AdjustAmount,
                    x.BankName,
                    x.ChequeNo,
                    x.ChequeDate,
                    x.Description
                })
                .ToList();

            var fileBytes = await excelTemplateService.CreateTemplateAsync(
                sheetName: "Paid Bills",
                headers: headers,
                sampleData: exportData
            );

            if (fileBytes == null || fileBytes.Length == 0)
            {
                await _JS.InvokeVoidAsync(
                    "alert",
                    "Failed to generate Excel file."
                );

                return;
            }

            var base64 = Convert.ToBase64String(fileBytes);

            await _JS.InvokeVoidAsync(
                "downloadExcelFile",
                base64,
                "PaidBills.xlsx"
            );
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "Error while exporting Paid Bills Excel"
            );

            await _JS.InvokeVoidAsync(
                "alert",
                "Error occurred while exporting Excel."
            );
        }
    }
}