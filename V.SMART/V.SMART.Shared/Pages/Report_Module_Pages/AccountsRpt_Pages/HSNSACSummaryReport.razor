                                    <div class="card-body p-3">

                                        <div class="row align-items-start">

                                            <!-- Report Type -->
                                            <div class="col-md-3">
                                                <label class="small fw-bold mb-2">Report Type</label>

                                                <div class="d-grid gap-2">

                                                    <!-- Sales -->
