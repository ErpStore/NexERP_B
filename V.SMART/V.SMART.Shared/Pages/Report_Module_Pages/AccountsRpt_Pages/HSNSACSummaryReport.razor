                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SelectedHSNCode) || IsAllSelected)
                    {
                       <div class="card shadow-sm mt-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-header text-white d-flex justify-content-between align-items-center flex-wrap gap-2"
                                     style="background:#6EADBC">

                                    <!-- TITLE -->
                                    <h6 class="mb-0">
                                        <i class="bi bi-file-earmark-text me-2"></i> HSN Summary Report
                                    </h6>

                                    <div class="card-header text-white" style="background:#6EADBC">

                                        <div class="row align-items-center gy-2">
                                            <!-- RIGHT SIDE -->
                                            <div class="col-12 col-lg">
                                                <div class="row g-2 justify-content-lg-end">

                                                    <!-- SEARCH -->
                                                    <div class="col-12 col-md-5">
                                                        <div class="input-group shadow-sm rounded-3 overflow-hidden border">
                                                            <span class="input-group-text bg-white border-0">
                                                                <i class="bi bi-search text-muted"></i>
                                                            </span>

                                                            <input type="text"
                                                                   class="form-control border-start-0"
                                                                   placeholder="Search InvoiceNo., Customer, Vendor..."
                                                                   @bind="searchText"
                                                                   @bind:event="oninput" />
                                                        </div>
                                                    </div>

                                                    <!-- COLUMN MENU -->
                                                    <div class="col-12 col-md-auto">
                                                        <div class="dropdown w-100">
                                                            <button class="btn btn-outline-light w-100"
                                                                    type="button"
                                                                    data-bs-toggle="dropdown">
                                                                <i class="bi bi-layout-three-columns me-1"></i>
                                                                Manage Columns
                                                            </button>

                                                            <ul class="dropdown-menu p-3 shadow border-0 rounded-4"
                                                                style="max-height:300px; overflow:auto; min-width:260px;">

                                                                @foreach (var col in Columns.Where(c => !c.IsDetailColumn || IsDetailView))
                                                                {
                                                                    <li class="mb-2">
                                                                        <div class="form-check">
                                                                            <input class="form-check-input"
                                                                                   type="checkbox"
                                                                                   checked="@col.IsVisible"
                                                                                   @onchange="async e => await OnColumnChanged(col, e.Value)" />

                                                                            <label class="form-check-label small fw-semibold">
                                                                                @col.Title
                                                                            </label>
                                                                        </div>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>

                                                    <!-- PRINT -->
                                                    <div class="col-12 col-md-auto">
                                                        <button class="btn btn-success rounded-3 shadow-sm fw-semibold w-100"
                                                                id="btnPrint"
                                                                @onclick="Print">
                                                            <i class="bi bi-file-earmark-excel-fill me-2"></i>
                                                            Print
                                                        </button>
                                                    </div>

                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                </div>

                                <div class="card-body p-0">
                                
                                   
                                    <div class="table-responsive" style="height:500px; overflow-y:auto; overflow-x:auto;">

                                            <table class="table table-bordered table-hover table-striped align-middle mb-0">

                                            <thead class="table-heading position-sticky top-0 z-3">

                                                <tr>
                                                    @if (IsColumnVisible("SlNo"))
                                                    {
                                                        <th>SlNo.</th>
                                                    }
                                                    @if (IsColumnVisible("Customer"))
                                                    {
                                                        <th>Customer</th>
                                                    }
                                                    @if (IsColumnVisible("InvoiceNo"))
                                                    {
                                                        <th>Invoice No</th>
                                                    }
                                                    @if (IsColumnVisible("InvoiceDate"))
                                                    {
                                                        <th>Invoice Date</th>
                                                    }
                                                    @if (IsColumnVisible("Type"))
                                                    {
                                                        <th>Type</th>
                                                    }
                                                    @if (IsColumnVisible("PartNo"))
                                                    {
                                                        <th>Part No</th>
                                                    }
                                                    @if (IsColumnVisible("PartName"))
                                                    {
                                                        <th>Part Name</th>
                                                    }
                                                    @if (IsColumnVisible("HSNCode"))
                                                    {
                                                        <th>HSN Code</th>
                                                    }
                                                    @if (IsColumnVisible("UOM"))
                                                    {
                                                        <th>UOM</th>
                                                    }
                                                    @if (IsColumnVisible("Qty"))
                                                    {
                                                        <th>Qty</th>
                                                    }
                                                

                                                </tr>
                                            </thead>
                                       
                                            <tbody>

                                                @if (FilteredHSNSumData != null && FilteredHSNSumData.Any())
                                                {
                                                    @foreach (var item in FilteredHSNSumData)
                                                    {
                                                        <tr>
                                                            @if (IsColumnVisible("SlNo"))
                                                            {
                                                                <td class="text-center">@item.SlNo</td>
                                                            }
                                                            @if (IsColumnVisible("Customer"))
                                                            {
                                                                <td>@item.Customer</td>
                                                            }
                                                            @if (IsColumnVisible("InvoiceNo"))
                                                            {
                                                                <td>@item.InvoiceNo</td>
                                                            }
                                                            @if (IsColumnVisible("InvoiceDate"))
                                                            {
                                                                <td>@item.InvoiceDate?.ToString("dd/MM/yyyy")</td>
                                                            }
                                                            @if (IsColumnVisible("Type"))
                                                            {
                                                                <td>
                                                                    <span class="badge px-3 py-2 text-white"
                                                                          style="@(item.Type == "Sales"
                                                                                ? "background:linear-gradient(135deg,#4F46E5,#5e435d);"
                                                                                : item.Type == "LABOUR"
                                                                                ? "background:linear-gradient(135deg,#F59E0B,#FBBF24); color:#9491e2;"
                                                                                : item.Type == "EXPORT"
                                                                                ? "background:linear-gradient(135deg,#10B981,#6d90b9);"
                                                                                : item.Type == "PURCHASE"
                                                                                ? "background:linear-gradient(135deg,#06B6D4,#22D3EE); color:#87a3a3;"
                                                                                : item.Type == "SUBCONTRACT"
                                                                                ? "background:linear-gradient(135deg,#EF4444,#5c73b9);"
                                                                                : "background:linear-gradient(135deg,#6B7280,#9CA3AF);")">

                                                                           @item.Type

                                                                    </span>
                                                                </td>
                                                            }
                                                            @if (IsColumnVisible("PartNo"))
                                                            {
                                                                <td>@item.PartNo</td>
                                                            }
                                                            @if (IsColumnVisible("PartName"))
                                                            {
                                                                <td>@item.PartName</td>
                                                            }
                                                            @if (IsColumnVisible("HSNCode"))
                                                            {
                                                                <td>@item.HSNCode</td>
                                                            }
                                                            @if (IsColumnVisible("UOM"))
                                                            {
                                                                <td>@item.UOM</td>
                                                            }
                                                            @if (IsColumnVisible("Qty"))
                                                            {
                                                                <td class="text-end">
                                                                    @item.Qty?.ToString("N2")
                                                                </td>

                                                            }

                                                        </tr>
                                                    }
                                                }
                                            </tbody>

                                            @if (FilteredHSNSumData != null && FilteredHSNSumData.Any())
                                            {
                                                    int visibleColumns = Columns.Count(c => IsColumnVisible(c.Field));

                                                    <tfoot class="table-warning fw-bold">
                                                        <tr>
                                                            <td colspan="@(visibleColumns - 1)" class="text-end">
                                                                Total :
                                                            </td>

                                                            @if (IsColumnVisible("Qty"))
                                                            {
                                                                <td class="text-end">
                                                                    @FilteredHSNSumData.Sum(x => x.Qty ?? 0).ToString("N2")
                                                                </td>
                                                            }
                                                        </tr>
                                                    </tfoot>

                                                @* <tfoot class="table-warning fw-bold">
                                                    <tr>
                                                        @{
                                                            int totalColspan = 0;

                                                            if (IsColumnVisible("SlNo")) totalColspan++;
                                                            if (IsColumnVisible("Customer")) totalColspan++;
                                                            if (IsColumnVisible("InvoiceNo")) totalColspan++;
                                                            if (IsColumnVisible("InvoiceDate")) totalColspan++;
                                                        }

                                                        <td colspan="@totalColspan" class="text-end">
                                                            Total :
                                                        </td>

                                                        @if (IsColumnVisible("Type"))
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (IsColumnVisible("PartNo"))
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (IsColumnVisible("PartName"))
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (IsColumnVisible("HSNCode"))
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (IsColumnVisible("UOM"))
                                                        {
                                                            <td></td>
                                                        }

                                                        @if (IsColumnVisible("Qty"))
                                                        {
                                                            <td>@(FilteredHSNSumData.Sum(x => x.Qty ?? 0))</td>
                                                        }

                                                    </tr>
                                                </tfoot> *@
                                            }

                                        </table>

                                    </div>

                                   
                                </div>
                            </div>

                       </div>
                    }
                    else
                    {
                        <tr>
                            <td colspan="16" class="text-center text-muted py-4">
                                No Records Found
                            </td>
                        </tr>
                    }

                </div>
            </div>
        </div>
    </div>
}

@code
{
    protected override string ScreenName => "HSNSummary Report";
    private bool isProcessing = true;
    private string searchText = string.Empty;
    private bool IsDetailView { get; set; }
    private List<PageHeader.BreadcrumbItem> HSNSummaryBreadcrumbs { get; set; } = new()
    {
        new PageHeader.BreadcrumbItem { Text = "Reports" },
        new PageHeader.BreadcrumbItem { Text = "Accounts" },
        new PageHeader.BreadcrumbItem { Text = "HSNSummary", IsLast = true }
    };
    private List<Customer> Customers = new();
    // Modal properties
    private string ModalTitle = string.Empty;
    private string btnText = string.Empty;
    private string confirmation = string.Empty;
    private string btnColor = string.Empty;

    // private string SelectedOption = "DetailView";
    private bool DetailView = true;
    private bool SummaryView = false;

    // Modal state
    private bool isModalVisible = false;
    private string ActiveModal = "";
    private string MasterModalTitle = "";

    private List<Customer> FilteredParties = new();

    private List<CustomerVM> FilteredCustomers = new();
    private List<VendorVM> FilteredVendors = new();
    private List<ItemVM> FilteredHSNItems = new();
    private bool IsLoading = false;

    public List<HSNSummaryVM> HSNSummaryVMs { get; set; } = new();

    private string SelectedItemId;
    public string SelectedItemCode { get; set; }
    private string SelectedTopic = "";
    public DateTime? FromDate = DateTime.Today.AddMonths(-1);
    public DateTime? ToDate = DateTime.Today;

    private List<ItemVM> ItemList = new();

    private List<HSNSummaryVM> FilteredData = new();
    private string? UserName;
    private int screenCode { get; set; }
    private List<GridColumn> Columns = new();
    private string UserId = "";


    private List<HSNSummaryVM> HSNSummaryList = new();
    private List<HSNSummaryVM> FilteredHSNSummaryList = new();

    private List<HSNSummaryVM> AllHSNData = new();
    private List<HSNSummaryVM> FilteredHSNSummaryData = new();
    private bool IsAllSelected => SelectedHSNCode == "ALL";
    private string hsnSearch = "";
    private List<HSNSummaryVM> HSNSummaryData = new();
    private string SelectedReportType = "";
    private string SelectedHSNCode = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRightsAsync();
            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
            HSNSummaryData = new();
            FilteredHSNSummaryData = new();
            // await LoadHSNData();
            await InitializeColumns(IsHidden);
            screenCode = await hsnSummaryService.GetScreenCodeByScreenNameAsync(ScreenName);
            UserName = await CurrentUserService.GetUsernameAsync();
            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "OnInitializedAsync in Stock Positions");

        }
        finally
        {
            isProcessing = false;
        }
    }

    private void OnDetailViewChanged(ChangeEventArgs e)
    {
        DetailView = (bool)e.Value;

        if (DetailView)
            SummaryView = false;
    }

    private void OnSummaryViewChanged(ChangeEventArgs e)
    {
        SummaryView = (bool)e.Value;

        if (SummaryView)
            DetailView = false;
    }

    private async Task InitializeColumns(bool Hidden)
    {
        try
        {
            Columns = new List<GridColumn>
            {
                // ================= MAIN COLUMNS =================
                new() { Title = "SlNo", Field = "SlNo", IsVisible = true, IsDetailColumn = false },
                new() { Title = "Customer", Field = "Customer", IsVisible = true, IsDetailColumn = false },
                new() { Title = "Type", Field = "Type", IsVisible = true, IsDetailColumn = false },
                new() { Title = "Invoice No.", Field = "InvoiceNo", IsVisible = true, IsDetailColumn = false },
                new() { Title = "Invoice Date", Field = "InvoiceDate", IsVisible = true, IsDetailColumn = false },
                new() { Title = "Part No", Field = "PartNo", IsVisible = true, IsDetailColumn = false },
                new() { Title = "Part Name", Field = "PartName", IsVisible = true, IsDetailColumn = false },
                new() { Title = "HSN Code", Field = "HSNCode", IsVisible = true, IsDetailColumn = false },
                new() { Title = "UOM", Field = "UOM", IsVisible = true, IsDetailColumn = false },
                new() { Title = "Qty", Field = "Qty", IsVisible = true, IsDetailColumn = false },

            };

            await LoadColumnPreferences(UserName);
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in InitializeColumns()");
        }
    }

    private async Task LoadColumnPreferences(string UserName)
    {
        try
        {
            var saved = await PreferenceService.LoadPreferencesAsync(ScreenName, UserName);

            if (saved != null && saved.Any())
            {
                foreach (var col in Columns)
                {
                    var match = saved.FirstOrDefault(x => x.Field == col.Field);
                    if (match != null)
                        col.IsVisible = match.IsVisible;
                }
            }
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error loading column preferences for JobOrderList");
            await _js.ToastrError("Failed to load column preferences.");
        }
    }


    private async Task HandleColumnChange(List<GridColumn> updated)
    {
        try
        {
            Columns = updated;
            await PreferenceService.SavePreferencesAsync(ScreenName, UserName, Columns);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error in HandleColumnChange()");
        }
    }

    private async Task OnColumnChanged(GridColumn column, object value)
    {
        try
        {
            column.IsVisible = Convert.ToBoolean(value);
            await PreferenceService.SavePreferencesAsync(ScreenName, UserName, Columns);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error changing column");
        }
    }

    // private bool IsColumnVisible(string field)
    // {
    //     return Columns.Any(x => x.Field == field && x.IsVisible);
    // }

    private bool IsColumnVisible(string field)
    {
        var column = Columns.FirstOrDefault(x => x.Field == field);

        if (column == null || !column.IsVisible)
            return false;

        if (SummaryView)
        {
            return field == "HSNCode"
                || field == "Qty"
                || field == "Type";
        }

        return true;
    }

    private async Task OnReportTypeChanged(ChangeEventArgs e)
    {
        SelectedReportType = e.Value?.ToString() ?? "";

        SelectedHSNCode = "";
        FilteredHSNSummaryData.Clear();

        HSNSummaryData = await hsnSummaryService.GetHSNSummaryReportAsync(
            SelectedReportType,
            FromDate,
            ToDate);

        int i = 1;

        foreach (var item in FilteredHSNSumData)
        {
            item.SlNo = i++;
        }

        StateHasChanged();
    }

    private async Task LoadHSNData()
    {
        HSNSummaryData = await hsnSummaryService.GetHSNSummaryReportAsync(
            SelectedReportType,
            FromDate,
            ToDate);

        int i = 1;

        foreach (var item in FilteredHSNSumData)
        {
            item.SlNo = i++;
        }

        Console.WriteLine($"Records : {HSNSummaryData.Count}");

        foreach (var item in HSNSummaryData.Take(5))
        {
            Console.WriteLine(item.HSNCode);
        }

        FilteredHSNSummaryData = HSNSummaryData.ToList();

        StateHasChanged();
    }

    private void ApplyHSNFilter()
    {
        if (SelectedHSNCode == "ALL")
        {
            FilteredHSNSummaryData = AllHSNData.ToList();
        }
        else
        {
            FilteredHSNSummaryData = AllHSNData
                .Where(x => x.HSNCode == SelectedHSNCode)
                .ToList();
        }

        StateHasChanged();
    }

    private IEnumerable<HSNSummaryVM> FilteredItems
    {
        get
        {
            if (HSNSummaryData == null || !HSNSummaryData.Any())
                return Enumerable.Empty<HSNSummaryVM>();

            return HSNSummaryData
                .Where(x => !string.IsNullOrWhiteSpace(x.HSNCode))
                .Where(x => string.IsNullOrWhiteSpace(hsnSearch)
                         || x.HSNCode!.Contains(hsnSearch, StringComparison.OrdinalIgnoreCase))
                .GroupBy(x => x.HSNCode)
                .Select(g => g.First())
                .OrderBy(x => x.HSNCode);
        }
    }

    private void SelectHSNCode(string hsnCode)
    {
        SelectedHSNCode = hsnCode;

        if (hsnCode == "ALL")
        {
            FilteredHSNSummaryData = HSNSummaryData.ToList();
        }
        else
        {
            FilteredHSNSummaryData = HSNSummaryData
                .Where(x => x.HSNCode == hsnCode)
                .ToList();
        }

        int i = 1;

        foreach (var item in FilteredHSNSumData)
        {
            item.SlNo = i++;
        }

        StateHasChanged();
    }

    IEnumerable<HSNSummaryVM> FilteredHSNSumData
    {
        get
        {
            var filtered = (FilteredHSNSummaryData ?? Enumerable.Empty<HSNSummaryVM>())
                .Where(s =>
                    string.IsNullOrWhiteSpace(searchText)
                    || (!string.IsNullOrWhiteSpace(s.InvoiceNo) &&
                        s.InvoiceNo.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                    || (!string.IsNullOrWhiteSpace(s.Customer) &&
                        s.Customer.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                    || (!string.IsNullOrWhiteSpace(s.Type) &&
                        s.Type.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                    ||  (!string.IsNullOrEmpty(s.HSNCode) &&
                        s.HSNCode.Contains(searchText,StringComparison.OrdinalIgnoreCase)))
                        .ToList();

            for (int i = 0; i < filtered.Count; i++)
            {
                filtered[i].SlNo = i + 1;
            }

            return filtered;
        }
    }


