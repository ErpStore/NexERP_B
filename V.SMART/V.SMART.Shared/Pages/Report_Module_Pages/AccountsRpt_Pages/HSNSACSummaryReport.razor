                                                <label class="small fw-bold">HSN Code</label>

                                                <input class="form-control form-control-sm"
                                                       placeholder="Search HSN Code..."
                                                       value="@hsnSearch"
                                                       @oninput="OnHSNSearchChange" />
                                                    @* <div class="border rounded shadow-sm bg-white mt-3 p-2 overflow-y-auto"
                                                         style="height:200px;"> *@
                                                <div class="border rounded shadow-sm bg-white mt-3 p-2"
                                                     style="height:200px;
                                                        overflow-y:auto;
                                                        overflow-x:auto;
                                                        white-space:nowrap;">
                                                    <!-- ALL -->
                                                    <div class="dropdown-item cursor-pointer
                                                    @(IsAllSelected ? "text-white fw-bold" : "")"
                                                         style="@(IsAllSelected ? "background-color:#815355;" : "")"
                                                         @onclick='() => SelectHSNCode("ALL")'>
                                                        ALL
                                                    </div>

                                                    @foreach (var item in FilteredItems)
                                                    {
                                                        <div class="dropdown-item cursor-pointer
                                                        @(SelectedHSNCode == item.HSNCode ? "text-white fw-bold" : "")"
                                                             style="@(SelectedHSNCode == item.HSNCode ? "background-color:#815355;" : "")"
                                                             @onclick='() => SelectHSNCode(item.HSNCode)'>

                                                            @item.HSNCode

                                                        </div>
                                                    }

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

