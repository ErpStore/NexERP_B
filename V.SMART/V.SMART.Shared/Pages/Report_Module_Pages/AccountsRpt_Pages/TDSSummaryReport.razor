    private async Task OnInputChanged(ChangeEventArgs e)
    {
        try
        {
            searchText = e.Value?.ToString() ?? "";

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "Error while searching");
        }
    }

    private void OnPartySearchChange(ChangeEventArgs e)
    {
        partySearch = e.Value?.ToString() ?? "";

        // ================= PURCHASE =================

        if (SelectedTopic == "Purchase")
        {
            FilteredVendors = VendorList
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.VendorName) &&
                    x.VendorName.Contains(
                        partySearch,
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        // ================= SALES / EXPORT =================

        else
        {
            FilteredCustomers = CustomerList
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.CustName) &&
                    x.CustName.Contains(
                        partySearch,
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task OnReportTypeChanged(string reportType)
    {
        try
        {
            IsLoading = true;

            SelectedTopic = reportType;

            var result = await tdsSummaryService.GetTDSSummaryReportAsync(
                SelectedTopic,
                FromDate,
                ToDate);

            FilteredTDSReportList = result?.ToList() ?? new List<TDSReportVM>();

            int i = 1;

            foreach (var item in FilteredTDSReportList)
            {
                item.SlNo = i++;
            }
        }
        catch (Exception ex)
        {
            FilteredTDSReportList = new List<TDSReportVM>();

            await _logs.LogDeveloperError(ex, "Error in OnReportTypeChanged");
        }
        finally
        {
            IsLoading = false;

            StateHasChanged();
        }
    }

    private async Task DateChanged()
    {
        if (!string.IsNullOrEmpty(SelectedTopic))
        {
            await OnReportTypeChanged(SelectedTopic);
        }
    }


    private async Task ExportTDSSummaryDataToExcel(bool isConfirm)
    {
        try
        {
            isProcessing = true;

            await _js.InvokeVoidAsync("HideConfirmationModal");

            if (!isConfirm)
                return;

            if (FilteredTDSSummaryData == null || !FilteredTDSSummaryData.Any())
            {
                await _js.ToastrWarning("No data available");
                return;
            }

            List<Dictionary<string, object>> exportData = new();

            foreach (var item in FilteredTDSSummaryData)
            {
                Dictionary<string, object> row = new();

                // =========================
                // MAIN COLUMNS
                // =========================

                if (IsColumnVisible("SlNo"))
                    row.Add("Sl No.", item.SlNo);

                if (IsColumnVisible("Customer"))
                    row.Add("Customer", item.Customer);

                if (IsColumnVisible("InvoiceNo"))
                    row.Add("Invoice No.", item.InvoiceNo);

                if (IsColumnVisible("InvoiceDate"))
                    row.Add("Invoice Date", item.InvoiceDate?.ToString("dd/MM/yyyy"));

                if (IsColumnVisible("Type"))
                    row.Add("Type", item.Type);

                if (IsColumnVisible("InvoiceValue"))
                    row.Add("Invoice Value", item.InvoiceValue);

                if (IsColumnVisible("TotalBasicAmount"))
                    row.Add("Basic Amount", item.TotalBasicAmount);

                if (IsColumnVisible("CreditDebitNoteNo"))
                    row.Add("Credit/Debit Note No", item.CreditDebitNoteNo);

                if (IsColumnVisible("CreditDebitNoteDate"))
                    row.Add("Credit/Debit Note Date", item.CreditDebitNoteDate);

                if (IsColumnVisible("CreditDebitNoteAmt"))
                    row.Add("Credit/Debit Note Amount", item.CreditDebitNoteAmt);

                if (IsColumnVisible("TDSPercent"))
                    row.Add("TDS %", item.TDSPercent);

                if (IsColumnVisible("TDSAmt"))
                    row.Add("TDS Amount", item.TDSAmt);

                if (IsColumnVisible("TotalAmount"))
                    row.Add("Total Amount", item.TotalAmount);

                if (IsColumnVisible("InvoiceBalance"))
                    row.Add("Invoice Balance", item.InvoiceBalance);

                if (IsColumnVisible("Remarks"))
                    row.Add("Remarks", item.Remarks);

                if (IsColumnVisible("PANNo"))
                    row.Add("PAN No.", item.PANNo);

                
                exportData.Add(row);
            }

            if (!exportData.Any())
            {
                await _js.ToastrWarning("No data found for export");

                return;
            }

            var bytes = await ExcelExportService.ExportPendingListToExcel(exportData, "TDSSummary", "TDS Summary List");
            var base64 = Convert.ToBase64String(bytes);
            await _js.DownloadExcelAsync(base64, "TDSSummary.xlsx");
            await _js.ToastrSuccess("Excel exported successfully");
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "ExportTDSSummaryDataToExcel");
            await _js.ToastrError("Error while exporting TDS Summary Report!");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public async Task<byte[]> CreateTemplateAsync(string sheetName, string[] headers, IEnumerable<object> data)
    {
        try
        {
            using var workbook = new XLWorkbook();

            var worksheet = workbook.Worksheets.Add(sheetName);

            // HEADER
            for (int col = 0; col < headers.Length; col++)
            {
                var cell = worksheet.Cell(1, col + 1);

                cell.Value = headers[col];

                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.Yellow;
            }

            int rowIndex = 2;

            foreach (var obj in data)
            {
                for (int col = 0; col < headers.Length; col++)
                {
                    var header = headers[col];

                    object? value = null;

                    // PROPERTY MATCH
                    var prop = obj.GetType().GetProperty(header);

                    if (prop != null)
                    {
                        value = prop.GetValue(obj);
                    }

                    worksheet.Cell(rowIndex, col + 1).Value =
                        value?.ToString() ?? "";
                }

                rowIndex++;
            }

            worksheet.Columns().AdjustToContents();

            using var stream = new MemoryStream();

            workbook.SaveAs(stream);

            return stream.ToArray();
        }
        catch (Exception ex)
        {
            await _logs.LogDeveloperError(ex, "CreateTemplateAsync");

            await _js.ToastrError("Excel creation failed");

            return Array.Empty<byte>();
        }
    }
