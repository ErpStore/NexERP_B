                            <option value="Subcontract">Subcontract</option>

                        </InputSelect> *@

                      @*   <InputSelect class="form-select shadow-sm"
                                     Value="SelectedType"
                                     ValueChanged="OnTypeChanged"
                                     ValueExpression="() => SelectedType">

                            <option value="">Select Type</option>
