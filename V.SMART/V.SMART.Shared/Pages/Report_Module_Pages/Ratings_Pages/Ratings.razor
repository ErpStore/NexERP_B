    private Task<IEnumerable<ItemVM>> SearchItems(string value, CancellationToken cancellationToken)
    {
        IEnumerable<ItemVM> result;

        if (string.IsNullOrWhiteSpace(value))
        {
            result = Items;
        }
        else
        {
            result = Items.Where(x =>
                x.ItemCode.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(result);
    }


