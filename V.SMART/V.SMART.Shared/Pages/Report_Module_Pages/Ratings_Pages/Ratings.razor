@inject NavigationManager _navigation
@inject IExcelTemplateService excelTemplateService

<style>
    .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
    }

        .table-responsive thead th {
            position: sticky;
            top: 0;
            z-index: 100;
            background: #0d6efd;
            color: #fff;
            border-bottom: 2px solid #0a58ca;
        }

        .small-autocomplete .mud-input-control {
            min-height: 32px;
        }

        .small-autocomplete .mud-input-slot {
            min-height: 32px;
            padding-top: 4px;
            padding-bottom: 4px;
        }

        .small-autocomplete input {
            padding: 4px 8px !important;
            font-size: 13px;
        }
</style>

@if (isProcessing)
{
    <ProcessingOverlay Visible="@isProcessing" Message="Please wait..." />
}
else if (!CanView)
{
    <RedirectToLogin />
}
else
{
    <div class="container-fluid mt-4">

        <!-- Header -->
        <div class="card border-0 shadow-lg mb-4">

            <div class="card-header bg-light border-bottom">

                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body bg-primary text-white rounded">

                        <div class="row align-items-center">

                            <div class="col-md-8">

                                <h4 class="fw-bold mb-1">
                                    <i class="bi bi-speedometer2 me-2"></i>
