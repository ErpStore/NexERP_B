                    </div>
                }
                else if (ShowFPY)
                {
                    <div class="card-header bg-success text-white py-2">

                        <div class="row align-items-center">

                            <div class="col-lg-4 col-md-4">
                                <h5 class="mb-0">
                                    <i class="bi bi-pie-chart me-2"></i>
                                    First Pass Yield (FPY) Report
                                </h5>
                            </div>



                            <div class="col-lg-4 col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-search"></i>
                                    </span>

                                    <InputText class="form-control"
                                               placeholder="Search..."
                                               @bind-Value="searchText1"
                                               @oninput="e => searchText1 = e.Value?.ToString()" />
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 text-end">
                                <button class="btn btn-light"
                                        @onclick="OnPrintPendingTrack1">
                                    <i class="bi bi-download me-2"></i>
                                    Export Excel
                                </button>
                            </div>

                        </div>

                    </div>
                }

                <!-- Body -->
                <div class="card-body">

                    @if (ShowRatings)
                    {
                        <!-- Put your existing Rating table here -->
                        @* <table class="table table-hover table-striped table-bordered align-middle"> *@

                        <div class="table-responsive table-scroll">

                            <table class="table table-bordered table-striped table-hover mb-0 py-2">


                             <thead class="table-primary">
                                <tr>
                                    @if (IsVisible("SlNo"))
                                    {
                                        <th>Sl No</th>
                                    }
                                    @if (IsVisible("CustName"))
                                    {
                                        <th>Customer Name</th>
                                    }
                                    @if (IsVisible("PONo"))
                                    {
                                        <th>PO No</th>
                                    }
                                    @if (IsVisible("PODate"))
                                    {
                                        <th>PO Date</th>
                                    }
                                    @if (DetailsView && IsVisible("ItemCode"))
                                    {
                                        <th>Item Code</th>
                                    }

                                    @if (DetailsView && IsVisible("ItemName"))
                                    {
                                        <th>Item Name</th>
                                    }

                                    @if (IsVisible("Qty"))
                                    {
                                        <th>Qty</th>
                                    }
                                    @*   @if (DetailsView && IsVisible("WoNo"))
                                    {
                                        <th>WO No</th>
                                    } *@
                                    @if (IsVisible("PoDueDate"))
                                    {
                                        <th>Due Date</th>
                                    }
                                    @if (IsVisible("DcNo"))
                                    {
                                        <th>DC No</th>
                                    }
                                    @if (IsVisible("DCDate"))
                                    {
                                        <th>DC Date</th>
                                    }
                                    @if (IsVisible("DcQty"))
                                    {
                                        <th>DC Qty</th>
                                    }
                                    @if (IsVisible("RejectQty"))
                                    {
                                        <th>Reject Qty</th>
                                    }
                                    @if (IsVisible("ReworkQty"))
                                    {
                                        <th>R/W Qty</th>
                                    }
                                    @if (IsVisible("InvNo"))
                                    {
                                        <th>Inv No</th>
                                    }
                                    @if (IsVisible("InvDate"))
                                    {
                                        <th>Inv Date</th>
                                    }
                                    @if (IsVisible("INVQty"))
                                    {
                                        <th>Inv Qty</th>
                                    }
                                    @if (IsVisible("TotalDays"))
                                    {
                                        <th>Delay Days</th>
                                    }
                                    @if (IsVisible("Perfarmence Rating"))
                                    {
                                        <th>Perfarmence Rating</th>
                                    }
                                    @if (IsVisible("DeliveryRating"))
                                    {
                                        <th>Delivery Rating</th>
                                    }
                                    @if (IsVisible("QualityRating"))
                                    {
                                        <th>Quality Rating</th>
                                    }
                                    @if (IsVisible("SalesRating"))
                                    {
                                        <th>Sales Rating</th>
                                    }
                                    @if (IsVisible("VendorRating"))
                                    {
                                        <th>Vendor Rating</th>
                                    }
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in FilteredRatings.Select((x, i) => new { x, i }))
                                {
                                    <tr>
                                        @if (IsVisible("SlNo"))
                                        {
                                            <td>@(item.i + 1)</td>
                                        }

                                        @if (IsVisible("CustName"))
                                        {
                                            <td class="fw-semibold">@item.x.CustName</td>
                                        }

                                        @if (IsVisible("PONo"))
                                        {
                                            <td>@item.x.PONo</td>
                                        }

                                        @if (IsVisible("PODate"))
                                        {
                                            <td>@item.x.PODate?.ToString("dd/MM/yyyy")</td>
                                        }

                                        @if (DetailsView && IsVisible("ItemCode"))
                                        {
                                            <td>@item.x.ItemCode</td>
                                        }

                                        @if (DetailsView && IsVisible("ItemName"))
                                        {
                                            <td>@item.x.ItemName</td>
                                        }

                                        @if (IsVisible("Qty"))
                                        {
                                            <td>@item.x.Qty</td>
                                        }

                                        @*  @if (DetailsView && IsVisible("WoNo"))
                                        {
                                            <td>@item.x.WoNo</td>
                                        } *@

                                        @if (IsVisible("PoDueDate"))
                                        {
                                            <td>@item.x.PoDueDate?.ToString("dd/MM/yyyy")</td>
                                        }

                                        @if (IsVisible("DcNo"))
                                        {
                                            <td>@item.x.DcNo</td>
                                        }

                                        @if (IsVisible("DCDate"))
                                        {
                                            <td>@item.x.DCDate?.ToString("dd/MM/yyyy")</td>
                                        }

                                        @if (IsVisible("DcQty"))
                                        {
                                            <td>@item.x.DcQty</td>
                                        }

                                        @if (IsVisible("RejectQty"))
                                        {
                                            <td>@item.x.RejectQty</td>
                                        }

                                        @if (IsVisible("ReworkQty"))
                                        {
                                            <td>@item.x.ReworkQty</td>
                                        }

                                        @if (IsVisible("InvNo"))
                                        {
                                            <td>@item.x.InvNo</td>
                                        }

                                        @if (IsVisible("InvDate"))
                                        {
                                            <td>@item.x.InvDate?.ToString("dd/MM/yyyy")</td>
                                        }

                                        @if (IsVisible("INVQty"))
                                        {
                                            <td>@item.x.INVQty</td>
                                        }

                                        @if (IsVisible("TotalDays"))
                                        {
                                            <td>
                                                <span class="badge bg-info">
                                                    📅 @item.x.TotalDays
                                                </span>
                                            </td>
                                        }

                                        @if (IsVisible("Perfarmence Rating"))
                                        {
                                            <td>
                                                <span class="badge bg-warning text-dark">
                                                    ⭐ @item.x.Rating
                                                </span>
                                            </td>
                                        }

                                        @if (IsVisible("DeliveryRating"))
                                        {
                                            <td>
                                                <span class="badge bg-primary">
                                                    ⭐ @item.x.DeliveryRating
                                                </span>
                                            </td>
                                        }

                                        @if (IsVisible("QualityRating"))
                                        {
                                            <td>
                                                <span class="badge bg-success">
                                                    ⭐  @item.x.QualityRating
                                                </span>
                                            </td>
                                        }

                                        @if (IsVisible("SalesRating"))
                                        {
                                            <td>
                                                <span class="badge bg-secondary">
                                                    ⭐ @item.x.SalesRating
                                                </span>
                                            </td>
                                        }

                                        @if (IsVisible("VendorRating"))
                                        {
                                            <td>
                                                <span class="badge bg-danger">
                                                    ⭐ @item.x.VendorRating
                                                </span>
                                            </td>
                                        }


                                    </tr>
                                }

                            </tbody>

                        </table>
                        </div>
                    }

                    @if (ShowFPY)
                    {
                        <div class="table-responsive table-scroll">

                            <table class="table table-bordered table-striped table-hover mb-0 py-2">

                                <thead class="table-success">

                                    <tr>
                                        <th>Party</th>
                                        <th>Item code</th>
                                        <th>Item Name</th>
                                        <th class="text-end">Production Qty</th>
                                        <th class="text-end">Reject Qty</th>
                                        <th class="text-end">Rework Qty</th>
                                        <th class="text-end">FPY Qty</th>
                                        <th class="text-end">FPY %</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in FilteredFPYReport)
                                    {
                                        <tr>

                                            <td>@item.PartyName</td>
                                           
                                            <td>@item.Itemcode</td>

                                            <td>@item.ItemName</td>

                                            <td class="text-end">
                                                @item.ProductionQty
                                            </td>

                                            <td class="text-end">
                                                @item.RejectionQty
                                            </td>

                                            <td class="text-end">
                                                @item.ReworkQty
                                            </td>

                                            <td class="text-end fw-bold text-success">
                                                @item.FPYQty
                                            </td>

                                            <td class="text-end fw-bold">
                                                @item.FPYPercentage.ToString("0.00") %
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                         <div class="row mt-4">

                            <div class="col-md-4">
                                <div class="card border-primary shadow">
                                    <div class="card-body text-center">
                                        <h6>Production Qty</h6>
                                        <h3 class="text-primary">
                                            @FPYReport.Sum(x => x.ProductionQty)
                                        </h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="card border-danger shadow">
                                    <div class="card-body text-center">
                                        <h6>Reject Qty</h6>
                                        <h3 class="text-danger">
                                            @FPYReport.Sum(x => x.RejectionQty)
                                        </h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="card border-warning shadow">
                                    <div class="card-body text-center">
                                        <h6>Rework Qty</h6>
                                        <h3 class="text-warning">
                                            @FPYReport.Sum(x => x.ReworkQty)
                                        </h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="card border-success shadow">
                                    <div class="card-body text-center">
                                        <h6>FPY Qty</h6>
                                        <h3 class="text-success">
                                            @FPYReport.Sum(x => x.FPYQty)
                                        </h3>
                                    </div>
                                </div>
                            </div>


                            <div class="col-md-2">
                                <div class="card border-info shadow">
                                    <div class="card-body text-center">
                                        <h6>FPY %</h6>
                                        <h3 class="text-info">
                                            @{
                                                var totalProduction = FPYReport.Sum(x => x.ProductionQty);
                                                var totalFPYQty = FPYReport.Sum(x => x.FPYQty);

                                                var overallFPY = totalProduction > 0
                                                ? Math.Round((totalFPYQty / totalProduction) * 100, 2)
                                                : 0;
                                            }

                                            @overallFPY.ToString("0.00")%
                                        </h3>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="alert alert-warning mt-3">
                No data available.
            </div>
        }

  
       
    </div>
}


@code {

    protected override string ScreenName => "Ratings";
    private List<PartyVM> Parties = new();

    private List<ItemVM> Items = new();

    private List<FPYVM> FPYReport = new();

    public decimal FPYPercent { get; set; }

    private bool isProcessing = false;


    private decimal OverallFPYPercentage;

    private bool ShowRatings = false;
    private bool ShowFPY = false;

    private string SelectedType = "";
    private string SelectedParty = "";

    private string SelectedItem = "";

    private string PartyLabel = "Party";

    public bool DetailsView { get; set; }

    private string? UserName;

    private bool IsLoading { get; set; }

    private string searchText;

    private string searchText1 = string.Empty;

    public List<GridColumn> Columns { get; set; }

    private DateTime? FromDate = DateTime.Today.AddMonths(-1);
    private DateTime? ToDate = DateTime.Today;


    private List<RatingVM> RatingVMs = new();




    protected override async Task OnInitializedAsync()
    {
        try
        {
            isProcessing = true;

            await LoadRightsAsync();

            if (!CanView)
            {
                _navigation.NavigateTo("/access-denied");
                return;
            }
        }
        catch (Exception ex)
        {
            await LoggingService.LogDeveloperError(
                ex,
                "Error loading Ratings page");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private List<PageHeader.BreadcrumbItem> RatingBreadcrumbs = new()
    {
        new() { Text = "Reports" },
        new() { Text = "Ratings" },
        new() { Text = "Rating", IsLast = true }
    };


    private bool IsVisible(string field)
    {
        return Columns?.FirstOrDefault(x => x.Field == field)?.IsVisible ?? true;
    }


    public async Task InitializeColumns(bool hidden)
    {
        try
        {
            Columns = new List<GridColumn>();

            if (SelectedType == "Sales" ||
                SelectedType == "Labour" ||
                SelectedType == "Subcontract" ||
                SelectedType == "Purchase")
            {
                Columns.AddRange(new[]
                {
                new GridColumn { Title = "Sl No", Field = "SlNo", IsVisible = true },

                new GridColumn { Title = "Customer Name", Field = "CustName", IsVisible = true },

                new GridColumn { Title = "PO No", Field = "PONo", IsVisible = true },

                new GridColumn { Title = "PO Date", Field = "PODate", IsVisible = true },

                new GridColumn { Title = "Item Code", Field = "ItemCode", IsVisible = true },

                new GridColumn { Title = "Item Name", Field = "ItemName", IsVisible = true },

                new GridColumn { Title = "Qty", Field = "Qty", IsVisible = true },

                new GridColumn { Title = "WO No", Field = "WoNo", IsVisible = true },

                new GridColumn { Title = "Due Date", Field = "PoDueDate", IsVisible = true },

                new GridColumn { Title = "DC No", Field = "DcNo", IsVisible = true },

                new GridColumn { Title = "DC Date", Field = "DCDate", IsVisible = true },

                new GridColumn { Title = "DC Qty", Field = "DcQty", IsVisible = true },

                new GridColumn { Title = "Reject Qty", Field = "RejectQty", IsVisible = true },

                new GridColumn { Title = "Rework Qty", Field = "ReworkQty", IsVisible = true },

                new GridColumn { Title = "Invoice No", Field = "InvNo", IsVisible = true },

                new GridColumn { Title = "Invoice Date", Field = "InvDate", IsVisible = true },

                new GridColumn { Title = "Invoice Qty", Field = "INVQty", IsVisible = true },

