    private async Task OnPartyChanged(PartyVM? value)
    {
        SelectedPartyVM = value;
        if (value == null)
        {
            SelectedParty = "";      // or null
            SelectedItem = "";
            SelectedItemVM = null;
            Items.Clear();

            // Load all parties data


            RatingVMs = await ratingService.GetRatings(
             DetailsView,
             SelectedType,
             SelectedParty,
             FromDate,
             ToDate);

            return;
        }


        SelectedParty = value.Id.ToString();
        // Select it automatically
       
        
        // Clear Item
        SelectedItem = "";
        SelectedItemVM = null;
        Items.Clear();

        if (string.IsNullOrWhiteSpace(SelectedParty))
            return;

        int partyId = Convert.ToInt32(SelectedParty);

      

        if (SelectedType == "Sales")
        {
            Items = await _unitOfWork.MfgDcs
                .GetQueryable()
                .Where(dc =>
                    dc.CustId == partyId &&
                    (!FromDate.HasValue || dc.DcDate >= FromDate.Value) &&
                    (!ToDate.HasValue || dc.DcDate < ToDate.Value.AddDays(1)))
                .SelectMany(dc => dc.MfgDcSubs)
                .Select(x => new ItemVM
                {
                    ItemId = x.Item.ItemId,
                    ItemCode = x.Item.ItemCode
                })
                .Distinct()
                .OrderBy(x => x.ItemCode)
                .ToListAsync();
        }
        else if (SelectedType == "Purchase")
        {
            Items = await _unitOfWork.PurchaseGRNs
                .GetQueryable()
                .Where(grn =>
                    grn.VendorCode == partyId &&
                    (!FromDate.HasValue || grn.GRNDate >= FromDate.Value) &&
                    (!ToDate.HasValue || grn.GRNDate < ToDate.Value.AddDays(1)))
                .SelectMany(grn => grn.PurchaseGRNSubs)
                .Select(x => new ItemVM
                {
                    ItemId = x.ItemId,
                    ItemCode = x.Item.ItemCode
                })
                .Distinct()
                .OrderBy(x => x.ItemCode)
                .ToListAsync();
        }
        else if (SelectedType == "SubContract")
        {
            Items = await _unitOfWork.SubConGRNs
                .GetQueryable()
                .Where(grn =>
                    grn.VendorCode == partyId &&
                    (!FromDate.HasValue || grn.GRNDate >= FromDate.Value) &&
                    (!ToDate.HasValue || grn.GRNDate < ToDate.Value.AddDays(1)))
                .SelectMany(grn => grn.SubConGRNSubs)
                .Select(x => new ItemVM
                {
                    ItemId = x.ItemId!.Value,
                    ItemCode = x.Item.ItemCode
                })
                .Distinct()
                .OrderBy(x => x.ItemCode)
                .ToListAsync();
        }
        else if (SelectedType == "Labour")
        {
            Items = await _unitOfWork.LabourGRNs
                .GetQueryable()
                .Where(grn =>
                    grn.CustId == partyId &&
                    (!FromDate.HasValue || grn.GRNDate >= FromDate.Value) &&
                    (!ToDate.HasValue || grn.GRNDate < ToDate.Value.AddDays(1)))
                .SelectMany(grn => grn.LabourGRNSubs)
                .Select(x => new ItemVM
                {
                    ItemId = x.ItemId!.Value,
                    ItemCode = x.Item.ItemCode
                })
                .Distinct()
                .OrderBy(x => x.ItemCode)
                .ToListAsync();
        }

        Items.Insert(0, new ItemVM
        {
            ItemId = 0,
            ItemCode = "All Items"
        });
        SelectedItem = "0"; // Select "All Items" by default

        StateHasChanged();
    }

