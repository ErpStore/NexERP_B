                                </option>
                            }

                        </InputSelect>
                    </div> *@

                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-bold text-success">
                        Item
                    </label>

                <MudBlazor.MudAutocomplete T="ItemVM"
                                     Value="@SelectedItemVM"
                                     ValueChanged="@OnItemChanged"
                                     SearchFunc="@SearchItems"
