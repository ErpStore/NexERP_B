@code {

    [Parameter] public bool DrawerOpen { get; set; }
    [Parameter] public EventCallback ToggleDrawer { get; set; }
    [Parameter] public EventCallback<string?> OnFlyoutChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await DetectActiveModule();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await DetectActiveModule();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private CustomAuthStateProvider? CustomAuth =>
        AuthenticationStateProvider as CustomAuthStateProvider;

    private bool ShowProductionMenu =>
        CustomAuth?.IsQrLogin == true &&
        CustomAuth?.IsProductionUser == true;


    // ── Active route ─────────────────────────────────────────────────────
    private string ActiveHref =>
        "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');

    private bool IsActive(string href)
    {
        var rel = href.TrimStart('/').TrimEnd('/');
        var cur = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        if (string.IsNullOrEmpty(rel)) return string.IsNullOrEmpty(cur);
        return cur.Equals(rel, StringComparison.OrdinalIgnoreCase) ||
               cur.StartsWith(rel + "/", StringComparison.OrdinalIgnoreCase);
    }

    // ── Flyout state ─────────────────────────────────────────────────────
    private string? _activeFlyout;

    // ── Data model (public static so MainLayout can render the subnav bar) ──────────
    public record NavItem(string Label, string Href, List<NavItem>? Children = null);
    public record NavGroupDef(string MudIcon, List<NavItem> Items);

    public static readonly Dictionary<string, NavGroupDef> NavGroups = new()
    {
        // ═══════════════════════════════════════
        // DASHBOARD
        // ═══════════════════════════════════════
