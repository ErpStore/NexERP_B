                new("BOM Cost Estimation",        "costcalculator"),
            }),

            new("General Master", "", new()
            {
                new("Customer Master",            "customer"),
                new("Vendor Master",              "vendor"),
                new("Machine Master",             "machineList"),
                new("Terms & Conditions",         "terms-and-conditions"),
                new("States Master",              "state"),
                new("Master Upload",              "master-upload"),
                new("Contract Review Master",     "contractReviewMasterList"),
                new("Rejection Master",           "RejectionMaster"),
            }),

            new("Account Master", "", new()
            {
                new("Expense Master",             "expense"),
                new("Income Master",              "income"),
