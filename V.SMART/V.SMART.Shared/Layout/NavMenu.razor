    // ── Module selection & auto-detection ────────────────────────────────
    private async Task SelectModule(string key)
    {
        _activeFlyout = key;
        await OnFlyoutChanged.InvokeAsync(key);
        if (NavGroups.TryGetValue(key, out var group) && group.Items.Count > 0)
        {
            var first = group.Items[0];
            var href = (first.Children?.Count > 0) ? first.Children[0].Href : first.Href;
            if (!string.IsNullOrEmpty(href))
                NavigationManager.NavigateTo("/" + href);
        }
    }

    private async Task DetectActiveModule()
    {
        var current = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        foreach (var (key, group) in NavGroups)
        {
            if (group.Items.Any(item => ItemMatchesUrl(item, current)))
            {
                _activeFlyout = key;
                await OnFlyoutChanged.InvokeAsync(key);
                return;
            }
        }
        _activeFlyout = null;
        await OnFlyoutChanged.InvokeAsync(null);
    }

    private static bool ItemMatchesUrl(NavItem item, string current)
    {
        if (!string.IsNullOrEmpty(item.Href))
        {
            var rel = item.Href.TrimStart('/').TrimEnd('/');
            if (!string.IsNullOrEmpty(rel) &&
                (current.Equals(rel, StringComparison.OrdinalIgnoreCase) ||
                 current.StartsWith(rel + "/", StringComparison.OrdinalIgnoreCase)))
                return true;
        }
        return item.Children?.Any(c => ItemMatchesUrl(c, current)) == true;
    }

    // Short labels for mini sidebar buttons
    private static string GetShortLabel(string key) => key switch
    {
        "Dashboard"       => "Dashboard",
        "Master"          => "Master",
        "CRM / Sales"     => "Sales",
        "Purchase"        => "Purchase",
        "Planning"        => "Planning",
        "Production"      => "Production",
        "Inventory"       => "Inventory",
        "Quality Control" => "QC",
        "Maintenance"     => "Maintain",
        "Human Resource"  => "HR",
        "Finance"         => "Finance",
        "Reports"         => "Reports",
        "Utilities"       => "Utils",
        _                 => key.Length > 9 ? key[..9] : key
    };

    private void Navigate(string href)
    {
        NavigationManager.NavigateTo(href);
    }

    private void NavigateAndClose(string href)
    {
        NavigationManager.NavigateTo(href);
    }

