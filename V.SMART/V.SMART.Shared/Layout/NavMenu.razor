        // ═══════════════════════════════════════
        // MASTER
        // ═══════════════════════════════════════
        ["Master"] = new(Icons.Material.Filled.MenuBook, new()
        {
            new("Admin Master", "", new()
            {
                new("User Master",                "user"),
                new("User Rights Master",         "userRights"),
                new("Authority Manage",           "userLevelAuthorization"),
            }),

            new("Inventory Master", "", new()
            {
                new("Category Master",            "category"),
                new("Measurement Unit",           "uom"),
                new("Stores Master",              "stores"),
                new("Store Mapping",              "store-map"),
                new("HSN/SAC Master",             "hsnMaster"),
                new("Material Master",            "rawMaterialList"),
                new("Item Master",                "itemList"),
                new("BOM Master",                 "bomList"),
                new("Process Master",             "processList"),
