@using MudBlazor
@implements IDisposable
@inject NavigationManager NavigationManager

@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="vs-nav-shell">

    @if (!DrawerOpen)
    {
        <!-- ══════════════════════════════
        MINI SIDEBAR
        ══════════════════════════════ -->
        <div class="vs-mini-nav vs-mini-sidebar">


            @if (!ShowProductionMenu)
            {
                <!-- Home -->
                <div class="vs-mini-item">

                    <button class="vs-mini-btn @(IsActive("/") ? "vs-mini-btn--active" : "")"
                            title="Home"
                            @onclick='() => Navigate("/")'>

                        <MudIcon Icon="@Icons.Material.Filled.Home"
                                 Size="Size.Small" />
                        <span class="vs-mini-btn-label">Home</span>

                    </button>

                </div>
            }

            <AuthorizeView Roles="Administrator,ERPAdmin,User">

                <Authorized>

                    @if (ShowProductionMenu)
                    {
                        <div class="vs-mini-item">

                            <button class="vs-mini-btn   @(IsActive("/productionLogList") ? "vs-mini-btn--active" : "")"
                            title="Daily Production Log"
                            @onclick='() => Navigate("/productionLogList/true")'>

                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" />

                            </button>

                        </div>
                                }
                    else
                    {
                        <!-- Groups — clicking selects the module and loads its subnav into the top bar -->
                        @foreach (var group in NavGroups)
                        {
                            var g = group;

                            <div class="vs-mini-item">

                                <button class="vs-mini-btn
                                    @(_activeFlyout == g.Key ? "vs-mini-btn--open" : "")
                                    @(g.Value.Items.Any(x => ItemMatchesUrl(x, NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/')))
                                    ? "vs-mini-btn--active"
                                    : "")"
                            title="@g.Key"
                            @onclick="() => SelectModule(g.Key)">

                                    <MudIcon Icon="@g.Value.MudIcon"
                                             Size="Size.Small" />
                                    <span class="vs-mini-btn-label">@GetShortLabel(g.Key)</span>

                                </button>

                            </div>
                        }

                    }

                </Authorized>

            </AuthorizeView>

        </div>

        @* Horizontal subnav rendered in MainLayout to avoid fixed-position containment issues *@
    }
    else
