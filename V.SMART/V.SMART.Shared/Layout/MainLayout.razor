@using MudBlazor
@inherits LayoutComponentBase

@inject IJSRuntime _js
@inject ThemeStateService ThemeStateService
@inject ILocalStorageService localStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserThemePreferenceService UserThemePreferenceService
@inject NavigationManager NavigationManager
@inject SessionTimeoutService SessionService
@inject UserSession session

<MudThemeProvider Theme="@_appTheme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@($"vs-layout {(_isDark ? "vs-dark ng-dark" : "vs-light")}")">

    <!-- ══════════════════════════════════════════
         APP BAR
         ══════════════════════════════════════════ -->
    <MudAppBar Elevation="0" Dense="true" Class="vs-appbar">

        <div class="vs-appbar-brand">
            <div class="vs-appbar-logo">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="30" height="30">
                    <defs>
                        <linearGradient id="ng-appbar-logo" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#2563EB"/>
                            <stop offset="100%" stop-color="#7C3AED"/>
                        </linearGradient>
                    </defs>
                    <rect width="48" height="48" rx="11" fill="url(#ng-appbar-logo)"/>
                    <path d="M11 37V11h6.5l13.5 18.5V11H37v26h-6.5L17 18.5V37z" fill="rgba(255,255,255,0.95)"/>
                </svg>
            </div>
            <div class="vs-appbar-brand-text">
                <span class="vs-appbar-company">NexGen-ERP</span>
            </div>
        </div>

        <MudSpacer />

        <!-- Global search -->
        <div class="ng-topbar-search d-none d-md-flex me-3">
            <i class="bi bi-search" style="font-size:13px;"></i>
            <span>Search modules, records…</span>
            <kbd>Ctrl K</kbd>
        </div>

        <!-- User chip -->
        <div class="ng-topbar-user me-2">
            <i class="bi bi-person-circle" style="font-size:16px;"></i>
            <span class="d-none d-sm-inline">@(session?.UserName ?? "Guest")</span>
        </div>

        <!-- Theme toggle -->
        <MudIconButton Icon="@(_isDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       Size="Size.Small"
                       Class="vs-appbar-theme-btn"
                       OnClick="ToggleTheme" />

    </MudAppBar>

    <!-- ══════════════════════════════════════════
         MINI SIDEBAR (outside MudDrawer so
         flyouts can overflow freely)
         ══════════════════════════════════════════ -->
    @if (!_drawerOpen)
    {
        <NavMenu DrawerOpen="false" ToggleDrawer="DrawerToggle" OnFlyoutChanged="OnSubnavChanged" />
    }

    <!-- ══════════════════════════════════════════
         FULL DRAWER (temporary overlay)
         ══════════════════════════════════════════ -->
    @if (_drawerOpen)
    {
        <MudDrawer @bind-Open="_drawerOpen"
                   Variant="DrawerVariant.Temporary"
                   Width="300px"
                   Elevation="0"
                   ClipMode="DrawerClipMode.Always"
                   Class="vs-drawer">
            <NavMenu DrawerOpen="true" ToggleDrawer="DrawerToggle" />
        </MudDrawer>
    }

    <!-- ══════════════════════════════════════════
         MAIN CONTENT
         ══════════════════════════════════════════ -->
    <MudMainContent Class="@($"vs-main {(_drawerOpen ? "vs-main--open" : "vs-main--mini")}")"
                    @onclick="TrackActivity"
                    @onmousemove="TrackActivity"
                    @onkeydown="TrackActivity">
        <div class="vs-content-shell">
            @if (!string.IsNullOrEmpty(_activeModule) && NavMenu.NavGroups.ContainsKey(_activeModule))
            {
                <nav class="vs-subnav-bar">
                    @foreach (var item in NavMenu.NavGroups[_activeModule].Items)
                    {
                        var i = item;
                        @if (i.Children != null && i.Children.Count > 0)
                        {
                            <div class="vs-subnav-group @(i.Children.Any(c => IsSubnavActive(c.Href)) ? "vs-subnav-group--active" : "")">
                                <button class="vs-flyout-item vs-flyout-item--group @(i.Children.Any(c => IsSubnavActive(c.Href)) ? "vs-flyout-item--active" : "")">
                                    @i.Label <i class="bi bi-chevron-down" style="font-size:9px;margin-left:3px;"></i>
                                </button>
                                <div class="vs-subnav-dropdown">
                                    @foreach (var child in i.Children)
                                    {
                                        var c = child;
                                        <a class="vs-subnav-dropdown-item @(IsSubnavActive(c.Href) ? "vs-subnav-dropdown-item--active" : "")"
                                           href="/@c.Href">@c.Label</a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="vs-flyout-item @(IsSubnavActive(i.Href) ? "vs-flyout-item--active" : "")"
                               href="/@i.Href">@i.Label</a>
                        }
                    }
                </nav>
            }
            @Body
        </div>
    </MudMainContent>

</MudLayout>
@if (_showSessionWarning)
{
    <MudOverlay Visible="true" DarkBackground="true">
        <MudPaper Class="pa-6 mx-auto mt-12"
                  Elevation="10"
                  Style="width:450px;">

            <MudText Typo="Typo.h5"
                     Color="Color.Warning"
                     Align="MudBlazor.Align.Center">
                Session Timeout Warning
            </MudText>

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.body1"
                     Align="MudBlazor.Align.Center">
                You have been inactive.
            </MudText>

            <MudText Typo="Typo.h4"
                     Color="@(_countdown <= 10 ? Color.Error : Color.Warning)"
                     Align="MudBlazor.Align.Center">
                @_countdown Seconds
            </MudText>

            <MudText Align="MudBlazor.Align.Center">
                Your session will be closed automatically.
            </MudText>

            <div class="d-flex justify-center mt-4">
                <MudButton Color="Color.Success"
                           Variant="Variant.Filled"
                           OnClick="ContinueSession">
                    Continue Session
                </MudButton>
            </div>

        </MudPaper>
    </MudOverlay>
}


@code {

    private bool _drawerOpen = false;
    private bool _isDark = false;
    private string? _activeModule;

    private void OnSubnavChanged(string? moduleKey)
    {
        _activeModule = moduleKey;
        StateHasChanged();
    }

    private bool IsSubnavActive(string href)
    {
        var rel = href.TrimStart('/').TrimEnd('/');
        var cur = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        if (string.IsNullOrEmpty(rel)) return false;
        return cur.Equals(rel, StringComparison.OrdinalIgnoreCase) ||
               cur.StartsWith(rel + "/", StringComparison.OrdinalIgnoreCase);
    }

    private bool _showSessionWarning;

    private PeriodicTimer? _idleTimer;
    private PeriodicTimer? _countdownTimer;

    private int _countdown = 30;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        SessionService.Touch();

        _idleTimer = new PeriodicTimer(
            TimeSpan.FromSeconds(1));

        _ = MonitorIdleTime();

       
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _drawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Initialize Navigation Guard
        await _js.InvokeVoidAsync("NavigationGuard.initialize");

        _isDark = await UserThemePreferenceService.LoadLocalThemeAsync();
        ThemeStateService.SetTheme(_isDark);
        StateHasChanged();

        await UserThemePreferenceService.SyncThemeFromDatabaseAsync(v =>
        {
            _isDark = v;
            ThemeStateService.SetTheme(v);
            InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        ThemeStateService.SetTheme(_isDark);
        await UserThemePreferenceService.SaveThemePreferenceAsync(_isDark);
    }

    // ── MudBlazor theme ──────────────────────────────────────────────────
    private readonly MudTheme _appTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            Secondary = "#7C3AED",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#0F172A",
            DrawerBackground = "#0F172A",
            DrawerText = "#CBD5E1",
            Surface = "#FFFFFF",
            Background = "#F0F4FA",
            TextPrimary = "#0F172A",
            TextSecondary = "#64748B",
            LinesDefault = "rgba(15,23,42,0.08)",
            DrawerIcon = "#64748B",
            ActionDefault = "#64748B",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#3B82F6",
            Secondary = "#A78BFA",
            Background = "#060B18",
            Surface = "#111827",
            AppbarBackground = "#0D1526",
            AppbarText = "#F1F5F9",
            DrawerBackground = "#070C18",
            DrawerText = "#CBD5E1",
            TextPrimary = "#F1F5F9",
            TextSecondary = "#94A3B8",
            LinesDefault = "rgba(255,255,255,0.08)",
            DrawerIcon = "#64748B",
            ActionDefault = "#94A3B8",
        },
    };

    private async Task MonitorIdleTime()
    {
        while (await _idleTimer!.WaitForNextTickAsync())
        {
            if (!_showSessionWarning &&
                SessionService.IsIdle(5)) // 2 minutes
            {
                await InvokeAsync(async () =>
                {
                    _showSessionWarning = true;
                    _countdown = 30;

                    StateHasChanged();

                    _ = StartCountdown();

                    await Task.CompletedTask;
                });
            }
        }
    }

    private async Task StartCountdown()
    {
        _countdownTimer?.Dispose();

        _countdownTimer =
            new PeriodicTimer(TimeSpan.FromSeconds(1));

        while (_showSessionWarning &&
               await _countdownTimer.WaitForNextTickAsync())
        {
            _countdown--;

            await InvokeAsync(StateHasChanged);

            if (_countdown <= 0)
            {
                _showSessionWarning = false;

                await InvokeAsync(() =>
                {
                    LogoutUser();
                });

                return;
            }
        }
    }

    private void ContinueSession()
    {
        SessionService.Touch();

        _showSessionWarning = false;

        _countdown = 30;

        _countdownTimer?.Dispose();

        StateHasChanged();
    }

    private void TrackActivity()
    {
        SessionService.Touch();

        if (_showSessionWarning)
        {
            ContinueSession();
        }
    }

    private void LogoutUser()
    {
        NavigationManager.NavigateTo("/login", true);
    }

}
