<div class="card h-100 bg-light border-0 shadow-sm">
    <div class="card-body d-flex flex-column">

        <!-- Switch -->
        <div class="form-check form-switch mb-3">
            <InputCheckbox Value="SwitchValue"
                           ValueChanged="SwitchValueChanged"
                           ValueExpression="@(() => SwitchValue)"
                           class="form-check-input"
                           id="@SwitchId" />

            <label class="form-check-label fw-bold text-primary" for="@SwitchId">
                @Label
            </label>
        </div>

        <!-- ✅ Switch Validation -->
        <ValidationMessage For="@(() => SwitchValue)" />

        @if (SwitchValue)
        {
            <div>
                <label class="form-label">@LevelLabel</label>

                <InputSelect Value="LevelValue"
                             ValueChanged="LevelValueChanged"
                             ValueExpression="@(() => LevelValue)"
                             class="form-select">

                    <option value="">Select Level</option>
                    <option value="Level1">Level1</option>
                    <option value="Level2">Level2</option>
                    <option value="Level3">Level3</option>
                </InputSelect>

                <!-- ✅ Level Validation -->
                <ValidationMessage For="@(() => LevelValue)" />
            </div>
        }

    </div>
</div>


@code {
    [Parameter] public bool SwitchValue { get; set; }
    [Parameter] public EventCallback<bool> SwitchValueChanged { get; set; }

    [Parameter] public string LevelValue { get; set; }
    [Parameter] public EventCallback<string> LevelValueChanged { get; set; }

    [Parameter] public string Label { get; set; }
    [Parameter] public string LevelLabel { get; set; }
    [Parameter] public string SwitchId { get; set; }
}
