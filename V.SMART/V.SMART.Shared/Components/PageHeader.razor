<div class="sticky-header-wrapper">

    <div class="card-header text-white rounded-top-1 py-3 px-4"
         style="background:#6b2220;
                font-family:Georgia;
                border:none;">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">

                <ol class="breadcrumb mb-0 bg-transparent p-0 align-items-center">

                    <!-- HOME -->
                    <li class="breadcrumb-item d-flex align-items-center">

                        <i class="bi bi-house-door-fill me-1 text-warning"></i>

                        <SmartBackButton Url="/"
                                         RenderAsLink="true"
                                         CssClass="text-white text-decoration-none fw-semibold">

                            <ChildContent>

                                Home

                            </ChildContent>

                        </SmartBackButton>

                    </li>

                    @if (Breadcrumbs.Any())
                    {
                        <li class="px-2 text-warning">

                            <i class="bi bi-arrow-right"></i>

                        </li>
                    }

                    <!-- DYNAMIC -->
                    @foreach (var crumb in Breadcrumbs)
                    {
                        <li class="breadcrumb-item d-flex align-items-center">

                            @if (!string.IsNullOrEmpty(crumb.Icon))
                            {
                                <i class="@crumb.Icon me-1 text-warning"></i>
                            }

                            @if (!crumb.IsLast)
                            {
                                <SmartBackButton Url="@crumb.Url"
                                                 RenderAsLink="true"
                                                 CssClass="text-white text-decoration-none fw-semibold">

                                    <ChildContent>

                                        @crumb.Text

                                    </ChildContent>

                                </SmartBackButton>
                            }
                            else
                            {
                                <span class="fw-bold text-warning">

                                    @crumb.Text

                                </span>
                            }

                        </li>

                        @if (!crumb.IsLast)
                        {
                            <li class="px-2 text-warning">

                                <i class="bi bi-arrow-right"></i>

                            </li>
                        }
                    }

                </ol>

               @*  <span>@SearchedFields</span> *@

            </nav>
            <div class="d-flex align-items-center">

                <h5 class="mb-0 fw-bold">

                    <span class="badge bg-success-subtle text-success fs-6 text-wrap">

                        @if (!string.IsNullOrEmpty(SearchedFields))
                        {
                            <i class="@SearchedFields me-2"></i>
                        }

                        @SearchedFields

                    </span>

                </h5>

            </div>
            <!-- TITLE -->
            <div class="d-flex align-items-center">

                <h5 class="mb-0 fw-bold">

                    <span class="badge bg-warning text-dark fs-6">

                        @if (!string.IsNullOrEmpty(TitleIcon))
                        {
                            <i class="@TitleIcon me-2"></i>
                        }

                        @TitleText

                    </span>

                </h5>

            </div>

        </div>

    </div>

</div>

<style>

    .sticky-header-wrapper {
        position: sticky;
        top: 65px;
        z-index: 999;
        background: transparent;
    }

</style>

@code {

    [Parameter]
    public List<BreadcrumbItem> Breadcrumbs { get; set; } = new();

    [Parameter]
    public string TitleText { get; set; } = "";

    [Parameter]
    public string TitleIcon { get; set; } = "bi bi-clock";

    [Parameter]
    public string SearchedFields { get; set; } = "";

    public class BreadcrumbItem
    {
        public string Text { get; set; } = "";

        public string Url { get; set; } = "#";

        public string Icon { get; set; } = "";

        public bool IsLast { get; set; } = false;
    }

}

