<div class="zh-module-header">

    <div class="zh-module-title-group">
        @if (!string.IsNullOrEmpty(TitleIcon))
        {
            <i class="@TitleIcon" style="font-size:16px; color:var(--ng-brand); margin-right:8px; flex-shrink:0;"></i>
        }
        <span class="zh-breadcrumb-active">@TitleText</span>
    </div>

</div>

@code {

    [Parameter]
    public List<BreadcrumbItem> Breadcrumbs { get; set; } = new();

    [Parameter]
    public string TitleText { get; set; } = "";

    [Parameter]
    public string TitleIcon { get; set; } = "bi bi-clock";

    [Parameter]
    public string SearchedFields { get; set; } = "";

    public class BreadcrumbItem
    {
        public string Text { get; set; } = "";

        public string Url { get; set; } = "#";

        public string Icon { get; set; } = "";

        public bool IsLast { get; set; } = false;
    }

}

