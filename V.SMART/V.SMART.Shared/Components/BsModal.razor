@inject IJSRuntime _js


<div class="modal fade" id="bsConfirmationModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow-sm">

            <!-- Header -->
            <div class="modal-header bg-light border-bottom-0 rounded-top-4">
                <h5 class="modal-title fw-semibold text-secondary" id="confirmModalLabel">
                    @Title
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body px-3 px-sm-4 py-4 bg-white">

                @if (ShowReasonBox)
                {
                    <div class="mb-3">
                        <label for="reason" class="form-label fw-semibold text-secondary">
                            Reason <span class="text-danger">*</span>
                        </label>
                        <textarea id="reason"
                                  class="form-control rounded-3 border border-1 border-secondary-subtle"
                                  rows="3"
                                  placeholder="Enter reason..."
                                  @bind="Reason"
                                  style="resize: none;"></textarea>
                    </div>
                }

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 gap-sm-4 mt-4">

                    <button type="button"
                            class="btn btn-lg @ButtonBootstrapStyle fw-semibold rounded-3 px-4 py-2 flex-fill text-white"
                            style="border:none;"
                            @onclick="() => ConfirmationClicked(true)">
                        <i class="bi bi-check-circle me-2"></i>@ButtonText
                    </button>

                    <button type="button"
                            class="btn btn-lg fw-semibold rounded-3 px-4 py-2 flex-fill btn-outline-secondary"
                            data-bs-dismiss="modal"
                            @onclick="() => ConfirmationClicked(false)">
                        <i class="bi bi-x-circle me-2"></i>Close
                    </button>

                </div>

            </div>
        </div>
    </div>
</div>


@code {
    [Parameter]
    public EventCallback<bool> OnModalConfirmation { get; set; }

    [Parameter]
    public string Title { get; set; } = "Please Confirm";

    [Parameter]
    public string ButtonBootstrapStyle { get; set; } = "btn-primary";

    [Parameter]
    public string ButtonText { get; set; } = "Confirm";

    [Parameter]
    public EventCallback<string> OnReasonChanged { get; set; }

    [Parameter] public bool ShowReasonBox { get; set; } = false;
    [Parameter] public string Reason { get; set; } = string.Empty;

    private async Task ConfirmationClicked(bool isConfirmed)
    {
        if (isConfirmed)
        {
            if (ShowReasonBox && string.IsNullOrWhiteSpace(Reason))
            {
                await _js.ToastrWarning("Please enter a valid reason before confirming.");
                return;
            }

            await OnReasonChanged.InvokeAsync(Reason);
            await OnModalConfirmation.InvokeAsync(true);
        }
        else
        {
            await OnModalConfirmation.InvokeAsync(false);
        }
    }

}