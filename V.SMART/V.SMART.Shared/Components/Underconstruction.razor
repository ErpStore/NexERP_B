@page "/under-construction"

<PageTitle>Under Construction</PageTitle>

<div class="construction-wrapper">

    <!-- Background Glow -->
    <div class="bg-orb orb1"></div>
    <div class="bg-orb orb2"></div>

    <!-- Main Card -->
    <div class="construction-card">

        <!-- Animated Icon -->
        <div class="icon-wrap">
            <div class="gear gear1">⚙</div>
            <div class="gear gear2">⚙</div>
        </div>

        <!-- Content -->
        <h1>Page Under Construction</h1>

        <p>
            We're currently building something amazing for you.
            Please check back again soon.
        </p>

        <!-- Progress -->
        <div class="progress-area">
            <div class="progress-bar"></div>
        </div>

        <span class="status-text">Development In Progress...</span>

        <!-- Optional Button -->
        <button class="home-btn" @onclick="GoHome">
            Back To Home
        </button>

    </div>
</div>

<style>
    /* =========================================================
       UNDER CONSTRUCTION PAGE
       ========================================================= */

    .construction-wrapper {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: linear-gradient(135deg, #0f172a, #111827, #1e293b);
    }

    /* Background Glow */
    .bg-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        opacity: 0.35;
        animation: floatOrb 10s ease-in-out infinite;
    }

    .orb1 {
        width: 300px;
        height: 300px;
        background: #3b82f6;
        top: -80px;
        left: -80px;
    }

    .orb2 {
        width: 250px;
        height: 250px;
        background: #06b6d4;
        bottom: -80px;
        right: -80px;
        animation-delay: 2s;
    }

    /* Card */
    .construction-card {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 650px;
        padding: 3rem 2rem;
        border-radius: 28px;
        text-align: center;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 10px 40px rgba(0,0,0,0.35), inset 0 1px 1px rgba(255,255,255,0.08);
    }

    /* Icon */
    .icon-wrap {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto 1.5rem;
    }

    .gear {
        position: absolute;
        color: white;
        text-shadow: 0 0 25px rgba(255,255,255,0.4);
    }

    .gear1 {
        font-size: 70px;
        left: 10px;
        top: 20px;
        animation: spin 6s linear infinite;
    }

    .gear2 {
        font-size: 42px;
        right: 10px;
        bottom: 15px;
        animation: spinReverse 4s linear infinite;
    }

    /* Heading */
    .construction-card h1 {
        font-size: 2.6rem;
        font-weight: 800;
        color: white;
        margin-bottom: 1rem;
    }

    /* Description */
    .construction-card p {
        color: rgba(255,255,255,0.75);
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 2rem;
    }

    /* Progress */
    .progress-area {
        width: 100%;
        height: 14px;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(255,255,255,0.12);
        margin-bottom: 1rem;
    }

    .progress-bar {
        height: 100%;
        width: 65%;
        border-radius: inherit;
        background: linear-gradient( 90deg, #3b82f6, #06b6d4, #38bdf8 );
        background-size: 200% 100%;
        animation: loading 3s ease-in-out infinite, gradientMove 4s linear infinite;
    }

    .status-text {
        display: inline-block;
        color: #cbd5e1;
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }

    /* Button */
    .home-btn {
        border: none;
        outline: none;
        padding: 0.9rem 1.8rem;
        border-radius: 14px;
        font-size: 1rem;
        font-weight: 600;
        color: white;
        cursor: pointer;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        backdrop-filter: blur(12px);
        transition: all 0.3s ease;
    }

        .home-btn:hover {
            transform: translateY(-3px) scale(1.02);
            background: rgba(255,255,255,0.18);
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
        }

    /* Animations */
    @@keyframes spin {
        from

    {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

    }

    @@keyframes spinReverse {
        from

    {
        transform: rotate(360deg);
    }

    to {
        transform: rotate(0deg);
    }

    }

    @@keyframes loading {
        0%

    {
        width: 20%;
    }

    50% {
        width: 80%;
    }

    100% {
        width: 20%;
    }

    }

    @@keyframes gradientMove {
        0%

    {
        background-position: 0% 50%;
    }

    100% {
        background-position: 200% 50%;
    }

    }

    @@keyframes floatOrb {
        0%,100%

    {
        transform: translateY(0px);
    }

    50% {
        transform: translateY(-25px);
    }

    }

    /* Responsive */
    @@media (max-width: 768px) {
        .construction-card

    {
        padding: 2.5rem 1.5rem;
    }

    .construction-card h1 {
        font-size: 2rem;
    }

    .construction-card p {
        font-size: 0.95rem;
    }

    }
</style>

@code {

    [Inject] NavigationManager Nav { get; set; } = default!;

    private void GoHome()
    {
        Nav.NavigateTo("/");
    }
}