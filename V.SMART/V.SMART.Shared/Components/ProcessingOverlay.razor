@* FullScreenLoader.razor *@

@if (Visible)
{
    <div class="loader-overlay">

        <div class="loader-glass-card">

            <img src="@ImageSrc"
                 alt="@AltText"
                 class="loader-image" />

            @if (!string.IsNullOrEmpty(Message))
            {
                <div class="loader-text">
                    @Message
                </div>
            }

            <div class="loader-bar">
                <div class="loader-progress"></div>
            </div>

        </div>

    </div>
}

@code {
    [Parameter] public bool Visible { get; set; } = false;
    [Parameter] public string ImageSrc { get; set; } = "/_content/V.SMART.Shared/images/BSPLLOGOANIMATED.gif";
    [Parameter] public string AltText { get; set; } = "Loading...";
    [Parameter] public string Message { get; set; }
}