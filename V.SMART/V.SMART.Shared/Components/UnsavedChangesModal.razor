@if (Visible)
{
    <div class="clann-guard-root @(IsDark ? "theme-dark" : "theme-light") clann-overlay"
         @onclick="OnCancel">
        <div class="crystal-card @(Animate ? "animate-in" : "")"
             @onclick:stopPropagation="true">
            <div class="card-top-edge"></div>
            <div class="card-facet"></div>
            <div class="card-inner">
                <div class="modal-warn-header">
                    <div class="warn-icon-wrap">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <h5 class="modal-title-text">@Title</h5>
                </div>
                <p class="modal-body-text">@Message</p>
                <div class="btn-row">
                    <button type="button" class="glass-btn btn-continue" @onclick="OnContinue">
                        <span class="btn-shimmer"></span>
                        <span class="btn-top-edge"></span>
                        <i class="bi bi-pencil-fill"></i>
                        Continue
                    </button>
                    <button type="button" class="glass-btn btn-discard" @onclick="OnDiscard">
                        <span class="btn-shimmer"></span>
                        <span class="btn-top-edge"></span>
                        <i class="bi bi-trash3-fill"></i>
                        Discard
                    </button>
                </div>
                <div class="crystal-divider"></div>
                <button type="button" class="glass-cancel-btn" @onclick="OnCancel">
                    <span class="btn-shimmer"></span>
                    <i class="bi bi-x-circle"></i>
                    Cancel
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool Animate { get; set; }
    [Parameter] public bool IsDark { get; set; }   // ← NEW parameter
    [Parameter] public string Title { get; set; } = "Unsaved Changes";
    [Parameter]
    public string Message { get; set; } =
        "Some changes have been made to this record. Do you want to continue editing or discard changes?";
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnDiscard { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}