<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The API's test project. Created by task M2-A06.

    M2-A02 was scheduled to create this project first; it has not landed (verified 2026-08-20:
    tests/ contained only V.SMART.Shared.Tests). M2-A06 changes the error contract of every
    endpoint, so it creates the project rather than shipping the contract untested. M2-A02
    extends this project instead of creating it; nothing here asserts the pre-M2-A06 shapes.

    TargetFramework is net9.0, matching tests/V.SMART.Shared.Tests. FrameworkReference on
    Microsoft.AspNetCore.App is required because V.SMART.Api is a Web SDK project: without it
    HttpContext, ProblemDetails and ControllerBase do not resolve here.

    Package versions match tests/V.SMART.Shared.Tests exactly. Mixing versions across the
    reference boundary is the classic source of MethodNotFoundException at test time.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\V.SMART\V.SMART.Api\V.SMART.Api.csproj" />
  </ItemGroup>

</Project>
